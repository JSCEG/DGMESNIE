<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>annotations</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <Features>$(Features);experimental-data-section-string-literals</Features>
    <RootNamespace>NSIE</RootNamespace>
    <AssemblyName>NSIE</AssemblyName>
    <AspNetCoreHostingModel>InProcess</AspNetCoreHostingModel>
    <PreserveCompilationContext>true</PreserveCompilationContext>
    <CopyRazorGenerateFilesToPublishDirectory>true</CopyRazorGenerateFilesToPublishDirectory>
    <CopyOutputSymbolsToPublishDirectory>false</CopyOutputSymbolsToPublishDirectory>
  </PropertyGroup>
  <ItemGroup>
    <!-- compilacion/ es una salida generada y no debe participar en Razor ni en el build. -->
    <Content Remove="compilacion\**\*" />
    <Compile Remove="compilacion\**\*.cs" />
    <EmbeddedResource Remove="compilacion\**\*" />
    <None Remove="compilacion\**\*" />
  </ItemGroup>
  <ItemGroup>
    <Content Update="wwwroot\**\*.*">
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </Content>
    <Content Update="Views\**\*.*">
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </Content>
    <Content Update="appsettings.json">
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </Content>
  </ItemGroup>
  <ItemGroup>
    <Content Update="wwwroot\Ejemplos\**\*.*;wwwroot\Geovisualizador\**\*.*;wwwroot\document\**\*.*;wwwroot\documentos\**\*.*;Ejemplos\**\*.*;Insumos\**\*.*;Respaldos\**\*.*">
      <CopyToPublishDirectory>Never</CopyToPublishDirectory>
    </Content>
    <None Update="Ejemplos\**\*.*;Insumos\**\*.*;Respaldos\**\*.*">
      <CopyToPublishDirectory>Never</CopyToPublishDirectory>
    </None>
  </ItemGroup>
  <ItemGroup>
    <!-- Recursos locales no productivos, duplicados en CDN o generados en ejecución. -->
    <Content Update="wwwroot\Constancia Ejemplo\**\*.*;wwwroot\reglamento.html;wwwroot\video\**\*.*;wwwroot\archivos\**\*.*;wwwroot\documents\BD_Privados_FirmesCGPT.xlsx;wwwroot\documents\Coordenadas-de-Geo-referenciación-Póster.pdf;wwwroot\documents\EnergeoCRE-Guía.pdf;wwwroot\documents\Informe_Seguimiento_ProyectosFirmes_Mayo2026.docx;wwwroot\Presentaciones\14a Sesion Ordinaria CT-CNE.html;wwwroot\Presentaciones\MarcoJuridico.html;wwwroot\Presentaciones\Segunda_Convocatoria.html">
      <CopyToPublishDirectory>Never</CopyToPublishDirectory>
    </Content>
  </ItemGroup>
  <ItemGroup>
    <Content Update="appsettings.Development.json;appsettings.Local.json;Documentacion\**\*.*;Entrega\**\*.*;Mockups\**\*.*;temp_*.js;test_*.sql;test_*.html;package.json;package-lock.json;graphify-out\**\*.*;scratch\**\*.*;out\**\*.*;database\**\*.*;compilacion\**\*.*;tmp\**\*.*;salidas\**\*.*">
      <CopyToPublishDirectory>Never</CopyToPublishDirectory>
    </Content>
    <None Update="appsettings.Development.json;appsettings.Local.json;Documentacion\**\*.*;Entrega\**\*.*;Mockups\**\*.*;temp_*.js;test_*.sql;test_*.html;package.json;package-lock.json;graphify-out\**\*.*;scratch\**\*.*;out\**\*.*;database\**\*.*;compilacion\**\*.*;tmp\**\*.*;salidas\**\*.*">
      <CopyToPublishDirectory>Never</CopyToPublishDirectory>
    </None>
  </ItemGroup>
  <ItemGroup>
    <!-- Atlas SEN se actualiza en ejecución y persiste fuera de wwwroot en Azure App Service. -->
    <Content Update="App_Data\cache\atlas-sen\**\*.*">
      <CopyToPublishDirectory>Never</CopyToPublishDirectory>
    </Content>
    <None Update="App_Data\cache\atlas-sen\**\*.*">
      <CopyToPublishDirectory>Never</CopyToPublishDirectory>
    </None>
  </ItemGroup>
  <ItemGroup>
    <Folder Include="wwwroot\Geo_Json\" />
    <Folder Include="wwwroot\img\" />
    <Folder Include="wwwroot\Mapas_N\" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="ClosedXML" Version="0.104.2" />
    <PackageReference Include="Dapper" Version="2.0.123" />
    <PackageReference Include="Dapper.Contrib" Version="2.0.78" />
    <PackageReference Include="MailKit" Version="4.16.0" />
    <PackageReference Include="Microsoft.Data.SqlClient" Version="5.1.4" />
    <PackageReference Include="Microsoft.VisualStudio.Web.CodeGeneration.Design" Version="6.0.13" />
    <PackageReference Include="SendGrid" Version="9.24.4" />
    <PackageReference Include="Swashbuckle.AspNetCore" Version="6.3.0" />
    <PackageReference Include="UglyToad.PdfPig" Version="1.7.0-custom-5" />
    <PackageReference Include="itext7" Version="7.1.15" />
    <PackageReference Include="Microsoft.AspNetCore.Authentication.Google" Version="8.0.0" />
    <PackageReference Include="Microsoft.AspNetCore.Authentication.Facebook" Version="8.0.0" />
  </ItemGroup>
</Project>
