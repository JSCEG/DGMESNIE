@model NSIE.Models.ProyectoModernizacionRegistro

<div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>

<div class="row g-3">
    <div class="col-md-2">
        <label asp-for="Numero" class="form-label"></label>
        <input asp-for="Numero" class="form-control" />
        <span asp-validation-for="Numero" class="text-danger"></span>
    </div>
    <div class="col-md-2">
        <label asp-for="NumeroOriginal" class="form-label"></label>
        <input asp-for="NumeroOriginal" class="form-control" />
        <span asp-validation-for="NumeroOriginal" class="text-danger"></span>
    </div>
    <div class="col-md-3">
        <label asp-for="GRT" class="form-label"></label>
        <input asp-for="GRT" class="form-control" />
        <span asp-validation-for="GRT" class="text-danger"></span>
    </div>
    <div class="col-md-5">
        <label asp-for="NombreProyecto" class="form-label"></label>
        <input asp-for="NombreProyecto" class="form-control" />
        <span asp-validation-for="NombreProyecto" class="text-danger"></span>
    </div>

    <div class="col-md-4">
        <label asp-for="TipoFinanciamiento" class="form-label"></label>
        <input asp-for="TipoFinanciamiento" class="form-control" />
        <span asp-validation-for="TipoFinanciamiento" class="text-danger"></span>
    </div>
    <div class="col-md-2">
        <label asp-for="AnioInstruccion" class="form-label"></label>
        <input asp-for="AnioInstruccion" class="form-control" />
        <span asp-validation-for="AnioInstruccion" class="text-danger"></span>
    </div>
    <div class="col-md-3">
        <label asp-for="EtapaProyecto" class="form-label"></label>
        <input asp-for="EtapaProyecto" class="form-control" />
        <span asp-validation-for="EtapaProyecto" class="text-danger"></span>
    </div>
    <div class="col-md-3">
        <label asp-for="MontoProyectoMdp" class="form-label"></label>
        <input asp-for="MontoProyectoMdp" class="form-control" />
        <span asp-validation-for="MontoProyectoMdp" class="text-danger"></span>
    </div>

    <div class="col-md-4">
        <label asp-for="FechaEstimadaInicio" class="form-label"></label>
        <input asp-for="FechaEstimadaInicio" class="form-control" />
        <span asp-validation-for="FechaEstimadaInicio" class="text-danger"></span>
    </div>
    <div class="col-md-4">
        <label asp-for="FeoIndicadaOficioSener" class="form-label"></label>
        <input asp-for="FeoIndicadaOficioSener" class="form-control" />
        <span asp-validation-for="FeoIndicadaOficioSener" class="text-danger"></span>
    </div>
    <div class="col-md-4">
        <label asp-for="FeoFactible" class="form-label"></label>
        <input asp-for="FeoFactible" class="form-control" />
        <span asp-validation-for="FeoFactible" class="text-danger"></span>
    </div>

    <div class="col-md-3">
        <label asp-for="PorcentajeAvanceEjecucion" class="form-label"></label>
        <input asp-for="PorcentajeAvanceEjecucion" class="form-control" />
        <span asp-validation-for="PorcentajeAvanceEjecucion" class="text-danger"></span>
    </div>
    <div class="col-md-3">
        <label asp-for="Mva" class="form-label"></label>
        <input asp-for="Mva" class="form-control" />
        <span asp-validation-for="Mva" class="text-danger"></span>
    </div>
    <div class="col-md-3">
        <label asp-for="Mvar" class="form-label"></label>
        <input asp-for="Mvar" class="form-control" />
        <span asp-validation-for="Mvar" class="text-danger"></span>
    </div>
    <div class="col-md-3">
        <label asp-for="KmC" class="form-label"></label>
        <input asp-for="KmC" class="form-control" />
        <span asp-validation-for="KmC" class="text-danger"></span>
    </div>

    <div class="col-md-4">
        <label asp-for="ComentariosNivelPriorizacion" class="form-label"></label>
        <input asp-for="ComentariosNivelPriorizacion" class="form-control" />
        <span asp-validation-for="ComentariosNivelPriorizacion" class="text-danger"></span>
    </div>
    <div class="col-md-4">
        <label asp-for="ClavePem" class="form-label"></label>
        <input asp-for="ClavePem" class="form-control" />
        <span asp-validation-for="ClavePem" class="text-danger"></span>
    </div>
    <div class="col-md-4">
        <label asp-for="ClasificacionSener" class="form-label"></label>
        <input asp-for="ClasificacionSener" class="form-control" />
        <span asp-validation-for="ClasificacionSener" class="text-danger"></span>
    </div>

    <div class="col-md-4">
        <label asp-for="FechaProgramacionTrimestre" class="form-label"></label>
        <input asp-for="FechaProgramacionTrimestre" class="form-control" />
        <span asp-validation-for="FechaProgramacionTrimestre" class="text-danger"></span>
    </div>
    <div class="col-md-4">
        <label asp-for="QuincenaPublicacion" class="form-label"></label>
        <input asp-for="QuincenaPublicacion" class="form-control" />
        <span asp-validation-for="QuincenaPublicacion" class="text-danger"></span>
    </div>
    <div class="col-md-4">
        <label asp-for="UniversoPresentacionPresidencia" class="form-label"></label>
        <input asp-for="UniversoPresentacionPresidencia" class="form-control" />
        <span asp-validation-for="UniversoPresentacionPresidencia" class="text-danger"></span>
    </div>

    <div class="col-12">
        <label asp-for="ElementosEquiposAsociados" class="form-label"></label>
        <textarea asp-for="ElementosEquiposAsociados" class="form-control" rows="6"></textarea>
        <span asp-validation-for="ElementosEquiposAsociados" class="text-danger"></span>
    </div>
    <div class="col-12">
        <label asp-for="CircunstanciasAtrasos" class="form-label"></label>
        <textarea asp-for="CircunstanciasAtrasos" class="form-control" rows="4"></textarea>
        <span asp-validation-for="CircunstanciasAtrasos" class="text-danger"></span>
    </div>
    <div class="col-12">
        <label asp-for="AccionesMitigacionCorreccion" class="form-label"></label>
        <textarea asp-for="AccionesMitigacionCorreccion" class="form-control" rows="4"></textarea>
        <span asp-validation-for="AccionesMitigacionCorreccion" class="text-danger"></span>
    </div>
    <div class="col-12">
        <label asp-for="EstadoRealProyecto" class="form-label"></label>
        <textarea asp-for="EstadoRealProyecto" class="form-control" rows="4"></textarea>
        <span asp-validation-for="EstadoRealProyecto" class="text-danger"></span>
    </div>
</div>

<div class="d-flex justify-content-end gap-2 mt-4">
    <a asp-action="Index" class="btn btn-outline-secondary">Cancelar</a>
    <button type="submit" class="btn btn-primary">@ViewData["SubmitLabel"]</button>
</div>