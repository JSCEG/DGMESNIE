</style>

@section scripts {
    <script>
        (function () {
            const cache = new Map();
            const urlDetalle = '@Url.Action("Detalle")';

            function escapeHtml(text) {
                const div = document.createElement('div');
                div.textContent = text;
                return div.innerHTML;
            }

            const hayValor = v => v != null && String(v).trim() !== '';

            const spec = (label, valor) => `
                <div class="ip-spec">
                    <span>${label}</span>
                    <strong>${hayValor(valor) ? escapeHtml(String(valor)) : '—'}</strong>
                </div>`;

            const seccion = (tipo, icono, titulo, valor) => !hayValor(valor) ? '' : `
                <section class="ip-seccion ip-seccion--${tipo}">
                    <h6><i class="fas ${icono}"></i>${titulo}</h6>
                    <div class="ip-seccion__texto">${escapeHtml(String(valor))}</div>
                </section>`;

            function render(data) {
                const specs = `<div class="ip-specs">
                    ${spec('Financiamiento', data.tipoFinanciamiento)}
                    ${spec('Año de instrucción', data.anioInstruccion)}
                    ${spec('Clasificación SENER', data.clasificacionSener)}
                    ${spec('Programación / publicación', [data.fechaProgramacionTrimestre, data.quincenaPublicacion].filter(hayValor).join(' / '))}
                    ${spec('Inicio estimado', data.fechaEstimadaInicio)}
                    ${spec('FEO oficio SENER', data.feoIndicadaOficioSener)}
                    ${spec('FEO factible', data.feoFactible)}
                    ${spec('MVA · MVAR · km-C', [data.mva, data.mvar, data.kmC].map(v => hayValor(v) ? v : '—').join(' · '))}
                </div>`;

                const secciones =
                    seccion('estado', 'fa-clipboard-check', 'Estado real que guarda el proyecto', data.estadoRealProyecto) +
                    seccion('atrasos', 'fa-triangle-exclamation', 'Circunstancias de atraso', data.circunstanciasAtrasos) +
                    seccion('mitigacion', 'fa-shield-halved', 'Acciones de mitigación', data.accionesMitigacionCorreccion) +
                    seccion('equipos', 'fa-plug-circle-bolt', 'Elementos y equipos asociados', data.elementosEquiposAsociados);

                return specs + (secciones || '<p class="ip-detalle-vacio mb-0"><i class="fas fa-circle-info me-2"></i>Sin narrativa registrada para este proyecto.</p>');
            }

            document.querySelectorAll('[data-detalle-toggle]').forEach(btn => {
                btn.addEventListener('click', async () => {
                    const id = btn.getAttribute('data-detalle-toggle');
                    const panel = document.getElementById('detalle-' + id);
                    if (!panel) return;

                    const abierto = btn.getAttribute('aria-expanded') === 'true';
                    if (abierto) {
                        panel.hidden = true;
                        btn.setAttribute('aria-expanded', 'false');
                        return;
                    }

                    panel.hidden = false;
                    btn.setAttribute('aria-expanded', 'true');

                    if (cache.has(id)) {
                        panel.innerHTML = cache.get(id);
                        return;
                    }

                    try {
                        const resp = await fetch(`${urlDetalle}?id=${id}`, { headers: { 'Accept': 'application/json' } });
                        if (!resp.ok) throw new Error('HTTP ' + resp.status);
                        const data = await resp.json();
                        const html = render(data);
                        cache.set(id, html);
                        panel.innerHTML = html;
                    } catch (e) {
                        panel.innerHTML = '<div class="text-danger small">No fue posible cargar el detalle. Intenta de nuevo.</div>';
                    }
                });
            });

            // Autofiltrar al cambiar selects (conserva UX de un clic)
            ['etapa', 'tipoFinanciamiento', 'universo'].forEach(idSel => {
                const el = document.getElementById(idSel);
                if (el) el.addEventListener('change', () => document.getElementById('ip-filtros').requestSubmit());
            });
        })();
    </script>
}
