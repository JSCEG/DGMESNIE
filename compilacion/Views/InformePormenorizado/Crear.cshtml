@model NSIE.Models.ProyectoModernizacionRegistro

@{
    ViewData["Title"] = "Nuevo proyecto de modernización";
    var headerModel = ViewData["HeaderModel"] as NSIE.Models.HeaderViewModel;
}

@if (headerModel != null)
{
    @await Html.PartialAsync("_ViewHeader", headerModel)
}

<div class="container-fluid shell-page-container py-3">
    <div class="card border-0 shadow-sm">
        <div class="card-body p-4">
            <h4 class="mb-1">@ViewData["FormTitle"]</h4>
            <p class="text-muted mb-4">Captura la información del proyecto con el mismo detalle del informe pormenorizado oficial.</p>

            <form asp-action="Crear" method="post">
                @Html.AntiForgeryToken()
                <partial name="_Formulario" model="Model" />
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}