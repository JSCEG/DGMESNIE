@model NSIE.Models.DashboardSIILViewModel
@using NSIE.Models
@using Newtonsoft.Json
@{
    ViewData["Title"] = "SIIL - Tablero Principal";
    var header = new HeaderViewModel
    {
        Title = "SIIL - Tablero Principal",
        IconPath = "siil.png",
        Description = "Plataforma de Inteligencia y Catálogo Nacional de Muestreo (SNIEn)",
        Section = "SIIL",
        ModuleInfo = JsonConvert.SerializeObject(new
        {
            title = "SIIL",
            description = "Registro y consultorio de información de litio",
            functionality = "Registro, consultoría y análisis de muestras y pronósticos",
            stage = "Operación",
            roles = new[] {
                new { icon = "flask", text = "Registro: captura de muestras" },
                new { icon = "map", text = "Consultorio: pronósticos y mapas" }
            }
        })
    };
}

@{
    bool existeBarreno = ViewBag.ExisteBarreno ?? false;
}

<div class="container-fluid p-4">
    @await Html.PartialAsync("_ViewHeader", header)

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            <i class="bi bi-check-circle me-2"></i>
            @TempData["SuccessMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <!-- FILA 1: KPIs (RESUMEN EJECUTIVO) -->
    <div class="row mb-4">
        <!-- KPI 1: Basado en Fuente [5] (Total registros) -->
        <div class="col-md-4">
            <div class="card text-white bg-primary mb-3 shadow-sm">
                <div class="card-header">Muestras Físicas</div>
                <div class="card-body">
                    <h2 class="card-title display-6">@Model.TotalMuestras</h2>
                    <p class="card-text"><small>Registros en Catálogo Nacional</small></p>
                </div>
            </div>
        </div>

        <!-- KPI 2: Basado en Fuente [3] (Pozos 'Muy Alto'/'Alto') -->
        <div class="col-md-4">
            <div class="card text-white bg-warning mb-3 shadow-sm">
                <div class="card-header text-dark">Oportunidades (Pronóstico)</div>
                <div class="card-body text-dark">
                    <h2 class="card-title display-6">@Model.PozosPrioritarios</h2>
                    <p class="card-text"><small>Pozos existentes con potencial Alto/Muy Alto</small></p>
                </div>
            </div>
        </div>

        <!-- KPI 3: Basado en Fuente [4] (Muestras con PPM calculado) -->
        <div class="col-md-4">
            <div class="card text-white bg-success mb-3 shadow-sm">
                <div class="card-header">Resultados Concluidos</div>
                <div class="card-body">
                    <h2 class="card-title display-6">@Model.MuestrasAnalizadas</h2>
                    <p class="card-text"><small>Muestras con cálculo de Litio Probable</small></p>
                </div>
            </div>
        </div>
    </div>

    <!-- FILA 2: ACCESOS DIRECTOS (NAVEGACIÓN) -->
    <div class="row gx-5">

        <!-- Módulo de Operación (Formularios) -->
        <div class="col-md-6 mb-4">
            <div class="card h-100 border-primary">
                <div class="card-body text-center">

                    <h3 class="card-title text-primary">
                        <i class="bi bi-pencil-square"></i> Operación Campo
                    </h3>

                    <p class="card-text text-muted">
                        Gestión de evidencia física y captura de datos.
                    </p>

                    <hr>

                    <!-- PASO 1: BARRENACIÓN -->
                    <a href="@Url.Action("Barrenacion", "SIIL")"
                    class="btn btn-success btn-lg w-100 mb-2">
                        <i class="bi bi-tools"></i> Cuestionario de Barrenación
                    </a>

                    <!-- PASO 2: REGISTRO DE MUESTRA -->
                    <a href="@Url.Action("CrearMuestra", "SIIL")"
                        class="btn btn-lg w-100 mb-2 @(existeBarreno ? "btn-primary" : "btn-outline-secondary disabled")">

                        <i class="bi bi-plus-circle"></i> Registro de Muestra
                    </a>

                    <!-- PASO 3 y 4 -->
                    <div class="d-flex justify-content-between mt-3">

                        <a href="#"
                        class="btn btn-outline-secondary btn-sm disabled">
                            Formulario Campo
                        </a>

                        <a href="#"
                        class="btn btn-outline-secondary btn-sm disabled">
                            Formulario Laboratorio
                        </a>

                    </div>

                </div>
            </div>
        </div>


        <!-- Módulo de Inteligencia -->
        <div class="col-md-6 mb-4">
            <div class="card h-100 border-warning">
                <div class="card-body text-center">

                    <h3 class="card-title text-warning text-dark">
                        <i class="bi bi-map"></i> Inteligencia (Pronóstico)
                    </h3>

                    <p class="card-text text-muted">
                        Visualización de insumos históricos y mapas de calor.
                    </p>

                    <hr>

                    <a href="#"
                    class="btn btn-outline-dark btn-lg w-100 mb-2 disabled">
                        <i class="bi bi-geo-alt"></i> Ver Mapa de Calor
                    </a>

                    <p class="small text-muted mt-2">
                        Fuente de datos: Calculadora Li probable_V4 [Insumo 202502]
                    </p>

                </div>
            </div>
        </div>

    </div>

    <!-- RESUMEN DE ACTIVIDAD -->
    <div class="row mt-4">
        <div class="col-12">
            <div class="card shadow-sm">
                <div class="card-header bg-light">
                    <h5 class="mb-0">
                        <i class="bi bi-clock-history me-2"></i>
                        Resumen de Actividad
                    </h5>
                </div>
                <div class="card-body">
                    <div class="row">
                        <div class="col-md-6">
                            <p class="mb-2"><strong>Usuario:</strong> @Model.NombreUsuario</p>
                            <p class="mb-2"><strong>Rol:</strong> <span class="badge bg-info">@Model.RolUsuario</span>
                            </p>
                        </div>
                        <div class="col-md-6 text-md-end">
                            <p class="mb-2"><strong>Última actualización:</strong> @DateTime.Now.ToString("dd/MM/yyyy                            HH:mm")</p>
                            <p class="mb-2">
                                <strong>Pozos en base:</strong>
                                <span class="badge bg-secondary">@(Model.PronosticosPozos?.Count ?? 0)</span>
                            </p>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>