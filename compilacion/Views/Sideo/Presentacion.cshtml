@{
    ViewData["Title"] = "SIDEO · Presentaciones 16:9";
}

@await Html.PartialAsync("_ViewHeader", ViewData["HeaderViewModel"] as NSIE.Models.HeaderViewModel)

@section Styles {
    <style>
        .presentation-deck {
            background-color: var(--sener-tinta);
            padding: var(--space-4) 0;
            border-radius: var(--radius-md);
            box-shadow: var(--shadow-card);
            display: flex;
            flex-direction: column;
            align-items: center;
            gap: var(--space-4);
            overflow: hidden;
        }

        /* 16:9 responsive container */
        .slide-stage {
            width: 100%;
            max-width: 1000px;
            aspect-ratio: 16 / 9;
            background: var(--sener-blanco);
            box-shadow: 0 10px 40px rgba(0,0,0,0.5);
            position: relative;
            overflow: hidden;
            border: 1px solid var(--sener-linea);
        }

        /* Individual Slides */
        .slide-item {
            width: 100%;
            height: 100%;
            display: none;
            flex-direction: column;
            padding: 5.5% 8.5%; /* Margin scales proportionately */
            box-sizing: border-box;
            background: var(--sener-blanco);
            color: var(--sener-tinta);
            font-family: var(--font-text);
            position: absolute;
            top: 0;
            left: 0;
            transition: opacity 0.4s ease;
            opacity: 0;
        }

        .slide-item.active {
            display: flex;
            opacity: 1;
        }

        /* Portada Slide Styles */
        .slide-portada {
            padding-bottom: 3.5%;
        }

        .slide-portada .logos {
            display: flex;
            align-items: center;
            gap: 20px;
            margin-bottom: 2%;
        }

        .slide-portada .logos img {
            height: clamp(30px, 4.5vw, 42px);
        }

        .slide-portada .dv {
            width: 1px;
            height: clamp(25px, 4vw, 38px);
            background: #E0DCD4;
        }

        .slide-portada .kick {
            font-size: clamp(12px, 1.6vw, 16px);
            font-weight: var(--fw-semibold);
            letter-spacing: var(--tracking-kicker);
            text-transform: uppercase;
            color: var(--sener-guinda);
        }

        .slide-portada h1 {
            font-family: var(--font-display);
            font-weight: var(--fw-regular);
            font-size: clamp(32px, 5.5vw, 56px);
            line-height: var(--lh-tight);
            letter-spacing: var(--tracking-tight);
            margin: 1.5% 0 0;
            max-width: 18ch;
            color: var(--sener-tinta);
        }

        .slide-portada .range {
            display: flex;
            align-items: center;
            gap: 18px;
            margin-top: 2%;
        }

        .slide-portada .range .y {
            font-family: var(--font-display);
            font-weight: var(--fw-medium);
            font-size: clamp(20px, 3.2vw, 34px);
            color: var(--sener-guinda);
            white-space: nowrap;
        }

        .slide-portada .range .ln {
            width: 90px;
            height: 3px;
            background: var(--sener-dorado);
        }

        .slide-portada .range .sub {
            font-size: clamp(12px, 1.6vw, 17px);
            color: var(--sener-gris);
            max-width: 32ch;
        }

        .slide-portada .img-container {
            flex: 1;
            position: relative;
            overflow: hidden;
            background: var(--sener-guinda);
            margin-top: 3%;
            border-radius: var(--radius-sm);
        }

        .slide-portada .img-container img {
            width: 100%;
            height: 100%;
            object-fit: cover;
            object-position: center 42%;
        }

        .slide-portada .gold-bar {
            position: absolute;
            left: 0;
            right: 0;
            top: 0;
            height: 4px;
            background: var(--sener-dorado);
        }

        .slide-portada .foot {
            display: flex;
            gap: 56px;
            margin-top: 3%;
        }

        .slide-portada .foot .l {
            font-size: clamp(10px, 1.4vw, 15px);
            font-weight: var(--fw-bold);
            letter-spacing: 0.1em;
            text-transform: uppercase;
            color: var(--sener-gris-claro);
        }

        .slide-portada .foot .v {
            font-size: clamp(12px, 1.6vw, 18px);
            font-weight: var(--fw-bold);
            margin-top: 4px;
        }

        /* Sección Slide Styles */
        .slide-seccion {
            justify-content: center;
            position: relative;
        }

        .slide-seccion .bar {
            position: absolute;
            left: 0;
            top: 0;
            bottom: 0;
            width: 10px;
            background: var(--sener-guinda);
        }

        .slide-seccion .logos {
            position: absolute;
            top: 5.5%;
            left: 8.5%;
            display: flex;
            align-items: center;
            gap: 24px;
        }

        .slide-seccion .logos img {
            height: clamp(35px, 5.5vw, 64px);
        }

        .slide-seccion .dv {
            width: 1px;
            height: clamp(30px, 4.5vw, 54px);
            background: #E0DCD4;
        }

        .slide-seccion .num {
            position: absolute;
            right: 5.5%;
            bottom: -5%;
            font-family: var(--font-display);
            font-weight: var(--fw-regular);
            font-size: clamp(180px, 30vw, 420px);
            line-height: 1;
            color: var(--sener-papel);
            z-index: 1;
            user-select: none;
        }

        .slide-seccion .content-wrap {
            position: relative;
            z-index: 2;
        }

        .slide-seccion .kick {
            display: flex;
            align-items: center;
            gap: 10px;
            font-size: clamp(13px, 1.8vw, 18px);
            font-weight: var(--fw-bold);
            letter-spacing: var(--tracking-kicker);
            text-transform: uppercase;
            color: var(--sener-guinda);
        }

        .slide-seccion h1 {
            font-family: var(--font-display);
            font-weight: var(--fw-regular);
            font-size: clamp(40px, 7vw, 70px);
            line-height: 1.1;
            margin: 2% 0 0;
            color: var(--sener-tinta);
        }

        .slide-seccion .rule {
            display: flex;
            align-items: center;
            gap: 18px;
            margin-top: 3%;
        }

        .slide-seccion .rule .ln {
            width: 100px;
            height: 4px;
            background: var(--sener-dorado);
        }

        .slide-seccion .rule .t {
            font-size: clamp(14px, 2vw, 21px);
            color: var(--sener-tinta);
            max-width: 30ch;
        }

        /* Datos Slide Styles */
        .slide-datos {
            padding: 5.5% 6.5%;
        }

        .slide-datos .head {
            display: flex;
            justify-content: space-between;
            align-items: baseline;
            border-bottom: 1px solid var(--sener-linea);
            padding-bottom: 2%;
        }

        .slide-datos .head .k {
            font-size: clamp(11px, 1.5vw, 16px);
            font-weight: var(--fw-bold);
            letter-spacing: var(--tracking-kicker);
            text-transform: uppercase;
            color: var(--sener-guinda);
        }

        .slide-datos .head .s {
            font-size: clamp(11px, 1.5vw, 16px);
            letter-spacing: 0.06em;
            text-transform: uppercase;
            color: var(--sener-gris-claro);
        }

        .slide-datos h2 {
            font-family: var(--font-display);
            font-weight: var(--fw-regular);
            font-size: clamp(24px, 4vw, 40px);
            margin: 2.5% 0 0;
            color: var(--sener-tinta);
        }

        .slide-datos .kpis {
            display: grid;
            grid-template-columns: repeat(3, 1fr);
            gap: 30px;
            margin-top: 3.5%;
        }

        .slide-datos .big-num {
            font-family: var(--font-display);
            font-size: clamp(36px, 5.8vw, 58px);
            line-height: 0.82;
            color: var(--sener-guinda);
        }

        .slide-datos .lab {
            font-size: clamp(11px, 1.5vw, 16px);
            color: var(--sener-gris);
            margin-top: 6px;
        }

        .slide-datos .bars {
            flex: 1;
            display: flex;
            flex-direction: column;
            justify-content: center;
            gap: 12px;
            margin-top: 2%;
        }

        .slide-datos .br {
            display: flex;
            align-items: center;
            gap: 14px;
        }

        .slide-datos .br .n {
            width: clamp(80px, 14vw, 140px);
            font-size: clamp(13px, 1.8vw, 18px);
            flex: none;
        }

        .slide-datos .br .track {
            flex: 1;
            height: clamp(14px, 2.2vw, 22px);
            background: var(--sener-papel);
            border-radius: 4px;
            overflow: hidden;
        }

        .slide-datos .br .fill {
            height: 100%;
            border-radius: 4px;
            display: block;
        }

        .slide-datos .br .v {
            width: clamp(60px, 9vw, 90px);
            text-align: right;
            font-family: var(--font-mono);
            font-weight: var(--fw-bold);
            font-size: clamp(13px, 1.8vw, 18px);
        }

        .slide-datos .foot {
            display: flex;
            justify-content: space-between;
            border-top: 1px solid var(--sener-linea);
            padding-top: 2%;
            margin-top: 3%;
            font-size: clamp(11px, 1.5vw, 16px);
            color: var(--sener-gris-claro);
        }

        /* Navigation controls */
        .deck-controls {
            display: flex;
            gap: var(--space-3);
            align-items: center;
            margin-top: var(--space-2);
        }

        .deck-info {
            color: var(--sener-blanco);
            font-family: var(--font-mono);
            font-size: 14px;
        }
    </style>
}

<div class="container-fluid shell-page-container py-3 spec-container">
    <!-- breadcrumbs -->
    <div class="gestor-breadcrumbs">
        <nav aria-label="breadcrumb">
            <ol class="breadcrumb">
                <li class="breadcrumb-item"><a href="@Url.Action("Index", "Home")">Inicio</a></li>
                <li class="breadcrumb-item"><a href="@Url.Action("Index", "Sideo")">Sistema de Diseño</a></li>
                <li class="breadcrumb-item active" aria-current="page">Láminas 16:9</li>
            </ol>
        </nav>
    </div>

    <div class="mb-4">
        <a href="@Url.Action("Index", "Sideo")" class="sideo-btn sideo-btn-outline">
            <i class="bi bi-arrow-left"></i> Volver a Especificaciones
        </a>
    </div>

    <!-- STAGE PLAYER -->
    <div class="presentation-deck">
        <div class="slide-stage">
            
            <!-- SLIDE 1: PORTADA -->
            <div class="slide-item slide-portada active" id="slide-0">
                <div class="logos">
                    <img src="~/img/sideo/logo_gob.png" alt="Gobierno de México">
                    <div class="dv"></div>
                    <img src="~/img/sideo/logo_sener.png" alt="Secretaría de Energía">
                </div>
                <div class="tt">
                    <div class="kick">Subsecretaría de Planeación y Transición Energética</div>
                    <h1>Expansión del Sistema Eléctrico Nacional</h1>
                    <div class="range">
                        <span class="y">2024 — 2030</span>
                        <span class="ln"></span>
                        <span class="sub">Plan de expansión de la generación, el almacenamiento y la transición a energías limpias.</span>
                    </div>
                </div>
                <div class="img-container">
                    <img src="~/img/sideo/reno_portada.png" alt="Generación Renovable">
                    <div class="gold-bar"></div>
                </div>
                <div class="foot">
                    <div>
                        <div class="l">Versión</div>
                        <div class="v">1.0</div>
                    </div>
                    <div>
                        <div class="l">Fecha</div>
                        <div class="v">25 de junio de 2026</div>
                    </div>
                    <div>
                        <div class="l">Fuente</div>
                        <div class="v">SENER · CFE · CENACE</div>
                    </div>
                </div>
            </div>

            <!-- SLIDE 2: SECCIÓN -->
            <div class="slide-item slide-seccion" id="slide-1">
                <div class="bar"></div>
                <div class="logos">
                    <img src="~/img/sideo/logo_gob.png" alt="Gobierno de México">
                    <div class="dv"></div>
                    <img src="~/img/sideo/logo_sener.png" alt="Secretaría de Energía">
                </div>
                <div class="num">01</div>
                <div class="content-wrap">
                    <div class="kick">● Sección 01</div>
                    <h1>Nueva capacidad</h1>
                    <div class="rule">
                        <span class="ln"></span>
                        <span class="t">Cuánta nueva generación suma el país entre 2026 y 2030 y quién la construye.</span>
                    </div>
                </div>
            </div>

            <!-- SLIDE 3: DATOS -->
            <div class="slide-item slide-datos" id="slide-2">
                <div class="head">
                    <div class="k">Sección 01 · Nueva capacidad</div>
                    <div class="s">2026 — 2030</div>
                </div>
                <h2>Adiciones de capacidad por región.</h2>
                <div class="kpis">
                    <div>
                        <div class="big-num">122,298</div>
                        <div class="lab">MW instalados · 2030</div>
                    </div>
                    <div>
                        <div class="big-num">32,475</div>
                        <div class="lab">MW nuevos · +30.76%</div>
                    </div>
                    <div>
                        <div class="big-num">68.89%</div>
                        <div class="lab">Generación limpia</div>
                    </div>
                </div>
                <div class="bars">
                    <div class="br">
                        <span class="n">Noreste</span>
                        <span class="track"><span class="fill" style="width:100%; background:var(--tec-fv)"></span></span>
                        <span class="v">7,767</span>
                    </div>
                    <div class="br">
                        <span class="n">Peninsular</span>
                        <span class="track"><span class="fill" style="width:60%; background:var(--tec-eo)"></span></span>
                        <span class="v">4,684</span>
                    </div>
                    <div class="br">
                        <span class="n">Oriental</span>
                        <span class="track"><span class="fill" style="width:30%; background:var(--tec-hid)"></span></span>
                        <span class="v">2,310</span>
                    </div>
                </div>
                <div class="foot">
                    <span>Fuente: SENER · CENACE (2024). Cifras en MW.</span>
                    <span>03</span>
                </div>
            </div>

        </div>

        <!-- CONTROLS -->
        <div class="deck-controls">
            <button type="button" class="sideo-btn sideo-btn-outline" id="btnPrev" style="border-color: #ffffff; color: #ffffff !important;">
                <i class="bi bi-chevron-left"></i> Anterior
            </button>
            <span class="deck-info" id="deckInfo">1 / 3</span>
            <button type="button" class="sideo-btn sideo-btn-outline" id="btnNext" style="border-color: #ffffff; color: #ffffff !important;">
                Siguiente <i class="bi bi-chevron-right"></i>
            </button>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        let currentSlideIndex = 0;
        const totalSlides = 3;

        function showSlide(index) {
            if (index < 0 || index >= totalSlides) return;

            // Update DOM states
            document.querySelectorAll('.slide-item').forEach((slide, i) => {
                if (i === index) {
                    slide.classList.add('active');
                } else {
                    slide.classList.remove('active');
                }
            });

            currentSlideIndex = index;
            document.getElementById('deckInfo').textContent = `${currentSlideIndex + 1} / ${totalSlides}`;
            
            // Disable buttons if bounds reached
            document.getElementById('btnPrev').disabled = currentSlideIndex === 0;
            document.getElementById('btnNext').disabled = currentSlideIndex === totalSlides - 1;
        }

        // Initialize
        $(document).ready(function() {
            showSlide(0);

            $('#btnPrev').click(function() {
                showSlide(currentSlideIndex - 1);
            });

            $('#btnNext').click(function() {
                showSlide(currentSlideIndex + 1);
            });

            // Keyboard navigation
            $(document).keydown(function(e) {
                if (e.keyCode === 37) { // Left arrow
                    showSlide(currentSlideIndex - 1);
                } else if (e.keyCode === 39) { // Right arrow
                    showSlide(currentSlideIndex + 1);
                }
            });
        });
    </script>
}
