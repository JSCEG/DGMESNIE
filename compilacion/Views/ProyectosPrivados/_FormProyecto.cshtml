@model NSIE.Models.ProyectosPrivados.ProyectoForm

<div class="row g-4">
    <!-- 1. IDENTIFICACIÓN Y DATOS BÁSICOS -->
    <div class="col-12">
        <h3 class="h5 pb-2 mb-3" style="color: var(--color-gobmx-guinda, #9B2247); border-bottom: 2px solid #E0E0E0; font-weight: 700;">
            <i class="fas fa-id-card"></i> 1. Identificación y Datos Básicos
        </h3>
    </div>
    
    <div class="col-md-4">
        <div class="form-group mb-3">
            <label asp-for="Nombre" class="form-label" style="font-weight: 600;">Nombre del Proyecto (Real) *</label>
            <input asp-for="Nombre" class="form-control" placeholder="Ej. Tizimin II" required />
            <span asp-validation-for="Nombre" class="text-danger"></span>
        </div>
    </div>
    <div class="col-md-4">
        <div class="form-group mb-3">
            <label asp-for="Status" class="form-label" style="font-weight: 600;">Estatus del Proyecto</label>
            <input asp-for="Status" class="form-control" placeholder="Ej. En Operación" />
        </div>
    </div>
    <div class="col-md-4">
        <div class="form-group mb-3">
            <label asp-for="EmpresaId" class="form-label" style="font-weight: 600;">Promovente / Grupo Asignado</label>
            <select asp-for="EmpresaId" class="form-select" asp-items="@(new SelectList(ViewBag.Empresas, "Id", "Nombre"))">
                <option value="">-- Seleccionar Empresa --</option>
            </select>
        </div>
    </div>

    <div class="col-md-4">
        <div class="form-group mb-3">
            <label asp-for="Promovente" class="form-label" style="font-weight: 600;">Nombre Promovente (Texto libre)</label>
            <input asp-for="Promovente" class="form-control" />
        </div>
    </div>
    <div class="col-md-4">
        <div class="form-group mb-3">
            <label asp-for="GrupoEconomico" class="form-label" style="font-weight: 600;">Grupo Económico (Texto libre)</label>
            <input asp-for="GrupoEconomico" class="form-control" />
        </div>
    </div>
    <div class="col-md-4">
        <div class="form-group mb-3">
            <label asp-for="Tipo" class="form-label" style="font-weight: 600;">Tecnología / Tipo</label>
            <select asp-for="Tipo" class="form-select">
                <option value="">-- Seleccionar --</option>
                <option value="FV">FV (Fotovoltaica)</option>
                <option value="EO">EO (Eólica)</option>
                <option value="Hidro">Hidro (Hidroeléctrica)</option>
                <option value="COG">COG (Cogeneración)</option>
                <option value="CI/COG">CI/COG</option>
                <option value="GEN">GEN (Generación)</option>
            </select>
        </div>
    </div>

    <div class="col-md-3">
        <div class="form-group mb-3">
            <label asp-for="CapacidadMW" class="form-label" style="font-weight: 600;">Capacidad (MW)</label>
            <input asp-for="CapacidadMW" type="number" step="0.001" class="form-control" />
        </div>
    </div>
    <div class="col-md-3">
        <div class="form-group mb-3">
            <label asp-for="Renovable" class="form-label" style="font-weight: 600;">¿Es Renovable?</label>
            <select asp-for="Renovable" class="form-select">
                <option value="true">Sí</option>
                <option value="false">No</option>
            </select>
        </div>
    </div>
    <div class="col-md-3">
        <div class="form-group mb-3">
            <label asp-for="Anio" class="form-label" style="font-weight: 600;">Año</label>
            <input asp-for="Anio" type="number" class="form-control" />
        </div>
    </div>
    <div class="col-md-3">
        <div class="form-group mb-3">
            <label asp-for="Mes" class="form-label" style="font-weight: 600;">Mes</label>
            <input asp-for="Mes" class="form-control" />
        </div>
    </div>

    <div class="col-md-6">
        <div class="form-group mb-3">
            <label asp-for="AdicionesSustituciones" class="form-label" style="font-weight: 600;">Adiciones o Sustituciones</label>
            <input asp-for="AdicionesSustituciones" class="form-control" />
        </div>
    </div>
    <div class="col-md-6">
        <div class="form-group mb-3">
            <label asp-for="ContratoUnidad" class="form-label" style="font-weight: 600;">Contrato o Unidad</label>
            <input asp-for="ContratoUnidad" class="form-control" />
        </div>
    </div>

    <!-- 2. GEOGRAFÍA Y CONTROL -->
    <div class="col-12 mt-4">
        <h3 class="h5 pb-2 mb-3" style="color: var(--color-gobmx-guinda, #9B2247); border-bottom: 2px solid #E0E0E0; font-weight: 700;">
            <i class="fas fa-globe-americas"></i> 2. Ubicación y Geografía
        </h3>
    </div>
    <div class="col-md-4">
        <div class="form-group mb-3">
            <label asp-for="EntidadFederativa" class="form-label" style="font-weight: 600;">Entidad Federativa</label>
            <input asp-for="EntidadFederativa" class="form-control" />
        </div>
    </div>
    <div class="col-md-4">
        <div class="form-group mb-3">
            <label asp-for="Municipio" class="form-label" style="font-weight: 600;">Municipio</label>
            <input asp-for="Municipio" class="form-control" />
        </div>
    </div>

    <!-- Aviso de Coordenadas Invertidas -->
    <div class="col-12 mb-2">
        <div class="alert alert-warning d-flex align-items-start" role="alert" style="border-left: 4px solid #D6A258; background-color: var(--shell-surface-2, #FCF8F2); color: var(--shell-accent-2, #856404); font-size: 13.5px; border-radius: 6px; padding: 12px 15px;">
            <i class="fas fa-exclamation-triangle me-3 mt-1" style="font-size: 18px; color: #D6A258;"></i>
            <div>
                <strong>Aviso sobre Coordenadas (Base de Datos):</strong> 
                Debido a la estructura histórica del sistema, los campos de coordenadas están <strong>invertidos</strong>:
                <ul class="mb-0 mt-1" style="padding-left: 20px;">
                    <li>El campo <strong>Latitud</strong> guarda la <strong>Longitud</strong> (valor negativo para México, ej. <code>-106.5116839965</code>).</li>
                    <li>El campo <strong>Longitud</strong> guarda la <strong>Latitud</strong> (valor positivo para México, ej. <code>30.6174885891</code>).</li>
                </ul>
            </div>
        </div>
    </div>

    <div class="col-md-6">
        <div class="form-group mb-3">
            <label asp-for="Latitud" class="form-label" style="font-weight: 600;">Latitud (almacena Longitud)</label>
            <input asp-for="Latitud" type="text" class="form-control" placeholder="Ej. -106.5116839965" />
            <span asp-validation-for="Latitud" class="text-danger d-block"></span>
            <small class="text-muted" style="font-size: 11px;">Oeste (negativo): entre -118 y -86</small>
        </div>
    </div>
    <div class="col-md-6">
        <div class="form-group mb-3">
            <label asp-for="Longitud" class="form-label" style="font-weight: 600;">Longitud (almacena Latitud)</label>
            <input asp-for="Longitud" type="text" class="form-control" placeholder="Ej. 30.6174885891" />
            <span asp-validation-for="Longitud" class="text-danger d-block"></span>
            <small class="text-muted" style="font-size: 11px;">Norte (positivo): entre 14 y 33</small>
        </div>
    </div>

    <div class="col-md-4">
        <div class="form-group mb-3">
            <label asp-for="GerenciaControl" class="form-label" style="font-weight: 600;">Gerencia de Control</label>
            <input asp-for="GerenciaControl" class="form-control" />
        </div>
    </div>
    <div class="col-md-4">
        <div class="form-group mb-3">
            <label asp-for="RegionTransmision" class="form-label" style="font-weight: 600;">Región de Transmisión</label>
            <input asp-for="RegionTransmision" class="form-control" />
        </div>
    </div>
    <div class="col-md-4">
        <div class="form-group mb-3">
            <label asp-for="Origen" class="form-label" style="font-weight: 600;">Origen del Proyecto</label>
            <input asp-for="Origen" class="form-control" placeholder="Ej. Privados Firmes" />
        </div>
    </div>

    <!-- 3. DETALLE DE OBRA Y REGULATORIO -->
    <div class="col-12 mt-4">
        <h3 class="h5 pb-2 mb-3" style="color: var(--color-gobmx-guinda, #9B2247); border-bottom: 2px solid #E0E0E0; font-weight: 700;">
            <i class="fas fa-tools"></i> 3. Fechas de Obra y Regulatorio
        </h3>
    </div>
    <div class="col-md-4">
        <div class="form-group mb-3">
            <label asp-for="FechaInicioObras" class="form-label" style="font-weight: 600;">Inicio de Obras</label>
            <input asp-for="FechaInicioObras" type="date" class="form-control" />
        </div>
    </div>
    <div class="col-md-4">
        <div class="form-group mb-3">
            <label asp-for="FechaTerminacionObras" class="form-label" style="font-weight: 600;">Terminación de Obras</label>
            <input asp-for="FechaTerminacionObras" type="date" class="form-control" />
        </div>
    </div>
    <div class="col-md-4">
        <div class="form-group mb-3">
            <label asp-for="FechaEntradaOperacion" class="form-label" style="font-weight: 600;">Entrada en Operación</label>
            <input asp-for="FechaEntradaOperacion" type="date" class="form-control" />
        </div>
    </div>

    <div class="col-md-4">
        <div class="form-group mb-3">
            <label asp-for="Firmes" class="form-label" style="font-weight: 600;">Firme</label>
            <input asp-for="Firmes" class="form-control" />
        </div>
    </div>
    <div class="col-md-4">
        <div class="form-group mb-3">
            <label asp-for="PorcentajeConstruccion" class="form-label" style="font-weight: 600;">% Construcción</label>
            <input asp-for="PorcentajeConstruccion" type="number" step="0.01" class="form-control" />
        </div>
    </div>
    <div class="col-md-4">
        <div class="form-group mb-3">
            <label asp-for="NumeroPermiso" class="form-label" style="font-weight: 600;">Número de Permiso</label>
            <input asp-for="NumeroPermiso" class="form-control" />
        </div>
    </div>

    <div class="col-md-4">
        <div class="form-group mb-3">
            <label asp-for="FolioEvIS_MISSE" class="form-label" style="font-weight: 600;">Folio EvIS/MISSE</label>
            <input asp-for="FolioEvIS_MISSE" class="form-control" />
        </div>
    </div>
    <div class="col-md-4">
        <div class="form-group mb-3">
            <label asp-for="StatusEvIS_MISSE" class="form-label" style="font-weight: 600;">Estatus EvIS/MISSE</label>
            <input asp-for="StatusEvIS_MISSE" class="form-control" />
        </div>
    </div>
    <div class="col-md-4">
        <div class="form-group mb-3">
            <label asp-for="StatusCPLI" class="form-label" style="font-weight: 600;">Estatus CPLI</label>
            <input asp-for="StatusCPLI" class="form-control" />
        </div>
    </div>

    <div class="col-md-12">
        <div class="form-group mb-3">
            <label asp-for="ConflictosSociales" class="form-label" style="font-weight: 600;">Conflictos Sociales Detectados</label>
            <textarea asp-for="ConflictosSociales" class="form-control" rows="2"></textarea>
        </div>
    </div>

    <div class="col-md-12">
        <div class="form-group mb-3">
            <label asp-for="EstadoProgramaObras" class="form-label" style="font-weight: 600;">Estado actual del Programa de Obras</label>
            <textarea asp-for="EstadoProgramaObras" class="form-control" rows="2"></textarea>
        </div>
    </div>

    <div class="col-md-6">
        <div class="form-group mb-3">
            <label asp-for="TramiteCNE" class="form-label" style="font-weight: 600;">Trámite en proceso con CNE</label>
            <textarea asp-for="TramiteCNE" class="form-control" rows="2"></textarea>
        </div>
    </div>
    <div class="col-md-6">
        <div class="form-group mb-3">
            <label asp-for="ObservacionesCNE" class="form-label" style="font-weight: 600;">Observaciones CNE</label>
            <textarea asp-for="ObservacionesCNE" class="form-control" rows="2"></textarea>
        </div>
    </div>

    <!-- 4. SEMARNAT Y SECTOR AMBIENTAL -->
    <div class="col-12 mt-4">
        <h3 class="h5 pb-2 mb-3" style="color: var(--color-gobmx-guinda, #9B2247); border-bottom: 2px solid #E0E0E0; font-weight: 700;">
            <i class="fas fa-leaf"></i> 4. Trámites Ambientales (SEMARNAT)
        </h3>
    </div>
    <div class="col-md-4">
        <div class="form-group mb-3">
            <label asp-for="EstatusSemarnat" class="form-label" style="font-weight: 600;">Estatus SEMARNAT</label>
            <input asp-for="EstatusSemarnat" class="form-control" />
        </div>
    </div>
    <div class="col-md-8">
        <div class="form-group mb-3">
            <label asp-for="TramitesSemarnat" class="form-label" style="font-weight: 600;">Trámites SEMARNAT</label>
            <input asp-for="TramitesSemarnat" class="form-control" />
        </div>
    </div>
    <div class="col-md-12">
        <div class="form-group mb-3">
            <label asp-for="ObservacionesSemarnat" class="form-label" style="font-weight: 600;">Observaciones SEMARNAT</label>
            <textarea asp-for="ObservacionesSemarnat" class="form-control" rows="2"></textarea>
        </div>
    </div>

    <!-- 5. ANÁLISIS Y SEMÁFORO -->
    <div class="col-12 mt-4">
        <h3 class="h5 pb-2 mb-3" style="color: var(--color-gobmx-guinda, #9B2247); border-bottom: 2px solid #E0E0E0; font-weight: 700;">
            <i class="fas fa-tachometer-alt"></i> 5. Análisis, Clasificación y Semáforo
        </h3>
    </div>
    
    <div class="col-md-3">
        <div class="form-group mb-3">
            <label asp-for="ClasificacionId" class="form-label" style="font-weight: 600;">Clasificación Operativa</label>
            <select asp-for="ClasificacionId" class="form-select" asp-items="@(new SelectList(ViewBag.Clasificaciones, "Id", "Nombre"))">
                <option value="">-- Seleccionar --</option>
            </select>
        </div>
    </div>
    <div class="col-md-3">
        <div class="form-group mb-3">
            <label asp-for="PrioridadId" class="form-label" style="font-weight: 600;">Prioridad</label>
            <select asp-for="PrioridadId" class="form-select" asp-items="@(new SelectList(ViewBag.Prioridades, "Id", "Nombre"))">
                <option value="">-- Seleccionar --</option>
            </select>
        </div>
    </div>
    <div class="col-md-3">
        <div class="form-group mb-3">
            <label asp-for="SemaforoId" class="form-label" style="font-weight: 600;">Semáforo de Alerta</label>
            <select asp-for="SemaforoId" class="form-select" asp-items="@(new SelectList(ViewBag.Semaforos, "Id", "Nombre"))">
                <option value="">-- Seleccionar --</option>
            </select>
        </div>
    </div>
    <div class="col-md-3">
        <div class="form-group mb-3">
            <label asp-for="SemaforoPPT" class="form-label" style="font-weight: 600;">Semáforo Presentación (PPT)</label>
            <input asp-for="SemaforoPPT" class="form-control" />
        </div>
    </div>

    <div class="col-md-4">
        <div class="form-group mb-3">
            <label asp-for="Categoria" class="form-label" style="font-weight: 600;">Categoría del Proyecto</label>
            <input asp-for="Categoria" class="form-control" />
        </div>
    </div>
    <div class="col-md-4">
        <div class="form-group mb-3">
            <label asp-for="InteresadaEnContinuar" class="form-label" style="font-weight: 600;">¿Interesada en Continuar?</label>
            <select asp-for="InteresadaEnContinuar" class="form-select">
                <option value="true">Sí</option>
                <option value="false">No</option>
            </select>
        </div>
    </div>
    <div class="col-md-4">
        <div class="form-group mb-3">
            <label asp-for="Fuente" class="form-label" style="font-weight: 600;">Fuente de la Información</label>
            <input asp-for="Fuente" class="form-control" />
        </div>
    </div>

    <div class="col-md-12">
        <div class="form-group mb-3">
            <label asp-for="ObservacionesUEVISPI" class="form-label" style="font-weight: 600;">Observaciones UEVISPI</label>
            <textarea asp-for="ObservacionesUEVISPI" class="form-control" rows="2"></textarea>
        </div>
    </div>

    <div class="col-md-12">
        <div class="form-group mb-3">
            <label asp-for="ResumenCaso" class="form-label" style="font-weight: 600;">Resumen del Caso</label>
            <textarea asp-for="ResumenCaso" class="form-control" rows="3"></textarea>
        </div>
    </div>

    <div class="col-md-12">
        <div class="form-group mb-3">
            <label asp-for="PropuestaAtencion" class="form-label" style="font-weight: 600;">Propuesta de Atención</label>
            <textarea asp-for="PropuestaAtencion" class="form-control" rows="3"></textarea>
        </div>
    </div>

    <div class="col-md-12">
        <div class="form-group mb-3">
            <label asp-for="SiguientesPasos" class="form-label" style="font-weight: 600;">Siguientes Pasos</label>
            <textarea asp-for="SiguientesPasos" class="form-control" rows="3"></textarea>
        </div>
    </div>

    <div class="col-md-12">
        <div class="form-group mb-3">
            <label asp-for="RazonesBreves" class="form-label" style="font-weight: 600;">Razones (Breves)</label>
            <textarea asp-for="RazonesBreves" class="form-control" rows="2"></textarea>
        </div>
    </div>

    <div class="col-md-4">
        <div class="form-group mb-3">
            <label asp-for="RequiereAlmacenamiento" class="form-label" style="font-weight: 600;">¿Requiere Almacenamiento?</label>
            <input asp-for="RequiereAlmacenamiento" class="form-control" />
        </div>
    </div>
    <div class="col-md-4">
        <div class="form-group mb-3">
            <label asp-for="FechaUltimaActualizacion" class="form-label" style="font-weight: 600;">Fecha Última Actualización</label>
            <input asp-for="FechaUltimaActualizacion" type="date" class="form-control" />
        </div>
    </div>
    <div class="col-md-4">
        <div class="form-group mb-3">
            <label asp-for="FuenteUltimaActualizacion" class="form-label" style="font-weight: 600;">Fuente Última Actualización</label>
            <input asp-for="FuenteUltimaActualizacion" class="form-control" />
        </div>
    </div>
</div>
