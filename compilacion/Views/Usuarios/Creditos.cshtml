@model List<Credito>;
@using Microsoft.AspNetCore.Http
@using Newtonsoft.Json
@using NSIE.Models
@inject IHttpContextAccessor HttpContextAccessor

@{
    var httpContext = HttpContextAccessor.HttpContext;
    var perfilUsuarioJson = httpContext.Session.GetString("PerfilUsuario");
    var perfilUsuario = JsonConvert.DeserializeObject<PerfilUsuario>(perfilUsuarioJson);

    ViewData["NombreUsuario"] = perfilUsuario.Nombre;
    ViewData["RolUsuario"] = perfilUsuario.Rol;
    ViewData["IDUsuario"] = perfilUsuario.IdUsuario;

    var ordenSecciones = new List<string> { "Líder del Proyecto", "Desarrollo del Proyecto", "Colaboradores del Proyecto" };

    // Agrupa los créditos por sección y luego ordénalos por CreditoID de manera descendente
    var creditosAgrupados = Model
    .GroupBy(c => c.Seccion)
    .OrderBy(g => ordenSecciones.IndexOf(g.Key))
    .Select(g => new { Seccion = g.Key, Creditos = g.OrderBy(c => c.CreditoID) })
    .ToList();
}

@{
    ViewData["Title"] = "Créditos";

    var header = new HeaderViewModel
    {
        Title = "Créditos",
        IconPath = "creditos.png",
        Description = "Equipo responsable del diseño, desarrollo y operación de la plataforma.",
        Section = "Acerca de",
        ModuleInfo = JsonConvert.SerializeObject(new
        {
            title = "Créditos",
            description = "Reconocimiento al equipo que diseñó, desarrolló y opera la plataforma.",
            functionality = "Consulta el directorio del equipo del proyecto y su registro de propiedad intelectual.",
            stage = "Información"
        })
    };
}

@await Html.PartialAsync("_ViewHeader", header)

@section Styles {
    <style>
        .credito-item {
            display: flex;
            gap: 1.25rem;
            align-items: flex-start;
            margin-bottom: 1.5rem;
        }

        .credito-item__foto {
            flex: 0 0 auto;
            width: 132px;
            height: 132px;
            border-radius: 50%;
            object-fit: cover;
            border: 3px solid rgba(180, 137, 52, 0.35);
            background: var(--shell-surface-2, #f8fafc);
        }

        .credito-item__nombre {
            margin-bottom: 0.15rem;
            color: var(--shell-accent, var(--shell-guinda));
            font-weight: 700;
        }

        .credito-item__cargo {
            color: var(--shell-muted, #617083);
            font-size: 0.95rem;
        }

        .credito-item hr {
            margin: 0.5rem 0;
            border-color: rgba(180, 137, 52, 0.35);
            opacity: 1;
        }

        .creditos-registro {
            padding: 1rem 1.25rem;
            margin-bottom: 1.75rem;
            border: 1px solid rgba(30, 91, 79, 0.22);
            border-left: 4px solid var(--shell-verde, #1e5b4f);
            border-radius: 14px;
            background: var(--shell-surface, #ffffff);
        }

        .creditos-registro h5 {
            color: var(--shell-accent-3, var(--shell-verde));
            font-weight: 800;
        }

        @@media (max-width: 575.98px) {
            .credito-item {
                flex-direction: column;
                align-items: center;
                text-align: center;
            }

            .credito-item__foto {
                width: 96px;
                height: 96px;
            }
        }
    </style>
}

<div class="container">
    <nav aria-label="breadcrumb" class="mb-4">
        <ol class="breadcrumb">
            <li class="breadcrumb-item"><a href="@Url.Action("Index", "Home")"><i class="fas fa-home me-1"></i>Inicio</a></li>
            <li class="breadcrumb-item active" aria-current="page">@ViewData["Title"]</li>
        </ol>
    </nav>

    <div class="creditos-registro">
        <h5>EnerGeoCRE</h5>
        <p class="mb-1"><strong>Número de registro ante INDAUTOR:</strong> 03-2023-081012481700-01</p>
        <p class="mb-0"><strong>IMPI:</strong> 2985463</p>
    </div>

    <section class="creditos">
        @foreach (var grupo in creditosAgrupados)
        {
            if (ordenSecciones.Contains(grupo.Seccion))
            {
                <h3 class="form-section-title">@grupo.Seccion</h3>
                <div class="row">
                    @foreach (var credito in grupo.Creditos)
                    {
                        <div class="col-12 col-lg-6">
                            <div class="credito-item">
                                <img class="credito-item__foto" src="@credito.ImagenUrl" alt="@credito.Nombre" />
                                <div>
                                    <h4 class="credito-item__nombre">@credito.Nombre</h4>
                                    <div class="credito-item__cargo">@credito.Cargo <a href="@credito.PaginaWeb">@credito.PaginaWeb</a></div>
                                    <hr>
                                    <p class="mb-0">@credito.Actividades</p>
                                </div>
                            </div>
                        </div>
                    }
                </div>
            }
        }
    </section>
</div>



@section scripts {


}
