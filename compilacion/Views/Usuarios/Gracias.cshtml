@using Microsoft.AspNetCore.Http
@using Newtonsoft.Json
@using NSIE.Models
@inject IHttpContextAccessor HttpContextAccessor

@{
    ViewData["Title"] = "Gracias";

    var header = new HeaderViewModel
    {
        Title = "Gracias",
        IconPath = "analisis.png",
        Description = "Tu opinión fue registrada correctamente.",
        Section = "Participación",
        ModuleInfo = JsonConvert.SerializeObject(new
        {
            title = "Gracias por participar",
            description = "Confirmación de que la encuesta fue enviada con éxito.",
            stage = "Participación"
        })
    };
}

@await Html.PartialAsync("_ViewHeader", header)

<div class="container text-center">
    <h3 class="form-section-title justify-content-center">¡Gracias por tu participación!</h3>
    <p>Tu opinión ha sido recibida con éxito.</p>
    <div class="mb-4">
        <img src="@Cdn.Url/img_snier/vistas/energeo_circulo.png" alt="EnerGeo" class="img-fluid"
             style="max-width: min(70vw, 280px); height: auto;">
    </div>
    <a class="btn btn-primary w-100 w-sm-auto" href="@Url.Action("Index", "Home")">
        <i class="fas fa-home me-1"></i> Volver al inicio
    </a>
</div>




<!-- Scripts -->
@section scripts {



}