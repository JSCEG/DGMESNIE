@model NSIE.Models.Credito
@using Microsoft.AspNetCore.Http
@using Newtonsoft.Json
@using NSIE.Models
@inject IHttpContextAccessor HttpContextAccessor

@{
    ViewData["Title"] = "Reseña";

    var header = new HeaderViewModel
    {
        Title = "Reseña",
        IconPath = "analisis.png",
        Description = "Semblanza de la persona integrante del equipo del proyecto.",
        Section = "Acerca de",
        ModuleInfo = JsonConvert.SerializeObject(new
        {
            title = "Reseña",
            description = "Muestra la semblanza profesional de una persona integrante del equipo.",
            stage = "Información"
        })
    };
}

@await Html.PartialAsync("_ViewHeader", header)

<div class="container">
    <nav aria-label="breadcrumb" class="mb-4">
        <ol class="breadcrumb">
            <li class="breadcrumb-item"><a href="@Url.Action("Index", "Home")"><i class="fas fa-home me-1"></i>Inicio</a></li>
            <li class="breadcrumb-item"><a href="#" onclick="history.back(); return false;">Regresar</a></li>
            <li class="breadcrumb-item active" aria-current="page">@ViewData["Title"]</li>
        </ol>
    </nav>

    <h2 class="form-section-title">@Model.Nombre</h2>
    <p>@Model.Resena</p>
</div>




<!-- Scripts -->
@section scripts {



}