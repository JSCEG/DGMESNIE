</style>

@section scripts {
    <script>
        // Autofiltrar al cambiar cualquier select (misma UX de un clic que el resto de la plataforma)
        document.querySelectorAll('#pam-filtros select').forEach(function (sel) {
            sel.addEventListener('change', function () {
                document.getElementById('pam-filtros').requestSubmit();
            });
        });
    </script>
}
