            vertical-align: top;
            max-width: 30rem;
            color: var(--pam-ink);
        }

        .pam-table th:nth-child(1), .pam-table td:nth-child(1) { width: 150px; }
        .pam-table th:nth-child(2), .pam-table td:nth-child(2) { width: 320px; }
