        .pam-filters { grid-template-columns: repeat(3, minmax(0, 1fr)); }
        .pam-search { grid-column: 1 / -1; }
    }

    @@media (min-width: 1200px) {
        .pam-analitica { grid-template-columns: minmax(0, 1.6fr) minmax(300px, 1fr) minmax(260px, .8fr); align-items: stretch; }
        .pam-kpis { grid-template-columns: repeat(2, minmax(0, 1fr)); }
        .pam-filters { grid-template-columns: minmax(260px, 2.4fr) repeat(3, minmax(150px, 1fr)) auto auto; }
        .pam-search { grid-column: auto; }
    }

    /* Tabla de escritorio: encabezado pegajoso y columna de acciones fija */
