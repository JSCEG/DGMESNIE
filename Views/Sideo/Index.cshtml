@{
    ViewData["Title"] = "SIDEO · Especificaciones";
}

@await Html.PartialAsync("_ViewHeader", ViewData["HeaderViewModel"] as NSIE.Models.HeaderViewModel)

@section Styles {
    <style>
        .spec-container {
            font-family: var(--font-text);
            color: var(--sener-tinta);
            background-color: var(--sener-blanco);
        }

        .spec-section {
            background-color: var(--sener-papel);
            border: 1px solid var(--sener-linea);
            border-radius: var(--radius-md);
            box-shadow: var(--shadow-card);
            padding: var(--space-5);
            margin-bottom: var(--space-6);
        }

        .spec-section-title {
            font-family: var(--font-display);
            font-size: 2.2rem;
            color: var(--sener-guinda);
            margin-bottom: var(--space-4);
            border-bottom: 2px solid var(--sener-guinda);
            padding-bottom: var(--space-2);
        }

        .spec-kicker {
            font-family: var(--font-text);
            font-size: 13px;
            font-weight: var(--fw-bold);
            letter-spacing: var(--tracking-kicker);
            text-transform: uppercase;
            color: var(--sener-guinda);
            margin-bottom: var(--space-1);
        }

        .color-grid {
            display: grid;
            grid-template-columns: repeat(auto-fill, minmax(180px, 1fr));
            gap: var(--space-4);
        }

        .color-card {
            border: 1px solid var(--sener-linea);
            border-radius: var(--radius-md);
            overflow: hidden;
            box-shadow: var(--shadow-soft);
            background: var(--sener-blanco);
            transition: transform 0.2s ease-in-out;
        }

        .color-card:hover {
            transform: translateY(-4px);
        }

        .color-swatch {
            height: 100px;
            width: 100%;
        }

        .color-info {
            padding: var(--space-3);
        }

        .color-name {
            font-weight: var(--fw-bold);
            font-size: 15px;
            margin-bottom: var(--space-1);
        }

        .color-hex {
            font-family: var(--font-mono);
            font-size: 13px;
            color: var(--sener-gris);
        }

        .color-var {
            font-family: var(--font-mono);
            font-size: 11px;
            color: var(--sener-gris-claro);
            word-break: break-all;
            margin-top: var(--space-1);
        }

        .spec-code {
            font-family: var(--font-mono);
            font-size: 13px;
            background-color: var(--sener-papel);
            border: 1px solid var(--sener-linea);
            padding: var(--space-2) var(--space-3);
            border-radius: var(--radius-sm);
            margin-top: var(--space-3);
            display: block;
            overflow-x: auto;
            color: #bd1e51;
        }

        .flex-wrap-gap {
            display: flex;
            flex-wrap: wrap;
            gap: var(--space-3);
            align-items: center;
        }
    </style>
}

<div class="container-fluid shell-page-container py-3 spec-container">
    <!-- breadcrumbs -->
    <div class="gestor-breadcrumbs">
        <nav aria-label="breadcrumb">
            <ol class="breadcrumb">
                <li class="breadcrumb-item"><a href="@Url.Action("Index", "Home")">Inicio</a></li>
                <li class="breadcrumb-item active" aria-current="page">Sistema de Diseño SIDEO</li>
            </ol>
        </nav>
    </div>

    <!-- Navegación interna rápida -->
    <div class="mb-4 flex-wrap-gap">
        <a href="#colores" class="sideo-btn sideo-btn-primary">Colores</a>
        <a href="#tipografia" class="sideo-btn sideo-btn-accent">Tipografía</a>
        <a href="#botones" class="sideo-btn sideo-btn-secondary">Botones</a>
        <a href="#separadores" class="sideo-btn sideo-btn-outline">Separadores</a>
        <a href="#listas" class="sideo-btn sideo-btn-outline">Listas</a>
        <a href="#componentes" class="sideo-btn sideo-btn-outline">Componentes (KPI/Tablas)</a>
        <a href="@Url.Action("Presentacion", "Sideo")" class="sideo-btn sideo-btn-primary ms-auto" style="background-color: #3b2247;">
            <i class="bi bi-file-earmark-slides-fill me-2"></i>Ver Diapositivas 16:9
        </a>
    </div>

    <!-- SECCIÓN: COLORES -->
    <section class="spec-section" id="colores">
        <div class="spec-kicker">SIDEO Visual Foundations</div>
        <h2 class="spec-section-title">Paleta de Colores Institucional</h2>
        
        <h4 class="mt-4 mb-3" style="font-family: var(--font-display); color: var(--sener-tinta)">Colores de Marca</h4>
        <div class="color-grid">
            <div class="color-card">
                <div class="color-swatch" style="background-color: var(--sener-guinda);"></div>
                <div class="color-info">
                    <div class="color-name">Guinda SENER</div>
                    <div class="color-hex">#9B2247</div>
                    <div class="color-var">--sener-guinda</div>
                </div>
            </div>
            <div class="color-card">
                <div class="color-swatch" style="background-color: var(--sener-guinda-dark);"></div>
                <div class="color-info">
                    <div class="color-name">Guinda Oscuro</div>
                    <div class="color-hex">#8E1F40</div>
                    <div class="color-var">--sener-guinda-dark</div>
                </div>
            </div>
            <div class="color-card">
                <div class="color-swatch" style="background-color: var(--sener-dorado);"></div>
                <div class="color-info">
                    <div class="color-name">Dorado Acento</div>
                    <div class="color-hex">#E0A12E</div>
                    <div class="color-var">--sener-dorado</div>
                </div>
            </div>
            <div class="color-card">
                <div class="color-swatch" style="background-color: var(--sener-esmeralda);"></div>
                <div class="color-info">
                    <div class="color-name">Esmeralda Limpio</div>
                    <div class="color-hex">#0E8A6E</div>
                    <div class="color-var">--sener-esmeralda</div>
                </div>
            </div>
            <div class="color-card">
                <div class="color-swatch" style="background-color: var(--sener-cian);"></div>
                <div class="color-info">
                    <div class="color-name">Cian Datos</div>
                    <div class="color-hex">#1E9CB8</div>
                    <div class="color-var">--sener-cian</div>
                </div>
            </div>
        </div>

        <h4 class="mt-4 mb-3" style="font-family: var(--font-display); color: var(--sener-tinta)">Colores Neutrales</h4>
        <div class="color-grid">
            <div class="color-card">
                <div class="color-swatch" style="background-color: var(--sener-tinta);"></div>
                <div class="color-info">
                    <div class="color-name">Tinta Texto</div>
                    <div class="color-hex">#1c1b1a</div>
                    <div class="color-var">--sener-tinta</div>
                </div>
            </div>
            <div class="color-card">
                <div class="color-swatch" style="background-color: var(--sener-gris);"></div>
                <div class="color-info">
                    <div class="color-name">Gris Secundario</div>
                    <div class="color-hex">#6F6B66</div>
                    <div class="color-var">--sener-gris</div>
                </div>
            </div>
            <div class="color-card">
                <div class="color-swatch" style="background-color: var(--sener-gris-claro);"></div>
                <div class="color-info">
                    <div class="color-name">Gris Claro</div>
                    <div class="color-hex">#9A958E</div>
                    <div class="color-var">--sener-gris-claro</div>
                </div>
            </div>
            <div class="color-card">
                <div class="color-swatch" style="background-color: var(--sener-papel); border-bottom: 1px solid var(--sener-linea);"></div>
                <div class="color-info">
                    <div class="color-name">Papel Cálido</div>
                    <div class="color-hex">#FAF8F5</div>
                    <div class="color-var">--sener-papel</div>
                </div>
            </div>
            <div class="color-card">
                <div class="color-swatch" style="background-color: var(--sener-linea); border-bottom: 1px solid var(--sener-linea-suave);"></div>
                <div class="color-info">
                    <div class="color-name">Línea Divisora</div>
                    <div class="color-hex">#ECE8E2</div>
                    <div class="color-var">--sener-linea</div>
                </div>
            </div>
        </div>

        <h4 class="mt-4 mb-3" style="font-family: var(--font-display); color: var(--sener-tinta)">Colores de Tecnologías</h4>
        <div class="color-grid">
            <div class="color-card">
                <div class="color-swatch" style="background-color: #E0A12E;"></div>
                <div class="color-info">
                    <div class="color-name">Solar Fotovoltaica</div>
                    <div class="color-hex">#E0A12E</div>
                    <div class="color-var">--tec-fv</div>
                </div>
            </div>
            <div class="color-card">
                <div class="color-swatch" style="background-color: #1E9CB8;"></div>
                <div class="color-info">
                    <div class="color-name">Eólica</div>
                    <div class="color-hex">#1E9CB8</div>
                    <div class="color-var">--tec-eo</div>
                </div>
            </div>
            <div class="color-card">
                <div class="color-swatch" style="background-color: #2E6FB0;"></div>
                <div class="color-info">
                    <div class="color-name">Hidroeléctrica</div>
                    <div class="color-hex">#2E6FB0</div>
                    <div class="color-var">--tec-hid</div>
                </div>
            </div>
            <div class="color-card">
                <div class="color-swatch" style="background-color: #3BA98C;"></div>
                <div class="color-info">
                    <div class="color-name">Hidrógeno</div>
                    <div class="color-hex">#3BA98C</div>
                    <div class="color-var">--tec-h2</div>
                </div>
            </div>
            <div class="color-card">
                <div class="color-swatch" style="background-color: #8A9099;"></div>
                <div class="color-info">
                    <div class="color-name">Ciclo Combinado</div>
                    <div class="color-hex">#8A9099</div>
                    <div class="color-var">--tec-cc</div>
                </div>
            </div>
        </div>
    </section>

    <!-- SECCIÓN: TIPOGRAFÍA -->
    <section class="spec-section" id="tipografia">
        <div class="spec-kicker">SIDEO Visual Foundations</div>
        <h2 class="spec-section-title">Tipografía y Jerarquía</h2>
        
        <div class="row g-4">
            <div class="col-md-7">
                <div class="p-3 border rounded bg-white">
                    <div class="mb-4">
                        <span class="text-muted small d-block mb-1">Display (Newsreader Regular) - --fs-display (92px)</span>
                        <div style="font-family: var(--font-display); font-size: 56px; line-height: var(--lh-tight); letter-spacing: var(--tracking-tight); color: var(--sener-guinda)">
                            Transición
                        </div>
                    </div>
                    <div class="mb-4">
                        <span class="text-muted small d-block mb-1">Title (Newsreader Regular) - --fs-title (48px)</span>
                        <div style="font-family: var(--font-display); font-size: 36px; color: var(--sener-tinta)">
                            Nueva capacidad por región.
                        </div>
                    </div>
                    <div class="mb-4">
                        <span class="text-muted small d-block mb-1">Kicker (Libre Franklin Semibold) - --fs-kicker (24px) + letter-spacing</span>
                        <div style="font-family: var(--font-text); font-size: 16px; font-weight: var(--fw-semibold); letter-spacing: var(--tracking-kicker); text-transform: uppercase; color: var(--sener-guinda)">
                            SECCIÓN 01 · CAPACIDAD ADICIONAL
                        </div>
                    </div>
                    <div class="mb-4">
                        <span class="text-muted small d-block mb-1">Body Text (Libre Franklin Regular) - --fs-body (27px)</span>
                        <p style="font-family: var(--font-text); font-size: 18px; line-height: var(--lh-body); color: var(--text-body)">
                            La Secretaría de Energía proyecta una adición importante de energía solar fotovoltaica y eólica en los polos regionales de desarrollo entre 2026 y 2030, disminuyendo la huella de carbono del Sistema Eléctrico Nacional.
                        </p>
                    </div>
                    <div>
                        <span class="text-muted small d-block mb-1">Tabular Figures (IBM Plex Mono Semibold) - --font-mono</span>
                        <span style="font-family: var(--font-mono); font-weight: var(--fw-semibold); font-size: 28px; color: var(--sener-esmeralda)">
                            68.89%
                        </span>
                    </div>
                </div>
            </div>
            
            <div class="col-md-5">
                <div class="p-3 border rounded bg-white h-100">
                    <h5 class="fw-bold mb-3" style="color: var(--sener-tinta)">Énfasis en Texto</h5>
                    <ul class="sideo-list">
                        <li class="sideo-li"><span class="sideo-dot"></span> Negrita: <strong>La meta es 122,298 MW</strong>.</li>
                        <li class="sideo-li"><span class="sideo-dot"></span> Cursiva: <em>Según el Programa Sectorial</em>.</li>
                        <li class="sideo-li"><span class="sideo-dot"></span> Subrayado Dorado: <span style="text-decoration: underline; text-decoration-color: var(--sener-dorado); text-decoration-thickness: 2px; text-underline-offset: 4px">nota metodológica</span>.</li>
                        <li class="sideo-li"><span class="sideo-dot"></span> Tachado y Corrección: <span style="text-decoration: line-through; text-decoration-color: var(--sener-gris-claro); color: var(--sener-gris-claro)">110,000 MW</span> <strong style="color: var(--sener-guinda)">122,298 MW</strong></li>
                        <li class="sideo-li"><span class="sideo-dot"></span> Resaltado Dorado Tenue: <span style="background: var(--sener-resaltado-bg); padding: 2px 8px; border-radius: var(--radius-sm)">68.89% de energía limpia</span>.</li>
                    </ul>

                    <code class="spec-code d-block mt-4">
font-family: var(--font-display);<br>
font-family: var(--font-text);<br>
font-family: var(--font-mono);
                    </code>
                </div>
            </div>
        </div>
    </section>

    <!-- SECCIÓN: BOTONES -->
    <section class="spec-section" id="botones">
        <div class="spec-kicker">SIDEO UI Elements</div>
        <h2 class="spec-section-title">Botones Homologados</h2>
        
        <div class="p-4 border rounded bg-white mb-3">
            <div class="flex-wrap-gap mb-4">
                <button type="button" class="sideo-btn sideo-btn-primary">Botón Primario</button>
                <button type="button" class="sideo-btn sideo-btn-secondary">Botón Secundario</button>
                <button type="button" class="sideo-btn sideo-btn-accent">Botón Acento</button>
                <button type="button" class="sideo-btn sideo-btn-outline">Botón Outline</button>
                
                <button type="button" class="sideo-btn sideo-btn-primary" disabled>Deshabilitado</button>
            </div>
            
            <div class="flex-wrap-gap">
                <button type="button" class="sideo-btn sideo-btn-primary">
                    <i class="bi bi-save2-fill"></i> Con Ícono
                </button>
                <button type="button" class="sideo-btn sideo-btn-outline">
                    Con Chevron <svg class="sideo-chevron" viewBox="0 0 24 24"><polyline points="6 9 12 15 18 9"></polyline></svg>
                </button>
            </div>
        </div>

        <code class="spec-code">
&lt;button class="sideo-btn sideo-btn-primary"&gt;Botón Primario&lt;/button&gt;<br>
&lt;button class="sideo-btn sideo-btn-outline"&gt;Botón Outline&lt;/button&gt;
        </code>
    </section>

    <!-- SECCIÓN: SEPARADORES -->
    <section class="spec-section" id="separadores">
        <div class="spec-kicker">SIDEO Ornamental Lines</div>
        <h2 class="spec-section-title">Separadores con Rombo</h2>
        
        <div class="p-4 border rounded bg-white">
            <div class="mb-4">
                <span class="text-muted small">Separador Dorado (Principal de Contraportada y Figuras)</span>
                <div class="sideo-sep sep-dorado">
                    <span class="sideo-ln"></span>
                    <span class="sideo-dm"></span>
                    <span class="sideo-ln"></span>
                </div>
            </div>

            <div class="mb-4">
                <span class="text-muted small">Separador Guinda (Marca Principal)</span>
                <div class="sideo-sep sep-guinda">
                    <span class="sideo-ln"></span>
                    <span class="sideo-dm"></span>
                    <span class="sideo-ln"></span>
                </div>
            </div>

            <div class="mb-4">
                <span class="text-muted small">Separador Esmeralda (Energías Limpias)</span>
                <div class="sideo-sep sep-esmeralda">
                    <span class="sideo-ln"></span>
                    <span class="sideo-dm"></span>
                    <span class="sideo-ln"></span>
                </div>
            </div>

            <div>
                <span class="text-muted small">Separador Gris (Neutro)</span>
                <div class="sideo-sep sep-gris">
                    <span class="sideo-ln"></span>
                    <span class="sideo-dm"></span>
                    <span class="sideo-ln"></span>
                </div>
            </div>
        </div>

        <code class="spec-code">
&lt;div class="sideo-sep sep-guinda"&gt;<br>
&nbsp;&nbsp;&lt;span class="sideo-ln"&gt;&lt;/span&gt;&lt;span class="sideo-dm"&gt;&lt;/span&gt;&lt;span class="sideo-ln"&gt;&lt;/span&gt;<br>
&lt;/div&gt;
        </code>
    </section>

    <!-- SECCIÓN: LISTAS -->
    <section class="spec-section" id="listas">
        <div class="spec-kicker">SIDEO Content Layout</div>
        <h2 class="spec-section-title">Listas y Viñetas Dinámicas</h2>
        
        <div class="row g-4">
            <div class="col-md-6">
                <div class="p-4 border rounded bg-white h-100">
                    <h5 class="fw-bold mb-3" style="color: var(--sener-tinta)">Lista Multinivel</h5>
                    <ul class="sideo-list">
                        <li class="sideo-li"><span class="sideo-dot"></span> Nivel 1: Nueva capacidad eléctrica (Punto Guinda)</li>
                        <li class="sideo-li" style="padding-left: var(--sep-indent);"><span class="sideo-ring"></span> Nivel 2: Solar fotovoltaica y parques eólicos (Anillo Dorado)</li>
                        <li class="sideo-li" style="padding-left: calc(var(--sep-indent) * 2);"><span class="sideo-dash"></span> Nivel 3: Polos regionales de desarrollo (Guion Gris)</li>
                    </ul>
                </div>
            </div>

            <div class="col-md-6">
                <div class="p-4 border rounded bg-white h-100">
                    <h5 class="fw-bold mb-3" style="color: var(--sener-tinta)">Variantes de Marcadores</h5>
                    <ul class="sideo-list mb-3">
                        <li class="sideo-li"><span class="sideo-sq"></span> Marcador Cuadrado Guinda</li>
                        <li class="sideo-li">
                            <svg class="sideo-check-icon" viewBox="0 0 24 24"><polyline points="20 6 9 17 4 12"></polyline></svg>
                            Marcador de Verificación Esmeralda
                        </li>
                    </ul>

                    <h5 class="fw-bold mb-2" style="color: var(--sener-tinta)">Lista Numerada Newsreader</h5>
                    <ul class="sideo-list">
                        <li class="sideo-li"><span class="sideo-num">1.</span> Primer acuerdo del consejo ordinario.</li>
                        <li class="sideo-li"><span class="sideo-num">2.</span> Segundo acuerdo de integración y metas.</li>
                    </ul>
                </div>
            </div>
        </div>

        <code class="spec-code">
&lt;ul class="sideo-list"&gt;<br>
&nbsp;&nbsp;&lt;li class="sideo-li"&gt;&lt;span class="sideo-dot"&gt;&lt;/span&gt;Contenido&lt;/li&gt;<br>
&nbsp;&nbsp;&lt;li class="sideo-li" style="padding-left: var(--sep-indent);"&gt;&lt;span class="sideo-ring"&gt;&lt;/span&gt;Subnivel&lt;/li&gt;<br>
&lt;/ul&gt;
        </code>
    </section>

    <!-- SECCIÓN: COMPONENTES COMPLEJOS -->
    <section class="spec-section" id="componentes">
        <div class="spec-kicker">SIDEO Visual Specification</div>
        <h2 class="spec-section-title">Componentes Avanzados (KPIs, Badges, Tablas, Chips)</h2>
        
        <div class="row g-4 mb-4">
            <!-- KPIs -->
            <div class="col-md-6">
                <div class="p-4 border rounded bg-white h-100">
                    <h5 class="fw-bold mb-3" style="color: var(--sener-tinta)">Muestras de KPIs</h5>
                    <div class="row g-3">
                        <div class="col-sm-6">
                            <div class="sideo-kpi-card">
                                <div class="sideo-kpi-title">Capacidad limpia</div>
                                <div class="sideo-kpi-value">68.89%</div>
                            </div>
                        </div>
                        <div class="col-sm-6">
                            <div class="sideo-kpi-card kpi-guinda">
                                <div class="sideo-kpi-title">Proyección 2030</div>
                                <div class="sideo-kpi-value">122,298</div>
                            </div>
                        </div>
                        <div class="col-12 mt-3">
                            <div class="border rounded p-3 bg-light">
                                <div class="sideo-kpi-big">32,475</div>
                                <div class="sideo-kpi-label">MW nuevos adicionados</div>
                                <div class="sideo-kpi-delta">▲ +30.76%</div>
                                <div class="sideo-kpi-delta delta-negative">▼ −4.2%</div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Badges, Chips y Chevrones -->
            <div class="col-md-6">
                <div class="p-4 border rounded bg-white h-100">
                    <h5 class="fw-bold mb-3" style="color: var(--sener-tinta)">Badges de Estado</h5>
                    <div class="flex-wrap-gap mb-4">
                        <span class="sideo-badge sideo-badge-success">En meta</span>
                        <span class="sideo-badge sideo-badge-warning">En proceso</span>
                        <span class="sideo-badge sideo-badge-danger">Crítico</span>
                    </div>

                    <h5 class="fw-bold mb-3" style="color: var(--sener-tinta)">Fichas (Chips) de Tecnología</h5>
                    <div class="flex-wrap-gap mb-4">
                        <span class="sideo-chip"><span class="sideo-chip-indicator" style="background-color: var(--tec-fv)"></span>Solar Fotovoltaica</span>
                        <span class="sideo-chip"><span class="sideo-chip-indicator" style="background-color: var(--tec-eo)"></span>Eólica</span>
                        <span class="sideo-chip"><span class="sideo-chip-indicator" style="background-color: var(--tec-hid)"></span>Hidroeléctrica</span>
                    </div>

                    <h5 class="fw-bold mb-3" style="color: var(--sener-tinta)">Chevrones SVG de trazo</h5>
                    <div class="flex-wrap-gap">
                        <span>Down: <svg class="sideo-chevron sideo-chevron-down" viewBox="0 0 24 24"><polyline points="6 9 12 15 18 9"></polyline></svg></span>
                        <span>Right: <svg class="sideo-chevron sideo-chevron-right" viewBox="0 0 24 24"><polyline points="6 9 12 15 18 9"></polyline></svg></span>
