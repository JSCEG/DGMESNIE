@model NSIE.Models.ProyectosPrivados.ProyectoForm
@{
    ViewData["Title"] = "Editar Proyecto";
    var header = ViewData["HeaderViewModel"] as NSIE.Models.HeaderViewModel;
}

@if (header != null)
{
    @await Html.PartialAsync("_ViewHeader", header)
}

<div class="container ps-5 pe-5 mb-5">
    <!-- Breadcrumbs -->
    <div class="alert alert-light mb-3" role="alert" style="padding-left: 15px;">
        <nav aria-label="breadcrumb">
            <ol class="breadcrumb lp-5 mb-0">
                <li class="breadcrumb-item"><a href="@Url.Action("Index", "Home")">Inicio</a></li>
                <li class="breadcrumb-item"><a href="@Url.Action("Index", "ProyectosPrivados")">Proyectos Privados</a></li>
                <li class="breadcrumb-item"><a href="@Url.Action("Detalle", "ProyectosPrivados", new { id = Model.ProyectoId })">@Model.Nombre</a></li>
                <li class="breadcrumb-item active" aria-current="page">Editar</li>
            </ol>
        </nav>
    </div>

    <div class="card p-4 shadow-sm" style="border: 1px solid #E0E0E0; border-radius: 8px;">
        <form asp-action="Editar" asp-route-id="@Model.ProyectoId" method="post">
            @Html.AntiForgeryToken()
            <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

            <input type="hidden" asp-for="ProyectoId" />

            @await Html.PartialAsync("_FormProyecto", Model)

            <div class="d-flex justify-content-end gap-2 mt-4 pt-3 border-top">
                <a href="@Url.Action("Detalle", "ProyectosPrivados", new { id = Model.ProyectoId })" class="btn btn-secondary" style="background-color: var(--color-gobmx-gris, #98989A); border: none; font-weight: 600;">
                    Cancelar
                </a>
                <button type="submit" class="btn btn-primary" style="background-color: var(--color-gobmx-guinda, #9B2247); border: none; font-weight: 600;">
                    <i class="fas fa-save"></i> Guardar Cambios
                </button>
            </div>
        </form>
    </div>
</div>
