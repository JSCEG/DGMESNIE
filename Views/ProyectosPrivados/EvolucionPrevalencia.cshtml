@{
    ViewData["Title"] = "Evolución Prevalencia";
    var header = ViewData["HeaderViewModel"] as NSIE.Models.HeaderViewModel;
}

@section Styles {
    <style>
        .iframe-container {
            position: relative;
            width: 100%;
            height: calc(100vh - 280px);
            min-height: 650px;
            border-radius: var(--radius-md, 8px);
            overflow: hidden;
            box-shadow: var(--elev-1, 0 4px 6px rgba(0, 0, 0, 0.1));
            border: 1px solid var(--shell-line, #DDDDDD);
            background: var(--shell-surface, #FFFFFF);
        }

        .iframe-container iframe {
            width: 100%;
            height: 100%;
            border: none;
        }
    </style>
}

@if (header != null)
{
    @await Html.PartialAsync("_ViewHeader", header)
}

<div class="container px-3 px-md-4 mb-5">
    <nav aria-label="breadcrumb" class="mb-3">
        <ol class="breadcrumb mb-0">
            <li class="breadcrumb-item"><a href="@Url.Action("Index", "Home")"><i class="fas fa-home me-1"></i>Inicio</a></li>
            <li class="breadcrumb-item active" aria-current="page">Evolución Prevalencia</li>
        </ol>
    </nav>

    <div class="iframe-container">
        <iframe src="https://pvirce.pages.dev/GENERACION-GWH"
                title="Evolución Prevalencia - Generación GWh"
                allowfullscreen>
        </iframe>
    </div>
</div>
