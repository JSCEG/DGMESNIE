@model NSIE.Models.ProyectosPrivados.IngestionResultDto
@{
    ViewData["Title"] = "Resultado de la Ingestión";
    var header = ViewData["HeaderViewModel"] as NSIE.Models.HeaderViewModel;
}

@section Styles {
    <style>
        .result-kpi {
            background: #FFFFFF;
            border: 1px solid #E0E0E0;
            border-radius: 8px;
            padding: 24px;
            box-shadow: 0 4px 6px rgba(0, 0, 0, 0.05);
            text-align: center;
        }
        .result-kpi .value {
            font-size: 36px;
            font-weight: 700;
            margin-bottom: 8px;
        }
        .result-kpi-success {
            border-top: 5px solid var(--color-gobmx-verde, #1E5B4F);
            color: var(--color-gobmx-verde, #1E5B4F);
        }
        .result-kpi-info {
            border-top: 5px solid var(--color-gobmx-dorado, #A57F2C);
            color: var(--color-gobmx-dorado, #A57F2C);
        }
        .result-kpi-warning {
            border-top: 5px solid var(--color-gobmx-guinda, #9B2247);
            color: var(--color-gobmx-guinda, #9B2247);
        }
        .log-panel {
            background: #FAFAFA;
            border: 1px solid #E0E0E0;
            border-radius: 8px;
            padding: 20px;
            max-height: 300px;
            overflow-y: auto;
            font-family: monospace;
            font-size: 13px;
        }
        .card-definition {
            background-color: var(--color-gobmx-verde-light, rgba(30, 91, 79, 0.05));
            border-left: 5px solid var(--color-gobmx-verde, #1E5B4F);
            border-radius: 8px;
            padding: 20px;
            margin-bottom: 24px;
        }
        .card-definition h4 {
            color: var(--color-gobmx-verde, #1E5B4F);
            font-family: var(--font-family-headings, serif);
            margin-top: 0;
        }
    </style>
}

@if (header != null)
{
    @await Html.PartialAsync("_ViewHeader", header)
}

<div class="container ps-5 pe-5 mb-5">
    <!-- Breadcrumbs -->
    <div class="alert alert-light mb-3" role="alert" style="padding-left: 15px;">
</div>

    <!-- Resumen -->
    <div class="card-definition mb-4">
        <h4><i class="fas fa-check-circle"></i> Ingestión Completada Exitosamente</h4>
        <p class="mb-0">
            El archivo <strong>@Model.ArchivoNombre</strong> ha sido cargado en el esquema de staging y procesado a través de las reglas de deduplicación canónicas.
        </p>
    </div>

    <!-- KPIs Row -->
    <div class="row g-4 mb-4">
        <div class="col-md-3">
            <div class="result-kpi">
                <div class="value">@Model.TotalFilasProcesadas</div>
                <div class="text-muted">Total Filas Leídas</div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="result-kpi result-kpi-success">
                <div class="value">@Model.NuevosProyectosInsertados</div>
                <div class="text-muted">Proyectos Creados</div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="result-kpi result-kpi-info">
                <div class="value">@Model.IdentificadoresAsociados</div>
                <div class="text-muted">Fusiones Automáticas</div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="result-kpi result-kpi-warning" style="cursor: pointer;" onclick="location.href='@Url.Action("Conflictos", "ProyectosPrivados")'">
                <div class="value">@Model.ConflictosDetectados</div>
                <div class="text-muted">Dudas (En espera de decisión)</div>
                <small class="text-primary font-weight-bold d-block mt-2"><i class="fas fa-external-link-alt"></i> Resolver Ahora</small>
            </div>
        </div>
    </div>

    <!-- Log de ejecución -->
    <h3 class="h5 mb-3" style="font-family: var(--font-family-headings, serif); color: var(--color-gobmx-guinda, #9B2247);">Bitácora Detallada</h3>
    <div class="log-panel mb-4">
        @foreach (var log in Model.MensajesLog)
        {
            <div><i class="fas fa-terminal text-secondary"></i> @log</div>
        }
    </div>

    <div class="text-center">
        <a href="@Url.Action("Index", "ProyectosPrivados")" class="btn btn-primary" style="background-color: var(--color-gobmx-guinda, #9B2247); border: none; font-weight: 600; padding: 10px 32px;">
            Regresar a la Cartera
        </a>
    </div>
</div>
