@{
    ViewData["Title"] = "Producción Energética Anual";
    var header = ViewData["HeaderViewModel"] as NSIE.Models.HeaderViewModel;
}

@section Styles {
    <style>
        .iframe-container {
            position: relative;
            width: 100%;
            height: calc(100vh - 280px);
            min-height: 650px;
            border-radius: var(--radius-md, 8px);
            overflow: hidden;
            box-shadow: var(--elev-1, 0 4px 6px rgba(0, 0, 0, 0.1));
            border: 1px solid var(--shell-line, #DDDDDD);
            background: var(--shell-surface, #FFFFFF);
        }

        .iframe-container iframe {
            width: 100%;
            height: 100%;
            border: none;
        }
    </style>
}

@if (header != null)
{
    @await Html.PartialAsync("_ViewHeader", header)
}

<div class="container px-3 px-md-4 mb-5">
<div class="iframe-container">
        <iframe sandbox="allow-scripts allow-same-origin allow-forms allow-popups allow-downloads"  src="https://pvirce.pages.dev/PRODUCCION-ENERGETICA-SENER"
                title="Producción Energética Anual - SENER"
                allowfullscreen>
        </iframe>
    </div>
</div>

