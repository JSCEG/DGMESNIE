@{
    ViewData["Title"] = "Programa Vinculante 2026 — 2040";
    var header = ViewData["HeaderViewModel"] as NSIE.Models.HeaderViewModel;
}

@section Styles {
    <style>
        .iframe-container {
            position: relative;
            width: 100%;
            height: calc(100vh - 280px);
            min-height: 650px;
            border-radius: var(--border-radius-md, 8px);
            overflow: hidden;
            box-shadow: var(--box-shadow-card, 0 4px 6px rgba(0, 0, 0, 0.1));
            border: 1px solid var(--color-border, #DDDDDD);
            background: #FFFFFF;
            transition: all 0.3s ease;
        }
        .iframe-container iframe {
            width: 100%;
            height: 100%;
            border: none;
        }
    </style>
}

@if (header != null)
{
    @await Html.PartialAsync("_ViewHeader", header)
}

<div class="container ps-5 pe-5 mb-5">
    <!-- Breadcrumbs -->
    <div class="alert alert-light mb-3" role="alert" style="padding-left: 15px;">
        <nav aria-label="breadcrumb">
            <ol class="breadcrumb lp-5 mb-0">
                <li class="breadcrumb-item"><a href="@Url.Action("Index", "Home")">Inicio</a></li>
                <li class="breadcrumb-item active" aria-current="page">Programa Vinculante 2026 — 2040</li>
            </ol>
        </nav>
    </div>

    <!-- Iframe Container -->
    <div class="iframe-container">
        <iframe src="https://pvirce.pages.dev/" 
                title="Programa Vinculante 2026 — 2040 Instalación y Retiro de Centrales Eléctricas" 
                allowfullscreen>
        </iframe>
    </div>
</div>
