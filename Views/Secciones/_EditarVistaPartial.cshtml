@model NSIE.Models.ModulosVista

<div class="modal-sec__header">
    <div>
        <span class="modal-sec__kicker">@Model.ModuloTitle</span>
        <h5 class="modal-sec__title">Editar vista</h5>
    </div>
    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
</div>

<form id="formEditarVista" class="form-sec">
    @Html.AntiForgeryToken()
    <div class="modal-sec__body">
        <input asp-for="VistaId" type="hidden" />
        <input asp-for="ModuloId" type="hidden" />

        <div class="row">
            <div class="col-12">
                <p class="form-sec__nota mb-3">
                    <i class="fas fa-circle-info"></i>
                    <span>Esta vista cuelga del módulo <strong>@Model.ModuloTitle</strong>.</span>
                </p>
            </div>
        </div>

        <div class="row">
            <div class="col-md-8">
                <label asp-for="Titulo" class="form-label">Título de la Vista *</label>
                <input asp-for="Titulo" class="form-control" required />
                <span asp-validation-for="Titulo" class="text-danger"></span>
            </div>
            <div class="col-md-4">
                <label asp-for="Orden" class="form-label">Orden</label>
                <input asp-for="Orden" type="number" class="form-control" min="1" />
                <span asp-validation-for="Orden" class="text-danger"></span>
            </div>
        </div>

        <div class="row mt-3">
            <div class="col-md-6">
                <label asp-for="Controller" class="form-label">Controller *</label>
                <input asp-for="Controller" class="form-control" required />
                <span asp-validation-for="Controller" class="text-danger"></span>
            </div>
            <div class="col-md-6">
                <label asp-for="Action" class="form-label">Action *</label>
                <input asp-for="Action" class="form-control" required />
                <span asp-validation-for="Action" class="text-danger"></span>
            </div>
        </div>

        <div class="row mt-3">
            <div class="col-md-6">
                <label asp-for="Roles" class="form-label">Roles (IDs separados por coma)</label>
                <input asp-for="Roles" class="form-control" />
                <small class="form-text text-muted">Dejar vacío para todos los roles</small>
            </div>
            <div class="col-md-6">
                <label class="form-label fw-bold">Usuarios con acceso</label>
                <div class="input-group mb-2">
                    <span class="input-group-text bg-white"><i class="fas fa-search text-muted"></i></span>
                    <input type="text" id="buscarUsuarioEditarVista" class="form-control form-control-sm" placeholder="Buscar usuario..." />
                </div>
                <div id="usuariosCheckboxContainerEditarVista" class="form-sec__usuarios mb-1">
                    <div class="text-muted small"><i class="fas fa-spinner fa-spin me-1"></i> Cargando usuarios...</div>
                </div>
                <input type="hidden" asp-for="Perfiles" id="inputPerfilesHiddenEditarVista" />
                <small class="form-text text-muted">Dejar vacío para permitir el acceso a todos los usuarios.</small>
            </div>
        </div>

        <div class="row mt-3">
            <div class="col-md-6">
                <div class="form-sec__estado">
                    <span class="form-sec__estado-texto">
                        <span class="form-sec__estado-titulo">Visible en el menú</span>
                        <span class="form-sec__estado-ayuda">Si se apaga, la vista queda oculta.</span>
                    </span>
                    <input asp-for="Activa" class="form-check-input" type="checkbox" role="switch" />
                </div>
            </div>
            <div class="col-md-6">
                <div class="form-sec__estado">
                    <span class="form-sec__estado-texto">
                        <span class="form-sec__estado-titulo">Es enlace externo</span>
                        <span class="form-sec__estado-ayuda">Abre fuera del SNIEr en lugar de una ruta interna.</span>
                    </span>
                    <input asp-for="EsExterno" class="form-check-input" type="checkbox" role="switch" />
                </div>
            </div>
        </div>
    </div>

    <div class="modal-sec__foot">
        <button type="button" class="btn-sec" data-bs-dismiss="modal">Cancelar</button>
        <button type="submit" class="btn-sec btn-sec--primary">
            <i class="fas fa-check"></i> Guardar cambios
        </button>
    </div>
</form>

<script>
    $(document).ready(function () {
        const hiddenInput = $("#inputPerfilesHiddenEditarVista");
        const container = $("#usuariosCheckboxContainerEditarVista");
        const initialValues = (hiddenInput.val() || "").split(",").map(v => v.trim()).filter(v => v !== "");

        $.getJSON("/Secciones/GetUsuariosVigentes", function (users) {
            container.empty();
            if (!users || users.length === 0) {
                container.html('<div class="text-muted small">No hay usuarios vigentes disponibles.</div>');
                return;
            }

            users.forEach(function (user) {
                const userId = (user.idUsuario !== undefined ? user.idUsuario : user.IdUsuario).toString();
                const userName = user.nombre !== undefined ? user.nombre : user.Nombre;
                const isChecked = initialValues.includes(userId);
                const checkedAttr = isChecked ? "checked" : "";

                const itemHtml = `
                    <div class="form-check usuario-row-item py-1">
                        <input class="form-check-input chk-usuario-acceso-edit-vista" type="checkbox" value="${userId}" id="chk_user_edit_vis_${userId}" ${checkedAttr}>
                        <label class="form-check-label text-truncate w-100 cursor-pointer" for="chk_user_edit_vis_${userId}">
                            ${userName}
                        </label>
                    </div>
                `;
                container.append(itemHtml);
            });

            // Registrar evento change
            container.on("change", ".chk-usuario-acceso-edit-vista", function () {
                const checkedIds = [];
                container.find(".chk-usuario-acceso-edit-vista:checked").each(function () {
                    checkedIds.push($(this).val());
                });
                hiddenInput.val(checkedIds.join(","));
            });
        }).fail(function () {
            container.html('<div class="text-danger small"><i class="fas fa-exclamation-triangle me-1"></i> Error al cargar usuarios.</div>');
        });

        // Búsqueda interactiva
        $("#buscarUsuarioEditarVista").on("keyup", function () {
            const searchVal = $(this).val().toLowerCase();
            container.find(".usuario-row-item").each(function () {
                const labelText = $(this).find("label").text().toLowerCase();
                if (labelText.includes(searchVal)) {
                    $(this).show();
                } else {
                    $(this).hide();
                }
            });
        });
    });

    document.getElementById('formEditarVista').addEventListener('submit', function (e) {
        e.preventDefault();

        const formData = new FormData(this);
        const submitBtn = this.querySelector('button[type="submit"]');

        // Deshabilitar botón mientras se procesa
        submitBtn.disabled = true;
        submitBtn.innerHTML = '<i class="fas fa-spinner fa-spin"></i> Actualizando...';

        fetch('@Url.Action("GuardarEdicionVista", "Secciones")', {
            method: 'POST',
            body: formData
        })
            .then(response => {
                if (response.ok) {
                    return response.json();
                } else {
                    return response.text().then(text => {
                        throw new Error(text || 'Error al actualizar');
                    });
                }
            })
            .then(data => {
                // Cerrar modal
                const modal = bootstrap.Modal.getInstance(document.getElementById('vistaModal'));
                modal.hide();

                // Mostrar mensaje de éxito
                Swal.fire({
                    title: '¡Actualizada!',
                    text: data.mensaje || 'Vista actualizada correctamente',
                    icon: 'success',
                    timer: 2000,
                    showConfirmButton: false
                }).then(() => {
                    // Recargar la página para mostrar los cambios
                    window.location.reload();
                });
            })
            .catch(error => {
                console.error('Error:', error);

                // Mostrar mensaje de error
                Swal.fire({
                    title: 'Error',
                    text: 'Error al actualizar la vista: ' + error.message,
                    icon: 'error'
                });

                // Rehabilitar botón
                submitBtn.disabled = false;
                submitBtn.innerHTML = '<i class="fas fa-save"></i> Actualizar Vista';
            });
    });
</script>
