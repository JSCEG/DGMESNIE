@model List<NSIE.Models.SeccionConModulos>
@using NSIE.Models
@using Microsoft.AspNetCore.Http
@using Newtonsoft.Json
@inject IHttpContextAccessor HttpContextAccessor

@{
    ViewData["Title"] = "Gestión de Secciones";

    var perfilJson = HttpContextAccessor.HttpContext.Session.GetString("PerfilUsuario");
    var perfilUsuario = JsonConvert.DeserializeObject<PerfilUsuario>(perfilJson);
    ViewData["NombreUsuario"] = perfilUsuario.Nombre;
    ViewData["RolUsuario"] = perfilUsuario.Rol;
    ViewData["MercadoUsuario"] = perfilUsuario.Mercado_ID;

    var header = new HeaderViewModel
    {
        Title = ViewData["Title"].ToString(),
        IconPath = "secciones.png", // Ruta relativa desde img_snier
        Description = "Administra las secciones principales del sistema, su orden y módulos asociados.",
        Section = "Administración",
        ModuleInfo = JsonConvert.SerializeObject(new
        {
            title = "Gestión de Secciones",
            description = "Herramienta integral para la administración y organización de las secciones del SNIEr.",
            functionality = "Permite crear, editar, ocultar, eliminar y reordenar las secciones, así como gestionar los módulos y vistas asociados a cada una.",
            stage = "Operación",
            roles = new[] {
                new { icon = "user-shield", text = "Administradores: Control total sobre las secciones y su contenido." },
                new { icon = "eye", text = "Usuarios: Visualización de las secciones y módulos disponibles." }
            },
            order = new { step = 1, description = "Módulo central para la estructura de navegación del sitio." },
            manualUrl = "/Documentos/ManualGestionSecciones.pdf" // Asumiendo que existe un manual específico
        })
    };

    var secciones = Model.OrderBy(s => s.Orden).ThenBy(s => s.Titulo).ToList();
    var totalModulos = secciones.Sum(s => s.Modulos?.Count ?? 0);
    var totalVistas = secciones.Sum(s => s.Modulos?.Sum(m => m.Vistas?.Count ?? 0) ?? 0);
}

@await Html.PartialAsync("_ViewHeader", header)

<div class="container-fluid px-3 px-lg-4 secciones-page">

    <!-- Miga de pan (Breadcrumbs) -->
    <nav aria-label="breadcrumb" class="mb-3">
        <ol class="breadcrumb">
            <li class="breadcrumb-item"><a href="@Url.Action("Index", "Home")"><i class="fas fa-home me-1"></i>Inicio</a></li>
            <li class="breadcrumb-item active" aria-current="page">Gestión de Secciones</li>
        </ol>
    </nav>

    <!-- Encabezado del árbol. Las cifras sustituyen a las tarjetas de estadística:
         son el mismo dato que la lista ya entrega, dicho en una línea. -->
    <header class="navtree-head">
        <div class="navtree-head__text">
            <p class="navtree-head__kicker">Administración</p>
            <h2 class="navtree-head__title">Estructura de navegación</h2>
            <p class="navtree-head__sub">
                <strong>@secciones.Count</strong> secciones ·
                <strong>@totalModulos</strong> módulos ·
                <strong>@totalVistas</strong> vistas.
                El orden de esta lista es el orden del menú.
            </p>
        </div>
        <div class="navtree-head__actions">
            <button type="button" class="shell-btn" onclick="previsualizarMenu()">
                <i class="fas fa-eye"></i> Previsualizar menú
            </button>
            <button type="button" class="shell-btn shell-btn--primary" onclick="abrirModalNuevaSeccion()">
                <i class="fas fa-plus"></i> Nueva sección
            </button>
        </div>
    </header>

    @if (secciones.Any())
    {
        <div class="navtree-toolbar">
            <div class="navtree-search">
                <i class="fas fa-search" aria-hidden="true"></i>
                <input type="search" id="navtreeBuscar" autocomplete="off"
                       placeholder="Buscar sección, módulo o vista…"
                       aria-label="Buscar sección, módulo o vista">
            </div>
            <div class="navtree-chips" role="group" aria-label="Filtrar por estado">
                <button type="button" class="navtree-chip is-active" data-filtro="todas">Todas</button>
                <button type="button" class="navtree-chip" data-filtro="activas">Activas</button>
                <button type="button" class="navtree-chip" data-filtro="ocultas">Ocultas</button>
            </div>
            <span class="navtree-hint"><i class="fas fa-arrows-up-down"></i> Arrastra para reordenar</span>
        </div>

        <div class="navtree" id="navtree">
            <div class="navtree__head" aria-hidden="true">
                <span class="navtree__col-handle"></span>
                <span class="navtree__col-num"></span>
                <span class="navtree__col-nombre">Sección</span>
                <span class="navtree__col-resp">Responsable</span>
                <span class="navtree__col-cont">Contenido</span>
                <span class="navtree__col-estado">Estado</span>
                <span class="navtree__col-acciones">Acciones</span>
            </div>

            @{ var indice = 0; }
            @foreach (var seccion in secciones)
            {
                indice++;
                var modulos = (seccion.Modulos ?? new List<Modulo>()).OrderBy(m => m.Orden).ThenBy(m => m.Title).ToList();
                var vistasSeccion = modulos.Sum(m => m.Vistas?.Count ?? 0);
                var sinResponsable = string.IsNullOrWhiteSpace(seccion.ResponsableNormativo);
                var sinDescripcion = string.IsNullOrWhiteSpace(seccion.Descripcion);

                <section class="navtree-item @(seccion.Activo ? "" : "is-oculta")"
                         data-seccion-id="@seccion.Id"
                         data-orden="@seccion.Orden"
                         data-activa="@seccion.Activo.ToString().ToLower()">

                    <div class="navtree-row navtree-row--seccion">
                        <button type="button" class="navtree-handle" title="Arrastra para cambiar el orden en el menú"
                                aria-label="Reordenar @seccion.Titulo">
                            <i class="fas fa-grip-vertical"></i>
                        </button>

                        <span class="navtree-num">@indice.ToString("00")</span>

                        <div class="navtree-nombre">
                            <a class="navtree-nombre__titulo" href="#"
                               onclick="abrirModalEditarSeccion(@seccion.Id); return false;">@seccion.Titulo</a>
                            <span class="navtree-nombre__desc @(sinDescripcion && sinResponsable ? "is-faint" : "")">
                                @if (sinDescripcion && sinResponsable)
                                {
                                    @:Sin descripción · sin responsable asignado
                                }
                                else if (sinDescripcion)
                                {
                                    @:Sin descripción
                                }
                                else
                                {
                                    @seccion.Descripcion
                                }
                            </span>
                        </div>

                        <div class="navtree-resp @(sinResponsable ? "is-faint" : "")">
                            @(sinResponsable ? "Sin asignar" : seccion.ResponsableNormativo)
                        </div>

                        <div class="navtree-cont">
                            @if (modulos.Any())
                            {
                                <button type="button" class="navtree-toggle" aria-expanded="false"
                                        data-target="modulos-@seccion.Id">
                                    <i class="fas fa-chevron-down navtree-toggle__caret"></i>
                                    <span>@modulos.Count módulo@(modulos.Count == 1 ? "" : "s") · @vistasSeccion vista@(vistasSeccion == 1 ? "" : "s")</span>
                                </button>
                            }
                            else
                            {
                                <span class="navtree-cont__vacio">Sin módulos</span>
                            }
                        </div>

                        <div class="navtree-estado">
                            <span class="shell-badge @(seccion.Activo ? "shell-badge--activa" : "shell-badge--oculta")">
                                @(seccion.Activo ? "Activa" : "Oculta")
                            </span>
                        </div>

                        <div class="navtree-acciones">
                            <button type="button" class="navtree-icon" title="Editar sección"
                                    onclick="abrirModalEditarSeccion(@seccion.Id)">
                                <i class="fas fa-pen"></i>
                            </button>
                            <div class="dropdown">
                                <button type="button" class="navtree-icon" data-bs-toggle="dropdown"
                                        data-bs-container="body" aria-expanded="false" title="Más acciones">
                                    <i class="fas fa-ellipsis"></i>
                                </button>
                                <ul class="dropdown-menu dropdown-menu-end navtree-menu">
                                    <li>
                                        <a class="dropdown-item" href="@Url.Action("EditarModulos", "Secciones", new { id = seccion.Id })">
                                            <i class="fas fa-cubes"></i> Gestionar módulos
                                        </a>
                                    </li>
                                    <li>
                                        <button class="dropdown-item" type="button"
                                                onclick="toggleActivarSeccion(@seccion.Id, @seccion.Activo.ToString().ToLower())">
                                            <i class="fas fa-@(seccion.Activo ? "eye-slash" : "eye")"></i>
                                            @(seccion.Activo ? "Ocultar del menú" : "Mostrar en el menú")
                                        </button>
                                    </li>
                                    <li><hr class="dropdown-divider"></li>
                                    <li>
                                        <button class="dropdown-item navtree-menu__danger" type="button"
                                                onclick="eliminarSeccionAjax(@seccion.Id)">
                                            <i class="fas fa-trash-can"></i> Eliminar sección
                                        </button>
                                    </li>
                                </ul>
                            </div>
                        </div>
                    </div>

                    @if (modulos.Any())
                    {
                        <div class="navtree-hijos" id="modulos-@seccion.Id" hidden>
                            @foreach (var modulo in modulos)
                            {
                                var vistas = (modulo.Vistas ?? new List<VistaSNIER>()).OrderBy(v => v.Orden).ThenBy(v => v.Titulo).ToList();

                                <div class="navtree-modulo" data-modulo-id="@modulo.Id"
                                     data-activa="@modulo.Activo.ToString().ToLower()">
                                    <div class="navtree-row navtree-row--modulo">
                                        <span class="navtree-handle navtree-handle--placeholder" aria-hidden="true"></span>
                                        <span class="navtree-num"></span>

                                        <div class="navtree-nombre navtree-nombre--modulo">
                                            <i class="fas fa-cube navtree-nombre__icono" aria-hidden="true"></i>
                                            <a class="navtree-nombre__titulo" href="#"
                                               onclick="abrirModalEditarModulo(@modulo.Id); return false;">@modulo.Title</a>
                                        </div>

                                        <div class="navtree-resp is-faint">—</div>

                                        <div class="navtree-cont">
                                            @if (vistas.Any())
                                            {
                                                <button type="button" class="navtree-toggle" aria-expanded="false"
                                                        data-target="vistas-@modulo.Id">
                                                    <i class="fas fa-chevron-right navtree-toggle__caret"></i>
                                                    <span>@vistas.Count vista@(vistas.Count == 1 ? "" : "s")</span>
                                                </button>
                                            }
                                            else
                                            {
                                                <span class="navtree-cont__vacio">Sin vistas</span>
                                            }
                                        </div>

                                        <div class="navtree-estado">
                                            <span class="shell-badge shell-badge--sm @(modulo.Activo ? "shell-badge--activa" : "shell-badge--oculta")">
                                                @(modulo.Activo ? "Activo" : "Oculto")
                                            </span>
                                        </div>

                                        <!-- El lápiz abre el módulo, igual que en la fila de sección.
                                             Salir a otra página es una acción distinta y vive en el menú. -->
                                        <div class="navtree-acciones">
                                            <button type="button" class="navtree-icon" title="Editar módulo"
                                                    onclick="abrirModalEditarModulo(@modulo.Id)">
                                                <i class="fas fa-pen"></i>
                                            </button>
                                            <div class="dropdown">
                                                <button type="button" class="navtree-icon" data-bs-toggle="dropdown"
                                                        data-bs-container="body" aria-expanded="false" title="Más acciones">
                                                    <i class="fas fa-ellipsis"></i>
                                                </button>
                                                <ul class="dropdown-menu dropdown-menu-end navtree-menu">
                                                    <li>
                                                        <a class="dropdown-item" href="@Url.Action("EditarVistas", "Secciones", new { moduloId = modulo.Id })">
                                                            <i class="fas fa-list"></i> Gestionar vistas
                                                        </a>
                                                    </li>
                                                </ul>
                                            </div>
                                        </div>
                                    </div>

                                    @if (vistas.Any())
                                    {
                                        <div class="navtree-nietos" id="vistas-@modulo.Id" hidden>
                                            @foreach (var vista in vistas)
                                            {
                                                <div class="navtree-row navtree-row--vista"
                                                     data-activa="@vista.Activa.ToString().ToLower()">
                                                    <span class="navtree-handle navtree-handle--placeholder" aria-hidden="true"></span>
                                                    <span class="navtree-num"></span>

                                                    <div class="navtree-nombre navtree-nombre--vista">
                                                        <span class="navtree-nombre__titulo">@vista.Titulo</span>
                                                    </div>

                                                    <div class="navtree-resp is-faint">—</div>

                                                    <div class="navtree-cont">
                                                        <code class="navtree-ruta">/@vista.Controller/@vista.Action</code>
                                                    </div>

                                                    <div class="navtree-estado">
                                                        <span class="shell-badge shell-badge--sm @(vista.Activa ? "shell-badge--activa" : "shell-badge--oculta")">
                                                            @(vista.Activa ? "Activa" : "Oculta")
                                                        </span>
                                                    </div>

                                                    <div class="navtree-acciones"></div>
                                                </div>
                                            }
                                        </div>
                                    }
                                </div>
                            }

                            <a class="navtree-agregar" href="@Url.Action("CrearModulo", "Secciones", new { seccionId = seccion.Id })">
                                <i class="fas fa-plus"></i> Agregar módulo
                            </a>
                        </div>
                    }
                </section>
            }
        </div>

        <footer class="navtree-foot">
            <span id="navtreeConteo">Mostrando las @secciones.Count secciones</span>
            <span class="navtree-foot__hint">El orden se guarda al soltar</span>
        </footer>
    }
    else
    {
        <div class="navtree-vacio">
            <i class="fas fa-circle-info"></i>
            <span>
                <strong>Todavía no hay secciones</strong>
                El menú del sistema se arma con esta lista. Empieza con «Nueva sección».
            </span>
        </div>
    }

</div> <!-- Fin del contenedor principal -->

<!-- Modal para crear/editar sección -->
<div class="modal fade" id="seccionModal" tabindex="-1">
    <div class="modal-dialog modal-xl modal-fullscreen-md-down">
        <div class="modal-content">
            <div id="contenidoModalSeccion">
                <!-- Aquí se carga el contenido dinámico -->
            </div>
        </div>
    </div>
</div>

<!-- Modal de módulo. El árbol edita los tres niveles sin salir de la página,
     así que el módulo también se abre aquí y no manda a otra pantalla. -->
<div class="modal fade" id="moduloModal" tabindex="-1">
    <div class="modal-dialog modal-xl modal-fullscreen-md-down">
        <div class="modal-content">
            <div id="contenidoModalModulo">
                <!-- Aquí se carga el contenido dinámico -->
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="~/js/navtree-orden.js" asp-append-version="true"></script>
    <script>
        let seccionModal;
        let moduloModal;

        $(document).ready(function () {
            // Los modales se cuelgan de <body> antes de instanciarlos. Si se
            // quedan dentro de <main>, que trae isolation: isolate, su z-index
            // no compite con el velo y aparecen por debajo, apagados y sin
            // forma de cerrarlos. Mismo criterio que EditarModulos y EditarVistas.
            const seccionEl = document.getElementById('seccionModal');
            document.body.appendChild(seccionEl);
            seccionModal = new bootstrap.Modal(seccionEl);

            const moduloEl = document.getElementById('moduloModal');
            document.body.appendChild(moduloEl);
            moduloModal = new bootstrap.Modal(moduloEl);

            inicializarArbol();
        });

        /* ------------------------------------------------------------------
         * Árbol: abrir/cerrar, buscar, filtrar y reordenar
         * ---------------------------------------------------------------- */
        function inicializarArbol() {
            const arbol = document.getElementById('navtree');
            if (!arbol) return;

            // Un solo listener delegado para los tres niveles.
            arbol.addEventListener('click', function (ev) {
                const toggle = ev.target.closest('.navtree-toggle');
                if (!toggle) return;
                const destino = document.getElementById(toggle.dataset.target);
                if (!destino) return;
                const abierto = toggle.getAttribute('aria-expanded') === 'true';
                toggle.setAttribute('aria-expanded', String(!abierto));
                destino.hidden = abierto;
            });

            inicializarBusqueda();
            inicializarChips();
            activarArrastreNavtree(arbol, {
                campoId: 'seccionId',
                atributo: 'seccionId',
                url: '@Url.Action("ActualizarOrdenSecciones", "Secciones")'
            });
        }

        function inicializarBusqueda() {
            const campo = document.getElementById('navtreeBuscar');
            if (!campo) return;
            let temporizador;
            campo.addEventListener('input', function () {
                clearTimeout(temporizador);
                temporizador = setTimeout(aplicarFiltros, 150);
            });
        }

        function inicializarChips() {
            document.querySelectorAll('.navtree-chip').forEach(function (chip) {
                chip.addEventListener('click', function () {
                    document.querySelectorAll('.navtree-chip').forEach(c => c.classList.remove('is-active'));
                    chip.classList.add('is-active');
                    aplicarFiltros();
                });
            });
        }

        function filtroActivo() {
            const chip = document.querySelector('.navtree-chip.is-active');
            return chip ? chip.dataset.filtro : 'todas';
        }

        function aplicarFiltros() {
            const campo = document.getElementById('navtreeBuscar');
            const texto = (campo ? campo.value : '').trim().toLowerCase();
            const filtro = filtroActivo();
            let visibles = 0;

            document.querySelectorAll('.navtree-item').forEach(function (item) {
                const activa = item.dataset.activa === 'true';
                let pasaEstado = true;
                if (filtro === 'activas') pasaEstado = activa;
                if (filtro === 'ocultas') pasaEstado = !activa;

                // La búsqueda mira los tres niveles: si un módulo o una vista
                // coincide, la sección se muestra y se abre en el sitio.
                let pasaTexto = true;
                let coincideHijo = false;
                if (texto) {
                    const enSeccion = item.querySelector('.navtree-row--seccion').innerText.toLowerCase().includes(texto);
                    coincideHijo = Array.from(item.querySelectorAll('.navtree-row--modulo, .navtree-row--vista'))
                        .some(r => r.innerText.toLowerCase().includes(texto));
                    pasaTexto = enSeccion || coincideHijo;
                }

                const mostrar = pasaEstado && pasaTexto;
                item.hidden = !mostrar;
                if (mostrar) visibles++;

                if (mostrar && coincideHijo) abrirRama(item);
            });

            const conteo = document.getElementById('navtreeConteo');
            if (conteo) {
                const total = document.querySelectorAll('.navtree-item').length;
                conteo.textContent = (visibles === total)
                    ? ('Mostrando las ' + total + ' secciones')
                    : ('Mostrando ' + visibles + ' de ' + total + ' secciones');
            }
        }

        function abrirRama(item) {
            item.querySelectorAll('.navtree-toggle').forEach(function (t) {
                const destino = document.getElementById(t.dataset.target);
                if (destino) { destino.hidden = false; t.setAttribute('aria-expanded', 'true'); }
            });
        }

        /* El arrastre vive en ~/js/navtree-orden.js, compartido con las
         * pantallas de módulos y de vistas. */

        /* Previsualización: el menú tal como lo verá el usuario, es decir solo
         * lo activo y en el orden actual de la lista. */
        function previsualizarMenu() {
            const lineas = [];
            document.querySelectorAll('.navtree-item').forEach(function (item) {
                if (item.dataset.activa !== 'true') return;
                const titulo = item.querySelector('.navtree-nombre__titulo').textContent.trim();
                const modulos = Array.from(item.querySelectorAll('.navtree-modulo'))
                    .filter(m => m.dataset.activa === 'true')
                    .map(m => m.querySelector('.navtree-nombre__titulo').textContent.trim());
                lineas.push(
                    '<li><strong>' + titulo + '</strong>' +
                    (modulos.length ? '<ul>' + modulos.map(t => '<li>' + t + '</li>').join('') + '</ul>' : '') +
                    '</li>'
                );
            });

            Swal.fire({
                title: 'Menú como lo verá el usuario',
                html: lineas.length
                    ? '<ul class="navtree-preview">' + lineas.join('') + '</ul>'
                    : '<p>No hay secciones activas, así que el menú saldría vacío.</p>',
                width: 620,
                confirmButtonText: 'Cerrar'
            });
        }

        /* ------------------------------------------------------------------
         * Modales y acciones (sin cambios de contrato con el servidor)
         * ---------------------------------------------------------------- */
        function abrirModalNuevaSeccion() {
            cargarModalSeccion('@Url.Action("CrearSeccion", "Secciones")');
        }

        function abrirModalEditarSeccion(seccionId) {
            cargarModalSeccion('@Url.Action("ModalEditarSeccion", "Secciones")?id=' + seccionId);
        }

        function abrirModalEditarModulo(moduloId) {
            cargarEnModal(moduloModal, '#contenidoModalModulo',
                '@Url.Action("ModalEditarModulo", "Secciones")?id=' + moduloId);
        }

        function cargarModalSeccion(url) {
            cargarEnModal(seccionModal, '#contenidoModalSeccion', url);
        }

        function cargarEnModal(instancia, contenedor, url) {
            $(contenedor).html('<div class="text-center p-4"><i class="fas fa-spinner fa-spin fa-2x"></i><br>Cargando...</div>');
            instancia.show();

            $.get(url)
                .done(function (html) {
                    $(contenedor).html(html);
                })
                .fail(function (xhr) {
                    instancia.hide();
                    let mensaje = 'Error al cargar el modal';
                    if (xhr.status === 404) mensaje = 'Modal no encontrado';
                    else if (xhr.status === 400) mensaje = xhr.responseText || 'Datos incorrectos';
                    else if (xhr.status === 500) mensaje = 'Error interno del servidor';
                    Swal.fire('Error', mensaje, 'error');
                });
        }

        function toggleActivarSeccion(seccionId, estaActiva) {
            const accion = estaActiva ? 'ocultar' : 'mostrar';

            Swal.fire({
                title: estaActiva ? '¿Ocultar del menú?' : '¿Mostrar en el menú?',
                text: estaActiva
                    ? 'La sección dejará de aparecer en el menú, pero no se borra nada.'
                    : 'La sección volverá a aparecer en el menú.',
                icon: 'question',
                showCancelButton: true,
                confirmButtonText: 'Sí, ' + accion,
                cancelButtonText: 'Cancelar'
            }).then((result) => {
                if (!result.isConfirmed) return;
                $.post('@Url.Action("ToggleActivarSeccion", "Secciones")', {
                    id: seccionId,
                    activar: !estaActiva
                })
                    .done(function (response) {
                        Swal.fire('Éxito', response.mensaje, 'success').then(() => location.reload());
                    })
                    .fail(function () {
                        Swal.fire('Error', 'Error al cambiar el estado de la sección', 'error');
                    });
            });
        }

        function eliminarSeccionAjax(seccionId) {
            Swal.fire({
                title: '¿Eliminar sección?',
                text: "Esta acción eliminará la sección y todos sus módulos y vistas asociadas",
                icon: 'warning',
                showCancelButton: true,
                confirmButtonColor: '#d33',
                cancelButtonColor: '#6c757d',
                confirmButtonText: 'Sí, eliminar',
                cancelButtonText: 'Cancelar'
            }).then((result) => {
                if (!result.isConfirmed) return;

                $.ajax({
                    url: '@Url.Action("EliminarSeccionAjax", "Secciones")',
                    method: 'POST',
                    data: { id: seccionId },
                    success: function (response) {
                        if (response.success || response.mensaje) {
                            Swal.fire({
                                title: '¡Eliminada!',
                                text: response.mensaje || 'Sección eliminada correctamente',
                                icon: 'success',
                                timer: 2000,
                                showConfirmButton: false
                            }).then(() => location.reload());
                        } else if (response.error) {
                            Swal.fire('Error', response.error, 'error');
                        } else {
                            Swal.fire('Error', 'Respuesta inesperada del servidor', 'error');
                        }
                    },
                    error: function (xhr) {
                        let mensaje = 'Error al eliminar la sección';
                        if (xhr.status === 400) mensaje = xhr.responseText || 'Datos incorrectos';
                        else if (xhr.status === 404) mensaje = 'Método no encontrado en el servidor';
                        else if (xhr.status === 500) mensaje = 'Error interno del servidor';
                        Swal.fire('Error', mensaje, 'error');
                    }
                });
            });
        }
    </script>
}
