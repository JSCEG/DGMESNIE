@model NSIE.Models.SeccionConModulos
@using NSIE.Models
@using Microsoft.AspNetCore.Http
@using Newtonsoft.Json
@inject IHttpContextAccessor HttpContextAccessor

@{
    ViewData["Title"] = $"Módulos de la Sección: {Model.Titulo}";

    var header = new HeaderViewModel
    {
        Title = ViewData["Title"].ToString(),
        IconPath = "modulos.png", // Ruta relativa desde img_snier
        Description = $"Administra los módulos asociados a la sección: {Model.Titulo}.",
        Section = $"Administración > Secciones > {Model.Titulo}",
        ModuleInfo = JsonConvert.SerializeObject(new
        {
            title = $"Módulos de la Sección: {Model.Titulo}",
            description = $"Aquí puedes gestionar los módulos que pertenecen a la sección '{Model.Titulo}'. Puedes crear nuevos módulos, editar los existentes, y organizar sus vistas.",
            functionality = "Creación, edición, eliminación y gestión de vistas para cada módulo dentro de la sección.",
            stage = "Operación",
            roles = new[] {
                new { icon = "user-shield", text = "Administradores: Gestión completa de módulos y vistas." },
                new { icon = "eye", text = "Usuarios: Visualización de módulos y sus vistas." }
            },
            order = new { step = 2, description = "Gestión de contenido detallado por sección." },
            manualUrl = "/Documentos/ManualGestionModulos.pdf" // Placeholder for a specific manual
        })
    };
}

@Html.AntiForgeryToken()

@await Html.PartialAsync("_ViewHeader", header)

<div class="container-fluid px-3 px-lg-4 secciones-page">
    <!-- Miga de pan (Breadcrumbs) -->
    <nav aria-label="breadcrumb" class="mb-3">
        <ol class="breadcrumb">
            <li class="breadcrumb-item"><a href="@Url.Action("Index", "Home")"><i class="fas fa-home me-1"></i>Inicio</a></li>
            <li class="breadcrumb-item"><a href="@Url.Action("Index", "Secciones")">Gestión de Secciones</a></li>
            <li class="breadcrumb-item active" aria-current="page">Módulos de @Model.Titulo</li>
        </ol>
    </nav>

@{
    var modulos = Model.Modulos.OrderBy(m => m.Orden).ThenBy(m => m.Title).ToList();
    var vistasDeLaSeccion = modulos.Sum(m => m.Vistas?.Count ?? 0);
}

<header class="navtree-head">
    <!-- Sin título propio: _ViewHeader ya encabeza la página con el nombre de la
         sección, y repetirlo aquí daba dos veces lo mismo. -->
    <div class="navtree-head__text">
        <p class="navtree-head__sub">
            <strong>@modulos.Count</strong> módulo@(modulos.Count == 1 ? "" : "s") ·
            <strong>@vistasDeLaSeccion</strong> vista@(vistasDeLaSeccion == 1 ? "" : "s").
            El orden de esta lista es el orden dentro de la sección.
        </p>
    </div>
    <div class="navtree-head__actions">
        <a class="navtree-btn" href="@Url.Action("Index", "Secciones")">
            <i class="fas fa-arrow-left"></i> Volver al árbol
        </a>
        <button type="button" class="navtree-btn navtree-btn--primary" onclick="abrirModalNuevoModulo()">
            <i class="fas fa-plus"></i> Nuevo módulo
        </button>
    </div>
</header>

@if (modulos.Any())
{
    <div class="navtree-toolbar">
        <span class="navtree-hint ms-0"><i class="fas fa-arrows-up-down"></i> Arrastra para reordenar · el orden se guarda al soltar</span>
    </div>
}

@if (modulos.Any())
{
    <div class="navtree" id="navtreeModulos">
        <div class="navtree__head" aria-hidden="true">
            <span class="navtree__col-handle"></span>
            <span class="navtree__col-num"></span>
            <span class="navtree__col-nombre">Módulo</span>
            <span class="navtree__col-resp">Ruta</span>
            <span class="navtree__col-cont">Contenido</span>
            <span class="navtree__col-estado">Estado</span>
            <span class="navtree__col-acciones">Acciones</span>
        </div>

        @{ var indice = 0; }
        @foreach (var modulo in modulos)
        {
            indice++;
            var vistas = (modulo.Vistas ?? new List<VistaSNIER>()).OrderBy(v => v.Orden).ThenBy(v => v.Titulo).ToList();
            var sinDescripcion = string.IsNullOrWhiteSpace(modulo.Desc);

            <section class="navtree-item @(modulo.Activo ? "" : "is-oculta")"
                     data-modulo-id="@modulo.Id" data-orden="@modulo.Orden">
                <div class="navtree-row navtree-row--seccion">
                    <button type="button" class="navtree-handle" title="Arrastra para cambiar el orden dentro de la sección"
                            aria-label="Reordenar @modulo.Title">
                        <i class="fas fa-grip-vertical"></i>
                    </button>
                    <span class="navtree-num">@indice.ToString("00")</span>

                    <div class="navtree-nombre">
                        <a class="navtree-nombre__titulo" href="#"
                           onclick="abrirModalEditarModulo(@modulo.Id); return false;">@modulo.Title</a>
                        <span class="navtree-nombre__desc @(sinDescripcion ? "is-faint" : "")">
                            @(sinDescripcion ? "Sin descripción" : modulo.Desc)
                        </span>
                    </div>

                    <div class="navtree-resp">
                        <code class="navtree-ruta">/@modulo.Controller/@modulo.Action</code>
                    </div>

                    <div class="navtree-cont">
                        @if (vistas.Any())
                        {
                            <button type="button" class="navtree-toggle" aria-expanded="false"
                                    data-target="vistas-mod-@modulo.Id">
                                <i class="fas fa-chevron-down navtree-toggle__caret"></i>
                                <span>@vistas.Count vista@(vistas.Count == 1 ? "" : "s")</span>
                            </button>
                        }
                        else
                        {
                            <span class="navtree-cont__vacio">Sin vistas</span>
                        }
                    </div>

                    <div class="navtree-estado">
                        <span class="navtree-badge @(modulo.Activo ? "navtree-badge--activa" : "navtree-badge--oculta")">
                            @(modulo.Activo ? "Activo" : "Oculto")
                        </span>
                    </div>

                    <div class="navtree-acciones">
                        <button type="button" class="navtree-icon" title="Editar módulo"
                                onclick="abrirModalEditarModulo(@modulo.Id)">
                            <i class="fas fa-pen"></i>
                        </button>
                        <div class="dropdown">
                            <button type="button" class="navtree-icon" data-bs-toggle="dropdown"
                                    data-bs-container="body" aria-expanded="false" title="Más acciones">
                                <i class="fas fa-ellipsis"></i>
                            </button>
                            <ul class="dropdown-menu dropdown-menu-end navtree-menu">
                                <li>
                                    <a class="dropdown-item" asp-action="EditarVistas" asp-route-moduloId="@modulo.Id">
                                        <i class="fas fa-list"></i> Gestionar vistas
                                    </a>
                                </li>
                                <li><hr class="dropdown-divider"></li>
                                <li>
                                    <button class="dropdown-item navtree-menu__danger" type="button"
                                            onclick="eliminarModuloAjax(@modulo.Id)">
                                        <i class="fas fa-trash-can"></i> Eliminar módulo
                                    </button>
                                </li>
                            </ul>
                        </div>
                    </div>
                </div>

                @if (vistas.Any())
                {
                    <div class="navtree-hijos" id="vistas-mod-@modulo.Id" hidden>
                        @foreach (var vista in vistas)
                        {
                            <div class="navtree-row navtree-row--modulo">
                                <span class="navtree-handle navtree-handle--placeholder" aria-hidden="true"></span>
                                <span class="navtree-num"></span>

                                <div class="navtree-nombre navtree-nombre--modulo">
                                    <i class="fas fa-file-lines navtree-nombre__icono" aria-hidden="true"></i>
                                    <span class="navtree-nombre__titulo">@vista.Titulo</span>
                                </div>

                                <div class="navtree-resp">
                                    <code class="navtree-ruta">/@vista.Controller/@vista.Action</code>
                                </div>

                                <div class="navtree-cont">
                                    <span class="navtree-cont__vacio">@(vista.EsExterno ? "Enlace externo" : "Ruta interna")</span>
                                </div>

                                <div class="navtree-estado">
                                    <span class="navtree-badge navtree-badge--sm @(vista.Activa ? "navtree-badge--activa" : "navtree-badge--oculta")">
                                        @(vista.Activa ? "Activa" : "Oculta")
                                    </span>
                                </div>

                                <div class="navtree-acciones"></div>
                            </div>
                        }

                        <a class="navtree-agregar" asp-action="EditarVistas" asp-route-moduloId="@modulo.Id">
                            <i class="fas fa-pen"></i> Administrar estas vistas
                        </a>
                    </div>
                }
            </section>
        }
    </div>
}
else
{
    <div class="navtree-vacio">
        <i class="fas fa-circle-info"></i>
        <span>
            <strong>Esta sección aún no tiene módulos</strong>
            Sin módulos no aparece nada colgando de ella en el menú. Empieza con «Nuevo módulo».
        </span>
    </div>
}

<!-- Modal para crear/editar módulo -->
<div class="modal fade" id="moduloModal" tabindex="-1">
    <div class="modal-dialog modal-lg modal-fullscreen-md-down">
        <div class="modal-content">
            <div id="contenidoModalModulo">
                <!-- Aquí se carga el contenido dinámico -->
            </div>
        </div>
    </div>
</div>
</div>


@section Scripts {
    <script src="~/js/navtree-orden.js" asp-append-version="true"></script>
    <script>
        let moduloModal;

        $(document).ready(function () {
            const modalEl = document.getElementById('moduloModal');
            document.body.appendChild(modalEl);
            moduloModal = new bootstrap.Modal(modalEl);

            // Mismo despliegue en el sitio que el árbol de secciones: un solo
            // listener delegado, sin DataTables de por medio.
            const arbol = document.getElementById('navtreeModulos');
            if (arbol) {
                arbol.addEventListener('click', function (ev) {
                    const toggle = ev.target.closest('.navtree-toggle');
                    if (!toggle) return;
                    const destino = document.getElementById(toggle.dataset.target);
                    if (!destino) return;
                    const abierto = toggle.getAttribute('aria-expanded') === 'true';
                    toggle.setAttribute('aria-expanded', String(!abierto));
                    destino.hidden = abierto;
                });

                activarArrastreNavtree(arbol, {
                    campoId: 'moduloId',
                    atributo: 'moduloId',
                    url: '@Url.Action("ActualizarOrdenModulos", "Secciones")'
                });
            }
        });

        function abrirModalNuevoModulo() {
            const url = '@Url.Action("CrearModulo", "Secciones", new { seccionId = Model.Id })';
            cargarModalModulo(url);
        }

        function abrirModalEditarModulo(moduloId) {
            const url = '@Url.Action("ModalEditarModulo", "Secciones")?id=' + moduloId;
            cargarModalModulo(url);
        }

        function cargarModalModulo(url) {
            $.get(url)
                .done(function (html) {
                    $('#contenidoModalModulo').html(html);
                    moduloModal.show();
                })
                .fail(function (xhr, status, error) {
                    console.error('Error cargando modal:', error);
                    Swal.fire('Error', 'Error al cargar el modal: ' + error, 'error');
                });
        }

        function eliminarModuloAjax(moduloId) {
            Swal.fire({
                title: '¿Eliminar módulo?',
                text: "Esta acción eliminará el módulo y todas sus vistas asociadas",
                icon: 'warning',
                showCancelButton: true,
                confirmButtonColor: '#d33',
                cancelButtonColor: '#6c757d',
                confirmButtonText: 'Sí, eliminar',
                cancelButtonText: 'Cancelar'
            }).then((result) => {
                if (result.isConfirmed) {
                    // Buscar el token de múltiples formas
                    let token = $('input[name="__RequestVerificationToken"]').val();

                    // Si no se encuentra, buscar en forms
                    if (!token) {
                        token = $('form input[name="__RequestVerificationToken"]').val();
                    }

                    // Si aún no se encuentra, buscar en cualquier lugar
                    if (!token) {
                        token = $('input[name*="RequestVerificationToken"]').val();
                    }

                    console.log('🔍 Debug info:');
                    console.log('- Token encontrado:', token ? 'SÍ' : 'NO');
                    console.log('- Token value:', token);
                    console.log('- Módulo ID:', moduloId);
                    console.log('- Sección ID:', '@Model.Id');

                    // Preparar los datos
                    const postData = {
                        id: moduloId,
                        seccionId: '@Model.Id'
                    };

                    // Solo agregar token si existe
                    if (token) {
                        postData.__RequestVerificationToken = token;
                    }

                    console.log('- Datos a enviar:', postData);

                    $.ajax({
                        url: '@Url.Action("EliminarModulo", "Secciones")',
                        method: 'POST',
                        data: postData,
                        success: function (data) {
                            console.log('✅ Módulo eliminado exitosamente:', data);
                            Swal.fire({
                                title: '¡Eliminado!',
                                text: data.mensaje || 'Módulo eliminado correctamente',
                                icon: 'success',
                                timer: 2000,
                                showConfirmButton: false
                            }).then(() => {
                                location.reload();
                            });
                        },
                        error: function (xhr, status, error) {
                            console.error('❌ Error completo:', {
                                status: xhr.status,
                                statusText: xhr.statusText,
                                responseText: xhr.responseText,
                                error: error,
                                readyState: xhr.readyState
                            });

                            let mensaje = 'Error al eliminar el módulo';

                            if (xhr.status === 400) {
                                mensaje = 'Token de verificación inválido o datos incorrectos';
                            } else if (xhr.status === 404) {
                                mensaje = 'Módulo no encontrado';
                            } else if (xhr.status === 500) {
                                mensaje = 'Error interno del servidor';
                            }

                            Swal.fire({
                                title: 'Error',
                                text: mensaje,
                                icon: 'error',
                                footer: xhr.responseText ? 'Detalles: ' + xhr.responseText : ''
                            });
                        }
                    });
                }
            });
        }

    </script>
}
