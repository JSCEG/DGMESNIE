@model NSIE.Models.SeccionSNIER
@using Microsoft.AspNetCore.Http
@using Newtonsoft.Json
@inject IHttpContextAccessor HttpContextAccessor

@{
    ViewData["Title"] = "Crear nueva sección";
    var httpContext = HttpContextAccessor.HttpContext;
    var perfilUsuarioJson = httpContext.Session.GetString("PerfilUsuario");
    var perfilUsuario = JsonConvert.DeserializeObject<PerfilUsuario>(perfilUsuarioJson);
}

<div class="modal-sec__header">
    <div>
        <span class="modal-sec__kicker">Estructura de navegación</span>
        <h5 class="modal-sec__title">Nueva sección</h5>
    </div>
    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Cerrar"></button>
</div>

<div class="modal-sec__body">
    <form id="formCrearSeccion" class="form-sec">
        @Html.AntiForgeryToken()

        <div class="row">
            <div class="col-md-6 mb-3">
                <label asp-for="Titulo" class="form-label"> Título de la Sección *
                </label>
                <input asp-for="Titulo" class="form-control" required placeholder="Ingrese el título..." />
                <span asp-validation-for="Titulo" class="text-danger"></span>
            </div>

            <div class="col-md-6 mb-3">
                <label asp-for="FundamentoLegal" class="form-label"> Fundamento Legal
                </label>
                <input asp-for="FundamentoLegal" class="form-control" placeholder="Ej: Art. 70, 71, 75 Reglamento" />
            </div>
        </div>

        <div class="row">
            <div class="col-md-12 mb-3">
                <label asp-for="Descripcion" class="form-label"> Descripción
                </label>
                <textarea asp-for="Descripcion" class="form-control" rows="3"
                    placeholder="Descripción general de la sección..."></textarea>
            </div>
        </div>

        <div class="row">
            <div class="col-md-6 mb-3">
                <label asp-for="Objetivo" class="form-label"> Objetivo
                </label>
                <input asp-for="Objetivo" class="form-control" placeholder="Objetivo principal..." />
            </div>

            <div class="col-md-6 mb-3">
                <label asp-for="ResponsableNormativo" class="form-label"> Responsable Normativo
                </label>
                <input asp-for="ResponsableNormativo" class="form-control" placeholder="Unidad responsable..." />
            </div>
        </div>

        <div class="row">
            <div class="col-md-6 mb-3">
                <label asp-for="PublicoObjetivo" class="form-label"> Público Objetivo
                </label>
                <input asp-for="PublicoObjetivo" class="form-control" placeholder="A quién va dirigido..." />
            </div>

            <div class="col-md-6 mb-3">
                <label asp-for="Ayuda" class="form-label"> Ayuda General
                </label>
                <input asp-for="Ayuda" class="form-control" placeholder="Información de ayuda..." />
            </div>
        </div>

        <div class="row">
            <div class="col-md-6 mb-3">
                <div class="form-sec__estado">
                    <span class="form-sec__estado-texto">
                        <span class="form-sec__estado-titulo">Visible en el menú</span>
                        <span class="form-sec__estado-ayuda">Apágalo si aún no quieres publicarla.</span>
                    </span>
                    <input asp-for="SeccionActiva" class="form-check-input" type="checkbox" role="switch" checked />
                </div>
            </div>
        </div>
    </form>
</div>

<div class="modal-sec__foot">
    <button type="button" class="btn-sec" data-bs-dismiss="modal">Cancelar</button>
    <button type="button" class="btn-sec btn-sec--primary" id="btnGuardarSeccion"><i class="bi bi-check-lg"></i> Crear sección
    </button>
</div>

<script>
    $(document).ready(function () {
        console.log('>>> Script del modal crear sección cargado');

        // Evento click del botón guardar
        $('#btnGuardarSeccion').on('click', function (e) {
            e.preventDefault();
            console.log('>>> Click en btnGuardarSeccion');

            const $btn = $(this);
            const $form = $('#formCrearSeccion');

            // Validación básica
            const titulo = $form.find('input[name="Titulo"]').val().trim();
            if (!titulo) {
                Swal.fire('Error', 'El título es obligatorio', 'error');
                return;
            }

            // Deshabilitar botón
            $btn.prop('disabled', true).html('<i class="bi bi-arrow-repeat bi-spin"></i> Guardando…');

            const formData = $form.serialize();
            console.log('>>> Datos del formulario:', formData);

            $.ajax({
                url: '@Url.Action("GuardarNuevaSeccion", "Secciones")',
                method: 'POST',
                data: formData,
                timeout: 30000,
                success: function (response) {
                    console.log('>>> Respuesta del servidor:', response);

                    if (response.mensaje) {
                        console.log('>>> Sección creada exitosamente');

                        // Cerrar modal
                        seccionModal.hide();

                        // Mostrar mensaje de éxito
                        Swal.fire({
                            title: '¡Éxito!',
                            text: response.mensaje,
                            icon: 'success',
                            timer: 2000,
                            showConfirmButton: false
                        }).then(() => {
                            console.log('>>> Recargando página...');
                            location.reload();
                        });
                    } else if (response.error) {
                        console.error('>>> Error del servidor:', response.error);
                        Swal.fire('Error', response.error, 'error');

                        // Rehabilitar botón
                        $btn.prop('disabled', false).html('<i class="bi bi-check-lg"></i> Crear sección');
                    } else {
                        console.error('>>> Respuesta inesperada:', response);
                        Swal.fire('Error', 'Respuesta inesperada del servidor', 'error');

                        // Rehabilitar botón
                        $btn.prop('disabled', false).html('<i class="bi bi-check-lg"></i> Crear sección');
                    }
                },
                error: function (xhr, status, error) {
                    console.error('>>> Error AJAX:', {
                        status: xhr.status,
                        statusText: xhr.statusText,
                        responseText: xhr.responseText,
                        error: error
                    });

                    let mensaje = 'Error de comunicación con el servidor';

                    if (xhr.status === 400) {
                        mensaje = xhr.responseText || 'Datos incorrectos';
                    } else if (xhr.status === 404) {
                        mensaje = 'Método no encontrado en el servidor';
                    } else if (xhr.status === 500) {
                        mensaje = 'Error interno del servidor';
                    } else if (status === 'timeout') {
                        mensaje = 'Tiempo de espera agotado';
                    }

                    Swal.fire('Error', mensaje, 'error');

                    // Rehabilitar botón
                    $btn.prop('disabled', false).html('<i class="bi bi-check-lg"></i> Crear sección');
                }
            });
        });

        // También manejar submit del form por si acaso
        $('#formCrearSeccion').on('submit', function (e) {
            e.preventDefault();
            $('#btnGuardarSeccion').click();
        });
    });
</script>

