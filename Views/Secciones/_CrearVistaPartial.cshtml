@model NSIE.Models.ModulosVista

<div class="modal-header">
    <h5 class="modal-title">
        <i class="fas fa-plus-circle text-success"></i>
        Nueva Vista para: @Model.ModuloTitle
    </h5>
    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
</div>

<form id="formCrearVista">
    @Html.AntiForgeryToken()
    <div class="modal-body">
        <input asp-for="ModuloId" type="hidden" />

        <div class="row">
            <div class="col-12">
                <div class="alert alert-info">
                    <i class="fas fa-info-circle"></i>
                    <strong>Módulo:</strong> @Model.ModuloTitle (ID: @Model.ModuloId)
                </div>
            </div>
        </div>

        <div class="row">
            <div class="col-md-8">
                <label asp-for="Titulo" class="form-label">Título de la Vista *</label>
                <input asp-for="Titulo" class="form-control" required placeholder="Ej: Listado de Usuarios" />
                <span asp-validation-for="Titulo" class="text-danger"></span>
            </div>
            <div class="col-md-4">
                <label asp-for="Orden" class="form-label">Orden</label>
                <input asp-for="Orden" type="number" class="form-control" min="1" value="1" />
                <span asp-validation-for="Orden" class="text-danger"></span>
            </div>
        </div>

        <div class="row mt-3">
            <div class="col-md-6">
                <label asp-for="Controller" class="form-label">Controller *</label>
                <input asp-for="Controller" class="form-control" required placeholder="Ej: Usuarios" />
                <span asp-validation-for="Controller" class="text-danger"></span>
            </div>
            <div class="col-md-6">
                <label asp-for="Action" class="form-label">Action *</label>
                <input asp-for="Action" class="form-control" required placeholder="Ej: Index" />
                <span asp-validation-for="Action" class="text-danger"></span>
            </div>
        </div>

        <div class="row mt-3">
            <div class="col-md-6">
                <label asp-for="Roles" class="form-label">Roles (IDs separados por coma)</label>
                <input asp-for="Roles" class="form-control" placeholder="Ej: 1,3,5" />
                <small class="form-text text-muted">Dejar vacío para todos los roles</small>
            </div>
            <div class="col-md-6">
                <label class="form-label fw-bold">Usuarios con acceso</label>
                <div class="input-group mb-2">
                    <span class="input-group-text bg-white"><i class="fas fa-search text-muted"></i></span>
                    <input type="text" id="buscarUsuarioCrearVista" class="form-control form-control-sm" placeholder="Buscar usuario..." />
                </div>
                <div id="usuariosCheckboxContainerCrearVista" class="border rounded p-2 bg-light mb-1" style="max-height: 150px; overflow-y: auto;">
                    <div class="text-muted small"><i class="fas fa-spinner fa-spin me-1"></i> Cargando usuarios...</div>
                </div>
                <input type="hidden" asp-for="Perfiles" id="inputPerfilesHiddenCrearVista" />
                <small class="form-text text-muted">Dejar vacío para permitir el acceso a todos los usuarios.</small>
            </div>
        </div>

        <div class="row mt-3">
            <div class="col-md-6">
                <div class="form-check">
                    <input asp-for="Activa" class="form-check-input" type="checkbox" checked />
                    <label asp-for="Activa" class="form-check-label">Vista Activa</label>
                </div>
            </div>
            <div class="col-md-6">
                <div class="form-check">
                    <input asp-for="EsExterno" class="form-check-input" type="checkbox" />
                    <label asp-for="EsExterno" class="form-check-label">Es Enlace Externo</label>
                </div>
            </div>
        </div>
    </div>

    <div class="modal-footer">
        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">
            <i class="fas fa-times"></i> Cancelar
        </button>
        <button type="submit" class="btn btn-success">
            <i class="fas fa-save"></i> Guardar Vista
        </button>
    </div>
</form>

<script>
    $(document).ready(function () {
        const hiddenInput = $("#inputPerfilesHiddenCrearVista");
        const container = $("#usuariosCheckboxContainerCrearVista");
        const initialValues = (hiddenInput.val() || "").split(",").map(v => v.trim()).filter(v => v !== "");

        $.getJSON("/Secciones/GetUsuariosVigentes", function (users) {
            container.empty();
            if (!users || users.length === 0) {
                container.html('<div class="text-muted small">No hay usuarios vigentes disponibles.</div>');
                return;
            }

            users.forEach(function (user) {
                const userId = (user.idUsuario !== undefined ? user.idUsuario : user.IdUsuario).toString();
                const userName = user.nombre !== undefined ? user.nombre : user.Nombre;
                const isChecked = initialValues.includes(userId);
                const checkedAttr = isChecked ? "checked" : "";

                const itemHtml = `
                    <div class="form-check usuario-row-item py-1">
                        <input class="form-check-input chk-usuario-acceso-crear-vista" type="checkbox" value="${userId}" id="chk_user_create_vis_${userId}" ${checkedAttr}>
                        <label class="form-check-label text-truncate w-100 cursor-pointer" for="chk_user_create_vis_${userId}">
                            ${userName}
                        </label>
                    </div>
                `;
                container.append(itemHtml);
            });

            // Registrar evento change
            container.on("change", ".chk-usuario-acceso-crear-vista", function () {
                const checkedIds = [];
                container.find(".chk-usuario-acceso-crear-vista:checked").each(function () {
                    checkedIds.push($(this).val());
                });
                hiddenInput.val(checkedIds.join(","));
            });
        }).fail(function () {
            container.html('<div class="text-danger small"><i class="fas fa-exclamation-triangle me-1"></i> Error al cargar usuarios.</div>');
        });

        // Búsqueda interactiva
        $("#buscarUsuarioCrearVista").on("keyup", function () {
            const searchVal = $(this).val().toLowerCase();
            container.find(".usuario-row-item").each(function () {
                const labelText = $(this).find("label").text().toLowerCase();
                if (labelText.includes(searchVal)) {
                    $(this).show();
                } else {
                    $(this).hide();
                }
            });
        });
    });

    document.getElementById('formCrearVista').addEventListener('submit', function (e) {
        e.preventDefault();

        const formData = new FormData(this);
        const submitBtn = this.querySelector('button[type="submit"]');

        // Deshabilitar botón mientras se procesa
        submitBtn.disabled = true;
        submitBtn.innerHTML = '<i class="fas fa-spinner fa-spin"></i> Guardando...';

        fetch('@Url.Action("GuardarNuevaVista", "Secciones")', {
            method: 'POST',
            body: formData
        })
            .then(response => {
                if (response.ok) {
                    return response.json();
                } else {
                    return response.text().then(text => {
                        throw new Error(text || 'Error al guardar');
                    });
                }
            })
            .then(data => {
                // Cerrar modal
                const modal = bootstrap.Modal.getInstance(document.getElementById('vistaModal'));
                modal.hide();

                // Mostrar mensaje de éxito
                Swal.fire({
                    title: '¡Éxito!',
                    text: data.mensaje || 'Vista creada correctamente',
                    icon: 'success',
                    timer: 2000,
                    showConfirmButton: false
                }).then(() => {
                    // Recargar la página para mostrar la nueva vista
                    window.location.reload();
                });
            })
            .catch(error => {
                console.error('Error:', error);

                // Mostrar mensaje de error
                Swal.fire({
                    title: 'Error',
                    text: 'Error al guardar la vista: ' + error.message,
                    icon: 'error'
                });

                // Rehabilitar botón
                submitBtn.disabled = false;
                submitBtn.innerHTML = '<i class="fas fa-save"></i> Guardar Vista';
            });
    });
</script>
