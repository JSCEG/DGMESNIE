@model NSIE.Models.Modulo
@using NSIE.Models
@using Microsoft.AspNetCore.Http
@using Newtonsoft.Json

@{
    ViewData["Title"] = $"Vistas del Módulo: {Model.Title}";
    var vistas = ViewData["Vistas"] as List<NSIE.Models.ModulosVista> ?? new List<NSIE.Models.ModulosVista>();

    var header = new HeaderViewModel
    {
        Title = ViewData["Title"].ToString(),
        IconPath = "vistas.png", // Ruta relativa desde img_snier
        Description = $"Administra las vistas asociadas al módulo: {Model.Title}.",
        Section = $"Administración > Secciones > {Model.Title} > {Model.Title}",
        ModuleInfo = JsonConvert.SerializeObject(new
        {
            title = $"Vistas del Módulo: {Model.Title}",
            description = $"Aquí puedes gestionar las vistas que pertenecen al módulo '{Model.Title}'. Puedes crear nuevas vistas, editar las existentes, y definir sus propiedades como roles y perfiles.",
            functionality = "Creación, edición y eliminación de vistas; asignación de controladores, acciones, roles y perfiles; configuración de vistas externas.",
            stage = "Operación",
            roles = new[] {
                new { icon = "user-shield", text = "Administradores: Gestión completa de vistas." },
                new { icon = "eye", text = "Usuarios: Acceso a las vistas según sus permisos." }
            },
            order = new { step = 3, description = "Configuración detallada de los accesos y funcionalidades del sistema." },
            manualUrl = "/Documentos/ManualGestionVistas.pdf" // Placeholder for a specific manual
        })
    };
}

@Html.AntiForgeryToken()

@await Html.PartialAsync("_ViewHeader", header)

<div class="container-fluid px-3 px-lg-4 secciones-page">
    <!-- Miga de pan (Breadcrumbs) -->
    <nav aria-label="breadcrumb" class="mb-3">
        <ol class="breadcrumb">
            <li class="breadcrumb-item"><a href="@Url.Action("Index", "Home")"><i class="fas fa-home me-1"></i>Inicio</a></li>
            <li class="breadcrumb-item"><a href="@Url.Action("Index", "Secciones")">Gestión de Secciones</a></li>
            <li class="breadcrumb-item"><a href="@Url.Action("EditarModulos", "Secciones", new { id = Model.SeccionId })">Módulos</a></li>
            <li class="breadcrumb-item active" aria-current="page">Vistas de @Model.Title</li>
        </ol>
    </nav>

    <header class="navtree-head">
        <!-- Sin título propio: _ViewHeader ya encabeza la página con el nombre
             del módulo, y repetirlo aquí daba dos veces lo mismo. -->
        <div class="navtree-head__text">
            <p class="navtree-head__sub">
                <strong>@vistas.Count</strong> vista@(vistas.Count == 1 ? "" : "s").
                Cada una es una pantalla a la que se puede dar acceso por rol o por usuario.
            </p>
        </div>
        <div class="navtree-head__actions">
            <a class="navtree-btn" href="@Url.Action("EditarModulos", "Secciones", new { id = Model.SeccionId })">
                <i class="fas fa-arrow-left"></i> Volver a los módulos
            </a>
            <button id="btnAddVista" type="button" class="navtree-btn navtree-btn--primary"
                    data-url="@Url.Action("CrearVista", "Secciones", new { moduloId = Model.Id })">
                <i class="fas fa-plus"></i> Nueva vista
            </button>
        </div>
    </header>

    @if (vistas.Any())
    {
        <div class="navtree-toolbar">
            <span class="navtree-hint ms-0"><i class="fas fa-arrows-up-down"></i> Arrastra para reordenar · el orden se guarda al soltar</span>
        </div>
    }

@if (vistas.Any())
{
    <div class="navtree">
        <div class="navtree__head" aria-hidden="true">
            <span class="navtree__col-handle"></span>
            <span class="navtree__col-num"></span>
            <span class="navtree__col-nombre">Vista</span>
            <span class="navtree__col-resp">Ruta</span>
            <span class="navtree__col-cont">Acceso</span>
            <span class="navtree__col-estado">Estado</span>
            <span class="navtree__col-acciones">Acciones</span>
        </div>

        @{ var indice = 0; }
        @foreach (var vista in vistas.OrderBy(v => v.Orden).ThenBy(v => v.Titulo))
        {
            indice++;
            var sinRoles = string.IsNullOrWhiteSpace(vista.Roles);
            var sinPerfiles = string.IsNullOrWhiteSpace(vista.Perfiles);

            <section class="navtree-item @(vista.Activa ? "" : "is-oculta")"
                     data-vista-id="@vista.VistaId" data-orden="@vista.Orden">
                <div class="navtree-row navtree-row--seccion">
                    <button type="button" class="navtree-handle" title="Arrastra para cambiar el orden dentro del módulo"
                            aria-label="Reordenar @vista.Titulo">
                        <i class="fas fa-grip-vertical"></i>
                    </button>
                    <span class="navtree-num">@indice.ToString("00")</span>

                    <div class="navtree-nombre">
                        <a class="navtree-nombre__titulo js-edit" href="#"
                           data-url="@Url.Action("ModalEditarVista", new { id = vista.VistaId })">@vista.Titulo</a>
                        <span class="navtree-nombre__desc @(vista.EsExterno ? "" : "is-faint")">
                            @(vista.EsExterno ? "Enlace externo" : "Ruta interna del SNIEr")
                        </span>
                    </div>

                    <div class="navtree-resp">
                        <code class="navtree-ruta">/@vista.Controller/@vista.Action</code>
                    </div>

                    <!-- Roles y usuarios dicen a quién llega la vista; «Todos» cuando
                         no hay restricción, en gris para que se lea como ausencia. -->
                    <div class="navtree-cont">
                        <span class="navtree-cont__vacio @(sinRoles && sinPerfiles ? "is-faint" : "")">
                            @(sinRoles ? "Todos los roles" : $"Roles {vista.Roles}") ·
                            @(sinPerfiles ? "todos los usuarios" : "usuarios elegidos")
                        </span>
                    </div>

                    <div class="navtree-estado">
                        <span class="navtree-badge @(vista.Activa ? "navtree-badge--activa" : "navtree-badge--oculta")">
                            @(vista.Activa ? "Activa" : "Oculta")
                        </span>
                    </div>

                    <div class="navtree-acciones">
                        <button type="button" class="navtree-icon js-edit" title="Editar vista"
                                data-url="@Url.Action("ModalEditarVista", new { id = vista.VistaId })">
                            <i class="fas fa-pen"></i>
                        </button>
                        <div class="dropdown">
                            <button type="button" class="navtree-icon" data-bs-toggle="dropdown"
                                    data-bs-container="body" aria-expanded="false" title="Más acciones">
                                <i class="fas fa-ellipsis"></i>
                            </button>
                            <ul class="dropdown-menu dropdown-menu-end navtree-menu">
                                <li>
                                    <button class="dropdown-item navtree-menu__danger js-delete" type="button"
                                            data-url="@Url.Action("EliminarVista", new { id = vista.VistaId })">
                                        <i class="fas fa-trash-can"></i> Eliminar vista
                                    </button>
                                </li>
                            </ul>
                        </div>
                    </div>
                </div>
            </section>
        }
    </div>
}
else
{
        <div class="navtree-vacio">
            <i class="fas fa-circle-info"></i>
            <span>
                <strong>Este módulo aún no tiene vistas</strong>
                Una vista es la pantalla a la que lleva el módulo. Empieza con «Nueva vista».
            </span>
        </div>
}

    <!-- Modal para crear/editar vista -->
    <div class="modal fade" id="vistaModal" tabindex="-1">
        <div class="modal-dialog modal-lg modal-fullscreen-md-down">
            <div class="modal-content">
                <div id="contenidoModalVista">
                    <!-- Aquí se carga el contenido dinámico -->
                </div>
            </div>
        </div>
    </div>

</div>
@section Scripts {

    <script src="~/js/navtree-orden.js" asp-append-version="true"></script>
    <script>
        let vistaModal;

        $(document).ready(function () {
            const modalEl = document.getElementById('vistaModal');
            document.body.appendChild(modalEl);
            vistaModal = new bootstrap.Modal(modalEl);

            activarArrastreNavtree(document.querySelector('.navtree'), {
                campoId: 'vistaId',
                atributo: 'vistaId',
                url: '@Url.Action("ActualizarOrdenVistas", "Secciones")'
            });
        });

        function loadVistaModal(url) {
            $.get(url)
                .done(function (html) {
                    $('#contenidoModalVista').html(html);
                    vistaModal.show();
                })
                .fail(function (xhr, status, error) {
                    console.error('Error cargando modal:', error);
                    Swal.fire('Error', 'Error al cargar el modal: ' + error, 'error');
                });
        }

        // Botón para nueva vista
        $(document).on('click', '#btnAddVista', function (e) {
            e.preventDefault();
            const url = $(this).data('url');
            loadVistaModal(url);
        });

        // Botones de editar
        $(document).on('click', '.js-edit', function (e) {
            e.preventDefault();
            const url = $(this).data('url');
            loadVistaModal(url);
        });

        // Botones de eliminar
        $(document).on('click', '.js-delete', function (e) {
            e.preventDefault();
            const url = $(this).data('url');

            Swal.fire({
                title: '¿Eliminar vista?',
                text: "Esta acción no se puede deshacer",
                icon: 'warning',
                showCancelButton: true,
                confirmButtonColor: '#d33',
                cancelButtonColor: '#6c757d',
                confirmButtonText: 'Sí, eliminar',
                cancelButtonText: 'Cancelar'
            }).then((result) => {
                if (result.isConfirmed) {
                    $.post(url)
                        .done(function (data) {
                            Swal.fire({
                                title: '¡Eliminada!',
                                text: data.mensaje || 'Vista eliminada correctamente',
                                icon: 'success',
                                timer: 2000,
                                showConfirmButton: false
                            }).then(() => {
                                location.reload();
                            });
                        })
                        .fail(function (xhr, status, error) {
                            Swal.fire('Error', 'Error al eliminar la vista', 'error');
                        });
                }
            });
        });
    </script>
}