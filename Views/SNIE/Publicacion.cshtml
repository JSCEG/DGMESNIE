            $('#detalleFrecuencia').text(serie.frecuencia);
            $('#detalleUltimaActualizacion').text(serie.ultimaActualizacion);
            $('#detalleCobertura').text(serie.cobertura);
            $('#urlSerie').text(serie.id);

