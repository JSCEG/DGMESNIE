@using Microsoft.AspNetCore.Http
@using Newtonsoft.Json
@using NSIE.Models
@inject IHttpContextAccessor HttpContextAccessor

@{
    var httpContext = HttpContextAccessor.HttpContext;
    var perfilUsuarioJson = httpContext.Session.GetString("PerfilUsuario");
    var perfilUsuario = JsonConvert.DeserializeObject<PerfilUsuario>(perfilUsuarioJson);
    ViewData["NombreUsuario"] = perfilUsuario.Nombre;
    ViewData["RolUsuario"] = perfilUsuario.Rol;
    ViewData["Title"] = "Portal Público SNIER - Datos Energéticos de México";

    var header = new HeaderViewModel
    {
        Title = "Portal Público de Datos Energéticos",
        IconPath = "conding.png",
        Description = "Acceso público a la información oficial del sector energético mexicano. Datos validados y actualizados del Sistema Nacional de Información Energética.",
        Section = "🌐 Portal Público y Transparencia",
        ModuleInfo = JsonConvert.SerializeObject(new
        {
            title = "Portal de Datos Públicos",
            description = "Plataforma de acceso público para consulta, visualización y descarga de datos energéticos oficiales.",
            functionality = "Exploración de datos, visualizaciones interactivas, descargas y acceso vía API.",
            stage = "Información publicada y validada",
            roles = new[] {
                new { icon = "users", text = "Público en general: Consulta y descarga libre" },
                new { icon = "chart-bar", text = "Investigadores: Análisis y estudios sectoriales" },
                new { icon = "building", text = "Sector privado: Decisiones de inversión" },
                new { icon = "graduation-cap", text = "Sector académico: Investigación y enseñanza" }
            },
            order = new { step = 5, description = "Portal final de transparencia y acceso público a datos validados" }
        }),
        LegalDescription = "Portal oficial de transparencia del sector energético mexicano conforme a la Ley General de Transparencia y Acceso a la Información Pública.",
        Fundamentos = new List<FundamentoLegal> {
            new() { Reference = "Ley de Transición Energética", Description = "Establece la obligación de publicar información energética" },
            new() { Reference = "Ley General de Transparencia", Description = "Garantiza el acceso público a la información gubernamental" }
        }
    };
}

@await Html.PartialAsync("_ViewHeader", header)

<!-- Referencias adicionales para el portal público -->
