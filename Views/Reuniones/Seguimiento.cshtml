@model NSIE.Models.ReunionesSeguimientoViewModel

@{
    ViewData["Title"] = "Seguimiento de asuntos";
    var asuntoPayloadJson = Newtonsoft.Json.JsonConvert.SerializeObject(Model.Asuntos.ToDictionary(
        asunto => asunto.AsuntoId,
        asunto => new
        {
            asunto.AsuntoId,
            asunto.TituloAsunto,
            asunto.Estatus,
            FechaCompromiso = asunto.FechaCompromiso?.ToString("yyyy-MM-dd"),
            FechaAtencion = asunto.FechaAtencion?.ToString("yyyy-MM-dd"),
            asunto.ObservacionesEnvioMonica
        }));
    var asuntosJson = Newtonsoft.Json.JsonConvert.SerializeObject(Model.Asuntos.Select(asunto => new
    {
        asunto.AsuntoId,
        asunto.NumeroRegistro,
        asunto.TituloAsunto,
        asunto.Descripcion,
        asunto.Expediente,
        FechaSolicitud = asunto.FechaSolicitud?.ToString("dd/MM/yyyy"),
        asunto.DiasTranscurridos,
        asunto.Responsable,
        asunto.Encargado,
        asunto.Minuta,
        asunto.FichaInformativaOficio,
        asunto.AreaResponsable,
        asunto.Estatus,
        asunto.EstadoActual,
        asunto.TipoAsunto,
        asunto.Semaforo,
        asunto.AlertaEnvioMonica,
        FechaReunion = asunto.FechaReunion?.ToString("dd/MM/yyyy"),
        FechaCompromiso = asunto.FechaCompromiso?.ToString("dd/MM/yyyy"),
        FechaAtencion = asunto.FechaAtencion?.ToString("dd/MM/yyyy"),
        FechaEnvioMonica = asunto.FechaEnvioMonica?.ToString("dd/MM/yyyy HH:mm"),
        asunto.CarpetaSharePointUrl,
        asunto.UbicacionCarpeta,
        asunto.DatosContacto,
        asunto.FechaTextoReunion,
        asunto.ObservacionesEnvioMonica,
        asunto.EnviadoAMonicaPorNombre,
        asunto.DestinatarioJuridico,
        asunto.TotalComentarios,
        asunto.NombreUsuarioUltimaActualizacion
    }));
}

@section Styles {
    <link rel="stylesheet" href="~/gestor/css/gestor.css" asp-append-version="true" />
    <style>
        #reunionesTabs .nav-link {
            border-radius: 12px;
            font-weight: 700;
            color: #6c757d;
            background: transparent;
            border: 1px solid transparent;
            transition: all 0.2s;
            padding: 0.5rem 1rem;
        }
        #reunionesTabs .nav-link.active {
            background-color: #8a0031 !important;
            color: #ffffff !important;
            border-color: #8a0031 !important;
        }
        #reunionesTabs .nav-link:hover:not(.active) {
            background-color: rgba(138, 0, 49, 0.05) !important;
            color: #8a0031 !important;
        }
        .reuniones-toolbar {
            display: flex;
            flex-wrap: wrap;
            justify-content: space-between;
            gap: 1rem;
            margin-bottom: 1.25rem;
        }

        .reuniones-toolbar__search {
            min-width: min(100%, 420px);
            position: relative;
            flex: 1 1 420px;
        }

        .reuniones-toolbar__search .form-control {
            padding-left: 2.7rem;
            border-radius: 14px;
        }

        .reuniones-toolbar__search-icon {
            position: absolute;
            top: 50%;
            left: 0.95rem;
            transform: translateY(-50%);
            color: #8a0031;
        }

        .reuniones-toolbar__meta {
            display: flex;
            align-items: center;
            gap: 0.75rem;
            color: #6c757d;
            font-size: 0.92rem;
        }

        .reuniones-chart-card {
            border: 1px solid rgba(138, 0, 49, 0.08);
            border-radius: 22px;
            background: #fff;
            padding: 1rem;
            box-shadow: none;
        }

        .reuniones-chart-card__header {
            display: flex;
            justify-content: space-between;
            align-items: center;
            gap: 0.75rem;
            margin-bottom: 0.75rem;
        }

        .reuniones-chart-card__title {
            margin: 0;
            color: #243444;
            font-size: 1rem;
            font-weight: 700;
        }

        .reuniones-chart-card__action {
            display: inline-flex;
            align-items: center;
            gap: 0.4rem;
            border: 1px solid rgba(138, 0, 49, 0.15);
            border-radius: 999px;
            background: #fff;
            color: #8a0031;
            font-size: 0.82rem;
            font-weight: 700;
            padding: 0.4rem 0.75rem;
        }

        .reuniones-chart-card:fullscreen,
        .reuniones-chart-card:-webkit-full-screen {
            width: 100%;
            height: 100%;
            padding: 1.25rem;
            background: #fff;
            overflow: auto;
        }

        .reuniones-chart-card:fullscreen .reuniones-chart,
        .reuniones-chart-card:-webkit-full-screen .reuniones-chart {
            height: calc(100vh - 8rem) !important;
        }

        .reuniones-chart {
            height: 280px;
        }

        .reuniones-chart,
        .reuniones-chart .highcharts-container,
        .reuniones-chart .highcharts-root,
        .reuniones-chart .highcharts-background {
            background: #fff;
        }

        .reuniones-chart:fullscreen,
        .reuniones-chart:-webkit-full-screen,
        .reuniones-chart .highcharts-container:fullscreen,
        .reuniones-chart .highcharts-container:-webkit-full-screen {
            background: #fff !important;
        }

        .reuniones-table thead th {
            white-space: nowrap;
            font-size: 0.82rem;
            text-transform: uppercase;
            letter-spacing: 0.04em;
        }

        .reuniones-table td {
            vertical-align: top;
        }

        .reuniones-table__title {
            min-width: 260px;
        }

        .reuniones-table__title strong {
            display: block;
            margin-bottom: 0.25rem;
            color: #243444;
        }

        .reuniones-table__title small {
            display: -webkit-box;
            -webkit-line-clamp: 2;
            -webkit-box-orient: vertical;
            overflow: hidden;
            color: #6b7280;
        }

        .reuniones-detail-row {
            display: none;
        }

        .reuniones-detail-row.is-visible {
            display: table-row;
        }

        .reuniones-detail-panel {
            padding: 1rem 1.1rem;
            background: #fff;
            border-top: 1px solid rgba(138, 0, 49, 0.08);
        }

        .reuniones-detail-grid {
            display: grid;
            grid-template-columns: repeat(2, minmax(0, 1fr));
            gap: 0.9rem;
        }

        .reuniones-detail-card {
            border: 1px solid rgba(138, 0, 49, 0.08);
            border-radius: 16px;
            padding: 0.85rem 0.95rem;
            background: #fff;
        }

        .reuniones-table__title a {
            color: #243444;
            text-decoration: none;
        }

        .reuniones-table__folder-link {
            display: inline-flex;
            align-items: center;
            gap: 0.4rem;
            color: #8a0031;
            font-weight: 700;
            text-decoration: none;
        }

        .reuniones-table__folder-link:hover {
            color: #6f0027;
            text-decoration: underline;
        }

        .reuniones-table__title a:hover {
            color: #8a0031;
        }

        .reuniones-table__meta {
            display: inline-flex;
            flex-wrap: wrap;
            gap: 0.45rem;
            margin-top: 0.45rem;
        }

        .reuniones-table__meta span {
            display: inline-flex;
            align-items: center;
            padding: 0.18rem 0.55rem;
            border-radius: 999px;
            border: 1px solid rgba(138, 0, 49, 0.12);
            color: #8a0031;
            font-size: 0.76rem;
            font-weight: 700;
        }

        .reuniones-detail-card span {
            display: block;
            margin-bottom: 0.25rem;
            color: #7b8797;
            font-size: 0.78rem;
            font-weight: 700;
            letter-spacing: 0.04em;
            text-transform: uppercase;
        }

        .reuniones-detail-card strong,
        .reuniones-detail-card p {
            margin: 0;
            color: #243444;
            font-size: 0.92rem;
            line-height: 1.5;
        }

        .reuniones-detail-card a {
            color: #8a0031;
            font-weight: 700;
            text-decoration: none;
        }

        .reuniones-detail-card a:hover {
            text-decoration: underline;
        }

        .reuniones-detail-actions {
            grid-column: 1 / -1;
            display: flex;
            flex-wrap: wrap;
            gap: 0.65rem;
        }

        .reuniones-badge--critical {
            background: rgba(138, 0, 49, 0.12);
            color: #8a0031;
            border: 1px solid rgba(138, 0, 49, 0.2);
        }

        .reuniones-stat--critical {
            border-color: rgba(138, 0, 49, 0.18) !important;
        }

        .reuniones-stat--critical .display-6 {
            color: #8a0031 !important;
        }

        .reuniones-pagination {
            display: flex;
            flex-wrap: wrap;
            justify-content: space-between;
            align-items: center;
            gap: 0.9rem;
            margin-top: 1rem;
        }

        .reuniones-pagination__pages {
            display: flex;
            flex-wrap: wrap;
            gap: 0.5rem;
        }

        .reuniones-pagination__pages .btn.active {
            background: #8a0031;
            border-color: #8a0031;
            color: #fff;
        }

        .reuniones-modal {
            z-index: 2000;
        }

        .reuniones-modal .modal-dialog {
            margin: 1.75rem auto;
        }

        .reuniones-modal .modal-content {
            border: 1px solid rgba(138, 0, 49, 0.12);
            border-radius: 22px;
            box-shadow: 0 28px 70px rgba(36, 52, 68, 0.18);
        }

        .reuniones-modal .modal-header,
        .reuniones-modal .modal-footer {
            border-color: rgba(138, 0, 49, 0.08);
        }

        .modal-backdrop.show {
            z-index: 1990;
        }

        @@media (max-width: 991.98px) {
            .reuniones-detail-grid {
                grid-template-columns: 1fr;
            }

            .reuniones-modal .modal-dialog {
                margin: 1rem;
            }
        }
        .slide-table .badge {
            font-size: 0.72rem;
            padding: 0.35em 0.75em;
            white-space: normal;
            word-break: break-word;
            display: inline-block;
            text-align: center;
            line-height: 1.2;
        }
    </style>
}

@if (Model.Header != null)
{
    @await Html.PartialAsync("_ViewHeader", Model.Header)
}

<div class="container-fluid shell-page-container py-3">
    <!-- Pestañas de Navegación -->
    <ul class="nav nav-pills mb-4 gap-2" id="reunionesTabs" role="tablist" style="border-bottom: 1px solid rgba(138, 0, 49, 0.1); padding-bottom: 0.75rem;">
        <li class="nav-item" role="presentation">
            <button class="nav-link active" id="tab-tablero" data-bs-toggle="pill" data-bs-target="#panel-tablero" data-toggle="pill" data-target="#panel-tablero" type="button" role="tab" aria-controls="panel-tablero" aria-selected="true">
                <i class="bi bi-grid-3x3-gap-fill me-2"></i>Tablero de control
            </button>
        </li>
        <li class="nav-item" role="presentation">
            <button class="nav-link" id="tab-reportes" data-bs-toggle="pill" data-bs-target="#panel-reportes" data-toggle="pill" data-target="#panel-reportes" type="button" role="tab" aria-controls="panel-reportes" aria-selected="false">
                <i class="bi bi-file-earmark-bar-graph me-2"></i>Reportes y Presentación
            </button>
        </li>
    </ul>

    <div class="tab-content" id="reunionesTabContent">
        <!-- Pestaña 1: Tablero Operativo -->
        <div class="tab-pane fade show active" id="panel-tablero" role="tabpanel" aria-labelledby="tab-tablero">
            <div class="row g-4 mb-4">
        <div class="col-12 col-md-6 col-xl-3">
            <div class="border rounded-3 bg-white p-4 shadow-sm h-100">
                <div class="text-muted small mb-2">Total de asuntos</div>
                <div class="display-6 fw-semibold text-dark">@Model.TotalAsuntos</div>
            </div>
        </div>
        <div class="col-12 col-md-6 col-xl-3">
            <div class="border rounded-3 bg-white p-4 shadow-sm h-100 border-success-subtle">
                <div class="text-muted small mb-2">Atendidos</div>
                <div class="display-6 fw-semibold text-success">@Model.TotalAtendidos</div>
            </div>
        </div>
        <div class="col-12 col-md-6 col-xl-3">
            <div class="border rounded-3 bg-white p-4 shadow-sm h-100 border-warning-subtle">
                <div class="text-muted small mb-2">Pendientes</div>
                <div class="display-6 fw-semibold text-warning-emphasis">@Model.TotalPendientes</div>
            </div>
        </div>
        <div class="col-12 col-md-6 col-xl-3">
            <div class="border rounded-3 bg-white p-4 shadow-sm h-100 reuniones-stat--critical">
                <div class="text-muted small mb-2">Pendientes con Mónica</div>
                <div class="display-6 fw-semibold">@Model.TotalPendientesEnvioMonica</div>
            </div>
        </div>
    </div>

    @if (TempData["ReunionesSuccess"] is string successMessage)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            @successMessage
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Cerrar"></button>
        </div>
    }

    @if (TempData["ReunionesError"] is string errorMessage)
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            @errorMessage
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Cerrar"></button>
        </div>
    }

    <div class="row g-4 mb-4">
        <div class="col-12 col-lg-4">
            <div class="reuniones-chart-card">
                <div class="reuniones-chart-card__header">
                    <h4 class="reuniones-chart-card__title">Estatus de atención</h4>
                    <button type="button" class="reuniones-chart-card__action" data-chart-fullscreen>
                        <i class="bi bi-arrows-fullscreen"></i>
                        <span>Pantalla completa</span>
                    </button>
                </div>
                <div id="reunionesChartEstatus" class="reuniones-chart"></div>
            </div>
        </div>
        <div class="col-12 col-lg-4">
            <div class="reuniones-chart-card">
                <div class="reuniones-chart-card__header">
                    <h4 class="reuniones-chart-card__title">Semáforo de seguimiento</h4>
                    <button type="button" class="reuniones-chart-card__action" data-chart-fullscreen>
                        <i class="bi bi-arrows-fullscreen"></i>
                        <span>Pantalla completa</span>
                    </button>
                </div>
                <div id="reunionesChartSemaforo" class="reuniones-chart"></div>
            </div>
        </div>
        <div class="col-12 col-lg-4">
            <div class="reuniones-chart-card">
                <div class="reuniones-chart-card__header">
                    <h4 class="reuniones-chart-card__title">Seguimiento con jurídico</h4>
                    <button type="button" class="reuniones-chart-card__action" data-chart-fullscreen>
                        <i class="bi bi-arrows-fullscreen"></i>
                        <span>Pantalla completa</span>
                    </button>
                </div>
                <div id="reunionesChartMonica" class="reuniones-chart"></div>
            </div>
        </div>
    </div>

    <div class="border rounded-3 bg-white p-4 shadow-sm">
        <div class="d-flex flex-wrap justify-content-between align-items-start gap-3 mb-3">
            <div>
                <h4 class="mb-1">Tablero de seguimiento</h4>
                <p class="text-muted mb-0">Consulta, filtra y despliega el detalle de cada asunto sin saturar la tabla
                    principal.</p>
                </div>
                <div class="d-flex gap-2">
                    <button class="btn btn-primary" type="button" data-bs-toggle="modal" data-bs-target="#reunionesCrearModal">Nuevo asunto</button>
                </div>
            </div>

            <div class="reuniones-toolbar">
                <div class="reuniones-toolbar__search">
                    <i class="bi bi-search reuniones-toolbar__search-icon"></i>
                    <input id="reunionesSearchInput" type="search" class="form-control"
                           placeholder="Buscar por asunto, expediente, responsable o estatus..." />
                </div>
                <div class="reuniones-toolbar__meta">
                    <span id="reunionesSearchSummary">@Model.TotalAsuntos asunto(s)</span>
                </div>
            </div>

            @if (!Model.Asuntos.Any())
            {
                <div class="alert alert-secondary mb-0">No hay asuntos disponibles para mostrar en el dashboard.</div>
            }
            else
            {
                <div class="table-responsive">
                    <table class="table table-hover align-middle reuniones-table" id="reunionesTable">
                        <thead class="table-light">
                            <tr>
                                <th></th>
                                <th>Semáforo</th>
                                <th>Asunto</th>
                                <th class="d-none d-md-table-cell">Envío jurídico</th>
                                <th class="d-none d-lg-table-cell">Ubicación carpeta</th>
                                <th class="d-none d-md-table-cell">Responsable</th>
                                <th class="d-none d-lg-table-cell">Reunión</th>
                                <th class="d-none d-md-table-cell">Compromiso</th>
                                <th>Estatus</th>
                                <th class="d-none d-sm-table-cell">Liga</th>
                            </tr>
                        </thead>
                        <tbody id="reunionesTableBody">
                            @foreach (var asunto in Model.Asuntos)
                            {
                                var carpetaTexto = asunto.UbicacionCarpeta ?? asunto.Expediente;
                                var badgeClass = asunto.Semaforo switch
                                {
                                    "Verde" => "bg-success-subtle text-success border border-success-subtle",
                                    "Amarillo" => "bg-warning-subtle text-warning-emphasis border border-warning-subtle",
                                    "Rojo" => "reuniones-badge--critical",
                                    _ => "bg-secondary-subtle text-secondary border border-secondary-subtle"
                                };

                                var alertaClass = asunto.AlertaEnvioMonica switch
                                {
                                    "Pendiente de envío a Mónica" => "reuniones-badge--critical",
                                    "Enviado a Mónica" => "bg-success-subtle text-success border border-success-subtle",
                                    _ => "bg-secondary-subtle text-secondary border border-secondary-subtle"
                                };

                                <tr class="reuniones-main-row"
                                    data-search="@($"{asunto.TituloAsunto} {asunto.Expediente} {asunto.UbicacionCarpeta} {asunto.Responsable} {asunto.Encargado} {asunto.Estatus} {asunto.EstadoActual} {asunto.TipoAsunto} {asunto.Semaforo} {asunto.AlertaEnvioMonica}".ToLowerInvariant())">
                                    <td>
                                        <button type="button" class="btn btn-sm btn-outline-secondary reuniones-toggle-detail"
                                                aria-label="Mostrar detalle">
                                            <i class="bi bi-plus-lg"></i>
                                        </button>
                                    </td>
                                    <td><span class="badge rounded-pill @badgeClass">@asunto.Semaforo</span></td>
                                    <td class="reuniones-table__title">
                                        @if (!string.IsNullOrWhiteSpace(asunto.CarpetaSharePointUrl))
                                        {
                                            <strong><a href="@asunto.CarpetaSharePointUrl" target="_blank"
                                                           rel="noopener noreferrer">@asunto.TituloAsunto</a></strong>
                                            }
                                    else
                                            {
                                                <strong>@asunto.TituloAsunto</strong>
                                            }
                                            <small>@(string.IsNullOrWhiteSpace(asunto.Descripcion) ? "Sin descripción operativa." :
                                                                                asunto.Descripcion)</small>
                                                <div class="reuniones-table__meta">
                                                    @if (!string.IsNullOrWhiteSpace(asunto.TipoAsunto))
                                                    {
                                                        <span>@asunto.TipoAsunto</span>
                                                    }
                                                    @if (!string.IsNullOrWhiteSpace(carpetaTexto))
                                                    {
                                                        <span>@carpetaTexto</span>
                                                    }
                                                </div>
                                            </td>
                                            <td class="d-none d-md-table-cell"><span class="badge rounded-pill @alertaClass">@asunto.AlertaEnvioMonica</span></td>
                                            <td class="d-none d-lg-table-cell">
                                                @if (!string.IsNullOrWhiteSpace(asunto.CarpetaSharePointUrl) && !string.IsNullOrWhiteSpace(carpetaTexto))
                                                {
                                                    <a class="reuniones-table__folder-link" href="@asunto.CarpetaSharePointUrl" target="_blank" rel="noopener noreferrer" title="Abrir expediente en SharePoint">
                                                        <i class="bi bi-folder-symlink"></i>
                                                        <span>@carpetaTexto</span>
                                                    </a>
                                                }
                                                else
                                                {
                                                    @(string.IsNullOrWhiteSpace(carpetaTexto) ? "-" : carpetaTexto)
                                                }
                                            </td>
                                            <td class="d-none d-md-table-cell">@(string.IsNullOrWhiteSpace(asunto.Encargado ?? asunto.Responsable) ? "-" : asunto.Encargado
                                                                                ?? asunto.Responsable)</td>
                                            <td class="d-none d-lg-table-cell">@(asunto.FechaReunion?.ToString("dd/MM/yyyy") ?? "-")</td>
                                            <td class="d-none d-md-table-cell">@(asunto.FechaCompromiso?.ToString("dd/MM/yyyy") ?? "-")</td>
                                            <td>@(string.IsNullOrWhiteSpace(asunto.EstadoActual) ? asunto.Estatus : asunto.EstadoActual)
                                            </td>
                                            <td class="d-none d-sm-table-cell">
                                                @if (!string.IsNullOrWhiteSpace(asunto.CarpetaSharePointUrl))
                                                {
                                                    <a class="btn btn-sm btn-outline-primary" href="@asunto.CarpetaSharePointUrl"
                                                       target="_blank" rel="noopener noreferrer">Abrir carpeta</a>
                                                }
                                                else
                                                {
                                                    <span class="badge text-bg-light border">Sin carpeta</span>
                                                }
                                            </td>
                                                </tr>
                                                <tr class="reuniones-detail-row">
                                                    <td colspan="10" class="reuniones-detail-panel">
                                                        <div class="reuniones-detail-grid">
                                                            <div class="reuniones-detail-actions">
                                                                <button type="button"
                                                                        class="btn btn-outline-secondary btn-sm"
                                                                        data-bs-toggle="modal"
                                                                        data-bs-target="#reunionesEditarModal"
                                                                        data-asunto-id="@asunto.AsuntoId">
                                                                    <i class="bi bi-pencil-square"></i>
                                                                    Editar seguimiento
                                                                </button>
                                                                <button type="button"
                                                                        class="btn btn-outline-secondary btn-sm"
                                                                        data-bs-toggle="modal"
                                                                        data-bs-target="#reunionesComentarioModal"
                                                                        data-asunto-id="@asunto.AsuntoId"
                                                                        data-asunto-titulo="@asunto.TituloAsunto">
                                                                    <i class="bi bi-chat-left-text"></i>
                                                                    Agregar comentario
                                                                </button>
                                                                <button type="button"
                                                                        class="btn btn-outline-secondary btn-sm"
                                                                        data-bs-toggle="modal"
                                                                        data-bs-target="#reunionesMonicaModal"
                                                                        data-asunto-id="@asunto.AsuntoId"
                                                                        data-asunto-titulo="@asunto.TituloAsunto">
                                                                    <i class="bi bi-send-check"></i>
                                                                    Marcar envío a Mónica
                                                                </button>
                                                                <button type="button"
                                                                        class="btn btn-outline-danger btn-sm"
                                                                        data-bs-toggle="modal"
                                                                        data-bs-target="#reunionesDesactivarModal"
                                                                        data-asunto-id="@asunto.AsuntoId"
                                                                        data-asunto-titulo="@asunto.TituloAsunto">
                                                                    <i class="bi bi-archive"></i>
                                                                    Desactivar
                                                                </button>
                                                            </div>
                                                            <div class="reuniones-detail-card">
                                                                <span>Descripción</span>
