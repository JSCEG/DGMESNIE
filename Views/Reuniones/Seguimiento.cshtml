@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/html2canvas@1.4.1/dist/html2canvas.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/jspdf@2.5.1/dist/jspdf.umd.min.js"></script>
    <script src="https://cdn.jsdelivr.net/gh/gitbrent/pptxgenjs@v3.12.0/dist/pptxgen.bundle.js"></script>
    <script>
        (() => {
            const coloresInstitucionales = {
                guinda: '#9B2247',
                verde: '#1E5B4F',
                dorado: '#A57F2C',
                amarilloClaro: '#E9C46A',
                gris: '#6c757d',
                fondo: '#ffffff',
                texto: '#243444',
                linea: '#d9c7ad'
            };

            const asuntoPayload = @Html.Raw(asuntoPayloadJson);
            const asuntos = @Html.Raw(asuntosJson);
            const searchInput = document.getElementById('reunionesSearchInput');
            const searchSummary = document.getElementById('reunionesSearchSummary');
            const paginationSummary = document.getElementById('reunionesPaginationSummary');
            const paginationPages = document.getElementById('reunionesPaginationPages');
            const mainRows = Array.from(document.querySelectorAll('.reuniones-main-row'));
            const charts = [];
            const pageSize = 10;
            let currentPage = 1;
            let filteredIndexes = mainRows.map((_, index) => index);

            function renderCharts() {
                if (!window.Highcharts) {
                    return;
                }

                Highcharts.setOptions({
                    colors: [
                        coloresInstitucionales.guinda,
                        coloresInstitucionales.verde,
                        coloresInstitucionales.dorado,
                        coloresInstitucionales.amarilloClaro,
                        coloresInstitucionales.gris
                    ],
                    chart: {
                        backgroundColor: coloresInstitucionales.fondo,
                        style: {
                            fontFamily: 'Noto Sans, sans-serif'
                        }
                    },
                    title: {
                        style: {
                            color: coloresInstitucionales.texto,
                            fontWeight: '700'
                        }
                    },
                    xAxis: {
                        lineColor: coloresInstitucionales.linea,
                        tickColor: coloresInstitucionales.linea,
                        labels: {
                            style: {
                                color: coloresInstitucionales.texto
                            }
                        }
                    },
                    yAxis: {
                        gridLineColor: '#eadfce',
                        title: {
                            style: {
                                color: coloresInstitucionales.texto
                            }
                        },
                        labels: {
                            style: {
                                color: coloresInstitucionales.texto
                            }
                        }
                    },
                    legend: {
                        itemStyle: {
                            color: coloresInstitucionales.texto,
                            fontWeight: '600'
                        }
                    },
                    tooltip: {
                        backgroundColor: '#ffffff',
                        borderColor: coloresInstitucionales.dorado,
                        style: {
                            color: coloresInstitucionales.texto
                        }
                    },
                    lang: {
                        viewFullscreen: 'Pantalla completa',
                        exitFullscreen: 'Salir de pantalla completa',
                        printChart: 'Imprimir gráfico',
                        downloadPNG: 'Descargar PNG',
                        downloadJPEG: 'Descargar JPEG',
                        downloadPDF: 'Descargar PDF',
                        downloadSVG: 'Descargar SVG'
                    },
                    navigation: {
                        buttonOptions: {
                            theme: {
                                fill: '#ffffff',
                                stroke: coloresInstitucionales.linea,
                                r: 10,
                                states: {
                                    hover: {
                                        fill: '#f3f4f6'
                                    },
                                    select: {
                                        fill: '#e5e7eb'
                                    }
                                }
                            }
                        }
                    }
                });

                const estatusCounts = contar(asuntos, 'Estatus');
                const semaforoCounts = contar(asuntos, 'Semaforo');
                const monicaCounts = contar(asuntos, 'AlertaEnvioMonica');

                charts.push(Highcharts.chart('reunionesChartEstatus', {
                    chart: { type: 'column', backgroundColor: coloresInstitucionales.fondo },
                    title: { text: null },
                    credits: { enabled: false },
                    exporting: { enabled: true },
                    xAxis: { categories: Object.keys(estatusCounts), crosshair: true },
                    yAxis: { title: { text: 'Asuntos' }, allowDecimals: false },
                    legend: { enabled: false },
                    series: [{
                        name: 'Estatus',
                        borderRadius: 8,
                        data: Object.entries(estatusCounts).map(([name, y]) => ({
                            name,
                            y,
                            color: name === 'Atendido' ? coloresInstitucionales.verde : coloresInstitucionales.guinda
                        }))
                    }]
                }));

                charts.push(Highcharts.chart('reunionesChartSemaforo', {
                    chart: { type: 'pie', backgroundColor: coloresInstitucionales.fondo },
                    title: { text: null },
                    credits: { enabled: false },
                    exporting: { enabled: true },
                    tooltip: {
                        pointFormat: '<b>{point.y}</b> asunto(s)'
                    },
                    plotOptions: {
                        pie: {
                            innerSize: '55%',
                            borderWidth: 2,
                            borderColor: '#ffffff',
                            dataLabels: {
                                enabled: true,
                                distance: 18,
                                style: {
                                    color: coloresInstitucionales.texto,
                                    textOutline: 'none',
                                    fontWeight: '600'
