                                                @section Scripts {
                                                    <script>
                                                        (() => {
                                                            const coloresInstitucionales = {
                                                                guinda: '#9B2247',
                                                                verde: '#1E5B4F',
                                                                dorado: '#A57F2C',
                                                                amarilloClaro: '#E9C46A',
                                                                gris: '#6c757d',
                                                                fondo: '#ffffff',
                                                                texto: '#243444',
                                                                linea: '#d9c7ad'
                                                            };

                                                            const asuntoPayload = @Html.Raw(asuntoPayloadJson);
                                                            const asuntos = @Html.Raw(asuntosJson);
                                                            const searchInput = document.getElementById('reunionesSearchInput');
                                                            const searchSummary = document.getElementById('reunionesSearchSummary');
                                                            const paginationSummary = document.getElementById('reunionesPaginationSummary');
                                                            const paginationPages = document.getElementById('reunionesPaginationPages');
                                                            const mainRows = Array.from(document.querySelectorAll('.reuniones-main-row'));
                                                            const charts = [];
                                                            const pageSize = 10;
                                                            let currentPage = 1;
                                                            let filteredIndexes = mainRows.map((_, index) => index);

                                                            function renderCharts() {
                                                                if (!window.Highcharts) {
                                                                    return;
                                                                }

                                                                Highcharts.setOptions({
                                                                    colors: [
                                                                        coloresInstitucionales.guinda,
                                                                        coloresInstitucionales.verde,
                                                                        coloresInstitucionales.dorado,
                                                                        coloresInstitucionales.amarilloClaro,
                                                                        coloresInstitucionales.gris
                                                                    ],
                                                                    chart: {
                                                                        backgroundColor: coloresInstitucionales.fondo,
                                                                        style: {
                                                                            fontFamily: 'Noto Sans, sans-serif'
                                                                        }
                                                                    },
                                                                    title: {
                                                                        style: {
                                                                            color: coloresInstitucionales.texto,
                                                                            fontWeight: '700'
                                                                        }
                                                                    },
                                                                    xAxis: {
                                                                        lineColor: coloresInstitucionales.linea,
                                                                        tickColor: coloresInstitucionales.linea,
                                                                        labels: {
                                                                            style: {
                                                                                color: coloresInstitucionales.texto
                                                                            }
                                                                        }
                                                                    },
                                                                    yAxis: {
                                                                        gridLineColor: '#eadfce',
                                                                        title: {
                                                                            style: {
                                                                                color: coloresInstitucionales.texto
                                                                            }
                                                                        },
                                                                        labels: {
                                                                            style: {
                                                                                color: coloresInstitucionales.texto
                                                                            }
                                                                        }
                                                                    },
                                                                    legend: {
                                                                        itemStyle: {
                                                                            color: coloresInstitucionales.texto,
                                                                            fontWeight: '600'
                                                                        }
                                                                    },
                                                                    tooltip: {
                                                                        backgroundColor: '#ffffff',
                                                                        borderColor: coloresInstitucionales.dorado,
                                                                        style: {
                                                                            color: coloresInstitucionales.texto
                                                                        }
                                                                    },
                                                                    lang: {
                                                                        viewFullscreen: 'Pantalla completa',
                                                                        exitFullscreen: 'Salir de pantalla completa',
                                                                        printChart: 'Imprimir gráfico',
                                                                        downloadPNG: 'Descargar PNG',
                                                                        downloadJPEG: 'Descargar JPEG',
                                                                        downloadPDF: 'Descargar PDF',
                                                                        downloadSVG: 'Descargar SVG'
                                                                    },
                                                                    navigation: {
                                                                        buttonOptions: {
                                                                            theme: {
                                                                                fill: '#ffffff',
                                                                                stroke: coloresInstitucionales.linea,
                                                                                r: 10,
                                                                                states: {
                                                                                    hover: {
                                                                                        fill: '#f3f4f6'
                                                                                    },
                                                                                    select: {
                                                                                        fill: '#e5e7eb'
                                                                                    }
                                                                                }
                                                                            }
                                                                        }
                                                                    }
                                                                });

                                                                const estatusCounts = contar(asuntos, 'Estatus');
                                                                const semaforoCounts = contar(asuntos, 'Semaforo');
                                                                const monicaCounts = contar(asuntos, 'AlertaEnvioMonica');

                                                                charts.push(Highcharts.chart('reunionesChartEstatus', {
                                                                    chart: { type: 'column', backgroundColor: coloresInstitucionales.fondo },
                                                                    title: { text: null },
                                                                    credits: { enabled: false },
                                                                    exporting: { enabled: true },
                                                                    xAxis: { categories: Object.keys(estatusCounts), crosshair: true },
                                                                    yAxis: { title: { text: 'Asuntos' }, allowDecimals: false },
                                                                    legend: { enabled: false },
                                                                    series: [{
                                                                        name: 'Estatus',
                                                                        borderRadius: 8,
                                                                        data: Object.entries(estatusCounts).map(([name, y]) => ({
                                                                            name,
                                                                            y,
                                                                            color: name === 'Atendido' ? coloresInstitucionales.verde : coloresInstitucionales.guinda
                                                                        }))
                                                                    }]
                                                                }));

                                                                charts.push(Highcharts.chart('reunionesChartSemaforo', {
                                                                    chart: { type: 'pie', backgroundColor: coloresInstitucionales.fondo },
                                                                    title: { text: null },
                                                                    credits: { enabled: false },
                                                                    exporting: { enabled: true },
                                                                    tooltip: {
                                                                        pointFormat: '<b>{point.y}</b> asunto(s)'
                                                                    },
                                                                    plotOptions: {
                                                                        pie: {
                                                                            innerSize: '55%',
                                                                            borderWidth: 2,
                                                                            borderColor: '#ffffff',
                                                                            dataLabels: {
                                                                                enabled: true,
                                                                                distance: 18,
                                                                                style: {
                                                                                    color: coloresInstitucionales.texto,
                                                                                    textOutline: 'none',
                                                                                    fontWeight: '600'
                                                                                },
                                                                                format: '{point.name}: {point.y}'
                                                                            }
                                                                        }
                                                                    },
                                                                    series: [{
                                                                        name: 'Semáforo',
                                                                        data: Object.entries(semaforoCounts).map(([name, y]) => ({
                                                                            name,
                                                                            y,
                                                                            color: name === 'Rojo'
                                                                                ? coloresInstitucionales.guinda
                                                                                : name === 'Amarillo'
                                                                                    ? coloresInstitucionales.amarilloClaro
                                                                                    : name === 'Verde'
                                                                                        ? coloresInstitucionales.verde
                                                                                        : coloresInstitucionales.dorado
                                                                        }))
                                                                    }]
                                                                }));

                                                                charts.push(Highcharts.chart('reunionesChartMonica', {
                                                                    chart: { type: 'bar', backgroundColor: coloresInstitucionales.fondo },
                                                                    title: { text: null },
                                                                    credits: { enabled: false },
                                                                    exporting: { enabled: true },
                                                                    xAxis: { categories: Object.keys(monicaCounts) },
                                                                    yAxis: { title: { text: 'Asuntos' }, allowDecimals: false },
                                                                    legend: { enabled: false },
                                                                    series: [{
                                                                        name: 'Jurídico',
                                                                        data: Object.entries(monicaCounts).map(([name, y]) => ({
                                                                            name,
                                                                            y,
                                                                            color: name === 'Pendiente de envío a Mónica'
                                                                                ? coloresInstitucionales.guinda
                                                                                : name === 'Enviado a Mónica'
                                                                                    ? coloresInstitucionales.verde
                                                                                    : coloresInstitucionales.dorado
                                                                        }))
                                                                    }]
                                                                }));
                                                            }

                                                            function contar(items, key) {
                                                                return items.reduce((acc, item) => {
                                                                    const value = (item[key] || 'Sin dato').trim();
                                                                    acc[value] = (acc[value] || 0) + 1;
                                                                    return acc;
                                                                }, {});
                                                            }

                                                            function applyFilter() {
                                                                const query = (searchInput?.value || '').trim().toLowerCase();

                                                                filteredIndexes = mainRows
                                                                    .map((row, index) => ({ row, index }))
                                                                    .filter(item => !query || (item.row.dataset.search || '').includes(query))
                                                                    .map(item => item.index);

                                                                currentPage = 1;
                                                                renderTablePage();
                                                            }

                                                            function renderTablePage() {
                                                                const totalItems = filteredIndexes.length;
                                                                const totalPages = Math.max(1, Math.ceil(totalItems / pageSize));

                                                                if (currentPage > totalPages) {
                                                                    currentPage = totalPages;
                                                                }

                                                                const start = (currentPage - 1) * pageSize;
                                                                const end = start + pageSize;
                                                                const visibleIndexes = new Set(filteredIndexes.slice(start, end));

                                                                mainRows.forEach((row, index) => {
                                                                    const detailRow = row.nextElementSibling;
                                                                    const shouldShow = visibleIndexes.has(index);
                                                                    row.style.display = shouldShow ? '' : 'none';
                                                                    if (!shouldShow && detailRow) {
                                                                        detailRow.style.display = 'none';
                                                                        detailRow.classList.remove('is-visible');
                                                                        const icon = row.querySelector('.reuniones-toggle-detail i');
                                                                        if (icon) {
                                                                            icon.className = 'bi bi-plus-lg';
                                                                        }
                                                                    }
                                                                });

                                                                if (searchSummary) {
                                                                    searchSummary.textContent = `${totalItems} asunto(s) encontrados`;
                                                                }

                                                                if (paginationSummary) {
                                                                    if (totalItems === 0) {
                                                                        paginationSummary.textContent = 'Sin resultados para la búsqueda actual.';
                                                                    } else {
                                                                        paginationSummary.textContent = `Mostrando ${start + 1}-${Math.min(end, totalItems)} de ${totalItems} asunto(s)`;
                                                                    }
                                                                }

                                                                renderPagination(totalPages);
                                                            }

                                                            function renderPagination(totalPages) {
                                                                if (!paginationPages) {
                                                                    return;
                                                                }

                                                                paginationPages.innerHTML = '';

                                                                for (let page = 1; page <= totalPages; page++) {
                                                                    const button = document.createElement('button');
                                                                    button.type = 'button';
                                                                    button.className = `btn btn-sm btn-outline-secondary${page === currentPage ? ' active' : ''}`;
                                                                    button.textContent = page;
                                                                    button.addEventListener('click', () => {
                                                                        currentPage = page;
                                                                        renderTablePage();
                                                                    });
                                                                    paginationPages.appendChild(button);
                                                                }
                                                            }

                                                            document.querySelectorAll('.reuniones-toggle-detail').forEach(button => {
                                                                button.addEventListener('click', () => {
                                                                    const mainRow = button.closest('tr');
                                                                    const detailRow = mainRow?.nextElementSibling;
                                                                    const icon = button.querySelector('i');

                                                                    if (!detailRow) {
                                                                        return;
                                                                    }

                                                                    const isVisible = detailRow.classList.toggle('is-visible');
                                                                    detailRow.style.display = isVisible ? 'table-row' : 'none';

                                                                    if (icon) {
                                                                        icon.className = isVisible ? 'bi bi-dash-lg' : 'bi bi-plus-lg';
                                                                    }
                                                                });
                                                            });

                                                            function bindCrudModals() {
                                                                document.querySelectorAll('[data-bs-target="#reunionesEditarModal"]').forEach((button) => {
                                                                    button.addEventListener('click', () => {
                                                                        const asuntoId = button.dataset.asuntoId;
                                                                        const item = asuntoPayload[asuntoId];
                                                                        document.getElementById('editarAsuntoId').value = asuntoId;
                                                                        document.getElementById('editarAsuntoEstatus').value = item?.Estatus || 'Pendiente';
                                                                        document.getElementById('editarFechaCompromiso').value = item?.FechaCompromiso || '';
                                                                        document.getElementById('editarFechaAtencion').value = item?.FechaAtencion || '';
                                                                    });
                                                                });

                                                                document.querySelectorAll('[data-bs-target="#reunionesComentarioModal"]').forEach((button) => {
                                                                    button.addEventListener('click', () => {
                                                                        document.getElementById('comentarioAsuntoId').value = button.dataset.asuntoId;
                                                                        document.getElementById('comentarioAsuntoTitulo').textContent = button.dataset.asuntoTitulo || '';
                                                                    });
                                                                });

                                                                document.querySelectorAll('[data-bs-target="#reunionesMonicaModal"]').forEach((button) => {
                                                                    button.addEventListener('click', () => {
                                                                        const asuntoId = button.dataset.asuntoId;
                                                                        const item = asuntoPayload[asuntoId];
                                                                        document.getElementById('monicaAsuntoId').value = asuntoId;
                                                                        document.getElementById('monicaAsuntoTitulo').textContent = button.dataset.asuntoTitulo || '';
                                                                        document.getElementById('monicaObservaciones').value = item?.ObservacionesEnvioMonica || '';
                                                                    });
                                                                });

                                                                document.querySelectorAll('[data-bs-target="#reunionesDesactivarModal"]').forEach((button) => {
                                                                    button.addEventListener('click', () => {
                                                                        document.getElementById('desactivarAsuntoId').value = button.dataset.asuntoId;
                                                                        document.getElementById('desactivarAsuntoTitulo').textContent = button.dataset.asuntoTitulo || '';
                                                                    });
                                                                });
                                                            }

                                                            function bindChartFullscreen() {
                                                                const requestFullscreen = (element) => {
                                                                    if (element.requestFullscreen) {
                                                                        return element.requestFullscreen();
                                                                    }

                                                                    if (element.webkitRequestFullscreen) {
                                                                        return element.webkitRequestFullscreen();
                                                                    }

                                                                    return Promise.resolve();
                                                                };

                                                                document.querySelectorAll('[data-chart-fullscreen]').forEach((button) => {
                                                                    button.addEventListener('click', async () => {
                                                                        const card = button.closest('.reuniones-chart-card');
                                                                        if (!card) {
                                                                            return;
                                                                        }

                                                                        const fullscreenElement = document.fullscreenElement || document.webkitFullscreenElement;
                                                                        if (fullscreenElement === card) {
                                                                            if (document.exitFullscreen) {
                                                                                await document.exitFullscreen();
                                                                            } else if (document.webkitExitFullscreen) {
                                                                                document.webkitExitFullscreen();
                                                                            }
                                                                            return;
                                                                        }

                                                                        await requestFullscreen(card);
                                                                    });
                                                                });

                                                                ['fullscreenchange', 'webkitfullscreenchange'].forEach((eventName) => {
                                                                    document.addEventListener(eventName, () => {
                                                                        const fullscreenElement = document.fullscreenElement || document.webkitFullscreenElement;

                                                                        window.setTimeout(() => {
                                                                            charts.forEach((chart) => {
                                                                                if (!fullscreenElement && chart?.renderTo) {
                                                                                    chart.renderTo.style.height = '';
                                                                                    chart.setSize(null, null, false);
                                                                                }

                                                                                chart.reflow();
                                                                            });
                                                                        }, 120);
                                                                    });
                                                                });
                                                            }

                                                            searchInput?.addEventListener('input', applyFilter);

                                                            renderCharts();
                                                            bindChartFullscreen();
                                                            bindCrudModals();
                                                            renderTablePage();
                                                        })();
                                                    </script>
                                                }