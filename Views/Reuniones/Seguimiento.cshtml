                        const semBadge = a.Semaforo === 'Rojo' ? 'reuniones-badge--critical' : (a.Semaforo === 'Amarillo' ? 'bg-warning-subtle text-warning-emphasis border border-warning-subtle' : 'bg-success-subtle text-success border border-success-subtle');
                        const folderIconHtml = a.CarpetaSharePointUrl 
                            ? `<a href="${escapeHtml(a.CarpetaSharePointUrl)}" target="_blank" rel="noopener noreferrer" style="color: #8a0031; margin-left: 0.4rem; font-size: 0.95rem; vertical-align: middle;" title="Abrir expediente en SharePoint"><i class="bi bi-folder-symlink-fill"></i></a>` 
                            : '';
                        return `
                            <tr>
                                <td style="width: 100px; min-width: 100px;"><span class="badge rounded-pill ${semBadge}" style="font-size: 0.72rem; padding: 0.35em 0.75em;">${escapeHtml(a.Semaforo)}</span></td>
                                <td><strong>${escapeHtml(a.TituloAsunto)}</strong>${folderIconHtml}</td>
                                <td style="width: 180px; min-width: 180px;">${escapeHtml(a.Responsable || a.Encargado || '-')}</td>
                                <td style="width: 120px; min-width: 120px;">${escapeHtml(a.FechaCompromiso || '-')}</td>
                                <td style="width: 110px; min-width: 110px;">${escapeHtml(a.Estatus)}</td>
                            </tr>
                        `;
                    }).join('');
                    
                    slidesHtml += `
                        <section class="internal-slide internal-slide--content">
                            <div class="internal-slide__top">
                                <div class="internal-slide__brand">
                                    <img src="https://cdn.sassoapps.com/dgmesnie/logo_gob.png" alt="Gobierno de México">
                                    <img src="https://cdn.sassoapps.com/dgmesnie/logo_sener.png" alt="Secretaría de Energía">
                                </div>
                                <div class="internal-slide__title">Listado de Asuntos (${pageNum} de ${totalPages})</div>
                                <div class="internal-slide__unit">DGMESNIE · Reuniones</div>
                            </div>
                            <div class="internal-slide__body">
                                <h2>Matriz de Seguimiento General</h2>
                                <table class="slide-table" style="font-size: 0.82rem;">
                                    <thead>
                                        <tr>
                                            <th style="width: 100px; min-width: 100px;">Semáforo</th>
                                            <th>Asunto</th>
                                            <th style="width: 180px; min-width: 180px;">Responsable</th>
                                            <th style="width: 120px; min-width: 120px;">Compromiso</th>
                                            <th style="width: 110px; min-width: 110px;">Estatus</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        ${rowsHtml}
                                    </tbody>
                                </table>
                            </div>
                            <div class="internal-slide__footer">
                                <span></span>
                                <span></span>
                                <span></span>
                            </div>
                        </section>
                    `;
                }
                return slidesHtml;
            }

            function renderSlideCharts(filtered) {
                const estatusCounts = countBy(filtered, 'Estatus');
                const semaforoCounts = countBy(filtered, 'Semaforo');
                const monicaCounts = countBy(filtered, 'AlertaEnvioMonica');

                const colors = {
                    guinda: '#8a0031',
                    verde: '#1e5b4f',
                    dorado: '#A57F2C',
                    amarilloClaro: '#E9C46A',
                    gris: '#6c757d',
                    fondo: '#ffffff',
                    texto: '#243444',
                    linea: '#d9c7ad'
                };

                if (document.getElementById('slide-chart-estatus') && window.Highcharts) {
                    Highcharts.chart('slide-chart-estatus', {
                        chart: { type: 'pie', backgroundColor: '#ffffff', height: 280 },
                        title: { text: null },
                        credits: { enabled: false },
                        exporting: { enabled: false },
                        tooltip: { pointFormat: '<b>{point.y}</b> asunto(s)' },
                        plotOptions: {
                            pie: {
                                innerSize: '55%',
                                borderWidth: 2,
                                borderColor: '#ffffff',
                                dataLabels: { enabled: false },
                                showInLegend: true
                            }
                        },
                        legend: {
                            align: 'center',
                            verticalAlign: 'bottom',
                            itemStyle: { fontSize: '10px' }
                        },
                        series: [{
                            name: 'Estatus',
                            data: Object.entries(estatusCounts).map(([name, y]) => ({
                                name,
                                y,
                                color: name === 'Atendido' ? colors.verde : (name === 'En proceso' ? colors.dorado : colors.guinda)
                            }))
                        }]
                    });
                }

                if (document.getElementById('slide-chart-semaforo') && window.Highcharts) {
                    Highcharts.chart('slide-chart-semaforo', {
                        chart: { type: 'pie', backgroundColor: '#ffffff', height: 280 },
                        title: { text: null },
                        credits: { enabled: false },
                        exporting: { enabled: false },
                        tooltip: { pointFormat: '<b>{point.y}</b> asunto(s)' },
                        plotOptions: {
                            pie: {
                                innerSize: '0%',
                                borderWidth: 2,
                                borderColor: '#ffffff',
                                dataLabels: { enabled: false },
                                showInLegend: true
                            }
                        },
                        legend: {
                            align: 'center',
                            verticalAlign: 'bottom',
                            itemStyle: { fontSize: '10px' }
                        },
                        series: [{
                            name: 'Semáforo',
                            data: Object.entries(semaforoCounts).map(([name, y]) => ({
                                name,
                                y,
                                color: name === 'Rojo' ? colors.guinda : (name === 'Amarillo' ? colors.amarilloClaro : colors.verde)
                            }))
                        }]
                    });
                }

                if (document.getElementById('slide-chart-monica') && window.Highcharts) {
                    Highcharts.chart('slide-chart-monica', {
                        chart: { type: 'column', backgroundColor: '#ffffff', height: 280 },
                        title: { text: null },
                        credits: { enabled: false },
                        exporting: { enabled: false },
                        xAxis: { categories: Object.keys(monicaCounts) },
                        yAxis: { title: { text: 'Asuntos' }, allowDecimals: false },
                        legend: { enabled: false },
                        series: [{
                            name: 'Jurídico',
                            borderRadius: 4,
                            data: Object.entries(monicaCounts).map(([name, y]) => ({
                                name,
                                y,
                                color: name === 'Enviado a Mónica' ? colors.verde : colors.guinda
                            }))
                        }]
                    });
                }
            }

            function countBy(items, key) {
                return items.reduce((acc, item) => {
                    const value = (item[key] || 'Sin dato').trim();
                    acc[value] = (acc[value] || 0) + 1;
                    return acc;
                }, {});
            }

            function renderReportDeck() {
                const deck = document.getElementById('internal-report-deck');
                if (!deck) return;

                const filtered = filterReportMatters();
                
                const summaryEl = document.getElementById('rep-summary');
                const totalCount = filtered.length;
                const atendidosCount = filtered.filter(a => a.Estatus === 'Atendido' || a.Semaforo === 'Verde').length;
                const pendientesCount = totalCount - atendidosCount;
                const monicaCount = filtered.filter(a => a.AlertaEnvioMonica === 'Pendiente de envío a Mónica').length;

                if (summaryEl) {
                    summaryEl.textContent = `${totalCount} asunto(s) · ${atendidosCount} atendido(s) · ${pendientesCount} pendiente(s)`;
                }

                let deckHtml = '';
                deckHtml += getCoverSlideHtml(filtered, totalCount, atendidosCount, pendientesCount, monicaCount);
                deckHtml += getIndicatorsSlideHtml(totalCount, atendidosCount, pendientesCount, monicaCount);
                deckHtml += getCriticalMattersSlideHtml(filtered);
                deckHtml += getJuridicoSlideHtml(filtered);
                deckHtml += getMattersDetailSlidesHtml(filtered);

                deck.innerHTML = deckHtml;
                renderSlideCharts(filtered);
            }

            async function descargarPdf() {
                if (!window.jspdf || !window.html2canvas) {
                    showToast('Librerías PDF no cargadas', 'err');
                    return;
                }
                const slides = [...document.querySelectorAll('#internal-report-deck .internal-slide')];
                if (!slides.length) {
                    showToast('Sin diapositivas para exportar', 'err');
                    return;
                }
                showToast('Generando PDF…');
                
                try {
                    const { jsPDF } = window.jspdf;
                    const pdf = new jsPDF({ orientation: 'landscape', unit: 'px', format: [1280, 720] });

                    for (let idx = 0; idx < slides.length; idx++) {
                        const canvas = await html2canvas(slides[idx], {
                            scale: 1.5,
                            useCORS: true,
                            allowTaint: false,
                            imageTimeout: 15000,
                            backgroundColor: '#ffffff'
                        });
                        const img = canvas.toDataURL('image/jpeg', 0.94);
                        if (idx > 0) pdf.addPage([1280, 720], 'landscape');
                        pdf.addImage(img, 'JPEG', 0, 0, 1280, 720);
                    }

                    pdf.save(`reporte-reuniones-${new Date().toISOString().slice(0, 10)}.pdf`);
                    showToast('PDF descargado', 'ok');
                } catch (err) {
                    console.error('Error generando PDF', err);
                    showToast('No se pudo generar el PDF', 'err');
                }
            }

            async function descargarPpt() {
                if (!window.PptxGenJS || !window.html2canvas) {
                    showToast('Librerías PPT no cargadas', 'err');
                    return;
                }
                const slides = [...document.querySelectorAll('#internal-report-deck .internal-slide')];
                if (!slides.length) {
                    showToast('Sin diapositivas para exportar', 'err');
                    return;
                }
                showToast('Generando PPT…');

                try {
                    const pptx = new PptxGenJS();
                    pptx.defineLayout({ name: 'INST', width: 13.333, height: 7.5 });
                    pptx.layout = 'INST';

                    for (const el of slides) {
                        const canvas = await html2canvas(el, { scale: 1.4, useCORS: true, backgroundColor: '#ffffff' });
                        const data = canvas.toDataURL('image/png');
                        const slide = pptx.addSlide();
                        slide.addImage({ data, x: 0, y: 0, w: 13.333, h: 7.5 });
                    }

                    await pptx.writeFile({ fileName: `reporte-reuniones-${new Date().toISOString().slice(0, 10)}.pptx` });
                    showToast('PPT descargado', 'ok');
                } catch (err) {
                    console.error('Error generando PPT', err);
                    showToast('No se pudo generar el PPT', 'err');
                }
            }

            let presentationMode = false;
            let presentationIndex = 0;
            let presentationSlides = [];

            function setPresentationControls(visible) {
                const controls = document.getElementById('presentationControls');
                if (!controls) return;
                controls.style.display = visible ? 'flex' : 'none';
                controls.setAttribute('aria-hidden', visible ? 'false' : 'true');
            }

            function fitActiveSlide() {
                if (!presentationMode || !presentationSlides.length) return;
                const active = presentationSlides[presentationIndex];
                if (!active) return;

                const baseW = active.offsetWidth || 1280;
                const baseH = active.offsetHeight || 720;
                const baseScale = Math.min(window.innerWidth / baseW, window.innerHeight / baseH);
                const scale = Math.max(0.2, baseScale * 0.98);
                active.style.setProperty('--presentation-scale', scale.toFixed(4));
            }

            function renderPresentationState() {
                if (!presentationSlides.length) return;
                presentationSlides.forEach((slide, idx) => {
                    slide.classList.toggle('active', idx === presentationIndex);
                    if (idx !== presentationIndex) slide.style.removeProperty('--presentation-scale');
                });
                const counter = document.getElementById('presentationCounter');
                if (counter) counter.textContent = `${presentationIndex + 1}/${presentationSlides.length}`;
                fitActiveSlide();
            }

            async function enterPresentation(startAt = 0) {
                presentationSlides = [...document.querySelectorAll('#internal-report-deck .internal-slide')];
                if (!presentationSlides.length) return;
                presentationMode = true;
                presentationIndex = Math.min(Math.max(startAt, 0), presentationSlides.length - 1);
                document.body.classList.add('presentation-mode');
                setPresentationControls(true);
                renderPresentationState();
                if (!document.fullscreenElement && document.documentElement.requestFullscreen) {
                    try { await document.documentElement.requestFullscreen(); } catch (_) { }
                }
                requestAnimationFrame(fitActiveSlide);
            }

            async function exitPresentation() {
                if (!presentationMode) return;
                presentationMode = false;
                document.body.classList.remove('presentation-mode');
                presentationSlides.forEach(slide => {
                    slide.classList.remove('active');
                    slide.style.removeProperty('--presentation-scale');
                });
                setPresentationControls(false);
                if (document.fullscreenElement && document.exitFullscreen) {
                    try { await document.exitFullscreen(); } catch (_) { }
                }
            }

            function nextPresentationSlide() {
                if (!presentationMode) return;
                presentationIndex = Math.min(presentationSlides.length - 1, presentationIndex + 1);
                renderPresentationState();
            }

            function prevPresentationSlide() {
                if (!presentationMode) return;
                presentationIndex = Math.max(0, presentationIndex - 1);
                renderPresentationState();
            }

            function wireReportes() {
                // Support both jQuery (Bootstrap 4) and Vanilla JS (Bootstrap 5) events
                const $tabEl = $('#tab-reportes');
                if ($tabEl.length) {
                    $tabEl.on('shown.bs.tab', () => {
                        renderReportDeck();
                    });
                }
                const tabEl = document.getElementById('tab-reportes');
                if (tabEl) {
                    tabEl.addEventListener('shown.bs.tab', () => {
                        renderReportDeck();
                    });
                }

                ['rep-filtro-estatus', 'rep-filtro-semaforo', 'rep-filtro-monica'].forEach(id => {
                    const el = document.getElementById(id);
                    if (el) el.addEventListener('change', renderReportDeck);
                });
                const q = document.getElementById('rep-filtro-busqueda');
                if (q) q.addEventListener('input', renderReportDeck);

                document.getElementById('rep-refresh')?.addEventListener('click', renderReportDeck);
                document.getElementById('rep-pdf')?.addEventListener('click', descargarPdf);
                document.getElementById('rep-ppt')?.addEventListener('click', descargarPpt);
                document.getElementById('rep-presentar')?.addEventListener('click', () => enterPresentation(0));

                document.getElementById('btnPrevSlide')?.addEventListener('click', prevPresentationSlide);
                document.getElementById('btnNextSlide')?.addEventListener('click', nextPresentationSlide);
                document.getElementById('btnExitPresentation')?.addEventListener('click', exitPresentation);

                window.addEventListener('resize', fitActiveSlide);
                
                document.addEventListener('fullscreenchange', () => {
                    if (presentationMode && !document.fullscreenElement) {
                        exitPresentation();
                    }
                });

                document.addEventListener('keydown', (ev) => {
                    if (!presentationMode) return;
                    if (['ArrowRight', 'PageDown', ' '].includes(ev.key)) {
                        ev.preventDefault();
                        nextPresentationSlide();
                    } else if (['ArrowLeft', 'PageUp', 'Backspace'].includes(ev.key)) {
                        ev.preventDefault();
                        prevPresentationSlide();
                    } else if (ev.key === 'Home') {
                        ev.preventDefault();
                        presentationIndex = 0;
                        renderPresentationState();
                    } else if (ev.key === 'End') {
                        ev.preventDefault();
                        presentationIndex = Math.max(0, presentationSlides.length - 1);
                        renderPresentationState();
                    } else if (ev.key === 'Escape') {
                        ev.preventDefault();
                        exitPresentation();
                    }
                });
            }

            renderCharts();
            bindChartFullscreen();
            bindCrudModals();
            renderTablePage();
            wireReportes();
        })();
    </script>
}