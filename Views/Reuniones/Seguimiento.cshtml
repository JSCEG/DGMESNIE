@model NSIE.Models.ReunionesSeguimientoViewModel

@{
    ViewData["Title"] = "Seguimiento de asuntos";
    var asuntosJson = Newtonsoft.Json.JsonConvert.SerializeObject(Model.Asuntos.Select(asunto => new
    {
        asunto.AsuntoId,
        asunto.TituloAsunto,
        asunto.Descripcion,
        asunto.Expediente,
        asunto.Responsable,
        asunto.AreaResponsable,
        asunto.Estatus,
        asunto.Semaforo,
        asunto.AlertaEnvioMonica,
        FechaReunion = asunto.FechaReunion?.ToString("dd/MM/yyyy"),
        FechaCompromiso = asunto.FechaCompromiso?.ToString("dd/MM/yyyy"),
        FechaAtencion = asunto.FechaAtencion?.ToString("dd/MM/yyyy"),
        FechaEnvioMonica = asunto.FechaEnvioMonica?.ToString("dd/MM/yyyy HH:mm"),
        asunto.CarpetaSharePointUrl,
        asunto.ObservacionesEnvioMonica,
        asunto.EnviadoAMonicaPorNombre,
        asunto.DestinatarioJuridico,
        asunto.TotalComentarios,
        asunto.NombreUsuarioUltimaActualizacion
    }));
}

@section Styles {
    <style>
        .reuniones-toolbar {
            display: flex;
            flex-wrap: wrap;
            justify-content: space-between;
            gap: 1rem;
            margin-bottom: 1.25rem;
        }

        .reuniones-toolbar__search {
            min-width: min(100%, 420px);
            position: relative;
            flex: 1 1 420px;
        }

        .reuniones-toolbar__search .form-control {
            padding-left: 2.7rem;
            border-radius: 14px;
        }

        .reuniones-toolbar__search-icon {
            position: absolute;
            top: 50%;
            left: 0.95rem;
            transform: translateY(-50%);
            color: #9B2247;
        }

        .reuniones-toolbar__meta {
            display: flex;
            align-items: center;
            gap: 0.75rem;
            color: #6c757d;
            font-size: 0.92rem;
        }

        .reuniones-chart-card {
            border: 1px solid rgba(155, 34, 71, 0.08);
            border-radius: 22px;
            background: #fff;
            padding: 1rem;
            box-shadow: 0 12px 24px rgba(31, 41, 55, 0.05);
        }

        .reuniones-chart-card__title {
            margin: 0 0 0.75rem;
            color: #243444;
            font-size: 1rem;
            font-weight: 700;
        }

        .reuniones-chart {
            min-height: 280px;
        }

        .reuniones-table thead th {
            white-space: nowrap;
            font-size: 0.82rem;
            text-transform: uppercase;
            letter-spacing: 0.04em;
        }

        .reuniones-table td {
            vertical-align: top;
        }

        .reuniones-table__title {
            min-width: 260px;
        }

        .reuniones-table__title strong {
            display: block;
            margin-bottom: 0.25rem;
            color: #243444;
        }

        .reuniones-table__title small {
            display: -webkit-box;
            -webkit-line-clamp: 2;
            -webkit-box-orient: vertical;
            overflow: hidden;
            color: #6b7280;
        }

        .reuniones-detail-row {
            display: none;
        }

        .reuniones-detail-row.is-visible {
            display: table-row;
        }

        .reuniones-detail-panel {
            padding: 1rem 1.1rem;
            background: linear-gradient(180deg, #fffdf8 0%, #ffffff 100%);
        }

        .reuniones-detail-grid {
            display: grid;
            grid-template-columns: repeat(2, minmax(0, 1fr));
            gap: 0.9rem;
        }

        .reuniones-detail-card {
            border: 1px solid rgba(155, 34, 71, 0.08);
            border-radius: 16px;
            padding: 0.85rem 0.95rem;
            background: #fff;
        }

        .reuniones-detail-card span {
            display: block;
            margin-bottom: 0.25rem;
            color: #7b8797;
            font-size: 0.78rem;
            font-weight: 700;
            letter-spacing: 0.04em;
            text-transform: uppercase;
        }

        .reuniones-detail-card strong,
        .reuniones-detail-card p {
            margin: 0;
            color: #243444;
            font-size: 0.92rem;
            line-height: 1.5;
        }

        .reuniones-pagination {
            display: flex;
            flex-wrap: wrap;
            justify-content: space-between;
            align-items: center;
            gap: 0.9rem;
            margin-top: 1rem;
        }

        .reuniones-pagination__pages {
            display: flex;
            flex-wrap: wrap;
            gap: 0.5rem;
        }

        .reuniones-pagination__pages .btn.active {
            background: #9B2247;
            border-color: #9B2247;
            color: #fff;
        }

        @@media (max-width: 991.98px) {
            .reuniones-detail-grid {
                grid-template-columns: 1fr;
            }
        }
    </style>
}

@if (Model.Header != null)
{
    @await Html.PartialAsync("_ViewHeader", Model.Header)
}

<div class="container-fluid shell-page-container py-3">
    <div class="row g-4 mb-4">
        <div class="col-12 col-md-6 col-xl-3">
            <div class="border rounded-3 bg-white p-4 shadow-sm h-100">
                <div class="text-muted small mb-2">Total de asuntos</div>
                <div class="display-6 fw-semibold text-dark">@Model.TotalAsuntos</div>
            </div>
        </div>
        <div class="col-12 col-md-6 col-xl-3">
            <div class="border rounded-3 bg-white p-4 shadow-sm h-100 border-success-subtle">
                <div class="text-muted small mb-2">Atendidos</div>
                <div class="display-6 fw-semibold text-success">@Model.TotalAtendidos</div>
            </div>
        </div>
        <div class="col-12 col-md-6 col-xl-3">
            <div class="border rounded-3 bg-white p-4 shadow-sm h-100 border-warning-subtle">
                <div class="text-muted small mb-2">Pendientes</div>
                <div class="display-6 fw-semibold text-warning-emphasis">@Model.TotalPendientes</div>
            </div>
        </div>
        <div class="col-12 col-md-6 col-xl-3">
            <div class="border rounded-3 bg-white p-4 shadow-sm h-100 border-danger-subtle">
                <div class="text-muted small mb-2">Pendientes con Mónica</div>
                <div class="display-6 fw-semibold text-danger">@Model.TotalPendientesEnvioMonica</div>
            </div>
        </div>
    </div>

    <div class="row g-4 mb-4">
        <div class="col-12 col-lg-4">
            <div class="reuniones-chart-card">
                <h4 class="reuniones-chart-card__title">Estatus de atención</h4>
                <div id="reunionesChartEstatus" class="reuniones-chart"></div>
            </div>
        </div>
        <div class="col-12 col-lg-4">
            <div class="reuniones-chart-card">
                <h4 class="reuniones-chart-card__title">Semáforo de seguimiento</h4>
                <div id="reunionesChartSemaforo" class="reuniones-chart"></div>
            </div>
        </div>
        <div class="col-12 col-lg-4">
            <div class="reuniones-chart-card">
                <h4 class="reuniones-chart-card__title">Seguimiento con jurídico</h4>
                <div id="reunionesChartMonica" class="reuniones-chart"></div>
            </div>
        </div>
    </div>

    <div class="border rounded-3 bg-white p-4 shadow-sm">
        <div class="d-flex flex-wrap justify-content-between align-items-start gap-3 mb-3">
            <div>
                <h4 class="mb-1">Tablero de seguimiento</h4>
                <p class="text-muted mb-0">Consulta, filtra y despliega el detalle de cada asunto sin saturar la tabla principal.</p>
            </div>
            <div class="d-flex gap-2">
                <a class="btn btn-outline-secondary" href="@Url.Action("ImportarExpedientes")">Respaldo manual</a>
                <button class="btn btn-primary" type="button" disabled>Nuevo asunto</button>
            </div>
        </div>

        <div class="reuniones-toolbar">
            <div class="reuniones-toolbar__search">
                <i class="bi bi-search reuniones-toolbar__search-icon"></i>
                <input id="reunionesSearchInput" type="search" class="form-control" placeholder="Buscar por asunto, expediente, responsable o estatus..." />
            </div>
            <div class="reuniones-toolbar__meta">
                <span id="reunionesSearchSummary">@Model.TotalAsuntos asunto(s)</span>
            </div>
        </div>

        @if (!Model.Asuntos.Any())
        {
            <div class="alert alert-secondary mb-0">No hay asuntos disponibles para mostrar en el dashboard.</div>
        }
        else
        {
            <div class="table-responsive">
                <table class="table table-hover align-middle reuniones-table" id="reunionesTable">
                    <thead class="table-light">
                        <tr>
                            <th></th>
                            <th>Semáforo</th>
                            <th>Asunto</th>
                            <th>Envío jurídico</th>
                            <th>Expediente</th>
                            <th>Responsable</th>
                            <th>Reunión</th>
                            <th>Compromiso</th>
                            <th>Estatus</th>
                            <th>Carpeta</th>
                        </tr>
                    </thead>
                    <tbody id="reunionesTableBody">
                        @foreach (var asunto in Model.Asuntos)
                        {
                            var badgeClass = asunto.Semaforo switch
                            {
                                "Verde" => "bg-success-subtle text-success border border-success-subtle",
                                "Amarillo" => "bg-warning-subtle text-warning-emphasis border border-warning-subtle",
                                "Rojo" => "bg-danger-subtle text-danger border border-danger-subtle",
                                _ => "bg-secondary-subtle text-secondary border border-secondary-subtle"
                            };

                            var alertaClass = asunto.AlertaEnvioMonica switch
                            {
                                "Pendiente de envío a Mónica" => "bg-danger-subtle text-danger border border-danger-subtle",
                                "Enviado a Mónica" => "bg-success-subtle text-success border border-success-subtle",
                                _ => "bg-secondary-subtle text-secondary border border-secondary-subtle"
                            };

                            <tr class="reuniones-main-row"
                                data-search="@($"{asunto.TituloAsunto} {asunto.Expediente} {asunto.Responsable} {asunto.Estatus} {asunto.Semaforo} {asunto.AlertaEnvioMonica}".ToLowerInvariant())">
                                <td>
                                    <button type="button" class="btn btn-sm btn-outline-secondary reuniones-toggle-detail" aria-label="Mostrar detalle">
                                        <i class="bi bi-plus-lg"></i>
                                    </button>
                                </td>
                                <td><span class="badge rounded-pill @badgeClass">@asunto.Semaforo</span></td>
                                <td class="reuniones-table__title">
                                    <strong>@asunto.TituloAsunto</strong>
                                    <small>@(string.IsNullOrWhiteSpace(asunto.Descripcion) ? "Sin descripción operativa." : asunto.Descripcion)</small>
                                </td>
                                <td><span class="badge rounded-pill @alertaClass">@asunto.AlertaEnvioMonica</span></td>
                                <td>@(string.IsNullOrWhiteSpace(asunto.Expediente) ? "-" : asunto.Expediente)</td>
                                <td>@(string.IsNullOrWhiteSpace(asunto.Responsable) ? "-" : asunto.Responsable)</td>
                                <td>@(asunto.FechaReunion?.ToString("dd/MM/yyyy") ?? "-")</td>
                                <td>@(asunto.FechaCompromiso?.ToString("dd/MM/yyyy") ?? "-")</td>
                                <td>@asunto.Estatus</td>
                                <td>
                                    @if (!string.IsNullOrWhiteSpace(asunto.CarpetaSharePointUrl))
                                    {
                                        <a class="btn btn-sm btn-outline-primary" href="@asunto.CarpetaSharePointUrl"
                                           target="_blank" rel="noopener noreferrer">Abrir carpeta</a>
                                    }
                                    else
                                    {
                                        <span class="badge text-bg-light border">Sin carpeta</span>
                                    }
                                </td>
                            </tr>
                            <tr class="reuniones-detail-row">
                                <td colspan="10" class="reuniones-detail-panel">
                                    <div class="reuniones-detail-grid">
                                        <div class="reuniones-detail-card">
                                            <span>Descripción</span>
                                            <p>@(string.IsNullOrWhiteSpace(asunto.Descripcion) ? "Sin descripción registrada." : asunto.Descripcion)</p>
                                        </div>
                                        <div class="reuniones-detail-card">
                                            <span>Seguimiento jurídico</span>
                                            <p>@(string.IsNullOrWhiteSpace(asunto.ObservacionesEnvioMonica) ? "Sin observaciones registradas." : asunto.ObservacionesEnvioMonica)</p>
                                        </div>
                                        <div class="reuniones-detail-card">
                                            <span>Área responsable</span>
                                            <strong>@(string.IsNullOrWhiteSpace(asunto.AreaResponsable) ? "-" : asunto.AreaResponsable)</strong>
                                        </div>
                                        <div class="reuniones-detail-card">
                                            <span>Comentarios históricos</span>
                                            <strong>@asunto.TotalComentarios</strong>
                                        </div>
                                        <div class="reuniones-detail-card">
                                            <span>Enviado a Mónica por</span>
                                            <strong>@(string.IsNullOrWhiteSpace(asunto.EnviadoAMonicaPorNombre) ? "Pendiente / sin registro" : asunto.EnviadoAMonicaPorNombre)</strong>
                                        </div>
                                        <div class="reuniones-detail-card">
                                            <span>Fecha de envío</span>
                                            <strong>@(asunto.FechaEnvioMonica?.ToString("dd/MM/yyyy HH:mm") ?? "-")</strong>
                                        </div>
                                        <div class="reuniones-detail-card">
                                            <span>Fecha de atención</span>
                                            <strong>@(asunto.FechaAtencion?.ToString("dd/MM/yyyy") ?? "-")</strong>
                                        </div>
                                        <div class="reuniones-detail-card">
                                            <span>Última actualización</span>
                                            <strong>@(string.IsNullOrWhiteSpace(asunto.NombreUsuarioUltimaActualizacion) ? "-" : asunto.NombreUsuarioUltimaActualizacion)</strong>
                                        </div>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>

            <div class="reuniones-pagination">
                <div class="text-muted small" id="reunionesPaginationSummary"></div>
                <div class="reuniones-pagination__pages" id="reunionesPaginationPages"></div>
            </div>
        }

        @if (Model.Notes.Any())
        {
            <div class="alert alert-warning mt-3 mb-0" role="alert">
                <ul class="mb-0 ps-3">
                    @foreach (var note in Model.Notes)
                    {
                        <li>@note</li>
                    }
                </ul>
            </div>
        }
    </div>
</div>

        @section Scripts {
            <script>
                (() => {
                    const asuntos = @Html.Raw(asuntosJson);
                    const searchInput = document.getElementById('reunionesSearchInput');
                    const searchSummary = document.getElementById('reunionesSearchSummary');
                    const paginationSummary = document.getElementById('reunionesPaginationSummary');
                    const paginationPages = document.getElementById('reunionesPaginationPages');
                    const mainRows = Array.from(document.querySelectorAll('.reuniones-main-row'));
                    const pageSize = 10;
                    let currentPage = 1;
                    let filteredIndexes = mainRows.map((_, index) => index);

                    function renderCharts() {
                        if (!window.Highcharts) {
                            return;
                        }

                        const estatusCounts = contar(asuntos, 'Estatus');
                        const semaforoCounts = contar(asuntos, 'Semaforo');
                        const monicaCounts = contar(asuntos, 'AlertaEnvioMonica');

                        Highcharts.chart('reunionesChartEstatus', {
                            chart: { type: 'column', backgroundColor: 'transparent' },
                            title: { text: null },
                            credits: { enabled: false },
                            xAxis: { categories: Object.keys(estatusCounts), crosshair: true },
                            yAxis: { title: { text: 'Asuntos' }, allowDecimals: false },
                            legend: { enabled: false },
                            series: [{
                                name: 'Estatus',
                                data: Object.entries(estatusCounts).map(([name, y]) => ({ name, y, color: name === 'Atendido' ? '#198754' : '#9B2247' }))
                            }]
                        });

                        Highcharts.chart('reunionesChartSemaforo', {
                            chart: { type: 'pie', backgroundColor: 'transparent' },
                            title: { text: null },
                            credits: { enabled: false },
                            plotOptions: {
                                pie: {
                                    innerSize: '55%',
                                    dataLabels: { enabled: true, format: '{point.name}: {point.y}' }
                                }
                            },
                            series: [{
                                name: 'Semáforo',
                                data: Object.entries(semaforoCounts).map(([name, y]) => ({
                                    name,
                                    y,
                                    color: name === 'Rojo' ? '#dc3545' : name === 'Amarillo' ? '#f0ad4e' : name === 'Verde' ? '#198754' : '#6c757d'
                                }))
                            }]
                        });

                        Highcharts.chart('reunionesChartMonica', {
                            chart: { type: 'bar', backgroundColor: 'transparent' },
                            title: { text: null },
                            credits: { enabled: false },
                            xAxis: { categories: Object.keys(monicaCounts) },
                            yAxis: { title: { text: 'Asuntos' }, allowDecimals: false },
                            legend: { enabled: false },
                            series: [{
                                name: 'Jurídico',
                                data: Object.entries(monicaCounts).map(([name, y]) => ({
                                    name,
                                    y,
                                    color: name === 'Pendiente de envío a Mónica' ? '#dc3545' : name === 'Enviado a Mónica' ? '#198754' : '#6c757d'
                                }))
                            }]
                        });
                    }

                    function contar(items, key) {
                        return items.reduce((acc, item) => {
                            const value = (item[key] || 'Sin dato').trim();
                            acc[value] = (acc[value] || 0) + 1;
                            return acc;
                        }, {});
                    }

                    function applyFilter() {
                        const query = (searchInput?.value || '').trim().toLowerCase();

                        filteredIndexes = mainRows
                            .map((row, index) => ({ row, index }))
                            .filter(item => !query || (item.row.dataset.search || '').includes(query))
                            .map(item => item.index);

                        currentPage = 1;
                        renderTablePage();
                    }

                    function renderTablePage() {
                        const totalItems = filteredIndexes.length;
                        const totalPages = Math.max(1, Math.ceil(totalItems / pageSize));

                        if (currentPage > totalPages) {
                            currentPage = totalPages;
                        }

                        const start = (currentPage - 1) * pageSize;
                        const end = start + pageSize;
                        const visibleIndexes = new Set(filteredIndexes.slice(start, end));

                        mainRows.forEach((row, index) => {
                            const detailRow = row.nextElementSibling;
                            const shouldShow = visibleIndexes.has(index);
                            row.style.display = shouldShow ? '' : 'none';
                            if (!shouldShow && detailRow) {
                                detailRow.style.display = 'none';
                                detailRow.classList.remove('is-visible');
                                const icon = row.querySelector('.reuniones-toggle-detail i');
                                if (icon) {
                                    icon.className = 'bi bi-plus-lg';
                                }
                            }
                        });

                        if (searchSummary) {
                            searchSummary.textContent = `${totalItems} asunto(s) encontrados`;
                        }

                        if (paginationSummary) {
                            if (totalItems === 0) {
                                paginationSummary.textContent = 'Sin resultados para la búsqueda actual.';
                            } else {
                                paginationSummary.textContent = `Mostrando ${start + 1}-${Math.min(end, totalItems)} de ${totalItems} asunto(s)`;
                            }
                        }

                        renderPagination(totalPages);
                    }

                    function renderPagination(totalPages) {
                        if (!paginationPages) {
                            return;
                        }

                        paginationPages.innerHTML = '';

                        for (let page = 1; page <= totalPages; page++) {
                            const button = document.createElement('button');
                            button.type = 'button';
                            button.className = `btn btn-sm btn-outline-secondary${page === currentPage ? ' active' : ''}`;
                            button.textContent = page;
                            button.addEventListener('click', () => {
                                currentPage = page;
                                renderTablePage();
                            });
                            paginationPages.appendChild(button);
                        }
                    }

                    document.querySelectorAll('.reuniones-toggle-detail').forEach(button => {
                        button.addEventListener('click', () => {
                            const mainRow = button.closest('tr');
                            const detailRow = mainRow?.nextElementSibling;
                            const icon = button.querySelector('i');

                            if (!detailRow) {
                                return;
                            }

                            const isVisible = detailRow.classList.toggle('is-visible');
                            detailRow.style.display = isVisible ? 'table-row' : 'none';

                            if (icon) {
                                icon.className = isVisible ? 'bi bi-dash-lg' : 'bi bi-plus-lg';
                            }
                        });
                    });

                    searchInput?.addEventListener('input', applyFilter);

                    renderCharts();
                    renderTablePage();
                })();
            </script>
        }
                                        <div class="fw-semibold mb-1">4. Seguimiento jurídico</div>
                                        <div class="text-muted small">La alerta muestra qué asuntos siguen pendientes de envío a Mónica.</div>
                                    </div>
                            </div>

                            @if (Model.Notes.Any())
                            {
                                <div class="alert alert-warning mb-0" role="alert">
                                    <ul class="mb-0 ps-3">
                                        @foreach (var note in Model.Notes)
                                        {
                                            <li>@note</li>
                                        }
                                    </ul>
                                </div>
                            }
                        </div>
                    </div>
        </div>
    </div>