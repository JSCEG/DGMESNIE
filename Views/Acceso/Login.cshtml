@{
    ViewData["Title"] = "Acceso al Sistema Nacional de Información Energética";
    Layout = null;
    var cdn = "https://cdn.sassoapps.com";
}

<!DOCTYPE html>
<html lang="es">

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"]</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/remixicon@4.3.0/fonts/remixicon.css">
    <link rel="stylesheet" href="~/css/acceso-login.css" asp-append-version="true" />
</head>

<body class="login-shell">
    <video class="login-bg-video" autoplay muted loop playsinline preload="metadata" aria-hidden="true">
        <source src="https://cdn.sassoapps.com/video/fondo_dgmesnie.mp4" type="video/mp4" />
    </video>
    <div class="login-bg-overlay" aria-hidden="true"></div>

    <main class="login-page">
        <section class="brand-side" aria-label="Identidad institucional">
            <div class="institutional-logos">
                <img src="@cdn/dgmesnie/logo_gob.png" alt="Gobierno de México">
                <span class="logo-separator" aria-hidden="true"></span>
                <img src="@cdn/dgmesnie/logo_sener.png" alt="Secretaría de Energía">
            </div>

            <div class="brand-content">
                <div class="brand-kicker">Dirección General de Metodologías y Estadísticas del Sistema Nacional de
                    Información de Energía</div>
                    <h1 class="brand-title" aria-label="Información Energética">
                        <span class="brand-title__line brand-title__line--typing" data-typing-text="Información">Información</span>
                        <span class="brand-title__line">Energética</span>
                    </h1>
                    <div class="title-rule"></div>
                    <p class="brand-text">
                        Información estratégica para consultar, gestionar y dar seguimiento a los datos del sector
                        energético nacional.
                    </p>

                    <div class="feature-list">
                        <div class="feature-item">
                            <div class="feature-icon">
                                <i class="ri-shield-check-line" aria-hidden="true"></i>
                            </div>
                            <div>
                                <strong>Seguridad institucional</strong>
                                <span>Protegemos la información con los más altos estándares.</span>
                            </div>
                        </div>
                        <div class="feature-item">
                            <div class="feature-icon">
                                <i class="ri-git-branch-line" aria-hidden="true"></i>
                            </div>
                            <div>
                                <strong>Trazabilidad de información</strong>
                                <span>Seguimiento y transparencia en cada proceso.</span>
                            </div>
                        </div>
                        <div class="feature-item">
                            <div class="feature-icon">
                                <i class="ri-line-chart-line" aria-hidden="true"></i>
                            </div>
                            <div>
                                <strong>Datos estratégicos</strong>
                                <span>Información confiable para la toma de decisiones.</span>
                            </div>
                        </div>
                    </div>
                </div>
            </section>

            <section class="auth-panel" aria-label="Formulario de inicio de sesión">
                <div class="lock-badge">
                    <i class="ri-lock-2-line" aria-hidden="true"></i>
                </div>

                <h2 class="login-title">Iniciar sesión</h2>
                <p class="login-subtitle">Accede con tu correo electrónico o RFC institucional.</p>

                <form action="@Url.Action("Login", "Acceso")" method="post" class="login-form">
                    <div class="mb-3">
                        <label class="form-label" for="Correo">Correo electrónico o RFC</label>
                        <div class="login-input">
                            <span class="input-icon"><i class="ri-user-3-line" aria-hidden="true"></i></span>
                            <input type="text" class="form-control" id="Correo" name="Correo"
                                   placeholder="usuario@dominio.gob.mx" autocomplete="username" />
                        </div>
                    </div>

                    <div class="mb-3">
                        <label class="form-label" for="Clave">Contraseña</label>
                        <div class="login-input password-input">
                            <span class="input-icon"><i class="ri-door-lock-line" aria-hidden="true"></i></span>
                            <input type="password" class="form-control" id="Clave" name="Clave"
                                   placeholder="Ingresa tu contraseña" autocomplete="current-password" />
                            <button type="button" class="toggle-password" onclick="togglePassword()"
                                    aria-label="Mostrar contraseña">
                                <i class="ri-eye-line" id="iconoClave" aria-hidden="true"></i>
                            </button>
                        </div>
                    </div>

                    @if (ViewData["Mensaje"] != null)
                    {
                        <div class="login-alert text-center">
                            <i class="ri-error-warning-line me-2" aria-hidden="true"></i>@ViewData["Mensaje"]
                        </div>
                    }

                    <button type="submit" class="login-submit">
                        <span class="login-submit__content">
                            <i class="ri-login-box-line" aria-hidden="true"></i>
                            <span>Iniciar sesión</span>
                        </span>
                    </button>
                </form>

                <div class="login-links">
                    <a href="@Url.Action("ForgotPassword", "Acceso")">¿Olvidaste tu contraseña?</a>
                </div>

                <div class="access-note">
                    <span class="note-icon"><i class="ri-shield-check-line" aria-hidden="true"></i></span>
                    <span>Acceso reservado a usuarios autorizados del Sistema Nacional de Información Energética.</span>
                </div>
            </section>
        </main>

        <script>
                function togglePassword() {
                    const passwordInput = document.getElementById("Clave");
                    const passwordIcon = document.getElementById("iconoClave");
                    const isPassword = passwordInput.type === "password";

                    passwordInput.type = isPassword ? "text" : "password";
                    passwordIcon.className = isPassword ? "ri-eye-off-line" : "ri-eye-line";
                }
        </script>
        <script src="https://cdnjs.cloudflare.com/ajax/libs/animejs/3.2.1/anime.min.js" defer></script>
        <script src="~/js/acceso-animations.js" asp-append-version="true" defer></script>
        <script src="~/js/validacion-formulario.js" asp-append-version="true"></script>
    </body>

</html>
