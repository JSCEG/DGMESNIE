@{
    ViewData["Title"] = "Acceso al Sistema Nacional de Información Energética";
    Layout = null;
    var cdn = "https://cdn.sassoapps.com";
}

<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"]</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css">
    <style>
        :root {
            color-scheme: light;
        }

        body {
            min-height: 100vh;
            margin: 0;
            font-family: "Segoe UI", Tahoma, Geneva, Verdana, sans-serif;
            background: linear-gradient(135deg, #691c32 0%, #8c2f4d 45%, #f5f1ea 45%, #f5f1ea 100%);
            display: flex;
            align-items: center;
            justify-content: center;
            padding: 24px;
        }

        .login-shell {
            width: 100%;
            max-width: 420px;
        }

        .login-card {
            background: rgba(255, 255, 255, 0.98);
            border: 0;
            border-radius: 24px;
            box-shadow: 0 24px 60px rgba(55, 24, 34, 0.22);
            overflow: hidden;
        }

        .login-card-body {
            padding: 40px 32px 32px;
        }

        .login-brand {
            width: 88px;
            height: auto;
        }

        .login-title {
            color: #691c32;
            font-size: 1.55rem;
            font-weight: 700;
            margin-bottom: 0.5rem;
        }

        .login-subtitle {
            color: #5f6368;
            font-size: 0.95rem;
            margin-bottom: 1.75rem;
        }

        .form-label {
            color: #3c4043;
            font-weight: 600;
            margin-bottom: 0.5rem;
        }

        .input-group-text {
            background: #fff;
            border-right: 0;
            color: #691c32;
        }

        .form-control {
            border-left: 0;
            min-height: 48px;
        }

        .form-control:focus {
            border-color: #ced4da;
            box-shadow: 0 0 0 0.2rem rgba(105, 28, 50, 0.12);
        }

        .toggle-password {
            cursor: pointer;
        }

        .login-alert {
            border-radius: 14px;
            padding: 0.9rem 1rem;
            margin-bottom: 1rem;
            font-size: 0.95rem;
        }

        .login-alert-danger {
            background: #fce8ea;
            color: #842029;
        }

        .login-submit {
            min-height: 48px;
            border: 0;
            border-radius: 14px;
            background: #691c32;
            color: #fff;
            font-weight: 600;
        }

        .login-submit:hover {
            background: #541628;
        }

        .login-links {
            text-align: center;
            margin-top: 1rem;
            font-size: 0.92rem;
        }

        .login-links a {
            color: #691c32;
            text-decoration: none;
        }

        .login-links a:hover {
            text-decoration: underline;
        }

        @@media (max-width: 576px) {
            body {
                background: #f5f1ea;
                padding: 16px;
            }

            .login-card-body {
                padding: 32px 24px 24px;
            }
        }
    </style>
</head>
<body>
    <main class="login-shell">
        <div class="card login-card">
            <div class="login-card-body">
                <div class="text-center mb-4">
                    <img src="@cdn/img_snier/login/logo_snier.png" alt="SNIER" class="login-brand mb-3">
                    <h1 class="login-title">Iniciar sesión</h1>
                    <p class="login-subtitle">Ingresa con tu correo electrónico o RFC y tu contraseña.</p>
                </div>

                <form action="@Url.Action("Login", "Acceso")" method="post">
                    <div class="mb-3">
                        <label class="form-label" for="Correo">Correo electrónico o RFC</label>
                        <div class="input-group">
                            <span class="input-group-text"><i class="bi bi-person-fill"></i></span>
                            <input type="text" class="form-control" id="Correo" name="Correo" placeholder="usuario@dominio.gob.mx" />
                        </div>
                    </div>

                    <div class="mb-3">
                        <label class="form-label" for="Clave">Contraseña</label>
                        <div class="input-group">
                            <span class="input-group-text"><i class="bi bi-lock-fill"></i></span>
                            <input type="password" class="form-control" id="Clave" name="Clave" placeholder="Ingresa tu contraseña" />
                            <span class="input-group-text toggle-password" onclick="togglePassword()">
                                <i class="bi bi-eye-fill" id="iconoClave"></i>
                            </span>
                        </div>
                    </div>

                    @if (ViewData["Mensaje"] != null)
                    {
                        <div class="login-alert login-alert-danger text-center">
                            <i class="bi bi-exclamation-circle me-2"></i>@ViewData["Mensaje"]
                        </div>
                    }

                    <div class="d-grid">
                        <button type="submit" class="login-submit">
                            <i class="bi bi-box-arrow-in-right me-2"></i>Iniciar sesión
                        </button>
                    </div>
                </form>

                <div class="login-links">
                    <a href="@Url.Action("ForgotPassword", "Acceso")">¿Olvidaste tu contraseña?</a>
                </div>
            </div>
        </div>
    </main>

    <script>
        function togglePassword() {
            const passwordInput = document.getElementById("Clave");
            const passwordIcon = document.getElementById("iconoClave");
            const isPassword = passwordInput.type === "password";

            passwordInput.type = isPassword ? "text" : "password";
            passwordIcon.className = isPassword ? "bi bi-eye-slash-fill" : "bi bi-eye-fill";
        }
    </script>
</body>
</html>
