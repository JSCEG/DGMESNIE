@{
    Layout = null;
    var cdn = "https://cdn.sassoapps.com";
}

<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <title>Sesión Expirada | SNIER</title>
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta name="description" content="Sistema Nacional de Información Energética - Sesión expirada">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/remixicon@4.3.0/fonts/remixicon.css">
    <link rel="stylesheet" href="~/css/acceso-login.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/acceso-sesion-expirada.css" asp-append-version="true" />
</head>
<body class="expired-page-shell">
    <main class="expired-page">
        <section class="brand-side expired-brand-side" aria-label="Identidad institucional">
            <div class="institutional-logos">
                <img src="@cdn/dgmesnie/logo_gob.png" alt="Gobierno de México">
                <span class="logo-separator" aria-hidden="true"></span>
                <img src="@cdn/dgmesnie/logo_sener.png" alt="Secretaría de Energía">
            </div>

            <div class="brand-content">
                <div class="brand-kicker">Dirección General de Metodologías y Estadísticas del Sistema Nacional de Información de Energía</div>
                <h1 class="brand-title">Sesión<br>expirada</h1>
                <div class="title-rule"></div>
                <p class="brand-text">
                    Por seguridad, el acceso institucional se cierra automáticamente después de un periodo de inactividad.
                </p>

                <div class="feature-list">
                    <div class="feature-item">
                        <div class="feature-icon">
                            <i class="ri-time-line" aria-hidden="true"></i>
                        </div>
                        <div>
                            <strong>Tiempo controlado</strong>
                            <span>Las sesiones activas se supervisan para reducir riesgos sobre la información.</span>
                        </div>
                    </div>
                    <div class="feature-item">
                        <div class="feature-icon">
                            <i class="ri-shield-keyhole-line" aria-hidden="true"></i>
                        </div>
                        <div>
                            <strong>Protección institucional</strong>
                            <span>El cierre automático evita accesos prolongados sin supervisión del usuario.</span>
                        </div>
                    </div>
                    <div class="feature-item">
                        <div class="feature-icon">
                            <i class="ri-login-circle-line" aria-hidden="true"></i>
                        </div>
                        <div>
                            <strong>Reingreso inmediato</strong>
                            <span>Puedes volver a autenticarte para continuar trabajando en el sistema.</span>
                        </div>
                    </div>
                </div>
            </div>
        </section>

        <section class="auth-panel expired-panel" aria-label="Aviso de sesión expirada">
            <div class="lock-badge expired-badge">
                <i class="ri-timer-flash-line" aria-hidden="true"></i>
            </div>

            <h1 class="login-title expired-title">Sesión expirada</h1>
            <p class="login-subtitle expired-subtitle">
                Tu sesión se cerró por inactividad. Vuelve a iniciar sesión para continuar.
            </p>

            <div class="expired-alert expired-alert-danger">
                <div class="expired-alert__icon">
                    <i class="ri-error-warning-line" aria-hidden="true"></i>
                </div>
                <div>
                    <strong>Tu sesión ha expirado por inactividad</strong>
                    <span>Por motivos de seguridad, las sesiones se cierran automáticamente después de 30 minutos sin actividad.</span>
                </div>
            </div>

            <a href="@Url.Action("Login", "Acceso")" class="login-submit expired-submit-link">
                <span class="login-submit__content">
                    <i class="ri-login-box-line" aria-hidden="true"></i>
                    <span>Volver a iniciar sesión</span>
                </span>
            </a>

            <div class="expired-alert expired-alert-warning">
                <div class="expired-alert__icon">
                    <i class="ri-information-line" aria-hidden="true"></i>
                </div>
                <div>
                    <strong>¿Problemas para acceder?</strong>
                    <span>Si el problema persiste, contacta al soporte técnico del sistema institucional.</span>
                </div>
            </div>

            <div class="access-note expired-note">
                <span class="note-icon"><i class="ri-time-line" aria-hidden="true"></i></span>
                <span>
                    Serás redirigido automáticamente en
                    <strong id="cuentaRegresiva">8</strong>
                    segundos.
                </span>
            </div>
        </section>
    </main>

    <script>
        let segundos = 8;
        const contador = document.getElementById("cuentaRegresiva");

        const intervalo = setInterval(() => {
            segundos--;
            contador.textContent = segundos;

            if (segundos <= 0) {
                clearInterval(intervalo);
                window.location.href = '@Url.Action("Login", "Acceso")';
            }
        }, 1000);

        document.addEventListener("keydown", function (e) {
            if (e.key === "Escape") {
                clearInterval(intervalo);
                contador.textContent = "pausada";
            }
        });
    </script>
</body>
</html>
