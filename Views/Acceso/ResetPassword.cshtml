@{
    Layout = null;
    var cdn = "https://cdn.sassoapps.com";
    var esExitoso = ViewData["EsExitoso"] != null && (bool)ViewData["EsExitoso"];
    var token = ViewData["Token"]?.ToString();
    if (string.IsNullOrWhiteSpace(token) && Context?.Request?.Form.ContainsKey("Token") == true)
    {
        token = Context.Request.Form["Token"].ToString();
    }
}

<!DOCTYPE html>
<html lang="es">

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Nueva Contraseña | SNIER</title>
    <meta name="description" content="Sistema Nacional de Información Energética - Restablecimiento de contraseña">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/remixicon@4.3.0/fonts/remixicon.css">
    <link rel="stylesheet" href="~/css/acceso-login.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/acceso-recuperacion.css" asp-append-version="true" />
</head>

<body class="recovery-shell-page">
    <main class="recovery-page">
        <section class="brand-side recovery-brand-side" aria-label="Identidad institucional">
            <div class="institutional-logos">
                <img src="@cdn/dgmesnie/logo_gob.png" alt="Gobierno de México">
                <span class="logo-separator" aria-hidden="true"></span>
                <img src="@cdn/dgmesnie/logo_sener.png" alt="Secretaría de Energía">
            </div>

            <div class="brand-content">
                <div class="brand-kicker">Dirección General de Metodologías y Estadísticas del Sistema Nacional de
                    Información de Energía</div>
                    <h1 class="brand-title">Actualización de contraseña</h1>
                    <div class="title-rule"></div>
                    <p class="brand-text">
                        Define una nueva contraseña para continuar con acceso seguro al Sistema Nacional de Información
                        Energética.
                    </p>

                    <div class="feature-list">
                        <div class="feature-item">
                            <div class="feature-icon">
                                <i class="ri-lock-password-line" aria-hidden="true"></i>
                            </div>
                            <div>
                                <strong>Enlace único</strong>
                                <span>El restablecimiento está vinculado al token enviado al correo institucional.</span>
                            </div>
                        </div>
                        <div class="feature-item">
                            <div class="feature-icon">
                                <i class="ri-timer-line" aria-hidden="true"></i>
                            </div>
                            <div>
                                <strong>Vigencia controlada</strong>
                                <span>Por seguridad, el enlace tiene una duración limitada.</span>
                            </div>
                        </div>
                        <div class="feature-item">
                            <div class="feature-icon">
                                <i class="ri-shield-keyhole-line" aria-hidden="true"></i>
                            </div>
                            <div>
                                <strong>Protección institucional</strong>
                                <span>El acceso se resguarda con validaciones y políticas de seguridad activas.</span>
                            </div>
                        </div>
                    </div>
                </div>
            </section>

            <section class="auth-panel recovery-panel" aria-label="Formulario de nueva contraseña">
                <div class="lock-badge recovery-badge">
                    <i class="@(esExitoso ? "ri-checkbox-circle-line" : "ri-lock-password-line")" aria-hidden="true"></i>
                </div>

                <h1 class="login-title recovery-title">¡Restablezca su contraseña!</h1>
                <p class="login-subtitle recovery-subtitle">
                    @(esExitoso
                        ? "Tu contraseña ya fue actualizada. Inicia sesión con tu nueva clave."
                        : "Ingresa y confirma tu nueva contraseña para finalizar el proceso.")
                </p>

                @if (!esExitoso)
                {
                    <form id="resetPasswordForm" action="@Url.Action("ResetPassword", "Acceso")" method="post" class="login-form">
                        <input type="hidden" name="Token" value="@token" />

                        <div class="mb-3">
                            <label for="Clave" class="form-label">Nueva contraseña</label>
                            <div class="login-input password-input">
                                <span class="input-icon"><i class="ri-lock-2-line" aria-hidden="true"></i></span>
                                <input id="Clave" type="password" name="Clave" class="form-control"
                                       placeholder="Ingresa tu nueva contraseña" required autocomplete="new-password">
                                <button type="button" class="toggle-password" data-target="Clave"
                                        aria-label="Mostrar contraseña nueva">
                                    <i class="ri-eye-line" aria-hidden="true"></i>
                                </button>
                            </div>
                        </div>

                        <div class="mb-3">
                            <label for="ConfirmarClave" class="form-label">Confirmar contraseña</label>
                            <div class="login-input password-input">
                                <span class="input-icon"><i class="ri-lock-password-line" aria-hidden="true"></i></span>
                                <input id="ConfirmarClave" type="password" name="ConfirmarClave" class="form-control"
                                       placeholder="Confirma tu nueva contraseña" required autocomplete="new-password">
                                <button type="button" class="toggle-password" data-target="ConfirmarClave"
                                        aria-label="Mostrar confirmación de contraseña">
                                    <i class="ri-eye-line" aria-hidden="true"></i>
                                </button>
                            </div>
                        </div>

                        @if (string.IsNullOrWhiteSpace(token))
                        {
                            <div class="login-alert text-center">
                                <i class="ri-error-warning-line me-2" aria-hidden="true"></i>No se encontró un token válido para
                                restablecer la contraseña.
                            </div>
                        }
                        else if (ViewData["Mensaje"] != null)
                        {
                            <div class="login-alert text-center">
                                <i class="ri-error-warning-line me-2" aria-hidden="true"></i>@ViewData["Mensaje"]
                            </div>
                        }

                        <button id="resetPasswordSubmit" type="submit" class="login-submit recovery-submit" @(string.IsNullOrWhiteSpace(token) ?
                                         "disabled" : "")>
                            <span class="login-submit__content">
                                <i class="ri-key-2-line" aria-hidden="true"></i>
                                <span id="resetPasswordSubmitText">Restablecer contraseña</span>
                            </span>
                        </button>

                        <div id="resetPasswordStatus" class="login-alert text-center mt-3" style="display:none;">
                            <i class="ri-loader-4-line me-2" aria-hidden="true"></i>
                            Estamos aplicando el cambio y enviando confirmación, por favor espera...
                        </div>
                    </form>

                    <div class="login-links recovery-links">
                        <a href="@Url.Action("Login", "Acceso")">
                            <i class="ri-arrow-left-line me-1" aria-hidden="true"></i>Volver al inicio de sesión
                        </a>
                    </div>
                }
                else
                {
                    <div class="recovery-success">
                        <div class="recovery-success__icon">
                            <i class="ri-checkbox-circle-line" aria-hidden="true"></i>
                        </div>
                        <div class="recovery-success__message">@ViewData["Mensaje"]</div>
                    </div>

                    <a href="@Url.Action("Login", "Acceso")" class="login-submit recovery-submit recovery-submit-link">
                        <span class="login-submit__content">
                            <i class="ri-arrow-left-line" aria-hidden="true"></i>
                            <span>Volver al inicio de sesión</span>
                        </span>
                    </a>
                }

                <div class="access-note recovery-note">
                    <span class="note-icon"><i class="ri-time-line" aria-hidden="true"></i></span>
                    <span>Por seguridad, el enlace de restablecimiento tiene vigencia limitada.</span>
                </div>
            </section>
        </main>

        <script>
                document.querySelectorAll('.toggle-password').forEach(function (button) {
                    button.addEventListener('click', function () {
                        var targetId = button.getAttribute('data-target');
                        var input = document.getElementById(targetId);
                        var icon = button.querySelector('i');

                        if (!input || !icon) {
                            return;
                        }

                        var showing = input.type === 'text';
                        input.type = showing ? 'password' : 'text';
                        icon.className = showing ? 'ri-eye-line' : 'ri-eye-off-line';
                    });
                });

                var resetForm = document.getElementById('resetPasswordForm');
                var resetSubmit = document.getElementById('resetPasswordSubmit');
                var resetSubmitText = document.getElementById('resetPasswordSubmitText');
                var resetStatus = document.getElementById('resetPasswordStatus');

                if (resetForm && resetSubmit && resetSubmitText && resetStatus) {
                    resetForm.addEventListener('submit', function () {
                        console.log('[ResetPassword] Iniciando actualizacion de contrasena y envio de correo de confirmacion...');
                        resetSubmit.disabled = true;
                        resetSubmit.setAttribute('aria-disabled', 'true');
                        resetSubmitText.textContent = 'Procesando...';
                        resetStatus.style.display = 'block';
                    });
                }
        </script>
        <script src="https://cdnjs.cloudflare.com/ajax/libs/animejs/3.2.1/anime.min.js" defer></script>
        <script src="~/js/acceso-animations.js" asp-append-version="true" defer></script>
    </body>

</html>