@{
    ViewData["Title"] = "Actividad sospechosa detectada";
    Layout = null;
    var cdn = "https://cdn.sassoapps.com";
}

<!DOCTYPE html>
<html lang="es">

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"]</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/remixicon@4.3.0/fonts/remixicon.css">
    <link rel="stylesheet" href="~/css/acceso-login.css" asp-append-version="true" />
</head>

<body class="login-shell suspicious-shell">
    <main class="login-page suspicious-page">
        <section class="brand-side" aria-label="Contexto institucional de seguridad">
            <div class="institutional-logos">
                <img src="@cdn/dgmesnie/logo_gob.png" alt="Gobierno de México">
                <span class="logo-separator" aria-hidden="true"></span>
                <img src="@cdn/dgmesnie/logo_sener.png" alt="Secretaría de Energía">
            </div>

            <div class="brand-content">
                <div class="brand-kicker">Protección preventiva del acceso institucional</div>
                <h1 class="brand-title">Actividad<br>Sospechosa</h1>
                <div class="title-rule"></div>
                <p class="brand-text">
                    Detectamos un patrón de entrada no permitido y bloqueamos la solicitud antes de procesarla para
                    proteger el acceso y la integridad del sistema.
                </p>

                <div class="feature-list">
                    <div class="feature-item">
                        <div class="feature-icon">
                            <i class="ri-shield-flash-line" aria-hidden="true"></i>
                        </div>
                        <div>
                            <strong>Bloqueo preventivo</strong>
                            <span>Se detuvo la solicitud antes de que pudiera ejecutarse dentro del sistema.</span>
                        </div>
                    </div>
                    <div class="feature-item">
                        <div class="feature-icon">
                            <i class="ri-file-warning-line" aria-hidden="true"></i>
                        </div>
                        <div>
                            <strong>Patrón no permitido</strong>
                            <span>El contenido capturado coincide con reglas de protección contra XSS e
                                inyección.</span>
                            </div>
                        </div>
                        <div class="feature-item">
                            <div class="feature-icon">
                                <i class="ri-restart-line" aria-hidden="true"></i>
                            </div>
                            <div>
                                <strong>Reintento seguro</strong>
                                <span>Corrige el contenido del campo y vuelve a iniciar sesión desde el acceso
                                    principal.</span>
                                </div>
                            </div>
                        </div>
                    </div>
                </section>

                <section class="auth-panel auth-panel--alert" aria-label="Aviso de seguridad">
                    <div class="lock-badge lock-badge--danger">
                        <i class="ri-alarm-warning-line" aria-hidden="true"></i>
                    </div>

                    <h2 class="login-title">Acceso bloqueado temporalmente</h2>
                    <p class="login-subtitle">Tu solicitud fue detenida porque contenía una secuencia potencialmente maliciosa.
                    </p>

                    <div class="security-alert-card">
                        <div class="security-alert-card__header">
                            <i class="ri-shield-keyhole-line" aria-hidden="true"></i>
                            <strong>¿Qué ocurrió?</strong>
                        </div>
                        <p class="security-alert-card__text">
                            Por motivos de seguridad, el sistema bloqueó la operación y te redirigió a esta pantalla de
                            resguardo.
                        </p>
                        <ul class="security-alert-list">
                            <li>No se procesó el contenido enviado.</li>
                            <li>Evita etiquetas HTML, scripts o expresiones no válidas en los campos.</li>
                            <li>Si el bloqueo fue un error, repite el intento con texto limpio.</li>
                        </ul>
                    </div>

                    <div class="security-countdown">
                        Redirigiendo al inicio de sesión en <span id="cuentaRegresiva">10</span> segundos.
                    </div>

                    <a class="login-submit security-submit" href="@Url.Action("Login", "Acceso")">
                        <span class="login-submit__content">
                            <i class="ri-arrow-left-line" aria-hidden="true"></i>
                            <span>Volver ahora</span>
                        </span>
                    </a>

                    <div class="access-note">
                        <span class="note-icon"><i class="ri-shield-check-line" aria-hidden="true"></i></span>
                        <span>Esta validación forma parte de la protección del acceso institucional del Sistema Nacional de
                            Información Energética.</span>
                        </div>
                    </section>
                </main>

                <script>
                        let segundos = 10;
                        const contadorElemento = document.getElementById("cuentaRegresiva");

                        const cuentaAtras = setInterval(() => {
                            segundos--;
                            contadorElemento.textContent = segundos;
                            if (segundos <= 0) {
                                clearInterval(cuentaAtras);
                                window.location.href = '@Url.Action("Login", "Acceso")';
                            }
                        }, 1000);
                </script>
            </body>

        </html>
