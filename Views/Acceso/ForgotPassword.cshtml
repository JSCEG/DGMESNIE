@{
    Layout = null;
    var cdn = "https://cdn.sassoapps.com";
    var esExitoso = ViewData["EsExitoso"] != null && (bool)ViewData["EsExitoso"];
}

<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Restablecer Contraseña | SNIER</title>
    <meta name="description" content="Sistema Nacional de Información Energética - Restablecimiento de contraseña">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/remixicon@4.3.0/fonts/remixicon.css">
    <link rel="stylesheet" href="~/css/acceso-login.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/acceso-recuperacion.css" asp-append-version="true" />
</head>
<body class="recovery-shell-page">
    <main class="recovery-page">
        <section class="brand-side recovery-brand-side" aria-label="Identidad institucional">
            <div class="institutional-logos">
                <img src="@cdn/dgmesnie/logo_gob.png" alt="Gobierno de México">
                <span class="logo-separator" aria-hidden="true"></span>
                <img src="@cdn/dgmesnie/logo_sener.png" alt="Secretaría de Energía">
            </div>

            <div class="brand-content">
                <div class="brand-kicker">Dirección General de Metodologías y Estadísticas del Sistema Nacional de Información de Energía</div>
                <h1 class="brand-title">Recuperación de contraseña</h1>
                <div class="title-rule"></div>
                <p class="brand-text">
                    Restablece el acceso a tu cuenta institucional mediante un enlace de verificación enviado a tu correo registrado.
                </p>

                <div class="feature-list">
                    <div class="feature-item">
                        <div class="feature-icon">
                            <i class="ri-mail-send-line" aria-hidden="true"></i>
                        </div>
                        <div>
                            <strong>Envío seguro</strong>
                            <span>Las instrucciones llegan al correo asociado a tu cuenta autorizada.</span>
                        </div>
                    </div>
                    <div class="feature-item">
                        <div class="feature-icon">
                            <i class="ri-time-line" aria-hidden="true"></i>
                        </div>
                        <div>
                            <strong>Vigencia limitada</strong>
                            <span>El enlace de recuperación permanece activo solo por un periodo controlado.</span>
                        </div>
                    </div>
                    <div class="feature-item">
                        <div class="feature-icon">
                            <i class="ri-shield-keyhole-line" aria-hidden="true"></i>
                        </div>
                        <div>
                            <strong>Control institucional</strong>
                            <span>El proceso protege el acceso a la información estratégica del sistema.</span>
                        </div>
                    </div>
                </div>
            </div>
        </section>

        <section class="auth-panel recovery-panel" aria-label="Recuperación de contraseña">
            <div class="lock-badge recovery-badge">
                <i class="@(esExitoso ? "ri-mail-check-line" : "ri-lock-password-line")" aria-hidden="true"></i>
            </div>

            <h1 class="login-title recovery-title">Restablecer contraseña</h1>
            <p class="login-subtitle recovery-subtitle">
                @(esExitoso
                    ? "Revisa tu bandeja de entrada y sigue las instrucciones para crear una nueva contraseña."
                    : "Ingresa el correo electrónico asociado a tu cuenta para recibir instrucciones.")
            </p>

            @if (!esExitoso)
            {
                <form method="post" action="@Url.Action("ForgotPassword", "Acceso")" class="login-form">
                    <div class="mb-3">
                        <label for="Correo" class="form-label">Correo electrónico</label>
                        <div class="login-input">
                            <span class="input-icon"><i class="ri-mail-line" aria-hidden="true"></i></span>
                            <input id="Correo" type="email" name="Correo" class="form-control"
                                   placeholder="usuario@dominio.gob.mx" required autocomplete="email">
                        </div>
                    </div>

                    @if (ViewData["Mensaje"] != null)
                    {
                        <div class="login-alert text-center">
                            <i class="ri-error-warning-line me-2" aria-hidden="true"></i>@ViewData["Mensaje"]
                        </div>
                    }

                    <button type="submit" class="login-submit recovery-submit">
                        <span class="login-submit__content">
                            <i class="ri-send-plane-line" aria-hidden="true"></i>
                            <span>Enviar instrucciones</span>
                        </span>
                    </button>
                </form>

                <div class="login-links recovery-links">
                    <a href="@Url.Action("Login", "Acceso")">
                        <i class="ri-arrow-left-line me-1" aria-hidden="true"></i>Volver al inicio de sesión
                    </a>
                </div>
            }
            else
            {
                <div class="recovery-success">
                    <div class="recovery-success__icon">
                        <i class="ri-checkbox-circle-line" aria-hidden="true"></i>
                    </div>
                    <div class="recovery-success__message">@ViewData["Mensaje"]</div>
                </div>

                <a href="@Url.Action("Login", "Acceso")" class="login-submit recovery-submit recovery-submit-link">
                    <span class="login-submit__content">
                        <i class="ri-arrow-left-line" aria-hidden="true"></i>
                        <span>Volver al inicio de sesión</span>
                    </span>
                </a>
            }

            <div class="access-note recovery-note">
                <span class="note-icon"><i class="ri-time-line" aria-hidden="true"></i></span>
                <span>Por seguridad, el enlace de recuperación solo será válido por tiempo limitado.</span>
            </div>
        </section>
    </main>
</body>
</html>
