@using NSIE.Models
@using Microsoft.AspNetCore.Antiforgery
@inject IAntiforgery AntiforgeryService
@{
    ViewData["Title"] = "Gestor de Actividades";
    var header = ViewData["HeaderViewModel"] as HeaderViewModel;
    var csrfToken = AntiforgeryService.GetAndStoreTokens(Context).RequestToken;
}

@section Styles {
    <meta name="csrf-token" content="@csrfToken">
    <link rel="stylesheet" href="~/gestor/css/gestor.css" asp-append-version="true">
}

@Html.AntiForgeryToken()

<div class="gestor-page__view-header">
    @if (header != null)
    {
        @await Html.PartialAsync("_ViewHeader", header)
    }
</div>

<div id="tracking-preloader" class="tracking-preloader" role="status" aria-live="polite">
    <div class="tracking-preloader__card">
        <div class="tracking-preloader__brand">
            <img src="https://cdn.sassoapps.com/dgmesnie/logo_gob.png" alt="Gobierno de México">
            <span aria-hidden="true"></span>
            <img src="https://cdn.sassoapps.com/dgmesnie/logo_sener.png" alt="Secretaría de Energía">
        </div>
        <div class="tracking-preloader__spinner" aria-hidden="true"></div>
        <p class="tracking-preloader__title" id="tracking-preloader-title">Cargando seguimiento de actividades</p>
        <p class="tracking-preloader__sub" id="tracking-preloader-sub">Conectando con la base de datos…</p>
    </div>
</div>

<nav class="gestor-nav">
    <div class="gestor-shell gestor-nav__inner" role="tablist">
        <button class="gestor-tab active" data-view="dashboard">Dashboard</button>
        <button class="gestor-tab" data-view="temas">Temas</button>
        <button class="gestor-tab" data-view="tabla">Actividades por Tema</button>
        <button class="gestor-tab" data-view="calendario">Calendario</button>
        <button class="gestor-tab" data-view="gantt">Gantt</button>
        <button class="gestor-tab" data-view="kanban">Kanban</button>
        <button class="gestor-tab" data-view="responsables">Responsables</button>
        <button class="gestor-tab" data-view="alertas">Alertas <span class="badge" id="badge-alertas">0</span></button>
        <button class="gestor-tab" data-view="reportes">Reportes</button>
    </div>
</nav>

<div id="source-label" class="gestor-source" style="display:none">Base de datos NSIE</div>

<nav aria-label="breadcrumb" class="gestor-breadcrumbs">
    <ol class="breadcrumb">
        <li class="breadcrumb-item"><a href="@Url.Action("Index", "Home")">Inicio</a></li>
        <li class="breadcrumb-item active" aria-current="page">@ViewData["Title"]</li>
    </ol>
</nav>

<div class="gestor-shell global-filter-bar mb-3">
    <div class="panel py-2 px-3 d-flex align-items-center justify-content-between flex-wrap gap-2" style="border-radius: 12px; border: 1px solid rgba(138, 0, 49, 0.08); background: #ffffff;">
        <div class="d-flex align-items-center gap-2">
            <i class="fa-solid fa-calendar-days text-muted" style="color: var(--guinda) !important;"></i>
            <span style="font-size: 0.85rem; font-weight: 700; color: var(--texto);">Filtrar rango de fechas (Compromiso):</span>
        </div>
        <div class="d-flex align-items-center gap-2 flex-wrap">
            <label class="mb-0" style="font-size: 0.78rem; font-weight: 600; color: var(--texto-suave);">Desde:</label>
            <input type="date" id="filtro-global-desde" class="gestor-search" style="height: 32px; padding: 0.2rem 0.5rem; font-size: 0.8rem; width: 135px; border-radius: 8px;" />
            <label class="mb-0" style="font-size: 0.78rem; font-weight: 600; color: var(--texto-suave);">Hasta:</label>
            <input type="date" id="filtro-global-hasta" class="gestor-search" style="height: 32px; padding: 0.2rem 0.5rem; font-size: 0.8rem; width: 135px; border-radius: 8px;" />
            <button type="button" id="btn-limpiar-fechas" class="internal-button" style="min-height: 32px; padding: 0.2rem 0.6rem; font-size: 0.78rem; border-radius: 8px;">Limpiar</button>
        </div>
    </div>
</div>

<main class="gestor-shell internal-main">

    <section id="view-dashboard" class="gestor-view active gestor-dashboard">
        <div class="dashboard-kpis">
            <article class="dashboard-kpi-card">
                <span>Temas activos</span>
                <strong id="kpi-temas">0</strong>
                <small>de la Dirección</small>
            </article>
            <article class="dashboard-kpi-card">
                <span>Actividades</span>
                <strong id="kpi-actividades">0</strong>
                <small>registradas</small>
            </article>
            <article class="dashboard-kpi-card dashboard-kpi-card--ok">
                <span>Concluidas</span>
                <strong id="kpi-concluidas">0</strong>
                <small>cerradas</small>
            </article>
            <article class="dashboard-kpi-card dashboard-kpi-card--warning">
                <span>Por vencer (7d)</span>
                <strong id="kpi-por-vencer">0</strong>
                <small>próximas</small>
            </article>
            <article class="dashboard-kpi-card dashboard-kpi-card--risk">
                <span>Vencidas</span>
                <strong id="kpi-vencidas">0</strong>
                <small>requieren atención</small>
            </article>
            <article class="dashboard-kpi-card dashboard-kpi-card--gold">
                <span>Avance global</span>
                <strong id="kpi-avance">0%</strong>
                <small>promedio</small>
            </article>
        </div>

        <div class="dashboard-charts dashboard-charts--primary charts-grid">
            <section class="panel dashboard-panel dashboard-panel--chart">
                <header>
                    <div>
                        <h2>Estatus</h2>
                        <span>Distribución general de actividades</span>
                    </div>
                    <div class="dashboard-panel__actions">
                        <button type="button" class="chart-fullscreen-btn"
                                data-chart-fullscreen="chart-donut-estatus">Vista completa</button>
                    </div>
                </header>
                <div class="chart-box" id="chart-donut-estatus"></div>
            </section>
            <section class="panel dashboard-panel dashboard-panel--chart">
                <header>
                    <div>
                        <h2>Avance global</h2>
                        <span>Porcentaje promedio del portafolio</span>
                    </div>
                    <div class="dashboard-panel__actions">
                        <button type="button" class="chart-fullscreen-btn"
                                data-chart-fullscreen="chart-gauge-avance">Vista completa</button>
                    </div>
                </header>
                <div class="chart-box" id="chart-gauge-avance"></div>
            </section>
            <section class="panel dashboard-panel dashboard-panel--chart">
                <header>
                    <div>
                        <h2>Prioridad</h2>
                        <span>Balance de carga por criticidad</span>
                    </div>
                    <div class="dashboard-panel__actions">
                        <button type="button" class="chart-fullscreen-btn"
                                data-chart-fullscreen="chart-pie-prioridad">Vista completa</button>
                    </div>
                </header>
                <div class="chart-box" id="chart-pie-prioridad"></div>
            </section>
        </div>

        <div class="dashboard-charts charts-grid charts-grid--2">
            <section class="panel dashboard-panel dashboard-panel--chart">
                <header>
                    <div>
                        <h2>Carga por responsable</h2>
                        <span>Actividades activas por persona</span>
                    </div>
                    <div class="dashboard-panel__actions">
                        <button type="button" class="chart-fullscreen-btn"
                                data-chart-fullscreen="chart-barras-responsables">Vista completa</button>
                    </div>
                </header>
                <div class="chart-box" id="chart-barras-responsables"></div>
            </section>
            <section class="panel dashboard-panel dashboard-panel--chart">
                <header>
                    <div>
                        <h2>Distribución por tema</h2>
                        <span>Estatus apilado por línea de trabajo</span>
                    </div>
                    <div class="dashboard-panel__actions">
                        <button type="button" class="chart-fullscreen-btn"
                                data-chart-fullscreen="chart-stacked-temas">Vista completa</button>
                    </div>
                </header>
                <div class="chart-box" id="chart-stacked-temas"></div>
            </section>
        </div>

        <section class="panel panel--table dashboard-critical-panel">
            <header class="dashboard-critical-panel__header">
                <div>
                    <h2>Temas críticos</h2>
                    <span>Semáforo institucional de seguimiento</span>
                </div>
                <p>Prioriza los asuntos con vencimiento comprometido o bajo presión operativa.</p>
            </header>
            <div class="table-wrap dashboard-critical-table">
                <table id="tbl-criticos">
                    <thead>
                        <tr>
                            <th>Tema</th>
                            <th>Responsable</th>
                            <th>Avance</th>
                            <th>Compromiso</th>
                            <th>Estado</th>
                        </tr>
                    </thead>
                    <tbody></tbody>
                </table>
            </div>
        </section>
    </section>

    <section id="view-temas" class="gestor-view">
        <div class="internal-title">
            <div>
                <p>Catálogo</p>
                <h1>Temas</h1>
            </div>
            <div class="internal-actions">
                <input type="search" id="filtro-temas" class="gestor-search" placeholder="Buscar tema, responsable…">
                <button class="internal-button internal-button--primary" id="btn-nuevo-tema">+ Nuevo tema</button>
            </div>
        </div>
        <div class="cards-grid" id="cards-temas"></div>
    </section>

    <section id="view-tabla" class="gestor-view">
        <div class="internal-title">
            <div>
                <p>Detalle</p>
                <h1>Actividades por Tema</h1>
            </div>
            <div class="internal-actions tabla-actions">
                <button class="internal-button" id="btn-export-excel">Exportar CSV</button>
                <button class="internal-button internal-button--primary" id="btn-nueva-actividad">+ Nueva
                    actividad</button>
                </div>
            </div>

            <section class="tabla-toolbar" aria-label="Filtros de actividades">
                <input type="search" id="filtro-tabla" class="gestor-search" placeholder="Buscar actividad...">
                <select id="filtro-tabla-tema" class="gestor-search" aria-label="Filtrar por tema">
                    <option value="">Tema</option>
                </select>
                <select id="filtro-tabla-estatus" class="gestor-search" aria-label="Filtrar por estatus">
                    <option value="">Estatus</option>
                    <option value="Pendiente">Pendiente</option>
                    <option value="En proceso">En proceso</option>
                    <option value="Concluida">Concluida</option>
                    <option value="Vencida">Vencida</option>
                </select>
                <select id="filtro-tabla-prioridad" class="gestor-search" aria-label="Filtrar por prioridad">
                    <option value="">Prioridad</option>
                    <option value="Alta">Alta</option>
                    <option value="Media">Media</option>
                    <option value="Baja">Baja</option>
                </select>
                <select id="filtro-tabla-responsable" class="gestor-search" aria-label="Filtrar por responsable">
                    <option value="">Responsable</option>
                </select>
            </section>

            <section class="tabla-layout">
                <div class="panel panel--table tabla-main">
                    <div class="table-wrap">
                        <table id="tbl-actividades">
                            <thead>
                                <tr>
                                    <th>Tema</th>
                                    <th>Actividad</th>
                                    <th>Responsable</th>
                                    <th>Inicio</th>
                                    <th>Compromiso</th>
                                    <th>Estatus</th>
                                    <th>Tiempo</th>
                                    <th>Avance</th>
                                    <th>Prioridad</th>
                                    <th>Estado</th>
                                    <th>Acciones</th>
                                </tr>
                            </thead>
                            <tbody></tbody>
                        </table>
                    </div>
                    <footer class="tabla-pagination" aria-label="Paginación de actividades">
                        <div class="tabla-pagination__meta">
                            <small id="tabla-pagination-info">Mostrando 0 a 0 de 0 actividades</small>
                            <label class="tabla-page-size" for="tabla-page-size">
                                <span>Por página</span>
                                <select id="tabla-page-size" class="gestor-search" aria-label="Actividades por página">
                                    <option value="8" selected>8</option>
                                    <option value="20">20</option>
                                    <option value="50">50</option>
                                    <option value="100">100</option>
                                </select>
                            </label>
                        </div>
                        <div class="tabla-pagination__actions">
                            <button type="button" class="internal-button" id="tabla-page-prev">Anterior</button>
                            <span id="tabla-page-current" class="page-info">1 / 1</span>
                            <button type="button" class="internal-button" id="tabla-page-next">Siguiente</button>
                        </div>
                    </footer>
                </div>
            </section>
        </section>

        <section id="view-calendario" class="gestor-view">
            <div class="internal-title">
                <div>
                    <p>Vencimientos</p>
                    <h1>Calendario</h1>
                </div>
                <div class="internal-actions cal-nav">
                    <button class="internal-button" id="cal-prev">‹</button>
                    <span id="cal-label" class="page-info"></span>
                    <button class="internal-button" id="cal-next">›</button>
                </div>
            </div>
            <section class="panel">
                <div class="calendar" id="calendar"></div>
            </section>
        </section>

        <section id="view-gantt" class="gestor-view">
            <div class="internal-title">
                <div>
                    <p>Cronograma</p>
                    <h1>Gantt</h1>
                </div>
            </div>
            <section class="panel">
                <div class="gantt-wrap" id="gantt-wrap"></div>
            </section>
        </section>

        <section id="view-kanban" class="gestor-view">
            <div class="internal-title">
                <div>
                    <p>Flujo</p>
                    <h1>Kanban de actividades</h1>
                </div>
                <div class="internal-actions">
                    <select id="filtro-kanban-tema" class="gestor-search">
                        <option value="">Todos los temas</option>
                    </select>
                </div>
            </div>
            <div class="kanban-board" id="kanban-board"></div>
        </section>

        <section id="view-responsables" class="gestor-view">
            <div class="internal-title">
                <div>
                    <p>Personas</p>
                    <h1>Vista por responsable</h1>
                </div>
            </div>
            <div class="responsables-grid" id="responsables-grid"></div>
        </section>

        <section id="view-alertas" class="gestor-view">
            <div class="internal-title">
                <div>
                    <p>Atención</p>
                    <h1>Alertas</h1>
                </div>
            </div>
            <div class="alertas-list" id="alertas-list"></div>
        </section>

        <section id="view-reportes" class="gestor-view">
            <div class="internal-title">
                <div>
                    <p>Salidas institucionales</p>
                    <h1>Reportes</h1><span>Vista previa estilo presentación · descarga PDF / PPT / Excel</span>
                </div>
                <div class="internal-actions">
                    <button type="button" class="internal-button" id="rep-refresh">Actualizar</button>
                    <button type="button" class="internal-button" id="rep-pdf">PDF</button>
                    <button type="button" class="internal-button internal-button--primary" id="rep-ppt">PPT</button>
                    <button type="button" class="internal-button" id="rep-excel">Excel</button>
                </div>
            </div>
            <section class="filter-panel" aria-label="Filtros del reporte">
                <label><span>Tema</span><select id="rep-filtro-tema">
                    <option value="">Todos</option>
                </select></label>
                <label><span>Responsable</span><select id="rep-filtro-resp">
                    <option value="">Todos</option>
                </select></label>
                <label><span>Estatus</span>
                    <select id="rep-filtro-estatus">
                        <option value="">Todos</option>
                        <option value="Pendiente">Pendiente</option>
                        <option value="En proceso">En proceso</option>
                        <option value="Vencida">Vencida</option>
                        <option value="Concluida">Concluida</option>
                    </select>
                </label>
                <label><span>Prioridad</span>
                    <select id="rep-filtro-prioridad">
                        <option value="">Todas</option>
                        <option>Alta</option>
                        <option>Media</option>
                        <option>Baja</option>
                    </select>
                </label>
                <label><span>Periodo</span>
                    <select id="rep-filtro-periodo">
                        <option value="">Todo</option>
                        <option value="7">Próximos 7 días</option>
                        <option value="30">Próximos 30 días</option>
                        <option value="vencidas">Solo vencidas</option>
                    </select>
                </label>
                <label class="filter-panel__search"><span>Búsqueda</span><input id="rep-filtro-busqueda" type="search"
                                                                                    placeholder="Actividad, tema, comentario"></label>
                </section>
                <div id="rep-status" class="status-message" hidden></div>
                <section class="panel panel--preview">
                    <header>
                        <h2>Vista previa del reporte</h2><span id="rep-summary">—</span>
                    </header>
                    <div id="internal-report-deck" class="internal-report-deck"></div>
                </section>
            </section>
        </main>

        <div id="modal-root" class="modal-root" hidden>
            <div class="modal-backdrop"></div>
            <div class="modal-card" role="dialog" aria-modal="true">
                <header>
                    <h3 id="modal-title">Formulario</h3><button class="modal-close" id="modal-close">×</button>
                </header>
                <div id="modal-body"></div>
            </div>
        </div>
        <div id="toast-root" class="toast-root" aria-live="polite"></div>

        @section Scripts {
            <script src="https://d3js.org/d3.v7.min.js"></script>
            <script src="https://cdn.jsdelivr.net/npm/html2canvas@@1.4.1/dist/html2canvas.min.js"></script>
            <script src="https://cdn.jsdelivr.net/npm/jspdf@@2.5.1/dist/jspdf.umd.min.js"></script>
            <script src="https://cdn.jsdelivr.net/gh/gitbrent/pptxgenjs@@v3.12.0/dist/pptxgen.bundle.js"></script>
            <script src="https://cdn.jsdelivr.net/npm/exceljs@@4.4.0/dist/exceljs.min.js"></script>
            <script type="module" src="~/gestor/js/data-service.js" asp-append-version="true"></script>
            <script type="module" src="~/gestor/js/utils.js" asp-append-version="true"></script>
            <script type="module" src="~/gestor/js/charts.js" asp-append-version="true"></script>
            <script type="module" src="~/gestor/js/dashboard.js" asp-append-version="true"></script>
            <script type="module" src="~/gestor/js/temas.js" asp-append-version="true"></script>
            <script type="module" src="~/gestor/js/actividades.js" asp-append-version="true"></script>
            <script type="module" src="~/gestor/js/kanban.js" asp-append-version="true"></script>
            <script type="module" src="~/gestor/js/gantt.js" asp-append-version="true"></script>
            <script type="module" src="~/gestor/js/calendario.js" asp-append-version="true"></script>
            <script type="module" src="~/gestor/js/responsables.js" asp-append-version="true"></script>
            <script type="module" src="~/gestor/js/alertas.js" asp-append-version="true"></script>
            <script type="module" src="~/gestor/js/reportes.js" asp-append-version="true"></script>
            <script type="module" src="~/gestor/js/app.js" asp-append-version="true"></script>
        }
