@model IEnumerable<UserViewModel>
@inject IHttpContextAccessor HttpContextAccessor
@using Microsoft.AspNetCore.Http
@using Newtonsoft.Json

@{

    var httpContext = HttpContextAccessor.HttpContext;
    var perfilUsuarioJson = httpContext.Session.GetString("PerfilUsuario");
    var perfilUsuario = JsonConvert.DeserializeObject<PerfilUsuario>(perfilUsuarioJson);
    ViewData["NombreUsuario"] = perfilUsuario.Nombre;
    ViewData["RolUsuario"] = perfilUsuario.Rol;
    ViewData["MercadoUsuario"] = perfilUsuario.Mercado_ID;
    ViewData["IDUsuario"] = perfilUsuario.IdUsuario;
    ViewData["Title"] = "Gestión de Usuarios y Perfiles";
}

@{
    var header = new HeaderViewModel
    {
        Title = "Gestión de Usuarios y Perfiles",
        IconPath = "usuarios_scel.png",
        Description = "Gestiona perfiles, roles y accesos según normativa.",
        Section = "Gobernanza y Seguridad",
        ModuleInfo = JsonConvert.SerializeObject(new
        {
            title = "Gestión de Usuarios y Perfiles",
            description = "Sistema de administración de usuarios y control de accesos del SNIEr.",
            functionality = "Permite gestionar usuarios, asignar roles y mantener la trazabilidad de accesos.",
            stage = "Inicialización",
            roles = new[] {
                new { icon = "building", text = "Secretaría de Energía: Administración general" },
                new { icon = "users-cog", text = "Unidad SNIEr: Gestión de perfiles" },
                new { icon = "user-shield", text = "Dirección TICs: Control técnico" },
                new { icon = "user-tie", text = "Consejo: Supervisión de accesos" }
            },
            order = new { step = 1, description = "Control de accesos desde el inicio (Art. 70)" }
        }),
        LegalDescription = "Gestión de accesos y perfiles conforme a los lineamientos establecidos en el Art. 70 del Reglamento.",
        Fundamentos = new List<FundamentoLegal> {
            new() { Reference = "Art. 70 Reglamento", Description = "Establece los controles de acceso y gestión de usuarios" },
            new() { Reference = "Art. 71 Reglamento", Description = "Define la administración de perfiles" },
            new() { Reference = "Art. 76 Reglamento", Description = "Establece la trazabilidad y seguridad" }
        }
    };

    // El RFC es dato personal y viaja en los archivos que genera la exportación.
    // Se muestra con el centro cubierto; el dato completo vive en la ficha del
    // usuario, que exige entrar a editarlo.
    Func<string, string> enmascararRfc = rfc =>
    {
        if (string.IsNullOrWhiteSpace(rfc) || rfc.Length < 8) return rfc;
        return rfc.Substring(0, 4) + new string('•', rfc.Length - 7) + rfc.Substring(rfc.Length - 3);
    };

    var usuarios = Model.Where(u => u.Vigente).ToList();
    var conSesion = usuarios.Count(u => u.SesionActiva);
}

@section Styles {
    <link rel="stylesheet" href="~/css/usuarios.css" asp-append-version="true" />
}

@await Html.PartialAsync("_ViewHeader", header)

<div class="container-fluid px-3 px-lg-4 usuarios-page">
    <div class="shell-table-card">
        <div class="shell-table-toolbar">
            <div>
                <h5 class="mb-1 fw-bold">Usuarios, perfiles y trazabilidad</h5>
                <p class="mb-0 text-muted small">
                    <strong>@usuarios.Count</strong> usuarios vigentes ·
                    <strong>@conSesion</strong> con sesión abierta.
                    Abre la fila para ver el resto de los metadatos de control.
                </p>
            </div>
            <div class="shell-table-toolbar__group justify-content-md-end flex-grow-0">
                <a asp-controller="Usuarios" asp-action="CrearNotificacion" class="shell-btn">
                    <i class="fas fa-bell"></i> Crear notificación
                </a>
                <a asp-controller="Usuarios" asp-action="NuevoUsuario" class="shell-btn shell-btn--primary">
                    <i class="fas fa-user-plus"></i> Agregar usuario
                </a>
            </div>
        </div>

        @*
            La tabla mostraba las 27 columnas de la consulta, incluida la clave
            (hash SHA-256) y el RFC completo, y los botones de exportación se
            los llevaban a Excel, CSV y PDF. Aquí quedan las seis que sirven
            para administrar; el resto se abre por fila y la clave ya no se
            renderiza en ninguna parte.
        *@
        <div class="table-responsive">
            <table id="usuariosTabla" class="table table-hover align-middle w-100">
                <thead>
                    <tr>
                        <th class="usuarios-col-detalle"></th>
                        <th>Nombre</th>
                        <th>Unidad de adscripción</th>
                        <th>Correo</th>
                        <th>Rol</th>
                        <th>Sesión</th>
                        <th class="usuarios-col-acciones">Acciones</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var user in usuarios)
                    {
                        <tr data-id="@user.IdUsuario"
                            data-rfc="@enmascararRfc(user.RFC)"
                            data-clave-empleado="@user.ClaveEmpleado"
                            data-actualizacion="@(user.UltimaActualizacion == default ? "—" : user.UltimaActualizacion.ToString("dd/MM/yyyy HH:mm"))"
                            data-inicio-sesion="@(user.HoraInicioSesion == default ? "—" : user.HoraInicioSesion.ToString("dd/MM/yyyy HH:mm"))"
                            data-mercado="@user.Mercado_Nombre"
                            data-mercado-id="@user.Mercado_ID"
                            data-rol-registro="@user.RolUsuario_QuienRegistro"
                            data-rol-fecha="@(user.RolUsuario_FechaMod == default ? "—" : user.RolUsuario_FechaMod.ToString("dd/MM/yyyy"))"
                            data-rol-comentarios="@user.RolUsuario_Comentarios"
                            data-rol-vigente="@(user.RolUsuario_Vigente ? "Sí" : "No")">
                            <td class="usuarios-detalle-toggle" title="Ver el resto de los datos"></td>

                            <td>
                                <span class="usuarios-nombre">@user.Nombre</span>
                                <span class="usuarios-cargo">
                                    @(string.IsNullOrWhiteSpace(user.Cargo) ? "Sin cargo registrado" : user.Cargo)
                                </span>
                            </td>

                            <td>
                                @(string.IsNullOrWhiteSpace(user.Unidad_de_Adscripcion)
                                    ? Html.Raw("<span class=\"usuarios-vacio\">Sin adscripción</span>")
                                    : Html.Raw(Html.Encode(user.Unidad_de_Adscripcion)))
                            </td>

                            <td><a class="usuarios-correo" href="mailto:@user.Correo">@user.Correo</a></td>

                            <td>
                                @(string.IsNullOrWhiteSpace(user.Rol_Nombre)
                                    ? Html.Raw("<span class=\"usuarios-vacio\">Sin rol</span>")
                                    : Html.Raw(Html.Encode(user.Rol_Nombre)))
                            </td>

                            <td data-order="@(user.SesionActiva ? 1 : 0)">
                                <span class="shell-badge shell-badge--sm @(user.SesionActiva ? "shell-badge--activa" : "shell-badge--oculta")">
                                    @(user.SesionActiva ? "Abierta" : "Cerrada")
                                </span>
                            </td>

                            <td>
                                <div class="shell-table-actions justify-content-start">
                                    <a class="is-edit" href="@Url.Action("Edit", "Usuarios", new { id = user.IdUsuario })"
                                       title="Editar usuario" aria-label="Editar usuario @user.Nombre">
                                        <i class="fas fa-pen"></i>
                                    </a>
                                    <a href="@Url.Action("Eliminar", "Usuarios", new { id = user.IdUsuario })"
                                       class="is-delete delete-link" title="Eliminar usuario"
                                       aria-label="Eliminar usuario @user.Nombre">
                                        <i class="fas fa-trash-can"></i>
                                    </a>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>

    @*Modal para Confirmar la Eliminación*@
    <div class="modal fade" id="confirmDeleteModal" tabindex="-1" aria-labelledby="confirmDeleteModalLabel"
         aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content">
                <div class="modal-sec__header">
                    <div>
                        <span class="modal-sec__kicker">Gestión de usuarios</span>
                        <h5 class="modal-sec__title" id="confirmDeleteModalLabel">Eliminar usuario</h5>
                    </div>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Cerrar"></button>
                </div>
                <div class="modal-sec__body">
                    <p class="mb-0">Se dará de baja la cuenta y sus accesos. La acción no se puede deshacer.</p>
                </div>
                <div class="modal-sec__foot">
                    <button type="button" class="btn-sec" data-bs-dismiss="modal">Cancelar</button>
                    <a href="#" class="btn-sec btn-sec--primary" id="confirmDeleteButton">
                        <i class="fas fa-trash-can"></i> Eliminar
                    </a>
                </div>
            </div>
        </div>
    </div>


    @{
        var userMessage = TempData["UserMessage"] as string;
        var isSuccess = TempData["IsSuccess"] as bool?;
        var userErrorDetail = TempData["UserErrorDetail"] as string;
    }

    @if (!string.IsNullOrEmpty(userMessage))
    {
        <input type="hidden" id="userMessage" value="@userMessage" />
        <input type="hidden" id="isSuccess" value="@isSuccess" />
        <input type="hidden" id="userErrorDetail" value="@userErrorDetail" />

        <div class="modal" tabindex="-1" id="userMessageModal">
            <div class="modal-dialog modal-dialog-centered">
                <div class="modal-content">
                    <div class="modal-sec__header">
                        <div>
                            <span class="modal-sec__kicker">Gestión de usuarios</span>
                            <h5 class="modal-sec__title" id="modalTitle">Resultado</h5>
                        </div>
                        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Cerrar"></button>
                    </div>
                    <div class="modal-sec__body" id="modalBody">
                        <!-- El mensaje al usuario se inserta aquí con JavaScript -->
                    </div>
                    <div class="modal-sec__foot">
                        <button type="button" class="btn-sec" data-bs-dismiss="modal">Cerrar</button>
                    </div>
                </div>
            </div>
        </div>
    }

</div>

@section scripts {
    @*Modal para confirmar la eliminación*@
    <script>
        document.addEventListener("DOMContentLoaded", function () {
            // Los modales se cuelgan de <body>: dentro de <main>, que trae
            // isolation: isolate, su z-index no compite con el velo y quedarían
            // por debajo, sin forma de cerrarlos.
            document.querySelectorAll('#confirmDeleteModal, #userMessageModal').forEach(function (el) {
                document.body.appendChild(el);
            });

            var confirmDeleteButton = document.getElementById("confirmDeleteButton");

            document.addEventListener("click", function (e) {
                var link = e.target.closest(".delete-link");
                if (!link) return;
                e.preventDefault();
                confirmDeleteButton.href = link.href;
                console.info("[Usuarios] Solicitud de eliminación preparada", {
                    href: link.href,
                    idUsuario: link.href.split('/').pop()
                });
                new bootstrap.Modal(document.getElementById("confirmDeleteModal")).show();
            });

            if (confirmDeleteButton) {
                confirmDeleteButton.addEventListener("click", function () {
                    console.info("[Usuarios] Confirmación de eliminación", {
                        href: confirmDeleteButton.href,
                        idUsuario: confirmDeleteButton.href.split('/').pop()
                    });
                });
            }
        });
    </script>

    @*Modal Mensaje de Exito o error al eliminar*@
    <script>
        document.addEventListener("DOMContentLoaded", function () {
            var userMessageInput = document.getElementById("userMessage");
            var isSuccessInput = document.getElementById("isSuccess");
            if (!userMessageInput || !isSuccessInput) {
                return;
            }

            var userMessage = userMessageInput.value;
            var isSuccess = isSuccessInput.value.toLowerCase() === "true";
            var userErrorDetailInput = document.getElementById("userErrorDetail");
            var userErrorDetail = userErrorDetailInput ? userErrorDetailInput.value : "";

            document.getElementById("modalTitle").innerText = isSuccess ? "Listo" : "No se pudo completar";
            document.getElementById("modalBody").innerText = userMessage;

            new bootstrap.Modal(document.getElementById("userMessageModal")).show();

            if (isSuccess) {
                console.info("[Usuarios] Eliminación exitosa", { message: userMessage });
            } else {
                console.error("[Usuarios] Error al eliminar usuario", {
                    message: userMessage,
                    detail: userErrorDetail || "Sin detalle recibido desde backend"
                });
            }
        });
    </script>

    <script>
        $(document).ready(function () {

            var table = $('#usuariosTabla').DataTable({
                lengthMenu: [[10, 50, 100, -1], [10, 50, 100, "Todos"]],
                order: [[1, 'asc']],
                columnDefs: [
                    { orderable: false, searchable: false, targets: [0, 6] }
                ],
                language: {
                    url: '//cdn.datatables.net/plug-ins/1.13.6/i18n/es-ES.json'
                },
                dom: 'Blfrtip',
                buttons: [
                    { extend: 'copyHtml5', title: 'SNIEr · Usuarios de la plataforma', exportOptions: { columns: [1, 2, 3, 4, 5] } },
                    { extend: 'excelHtml5', title: 'SNIEr · Usuarios de la plataforma', exportOptions: { columns: [1, 2, 3, 4, 5] } },
                    { extend: 'csvHtml5', title: 'SNIEr · Usuarios de la plataforma', exportOptions: { columns: [1, 2, 3, 4, 5] } },
                    {
                        extend: 'pdfHtml5',
                        title: 'SNIEr · Usuarios de la plataforma',
                        exportOptions: { columns: [1, 2, 3, 4, 5] },
                        customize: function (doc) {
                            doc.styles.tableHeader.color = '#ffffff';
                            doc.styles.tableHeader.fillColor = '#9B2247';
                            doc.defaultStyle.alignment = 'left';
                        }
                    }
                ]
            });

            // Detalle por fila: aquí viven los metadatos de control que antes
            // ocupaban veinte columnas a lo ancho.
            function detalleDe(fila) {
                var d = fila.dataset;
                var campo = function (etiqueta, valor) {
                    var v = (valor && valor.trim()) ? valor : '—';
                    return '<div class="usuarios-detalle__campo">' +
                           '<span class="usuarios-detalle__etiqueta">' + etiqueta + '</span>' +
                           '<span class="usuarios-detalle__valor">' + v + '</span></div>';
                };
                return '<div class="usuarios-detalle">' +
                    campo('Id de usuario', d.id) +
                    campo('RFC', d.rfc) +
                    campo('Clave de empleado', d.claveEmpleado) +
                    campo('Mercado', d.mercado) +
                    campo('Última actualización', d.actualizacion) +
                    campo('Inicio de sesión', d.inicioSesion) +
                    campo('Rol registrado por', d.rolRegistro) +
                    campo('Rol modificado el', d.rolFecha) +
                    campo('Rol vigente', d.rolVigente) +
                    campo('Comentarios del rol', d.rolComentarios) +
                    '</div>';
            }

            $('#usuariosTabla tbody').on('click', 'td.usuarios-detalle-toggle', function () {
                var tr = $(this).closest('tr');
                var fila = table.row(tr);

                if (fila.child.isShown()) {
                    fila.child.hide();
                    tr.removeClass('is-abierta');
                } else {
                    fila.child(detalleDe(tr[0])).show();
                    tr.addClass('is-abierta');
                }
            });

        });
    </script>

}
