@model NSIE.Models.Encuesta
@using Microsoft.AspNetCore.Http
@using Newtonsoft.Json
@using NSIE.Models
@inject IHttpContextAccessor HttpContextAccessor

@{
    ViewData["Title"] = "Encuesta";

    var header = new HeaderViewModel
    {
        Title = "Encuesta",
        IconPath = "analisis.png",
        Description = "Comparte tu opinión sobre la plataforma para ayudarnos a mejorarla.",
        Section = "Participación",
        ModuleInfo = JsonConvert.SerializeObject(new
        {
            title = "Encuesta de satisfacción",
            description = "Recoge la opinión de las personas usuarias sobre la utilidad y la experiencia de la plataforma.",
            functionality = "Responde unas preguntas breves sobre la información que buscaste y tu experiencia de uso.",
            stage = "Participación"
        })
    };
}

@await Html.PartialAsync("_ViewHeader", header)

<div class="container">
<h3 class="form-section-title">En EnerGeoCRE nos interesa conocer tu opinión</h3>

    <div asp-validation-summary="All" class="text-danger"></div>
    <form id="Encuesta" asp-action="EnviarEncuesta" method="post">
        <div class="mb-3">
            <label class="form-label" asp-for="Nombre">Nombre</label>
            <input type="text" class="form-control" asp-for="Nombre" required>
            <span asp-validation-for="Nombre" class="text-danger"></span>
        </div>

        <div class="mb-3">
            <label class="form-label" asp-for="Correo">Correo</label>
            <input type="email" class="form-control" asp-for="Correo" required>
            <span asp-validation-for="Correo" class="text-danger"></span>
        </div>



        <div class="mb-3">
            <label class="form-label d-block">
                ¿Encontraste la información que buscabas?
            </label>
            <div class="form-check form-check-inline">
                <input type="radio" class="form-check-input" asp-for="EncontroInformacion" value="true" id="encontroSi" required>
                <label class="form-check-label" for="encontroSi">Sí</label>
            </div>
            <div class="form-check form-check-inline">
                <input type="radio" class="form-check-input" asp-for="EncontroInformacion" value="false" id="encontroNo">
                <label class="form-check-label" for="encontroNo">No</label>
            </div>
        </div>

        <div class="mb-3">
            <label class="form-label d-block">
                ¿Te fue de utilidad?
            </label>
            <div class="form-check form-check-inline">
                <input type="radio" class="form-check-input" asp-for="FueUtil" value="true" id="utilSi" required>
                <label class="form-check-label" for="utilSi">Sí</label>
            </div>
            <div class="form-check form-check-inline">
                <input type="radio" class="form-check-input" asp-for="FueUtil" value="false" id="utilNo">
                <label class="form-check-label" for="utilNo">No</label>
            </div>
        </div>

        <div class="mb-3">
            <label class="form-label" asp-for="InformacionBuscada">¿Qué información buscaste?</label>
            <textarea class="form-control" asp-for="InformacionBuscada" rows="4" required></textarea>
            <span asp-validation-for="InformacionBuscada" class="text-danger"></span>
        </div>

        <div class="mb-3">
            <label class="form-label">¿Cómo calificas tu experiencia con la herramienta EnerGeoCRE?</label>
            <select class="form-select" asp-for="CalificacionExperiencia">
                <option value="Muy satisfecho">Muy satisfecho</option>
                <option value="Bastante satisfecho">Bastante satisfecho</option>
                <option value="Normal">Normal</option>
                <option value="Un poco insatisfecho">Un poco insatisfecho</option>
                <option value="Muy insatisfecho">Muy insatisfecho</option>
            </select>
        </div>

        <div class="mb-3">
            <label class="form-label d-block">
                ¿Quieres agregar algún comentario adicional?
            </label>
            <div class="form-check form-check-inline">
                <input type="radio" class="form-check-input" asp-for="AgregarComentario" value="true" id="comentarioSi" required>
                <label class="form-check-label" for="comentarioSi">Sí</label>
            </div>
            <div class="form-check form-check-inline">
                <input type="radio" class="form-check-input" asp-for="AgregarComentario" value="false" id="comentarioNo">
                <label class="form-check-label" for="comentarioNo">No</label>
            </div>
        </div>

        <div class="mb-3">
            <label class="form-label" asp-for="ComentarioAdicional">Comentario Adicional</label>
            <textarea class="form-control" asp-for="ComentarioAdicional" rows="4"></textarea>
            <span asp-validation-for="ComentarioAdicional" class="text-danger"></span>
        </div>

        <div class="mb-3">
            <input type="submit" class="btn btn-primary w-100 w-sm-auto" value="Enviar">
        </div>
    </form>

</div>




<!-- Scripts -->
@section scripts {

    <script type="text/javascript">
        $(document).ready(function () {
            // Inicialmente deshabilitar el campo de texto
            $('#ComentarioAdicional').prop('disabled', true);

            // Escuchar cambios en los radio buttons
            $('input[type=radio][name=AgregarComentario]').change(function () {
                // Habilitar el campo de texto si la respuesta es "Sí"
                if (this.value == 'true') {
                    $('#ComentarioAdicional').prop('disabled', false);
                    $('#ComentarioAdicional').prop('required', true);
                } else {
                    $('#ComentarioAdicional').prop('disabled', true);
                    $('#ComentarioAdicional').prop('required', false);
                }
            });
        });

