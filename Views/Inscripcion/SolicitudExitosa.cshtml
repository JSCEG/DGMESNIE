@using NSIE.Models
@using Microsoft.AspNetCore.Http
@using Newtonsoft.Json
@inject IHttpContextAccessor HttpContextAccessor
@{
    var httpContext = HttpContextAccessor.HttpContext;
    var perfilUsuarioJson = httpContext.Session.GetString("PerfilUsuario");
    var perfilUsuario = JsonConvert.DeserializeObject<PerfilUsuario>(perfilUsuarioJson);
    // Utilizar los datos del usuario para personalizar la vista
    ViewData["NombreUsuario"] = perfilUsuario.Nombre;
    ViewData["RolUsuario"] = perfilUsuario.Rol;
    ViewData["MercadoUsuario"] = perfilUsuario.Mercado_ID;
    ViewData["IDUsuario"] = perfilUsuario.IdUsuario;
}

@{
    ViewData["Title"] = "Solicitud de Inscripción al Sistema S-CEL";
}
<div class="text-center">
    <h3 class="cp-section cp-grouping-section">
        <img src="@Cdn.Url/img_snier/vistas/conding.png" alt="Icono personalizado" class="iconomenu">
        @ViewData["Title"]
    </h3>
</div>
<!-- Miga de Pan -->
<div class="alert alert-light" role="alert">
</div>
<div class="container mb-3">
    <div class="row">
        <div class="col-12 col-md-11 col-lg-7 col-xl-6 mx-auto">
            <div class="app-branding text-center mb-5">
                <!-- Puedes agregar más branding o dejarlo vacío -->
            </div><!--//app-branding-->

            <!-- Alerta de sección en construcción -->
            <div class="alert alert-success text-center p-4" role="alert">
                <strong>¡Muchas Gracias!</strong> Hemos recibido tu solicitud de inscripción de manera exitosa!,
                en breve recibirás un correo con la información de los siguientes pasos para concretar tu solicitud,
                recuerda que cualquier duda o comentario puedes escribirnos directamente a sistemacel@cre.gob.mx
            </div>


            <div class="mb-4">
                <img src="@Cdn.Url/img_snier/vistas/logo_scel.png" class="img-fluid" alt="Sección en Construcción" width="100%">
            </div>
            <button class="btn btn-cre-rojo" onclick="goBack()" data-toggle="tooltip" data-placement="bottom"
                title="Regresar a la página anterior">
                <i class="bi bi-backspace-fill"></i> &nbsp; Regresar
            </button>

        </div><!--//col-->
    </div><!--//row-->
</div><!--//container-->

<script>
    function goBack() {
        window.history.back();
    }
</script>
