    @*Preloader*@
    <script>
        let temporizadoresFicha = [];

        function actualizarPreloaderFicha(porcentaje, mensaje, etapa) {
            const preloader = document.getElementById('page-preloader');
            if (!preloader) return;

            const valor = Math.max(0, Math.min(100, Number(porcentaje) || 0));
            const barra = preloader.querySelector('[data-ficha-preloader-bar]');
            const progreso = barra?.closest('[role="progressbar"]');
            const textoValor = preloader.querySelector('[data-ficha-preloader-value]');
            const textoMensaje = preloader.querySelector('[data-ficha-preloader-message]');
            const textoEtapa = preloader.querySelector('[data-ficha-preloader-stage]');
            const pasos = Array.from(preloader.querySelectorAll('[data-page-preloader-steps] .preloader-step'));

            if (barra) barra.style.width = `${valor}%`;
            if (progreso) progreso.setAttribute('aria-valuenow', String(valor));
            if (textoValor) textoValor.textContent = `${Math.round(valor)}%`;
            if (textoMensaje && mensaje) textoMensaje.textContent = mensaje;
            if (textoEtapa && etapa) textoEtapa.textContent = etapa;
            pasos.forEach((paso, indice) => {
                const activo = valor >= (indice === 0 ? 1 : indice === 1 ? 45 : 82);
                paso.classList.toggle('is-active', activo);
                paso.classList.toggle('is-complete', activo && valor >= (indice === 0 ? 45 : indice === 1 ? 82 : 100));
            });
        }

        function mostrarPreloaderFicha(claveProyecto) {
            const preloader = document.getElementById('page-preloader');
            if (!preloader) return;

            temporizadoresFicha.forEach(window.clearTimeout);
            temporizadoresFicha = [];
            preloader.dataset.fichaPam = 'true';
            preloader.dataset.holdUntilReady = 'true';
            preloader.dataset.fichaReady = 'false';
            preloader.querySelector('[data-page-preloader-default]')?.setAttribute('hidden', '');
            preloader.querySelector('[data-page-preloader-ficha]')?.removeAttribute('hidden');
            $(preloader).stop(true, true).show();

            const clave = claveProyecto ? ` ${claveProyecto}` : '';
            actualizarPreloaderFicha(8, `Consultando la cartera y las fuentes de${clave}.`, 'Consulta de información vigente');
            [
                [450, 24, 'Integrando datos técnicos y financieros.', 'Datos del proyecto'],
                [1200, 43, 'Organizando fases, subfases y calendario.', 'Seguimiento del proyecto'],
                [2400, 61, 'Preparando mapas y contexto territorial.', 'Ubicación e infraestructura'],
                [4200, 76, 'Componiendo las láminas ejecutivas.', 'Presentación navegable'],
                [7000, 86, 'Validando el orden y la navegación.', 'Preparación final']
            ].forEach(([espera, valor, mensaje, etapa]) => {
                temporizadoresFicha.push(window.setTimeout(() => actualizarPreloaderFicha(valor, mensaje, etapa), espera));
            });
        }

        function completarPreloaderFicha() {
            const preloader = document.getElementById('page-preloader');
            if (!preloader) return;
            temporizadoresFicha.forEach(window.clearTimeout);
            temporizadoresFicha = [];
            preloader.dataset.fichaReady = 'true';
            actualizarPreloaderFicha(100, 'La ficha está lista para consulta, presentación y descarga.', 'Ficha generada');
            window.setTimeout(() => ocultarPreloaderPrincipal(true), 280);
        }

        function ocultarPreloaderPrincipal(forzar) {
            const preloader = document.getElementById('page-preloader');
            if (!preloader) return;
            const debeEsperar = preloader.dataset.holdUntilReady === 'true' && preloader.dataset.fichaReady !== 'true';
            if (debeEsperar && forzar !== true) return;
            $(preloader).stop(true, true).fadeOut('slow');
        }

        window.actualizarPreloaderFicha = actualizarPreloaderFicha;
        window.mostrarPreloaderFicha = mostrarPreloaderFicha;
        window.completarPreloaderFicha = completarPreloaderFicha;

        // ⏳ Ocultar preloader de página cuando todo (scripts, imágenes, etc.) ha cargado
        $(window).on('load', function () {
            ocultarPreloaderPrincipal();
        });

        // Fallback para producción: si algún recurso externo retrasa el evento load,
        // no dejamos el overlay visible indefinidamente.
        window.setTimeout(() => ocultarPreloaderPrincipal(true), document.getElementById('page-preloader')?.dataset.fichaPam === 'true' ? 15000 : 3500);
        window.addEventListener('pageshow', function (event) {
            if (event.persisted) ocultarPreloaderPrincipal(true);
            else ocultarPreloaderPrincipal();
        });

        // ✅ Cuando el DOM está listo (solo estructura HTML, no scripts externos)
        $(document).ready(function () {
            window.setTimeout(ocultarPreloaderPrincipal, 800);

            // Animación puntos page preloader
            let pageDots = 0;
            setInterval(() => {
                $('#page-dots').text('.'.repeat(pageDots));
                pageDots = (pageDots + 1) % 4;
            }, 500);

            // Mostrar preloader si se envía formulario válido
            $('form').on('submit', function () {
                if ($(this).is('[data-skip-page-preloader="true"]')) {
                    return;
                }

                if ($(this).attr('id') === 'form-upload-files' || $(this).valid()) {
                    $('#page-preloader').show();
                }
            });

            // La generación inicia desde el clic para cubrir también el tiempo de
            // respuesta del servidor antes de que la nueva página pueda dibujarse.
            $(document).on('click', 'a[href*="/InformePormenorizado/ProyectosIdentificados/Ficha/"]', function (event) {
                if (event.ctrlKey || event.metaKey || event.shiftKey || event.altKey || this.target === '_blank' || this.hasAttribute('download')) return;
                const url = new URL(this.href, window.location.href);
                const segmentos = url.pathname.split('/').filter(Boolean);
                mostrarPreloaderFicha(decodeURIComponent(segmentos[segmentos.length - 1] || ''));
            });

            // Si hay errores en servidor, ocultar preloader y alertar
            if ($('.validation-summary-errors').length > 0) {
                $('#page-preloader').hide();
                alert('Por favor, completa todos los campos obligatorios.');
            }

            // Animar los puntos del preloader AJAX
            let ajaxDots = 0;
            setInterval(() => {
                $('#ajax-dots').text('.'.repeat(ajaxDots));
                ajaxDots = (ajaxDots + 1) % 4;
            }, 500);

            // Mostrar/ocultar preloader AJAX
            $(document).ajaxStart(function () {
                $('#ajax-preloader').show();
            }).ajaxStop(function () {
                $('#ajax-preloader').hide();
            });
        });
    </script>

