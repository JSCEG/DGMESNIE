    <!-- DSv2: toggle de tema + helper de gráficos -->
    <script>
        (function () {
            var btn = document.getElementById('theme-toggle');

            function syncIcons(theme) {
                if (!btn) return;
                btn.querySelector('.theme-toggle__icon--dark').classList.toggle('d-none', theme === 'dark');
                btn.querySelector('.theme-toggle__icon--light').classList.toggle('d-none', theme !== 'dark');
            }

            window.dsChartTheme = function () {
                var dark = document.documentElement.getAttribute('data-bs-theme') === 'dark';
                return dark ? {
                    background: 'transparent',
                    text: '#ece7e2',
                    muted: '#a39aa8',
                    grid: 'rgba(255,255,255,0.10)',
                    guinda: '#d4537e',
                    dorado: '#d4ab52',
                    verde: '#4ccfae'
                } : {
                    background: 'transparent',
                    text: '#243444',
                    muted: '#6c7a89',
                    grid: '#edf0f3',
                    guinda: '#9B2247',
                    dorado: '#a57f2c',
                    verde: '#1e5b4f'
                };
            };

            syncIcons(document.documentElement.getAttribute('data-bs-theme'));

            if (btn) {
                btn.addEventListener('click', function () {
                    var next = document.documentElement.getAttribute('data-bs-theme') === 'dark' ? 'light' : 'dark';
                    document.documentElement.setAttribute('data-bs-theme', next);
                    try { localStorage.setItem('dgmesnie-theme', next); } catch (e) { }
                    syncIcons(next);
                    window.dispatchEvent(new CustomEvent('themechange', { detail: { theme: next } }));
                });
            }
        })();
    </script>

