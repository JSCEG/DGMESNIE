@using Microsoft.AspNetCore.Http
@using Newtonsoft.Json
@using NSIE.Models
@using System.Text.RegularExpressions
@inject IHttpContextAccessor HttpContextAccessor

@{  
     @* var cdn = "https://cdn.sassoapps.com"; *@
    var httpContext = HttpContextAccessor.HttpContext;
    var perfilUsuarioJson = httpContext?.Session?.GetString("PerfilUsuario");
    var perfilUsuario = string.IsNullOrEmpty(perfilUsuarioJson) ? null : JsonConvert.DeserializeObject<PerfilUsuario>(perfilUsuarioJson);
    var seccionesUsuarioJson = httpContext?.Session?.GetString("SeccionesUsuario");
    var seccionesUsuario = string.IsNullOrEmpty(seccionesUsuarioJson) ? new List<SeccionSNIER>() : (JsonConvert.DeserializeObject<List<SeccionSNIER>>(seccionesUsuarioJson) ?? new List<SeccionSNIER>());
    var perfilIdUsuario = perfilUsuario?.IdUsuario ?? "0";
    var perfilRolUsuario = perfilUsuario?.Rol ?? "0";
    ViewData["NombreUsuario"] = perfilUsuario?.Nombre ?? "Invitado";
    ViewData["RolUsuario"] = perfilUsuario?.Rol ?? "Público";
    ViewData["IDUsuario"] = perfilIdUsuario;
    ViewData["Unidad_de_Adscripcion"] = perfilUsuario?.Unidad_de_Adscripcion ?? "";
    ViewData["Mercado_ID"] = perfilUsuario?.Mercado_ID ?? "";
 var currentController = ViewContext.RouteData.Values["Controller"].ToString();
    var currentAction = ViewContext.RouteData.Values["Action"].ToString(); 
    var esFichaPam = string.Equals(currentController, "PamrntProyectos", StringComparison.OrdinalIgnoreCase)
        && string.Equals(currentAction, "Ficha", StringComparison.OrdinalIgnoreCase);
    string LimpiarEtiquetaMenu(string texto)
    {
        if (string.IsNullOrWhiteSpace(texto))
        {
            return string.Empty;
        }

        return Regex.Replace(texto, @"^[^\p{L}\p{N}]+", string.Empty).Trim();
    }
        @* var currentController = ViewContext.RouteData.Values["controller"]?.ToString();
    var currentAction = ViewContext.RouteData.Values["action"]?.ToString(); *@
}
