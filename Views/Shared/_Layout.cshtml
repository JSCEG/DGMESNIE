@{
    // Migas de pan del shell. Se arman con el mismo menú de la sesión que
    // dibuja la navegación de arriba, así que dicen dónde está el usuario
    // dentro de la estructura real, no dentro de lo que cada vista creyó.
    // Antes cada pantalla escribía las suyas: 150 vistas y cuatro marcados
    // distintos para lo mismo.
    string migaSeccion = null, migaModulo = null, migaVista = null;

    foreach (var sec in seccionesUsuario)
    {
        if (sec.Modulos == null) continue;
        foreach (var mod in sec.Modulos)
        {
            var vista = mod.Vistas?.FirstOrDefault(v =>
                string.Equals(v.VistaController, currentController, StringComparison.OrdinalIgnoreCase) &&
                string.Equals(v.VistaAction, currentAction, StringComparison.OrdinalIgnoreCase));

            var esModulo = string.Equals(mod.Controller, currentController, StringComparison.OrdinalIgnoreCase) &&
                           string.Equals(mod.Action, currentAction, StringComparison.OrdinalIgnoreCase);

            if (vista != null || esModulo)
            {
                migaSeccion = LimpiarEtiquetaMenu(sec.Titulo);
                migaModulo = LimpiarEtiquetaMenu(mod.Title);
                if (vista != null) migaVista = LimpiarEtiquetaMenu(vista.VistaTitle);
                break;
            }
        }
        if (migaSeccion != null) break;
    }

    // Si la ruta no está en el menú —una vista de detalle, por ejemplo— se usa
    // el título que la vista ya declara.
    var migaFinal = migaVista ?? migaModulo ?? (ViewData["Title"]?.ToString());
    var esInicio = string.Equals(currentController, "Home", StringComparison.OrdinalIgnoreCase) &&
                   string.Equals(currentAction, "Index", StringComparison.OrdinalIgnoreCase);
}

