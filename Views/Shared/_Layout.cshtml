            @if (migaSeccion != null)
            {
                <span class="shell-migas__sep" aria-hidden="true">›</span>
                <span>@migaSeccion</span>
            }
            @if (migaVista != null && migaModulo != null)
            {
                <span class="shell-migas__sep" aria-hidden="true">›</span>
                <span>@migaModulo</span>
            }
            <span class="shell-migas__sep" aria-hidden="true">›</span>
            <span class="shell-migas__actual">@migaFinal</span>
        </nav>

        @* La ayuda del módulo sube aquí, junto a la ruta. El contenido lo trae
