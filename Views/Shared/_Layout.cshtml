    <!-- Custom Scripts - Toggle real para móviles -->
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            const sidebarToggle = document.getElementById('sidebarToggle');
            const sidebarMobile = document.getElementById('sidebarMobile');

            // Crear instancia única del offcanvas
            let offcanvasInstance = new bootstrap.Offcanvas(sidebarMobile, {
                backdrop: true,
                keyboard: true
            });

            // Sincronizar estado del toggle con el offcanvas al cerrar/abrir desde fuera
            sidebarMobile.addEventListener('hidden.bs.offcanvas', function () {
                sidebarToggle.classList.remove('is-active');
            });
            sidebarMobile.addEventListener('shown.bs.offcanvas', function () {
                sidebarToggle.classList.add('is-active');
            });

            // Event listener único para el toggle
            sidebarToggle.addEventListener('click', function(e) {
                e.preventDefault();
                e.stopPropagation();
                if (window.innerWidth < 992) {
                    offcanvasInstance.toggle();
                }

                // Esperar a que la animación/transición termine (ajusta ms si tu transición es distinta)
                setTimeout(() => {
                    if (typeof sankeyChart !== 'undefined' && sankeyChart) sankeyChart.resize();
                    if (typeof subSankeyChart !== 'undefined' && subSankeyChart) subSankeyChart.resize();
                }, 220);
            });

            // Event listener para el botón "Menú" de la barra inferior móvil
            document.querySelectorAll('.mobile-menu-trigger').forEach(trigger => {
                trigger.addEventListener('click', function(e) {
                    e.preventDefault();
                    e.stopPropagation();
                    offcanvasInstance.toggle();
                });
            });

            // Prevenir conflictos en collapse buttons
            document.querySelectorAll('[data-bs-toggle="collapse"]').forEach(button => {
                button.addEventListener('click', function(e) {
                    e.stopPropagation();
                    // Bootstrap manejará el collapse automáticamente
                });
            });

            // Cerrar offcanvas al hacer click en cualquier enlace de navegación real (etiqueta a)
            document.querySelectorAll('#sidebarMobile a').forEach(link => {
                link.addEventListener('click', function() {
                    offcanvasInstance.hide();
                });
            });

            // Cerrar offcanvas en resize
            window.addEventListener('resize', function () {
                if (window.innerWidth >= 992 && sidebarMobile.classList.contains('show')) {
                    offcanvasInstance.hide();
                }
            });
        });
    </script>
