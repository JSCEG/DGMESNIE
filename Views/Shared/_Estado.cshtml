@model NSIE.Models.EstadoViewModel
@*
    Estado vacío / sin permiso, con el patrón único de la opción 2e del mockup
    de auditoría. La hoja estados.css la enlaza la vista que use esta parcial.

    Uso:
        @await Html.PartialAsync("_Estado", new EstadoViewModel {
            Icono = "fas fa-magnifying-glass",
            Titulo = "Ningún proyecto coincide con estos filtros",
            Texto  = "Hay 148 proyectos en la cartera. Prueba con menos criterios.",
            AccionTexto = "Limpiar filtros", AccionUrl = "#",
            SalidaTexto = "Ver toda la cartera", SalidaUrl = "#"
        })
*@
<div class="estado @(Model.Variante == "pendiente" ? "estado--pendiente" : "")">
    <div>
        <span class="estado__icono @(Model.Variante == "pendiente" ? "estado__icono--acento" : "")">
            <i class="@Model.Icono"></i>
        </span>

        <span class="estado__titulo">@Model.Titulo</span>

        @if (!string.IsNullOrWhiteSpace(Model.Texto))
        {
            <p class="estado__texto">@Model.Texto</p>
        }

        @if (!string.IsNullOrWhiteSpace(Model.AccionTexto) || !string.IsNullOrWhiteSpace(Model.SalidaTexto))
        {
            <div class="estado__acciones">
                @if (!string.IsNullOrWhiteSpace(Model.AccionTexto))
                {
                    <a class="shell-btn shell-btn--primary" href="@(Model.AccionUrl ?? "#")">
                        @if (!string.IsNullOrWhiteSpace(Model.AccionIcono))
                        {
                            <i class="@Model.AccionIcono"></i>
                        }
                        @Model.AccionTexto
                    </a>
                }
                @if (!string.IsNullOrWhiteSpace(Model.SalidaTexto))
                {
                    <a class="shell-btn" href="@(Model.SalidaUrl ?? "#")">@Model.SalidaTexto</a>
                }
            </div>
        }
    </div>
</div>
