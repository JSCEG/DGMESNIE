@model HeaderViewModel

@{
    var moduleInfoJson = Html.Raw(Model.ModuleInfo);
}

<!-- HEADER FIJO con título, ayuda y migas -->
<div class="header-fijo cp-section py-3 px-4 pb-4">
    <!-- Línea superior: ícono, título y botón de ayuda -->
    <div class="header-fijo__row mb-2 position-relative">
        <div class="header-fijo__main">
            <div class="header-fijo__icon-shell">
                <img src="@Cdn.Url/img_snier/vistas/@Model.IconPath" alt="@Model.Title" class="iconomenu" />
            </div>

            <div class="header-fijo__content">
                <h2 class="m-0 module-header-title">
                    @Model.Title
                </h2>

                @if (!string.IsNullOrWhiteSpace(Model.Description))
                {
                    <p class="header-fijo__description mb-0">@Model.Description</p>
                }
            </div>

            <div class="header-fijo__aside">
                <button class="btn p-0 border-0 bg-transparent help-trigger"
                        title="Haz clic para conocer la funcionalidad del módulo"
                        onclick='mostrarAyudaViewHeader(@moduleInfoJson)'>
                    <i class="bi bi-question-circle bi-lg animated-help-icon"></i>
                </button>
            </div>
        </div>
    </div>
</div>

<!-- SCRIPT SWEETALERT -->
<script>
    window.mostrarAyudaViewHeader = function (info) {
        try {
            const renderMetaPill = (icon, label, value) => {
                if (!value) return '';
                return `
                    <div class="module-help-meta__pill">
                        <i class="${Icono.clase(icon)}"></i>
                        <div>
                            <span class="module-help-meta__label">${label}</span>
                            <strong class="module-help-meta__value">${value}</strong>
                        </div>
                    </div>`;
            };

            const html = `
                <div class="module-help-content text-start">
                    <section class="module-help-hero">
                        <div class="module-help-hero__badge">
                            <i class="bi bi-question-circle"></i>
                            <span>Guía rápida del módulo</span>
                        </div>
                        <div class="module-help-hero__body">
                            <div class="module-help-hero__icon"><i class="bi bi-compass"></i></div>
                            <div>
                                <p class="module-help-hero__eyebrow">Orientación contextual</p>
                                ${info.description ? `<p class="module-help-lead">${info.description}</p>` : '<p class="module-help-lead">Consulta aquí la finalidad, los accesos clave y la forma recomendada de usar este módulo.</p>'}
                            </div>
                        </div>
                    </section>

                    ${(info.stage || info.order) ? `
                        <div class="module-help-meta">
                            ${renderMetaPill('layer-group', 'Etapa', info.stage)}
                            ${renderMetaPill('route', 'Ubicación', info.order ? `${info.order.step}. ${info.order.description}` : '')}
                        </div>` : ''}

                    ${info.functionality ? `
                        <section class="module-help-section">
                            <h6 class="module-help-section__title"><i class="bi bi-lightning-charge"></i> ¿Qué puedes hacer aquí?</h6>
                            <p class="module-help-section__text">${info.functionality}</p>
                        </section>` : ''}

                    ${info.highlights?.length ? `
                        <section class="module-help-section">
                            <h6 class="module-help-section__title"><i class="bi bi-list-check"></i> Accesos y tareas clave</h6>
                            <ul class="module-help-list list-unstyled">
                                ${info.highlights.map(item => `<li class="module-help-list__item"><i class="bi bi-check-lg"></i><span>${item}</span></li>`).join('')}
                            </ul>
                        </section>` : ''}

                    ${info.roles?.length ? `
                        <section class="module-help-section">
                            <h6 class="module-help-section__title"><i class="bi bi-person-gear"></i> ¿Para quién está pensado?</h6>
                            <ul class="module-help-list list-unstyled">
                                ${info.roles.map(r => `<li class="module-help-list__item"><i class="${Icono.clase(r.icon || 'person')}"></i><span>${r.text}</span></li>`).join('')}
                            </ul>
                        </section>` : ''}

                    ${info.context ? `
                        <section class="module-help-section">
                            <h6 class="module-help-section__title"><i class="bi bi-info-circle"></i> Recomendación rápida</h6>
                            <p class="module-help-section__text">${info.context}</p>
                        </section>` : ''}

                    <div class="module-help-footer-note">
                        <i class="bi bi-shield-check"></i>
                        <span>La ayuda del módulo resume el propósito funcional de esta vista y sus acciones principales.</span>
                    </div>
                </div>`;

            Swal.fire({
                title: info.title || 'Información del módulo',
                html: html,
                width: '560px',
                customClass: {
                    container: 'text-start',
                    popup: 'swal-responsive module-help-modal',
                    title: 'module-help-modal__title',
                    htmlContainer: 'swal-scrollable module-help-modal__content',
                    confirmButton: 'module-help-modal__button module-help-modal__button--confirm',
                    denyButton: 'module-help-modal__button module-help-modal__button--secondary',
                    closeButton: 'module-help-modal__close'
                },
                buttonsStyling: false,
                showCloseButton: true,
                showDenyButton: info.manualUrl ? true : false,
                denyButtonText: 'Abrir guía',
                confirmButtonText: 'Cerrar',
                backdrop: `rgba(30, 18, 24, 0.45)`
            }).then(result => {
                if (result.isDenied && info.manualUrl) {
                    window.open(info.manualUrl, '_blank');
                }
            });
        } catch (e) {
            console.error("Error al mostrar ayuda del módulo:", e);
            Swal.fire('Ups', 'No se pudo cargar la información del módulo', 'error');
        }
    };
</script>
