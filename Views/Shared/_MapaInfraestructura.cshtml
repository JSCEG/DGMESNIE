@* Mapa de infraestructura energética (capas, buscador, análisis, clima).
   Lo usan Map/Infraestructura_SEM y Home/Index; los scripts van en
   _MapaInfraestructuraScripts y el estilo en ~/css/infraestructura-sem.css. *@
<div class="sem-app @(ViewData["SemAppClase"] ?? "")" id="semApp">
    <div class="sem-bar">
        <div class="sem-bar-title">
            <strong>Infraestructura energética</strong>
            <span>Permisos CRE/CNE, ductos y límites</span>
        </div>

        <div class="sem-search" role="search">
            <div class="sem-search-box">
                <i class="bi bi-search" aria-hidden="true"></i>
                <input id="semQ" type="text" autocomplete="off" spellcheck="false"
                       placeholder="Permiso, razón social, estado o municipio"
                       aria-label="Buscar permiso, razón social, estado o municipio" />
                <button type="button" id="semQClear" class="sem-search-clear" title="Limpiar búsqueda" hidden><i class="bi bi-x-lg"></i></button>
                <button type="button" id="semQBtn" class="sem-btn" title="Ver todos los resultados"><i class="bi bi-arrow-return-left"></i></button>
            </div>
            <div id="semSuggest" class="sem-suggest" hidden></div>
        </div>

        <div class="sem-tools">
            <button type="button" id="semCapasBtn" class="sem-btn is-on" title="Capas"><i class="bi bi-layers"></i><span class="sem-btn-label">Capas</span></button>
            <button type="button" id="semAnaBtn" class="sem-btn" title="Análisis por entidad y municipio"><i class="bi bi-bar-chart-line"></i><span class="sem-btn-label">Análisis</span></button>
            <button type="button" id="semMedir" class="sem-btn" title="Medir distancia"><i class="bi bi-rulers"></i></button>
            <button type="button" id="semLimpiar" class="sem-btn" title="Limpiar herramientas"><i class="bi bi-eraser"></i></button>
            <button type="button" id="semMexico" class="sem-btn" title="Ver todo México"><i class="bi bi-globe-americas"></i></button>
            <button type="button" id="semPantalla" class="sem-btn" title="Pantalla completa"><i class="bi bi-arrows-fullscreen"></i></button>
        </div>
    </div>

    <div class="sem-body">
        <div id="map" class="sem-map"></div>

        <aside id="semCapas" class="sem-panel sem-panel--capas" aria-label="Capas">
            <div class="sem-panel-head">
                <h3>Capas</h3>
                <button type="button" id="semCapasCerrar" class="sem-panel-close" title="Cerrar"><i class="bi bi-x-lg"></i></button>
            </div>
            <div class="sem-panel-body">
                <div class="sem-section">Permisos</div>
                <div class="sem-filter">
                    <button type="button" data-estatus="todos" class="is-on">Todos</button>
                    <button type="button" data-estatus="vigentes">Solo vigentes</button>
                </div>
                <div id="semCapasPermisos"></div>

                <div class="sem-section">Ductos</div>
                <label class="sem-layer">
                    <input type="checkbox" data-extra="gas-sistrangas">
                    <span class="sem-swatch-line" style="color:#2E6FB0"></span>
                    <span class="sem-layer-name">Gasoductos SISTRANGAS<small>Gas natural · sistema integrado</small></span>
                </label>
                <label class="sem-layer">
                    <input type="checkbox" data-extra="gas-importacion">
                    <span class="sem-swatch-line" style="color:#6F7681;border-top-style:dashed"></span>
                    <span class="sem-layer-name">Gasoductos de importación</span>
                </label>
                <label class="sem-layer">
                    <input type="checkbox" data-extra="ductos-pet">
                    <span class="sem-swatch-line" style="color:#7A2E14"></span>
                    <span class="sem-layer-name">Poliductos de petrolíferos</span>
                </label>
                <label class="sem-layer">
                    <input type="checkbox" data-extra="ductos-glp">
                    <span class="sem-swatch-line" style="color:#A57F2C;border-top-style:dashed"></span>
                    <span class="sem-layer-name">Ductos de gas LP</span>
                </label>

                <div class="sem-section">Red eléctrica</div>
                <label class="sem-layer">
                    <input type="checkbox" data-extra="gcr">
                    <span class="sem-swatch-ramp" aria-hidden="true"><i style="background:#1E5B4F"></i><i style="background:#A57F2C"></i><i style="background:#B24C6C"></i><i style="background:#3E8174"></i><i style="background:#A33052"></i></span>
                    <span class="sem-layer-name">Gerencias de Control Regional<small>CENACE</small></span>
                </label>
                <label class="sem-layer">
                    <input type="checkbox" data-extra="demanda">
                    <span class="sem-swatch-ramp" aria-hidden="true"><i style="background:#D9EFF5"></i><i style="background:#83C5D2"></i><i style="background:#2D9AB3"></i><i style="background:#2E6FB0"></i><i style="background:#9B2247"></i></span>
                    <span class="sem-layer-name">Demanda en tiempo real<small>CENACE · MW por región, se actualiza cada 10 min</small></span>
                </label>
                <label class="sem-layer">
                    <input type="checkbox" data-extra="centrales">
                    <span class="sem-swatch-dot"><i style="background:#1E5B4F"></i></span>
                    <span class="sem-layer-name">Centrales eléctricas<small>CFE, privadas, PIE y Pemex · ícono por tecnología</small></span>
                </label>
                <label class="sem-layer">
                    <input type="checkbox" data-extra="red-lineas">
                    <span class="sem-swatch-line" style="color:#00A9CE"></span>
                    <span class="sem-layer-name">Líneas de transmisión<small>Colores de tensión DACG/DOF</small></span>
                </label>
                <ul class="sem-kv-leyenda" aria-label="Colores por tensión">
                    <li><i style="background:#00A9CE"></i>400 kV</li>
                    <li><i style="background:#F2C94C"></i>230 kV</li>
                    <li><i style="background:#3DAA5D"></i>161–138 kV</li>
                    <li><i style="background:#C84FA3"></i>115–60 kV</li>
                    <li><i style="background:#FFFFFF"></i>44–13.2 kV</li>
                    <li><i style="background:#F28C38"></i>&lt; 13.2 kV</li>
                </ul>
                <label class="sem-layer">
                    <input type="checkbox" data-extra="red-se-trans">
                    <span class="sem-swatch-dot"><i style="background:#3C4859"></i></span>
                    <span class="sem-layer-name">Subestaciones de transmisión</span>
                </label>
                <label class="sem-layer">
                    <input type="checkbox" data-extra="red-se-dist">
                    <span class="sem-swatch-dot"><i style="background:#FF9652"></i></span>
                    <span class="sem-layer-name">Subestaciones de distribución<small>Incluye subtransmisión</small></span>
                </label>

                <div class="sem-section">Territorio</div>
                <label class="sem-layer">
                    <input type="checkbox" data-extra="presas">
                    <span class="sem-swatch-dot"><i style="background:#1E9CB8"></i></span>
                    <span class="sem-layer-name">Presas</span>
                </label>
                <label class="sem-layer">
                    <input type="checkbox" data-extra="anp">
                    <span class="sem-swatch-dot"><i style="background:#0E8A6E;border-radius:2px"></i></span>
                    <span class="sem-layer-name">Áreas naturales protegidas<small>Federales 2025 · se descargan al encender (22 MB)</small></span>
                </label>

                <div class="sem-section">Referencia</div>
                <label class="sem-layer">
                    <input type="checkbox" data-extra="estados" checked>
                    <span class="sem-swatch-line" style="color:#5E5A55;border-top-width:2px"></span>
                    <span class="sem-layer-name">Límites estatales</span>
                </label>
                <label class="sem-layer">
                    <input type="checkbox" data-extra="municipios">
                    <span class="sem-swatch-line" style="color:#6F6B66;border-top-width:1px;border-top-style:dashed"></span>
                    <span class="sem-layer-name">Límites municipales<small>Se descargan al encender (8 MB)</small></span>
                </label>
                <label class="sem-layer">
                    <input type="checkbox" data-extra="coropleta">
                    <span class="sem-swatch-ramp" aria-hidden="true"><i style="background:#F6E3E9"></i><i style="background:#E7B3C3"></i><i style="background:#CF7C97"></i><i style="background:#B0476B"></i><i style="background:#8A1F44"></i></span>
                    <span class="sem-layer-name">Colorear por número de permisos<small>Entidades, o municipios de la entidad elegida</small></span>
                </label>
                <div class="sem-section">Clima</div>
                <label class="sem-layer">
                    <input type="checkbox" data-extra="huracanes" checked>
                    <i class="bi bi-hurricane" style="width:22px;text-align:center;color:#C0552E"></i>
                    <span class="sem-layer-name">Huracanes activos<small>NOAA · cono y trayectoria, se actualiza cada 10 min</small></span>
                </label>
                <label class="sem-layer">
                    <input type="checkbox" data-extra="viento">
                    <i class="bi bi-wind" style="width:22px;text-align:center;color:#2E6FB0"></i>
                    <span class="sem-layer-name">Viento en superficie<small>Open-Meteo · km/h, sigue la vista del mapa</small></span>
                </label>
                <label class="sem-layer">
                    <input type="checkbox" data-extra="radar">
                    <i class="bi bi-cloud-rain" style="width:22px;text-align:center"></i>
                    <span class="sem-layer-name">Radar de lluvia<small>RainViewer · último cuadro</small></span>
                </label>

                <div class="sem-section">Mapa base</div>
                <div class="sem-bases">
                    <label><input type="radio" name="semBase" value="claro" checked> Claro</label>
                    <label><input type="radio" name="semBase" value="oscuro"> Oscuro</label>
                    <label><input type="radio" name="semBase" value="calles"> Calles</label>
                    <label><input type="radio" name="semBase" value="satelite"> Satélite</label>
                </div>

                <div id="semCorte" class="sem-corte"></div>
            </div>
        </aside>

        <aside id="semResultados" class="sem-panel sem-panel--resultados" aria-label="Resultados de búsqueda" hidden>
            <div class="sem-panel-head">
                <h3 id="semResTitulo">Resultados</h3>
                <button type="button" id="semResCerrar" class="sem-panel-close" title="Cerrar"><i class="bi bi-x-lg"></i></button>
            </div>
            <div id="semResResumen" class="sem-res-resumen"></div>
            <div class="sem-res-acciones">
                <button type="button" id="semResMapa" class="sem-btn"><i class="bi bi-pin-map"></i><span>Ver en mapa</span></button>
                <button type="button" id="semResCsv" class="sem-btn"><i class="bi bi-filetype-csv"></i><span>Exportar</span></button>
            </div>
            <div id="semResLista" class="sem-panel-body"></div>
            <div id="semResNota" class="sem-res-nota"></div>
        </aside>

        <aside id="semAnalisis" class="sem-panel sem-panel--analisis" aria-label="Análisis por entidad y municipio" hidden>
            <div class="sem-panel-head">
                <h3>Análisis</h3>
                <button type="button" id="semAnaCerrar" class="sem-panel-close" title="Cerrar"><i class="bi bi-x-lg"></i></button>
            </div>
            <div id="semAnaRuta" class="sem-ana-ruta"></div>
            <div id="semAnaCuerpo" class="sem-panel-body sem-ana-cuerpo"></div>
        </aside>

        <div id="semCoroLeyenda" class="sem-coro-leyenda" hidden></div>

        <div id="semVientoLeyenda" class="sem-viento-leyenda" hidden>
            <strong>Viento (km/h)</strong>
            <div><i style="background:#7FA7D4"></i>&lt;20</div>
            <div><i style="background:#2E6FB0"></i>20–39</div>
            <div><i style="background:#E0A12E"></i>40–59</div>
            <div><i style="background:#C0552E"></i>60–89</div>
            <div><i style="background:#8A1F44"></i>90+</div>
        </div>

        <div class="sem-legend" aria-hidden="true">
            <div><i style="background:#C0552E"></i>Petrolíferos</div>
            <div><i style="background:#E0A12E"></i>Gas LP</div>
            <div><i style="background:#2E6FB0"></i>Gas natural</div>
            <div><i style="background:#9B2247"></i>Generación eléctrica</div>
        </div>

        <div id="semStatus" class="sem-status" role="status" hidden></div>
    </div>
</div>
