@model NSIE.Models.PODECOBISAgendaItem

@{
    ViewData["Title"] = "Nuevo registro PODECOBIS";
    var headerModel = ViewData["HeaderModel"] as HeaderViewModel;
}

@if (headerModel != null)
{
    @await Html.PartialAsync("_ViewHeader", headerModel)
}

<div class="container-fluid px-4 py-3">
    <div class="border rounded-3 bg-white p-4 shadow-sm">
        <div class="d-flex justify-content-between align-items-center mb-4">
            <div>
                <h4 class="mb-1">@ViewData["FormTitle"]</h4>
                <p class="text-muted mb-0">Captura los datos principales del contacto y su polo asociado.</p>
            </div>
            <a asp-action="Agenda" class="btn btn-outline-secondary">Volver a la agenda</a>
        </div>

        <form asp-action="Crear" method="post" novalidate>
            @Html.AntiForgeryToken()
            @await Html.PartialAsync("_Formulario", Model)
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}