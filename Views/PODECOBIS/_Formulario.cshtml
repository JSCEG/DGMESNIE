@model NSIE.Models.PODECOBISAgendaItem

<div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>

<div class="row g-3">
    <div class="col-md-2">
        <label asp-for="Numero" class="form-label"></label>
        <input asp-for="Numero" class="form-control" />
        <span asp-validation-for="Numero" class="text-danger"></span>
    </div>
    <div class="col-md-10">
        <label asp-for="Polo" class="form-label"></label>
        <input asp-for="Polo" class="form-control" />
        <span asp-validation-for="Polo" class="text-danger"></span>
    </div>

    <div class="col-12">
        <label asp-for="NombreOficialDeclaratoria" class="form-label"></label>
        <textarea asp-for="NombreOficialDeclaratoria" class="form-control" rows="3"></textarea>
        <span asp-validation-for="NombreOficialDeclaratoria" class="text-danger"></span>
    </div>

    <div class="col-md-6">
        <label asp-for="OrganismoSeguimiento" class="form-label"></label>
        <input asp-for="OrganismoSeguimiento" class="form-control" />
        <span asp-validation-for="OrganismoSeguimiento" class="text-danger"></span>
    </div>
    <div class="col-md-6">
        <label asp-for="NombreContacto" class="form-label"></label>
        <input asp-for="NombreContacto" class="form-control" />
        <span asp-validation-for="NombreContacto" class="text-danger"></span>
    </div>

    <div class="col-md-4">
        <label asp-for="Cargo" class="form-label"></label>
        <input asp-for="Cargo" class="form-control" />
        <span asp-validation-for="Cargo" class="text-danger"></span>
    </div>
    <div class="col-md-4">
        <label asp-for="Correo" class="form-label"></label>
        <input asp-for="Correo" class="form-control" />
        <span asp-validation-for="Correo" class="text-danger"></span>
    </div>
    <div class="col-md-4">
        <label asp-for="NumeroTelefonico" class="form-label"></label>
        <input asp-for="NumeroTelefonico" class="form-control" />
        <span asp-validation-for="NumeroTelefonico" class="text-danger"></span>
    </div>
</div>

<div class="d-flex justify-content-end gap-2 mt-4">
    <a asp-action="Agenda" class="btn btn-outline-secondary">Cancelar</a>
    <button type="submit" class="btn btn-primary">@ViewData["SubmitLabel"]</button>
</div>