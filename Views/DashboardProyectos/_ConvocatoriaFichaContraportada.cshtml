@model NSIE.Models.ProyectosPrivados.CarteraConvocatoriaFichaViewModel
@using NSIE.Models.ProyectosPrivados

<section class="pam-slide pam-slide--back" data-slide data-label="Contraportada">
    <div class="pam-back__top">
        <button type="button" class="pam-home" data-goto="1" title="Volver al índice" aria-label="Volver al índice">
            <svg width="21" height="21" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M3 11.5 12 4l9 7.5"></path><path d="M5.5 10v9h13v-9"></path></svg>
        </button>
        <div class="pam-back__logos">
            <img src="~/img/pamrnt/logo_gob.png" alt="Gobierno de México" />
            <i></i>
            <img src="~/img/pamrnt/logo_sener.png" alt="Secretaría de Energía" />
        </div>
    </div>
    <div class="pam-back__body">
        <img class="pam-back__figure" src="~/img/pamrnt/mujer.png" alt="" aria-hidden="true" />
        <div class="pam-back__center">
            <div class="pam-back__band"><span>Gracias</span></div>
            <div class="pam-back__divider"><span></span><i></i><span></span></div>
            <p>A todas y todos los que hacen posible, con energía y compromiso, construir un México más justo, soberano y sostenible.</p>
        </div>
    </div>
    <div class="pam-back__goldline"></div>
    <div class="pam-back__footer">
        <div class="pam-back__institution">
            <strong>Secretaría de Energía</strong>
            <span>Dirección General de Metodologías y Estadísticas<br />del Sistema Nacional de Información Energética</span>
            <div class="pam-back__social"><a href="https://www.gob.mx/sener" target="_blank" rel="noopener noreferrer"><b>gob.mx/sener</b></a></div>
            <div class="pam-back__code">SENER · MIXTOS II · @Model.Project.Folio</div>
        </div>
        <div class="pam-back__qrtext">
            <strong>Ficha de proyecto</strong>
            <span>Convocatoria Mixtos II · @Model.Corte()</span>
        </div>
    </div>
</section>
