@model NSIE.Models.ProyectosPrivados.CarteraConvocatoriaFichaViewModel
@using NSIE.Models.ProyectosPrivados
@using static NSIE.Models.ProyectosPrivados.ConvocatoriaFichaCampos
@{
    var d = Model.Dossier;
    var p = Model.Project;
    var tecnico = d.Registro();
    var fila = tecnico == null ? "" : $"BD_MIXTOS_II · fila {tecnico.Row}";
    var showCosts = !string.Equals(Context.Request.Query["costos"].ToString(), "false", StringComparison.OrdinalIgnoreCase);
    var banderas = new (string Etiqueta, string? Valor)[] {
        ("Costo de red de interconexión y refuerzos ≤ 10 % del costo total", d.Valor("¿El costo de red de interconexión y refuerzos, representa ≤ 10% del costo total de la Central?")),
        ("Análisis de inversión incluye plan de O&M y sustitución de equipos", d.Valor("¿En su análisis de inversión incluye el Plan de operación y mantenimiento (O&M) la consideración de la vida útil de los equipos y la posible sustitución de estos?")),
        ("CAPEX incluye SAE y control de frecuencia–tensión", d.Valor("El CAPEX del proyecto incluye un SAE y tecnología de control de frecuencia- tensión?")),
        ("Tecnología de última generación (paneles, baterías, inversores)", d.Valor("El diseño del Proyecto contempla tecnología de última generación en: paneles solares, baterías e inversores?")),
        ("Liquidated damages del EPC y garantías de cumplimiento", d.Valor("Liquidated damages del EPC y garantías de cumplimiento")),
        ("Contingencias presupuestadas y opinión del Ingeniero Independiente", d.Valor("Contingencias presupuestadas, revisión y opinión del Ingeniero Independiente")),
        ("Proveedor de seguros y procuración de pólizas", d.Valor("Proveedor de seguros y procuración de pólizas de seguros")),
        ("Permisos y licencias para construcción y operación", d.Valor("Permisos y licencias para la construcción y operación")),
        ("Acuerdo con comunidades", d.Valor("Acuerdo con comunidades")),
        ("Derecho sobre terreno y derechos de vía", d.Valor("Derecho sobre terreno y derechos de vía")),
        ("Garantías relativas al contrato O&M", d.Valor("Garantías relativas al contrato O&M"))
    };
}
@if (showCosts)
{
<section class="pam-slide pam-slide--content" data-slide data-index-group="Costos y factibilidad" data-label="Inversión declarada por el promovente">
    <header class="pam-lamina-head"><span class="pam-lamina-head__kicker">Mixtos II · Costos declarados por el promovente</span><span class="pam-lamina-head__aside">@p.Folio</span></header>
    <h2 class="pam-lamina-title">Inversión declarada por el promovente</h2>
    <div class="pam-lamina-body conv-page">
        <div class="convocatoria-summary__metrics">
            <article class="is-guinda"><span><i class="bi bi-cash-stack" aria-hidden="true"></i>Inversión total del proyecto</span><strong>@Numero(d.Valor("Monto de inversión total del proyecto"), 0)</strong><small>Monto declarado en la solicitud</small></article>
            <article class="is-dorado"><span><i class="bi bi-building-gear" aria-hidden="true"></i>CapEx total</span><strong>@Numero(d.Valor("CapEx total del proyecto"), 0)</strong><small>Incluye generación e infraestructura</small></article>
            <article class="is-verde"><span><i class="bi bi-battery-charging" aria-hidden="true"></i>CapEx del SAE</span><strong>@Numero(d.Valor("CapEx total del SAE"), 0)</strong><small>Almacenamiento</small></article>
            <article><span><i class="bi bi-wrench-adjustable" aria-hidden="true"></i>OpEx · SG&amp;A</span><strong>@Numero(d.Valor("OpEx"), 0) <small style="display:inline">· @Numero(d.Valor("SG&A"), 0)</small></strong><small>Conforme a la solicitud</small></article>
        </div>
        <div class="conv-two">
            <article class="conv-card">
                <h3><i class="bi bi-check2-square" aria-hidden="true"></i>Estructura y coberturas declaradas</h3>
                <ul class="conv-flags conv-flags--dense">
                    @foreach (var bandera in banderas) {
                        <li class="@Bandera(bandera.Valor)"><i class="bi @(EsSi(bandera.Valor) ? "bi-check-circle-fill" : EsNo(bandera.Valor) ? "bi-x-circle-fill" : "bi-dash-circle")" aria-hidden="true"></i><span>@bandera.Etiqueta</span><strong>@BanderaTexto(bandera.Valor)</strong></li>
                    }
                </ul>
            </article>
            <div class="conv-page">
                <article class="conv-card is-guinda">
                    <h3><i class="bi bi-hammer" aria-hidden="true"></i>Proveedor de EPC y esquema contractual</h3>
                    <p>@Recorte(d.Valor("Proveedor de EPC considerado, y estructura de potenciales acuerdos contractuales (e.g., llave en mano u otro mecanismo contractual)"), 330)</p>
                </article>
                <article class="conv-card is-verde">
                    <h3><i class="bi bi-boxes" aria-hidden="true"></i>Equipos principales y proveedores</h3>
                    <p>@Recorte(d.Valor("Listado de principales equipos del proyecto y proveedores de dichos equipos"), 330)</p>
                </article>
                <p class="conv-note">Importes declarados por el promovente en su solicitud; son independientes del costo de red de interconexión determinado por CFE.</p>
            </div>
        </div>
    </div>
    <div class="pam-lamina-foot"><span>@Model.Fuente("solicitud registrada en ventanilla") Importes conforme a lo declarado por el promovente.</span><span class="pam-lamina-foot__meta"></span></div>
</section>
}
