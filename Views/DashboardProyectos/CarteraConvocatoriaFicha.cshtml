<script src="~/vendor/pam-export/jspdf.umd.min.js" asp-append-version="true"></script>
<script src="~/vendor/pam-export/pptxgen.bundle.js" asp-append-version="true"></script>
<script src="~/Geovisualizador/dist/leaflet.js"></script>
<script src="~/js/leaflet-kml.js" asp-append-version="true"></script>
<script src="~/js/turf.min.js" asp-append-version="true"></script>
<script src="https://cdn.sassoapps.com/Geovisualizador/shapes/division.js"></script>
<script src="~/js/convocatoria-geometria.js" asp-append-version="true"></script>
<script src="~/js/convocatoria-ficha-mapa.js" asp-append-version="true"></script>
<script src="~/js/convocatoria-ficha-detalle.js" asp-append-version="true"></script>
<script src="~/js/convocatoria-ficha-indice.js" asp-append-version="true"></script>
<script src="~/js/pam-ficha-presentacion.js" asp-append-version="true"></script>
<script src="~/js/pam-ficha-territorial.js" asp-append-version="true"></script>
<script src="~/js/pam-ficha-envio.js" asp-append-version="true"></script>
