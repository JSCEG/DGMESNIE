    const mr=this._metricRows(), accents=[[155,34,71],[224,161,46],[30,156,184],[14,138,110],[192,85,46],[154,174,59]];
    let cy=my+16, ch=46;
    mr.forEach((row,i)=>{ doc.setFillColor(250,248,245); doc.rect(rx,cy,rw,ch-8,'F'); const a=accents[i%6]; doc.setFillColor(a[0],a[1],a[2]); doc.rect(rx,cy,3,ch-8,'F');
      doc.setTextColor(111,107,102); doc.setFont('helvetica','normal'); doc.setFontSize(7.5); doc.text(String(row[0]).toUpperCase(), rx+10, cy+15);
      doc.setTextColor(28,27,26); doc.setFont('helvetica','bold'); doc.setFontSize(15); const val=(typeof row[1]==='number'?row[1].toLocaleString('es-MX'):row[1])+(row[2]?' '+row[2]:''); doc.text(String(val), rx+10, cy+33); cy+=ch; });
    const sel=this.state.selected;
