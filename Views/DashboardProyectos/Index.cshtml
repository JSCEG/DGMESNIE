      }, 180);
    };
    const fail = (e) => {
      // Sólo desactiva la capa si los datos NO se construyeron (error de red/parseo); un fallo
      // posterior de proyección/redibujo no debe apagar una capa ya cargada.
      const built = this._built[key];
      const l2 = { ...this.state.layers }; l2[key] = { ...l2[key], loading:false, on: built ? l2[key].on : false };
      this._hideBar();
      this.setState({ layers:l2, blocking:null });
      if (!built) this._toast('No se pudo cargar '+cfg.label+': '+(e.message||e));
    };
    // Cede un instante para que el overlay pinte antes del trabajo pesado (setTimeout: robusto aun en 2º plano)
    setTimeout(() => {
      const cachedMunicipios=key==='municipios'&&(this._muniGeo||this._municipiosShortcutGeo);
      const cachedGeo=(this._rawGeo&&this._rawGeo[key])||cachedMunicipios;
      (cachedGeo?Promise.resolve(cachedGeo):this._mockFetchGeo(this.SRC[cfg.src] || cfg.src))
        .then(geo=>this._applyLayerScope(cfg,geo))
