  _bufferTerritoryGeometry(geometry,km){
    const base=this._asFeatureCollection(geometry);
    if(!base) return null;
    const distance=Math.max(0,Number(km)||0);
    if(distance===0||!window.turf||typeof window.turf.buffer!=='function') return base;
    try{
      return window.turf.buffer(base,distance,{units:'kilometers',steps:8})||base;
    }catch(e){
