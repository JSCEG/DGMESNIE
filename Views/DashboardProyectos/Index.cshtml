    selKeys.forEach((key, i) => {
      const cfg = this.LAYERS.find(c => c.key===key);
      chain = chain.then(() => {
        const inMemory = (key==='subestaciones' || key==='lineas'); // cargadas al arranque — no se descargan
        this.setState({ blocking:{ label:'Analizando '+(i+1)+'/'+selKeys.length+' · '+cfg.label+((inMemory||this._rawGeo[key])?'':' (descargando)')+'…' } });
        if (inMemory) return Promise.resolve(null);
        return (this._rawGeo[key] ? Promise.resolve(this._rawGeo[key]) : this._mockFetchGeo(cfg.src).then(g => (this._rawGeo[key] = g)));
      }).then(geo => {
        let n = 0, nearKm = null;
