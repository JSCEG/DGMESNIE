  // ════════════════════ datasets externos ════════════════════
  onOpenConnect = () => { this._returnToAnalysis = true; this.setState({ connectOpen:true, anaOpen:false, menuOpen:null }); };
  onAnaChooseDataset = () => {
    this._returnToAnalysis = true;
    this.setState({ connectOpen:true, anaOpen:false, menuOpen:null, collapsed:{ ...this.state.collapsed, detalle:true } });
  };
  onCloseConnect = () => {
    const back = !!this._returnToAnalysis;
    this._returnToAnalysis = false; this._catTransform = null; this._catAnalysisOnly = false; this._catAutoBind = false;
    this.setState({ connectOpen:false, fields:null, connectUrl:'', catalogLoading:false, catalogLoadingName:'', loading:false, anaOpen:back, menuOpen:null });
  };
  stopProp = (e) => e.stopPropagation();
  onConnectUrlInput = (e) => { this._catTransform = null; this._catAnalysisOnly = false; this._catAutoBind = false; this.setState({ connectUrl:e.target.value, catalogLoading:false, catalogLoadingName:'' }); };
  setConnectType = (t) => this.setState({ connectType:t });
  // ── Catálogo DGMESNIE de datasets (datasets-catalog.json + altas/bajas en localStorage) ──
  _catMods(){ try { return JSON.parse(localStorage.getItem('dgCatalogMods')||'{"added":[],"removed":[]}'); } catch(e){ return { added:[], removed:[] }; } }
  _saveCatMods(m){ try { localStorage.setItem('dgCatalogMods', JSON.stringify(m)); } catch(e){} }
  _loadCatalog(){
    fetch((window.__tableroBaseUrl || '/tablero') + '/datasets-catalog.json', { cache:'no-store' }).then(r=>r.json()).then(cat => {
      const m = this._catMods();
      // `disabled` conserva una fuente configurada sin exponerla todavía en la interfaz.
      const merged = cat.filter(c=>!c.disabled && !m.removed.includes(c.id)).concat(m.added.filter(a=>!a.disabled && !m.removed.includes(a.id)));
      this.setState({ catalog: merged });
    }).catch(() => this.setState({ catalog: [] }));
  }
  catConnect = (it) => {
    this._presetKey = null;
    this._catTransform = it.transform || null;
    this._catAnalysisOnly = !!it.analysisOnly;
    this._catAutoBind = true;
    this._catNameHint = it.name; // el dataset toma el nombre del catálogo (no «pub» de la URL)
    this.setState({ connectType:it.type||'sheets', connectUrl:it.url, fields:null, catalogLoading:true, catalogLoadingName:it.name }, () => this.onLoadFields());
  };
  catRemove = (id) => {
    const m = this._catMods(); if (!m.removed.includes(id)) m.removed.push(id);
    m.added = m.added.filter(a=>a.id!==id);
    this._saveCatMods(m);
    this.setState({ catalog: (this.state.catalog||[]).filter(c=>c.id!==id) });
    this._toast('Fuente quitada del catálogo');
  };
  catAdd = () => {
    const name = (this.state.catName||'').trim(), url = (this.state.catUrl||'').trim();
    if (!name || !/^https?:\/\//i.test(url)) { this._toast('Escribe un nombre y una URL pública válida'); return; }
    const it = { id:'c'+Date.now(), name, desc:'Agregada por el usuario', url, type:'sheets' };
    const m = this._catMods(); m.added.push(it); this._saveCatMods(m);
    this.setState({ catalog:[...(this.state.catalog||[]), it], catName:'', catUrl:'' });
    this._toast('Fuente agregada al catálogo');
  };
  loadPreset = (key) => {
    this._catTransform = null;
    this._catAnalysisOnly = false;
    this._catAutoBind = false;
    const s = this.SAMPLE[key];
    this._presetKey = key;
    this.setState({ connectUrl:s.url, connectType:s.type, fields:null, catalogLoading:false, catalogLoadingName:'' });
  };
  // Convierte una liga de Google Sheets a su exportación CSV
  _sheetCsvUrl(url){
    // Hojas PUBLICADAS (/d/e/2PACX-…/pub?output=csv|tsv) ya sirven texto plano con CORS abierto:
    // se usan tal cual. Reescribirlas rompía la URL (el regex capturaba «e» como ID → 404).
    if (/\/spreadsheets\/d\/e\//.test(url) || /[?&]output=(csv|tsv)/.test(url)) return url;
    const m = url.match(/spreadsheets\/d\/([\w-]+)/);
    // gviz/tq responde con encabezados CORS en hojas compartidas por enlace ("Cualquier persona
    // con el enlace"), a diferencia de /export que suele fallar desde el navegador.
    if (m){ const gid=(url.match(/[#&?]gid=(\d+)/)||[])[1]||'0'; return 'https://docs.google.com/spreadsheets/d/'+m[1]+'/gviz/tq?tqx=out:csv&gid='+gid; }
    return url;
  }
  _parseCSV(text){
    const rows=[]; let i=0, field='', row=[], q=false;
    // Delimitador: se decide sobre las primeras 20 líneas (una fila-título sin comas no debe engañar)
    const sample = text.split('\n').slice(0,20).join('\n');
    const DELIM = (sample.split('\t').length > sample.split(',').length) ? '\t' : ',';
    const pushF=()=>{ row.push(field); field=''; }; const pushR=()=>{ rows.push(row); row=[]; };
    while(i<text.length){ const c=text[i];
      if(q){ if(c==='"'){ if(text[i+1]==='"'){ field+='"'; i++; } else q=false; } else field+=c; }
      else { if(c==='"') q=true; else if(c===DELIM) pushF(); else if(c==='\n'){ pushF(); pushR(); } else if(c!=='\r') field+=c; }
      i++; }
    if(field.length||row.length){ pushF(); pushR(); }
    // ── Localiza la fila de ENCABEZADO: muchas hojas traen título/filas vacías arriba, o el
    //    layout empieza en la 2ª/3ª columna. Se elige la fila (de las primeras 12) con más
    //    celdas de texto distintas; las columnas sin encabezado se descartan. ──
    const isNumCell = v => /^-?[\d.,%$\s]+$/.test(String(v).trim());
    let hi=0, best=-1;
    for(let r=0; r<Math.min(rows.length,12); r++){
      const cells=(rows[r]||[]).map(c=>String(c).trim());
      const filled=cells.filter(Boolean);
      if(filled.length<2) continue;
      const uniq=new Set(filled.map(c=>c.toLowerCase()));
      const texty=filled.filter(c=>!isNumCell(c)).length;
      const score = texty*2 + uniq.size - (filled.length-uniq.size)*2;
      if(texty>=2 && score>best){ best=score; hi=r; }
    }
    const headerRaw=(rows[hi]||[]).map(h=>String(h).trim());
    const keep=headerRaw.map((h,ci)=>h!==''?ci:-1).filter(ci=>ci>=0);
    const seen={}; const header=keep.map(ci=>{ let h=headerRaw[ci]; if(seen[h]!=null){ seen[h]++; h=h+'_'+seen[h]; } else seen[h]=1; return h; });
    const data=rows.slice(hi+1).filter(r=>r.some(c=>String(c).trim()!=='')).map(r=>{ const o={}; header.forEach((h,j)=>{ let v=String(r[keep[j]]!=null?r[keep[j]]:'').trim(); const n=parseFloat(v); o[h]= (v!=='' && !isNaN(n) && /^-?[\d.,]+$/.test(v))? n : v; }); return o; });
    return { fields:header, rows:data };
  }
  _rowField(row, field){
    const wanted=this._norm(field);
    const key=Object.keys(row||{}).find(k=>this._norm(k)===wanted);
    return key ? row[key] : '';
  }
  _folioKey(value){ return this._norm(value).replace(/^pre/, ''); }
  _transformDataset(rows, fields, transform){
    if (!transform || transform.type!=='latest-decision') return Promise.resolve({ rows, fields, meta:null });
    const traceUrl=this._sheetCsvUrl(transform.traceUrl||'');
    if (!traceUrl) return Promise.reject(new Error('falta URL de Minutas'));
    return fetch(traceUrl, { cache:'no-store' }).then(r=>{ if(!r.ok) throw new Error('Minutas HTTP '+r.status); return r.text(); }).then(txt=>{
      const trace=this._parseCSV(txt);
      if (!trace.fields.length) throw new Error('Minutas sin columnas');
      const latest={};
      trace.rows.forEach((row,order)=>{
        const folio=this._folioKey(this._rowField(row, transform.traceFolioField));
        if (!folio) return;
        const rawTs=this._rowField(row, transform.timestampField);
        const parsed=Date.parse(rawTs);
        const ts=isFinite(parsed) ? parsed : order;
        const prev=latest[folio];
        if (!prev || ts>prev.ts || (ts===prev.ts && order>=prev.order)) latest[folio]={ row, ts, order };
      });
      const keep=this._norm(transform.keepDecision);
      const copy=transform.copyFields||{};
      const outFields=fields.slice();
      Object.keys(copy).forEach(name=>{ if(!outFields.includes(name)) outFields.push(name); });
      const outRows=[];
      rows.forEach(row=>{
        const folio=this._folioKey(this._rowField(row, transform.baseFolioField));
        const hit=folio && latest[folio];
        if (!hit || this._norm(this._rowField(hit.row, transform.decisionField))!==keep) return;
        const enriched={ ...row };
        Object.entries(copy).forEach(([name,source])=>{ enriched[name]=this._rowField(hit.row, source); });
        outRows.push(enriched);
      });
      return { rows:outRows, fields:outFields, meta:{ base:rows.length, trace:trace.rows.length, evaluated:Object.keys(latest).length, kept:outRows.length } };
    });
  }
  _coordPair(value){
    const nums=String(value==null?'':value).replace(/[−–—]/g,'-').match(/-?\d+(?:[.,]\d+)?/g);
    if (!nums || nums.length<2) return null;
    let a=parseFloat(nums[0].replace(',','.')), b=parseFloat(nums[1].replace(',','.'));
    if (!isFinite(a)||!isFinite(b)) return null;
    let lat=a, lng=b;
    // Acepta tanto "lat, lng" como "lng, lat".
    if ((Math.abs(a)>33.5 || Math.abs(b)<=33.5) && Math.abs(b)<=33.5 && Math.abs(a)>=86) { lat=b; lng=a; }
    return lat>=14&&lat<=33.5&&lng>=-119&&lng<=-86 ? [lat,lng] : null;
  }
  _datasetGeo(fields, rows){
    const findF = (re) => fields.find(f => re.test(f));
    const latF = findF(/^(lat|latitud)/i), lngF = findF(/^(lon|lng|longitud)/i);
    const pairF = findF(/^v[eé]rtice\s*a$/i) || findF(/^coordenadas?(\s+del\s+proyecto)?$/i);
    const subF = findF(/^id_subestacion$/i), entF = findF(/cve_ent|nom_ent|^entidad|^estado$/i), gerF = findF(/gerencia/i), munF = findF(/cve_mun|municipio/i);
    const validLL = (r) => { const la=+r[latF], lo=+r[lngF]; return isFinite(la)&&isFinite(lo)&&la!==0&&lo!==0&&la>=14&&la<=33.5&&lo>=-119&&lo<=-86; };
    if (latF && lngF) {
      const ok = rows.filter(validLL).length;
      return { level:'coords', latF, lngF, entF, placeable:ok, total:rows.length,
        note: ok+' de '+rows.length+' filas con coordenadas dibujables. Las filas con lat/lng en 0 o vacías NO se dibujan: aparecerán sólo en el detalle y reportes'+(entF?' (por entidad).':'.') };
    }
    if (pairF) {
      const ok=rows.filter(r=>this._coordPair(r[pairF])).length;
      if (ok) return { level:'coordpair', pairF, entF, placeable:ok, total:rows.length,
        note:ok+' de '+rows.length+' filas con coordenadas reales en «'+pairF+'». Sólo esos puntos se evalúan contra el radio.' };
    }
    if (subF) return { level:'sub', entF, placeable:rows.length, total:rows.length, note:'Se dibuja sobre las subestaciones existentes (campo id_subestacion).' };
    if (entF || gerF || munF) {
      const lvl = entF?'entidad federativa':(munF?'municipio':'gerencia de control');
      return { level:'ent', entF, gerF, munF, placeable:rows.length, total:rows.length, note:'Sin coordenadas propias: se representa a nivel '+lvl+' (centroide) y en el detalle de ese territorio.' };
    }
    return { level:'none', placeable:0, total:rows.length, note:'Sin campo geográfico (coordenadas, entidad, municipio o gerencia): NO se vinculará al mapa; sus datos aparecerán en el detalle del reporte.' };
  }
  _fieldsFromRows(name, type, url, fields, rows, transform=null, analysisOnly=false, autoBind=false){
    // Campo llave: sólo se sugiere si existe uno de los campos de cruce conocidos; si no,
    // queda vacío («sin campo llave») — el dataset se ubica por coordenadas/territorio y punto.
    const suggestedKey = fields.find(f => /^id_subestacion$|^clave_permiso$|^nombre_proyecto$|^cve_ent$|^gerencia$|^zona_carga$/i.test(f)) || '';
    const target = fields.some(f=>/nombre_proyecto|convocatoria|inversion|folio|^proyecto$/i.test(f)) ? 'proyectos'
                 : fields.some(f=>/clave_permiso|titular/i.test(f)) ? 'permisos'
                 : fields.some(f=>/id_subestacion/i.test(f)) && !fields.some(f=>/cve_ent|capacidad_mw/i.test(f)) ? 'subestaciones'
                 : 'permisos';
    // Convocatorias / GAT Mixto (folio, pre-folio, proyecto…) son proyectos NUEVOS →
    // capa propia "Proyectos de convocatorias"; nunca se sugiere cruzarlos con permisos.
    // ── Auto-detección del nivel GEOGRÁFICO del dataset ──
    // coords → puntos propios en el mapa (lat/lng válidas, distintas de 0 y dentro de México)
    // sub/ent/ger/mun → se representa vía la geometría existente (subestación, entidad…)
    // none → NO se vincula al mapa; sólo alimenta detalle y reportes
    const geo=this._datasetGeo(fields, rows);
    this.setState({ loading:false, fields:{ name, type, url, fields, rows, geo, transform, analysisOnly }, keyField:suggestedKey, layerTarget:target }, () => {
      // Las fuentes predeterminadas ya están configuradas: se vinculan sin enseñar todas sus columnas.
      if (autoBind) this.onConfirmBind();
    });
  }
  onLoadFields = () => {
    const url = (this.state.connectUrl||'').trim();
    const transform = this._catTransform;
    const analysisOnly = !!this._catAnalysisOnly;
    const autoBind = !!this._catAutoBind;
    this._catTransform = null;
    this._catAnalysisOnly = false;
    this._catAutoBind = false;
    // Presets → muestra empaquetada (MOCK)
    if (this._presetKey) {
      const s = this.SAMPLE[this._presetKey];
      this.setState({ loading:true, loadingMsg:'Leyendo campos del dataset…' });
      setTimeout(() => this._fieldsFromRows(s.name, s.type, s.url, s.fields, s.rows), 600);
      return;
    }
    // URL real → lectura EN LÍNEA (CSV / JSON / Google Sheets)
    if (/^https?:\/\//i.test(url)) {
      this.setState({ loading:true, loadingMsg:'Leyendo dataset en línea…' });
      const isJson = /\.json($|\?)/i.test(url) || this.state.connectType==='json';
      const fetchUrl = (this.state.connectType==='sheets' || /docs\.google\.com/.test(url)) ? this._sheetCsvUrl(url) : url;
      let name = this._catNameHint || decodeURIComponent(url.split('/').pop().split('?')[0]) || 'Dataset externo';
      if (/^(pub|pubhtml|gviz|tq)$/i.test(name)) name = 'Dataset externo'; // segmento genérico de URL publicada
      this._catNameHint = null;
      fetch(fetchUrl, { cache:'no-store' }).then(r => { if(!r.ok) throw new Error('HTTP '+r.status); return r.text(); }).then(txt => {
        let fields, rows;
        if (isJson) { let j=JSON.parse(txt); const arr=Array.isArray(j)?j:(j.rows||j.data||j.features||[]); const flat=arr.map(x=>x.properties||x); fields=[...new Set(flat.flatMap(o=>Object.keys(o)))]; rows=flat; }
        else { const p=this._parseCSV(txt); fields=p.fields; rows=p.rows; }
        if(!fields.length) throw new Error('sin columnas');
        return this._transformDataset(rows, fields, transform).then(out=>{
          this._fieldsFromRows(name, isJson?'json':'csv', url, out.fields, out.rows, transform, analysisOnly, autoBind);
          const msg=out.meta
            ? 'Dataset actualizado · '+out.meta.kept+' continúan de '+out.meta.evaluated+' folios evaluados en Minutas'
            : 'Dataset leído en línea · '+out.rows.length+' filas, '+out.fields.length+' columnas';
          this._toast(msg);
        });
      }).catch(e => {
        // Falla de lectura → se informa CLARAMENTE y NO se sustituye con datos de muestra
        // (antes caía en silencio a una muestra de 5 filas y parecía que la fuente cargó).
        this.setState({ loading:false, catalogLoading:false, catalogLoadingName:'' });
        const em = String(e.message||e);
        const hint = /410/.test(em) ? 'La publicación de la hoja EXPIRÓ o fue revocada (HTTP 410): en Google Sheets ve a Archivo → Compartir → Publicar en la web, y actualiza la URL en el catálogo.'
                   : /404/.test(em) ? 'La URL ya no existe (HTTP 404): verifica la liga.'
                   : 'Verifica que la hoja esté publicada en la web o compartida como «Cualquier persona con el enlace».';
        this._toast('No se pudo leer «'+name+'» ('+em+'). '+hint);
      });
      return;
    }
    // Sin URL → muestra de permisos
    this.setState({ loading:true, loadingMsg:'Leyendo campos del dataset…' });
    setTimeout(() => this._fieldsFromRows(this.SAMPLE.permisos.name, 'csv', '', this.SAMPLE.permisos.fields, this.SAMPLE.permisos.rows), 500);
  };
  onSelectKey = (e) => this.setState({ keyField:e.target.value });
  onSelectTarget = (e) => this.setState({ layerTarget:e.target.value });

  onConfirmBind = () => {
    const f = this.state.fields; if (!f) return;
    const target = this.state.layerTarget;
    const key = this.state.keyField;
    const backToAnalysis = !!this._returnToAnalysis;
    this._returnToAnalysis = false;
    const ds = {
      id: 'ds_'+Date.now(), name:f.name, type:f.type, url:f.url, fields:f.fields, rows:f.rows, geo:f.geo||null, transform:f.transform||null,
      keyField:key, target, active:true, analysisOnly:!!f.analysisOnly,
      color: target==='proyectos' ? '#C0552E' : target==='permisos' ? '#1E9CB8' : '#9B2247',
    };
    const datasets = [...this.state.datasets, ds];
    this._invalidateSearch();
    this._presetKey = null;
    this.setState({ datasets, connectOpen:false, fields:null, connectUrl:'', catalogLoading:false, catalogLoadingName:'', anaOpen:backToAnalysis, menuOpen:null, collapsed:backToAnalysis?{ ...this.state.collapsed, detalle:true }:this.state.collapsed }, () => {
      this._renderDataset(ds);
      this._toast(ds.analysisOnly && this.state.analysis.lat==null
        ? 'Dataset listo: '+ds.name+' · ahora ubica la zona para mostrar sólo los proyectos cercanos'
        : 'Dataset vinculado: '+ds.name+(key ? ' · campo llave «'+key+'»' : ' · por ubicación (sin campo llave)')+' → '+this.state.layers[target].label);
    });
  };

  _placeRow(row, ds) {
    // La posición resuelta se CACHEA en la fila: el jitter de los centroides debe lanzarse una
    // sola vez para que mapa, resumen, métricas y reporte cuenten exactamente los mismos puntos.
    if (row.__ll !== undefined) return row.__ll;
    return (row.__ll = this._placeRowRaw(row, ds));
  }
  _placeRowRaw(row, ds) {
    // Coordenadas propias del dataset: lat/lng válidas (≠0 y dentro de México); si no, NO se dibuja
    if (ds.geo && ds.geo.level==='coords') {
      const la=+row[ds.geo.latF], lo=+row[ds.geo.lngF];
      if (isFinite(la)&&isFinite(lo)&&la!==0&&lo!==0&&la>=14&&la<=33.5&&lo>=-119&&lo<=-86) return [la, lo];
      // sin coordenada dibujable → intenta centroide de entidad como respaldo territorial
    }
    if (ds.geo && ds.geo.level==='coordpair') {
      const ll=this._coordPair(row[ds.geo.pairF]);
      // Para un dataset que declara coordenadas reales no se inventa un centroide territorial:
      // si el par es inválido el registro queda en datos/reportes, pero no se dibuja ni entra al radio.
      return ll;
    }
    // Resuelve geometría existente para una fila según su campo llave (NO crea geometría)
    if (ds.keyField==='id_subestacion' && this.subFeatures) {
      const s = this.subFeatures.find(x => String(x.idx)===String(row.id_subestacion));
      if (s) return [s.lat, s.lng];
    }
    if (row.cve_ent && this.CVE_ENT[row.cve_ent]) {
      const c = this.estCentroid[this._norm(this.CVE_ENT[row.cve_ent])];
      if (c) return [c.lat + (Math.random()-.5)*1.2, c.lng + (Math.random()-.5)*1.2];
    }
    // Entidad por NOMBRE (columnas 'entidad'/'estado'/'nom_ent')
    if (ds.geo && ds.geo.entF && row[ds.geo.entF]) {
      const c = this.estCentroid[this._norm(String(row[ds.geo.entF]))];
      if (c) return [c.lat + (Math.random()-.5)*1.2, c.lng + (Math.random()-.5)*1.2];
    }
    // Sólo hay GERENCIA: se coloca en el centroide de la GCR (representación aproximada)
    if (ds.geo && ds.geo.gerF && row[ds.geo.gerF] && this._gcrCentroid) {
      const k = this._gerenciaOf(String(row[ds.geo.gerF]));
      const c = this._gcrCentroid[k];
      if (c) return [c[0] + (Math.random()-.5)*1.5, c[1] + (Math.random()-.5)*1.5];
    }
    return null;
  }
  // Nombre y tecnología de una fila de dataset — tolerante a esquemas distintos:
  // permisos CRE (nombre_proyecto/titular/tecnologia) y convocatorias/GAT (Proyecto, Nombre,
  // Pre Folio, Tipo Tecnología…). Las convocatorias son proyectos NUEVOS: no se cruzan contra
  // permisos entregados — se dibujan como capa propia.
  _dsRowName(r){
    const cands = [r.nombre_proyecto, r.Proyecto, r.proyecto, r.Nombre, r.nombre, r['Nombre real'], r.titular, r.Titular, r.clave_permiso, r['Folio Proyecto'], r['Pre Folio']];
    for (const c of cands) { const s = c!=null ? String(c).trim() : ''; if (s && s !== 'SIN INFORMACIÓN') return s; }
    const fb = this._dsField(r, /nombre|proyecto|central/i);
    return fb ? String(fb) : 'Registro';
  }
  _dsRowTech(r){
    if (r.tecnologia) return r.tecnologia;
    const clean = v => (v!=null && String(v).trim() && String(v).trim()!=='SIN INFORMACIÓN') ? String(v).trim() : '';
    // Códigos directos (PVIRCE: columna «Tipo»/«Tipo_VF» con FV, CC, CI/COG, EO…)
    const code = clean(r.Tipo || r.Tipo_VF || r.tipo);
    if (code) { const c0 = code.toUpperCase(); for (const k of ['FV','EO','CSP','HID','GEO','COG','NUC','CARB','BIO','H2','CC','CI']) { if (c0.split(/[^A-Z0-9]+/).includes(k)) return k==='CI'?'TER':k; } }
    // Combina tipo + subtecnología («ENERGÍA SOLAR» + «SOLAR FOTOVOLTAICA») para desambiguar FV/CSP
    const t = [clean(r['Tipo Tecnología']||r['Tipo Tecnologia']), clean(r.Subtecnología||r.Subtecnologia||r['Subtecnología_2'])].filter(Boolean).join(' ');
    if (t) return this._centralTech({ 'Tecnología': t });
    return null;
  }
  // Los datasets marcados como analysisOnly no se derraman sobre el mapa nacional: se
  // conservan cargados, pero sólo se materializan los registros dentro de la zona elegida.
  _datasetRowsForMap(ds, analysis=this.state.analysis) {
    if (!ds || !ds.active) return [];
    if (!ds.analysisOnly) return ds.rows || [];
    if (!analysis || analysis.lat==null || analysis.lng==null) return [];
    return (ds.rows||[]).filter(row => {
      const ll=this._placeRow(row, ds);
      return ll && this._haversine(analysis.lat, analysis.lng, ll[0], ll[1]) <= analysis.radiusKm;
    });
  }
  _renderDataset(ds) {
    const L = window.L;
    const target = ds && ds.target;
    if (!['permisos','proyectos'].includes(target)) { this._recompute(); return; }
    const g = this.groups[target]; g.clearLayers();
    const activeSets=this.state.datasets.filter(d => d.active && d.target===target);
    let n=0;
    activeSets.forEach(source => this._datasetRowsForMap(source).forEach(row => {
      const ll = this._placeRow(row, source); if (!ll) return;
      const tec = this._dsRowTech(row);
      const col = this._tecColor(tec);
      const isProj = target==='proyectos';
      const m = L.marker(ll, { icon: this._dsIcon(col, isProj, tec) });
      m.bindPopup('<b style="font-family:Newsreader,serif">'+this._dsRowName(row)+'</b><br><span style="color:#6F6B66;font-size:11px">'+this._tecLabel(tec)+' · '+(row.capacidad_mw||'—')+' MW · '+(row.estatus||'')+'</span>');
      m.on('click', () => { this.setState({ anaOpen:false, menuOpen:null }); this._selectDatasetFeature(row, source, ll); });
      g.addLayer(m); n++;
    }));
    const hasActive=activeSets.length>0;
    const layers = { ...this.state.layers };
    layers[target] = { ...layers[target], on:hasActive, count:n };
    if (hasActive) g.addTo(this.map); else { try { this.map.removeLayer(g); } catch(e){} }
    this.setState({ layers }, () => this._recompute());
  }
  _renderZonalDatasets = () => {
    const targets=[...new Set(this.state.datasets.filter(d=>d.analysisOnly).map(d=>d.target))];
    targets.forEach(target => this._renderDataset({ target }));
  };
  _techGlyph(t){
    // glifo de línea blanco por tecnología (estilo Lucide del sistema de diseño)
    const g = {
      FV:'<circle cx="13" cy="13" r="3.2"/><path d="M13 6.5v-2M13 21.5v-2M6.5 13h-2M21.5 13h-2M8.6 8.6 7.2 7.2M18.8 18.8l-1.4-1.4M17.4 8.6l1.4-1.4M7.2 18.8l1.4-1.4"/>',
      EO:'<path d="M5 19h7M9 19v-5M9 14c-3.5 0-4.5-3.5-2.5-5 1.6-1.2 3.2.6 2.5 5zM9 14c1.8-3 5.4-2.4 5.6.1.2 2-2.3 2.6-5.6-.1zM9 14c1.2-3.4-1.2-6-3.4-5.2-1.8.7-1.3 3.4 3.4 5.2z"/>',
      CC:'<path d="M13 5c1 3-3 4-3 8a3.5 3.5 0 0 0 7 0c0-2-1-3-1.5-4-.5 2-1.5 2-1.5 1 0-2 1-4-1-5z"/>',
      HID:'<path d="M13 5c3 4 5 6.5 5 9a5 5 0 0 1-10 0c0-2.5 2-5 5-9z"/>',
      GEO:'<path d="M4 20 10 9l3.2 5.5L16 10l5 10z"/>',
      COG:'<path d="M6 20v-6M6 14c-2.5 0-3.2-2.6-1.7-3.7 1.1-.8 2.3.4 1.7 3.7zM6 14c1.3-2.2 3.9-1.7 4 .1.1 1.4-1.7 1.9-4-.1zM13 20c1 3 6 3 7 0M13.5 13a3.5 3.5 0 0 1 6 0"/>',
      CARB:'<path d="M7 17a4 4 0 0 1 1-7 4.5 4.5 0 0 1 8 .5 3.5 3.5 0 0 1-1 6.5z"/>',
      NUC:'<circle cx="13" cy="13" r="1.6"/><path d="M13 13a5.5 5.5 0 0 1 4.8-2.7 5.5 5.5 0 0 1-2.4 4.6M13 13a5.5 5.5 0 0 0-4.8-2.7 5.5 5.5 0 0 0 2.4 4.6M13 13c.4 1.9-.2 4.2-1.5 5.4-1.6-1.4-2-3.6-1.3-5.4"/>',
      BIO:'<path d="M8 18c0-5 3-9 8-10-1 5-3 9-8 10zM8 18c0-3 1.5-5.5 4-7"/>',
      H2:'<path d="M6 8v10M6 13h5M11 8v10M15 18h4M17 18v-7l-2 1.4"/>',
