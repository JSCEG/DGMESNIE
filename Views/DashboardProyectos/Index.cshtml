      fetch('/api/podecobi/polos/'+encodeURIComponent(numero), { credentials:'same-origin' })
        .then(r => r.ok ? r.json() : Promise.reject(new Error('HTTP '+r.status)))
        .then(d => {
          if (!d || !d.polo) return;
          const pol = d.polo;
          const voc = (d.vocaciones||[]).map(v => v.vocacion).filter(Boolean);
          const cf  = (d.contactos||[]).find(c => c.ambito==='FEDERAL');
          const ce  = (d.contactos||[]).find(c => c.ambito==='ESTATAL');
          const fDOF = (d.fuentes||[]).find(f => f.tipo==='DOF' || f.tipo==='SIDOF');
          const rowsFull = [
            ['Tipo de infraestructura','Polo de Desarrollo · PODECOBI'],
