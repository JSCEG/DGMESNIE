  _nearestSub(sel){ let best=Infinity; this.subFeatures.forEach(s=>{ if(s.idx===sel.idx) return; const d=this._haversine(sel.lat,sel.lng,s.lat,s.lng); if(d<best) best=d; }); return best===Infinity?null:best; }
