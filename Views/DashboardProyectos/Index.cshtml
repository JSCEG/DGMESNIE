    ['occidental', ['guanajuato','jalisco','zacatecas','colima','aguascalientes','sanluispotosi','michoacan','nayarit']],
  ];

  state = {
    ready: false, booting: true, bootMsg: 'Conectando con fuentes oficiales…',
    loading: false, loadingMsg: 'Cargando…', toast: '', layerBar: null, blocking: null,
    basemap: 'color', legendOn: true,
