  _renderGraphFocus(result){
    this._clearGraphFocus();
    const L=window.L;
    const features=[];
    (result.edges||[]).forEach(edge=>{
      if(edge&&edge.geometry) features.push({type:'Feature',properties:{element_type:'edge'},geometry:edge.geometry});
    });
    (result.nodes||[]).forEach(node=>{
      const lat=Number(node.latitude),lng=Number(node.longitude);
      if(isFinite(lat)&&isFinite(lng)) features.push({
        type:'Feature',properties:{element_type:'node',is_virtual:!!node.isVirtual},
        geometry:{type:'Point',coordinates:[lng,lat]}
      });
    });
    this._graphFocus=L.geoJSON({type:'FeatureCollection',features},{
      pane:'hl',
      interactive:false,
      style:()=>({color:'#9B2247',weight:5,opacity:.92,pane:'hl'}),
      pointToLayer:(feature,latlng)=>L.circleMarker(latlng,{
