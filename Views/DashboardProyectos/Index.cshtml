  <style>
    *{box-sizing:border-box}
    html,body{margin:0;padding:0}
    .leaflet-container{font-family:'Noto Sans',sans-serif;background:#e8e4de}
    .leaflet-popup-content-wrapper{border-radius:8px;box-shadow:0 8px 28px rgba(0,0,0,.18);border-top:3px solid #9B2247}
    .leaflet-popup-content{margin:12px 14px;font-family:'Noto Sans',sans-serif}
