    { key:'gerencias',     cat:'División territorial',   panelCat:'Operación y mercado', panelSection:'Eléctrico', panelGroupOrder:10, panelSectionOrder:10, panelOrder:10, showInLayerPanel:true, label:'Gerencias de control CENACE', code:'GC', color:'#9B2247', type:'gerencias', src:'gerencias',  on:false },
