        this._toast(pamMeta
          ?cnt.toLocaleString('es-MX')+' proyectos PAM · '
            +Number(pamMeta.proyectosAsociadosRed||0).toLocaleString('es-MX')+' asociados a la red · '
            +Number(pamMeta.proyectosRegionales||0).toLocaleString('es-MX')+' con referencia regional GCR · '
            +'2ª convocatoria en capa independiente'
