    const fallback={
      point:'Punto seleccionado en mapa',
      coordinate:coordinates,
      address:'Dirección seleccionada',
      gcr:'GCR '+(this.GCR_NOMBRE[gcrKey]||'—'),
      'demand-region':'Región de control CENACE',
      'tariff-division':'División tarifaria CFE',
      podecobi:'Polo de Desarrollo para el Bienestar',
      municipality:municipality&&municipality!=='—'?municipality:'Municipio del punto',
      state:A.targetState||A.estado||'Entidad federativa'
    };
    const typeLabels={
      point:'Punto seleccionado',
      coordinate:'Coordenadas',
      address:'Dirección',
      gcr:'Gerencia de control regional',
      'demand-region':'Región de demanda CENACE',
      'tariff-division':'División tarifaria CFE',
      podecobi:'PODECOBI',
      municipality:'Municipio',
      state:'Entidad federativa'
    };
    const evaluationLabels={
      point:'Evaluación de punto',
      coordinate:'Evaluación por coordenadas',
      address:'Evaluación de dirección',
      gcr:'Evaluación de GCR',
      'demand-region':'Evaluación de demanda y pronóstico',
      'tariff-division':'Evaluación de usuarios y consumo',
      podecobi:'Evaluación de PODECOBI',
      municipality:'Evaluación de municipio',
      state:'Evaluación de estado'
    };
    const label=String(A.targetLabel||fallback[kind]||fallback.point).trim();
