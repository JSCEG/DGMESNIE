            ['Municipio', pol.municipio || '—'],
            ['Etapa / Subetapa', [pol.etapa, pol.subetapa].filter(Boolean).join(' · ') || '—'],
            ['Declaratoria', pol.fechaDeclaracion ? new Date(pol.fechaDeclaracion).toLocaleDateString('es-MX') : '—'],
            ['Superficie oficial (DOF)', pol.areaOficialHa!=null ? Number(pol.areaOficialHa).toLocaleString('es-MX',{maximumFractionDigits:4})+' ha' : '—'],
            ['Superficie GeoJSON', pol.areaGeojsonHa!=null ? Number(pol.areaGeojsonHa).toLocaleString('es-MX',{maximumFractionDigits:4})+' ha' : '—'],
            ['Δ superficie', pol.geojsonDeltaPct!=null ? Number(pol.geojsonDeltaPct).toFixed(2)+' %' : '—'],
            ['Centroide', pol.centroidLon!=null && pol.centroidLat!=null ? pol.centroidLon.toFixed(5)+', '+pol.centroidLat.toFixed(5) : '—'],
