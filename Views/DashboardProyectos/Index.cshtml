  async _generateTerritorialPDF(fmt, opts){
    const O=opts||{};
    const format=fmt==='pdf16x9'?'pdf16x9':'pdf';
    // Si el reporte ya está abierto, conserva exactamente el modelo visible:
    // incluye sus mapas temáticos ya renderizados y evita una segunda captura
    // que podría diferir del Front por el estado oculto del mapa base.
    const R=(this.state.reportOpen&&this._report)
      ?this._report
      :await this._buildReportAsync();
    if(!R) throw new Error('Ejecuta primero un análisis de zona para generar el reporte.');
    this._report=R;
