  _analysisPolygonFeatures(A){
    const T=window.turf;
    const source=A&&A.analysisGeometry;
    if(!source||!T) return [];
    try{
      const flat=T.flatten(this._asFeatureCollection(source));
      return (flat.features||[]).filter(feature=>{
        const type=feature&&feature.geometry&&feature.geometry.type;
        return type==='Polygon'||type==='MultiPolygon';
      });
    }catch(e){ return []; }
  }
  _prepareAnalysisContext(A){
    if(!A||!A.analysisGeometry||!window.turf) return null;
    const source=A.analysisGeometry;
    if(this._preparedAnalysisContext&&this._preparedAnalysisContext.source===source) return this._preparedAnalysisContext;
    try{
      const polygons=this._analysisPolygonFeatures(A);
      const bbox=polygons.length?window.turf.bbox({type:'FeatureCollection',features:polygons}):null;
      this._preparedAnalysisContext={source,polygons,bbox};
      return this._preparedAnalysisContext;
    }catch(e){ return null; }
  }
  _analysisBboxIntersects(feature,bbox){
    if(!bbox||!feature||!feature.geometry||!window.turf) return true;
    try{
      const candidate=window.turf.bbox(feature);
      return !(candidate[2]<bbox[0]||candidate[0]>bbox[2]||candidate[3]<bbox[1]||candidate[1]>bbox[3]);
    }catch(e){ return true; }
  }
  _analysisContainsPoint(A,lat,lng,context){
    if(!A||!isFinite(lat)||!isFinite(lng)) return false;
    if(!A.analysisGeometry) return this._haversine(A.lat,A.lng,lat,lng)<=A.radiusKm;
    const T=window.turf;
    if(!T) return false;
    try{
      const point=T.point([lng,lat]);
      const prepared=context||this._prepareAnalysisContext(A);
      const polygons=(prepared&&prepared.polygons)||this._analysisPolygonFeatures(A);
      if(prepared&&prepared.bbox&&(lng<prepared.bbox[0]||lng>prepared.bbox[2]||lat<prepared.bbox[1]||lat>prepared.bbox[3])) return false;
      return polygons.some(polygon=>T.booleanPointInPolygon(point,polygon));
    }catch(e){ return false; }
  }
  _analysisFeatureIntersects(A,feature,context){
    if(!feature||!feature.geometry) return false;
    if(!A||!A.analysisGeometry){
      const T=window.turf;
      if(T&&A&&isFinite(A.lat)&&isFinite(A.lng)&&isFinite(A.radiusKm)){
        try{
