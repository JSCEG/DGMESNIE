  // Color institucional por Gerencia de Control Regional (sistema de diseño SENER)
  GCR_COLORS = { noreste:'#3E8174', peninsular:'#A33052', oriental:'#6FA89A', central:'#B24C6C', occidental:'#A57F2C', bcalifornia:'#7E3B52', noroeste:'#1E5B4F', norte:'#9B2247', bcsur:'#A9CDC3', mulege:'#E0CA8E' };
  GCR_NOMBRE = { noreste:'Noreste', peninsular:'Peninsular', oriental:'Oriental', central:'Central', occidental:'Occidental', bcalifornia:'B. California', noroeste:'Noroeste', norte:'Norte', bcsur:'BC Sur', mulege:'Mulegé' };
  // Asignación entidad → gerencia (orden de prioridad resuelve estados compartidos)
