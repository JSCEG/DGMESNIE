    const number=value=>value==null||value===''
      ?null
      :(Number.isFinite(Number(value))?Number(value):null);
    const fmt=(value,digits=0)=>value==null
      ?'—'
      :Number(value).toLocaleString('es-MX',{
        minimumFractionDigits:digits,
