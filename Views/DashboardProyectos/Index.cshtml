      headCells.forEach((c,i)=>doc.text(c,xs[i]+pad,y+12)); doc.setCharSpace(0); y+=headHeight;
      doc.setDrawColor(accent[0],accent[1],accent[2]); doc.setLineWidth(2.5); doc.line(x,y-1.2,x+width,y-1.2);
    };
