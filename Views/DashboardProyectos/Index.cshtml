    report.metrics=(Array.isArray(report.metrics)?report.metrics:[]).concat([{
      label:'Generación distribuida',
      value:fmt(totalMw,1)+' MW',
      color:'#0E8A6E',
      dim:false,
      sub:context.states.length+' entidad(es) · '+(context.referencePeriod||'corte')
    }]);
    report.distributedGeneration={
      source:context.source,
      referencePeriod:context.referencePeriod,
      states:context.states
    };
  }

  _orderReportSections(report){
    if(!report||!Array.isArray(report.sections)) return;
    // Orden editorial compartido por Front, PDF Carta, PDF 16:9 y Excel.
    const order=[
      'layer-cut',
      'elec',
      'demanda-pronostico',
      'usuarios-consumo',
      'consumo-electricidad',
      'generacion-distribuida',
      'tarifas-atlas',
      'tarifas-electricas',
      'permits-electricity',
      'permits-gas',
      'permits-petroleum',
      'podecobi',
      'inegi',
      'social',
      'amb',
      'pat',
      'ter',
      'ds'
    ];
    const rank=new Map(order.map((key,index)=>[key,index]));
    report.sections=report.sections
      .map((section,index)=>({section,index}))
      .sort((a,b)=>{
        const rankA=rank.has(a.section&&a.section.key)?rank.get(a.section.key):order.length;
        const rankB=rank.has(b.section&&b.section.key)?rank.get(b.section.key):order.length;
        return rankA-rankB||a.index-b.index;
      })
      .map(item=>item.section);
  }

  _reportChartSvg(chart){
    if(chart&&chart.type==='timeseries') return this._reportTimeSeriesChartSvg(chart);
    const D=window.d3;
    if(!D||typeof D.create!=='function') return '';
    const data=(chart&&Array.isArray(chart.data)?chart.data:[]).filter(item=>Number.isFinite(Number(item.value))&&Number(item.value)>=0);
    if(!data.length) return '';
    const width=720,height=290,margin={top:30,right:88,bottom:18,left:198};
    const innerH=height-margin.top-margin.bottom;
    const maxValue=Math.max(1,D.max(data,item=>Number(item.value))||1);
    const x=D.scaleLinear().domain([0,maxValue]).nice().range([margin.left,width-margin.right]);
    const y=D.scaleBand().domain(data.map(item=>item.label)).range([margin.top,height-margin.bottom]).padding(.28);
    const formatValue=value=>Number(value).toLocaleString('es-MX',{minimumFractionDigits:chart.decimals||0,maximumFractionDigits:chart.decimals||0});
    const labelLines=label=>{
      const words=String(label||'').split(/\s+/).filter(Boolean),lines=[];
      let current='';
      words.forEach(word=>{
        const next=current?current+' '+word:word;
        if(next.length<=25||!current) current=next;
        else{ lines.push(current); current=word; }
      });
      if(current) lines.push(current);
      if(lines.length>2){
        const second=lines.slice(1).join(' ');
        return [lines[0],second.length>27?second.slice(0,25)+'…':second];
      }
      return lines.length?lines:['Dato'];
    };
    const svg=D.create('svg')
      .attr('xmlns','http://www.w3.org/2000/svg')
      .attr('viewBox','0 0 '+width+' '+height)
      .attr('width',width)
      .attr('height',height)
      .attr('role','img')
      .attr('aria-label','Gráfica de '+chart.title);
    svg.append('rect').attr('width',width).attr('height',height).attr('fill','#fff');
    const axis=svg.append('g')
      .attr('transform','translate(0,'+margin.top+')')
      .call(D.axisTop(x).ticks(4).tickSize(-innerH).tickFormat(value=>formatValue(value)));
    axis.select('.domain').remove();
    axis.selectAll('.tick line').attr('stroke','#ECE8E2').attr('stroke-width',1);
    axis.selectAll('.tick text').attr('fill','#9A958E').attr('font-size',11).attr('font-family','Arial, Helvetica, sans-serif');
    svg.append('g').selectAll('rect')
      .data(data).join('rect')
      .attr('x',margin.left)
      .attr('y',item=>y(item.label))
      .attr('width',item=>Math.max(2,x(Number(item.value))-margin.left))
      .attr('height',y.bandwidth())
      .attr('rx',4)
      .attr('fill',item=>item.color||'#9B2247');
    svg.append('g').selectAll('text')
      .data(data).join('text')
      .attr('x',margin.left-12)
      .attr('y',item=>y(item.label)+y.bandwidth()/2-((labelLines(item.label).length-1)*6)+4)
      .attr('text-anchor','end')
      .attr('fill','#3A3A3A')
      .attr('font-size',11)
      .attr('font-weight',700)
      .attr('font-family','Arial, Helvetica, sans-serif')
      .each(function(item){
        const node=D.select(this);
        node.text(null);
        labelLines(item.label).forEach((line,index)=>{
          node.append('tspan').attr('x',margin.left-12).attr('dy',index?12:0).text(line);
        });
      });
    svg.append('g').selectAll('text')
      .data(data).join('text')
      .attr('x',item=>{
        const px=x(Number(item.value));
        return px>width-margin.right-72?px-7:px+7;
      })
      .attr('y',item=>y(item.label)+y.bandwidth()/2+4)
      .attr('text-anchor',item=>x(Number(item.value))>width-margin.right-72?'end':'start')
      .attr('fill',item=>x(Number(item.value))>width-margin.right-72?'#fff':'#1c1b1a')
      .attr('font-size',12)
      .attr('font-weight',800)
      .attr('font-family','Arial, Helvetica, sans-serif')
      .text(item=>this._reportChartValueText(chart,item.value));
    const xml=new XMLSerializer().serializeToString(svg.node());
    return 'data:image/svg+xml;charset=utf-8,'+encodeURIComponent(xml);
  }

  _reportTimeSeriesChartSvg(chart){
    const D=window.d3;
    if(!D||typeof D.create!=='function') return '';
    const points=Array.isArray(chart&&chart.data)?chart.data:[];
    const series=(Array.isArray(chart&&chart.series)?chart.series:[])
      .map(item=>({...item,values:(Array.isArray(item.values)?item.values:[])
        .map(value=>value==null||value===''?null:Number(value))}));
    const values=series.flatMap(item=>item.values).filter(Number.isFinite);
    if(points.length<2||!values.length) return '';
    const width=720,height=290,margin={top:48,right:24,bottom:42,left:62};
    let min=D.min(values),max=D.max(values);
    const rawSpan=Math.max(1,max-min);
    min=Math.max(0,min-rawSpan*.10);
    max=max+rawSpan*.10;
    const x=D.scaleLinear().domain([0,Math.max(1,points.length-1)]).range([margin.left,width-margin.right]);
    const y=D.scaleLinear().domain([min,max]).nice().range([height-margin.bottom,margin.top]);
    const svg=D.create('svg')
      .attr('xmlns','http://www.w3.org/2000/svg')
      .attr('viewBox','0 0 '+width+' '+height)
      .attr('width',width)
      .attr('height',height)
      .attr('role','img')
      .attr('aria-label','Gráfica horaria de '+chart.title);
    svg.append('rect').attr('width',width).attr('height',height).attr('fill','#fff');
    const yAxis=svg.append('g')
      .attr('transform','translate('+margin.left+',0)')
      .call(D.axisLeft(y).ticks(4).tickSize(-(width-margin.left-margin.right)).tickFormat(value=>(Number(value)/1000).toLocaleString('es-MX',{maximumFractionDigits:1})));
    yAxis.select('.domain').remove();
    yAxis.selectAll('.tick line').attr('stroke','#ECE8E2').attr('stroke-width',1);
    yAxis.selectAll('.tick text').attr('fill','#6F6B66').attr('font-size',11).attr('font-family','Arial, Helvetica, sans-serif');
    const tickIndexes=[0,Math.round((points.length-1)*.25),Math.round((points.length-1)*.5),Math.round((points.length-1)*.75),points.length-1]
      .filter((value,index,array)=>array.indexOf(value)===index);
    const xAxis=svg.append('g')
      .attr('transform','translate(0,'+(height-margin.bottom)+')')
      .call(D.axisBottom(x).tickValues(tickIndexes).tickSize(5).tickFormat(index=>(points[Math.round(index)]||{}).label||''));
    xAxis.select('.domain').attr('stroke','#D8D3CC');
    xAxis.selectAll('.tick line').attr('stroke','#D8D3CC');
    xAxis.selectAll('.tick text').attr('fill','#6F6B66').attr('font-size',11).attr('font-family','Arial, Helvetica, sans-serif');
    const line=D.line()
      .defined(value=>Number.isFinite(value))
      .x((value,index)=>x(index))
      .y(value=>y(value));
    series.forEach(item=>{
      svg.append('path')
        .datum(item.values)
        .attr('fill','none')
        .attr('stroke',item.color||'#1E6FD9')
        .attr('stroke-width',item.key==='demand'?3:2.2)
        .attr('stroke-dasharray',item.dash||null)
        .attr('stroke-linecap','round')
        .attr('stroke-linejoin','round')
        .attr('d',line);
    });
    const legend=svg.append('g').attr('transform','translate('+margin.left+',18)');
    let legendX=0;
    series.forEach(item=>{
      legend.append('line')
        .attr('x1',legendX).attr('x2',legendX+23).attr('y1',4).attr('y2',4)
        .attr('stroke',item.color||'#1E6FD9').attr('stroke-width',3).attr('stroke-dasharray',item.dash||null);
      legend.append('text')
        .attr('x',legendX+30).attr('y',8)
        .attr('fill','#3A3A3A').attr('font-size',11).attr('font-weight',700)
        .attr('font-family','Arial, Helvetica, sans-serif').text(item.label||'Serie');
      legendX+=30+Math.max(66,String(item.label||'Serie').length*7);
    });
    svg.append('text')
      .attr('x',12).attr('y',margin.top-12)
      .attr('fill','#6F6B66').attr('font-size',10).attr('font-weight',700)
      .attr('font-family','Arial, Helvetica, sans-serif').text('GW');
    svg.append('text')
      .attr('x',width-margin.right).attr('y',height-10)
      .attr('text-anchor','end').attr('fill','#9A958E').attr('font-size',10)
      .attr('font-family','Arial, Helvetica, sans-serif').text('Hora del día');
    const xml=new XMLSerializer().serializeToString(svg.node());
    return 'data:image/svg+xml;charset=utf-8,'+encodeURIComponent(xml);
  }

  _reportChartValueText(chart,value){
    const numeric=Number(value);
    const formatted=numeric.toLocaleString('es-MX',{
      minimumFractionDigits:chart&&chart.decimals||0,
      maximumFractionDigits:chart&&chart.decimals||0,
    });
    let unit=String(chart&&chart.unit||'');
    if(numeric===1){
      if(unit==='subestaciones') unit='subestación';
      if(unit==='centrales') unit='central';
    }
    return formatted+(unit?' '+unit:'');
  }

  _ringAreaKm2(ring){
    if(!Array.isArray(ring)||ring.length<3) return 0;
    const earthRadiusKm=6371.0088;
    let sum=0;
    for(let i=0;i<ring.length;i++){
      const current=ring[i],next=ring[(i+1)%ring.length];
      if(!current||!next||!isFinite(current[0])||!isFinite(current[1])||!isFinite(next[0])||!isFinite(next[1])) continue;
      const lon1=current[0]*Math.PI/180,lon2=next[0]*Math.PI/180;
      const lat1=current[1]*Math.PI/180,lat2=next[1]*Math.PI/180;
      sum+=(lon2-lon1)*(2+Math.sin(lat1)+Math.sin(lat2));
    }
    return Math.abs(sum)*earthRadiusKm*earthRadiusKm/2;
  }

  _geometryAreaKm2(geometry){
    if(!geometry||!Array.isArray(geometry.coordinates)) return null;
    const polygonArea=rings=>{
      if(!Array.isArray(rings)||!rings.length) return 0;
      const outer=this._ringAreaKm2(rings[0]);
      const holes=rings.slice(1).reduce((sum,ring)=>sum+this._ringAreaKm2(ring),0);
      return Math.max(0,outer-holes);
    };
    const area=geometry.type==='Polygon'
      ? polygonArea(geometry.coordinates)
      : geometry.type==='MultiPolygon'
        ? geometry.coordinates.reduce((sum,rings)=>sum+polygonArea(rings),0)
        : 0;
    return area>0?area:null;
  }

  _resolveInegiArea(A){
    // La API oficial publica ámbitos geoestadísticos (entidad/municipio), no polígonos GCR.
    // Para una GCR evitamos atribuirle cifras del municipio donde cae su centroide.
    if(A.targetKind==='gcr') return null;
    const stateName=A.targetState||A.estado||'';
    const stateFeatures=(this.geo&&this.geo.estados&&this.geo.estados.features)||[];
    const stateFeature=stateFeatures.find(feature=>this._inFeature(A.lng,A.lat,feature.geometry))
      ||stateFeatures.find(feature=>this._norm(this._propEnt(feature.properties)||'')===this._norm(stateName));
    const stateProps=(stateFeature&&stateFeature.properties)||{};
    const stateCodeRaw=String(A.targetStateCode||stateProps.CVE_ENT||stateProps.cve_ent||
      Object.keys(this.CVE_ENT).find(key=>this._norm(this.CVE_ENT[key])===this._norm(stateName))||'');
    const stateCode=stateCodeRaw?stateCodeRaw.padStart(2,'0'):'';
    if(!/^(0[1-9]|[12]\d|3[0-2])$/.test(stateCode)) return null;

    if(A.targetKind==='state'){
      return {
        entidad:stateCode,municipio:'',name:this.CVE_ENT[stateCode]||stateName||'Entidad federativa',
        scope:'Entidad federativa',areaKm2:this._geometryAreaKm2(stateFeature&&stateFeature.geometry)
      };
    }

    const municipalGeo=this._muniGeo||this._municipiosShortcutGeo;
    const municipalityFeature=municipalGeo&&(municipalGeo.features||[]).find(feature=>{
      const props=feature.properties||{};
      if(A.targetKind==='municipality'&&A.targetMunicipalityCode){
        return String(props.CVE_ENT||props.cve_ent||'').padStart(2,'0')===stateCode &&
          String(props.CVE_MUN||props.cve_mun||'').padStart(3,'0')===String(A.targetMunicipalityCode).padStart(3,'0');
      }
      return this._inFeature(A.lng,A.lat,feature.geometry);
    });
    if(municipalityFeature){
      const props=municipalityFeature.properties||{};
      const entidad=String(props.CVE_ENT||props.cve_ent||stateCode).padStart(2,'0');
      const cveGeo=String(props.CVEGEO||props.cvegeo||'');
      const municipalityRaw=String(props.CVE_MUN||props.cve_mun||(cveGeo.length>=5?cveGeo.slice(-3):''));
      const municipio=municipalityRaw?municipalityRaw.padStart(3,'0'):'';
      if(/^\d{2}$/.test(entidad)&&/^\d{3}$/.test(municipio)&&municipio!=='000'){
        return {
          entidad,municipio,
          name:props.NOMGEO||props.nombre||A.targetMunicipality||'Municipio del punto central',
          scope:'Municipio',areaKm2:this._geometryAreaKm2(municipalityFeature.geometry)
        };
      }
    }

    return {
      entidad:stateCode,municipio:'',name:this.CVE_ENT[stateCode]||stateName||'Entidad federativa',
      scope:'Entidad federativa',areaKm2:this._geometryAreaKm2(stateFeature&&stateFeature.geometry)
    };
  }

  async _loadInegiReportContext(area){
    if(!area) return null;
    this._inegiReportCache=this._inegiReportCache||new Map();
    const key=area.entidad+area.municipio+':'+(area.areaKm2?area.areaKm2.toFixed(2):'na');
    if(this._inegiReportCache.has(key)) return this._inegiReportCache.get(key);
    const params=new URLSearchParams({entidad:area.entidad});
    if(area.municipio) params.set('municipio',area.municipio);
    if(area.areaKm2) params.set('areaKm2',area.areaKm2.toFixed(2));
    try{
      const response=await fetch('/DashboardProyectos/IndicadoresInegi?'+params.toString(),{
        method:'GET',credentials:'same-origin',headers:{Accept:'application/json'}
      });
      const payload=await response.json().catch(()=>null);
      if(!response.ok||!payload||!payload.ok||!payload.data){
        this._inegiStatus=payload&&payload.code?payload.code:'INEGI_UNAVAILABLE';
        return null;
      }
      const result={...payload.data,area};
      this._inegiReportCache.set(key,result);
      this._inegiStatus='OK';
      return result;
    }catch(e){
      this._inegiStatus='INEGI_UNAVAILABLE';
      return null;
    }
  }

  _formatInegiIndicator(indicator){
    const value=Number(indicator&&indicator.value);
    if(!Number.isFinite(value)) return 'sin dato';
    const decimals=Math.max(0,Math.min(2,Number(indicator.decimals)||0));
    const formatted=value.toLocaleString('es-MX',{
      minimumFractionDigits:decimals,maximumFractionDigits:decimals
    });
    const unit=String(indicator.unit||'').trim();
    return formatted+(unit?' '+unit:'');
  }

  _formatInegiNumber(indicator){
    const value=Number(indicator&&indicator.value);
    if(!Number.isFinite(value)) return 'sin dato';
    const decimals=Math.max(0,Math.min(2,Number(indicator.decimals)||0));
    return value.toLocaleString('es-MX',{
      minimumFractionDigits:decimals,maximumFractionDigits:decimals
    });
  }

  _buildInegiReportCharts(context){
    const breakdowns=Array.isArray(context&&context.breakdowns)?context.breakdowns:[];
    const palettes={
      population_trend:['#C9A24B','#1E6F5C'],
      population_sex:['#2E6FB0','#9B2247'],
      population_age_groups:['#C9A24B','#E0A12E','#1E6F5C','#9B2247'],
      indigenous_composition:['#C0552E','#D7D1C8'],
      economic_structure:['#1E6F5C','#9B2247','#E0A12E','#2E6FB0','#C0552E','#8A9099']
    };
    return breakdowns.map(breakdown=>{
      const items=Array.isArray(breakdown.items)?breakdown.items:[];
      const palette=palettes[breakdown.key]||palettes.economic_structure;
      const data=items.map((item,index)=>({
        label:item.label||item.key||'Indicador',
        value:Number(item.value),
        color:palette[index%palette.length],
        detail:breakdown.period||''
      })).filter(item=>Number.isFinite(item.value)&&item.value>=0);
      if(!data.length) return null;
      const chart={
        key:'inegi-'+(breakdown.key||'profile'),
        group:'inegi',
        title:breakdown.title||'Perfil territorial INEGI',
        subtitle:[breakdown.subtitle,breakdown.period].filter(Boolean).join(' · '),
        unit:breakdown.unit||'',
        decimals:Math.max(0,Math.min(2,Number(breakdown.decimals)||0)),
        data,
        source:'Fuente: '+(breakdown.source||'INEGI')
      };
      return {
        ...chart,
        alt:'Gráfica de '+chart.title.toLowerCase(),
        svgDataUrl:this._reportChartSvg(chart)
      };
    }).filter(Boolean);
  }

  _appendInegiToReport(report,context){
    if(!report||!context||!Array.isArray(context.indicators)||!context.indicators.length) return;
    const indicators=context.indicators;
    const area=context.area||{};
    const population=indicators.find(item=>item.key==='population_total');
    const economicUnits=indicators.find(item=>item.key==='economic_units');
    const rows=indicators.map(item=>[
      item.label||'Indicador',
      this._formatInegiIndicator(item),
      item.period||'—',
      [item.detail,item.source?'Fuente: '+item.source:''].filter(Boolean).join(' · ')
    ]);
    const charts=this._buildInegiReportCharts(context);
    const section={
      key:'inegi',kicker:'Contexto territorial · INEGI',color:'#1E6F5C',
      title:'Indicadores sociodemográficos y económicos',
      intro:'Ámbito de referencia: '+(area.scope||context.scope||'Territorio')+' · '+(area.name||context.geographicCode||'zona evaluada')+
        '. Se presenta el dato oficial más reciente disponible para ese ámbito geoestadístico; no se prorratea dentro de buffers o radios.',
      hasRows:false,rows:[],hasChips:false,chips:[],
      hasTable:true,table:{head:['Indicador','Valor','Periodo','Nota metodológica / fuente'],rows},
      tableLabel:'Indicadores oficiales',
      hasCharts:charts.length>0,charts,
      hasTable2:false,
      source:'INEGI · Banco de Indicadores y DENUE',
    };
    const socialIndex=report.sections.findIndex(item=>item.key==='social');
    report.sections.splice(socialIndex>=0?socialIndex+1:1,0,section);
    [population,economicUnits].filter(Boolean).forEach(item=>report.metrics.push({
      label:item.label,
      value:this._formatInegiNumber(item),
      color:item.key==='population_total'?'#1E6F5C':'#C0552E',
      dim:false,
      sub:[item.unit,item.period||'Dato más reciente','INEGI'].filter(Boolean).join(' · ')
    }));
    report.charts=(Array.isArray(report.charts)?report.charts:[]).concat(charts);
    report.inegi={
      geographicCode:context.geographicCode,
      scope:context.scope,
      queriedAt:context.queriedAt,
      area,
      indicators,
      breakdowns:Array.isArray(context.breakdowns)?context.breakdowns:[]
    };
  }

  _tariffDivisionsInAnalysis(){
    const A=this.state.analysis||{};
    if(!Array.isArray(A.ranKeys)||!A.ranKeys.includes('tarifas_div')) return [];
    const names=((this._genericFeats||{}).tarifas_div||[]).map(item=>{
      const props=(item&&item.props)||{};
      return props['DIVISIÓN']||props.DIVISION||props.Division||props.division||'';
    }).map(name=>String(name).trim()).filter(Boolean);
    return Array.from(new Set(names)).sort((a,b)=>a.localeCompare(b,'es-MX'));
  }

  _loadScriptGlobal(url,globalName){
    if(window[globalName]) return Promise.resolve(window[globalName]);
    this._externalScriptPromises=this._externalScriptPromises||new Map();
    const cacheKey=globalName+'|'+url;
    if(this._externalScriptPromises.has(cacheKey)) return this._externalScriptPromises.get(cacheKey);
    const promise=new Promise((resolve,reject)=>{
      const existing=document.querySelector('script[data-dg-global="'+globalName+'"]');
      const script=existing||document.createElement('script');
      const finish=()=>{
        const value=window[globalName];
        if(value) resolve(value);
        else reject(new Error('La fuente '+globalName+' no publicó una geometría utilizable'));
      };
      if(existing){
        if(window[globalName]) finish();
        else {
          existing.addEventListener('load',finish,{once:true});
          existing.addEventListener('error',()=>reject(new Error('No fue posible cargar '+globalName)),{once:true});
        }
        return;
      }
      script.src=url;
      script.async=true;
      script.dataset.dgGlobal=globalName;
      script.onload=finish;
      script.onerror=()=>reject(new Error('No fue posible cargar '+globalName));
      document.head.appendChild(script);
    }).catch(error=>{
      this._externalScriptPromises.delete(cacheKey);
      throw error;
    });
    this._externalScriptPromises.set(cacheKey,promise);
    return promise;
  }

  _sampleTariffLocalityFeatures(features,limit){
    const source=Array.isArray(features)?features:[];
    if(source.length<=limit) return source;
    const byDivision=new Map();
    source.forEach(feature=>{
      const props=(feature&&feature.properties)||{};
      const division=String(props['DIVISIÓN']||props.DIVISION||'Sin división');
      if(!byDivision.has(division)) byDivision.set(division,[]);
      byDivision.get(division).push(feature);
    });
    const selected=[];
    const perGroup=Math.max(1,Math.floor(limit/Math.max(1,byDivision.size)));
    byDivision.forEach(items=>{
      const take=Math.min(items.length,perGroup);
      const step=items.length/Math.max(1,take);
      for(let index=0;index<take;index++) selected.push(items[Math.min(items.length-1,Math.floor(index*step))]);
    });
    if(selected.length<limit){
      const chosen=new Set(selected);
      const remaining=source.filter(feature=>!chosen.has(feature));
      const take=Math.min(limit-selected.length,remaining.length);
      const step=remaining.length/Math.max(1,take);
      for(let index=0;index<take;index++) selected.push(remaining[Math.min(remaining.length-1,Math.floor(index*step))]);
    }
    return selected.slice(0,limit);
  }

  _analysisCentroidFeature(A){
    const T=window.turf;
    if(!T||!A) return null;
    const key=this._analysisSelectionKey(A)+':centroid';
    if(this._analysisCentroidCache&&this._analysisCentroidCache.key===key){
      return this._analysisCentroidCache.value;
    }
    let point=null;
    if(A.territoryGeometry){
      const source=this._asFeatureCollection(A.territoryGeometry);
      try{
        if(typeof T.centerOfMass==='function') point=T.centerOfMass(source);
      }catch(e){}
      if(!point){
        try{ point=T.centroid(source); }catch(e){}
      }
    }
    if(!point&&isFinite(A.lat)&&isFinite(A.lng)){
      try{ point=T.point([Number(A.lng),Number(A.lat)]); }catch(e){}
    }
    this._analysisCentroidCache={key,value:point};
    return point;
  }

  _distanceFromAnalysisCentroidKm(A,feature){
    const T=window.turf,origin=this._analysisCentroidFeature(A);
    if(!T||!origin||!feature||!feature.geometry) return null;
    let destination=feature;
    if(feature.geometry.type!=='Point'){
      try{
        destination=typeof T.centerOfMass==='function'?T.centerOfMass(feature):T.centroid(feature);
      }catch(e){
        try{ destination=T.centroid(feature); }catch(innerError){ return null; }
      }
    }
    try{
      const distance=T.distance(origin,destination,{units:'kilometers'});
      return Number.isFinite(distance)&&distance>=0?distance:null;
    }catch(e){ return null; }
  }

  _analysisTargetDistanceContext(A){
    const T=window.turf;
    if(!T||!A) return null;
    const key=this._analysisSelectionKey(A)+':distance-target';
    if(this._analysisDistanceTargetCache&&this._analysisDistanceTargetCache.key===key){
      return this._analysisDistanceTargetCache.value;
    }
    let targetFeatures=[];
    if(A.territoryGeometry){
      targetFeatures=this._normFeatures(this._asFeatureCollection(A.territoryGeometry));
    }else if(isFinite(A.lat)&&isFinite(A.lng)){
      targetFeatures=[T.point([Number(A.lng),Number(A.lat)])];
    }
    const lines=[];
    const points=[];
    const appendBoundary=feature=>{
      if(!feature||!feature.geometry) return;
      const geometry=feature.geometry;
      try{
        if(geometry.type==='Polygon'){
          this._normFeatures(T.polygonToLine(feature)).forEach(line=>lines.push(line));
        }else if(geometry.type==='MultiPolygon'){
          (geometry.coordinates||[]).forEach(coordinates=>{
            this._normFeatures(T.polygonToLine(T.polygon(coordinates))).forEach(line=>lines.push(line));
          });
        }else if(geometry.type==='LineString'||geometry.type==='MultiLineString'){
          lines.push(feature);
        }else if(geometry.type==='Point'){
          points.push(feature);
        }
      }catch(e){}
    };
    targetFeatures.forEach(appendBoundary);
    const value={features:targetFeatures,lines,points};
    this._analysisDistanceTargetCache={key,value};
    return value;
  }

  _distanceFromAnalysisTargetKm(A,feature){
    const T=window.turf,context=this._analysisTargetDistanceContext(A);
    if(!T||!context||!feature||!feature.geometry||!context.features.length) return null;
    try{
      if(context.features.some(target=>{
        if(target.geometry&&target.geometry.type==='Point'&&/Polygon/.test(feature.geometry.type)){
          return T.booleanPointInPolygon(target,feature);
        }
        return T.booleanIntersects(feature,target);
      })) return 0;
    }catch(e){}
    let best=Number.POSITIVE_INFINITY;
    const update=value=>{ if(Number.isFinite(value)&&value>=0&&value<best) best=value; };
    const distancePointToFeature=(point,target)=>{
      if(!point||!target||!target.geometry) return;
      try{
        if(target.geometry.type==='Point') update(T.distance(point,target,{units:'kilometers'}));
        else update(T.pointToLineDistance(point,target,{units:'kilometers'}));
      }catch(e){}
    };
    let featurePoints=[];
    try{
      featurePoints=(T.explode(feature).features||[]);
      if(featurePoints.length>80){
        const step=featurePoints.length/80;
        featurePoints=Array.from({length:80},(_,index)=>featurePoints[Math.min(featurePoints.length-1,Math.floor(index*step))]);
      }
    }catch(e){}
    featurePoints.forEach(point=>{
      context.lines.forEach(line=>distancePointToFeature(point,line));
      context.points.forEach(target=>distancePointToFeature(point,target));
    });
    if(context.points.length&&/Polygon/.test(feature.geometry.type)){
      const featureLines=[];
      try{
        if(feature.geometry.type==='Polygon') this._normFeatures(T.polygonToLine(feature)).forEach(line=>featureLines.push(line));
        else (feature.geometry.coordinates||[]).forEach(coordinates=>{
          this._normFeatures(T.polygonToLine(T.polygon(coordinates))).forEach(line=>featureLines.push(line));
        });
      }catch(e){}
      context.points.forEach(point=>featureLines.forEach(line=>distancePointToFeature(point,line)));
    }
    return Number.isFinite(best)?best:null;
  }

  async _loadTariffLocalitiesInAnalysis(A){
    if(!A||!Array.isArray(A.ranKeys)||!A.ranKeys.includes('tarifas_div')) return null;
    const key=this._analysisSelectionKey(A);
    if(this._tariffLocalityReportCache&&this._tariffLocalityReportCache.key===key){
      return this._tariffLocalityReportCache.value;
    }
    const source=await this._loadScriptGlobal(this.TARIFF_LOCALITIES_SRC,'localidades_division');
    const prepared=this._prepareAnalysisContext(A);
    const filtered=await this._filterByAnalysisAsync(source,A,prepared,null);
    const municipalityNames=new Map();
    const municipalityGeo=this._muniGeo||this._municipiosShortcutGeo;
    ((municipalityGeo&&municipalityGeo.features)||[]).forEach(feature=>{
      const props=feature.properties||{};
      const code=String(props.CVEGEO||props.cvegeo||'').trim();
      const name=String(props.NOMGEO||props.nom_mun||props.nombre||'').trim();
      if(code&&name) municipalityNames.set(code,name);
    });
    const features=Array.isArray(filtered.features)?filtered.features:[];
    const localidades=features.map(feature=>{
      const props=(feature&&feature.properties)||{};
      const cvegeo=String(props.CVEGEO||'').trim();
      const municipalityCode=String(props.union||cvegeo.slice(0,5)||'').trim();
      const stateCode=String(props.CVE_ENT||cvegeo.slice(0,2)||'').padStart(2,'0');
      const division=String(props['DIVISIÓN']||props.DIVISION||'Sin división').trim();
      return {
        cvegeo,
        nombre:String(props.NOMGEO||'Localidad sin nombre').trim(),
        ambito:String(props.AMBITO||'').trim(),
        municipioCodigo:municipalityCode,
        municipio:municipalityNames.get(municipalityCode)||municipalityCode||'—',
        entidad:this.CVE_ENT[stateCode]||stateCode||'—',
        division,
        distanciaKm:this._distanceFromAnalysisCentroidKm(A,feature)
      };
    }).sort((a,b)=>
      (Number.isFinite(a.distanciaKm)?a.distanciaKm:Number.POSITIVE_INFINITY)-
        (Number.isFinite(b.distanciaKm)?b.distanciaKm:Number.POSITIVE_INFINITY)||
      a.division.localeCompare(b.division,'es-MX')||
      a.entidad.localeCompare(b.entidad,'es-MX')||
      a.municipio.localeCompare(b.municipio,'es-MX')||
      a.nombre.localeCompare(b.nombre,'es-MX')
    );
    const divisions=Array.from(new Set(localidades.map(item=>item.division).filter(Boolean)))
      .sort((a,b)=>a.localeCompare(b,'es-MX'));
    const mapLimit=1400;
    const value={
      total:localidades.length,
      localidades,
      divisions,
      mapFeatures:this._sampleTariffLocalityFeatures(features,mapLimit),
      mapOmitted:Math.max(0,features.length-mapLimit),
      sourceFeatureCount:Array.isArray(source.features)?source.features.length:0
    };
    this._tariffLocalityReportCache={key,value};
    return value;
  }

  async _loadTariffReportContext(divisions){
    if(!Array.isArray(divisions)||!divisions.length) return null;
    this._tariffReportCache=this._tariffReportCache||new Map();
    const key=divisions.map(name=>this._norm(name)).sort().join('|');
    if(this._tariffReportCache.has(key)) return this._tariffReportCache.get(key);
    const params=new URLSearchParams({divisiones:divisions.join(',')});
    try{
      const response=await fetch('/DashboardProyectos/TarifasTerritoriales?'+params.toString(),{
        method:'GET',credentials:'same-origin',headers:{Accept:'application/json'}
      });
      const payload=await response.json().catch(()=>null);
      if(!response.ok||!payload||!payload.ok||!payload.data) return null;
      this._tariffReportCache.set(key,payload.data);
      return payload.data;
    }catch(e){
      return null;
    }
  }

  _tariffPeriodLabel(raw){
    if(!raw) return 'sin periodo disponible';
    const parsed=new Date(raw);
    if(Number.isNaN(parsed.getTime())) return String(raw);
    return parsed.toLocaleDateString('es-MX',{month:'long',year:'numeric',timeZone:'UTC'});
  }

  _appendTariffsToReport(report,context,localityContext){
    const records=Array.isArray(context&&context.registros)?context.registros:[];
    const divisions=Array.isArray(context&&context.divisiones)?context.divisiones:[];
    if(!report||!records.length||!divisions.length) return;
    const period=this._tariffPeriodLabel(context.periodo);
    const fmt=value=>{
      const number=Number(value);
      return Number.isFinite(number)
        ? number.toLocaleString('es-MX',{minimumFractionDigits:3,maximumFractionDigits:3})
        : '—';
    };
    const normalizedRecords=records.map(record=>({
      ...record,
      tarifa:String(record.tarifa||'').trim().toUpperCase(),
      division:String(record.division||'').trim()
    }));
    const referenceTariffs=[
      {key:'GDBT',label:'GDBT · comercio BT'},
      {key:'PDBT',label:'PDBT · comercio BT'},
      {key:'GDMTO',label:'GDMTO · industria MT'},
      {key:'GDMTH',label:'GDMTH · industria MT'},
      {key:'DIST',label:'DIST · industria AT'}
    ];
    const byDivision=new Map();
    normalizedRecords.forEach(record=>{
      if(!byDivision.has(record.division)) byDivision.set(record.division,new Map());
      byDivision.get(record.division).set(record.tarifa,record);
    });
    const byDivisionNormalized=new Map();
    byDivision.forEach((value,key)=>byDivisionNormalized.set(this._norm(key),value));
    const tableRows=divisions.map(division=>{
      const values=byDivision.get(division)||byDivisionNormalized.get(this._norm(division))||new Map();
      return [
        division,
        ...referenceTariffs.map(item=>fmt((values.get(item.key)||{}).valor))
      ];
    });
    const localities=Array.isArray(localityContext&&localityContext.localidades)
      ?localityContext.localidades.map(locality=>{
        const values=byDivision.get(locality.division)||byDivisionNormalized.get(this._norm(locality.division))||new Map();
        const reference=values.get('GDBT')||null;
        return {
          ...locality,
          tarifaReferencia:'GDBT',
          tarifaGdbt:reference&&Number.isFinite(Number(reference.valor))?Number(reference.valor):null,
          unidad:reference&&reference.unidades?reference.unidades:'$/kWh',
          periodo:reference&&reference.periodo?reference.periodo:context.periodo
        };
      }):[];
    const localityTableLimit=80;
    const localityRows=localities.slice(0,localityTableLimit).map(locality=>[
      locality.cvegeo||'—',
      locality.nombre||'—',
      locality.municipio||'—',
      locality.entidad||'—',
      locality.ambito||'—',
      locality.division||'—',
      locality.tarifaGdbt==null?'—':fmt(locality.tarifaGdbt),
      Number.isFinite(locality.distanciaKm)?locality.distanciaKm.toLocaleString('es-MX',{minimumFractionDigits:1,maximumFractionDigits:1})+' km':'—',
      period
    ]);
    if(localities.length>localityTableLimit){
      localityRows.push([
        '…',
        'Más '+(localities.length-localityTableLimit).toLocaleString('es-MX')+' localidades',
        'Detalle completo en Excel',
        '',
        '',
        '',
        '',
        '',
        ''
      ]);
    }
    const chartRows=normalizedRecords
      .filter(record=>record.tarifa==='GDBT'&&Number.isFinite(Number(record.valor))&&Number(record.valor)>0)
      .sort((a,b)=>a.division.localeCompare(b.division,'es-MX'))
      .slice(0,6);
    const chart=chartRows.length?{
      key:'tariff-gdbt',
      group:'tariffs',
      title:'Tarifa media GDBT por división',
      subtitle:'Comparación homogénea de comercio en baja tensión · '+period+
        (divisions.length>chartRows.length?' · se grafican 6 de '+divisions.length+' divisiones; la tabla conserva todas':''),
      unit:'$/kWh',
      decimals:3,
      data:chartRows.map((record,index)=>({
        label:record.division,
        value:Number(record.valor),
        color:this.ESTADO_PALETTE[index%this.ESTADO_PALETTE.length],
        detail:'GDBT · '+period
      })),
      source:'Fuente: '+(context.fuente||'CRE / CFE · Histórico DGMESNIE')
    }:null;
    const reportChart=chart?{
      ...chart,
      alt:'Gráfica de tarifa media GDBT por división',
      svgDataUrl:this._reportChartSvg(chart)
    }:null;
    const section={
      key:'tarifas-electricas',kicker:'Precios energéticos',color:'#A57F2C',
      title:'Tarifas eléctricas por división',
      intro:'Divisiones tarifarias que intersectan la geometría evaluada. Se presenta el último histórico disponible ('+
        period+'). Cada localidad hereda la tarifa aplicable de su división eléctrica; no representa un precio exclusivo de la localidad ni una tarifa vigente.',
      hasRows:true,
      rows:[
        ['Localidades intersectadas',localities.length.toLocaleString('es-MX')],
        ['Divisiones intersectadas',divisions.length.toLocaleString('es-MX')],
        ['Periodo histórico',period],
        ['Unidad de comparación','pesos por kWh']
      ],
      hasChips:false,chips:[],
      hasCharts:!!reportChart,charts:reportChart?[reportChart]:[],
      hasTable:true,
      table:{
        head:['División',...referenceTariffs.map(item=>item.label)],
        rows:tableRows
      },
      hasTable2:localityRows.length>0,
      table2:{
        head:['CVEGEO','Localidad','Municipio','Entidad','Ámbito','División','GDBT','Distancia al centroide','Periodo'],
        rows:localityRows
      },
      source:context.fuente||'CRE / CFE · Cuadros tarifarios históricos DGMESNIE'
    };
    const permitsIndex=report.sections.findIndex(item=>item.key==='permits-electricity');
    const electricIndex=report.sections.findIndex(item=>item.key==='elec');
    const insertAt=permitsIndex>=0?permitsIndex+1:(electricIndex>=0?electricIndex+1:0);
    report.sections.splice(insertAt,0,section);
    if(!report.metrics.some(metric=>this._norm(metric&&metric.label)==='divisionestarifarias')){
      report.metrics.push({
        label:'Divisiones tarifarias',
        value:divisions.length.toLocaleString('es-MX'),
        color:'#A57F2C',
        dim:false,
        sub:'intersectadas · histórico '+period
      });
    }
    if(localities.length&&!report.metrics.some(metric=>this._norm(metric&&metric.label)==='localidadestarifarias')){
      report.metrics.push({
        label:'Localidades tarifarias',
        value:localities.length.toLocaleString('es-MX'),
        color:'#C9A24B',
        dim:false,
        sub:'con tarifa aplicable según división'
      });
    }
    if(reportChart) report.charts=(Array.isArray(report.charts)?report.charts:[]).concat([reportChart]);
    report.tariffs={
      periodo:context.periodo,
      fuente:context.fuente,
      nota:context.nota,
      divisiones:divisions,
      registros:normalizedRecords,
      localidades:localities,
      mapaLocalidades:localityContext?{
        total:localityContext.total||localities.length,
        mostradas:Array.isArray(localityContext.mapFeatures)?localityContext.mapFeatures.length:0,
        omitidas:localityContext.mapOmitted||0
      }:null
    };
  }

  async _loadFuelPricesInAnalysis(A){
    if(!A||!Array.isArray(A.ranKeys)||!A.ranKeys.includes('perm_pet')||!window.turf) return null;
    const key=this._analysisSelectionKey(A);
    if(this._fuelPriceReportCache&&this._fuelPriceReportCache.key===key){
      return this._fuelPriceReportCache.value;
    }
    let bbox;
    try{ bbox=window.turf.bbox(this._reportAnalysisGeo(A)); }catch(e){ return null; }
    if(!Array.isArray(bbox)||bbox.length<4) return null;
    const minLon=Math.max(-118,Number(bbox[0])),minLat=Math.max(14,Number(bbox[1]));
    const maxLon=Math.min(-86,Number(bbox[2])),maxLat=Math.min(33.5,Number(bbox[3]));
    if(!(minLon<maxLon&&minLat<maxLat)) return null;
    const params=new URLSearchParams({
      minLat:minLat.toFixed(6),
      minLon:minLon.toFixed(6),
      maxLat:maxLat.toFixed(6),
      maxLon:maxLon.toFixed(6)
    });
    try{
      const response=await fetch('/DashboardProyectos/PreciosCombustibles?'+params.toString(),{
        method:'GET',credentials:'same-origin',headers:{Accept:'application/json'}
      });
      const payload=await response.json().catch(()=>null);
      if(!response.ok||!payload||!payload.ok||!payload.data) return null;
      const stations=(Array.isArray(payload.data.estaciones)?payload.data.estaciones:[])
        .filter(station=>this._analysisContainsPoint(A,Number(station.latitud),Number(station.longitud)))
        .map(station=>{
          const feature={
            type:'Feature',
            properties:{},
            geometry:{type:'Point',coordinates:[Number(station.longitud),Number(station.latitud)]}
          };
          return {...station,distanciaKm:this._distanceFromAnalysisCentroidKm(A,feature)};
        })
        .sort((a,b)=>
          (Number.isFinite(a.distanciaKm)?a.distanciaKm:Number.POSITIVE_INFINITY)-
          (Number.isFinite(b.distanciaKm)?b.distanciaKm:Number.POSITIVE_INFINITY)
        );
      const value={...payload.data,estaciones:stations};
      this._fuelPriceReportCache={key,value};
      return value;
    }catch(e){
      return null;
    }
  }

  _appendFuelPricesToReport(report,context){
    if(!report||!context||!Array.isArray(context.estaciones)||!context.estaciones.length) return;
    const section=(report.sections||[]).find(item=>item&&item.key==='permits-petroleum');
    if(!section) return;
    const stations=context.estaciones;
    const fmtPrice=value=>{
      const number=Number(value);
      return Number.isFinite(number)&&number>0
        ?'$'+number.toLocaleString('es-MX',{minimumFractionDigits:2,maximumFractionDigits:2})
        :'—';
    };
    const queriedAt=context.fechaConsulta?new Date(context.fechaConsulta):null;
    const cutoff=queriedAt&&!Number.isNaN(queriedAt.getTime())
      ?queriedAt.toLocaleString('es-MX',{dateStyle:'medium',timeStyle:'short'})
      :'consulta actual';
    section.rows=(Array.isArray(section.rows)?section.rows:[]).concat([
      ['Estaciones con precios reportados',stations.length.toLocaleString('es-MX')],
      ['Corte de consulta CNE',cutoff+(context.esRespaldo?' · último dato válido':'')]
    ]);
    const stationLimit=15;
    const stationRows=stations.slice(0,stationLimit).map(station=>[
      String(station.nombre||'Estación de servicio').slice(0,42),
      station.numeroPermiso||'—',
      fmtPrice(station.regular),
      fmtPrice(station.premium),
      fmtPrice(station.diesel),
      Number.isFinite(station.distanciaKm)
        ?station.distanciaKm.toLocaleString('es-MX',{minimumFractionDigits:1,maximumFractionDigits:1})+' km'
        :'—'
    ]);
    if(stations.length>stationLimit){
      stationRows.push([
        '… y '+(stations.length-stationLimit).toLocaleString('es-MX')+' estaciones más',
        'Detalle completo en Excel','','','',''
      ]);
    }
    section.hasTable2=true;
    section.table2={
      head:['Estación','Permiso','Regular','Premium','Diésel','Distancia al centroide'],
      rows:stationRows
    };
    const products=[
      {key:'regular',label:'Gasolina Regular',color:'#1E6F5C'},
      {key:'premium',label:'Gasolina Premium',color:'#9B2247'},
      {key:'diesel',label:'Diésel',color:'#2E6FB0'}
    ].map(product=>{
      const values=stations.map(station=>Number(station[product.key])).filter(value=>Number.isFinite(value)&&value>0);
      return values.length?{
        label:product.label,
        value:values.reduce((sum,value)=>sum+value,0)/values.length,
        color:product.color,
        detail:values.length.toLocaleString('es-MX')+' estaciones con dato'
      }:null;
    }).filter(Boolean);
    if(products.length){
      const chart={
        key:'fuel-prices-average',
        group:'fuel-prices',
        title:'Precio promedio reportado en la cobertura',
        subtitle:'Promedio simple de estaciones con dato · '+cutoff,
        unit:'$/litro',
        decimals:2,
        data:products,
        source:'Fuente: CNE · precios reportados por permisionarios'
      };
      const reportChart={
        ...chart,
        alt:'Gráfica de precios promedio de combustibles',
        svgDataUrl:this._reportChartSvg(chart)
      };
      section.hasCharts=true;
      section.charts=(Array.isArray(section.charts)?section.charts:[]).concat([reportChart]);
      report.charts=(Array.isArray(report.charts)?report.charts:[]).concat([reportChart]);
    }
    report.fuelPrices={
      fechaConsulta:context.fechaConsulta,
      esRespaldo:!!context.esRespaldo,
      fuente:context.fuente||'CNE · precios reportados por permisionarios',
      estaciones:stations
    };
  }

  _reportPermitIconKey(layerKey,properties){
    const props=properties||{};
    const permitType=this._norm(
      props.tipoPermiso||props.TipoPermiso||props.clasificacion||props.Clasificacion||''
    );
    if(layerKey==='perm_elec') return 'permit:perm_elec:'+this._centralTech(props);
    if(layerKey==='perm_pet'){
      if(permitType.includes('autoconsumo')) return 'permit:perm_pet:autoconsumo';
      if(permitType.includes('almacenamiento')) return 'permit:perm_pet:almacenamiento';
      if(permitType.includes('distribucion')) return 'permit:perm_pet:distribucion';
      return 'permit:perm_pet:expendio';
    }
    if(layerKey==='perm_glp'){
      if(permitType.includes('almacenamiento')) return 'permit:perm_glp:almacenamiento';
      if(permitType.includes('distribucion')) return 'permit:perm_glp:distribucion';
      return 'permit:perm_glp:expendio';
    }
    if(layerKey==='perm_gn') return 'permit:perm_gn:gas';
    return 'permit:perm_elec:TER';
  }

  _reportPermitLegendLabel(layerKey,properties){
    const props=properties||{};
    const permitType=String(
      props.tipoPermiso||props.TipoPermiso||props.clasificacion||props.Clasificacion||''
    ).trim();
    if(permitType&&this._norm(permitType)!=='sd') return permitType;
    return ({
      perm_elec:'Electricidad',
      perm_gn:'Gas natural',
      perm_glp:'Gas LP',
      perm_pet:'Petrolíferos'
    })[layerKey]||'Permiso energético';
  }

  _reportTechIconKey(technology,shape){
    const code=String(technology||'').trim().toUpperCase();
    return 'tech:'+(shape==='pin'?'pin':'chip')+':'+(code||'DEF');
  }

  _loadReportMapIcon(iconKey){
    if(!iconKey) return Promise.resolve(null);
    this._reportMapIconCache=this._reportMapIconCache||new Map();
    if(this._reportMapIconCache.has(iconKey)) return this._reportMapIconCache.get(iconKey);
    const promise=new Promise(resolve=>{
      const image=new Image();
      let settled=false;
      const finish=value=>{
        if(settled) return;
        settled=true;
        clearTimeout(timeout);
        resolve(value);
      };
      const timeout=setTimeout(()=>finish(null),7000);
      image.onload=()=>finish(image);
      image.onerror=()=>finish(null);
      image.decoding='async';
      image.src='data:image/svg+xml;charset=utf-8,'+encodeURIComponent(this._mapSymbolSvg(iconKey));
    });
    this._reportMapIconCache.set(iconKey,promise);
    return promise;
  }

  async _loadReportMapIcons(iconKeys){
    const keys=[...new Set((iconKeys||[]).filter(Boolean))];
    const entries=await Promise.all(keys.map(async key=>[key,await this._loadReportMapIcon(key)]));
    return new Map(entries);
  }

  _reportDatasetMapContext(A){
    const features=[];
    const sources=[];
    (this.state.datasets||[]).filter(dataset=>dataset&&dataset.active).forEach(dataset=>{
      let count=0;
      (dataset.rows||[]).forEach(row=>{
        const latLng=this._placeRow(row,dataset);
        if(!latLng||!this._analysisContainsPoint(A,latLng[0],latLng[1])) return;
        const technology=this._dsRowTech(row);
        const color=this._tecColor(technology);
        features.push({
          type:'Feature',
          properties:{
            datasetId:dataset.id||'',
            datasetName:dataset.name||'Dataset',
            target:dataset.target||'',
            technology:technology||'',
            technologyLabel:this._tecLabel(technology),
            iconKey:this._reportTechIconKey(technology,dataset.target==='proyectos'?'pin':'chip'),
            color,
            label:this._dsRowName(row)
          },
          geometry:{type:'Point',coordinates:[latLng[1],latLng[0]]}
        });
        count++;
      });
      if(count){
        sources.push({
          id:dataset.id||'',
          name:dataset.name||'Dataset',
          target:dataset.target||'',
          count
        });
      }
    });
    return {
      geo:{type:'FeatureCollection',features},
      sources
    };
  }

  _reportAnalysisGeo(A){
    if(A&&A.analysisGeometry) return this._asFeatureCollection(A.analysisGeometry);
    if(A&&isFinite(A.lat)&&isFinite(A.lng)&&isFinite(A.radiusKm)&&window.turf){
      try{
        return {
          type:'FeatureCollection',
          features:[window.turf.circle([A.lng,A.lat],A.radiusKm,{steps:72,units:'kilometers'})]
        };
      }catch(e){}
    }
    return {type:'FeatureCollection',features:[]};
  }

  _reportAnalysisLayerGeo(key){
    const geo=(this._analysisFilteredGeo||{})[key];
    if(geo&&Array.isArray(geo.features)){
      return {
        type:'FeatureCollection',
        features:geo.features.slice(),
        ...(geo.meta?{meta:geo.meta}:{})
      };
    }
    return {type:'FeatureCollection',features:[]};
  }

  _reportLineGeo(){
    const analyzed=this._reportAnalysisLayerGeo('red_lineas');
    if((analyzed.features||[]).length) return analyzed;
    const features=[];
    const appendLines=(latlngs,properties)=>{
      if(!Array.isArray(latlngs)||!latlngs.length) return;
      if(latlngs[0]&&isFinite(latlngs[0].lat)&&isFinite(latlngs[0].lng)){
        const coordinates=latlngs.map(point=>[point.lng,point.lat]).filter(point=>isFinite(point[0])&&isFinite(point[1]));
        if(coordinates.length>=2) features.push({type:'Feature',properties:properties||{},geometry:{type:'LineString',coordinates}});
        return;
      }
      latlngs.forEach(part=>appendLines(part,properties));
    };
    Array.from(this._anaLineSet||[]).forEach(layer=>{
      try{ appendLines(layer.getLatLngs(),layer._rec||{}); }catch(e){}
    });
    return {type:'FeatureCollection',features};
  }

  _reportSubstationGeo(key){
    const analyzed=this._reportAnalysisLayerGeo(key);
    if((analyzed.features||[]).length) return analyzed;
    const expected=key==='red_se_transmision'?'transmision':null;
    const features=Array.from(this._anaSubSet||[]).filter(item=>{
      if(!item||!isFinite(item.lat)||!isFinite(item.lng)) return false;
      const level=String((item.props||{}).network_level||'').toLowerCase();
      return expected?level===expected:level!=='transmision';
    }).map(item=>({
      type:'Feature',
      properties:{
        ...(item.props||{}),
        name:item.name||((item.props||{}).name)||'Subestación',
        voltage_kv:item.kv||((item.props||{}).voltage_kv)||null
      },
      geometry:{type:'Point',coordinates:[item.lng,item.lat]}
    }));
    return {type:'FeatureCollection',features};
  }

  _reportThematicBbox(A,layers,preferLayers=false,aspectRatio=1.99){
    const analysis=this._reportAnalysisGeo(A);
    const layerFeatures=(layers||[]).flatMap(layer=>this._normFeatures(layer&&layer.geo));
    const features=preferLayers&&layerFeatures.length
      ?layerFeatures
      :((analysis.features||[]).length?analysis.features:layerFeatures);
    let minLon=Infinity,minLat=Infinity,maxLon=-Infinity,maxLat=-Infinity;
    features.forEach(feature=>{
      const bbox=this._featureBBox(feature&&feature.geometry);
      if(!bbox) return;
      minLon=Math.min(minLon,bbox.minLon); minLat=Math.min(minLat,bbox.minLat);
      maxLon=Math.max(maxLon,bbox.maxLon); maxLat=Math.max(maxLat,bbox.maxLat);
    });
    if(!isFinite(minLon)) return [-118.5,14.3,-86.5,32.8];
    let lonSpan=Math.max(.08,maxLon-minLon),latSpan=Math.max(.08,maxLat-minLat);
    const centerLon=(minLon+maxLon)/2,centerLat=(minLat+maxLat)/2;
    const cosLat=Math.max(.35,Math.cos(centerLat*Math.PI/180));
    const projectedAspect=(lonSpan*cosLat)/latSpan;
    const targetAspect=Math.max(.8,Number(aspectRatio)||1.99);
    if(projectedAspect<targetAspect){
      lonSpan=targetAspect*latSpan/cosLat;
    }else{
      latSpan=lonSpan*cosLat/targetAspect;
    }
    minLon=centerLon-lonSpan/2; maxLon=centerLon+lonSpan/2;
    minLat=centerLat-latSpan/2; maxLat=centerLat+latSpan/2;
    const padLon=lonSpan*.085,padLat=latSpan*.085;
    return [minLon-padLon,minLat-padLat,maxLon+padLon,maxLat+padLat];
  }

  _renderThematicMap(spec,A){
    const canvas=document.createElement('canvas');
    canvas.width=1440; canvas.height=780;
    const ctx=canvas.getContext('2d');
    if(!ctx) return null;
    const mapX=34,mapY=34,mapW=1372,mapH=690;
    const bbox=this._reportThematicBbox(
      A,
      spec.layers||[],
      spec.fitToLayers===true,
      mapW/mapH
    );
    const clampLat=lat=>Math.max(-85,Math.min(85,Number(lat)||0));
    const mercatorY=lat=>Math.log(Math.tan(Math.PI/4+clampLat(lat)*Math.PI/360));
    const minMerc=mercatorY(bbox[1]),maxMerc=mercatorY(bbox[3]);
    const project=coordinate=>{
      const lon=Number(coordinate&&coordinate[0]),lat=Number(coordinate&&coordinate[1]);
      return [
        mapX+(lon-bbox[0])/Math.max(1e-9,bbox[2]-bbox[0])*mapW,
        mapY+(maxMerc-mercatorY(lat))/Math.max(1e-9,maxMerc-minMerc)*mapH
      ];
    };
    const resolveStyle=(style,feature)=>{
      const value={...(style||{})};
      ['color','fillColor','fillOpacity','opacity','weight','radius','iconImage','iconSize','clusterColor'].forEach(key=>{
        if(typeof value[key]==='function') value[key]=value[key](feature);
      });
      return value;
    };
    const drawPointMarker=(point,style)=>{
      const st=style||{};
      const color=st.fillColor||st.color||'#6F6B66';
      const opacity=st.opacity==null?1:Number(st.opacity);
      const fillOpacity=st.fillOpacity==null?1:Number(st.fillOpacity);
      const icon=st.iconImage;
      if(icon&&icon.complete&&icon.naturalWidth>0){
        const size=Math.max(24,Math.min(46,Number(st.iconSize)||34));
        ctx.save();
        ctx.globalAlpha=opacity;
        ctx.shadowColor='rgba(28,27,26,.28)';
        ctx.shadowBlur=7;
        ctx.shadowOffsetY=2;
        ctx.fillStyle='#FFFFFF';
        ctx.beginPath();
        ctx.arc(point[0],point[1],size*.54,0,Math.PI*2);
        ctx.fill();
        ctx.shadowColor='transparent';
        const ratio=icon.naturalWidth/Math.max(1,icon.naturalHeight);
        const drawW=ratio>=1?size:size*ratio;
        const drawH=ratio>=1?size/ratio:size;
        ctx.drawImage(icon,point[0]-drawW/2,point[1]-drawH/2,drawW,drawH);
        ctx.restore();
        return;
      }
      ctx.save();
      ctx.globalAlpha=opacity;
      ctx.beginPath();
      ctx.arc(point[0],point[1],Math.max(3,Number(st.radius)||6),0,Math.PI*2);
      if(fillOpacity>0){
        ctx.save();
        ctx.globalAlpha=opacity*fillOpacity;
        ctx.fillStyle=color;
        ctx.fill();
        ctx.restore();
      }
      ctx.strokeStyle=st.strokeColor||st.color||'#FFFFFF';
      ctx.lineWidth=Math.max(1,Number(st.weight)||1.5);
      ctx.stroke();
      ctx.restore();
    };
    const drawClusterMarker=(point,count,style)=>{
      const st=style||{};
      const color=st.clusterColor||st.fillColor||st.color||'#9B2247';
      const radius=Math.max(16,Math.min(27,15+Math.log10(Math.max(2,count))*7));
      ctx.save();
      ctx.shadowColor='rgba(28,27,26,.28)';
      ctx.shadowBlur=8;
      ctx.shadowOffsetY=2;
      ctx.fillStyle='#FFFFFF';
      ctx.beginPath();
      ctx.arc(point[0],point[1],radius+4,0,Math.PI*2);
      ctx.fill();
      ctx.shadowColor='transparent';
      ctx.fillStyle=color;
      ctx.beginPath();
      ctx.arc(point[0],point[1],radius,0,Math.PI*2);
      ctx.fill();
      ctx.strokeStyle='#FFFFFF';
      ctx.lineWidth=2;
      ctx.stroke();
      ctx.fillStyle='#FFFFFF';
      ctx.font='800 '+(count>99?15:17)+'px "Noto Sans",Arial,sans-serif';
      ctx.textAlign='center';
      ctx.textBaseline='middle';
      ctx.fillText(count>999?'999+':String(count),point[0],point[1]+.5);
      ctx.restore();
    };
    const drawGeometry=(geometry,style,feature)=>{
      if(!geometry) return;
      const st=resolveStyle(style,feature);
      const color=st.color||'#6F6B66';
      const fillColor=st.fillColor||color;
      const opacity=st.opacity==null?1:Number(st.opacity);
      const fillOpacity=st.fillOpacity==null?0:Number(st.fillOpacity);
      const weight=Math.max(.5,Number(st.weight)||1.5);
      const drawLine=(coordinates,close)=>{
        if(!Array.isArray(coordinates)||!coordinates.length) return false;
        let moved=false;
        coordinates.forEach((coordinate,index)=>{
          if(!Array.isArray(coordinate)||!isFinite(coordinate[0])||!isFinite(coordinate[1])) return;
          const point=project(coordinate);
          if(!moved){ ctx.moveTo(point[0],point[1]); moved=true; }
          else ctx.lineTo(point[0],point[1]);
        });
        if(moved&&close) ctx.closePath();
        return moved;
      };
      const drawPolygon=polygon=>{
        ctx.save();
        ctx.beginPath();
        let hasPath=false;
        (polygon||[]).forEach(ring=>{ if(drawLine(ring,true)) hasPath=true; });
        if(hasPath&&fillOpacity>0){
          ctx.globalAlpha=fillOpacity;
          ctx.fillStyle=fillColor;
          try{ ctx.fill('evenodd'); }catch(e){ ctx.fill(); }
        }
        if(hasPath&&opacity>0){
          ctx.globalAlpha=opacity;
          ctx.strokeStyle=color; ctx.lineWidth=weight; ctx.lineJoin='round'; ctx.lineCap='round';
          if(Array.isArray(st.dash)) ctx.setLineDash(st.dash);
          ctx.stroke();
        }
        ctx.restore();
      };
      const type=geometry.type;
      if(type==='Point'){
        const point=project(geometry.coordinates||[]);
        drawPointMarker(point,{...st,fillColor,color,opacity,weight});
      }else if(type==='MultiPoint'){
        (geometry.coordinates||[]).forEach(coordinate=>drawGeometry({type:'Point',coordinates},st,feature));
      }else if(type==='LineString'){
        ctx.save(); ctx.beginPath();
        if(drawLine(geometry.coordinates||[],false)){
          ctx.globalAlpha=opacity; ctx.strokeStyle=color; ctx.lineWidth=weight; ctx.lineJoin='round'; ctx.lineCap='round';
          if(Array.isArray(st.dash)) ctx.setLineDash(st.dash);
          ctx.stroke();
        }
        ctx.restore();
      }else if(type==='MultiLineString'){
        (geometry.coordinates||[]).forEach(coordinates=>drawGeometry({type:'LineString',coordinates},st,feature));
      }else if(type==='Polygon'){
        drawPolygon(geometry.coordinates||[]);
      }else if(type==='MultiPolygon'){
        (geometry.coordinates||[]).forEach(drawPolygon);
      }else if(type==='GeometryCollection'){
        (geometry.geometries||[]).forEach(item=>drawGeometry(item,st,feature));
      }
    };
    const drawGeo=(geo,style)=>{
      this._normFeatures(geo).forEach(feature=>drawGeometry(feature.geometry,style,feature));
    };
    const drawClusteredLayer=layer=>{
      const features=this._normFeatures(layer&&layer.geo);
      const points=features.filter(feature=>feature&&feature.geometry&&feature.geometry.type==='Point');
      const nonPoints=features.filter(feature=>!feature||!feature.geometry||feature.geometry.type!=='Point');
      if(nonPoints.length) drawGeo({type:'FeatureCollection',features:nonPoints},layer.style||{});
      if(!points.length) return;
      const cellSize=Math.max(24,Math.min(80,Number(layer.clusterRadius)||42));
      const buckets=new Map();
      points.forEach(feature=>{
        const point=project(feature.geometry.coordinates||[]);
        const cellX=Math.floor((point[0]-mapX)/cellSize);
        const cellY=Math.floor((point[1]-mapY)/cellSize);
        const key=cellX+':'+cellY;
        if(!buckets.has(key)) buckets.set(key,{sumX:0,sumY:0,items:[]});
        const bucket=buckets.get(key);
        bucket.sumX+=point[0];
        bucket.sumY+=point[1];
        bucket.items.push({feature,point});
      });
      buckets.forEach(bucket=>{
        if(bucket.items.length===1){
          const item=bucket.items[0];
          drawGeometry(item.feature.geometry,layer.style||{},item.feature);
          return;
        }
        const point=[bucket.sumX/bucket.items.length,bucket.sumY/bucket.items.length];
        const style=resolveStyle(layer.style||{},bucket.items[0].feature);
        drawClusterMarker(point,bucket.items.length,style);
      });
    };

    ctx.fillStyle='#F4F0EA'; ctx.fillRect(0,0,canvas.width,canvas.height);
    ctx.fillStyle='#FBFAF8'; ctx.fillRect(mapX,mapY,mapW,mapH);
    ctx.save(); ctx.beginPath(); ctx.rect(mapX,mapY,mapW,mapH); ctx.clip();
    const stateFeatures=((this.geo&&this.geo.estados&&this.geo.estados.features)||[]).filter(feature=>{
      const candidate=this._featureBBox(feature.geometry);
      return candidate&&!(candidate.maxLon<bbox[0]||candidate.minLon>bbox[2]||candidate.maxLat<bbox[1]||candidate.minLat>bbox[3]);
    });
    drawGeo({type:'FeatureCollection',features:stateFeatures},{color:'#D7D1C8',weight:1.2,fillOpacity:0,opacity:.9});
    const analysisGeo=this._reportAnalysisGeo(A);
    const territoryGeo=A&&A.territoryGeometry?this._asFeatureCollection(A.territoryGeometry):null;
    const hasTerritory=!!(territoryGeo&&(territoryGeo.features||[]).length);
    const hasTerritoryBuffer=hasTerritory&&Number(A&&A.bufferKm)>0;
    if(hasTerritoryBuffer){
      drawGeo(analysisGeo,{color:'#E0A12E',fillColor:'#E0A12E',weight:2.2,fillOpacity:.035,opacity:.82,dash:[9,6]});
    }
    if(hasTerritory){
      drawGeo(territoryGeo,{color:'#9B2247',fillColor:'#9B2247',weight:2.6,fillOpacity:.09,opacity:.92});
    }else{
      drawGeo(analysisGeo,{color:'#9B2247',fillColor:'#9B2247',weight:2.2,fillOpacity:.055,opacity:.75,dash:[8,6]});
    }
    (spec.layers||[]).forEach(layer=>{
      if(layer&&layer.cluster) drawClusteredLayer(layer);
      else drawGeo(layer&&layer.geo,layer&&layer.style||{});
    });
    if(hasTerritory){
      if(hasTerritoryBuffer) drawGeo(analysisGeo,{color:'#E0A12E',weight:3,fillOpacity:0,opacity:1,dash:[10,7]});
      drawGeo(territoryGeo,{color:'#9B2247',weight:3.5,fillOpacity:0,opacity:1});
    }else{
      drawGeo(analysisGeo,{color:'#9B2247',weight:3.1,fillOpacity:0,opacity:1,dash:[10,7]});
    }
    // Para análisis por punto, coordenadas o dirección se conserva el objetivo
    // exacto como pin central, siempre por encima de las capas y del radio.
    if(A&&!A.analysisGeometry&&isFinite(A.lat)&&isFinite(A.lng)){
      const point=project([A.lng,A.lat]);
      ctx.save();
      ctx.shadowColor='rgba(28,27,26,.32)';
      ctx.shadowBlur=9;
      ctx.shadowOffsetY=3;
      ctx.fillStyle='#9B2247';
      ctx.strokeStyle='#FFFFFF';
      ctx.lineWidth=3;
      ctx.beginPath();
      ctx.moveTo(point[0]-11,point[1]-22);
      ctx.quadraticCurveTo(point[0],point[1]+4,point[0]+11,point[1]-22);
      ctx.closePath();
      ctx.fill();
      ctx.stroke();
      ctx.beginPath();
      ctx.arc(point[0],point[1]-28,13,0,Math.PI*2);
      ctx.fill();
      ctx.stroke();
      ctx.beginPath();
      ctx.fillStyle='#FFFFFF';
      ctx.arc(point[0],point[1]-28,4.5,0,Math.PI*2);
      ctx.fill();
      ctx.restore();
    }
    ctx.restore();

    ctx.strokeStyle='#D9D3CB'; ctx.lineWidth=2; ctx.strokeRect(mapX,mapY,mapW,mapH);
    const legend=(spec.legendItems||[]).slice(0,10);
    if(legend.length){
      const panelW=Math.max(430,Math.min(540,Number(spec.legendWidth)||520));
      const wrapLegendText=(raw,maxWidth,maxLines)=>{
        const words=String(raw||'').split(/\s+/).filter(Boolean),lines=[];
        let current='';
        words.forEach(word=>{
          const next=current?current+' '+word:word;
          if(!current||ctx.measureText(next).width<=maxWidth) current=next;
          else{ lines.push(current); current=word; }
        });
        if(current) lines.push(current);
        const limit=Math.max(1,maxLines||2);
        if(lines.length>limit){
          const overflow=lines.slice(limit-1).join(' ');
          let clipped=overflow;
          while(clipped.length>1&&ctx.measureText(clipped+'…').width>maxWidth) clipped=clipped.slice(0,-1);
          return lines.slice(0,limit-1).concat([clipped.trimEnd()+'…']);
        }
        return lines.length?lines:['Capa'];
      };
      ctx.font='600 17px "Noto Sans",Arial,sans-serif';
      const preparedLegend=legend.map(item=>({
        item,
        lines:wrapLegendText(item.label||'Capa',panelW-82,2)
      }));
      ctx.font='500 15px "Noto Sans",Arial,sans-serif';
      const extraLines=spec.legendExtra?wrapLegendText(spec.legendExtra,panelW-36,2):[];
      const rowHeights=preparedLegend.map(entry=>entry.lines.length>1?43:31);
      const panelH=48+rowHeights.reduce((sum,height)=>sum+height,0)+(extraLines.length?extraLines.length*18+17:0);
      const x=mapX+18,y=mapY+18;
      ctx.save(); ctx.globalAlpha=.94; ctx.fillStyle='#FFFFFF'; ctx.fillRect(x,y,panelW,panelH); ctx.globalAlpha=1;
      ctx.strokeStyle='#E5DFD7'; ctx.lineWidth=1.5; ctx.strokeRect(x,y,panelW,panelH);
      ctx.fillStyle='#9B2247'; ctx.font='700 18px "Noto Sans",Arial,sans-serif';
      ctx.fillText(String(spec.legendTitle||'Simbología').toUpperCase(),x+18,y+29);
      let rowY=y+51;
      preparedLegend.forEach((entry,index)=>{
        const item=entry.item;
        const rowHeight=rowHeights[index];
        const cy=rowY+Math.min(14,rowHeight/2);
        ctx.strokeStyle=item.color||'#6F6B66'; ctx.fillStyle=item.color||'#6F6B66';
        if(item.type==='line'){
          ctx.lineWidth=4; ctx.beginPath(); ctx.moveTo(x+19,cy); ctx.lineTo(x+48,cy); ctx.stroke();
        }else if(item.type==='icon'&&item.image&&item.image.complete&&item.image.naturalWidth>0){
          ctx.fillStyle='#FFFFFF';
          ctx.beginPath();
          ctx.arc(x+34,cy,13,0,Math.PI*2);
          ctx.fill();
          const ratio=item.image.naturalWidth/Math.max(1,item.image.naturalHeight);
          const drawW=ratio>=1?24:24*ratio;
          const drawH=ratio>=1?24/ratio:24;
          ctx.drawImage(item.image,x+34-drawW/2,cy-drawH/2,drawW,drawH);
        }else if(item.type==='point'){
          ctx.beginPath(); ctx.arc(x+34,cy,6,0,Math.PI*2);
          if(!item.hollow) ctx.fill();
          ctx.strokeStyle=item.hollow?(item.color||'#8E9AAD'):'#FFFFFF';
          ctx.lineWidth=item.hollow?2.2:1.5;
          ctx.stroke();
        }else{
          ctx.globalAlpha=.72; ctx.fillRect(x+20,cy-8,27,16); ctx.globalAlpha=1; ctx.strokeStyle=item.color||'#6F6B66'; ctx.lineWidth=1.5; ctx.strokeRect(x+20,cy-8,27,16);
        }
        ctx.fillStyle='#2A2927'; ctx.font='600 17px "Noto Sans",Arial,sans-serif';
        entry.lines.forEach((line,lineIndex)=>ctx.fillText(line,x+61,rowY+16+lineIndex*19));
        rowY+=rowHeight;
      });
      if(extraLines.length){
        ctx.fillStyle='#6F6B66'; ctx.font='500 15px "Noto Sans",Arial,sans-serif';
        extraLines.forEach((line,index)=>ctx.fillText(line,x+18,rowY+17+index*18));
      }
      ctx.restore();
    }
    ctx.fillStyle='#6F6B66'; ctx.font='600 15px "Noto Sans",Arial,sans-serif';
    ctx.fillText(String(spec.source||'Fuente: DGMESNIE · SENER'),mapX,mapY+mapH+31);
    try{ return canvas.toDataURL('image/png'); }catch(e){ return null; }
  }

  async _attachReportThematicMaps(report,tariffLocalities){
    if(!report) return report;
    const A=this.state.analysis||{};
    const attach=(key,spec)=>{
      const section=(report.sections||[]).find(item=>item&&item.key===key);
      if(!section) return;
      const dataUrl=this._renderThematicMap(spec,A);
      if(!dataUrl) return;
      section.hasMap=true;
      section.mapDataUrl=dataUrl;
      section.mapAlt=spec.alt||('Mapa temático de '+String(section.title||'la sección').toLowerCase());
      section.mapCaption=spec.caption==null?'Mapa temático recortado al territorio analizado.':String(spec.caption);
      section.mapAspect=1440/780;
    };
    const attachGallery=(key,specs)=>{
      const section=(report.sections||[]).find(item=>item&&item.key===key);
      if(!section) return;
      const maps=(specs||[]).map(spec=>{
        const dataUrl=this._renderThematicMap(spec,A);
        return dataUrl?{
          title:spec.title||'Mapa temático',
          mapDataUrl:dataUrl,
          mapAlt:spec.alt||('Mapa temático de '+String(spec.title||section.title||'la sección').toLowerCase()),
          mapCaption:spec.caption==null?'Mapa temático recortado al territorio analizado.':String(spec.caption),
          mapAspect:1440/780
        }:null;
      }).filter(Boolean);
      if(!maps.length) return;
      section.hasMapGallery=true;
      section.mapGallery=maps;
    };

    const permitDefinitions=[
      {key:'perm_elec',label:'Electricidad',color:'#9B2247'},
      {key:'perm_gn',label:'Gas natural',color:'#2E6FB0'},
      {key:'perm_glp',label:'Gas LP',color:'#E0A12E'},
      {key:'perm_pet',label:'Petrolíferos',color:'#C0552E'}
    ];
    const permitContexts=permitDefinitions.map(definition=>({
      ...definition,
      geo:(A.ranKeys||[]).includes(definition.key)
        ?((this._analysisFilteredGeo||{})[definition.key]||{type:'FeatureCollection',features:[]})
        :{type:'FeatureCollection',features:[]}
    })).filter(context=>(context.geo.features||[]).length);
    const datasetMapContext=this._reportDatasetMapContext(A);
    const iconKeys=[];
    permitContexts.forEach(context=>(context.geo.features||[]).forEach(feature=>{
      iconKeys.push(this._reportPermitIconKey(context.key,feature.properties));
    }));
    (datasetMapContext.geo.features||[]).forEach(feature=>iconKeys.push((feature.properties||{}).iconKey));
    const centralGeo=(this._analysisFilteredGeo||{}).centrales;
    const centralIconKey=feature=>this._reportTechIconKey(this._centralTech((feature&&feature.properties)||{}),'chip');
    if(centralGeo&&(centralGeo.features||[]).length){
      (centralGeo.features||[]).forEach(feature=>iconKeys.push(centralIconKey(feature)));
    }
    const iconImages=await this._loadReportMapIcons(iconKeys);
    const firstCentralIconKey=centralGeo&&(centralGeo.features||[]).length?centralIconKey(centralGeo.features[0]):null;

    const electricLayers=[];
    const lineGeo=this._reportLineGeo();
    const transmissionSubstationGeo=this._reportSubstationGeo('red_se_transmision');
    const distributionSubstationGeo=this._reportSubstationGeo('red_se_distribucion');
    const permitGeo=(this._analysisFilteredGeo||{}).perm_elec;
    const lowVoltageWhiteLines={
      type:'FeatureCollection',
      features:(lineGeo.features||[]).filter(feature=>{
        const kv=Number((feature.properties||{}).voltage_kv)||0;
        return kv>=13.2&&kv<60;
      })
    };
    if(lowVoltageWhiteLines.features.length) electricLayers.push({
      geo:lowVoltageWhiteLines,
      style:{
        color:'#27313B',
        weight:feature=>Math.max(2.8,this._lineWeightForKv(Number((feature.properties||{}).voltage_kv)||0)*.78+1.8),
        opacity:.72
      }
    });
    if((lineGeo.features||[]).length) electricLayers.push({
      geo:lineGeo,
      style:{
        color:feature=>this._colorForKv(Number((feature.properties||{}).voltage_kv)||0),
        weight:feature=>Math.max(1.4,this._lineWeightForKv(Number((feature.properties||{}).voltage_kv)||0)*.78),
        opacity:.92
      }
    });
    if((transmissionSubstationGeo.features||[]).length) electricLayers.push({
      geo:transmissionSubstationGeo,
      style:{color:'#8E9AAD',strokeColor:'#8E9AAD',fillColor:'#FFFFFF',fillOpacity:0,radius:5.2,weight:2,opacity:1}
    });
    if((distributionSubstationGeo.features||[]).length) electricLayers.push({
      geo:distributionSubstationGeo,
      style:{color:'#FFFFFF',strokeColor:'#FFFFFF',fillColor:'#FF9652',fillOpacity:.94,radius:3.8,weight:1.1,opacity:1}
    });
    if(centralGeo&&(centralGeo.features||[]).length) electricLayers.push({
      geo:centralGeo,
      style:{
        color:feature=>this._tecColor(this._centralTech((feature&&feature.properties)||{})),
        fillColor:feature=>this._tecColor(this._centralTech((feature&&feature.properties)||{})),
        opacity:.92,radius:4.5,weight:1.2,
        iconImage:feature=>iconImages.get(centralIconKey(feature)),
        iconSize:24
      }
    });
    if(permitGeo&&(permitGeo.features||[]).length) electricLayers.push({
      geo:permitGeo,
      style:{
        color:'#2E6FB0',fillColor:'#2E6FB0',opacity:.88,radius:4,weight:1.1,
        iconImage:feature=>iconImages.get(this._reportPermitIconKey('perm_elec',feature.properties)),
        iconSize:22
      }
    });
    if(electricLayers.length){
      const usedVoltageColors=new Set((lineGeo.features||[]).map(feature=>
        this._colorForKv(Number((feature.properties||{}).voltage_kv)||0)
      ));
      const voltageLegend=(lineGeo.features||[]).length
        ?this.KV_COLORS.filter(item=>usedVoltageColors.has(item.color)).map(item=>({
          color:item.color,
          label:item.label,
          type:'line'
        }))
        :[];
      attach('elec',{
        layers:electricLayers,
        fitToLayers:true,
        legendTitle:'Infraestructura eléctrica',
        legendItems:[
          ...voltageLegend,
          ...((transmissionSubstationGeo.features||[]).length?[{color:'#8E9AAD',label:'Subestaciones de transmisión · huecas',type:'point',hollow:true}]:[]),
          ...((distributionSubstationGeo.features||[]).length?[{color:'#FF9652',label:'Subestaciones de distribución',type:'point'}]:[]),
          ...(centralGeo&&(centralGeo.features||[]).length?[{
            color:'#C0552E',label:'Centrales eléctricas',type:'icon',image:iconImages.get(firstCentralIconKey)
          }]:[]),
          ...(permitGeo&&(permitGeo.features||[]).length?[{
            color:'#2E6FB0',label:'Permisos eléctricos',type:'icon',
            image:iconImages.get(this._reportPermitIconKey('perm_elec',(permitGeo.features||[])[0].properties))
          }]:[])
        ],
        legendWidth:470,
        source:'Fuente: DGMESNIE · SENER · CENACE · inventario conciliado y grafo eléctrico',
        caption:''
      });
    }

    const demandGeo=this._reportAnalysisLayerGeo('demanda_atlas');
    if((demandGeo.features||[]).length){
      attach('demanda-pronostico',{
        layers:[{
          geo:demandGeo,
          style:{
            color:'#FFFFFF',
            fillColor:feature=>this._atlasLayerColor(
              this.LAYERS.find(layer=>layer.key==='demanda_atlas'),
              (feature&&feature.properties)||{}
            ),
            fillOpacity:.72,opacity:.88,weight:1.5
          }
        }],
        fitToLayers:true,
        legendTitle:'Demanda regional medida',
        legendItems:[
          {color:'#D9EFF5',label:'Menos de 2,000 MW',type:'fill'},
          {color:'#83C5D2',label:'2,000–3,999 MW',type:'fill'},
          {color:'#2D9AB3',label:'4,000–6,499 MW',type:'fill'},
          {color:'#2E6FB0',label:'6,500–8,999 MW',type:'fill'},
          {color:'#9B2247',label:'9,000 MW o más',type:'fill'}
        ],
        source:'Fuente: CENACE · GraficaDemanda · Atlas SEN',
        caption:'Regiones CENACE intersectadas por la cobertura, coloreadas con la última demanda medida disponible.'
      });
    }

    const distributedGenerationGeo=this._reportAnalysisLayerGeo(
      'generacion_distribuida_atlas'
    );
    if((distributedGenerationGeo.features||[]).length){
      attach('generacion-distribuida',{
        layers:[{
          geo:distributedGenerationGeo,
          style:{
            color:'#FFFFFF',
            fillColor:feature=>this._atlasLayerColor(
              this.LAYERS.find(
                layer=>layer.key==='generacion_distribuida_atlas'
              ),
              (feature&&feature.properties)||{}
            ),
            fillOpacity:.8,opacity:.92,weight:1.4
          }
        }],
        fitToLayers:true,
        legendTitle:'Generación distribuida acumulada',
        legendItems:[
          {color:'#D8F3DC',label:'Menos de 50 MW',type:'fill'},
          {color:'#95D5B2',label:'50–99 MW',type:'fill'},
          {color:'#52B788',label:'100–199 MW',type:'fill'},
          {color:'#2D6A4F',label:'200–399 MW',type:'fill'},
          {color:'#0B3D2E',label:'400 MW o más',type:'fill'}
        ],
        source:'Fuente: CNE · Generación Distribuida y Limpia · Atlas SEN',
        caption:'Capacidad acumulada de generación distribuida por entidad federativa dentro de la cobertura analizada.'
      });
    }

    const consumptionGeo=this._reportAnalysisLayerGeo('tarifas_atlas');
    if((consumptionGeo.features||[]).length){
      const metricSpecs=['users','energy','intensity'].map(metric=>{
        const definition=this._tariffMetricDefinition(metric);
        const scale=this._tariffMetricScaleFromFeatures(
          consumptionGeo.features,
          metric
        );
        const year=String(
          (((consumptionGeo.features||[])[0]||{}).properties||{}).reference_year||
          (report.consumption&&report.consumption.referenceYear)||
          'referencia disponible'
        );
        return {
          title:definition.label+' por división tarifaria',
          layers:[{
            geo:consumptionGeo,
            style:{
              color:'#FFFFFF',
              fillColor:feature=>this._tariffMetricColor(
                (feature&&feature.properties)||{},
                metric,
                scale
              ),
              fillOpacity:.78,opacity:.92,weight:1.4
            }
          }],
          fitToLayers:true,
          legendTitle:definition.label+' · '+year,
          legendItems:this._tariffMetricLegend(
            metric,
            consumptionGeo.features
          ).map(item=>({...item,type:'fill'})),
          source:'Fuente: CNE · memorias de cálculo del Suministro Básico · Atlas SEN',
          caption:definition.label+' en las divisiones CFE identificadas dentro del territorio analizado; escala relativa al corte '+year+'.'
        };
      });
      attachGallery('usuarios-consumo',metricSpecs);
    }

    const attachPermitMap=(sectionKey,contexts,options)=>{
      if(!contexts.length&&!(options.layers||[]).length) return;
      const permitLegend=new Map();
      const permitLayers=contexts.map(context=>{
        (context.geo.features||[]).forEach(feature=>{
          const iconKey=this._reportPermitIconKey(context.key,feature.properties);
          const label=this._reportPermitLegendLabel(context.key,feature.properties);
          const legendKey=context.key+'|'+iconKey+'|'+this._norm(label);
          const current=permitLegend.get(legendKey)||{
            color:context.color,
            label,
            type:'icon',
            image:iconImages.get(iconKey),
            count:0
          };
          current.count++;
          permitLegend.set(legendKey,current);
        });
        return {
          geo:context.geo,
          cluster:true,
          clusterRadius:42,
          style:{
            color:context.color,
            fillColor:context.color,
            opacity:.95,
            radius:6,
            weight:1.5,
            iconImage:feature=>iconImages.get(this._reportPermitIconKey(context.key,feature.properties)),
            iconSize:34,
            clusterColor:context.color
          }
        };
      });
      let legendItems=[...permitLegend.values()].sort((a,b)=>b.count-a.count);
      const permitLegendLimit=Math.max(3,8-(options.legendItems||[]).length);
      if(legendItems.length>permitLegendLimit){
        const others=legendItems.slice(permitLegendLimit-1);
        legendItems=legendItems.slice(0,permitLegendLimit-1).concat([{
          color:'#8A9099',
          label:'Otros tipos',
          type:'fill',
          count:others.reduce((sum,item)=>sum+item.count,0)
        }]);
      }
      attach(sectionKey,{
        layers:[...(options.layers||[]),...permitLayers],
        legendTitle:options.legendTitle||'Permisos por tipo',
        legendItems:[
          ...(options.legendItems||[]),
          ...legendItems.map(item=>({...item,label:item.label+' · '+item.count.toLocaleString('es-MX')}))
        ],
        legendExtra:'Las burbujas agrupan permisos próximos y muestran su cantidad.',
        source:options.source||'Fuente: CRE · inventarios institucionales DGMESNIE',
        caption:options.caption||'Permisos contenidos en la cobertura con simbología institucional y agrupación visual de concentraciones.'
      });
    };

    const gasContexts=permitContexts.filter(context=>context.key==='perm_gn'||context.key==='perm_glp');
    const gasLayers=[],gasLegend=[];
    const sistrangasGeo=(A.ranKeys||[]).includes('ductos_sis')?(this._analysisFilteredGeo||{}).ductos_sis:null;
    const importDuctGeo=(A.ranKeys||[]).includes('ductos_imp')?(this._analysisFilteredGeo||{}).ductos_imp:null;
    if(sistrangasGeo&&(sistrangasGeo.features||[]).length){
      gasLayers.push({geo:sistrangasGeo,style:{color:'#2E6FB0',weight:3.5,opacity:.95}});
      gasLegend.push({color:'#2E6FB0',label:'Ductos SISTRANGAS',type:'line'});
    }
    if(importDuctGeo&&(importDuctGeo.features||[]).length){
      gasLayers.push({geo:importDuctGeo,style:{color:'#A57F2C',weight:3.2,opacity:.92,dash:[9,5]}});
      gasLegend.push({color:'#A57F2C',label:'Ductos de importación',type:'line'});
    }
    attachPermitMap('permits-gas',gasContexts,{
      layers:gasLayers,
      legendItems:gasLegend,
      legendTitle:'Gas natural y Gas LP',
      source:'Fuente: CENAGAS / CRE · inventarios institucionales DGMESNIE',
      caption:'Ductos y permisos de gas natural y Gas LP contenidos en la cobertura; el territorio original se conserva en contorno guinda.'
    });

    const petroleumContexts=permitContexts.filter(context=>context.key==='perm_pet');
    attachPermitMap('permits-petroleum',petroleumContexts,{
      legendTitle:'Petrolíferos por tipo',
      source:'Fuente: CNE / CRE · inventarios institucionales DGMESNIE',
      caption:'Permisos de petrolíferos y estaciones de servicio contenidos en la cobertura, agrupados por proximidad.'
    });

    if((datasetMapContext.geo.features||[]).length){
      const datasetLegend=new Map();
      (datasetMapContext.geo.features||[]).forEach(feature=>{
        const props=feature.properties||{};
        const legendKey=(props.datasetId||props.datasetName)+'|'+(props.technology||'');
        const current=datasetLegend.get(legendKey)||{
          color:props.color||'#1E9CB8',
          label:props.datasetName+(props.technologyLabel?' · '+props.technologyLabel:''),
          type:'icon',
          image:iconImages.get(props.iconKey),
          count:0
        };
        current.count++;
        datasetLegend.set(legendKey,current);
      });
      attach('ds',{
        layers:[{
          geo:datasetMapContext.geo,
          cluster:true,
          clusterRadius:42,
          style:{
            color:feature=>(feature.properties||{}).color||'#1E9CB8',
            fillColor:feature=>(feature.properties||{}).color||'#1E9CB8',
            opacity:.96,
            radius:6,
            weight:1.5,
            iconImage:feature=>iconImages.get((feature.properties||{}).iconKey),
            iconSize:34,
            clusterColor:feature=>(feature.properties||{}).color||'#1E9CB8'
          }
        }],
        legendTitle:'Datasets seleccionados',
        legendItems:[...datasetLegend.values()]
          .sort((a,b)=>b.count-a.count)
          .map(item=>({...item,label:item.label+' · '+item.count.toLocaleString('es-MX')})),
        legendExtra:'Las burbujas agrupan proyectos o registros próximos.',
        source:'Fuente: datasets vinculados por el usuario · DGMESNIE',
        caption:'PVIRCE, convocatorias y demás datasets activos representados por tecnología dentro del territorio analizado.'
      });
    }

    const polosGeo=await this._fetchPolosGeoCache();
    const polosInAnalysis={
      type:'FeatureCollection',
      features:((polosGeo&&polosGeo.features)||[]).filter(feature=>this._analysisFeatureIntersects(A,feature))
    };
    if(polosInAnalysis.features.length){
      attach('podecobi',{
        layers:[{geo:polosInAnalysis,style:{color:'#9B2247',fillColor:'#9B2247',fillOpacity:.48,opacity:1,weight:3}}],
        legendTitle:'PODECOBI',
        legendItems:[{color:'#9B2247',label:'Polo(s) intersectado(s)',type:'fill'}],
        source:'Fuente: DGMESNIE · declaratorias DOF/SIDOF',
        caption:'Geometría del PODECOBI intersectado por la cobertura territorial analizada.'
      });
    }

    const localityFeatures=Array.isArray(tariffLocalities&&tariffLocalities.mapFeatures)?tariffLocalities.mapFeatures:[];
    if(localityFeatures.length){
      const divisions=Array.isArray(tariffLocalities.divisions)?tariffLocalities.divisions:[];
      const divisionColors=new Map(divisions.map((division,index)=>[this._norm(division),this.ESTADO_PALETTE[index%this.ESTADO_PALETTE.length]]));
      const priceByDivision=new Map();
      ((report.tariffs&&report.tariffs.localidades)||[]).forEach(locality=>{
        if(locality.tarifaGdbt!=null&&!priceByDivision.has(this._norm(locality.division))) priceByDivision.set(this._norm(locality.division),locality.tarifaGdbt);
      });
      const divisionGeo=(this._analysisFilteredGeo||{}).tarifas_div;
      const tariffLayers=[{
        geo:{type:'FeatureCollection',features:localityFeatures},
        style:{
          color:feature=>divisionColors.get(this._norm((feature.properties||{})['DIVISIÓN']||(feature.properties||{}).DIVISION))||'#A57F2C',
          fillColor:feature=>divisionColors.get(this._norm((feature.properties||{})['DIVISIÓN']||(feature.properties||{}).DIVISION))||'#A57F2C',
          fillOpacity:.58,opacity:.72,weight:1
        }
      }];
      if(divisionGeo&&(divisionGeo.features||[]).length){
        tariffLayers.push({geo:divisionGeo,style:{color:'#5E5953',fillOpacity:0,opacity:.9,weight:2.8}});
      }
      attach('tarifas-electricas',{
        layers:tariffLayers,
        legendTitle:'División y tarifa GDBT',
        legendItems:divisions.map(division=>{
          const price=priceByDivision.get(this._norm(division));
          return {
            color:divisionColors.get(this._norm(division))||'#A57F2C',
            label:division+(price==null?'':' · '+Number(price).toLocaleString('es-MX',{minimumFractionDigits:3,maximumFractionDigits:3})+' $/kWh'),
            type:'fill'
          };
        }),
        legendExtra:tariffLocalities.mapOmitted
          ?'Vista generalizada: '+tariffLocalities.mapOmitted.toLocaleString('es-MX')+' polígonos se omiten sólo del mapa.'
          :'Cada polígono corresponde a una localidad intersectada.',
        source:'Fuente: CFE / CRE · histórico DGMESNIE · marco de localidades tarifarias',
        caption:'Localidades intersectadas coloreadas por división. La tarifa mostrada es la referencia GDBT aplicable según división, no un precio exclusivo de cada localidad.'
      });
    }
    return report;
  }

  _hasCompletedReportAnalysis(A){
    const analysis=A||this.state.analysis||{};
    const hasLayers=Array.isArray(analysis.ranKeys)&&analysis.ranKeys.length>0;
    const hasDatasets=(this.state.datasets||[]).some(dataset=>dataset&&dataset.active);
    return !!(analysis.lat!=null&&!analysis.stale&&(hasLayers||hasDatasets));
  }

  _reportLayerFindings(A,L){
    const analysis=A||this.state.analysis||{};
    const layerState=L||this.state.layers||{};
    return (analysis.ranKeys||[]).map((key,index)=>{
      const cfg=this.LAYERS.find(layer=>layer.key===key)||{};
      const current=layerState[key]||{};
      const filtered=this._reportAnalysisLayerGeo(key);
      const meta=(filtered&&filtered.meta)||((this._analysisSourceMeta||{})[key])||{};
      const count=Number(current.count)||0;
      const nearest=Number(current.nearest);
      const source=String(meta.source||meta.Fuente||(
        cfg.type==='graph'
          ?'DGMESNIE · inventario conciliado y grafo eléctrico'
          :'DGMESNIE · fuente territorial institucional'
      ));
      const result=count>0
        ?this._nf(count)+' '+(count===1?'elemento':'elementos')
        :(Number.isFinite(nearest)?'0 elementos · más cercano a '+nearest.toLocaleString('es-MX',{maximumFractionDigits:1})+' km':'0 elementos');
      return {
        order:index+1,
        key,
        category:cfg.cat||'Análisis territorial',
        label:cfg.label||current.label||key,
        color:cfg.color||current.color||'#9B2247',
        count,
        result,
        source,
        summarized:!!current.summarized,
        visualization:current.summarized
          ?'Conteo calculado · dibujo omitido por volumen'
          :'Elementos individuales en el mapa'
      };
    });
  }

  _reportElectricalNetwork(A){
    const ranKeys=new Set((A&&A.ranKeys)||[]);
    const definitions=[
      {key:'red_lineas',label:'Líneas de transmisión',kind:'edge',color:'#00A9CE'},
      {key:'red_se_transmision',label:'Subestaciones de transmisión',kind:'node',color:'#8E9AAD'},
      {key:'red_se_distribucion',label:'Subestaciones de distribución',kind:'node',color:'#FF9652'}
    ];
    return definitions.filter(item=>ranKeys.has(item.key)).map(item=>{
      const geo=this._reportAnalysisLayerGeo(item.key);
      const meta=(geo&&geo.meta)||((this._analysisSourceMeta||{})[item.key])||{};
      return {
        ...item,
        geo,
        features:(geo.features||[]).slice(),
        meta,
        source:String(meta.source||meta.Fuente||'DGMESNIE · inventario conciliado y grafo eléctrico')
      };
    });
  }

  _reportElectricalSubSection(networkLayer){
    const layer=networkLayer||{};
    const features=Array.isArray(layer.features)?layer.features:[];
    const SAMPLE=18;
    const shown=features.slice(0,SAMPLE);
    const isEdge=layer.kind==='edge';
    const table=isEdge
      ?{
        head:['Línea','Origen','Destino','Tensión','Longitud','Estado topológico'],
        rows:shown.map(feature=>{
          const p=(feature&&feature.properties)||{};
          return [
            p.name||'Línea de transmisión',
            p.from_name||'—',
            p.to_name||'—',
            p.voltage_kv?this._nf(Number(p.voltage_kv))+' kV':'—',
            p.length_km!=null?Number(p.length_km).toLocaleString('es-MX',{maximumFractionDigits:2})+' km':'—',
            String(p.connection_state||'—').replace(/_/g,' ')
          ];
        })
      }
      :{
        head:['Subestación','Nivel de red','Tensión','Líneas asociadas'],
        rows:shown.map(feature=>{
          const p=(feature&&feature.properties)||{};
          return [
            p.name||'Subestación',
            this._networkLevelLabel(p.network_level),
            p.voltage_kv?this._nf(Number(p.voltage_kv))+' kV':'—',
            this._nf(Number(p.connection_count)||0)
          ];
        })
      };
    const sampleNote=features.length>SAMPLE
      ?'Se muestran '+SAMPLE+' de '+this._nf(features.length)+' registros; el Excel incluye el inventario completo.'
      :'Se muestran los '+this._nf(features.length)+' registros identificados.';
    return {
      kicker:'Capa analizada',
      color:layer.color||'#9B2247',
      title:layer.label||'Infraestructura eléctrica',
      intro:sampleNote,
      rows:isEdge
        ?[
          ['Elementos en la cobertura',this._nf(features.length)],
          ['Fuente',layer.source||'DGMESNIE']
        ]
        :[['Elementos en la cobertura',this._nf(features.length)]],
      hasTable:table.rows.length>0,
      table
    };
  }

  _buildReport(){
    const A = this.state.analysis;
    if (!this._hasCompletedReportAnalysis(A)) return Promise.resolve(null);
    const L = this.state.layers;
    const feats = k => ((this._genericFeats||{})[k]||[]);
    const names = (k, n) => { const seen=new Set(), list=[]; feats(k).forEach(f=>{ const nm=f.nom; if(nm && !seen.has(nm)){ seen.add(nm); if(list.length<(n||8)) list.push(nm); } }); return { total:seen.size, list }; };
    const cnt = k => (L[k] && L[k].count) || 0;
    const ran = k => A.ranKeys.includes(k);
    // Texto de conteo con contexto: un cero indica a qué distancia está el elemento más cercano
    const cntTxt = k => {
      if(!ran(k)) return 'no analizada';
      const ct=cnt(k);
      if(ct>0) return this._nf(ct)+' en la cobertura';
      const nr=L[k]&&L[k].nearest;
      return !A.analysisGeometry&&nr?'ninguno · el más cercano a '+Math.round(nr)+' km':'ninguno en la cobertura';
    };
    let gerKey = this._gerenciaOf(A.estado||'');
    if(A.targetKind==='gcr'){
      const normalizedTarget=this._norm(A.targetLabel||'');
      gerKey=Object.keys(this.GCR_NOMBRE).find(key=>normalizedTarget.includes(this._norm(this.GCR_NOMBRE[key])))||gerKey;
    }
    let muni = ['state','gcr','demand-region','tariff-division'].includes(A.targetKind)
      ?'—'
      :(A.targetMunicipality||'—');
    const municipalityGeo=this._muniGeo||this._municipiosShortcutGeo;
    if (municipalityGeo&&!['state','gcr','demand-region','tariff-division'].includes(A.targetKind)) { for (const f of (municipalityGeo.features||[])) { if (this._inFeature(A.lng, A.lat, f.geometry)) { muni = (f.properties && (f.properties.NOMGEO||f.properties.nombre)) || muni; break; } } }
    const sections = [];
    const charts=this._buildElectricReportCharts(A,ran,feats);
    const layerFindings=this._reportLayerFindings(A,L);
    const electricalNetwork=this._reportElectricalNetwork(A);

    // Resuelve la sección PODECOBI en paralelo al resto del reporte.
    const polosSectionPromise = this._buildPolosSection(A).catch(() => null);

    // Corte maestro: una fila por cada capa realmente ejecutada. Esta tabla es la
    // fuente compartida para la vista, los dos PDF y el Excel.
    sections.push({
      key:'layer-cut',
      kicker:'Cobertura analizada',
      color:'#9B2247',
      icon:'M4 6h16 M4 12h16 M4 18h16',
      title:'Resultado por capa seleccionada',
      intro:'Cada fila corresponde a una capa ejecutada en la corrida territorial. El conteo, la forma de visualización y la fuente se conservan sin agregar capas que no fueron seleccionadas.',
      rows:[],
      chips:[],
      hasRows:false,
      hasChips:false,
      hasTable:true,
      tableLabel:'Capas ejecutadas',
      table:{
        head:['Categoría','Capa','Resultado','Visualización','Fuente'],
        rows:layerFindings.map(item=>[
          item.category,
          item.label,
          item.result,
          item.visualization,
          item.source
        ])
      },
      hasTable2:false
    });

    // Infraestructura eléctrica: sólo aparece cuando la corrida incluyó al menos
    // una capa eléctrica. Los mapas muestran cada activo como elemento individual.
    const electricalKeys=['red_lineas','red_se_transmision','red_se_distribucion','centrales','perm_elec'];
    const electricalFindings=layerFindings.filter(item=>electricalKeys.includes(item.key));
    if(electricalFindings.length){
      sections.push({
        key:'elec',
        kicker:'Infraestructura eléctrica',
        color:'#9B2247',
        icon:'M13 2 3 14h7l-1 8 10-12h-7z',
        title:'Infraestructura eléctrica identificada',
        intro:'Activos contenidos en la cobertura territorial para cada capa eléctrica seleccionada. Las subestaciones y líneas provienen del inventario conciliado y del grafo eléctrico de la base de datos.',
        rows:electricalFindings.map(item=>[item.label,item.result]),
        chips:[],
        hasChips:false,
        hasRows:true,
        hasTable:false,
        hasTable2:false,
        hasSubSections:electricalNetwork.length>0,
        subSections:electricalNetwork.map(layer=>this._reportElectricalSubSection(layer))
      });
    }
    const permitReport=this._buildEnergyPermitReport(A,ran,feats);
    if(Array.isArray(permitReport.sections)) sections.push(...permitReport.sections);
    if(Array.isArray(permitReport.charts)) charts.push(...permitReport.charts);
    // 2 · Impacto social — población indígena
    const socKeys = [['atlas_pi','Pueblos indígenas (atlas)'],['lenguas','Lenguas indígenas'],['loc_ind','Localidades indígenas'],['reg_ind','Regiones indígenas'],['ruta_wx','Ruta Wixárika']];
    const socRows = socKeys.filter(([k])=>ran(k)).map(([k,lab]) => [lab, cntTxt(k)]);
    // Detalle de elementos sociales identificados en la cobertura (todas las capas sociales analizadas)
    const socDetail = [];
    [['atlas_pi','Pueblo indígena'],['lenguas','Lengua indígena'],['loc_ind','Localidad indígena'],['reg_ind','Región indígena'],['ruta_wx','Ruta Wixárika']].forEach(([k,lab])=>{
      if (!ran(k)) return;
      const seen = new Set();
      feats(k).forEach(f => { const nm=f.nom; if (nm && !seen.has(nm)) { seen.add(nm); if (socDetail.length<14) socDetail.push([String(nm).slice(0,46), lab]); } });
    });
    const socTotal = ['atlas_pi','lenguas','loc_ind','reg_ind','ruta_wx'].filter(ran).reduce((s,k)=>{ const seen=new Set(); feats(k).forEach(f=>f.nom&&seen.add(f.nom)); return s+seen.size; },0);
    if (socTotal > 14) socDetail.push(['… y '+this._nf(socTotal-14)+' elementos más', '']);
    if(socRows.length) sections.push({ key:'social', kicker:'Impacto social', color:'#C0552E', icon:'M17 21v-2a4 4 0 0 0-3-3.87 M7 21v-2a4 4 0 0 1 4-4h1 M12 11a4 4 0 1 0 0-8 4 4 0 0 0 0 8z', title:'Población y comunidades indígenas',
      intro:'Presencia de comunidades que podrían requerir consulta previa, libre e informada (Convenio 169 OIT).',
      hasRows:true, rows:socRows, hasChips:false, chips:[],
      hasTable:socDetail.length>0, table:{ head:['Elemento identificado','Tipo'], rows:socDetail }, hasTable2:false });
    // 3 · Ambiental
    const ambKeys = [['anp','ANP federales'],['anp_est','ANP estatales'],['conserv','Conservación voluntaria'],['ramsar','Humedales RAMSAR']];
    const ambRows = ambKeys.filter(([k])=>ran(k)).map(([k,lab]) => [lab, cntTxt(k)]);
    const ambNames = ['anp','anp_est','ramsar','conserv'].filter(ran).map(k=>names(k,5).list).flat().slice(0,10);
    if(ambRows.length) sections.push({ key:'amb', kicker:'Medio ambiente', color:'#0E8A6E', icon:'M11 20A7 7 0 0 1 4 13C4 7 9 3 20 4c1 11-3 16-9 16z M4 21c3-3 6-5 9-6', title:'Áreas naturales protegidas',
      intro:'Superficies bajo protección que condicionan o excluyen el desarrollo del proyecto.',
      hasRows:true, rows:ambRows, hasChips:ambNames.length>0, chips:ambNames, hasTable:false, hasTable2:false });
    // 4 · Patrimonio cultural
    const patKeys = [['arqueo','Sitios arqueológicos'],['za_pub','Zonas arqueológicas'],['z_hist','Zonas históricas']];
    const patRows = patKeys.filter(([k])=>ran(k)).map(([k,lab]) => [lab, cntTxt(k)]);
    const patNames = ['za_pub','z_hist','arqueo'].filter(ran).map(k=>names(k,5).list).flat().slice(0,10);
    if(patRows.length) sections.push({ key:'pat', kicker:'Patrimonio cultural', color:'#C9A24B', icon:'M3 22h18 M5 22V10 M19 22V10 M12 2 3 7h18z M9 22v-6h6v6', title:'Patrimonio arqueológico e histórico',
      intro:'Elementos con protección INAH en el entorno del sitio.',
      hasRows:true, rows:patRows, hasChips:patNames.length>0, chips:patNames, hasTable:false, hasTable2:false });
    // 5 · Territorio y tenencia
    const terDefs=[
      ['ran','Núcleos agrarios (RAN)'],
      ['presas','Presas'],
      ['ductos_imp','Ductos de importación'],
      ['ductos_sis','Ductos SISTRANGAS'],
      ['centrales','Centrales eléctricas']
    ];
    const terRows=terDefs.filter(([key])=>ran(key)).map(([key,label])=>[label,cntTxt(key)]);
    const ranNames = ran('ran') ? names('ran',8).list : [];
    if(terRows.length) sections.push({ key:'ter', kicker:'Territorio', color:'#2E6FB0', icon:'M3 3h7v7H3z M14 3h7v7h-7z M3 14h7v7H3z M14 14h7v7h-7z', title:'Tenencia de la tierra e infraestructura',
      intro:'Núcleos agrarios (posible negociación ejidal/comunal) e infraestructura complementaria.',
      hasRows:true, rows:terRows, hasChips:ranNames.length>0, chips:ranNames, hasTable:false, hasTable2:false });
    // 6 · Datasets vinculados: registros de las fuentes conectadas dentro de la cobertura
    const dsAct = this.state.datasets.filter(d=>d.active);
    if (dsAct.length) {
      const rowsDs=[]; const inRows=[];
      dsAct.forEach(d=>{
        let inR=0;
        d.rows.forEach(r=>{ const ll=this._placeRow(r,d); if(!ll) return; if(this._analysisContainsPoint(A,ll[0],ll[1])){ inR++; inRows.push({ r, d }); } });
        rowsDs.push([d.name, this._nf(inR)+' de '+this._nf(d.rows.length)+' registros en la cobertura']);
      });
      // Detalle de los registros encontrados — sólo los campos más representativos
      const MAXR = 14;
      const tRows = inRows.slice(0, MAXR).map(({r,d}) => {
        const tec = this._dsRowTech(r);
        const cap = this._dsCapacityMw(r);
        const ent = this.CVE_ENT[r.cve_ent] || this._dsField(r, /entidad|nom_ent|^estado$/i) || '—';
        return [ this._dsRowName(r).slice(0,36), String(d.name).slice(0,26), tec?this._tecLabel(tec):'—', cap?this._nf(cap)+' MW':'—', String(ent).slice(0,16) ];
      });
      if (inRows.length > MAXR) tRows.push(['… y '+this._nf(inRows.length-MAXR)+' registros más (ver Excel)', '', '', '', '']);
      sections.push({ key:'ds', kicker:'Datasets vinculados', color:'#1E9CB8', icon:'M12 8c4.4 0 8-1.3 8-3s-3.6-3-8-3-8 1.3-8 3 3.6 3 8 3z M20 5v14c0 1.7-3.6 3-8 3s-8-1.3-8-3V5 M4 12c0 1.7 3.6 3 8 3s8-1.3 8-3', title:'Registros de datasets en la zona',
        intro:'Filas de las fuentes conectadas (convocatorias, permisos, seguimiento) cuya ubicación cae dentro de la cobertura. Los registros ubicados por territorio (centroide de entidad/gerencia) son aproximados.',
        hasRows:true, rows:rowsDs, hasChips:false, chips:[],
        hasTable:tRows.length>0, table:{ head:['Registro','Dataset','Tecnología','Capacidad','Entidad'], rows:tRows }, hasTable2:false });
    }
    const totalEl = A.ranKeys.reduce((s,k)=>s+cnt(k),0);
    // KPIs dinámicos: primero capas con datos dentro de la cobertura; después capas en cero.
    // Se mantienen subestaciones, líneas y centrales si están seleccionadas para
    // preservar los tres KPIs básicos de infraestructura en todos los formatos.
    const pri = ['red_se_transmision','red_se_distribucion','red_lineas','centrales'];
    const pool = A.ranKeys.map(k => ({
      key: k,
      ct: cnt(k),
      nr: (L[k] && Number.isFinite(L[k].nearest)) ? L[k].nearest : Number.POSITIVE_INFINITY,
      label: (L[k] && L[k].label) || k,
      color: (L[k] && L[k].color) || '#9B2247'
    }));
    const used = new Set();
    const ordered = [];
    const pushK = it => { if (!it || used.has(it.key)) return; used.add(it.key); ordered.push(it); };
    pri.forEach(k => pushK(pool.find(p => p.key===k)));
    pool.filter(p => p.ct>0).sort((a,b) => b.ct-a.ct).forEach(pushK);
    pool.filter(p => p.ct===0).sort((a,b) => a.nr-b.nr).forEach(pushK);
    const kpiLayers = ordered.slice(0,6);

    // KPI PODECOBI: lectura síncrona del cache poblado por _polosKpiCache.
    // Si el cache aún no está listo, lo pedimos en línea y bloqueamos.
    const polosKpi = this._polosKpiCache || null;

    const territorialKey=this._analysisSelectionKey(A);
    let territorialContext=this._reportTerritorialContext;
    if(!territorialContext||territorialContext.key!==territorialKey){
      territorialContext={
        key:territorialKey,
        entidades:this._entitiesInAnalysis(A),
        municipios:this._municipiosInAnalysis(A),
        gerencias:this._gerenciasInAnalysis(A)
      };
      this._reportTerritorialContext=territorialContext;
    }
    let intersectedEntidades=[...territorialContext.entidades];
    let intersectedMunicipios=[...territorialContext.municipios];
    const intersectedGerencias=[...territorialContext.gerencias];
    if(A.analysisGeometry&&Number(A.bufferKm||0)===0&&A.targetKind==='municipality'){
      intersectedEntidades=[A.targetState||A.estado].filter(Boolean);
      intersectedMunicipios=[A.targetMunicipality].filter(Boolean);
    }else if(A.analysisGeometry&&Number(A.bufferKm||0)===0&&A.targetKind==='state'){
      intersectedEntidades=[A.targetState||A.estado].filter(Boolean);
    }
    const centroidFeature=this._analysisCentroidFeature(A);
    const centroidCoordinates=centroidFeature&&centroidFeature.geometry&&centroidFeature.geometry.coordinates;
    const centerLng=Array.isArray(centroidCoordinates)&&isFinite(centroidCoordinates[0])?Number(centroidCoordinates[0]):Number(A.lng);
    const centerLat=Array.isArray(centroidCoordinates)&&isFinite(centroidCoordinates[1])?Number(centroidCoordinates[1]):Number(A.lat);
    const geoLink = `https://www.google.com/maps/search/?api=1&query=${centerLat.toFixed(5)}%2C${centerLng.toFixed(5)}`;
    const osmLink = `https://www.openstreetmap.org/?mlat=${centerLat.toFixed(5)}&mlon=${centerLng.toFixed(5)}#map=12/${centerLat.toFixed(5)}/${centerLng.toFixed(5)}`;
    const target=this._analysisTarget(A,muni,gerKey);
    const metaRows = [
      ['Tipo de objetivo', target.typeLabel],
      ['Objetivo evaluado', target.label],
      ['Referencia de ubicación', target.detail],
      ['Centroide de referencia', `${centerLat.toFixed(5)}, ${centerLng.toFixed(5)}`],
      ['Cobertura de análisis', this._analysisCoverageLabel(A,false)],
      ['Superficie analizada', (this._analysisAreaKm2(A)||0).toLocaleString('es-MX',{maximumFractionDigits:1})+' km²'],
      ['Estado', ['gcr','demand-region','tariff-division'].includes(A.targetKind)?'Varias entidades':(A.targetState || A.estado || '—')],
      ['Municipio', muni],
      ['Gerencia de control', 'GCR ' + (this.GCR_NOMBRE[gerKey] || '—')],
    ];
    if (intersectedEntidades.length) metaRows.push(['Entidades intersectadas', intersectedEntidades.join(', ')]);
    if (intersectedMunicipios.length) metaRows.push(['Municipios intersectados', intersectedMunicipios.slice(0, 8).join(', ') + (intersectedMunicipios.length > 8 ? ' +' + (intersectedMunicipios.length - 8) : '')]);
    if (intersectedGerencias.length) metaRows.push(['Gerencias intersectadas', intersectedGerencias.map(g => 'GCR ' + (this.GCR_NOMBRE[g] || g)).join(', ')]);
    metaRows.push(['Mapa (Google Maps)', 'Abrir en Google Maps', geoLink]);
    metaRows.push(['Mapa (OpenStreetMap)', 'Abrir en OpenStreetMap', osmLink]);
    metaRows.push(['Capas analizadas', String(A.ranKeys.length)]);
    return {
      date: new Date().toLocaleDateString('es-MX', { year:'numeric', month:'long', day:'numeric' }),
      meta: metaRows,
      metrics: [{ label:'Elementos totales', value:this._nf(totalEl), color:'#9B2247', dim:false, sub:'en la cobertura' }]
        .concat(polosKpi ? [polosKpi] : [])
        .concat(kpiLayers.map(it => {
          const nrTxt = !A.analysisGeometry&&Number.isFinite(it.nr) ? ('más cercano a '+Math.round(it.nr)+' km') : 'sin presencia en la cobertura';
          return {
            label: it.label,
            value: this._nf(it.ct),
            color: it.color,
            dim: it.ct===0,
            sub: it.ct>0 ? 'en la cobertura' : nrTxt
          };
        }))
        .concat(dsAct.map(d => { let inR=0; d.rows.forEach(r=>{ const ll=this._placeRow(r,d); if(ll && this._analysisContainsPoint(A,ll[0],ll[1])) inR++; }); return { label:d.name, value:this._nf(inR), color:d.color||'#1E9CB8', dim:inR===0, sub: inR>0 ? 'registros en la cobertura' : 'sin registros en la cobertura' }; })),
      legendGroups: this._legendGroups(false),
      charts,
      sections,
      layerFindings,
      electricalNetwork,
      target,
      energyPermits:permitReport.raw,
      _buildPolosSectionPromise: polosSectionPromise,
    };
  }

  // Versión async: construye el reporte y ESPERA la sección PODECOBI antes de
  // retornar. Usada por onOpenReport para garantizar que la sección aparezca
  // desde el primer render del modal.
  async _buildReportAsync(){
    await this._anaMunicipiosShortcutGeo().catch(()=>null);
    const rep = await this._buildReport();
    if (!rep) return null;
    const inegiArea=this._resolveInegiArea(this.state.analysis);
    const [
      sec,inegiContext,tariffLocalities,fuelPriceContext,
      demandContext,consumptionContext,distributedGenerationContext
    ] = await Promise.all([
      rep._buildPolosSectionPromise,
      this._loadInegiReportContext(inegiArea),
      this._loadTariffLocalitiesInAnalysis(this.state.analysis).catch(()=>null),
      this._loadFuelPricesInAnalysis(this.state.analysis).catch(()=>null),
      this._loadDemandReportContext(this.state.analysis).catch(()=>null),
      this._loadConsumptionReportContext(this.state.analysis).catch(()=>null),
      this._loadDistributedGenerationReportContext(this.state.analysis).catch(()=>null)
    ]);
    const tariffDivisions=tariffLocalities&&Array.isArray(tariffLocalities.divisions)&&tariffLocalities.divisions.length
      ?tariffLocalities.divisions
      :this._tariffDivisionsInAnalysis();
    const tariffContext=await this._loadTariffReportContext(tariffDivisions);
    if (sec && !rep.sections.find(s => s.key === 'podecobi')) {
      // Inserta PODECOBI justo después de la sección eléctrica (índice 1) o al inicio
      const idx = rep.sections.findIndex(s => s.key === 'elec');
      if (idx >= 0) rep.sections.splice(idx + 1, 0, sec);
      else rep.sections.unshift(sec);
    }
    this._appendDemandToReport(rep,demandContext);
    this._appendConsumptionToReport(rep,consumptionContext);
    this._appendDistributedGenerationToReport(rep,distributedGenerationContext);
    this._appendTariffsToReport(rep,tariffContext,tariffLocalities);
    this._appendInegiToReport(rep,inegiContext);
    this._appendFuelPricesToReport(rep,fuelPriceContext);
    await this._attachReportThematicMaps(rep,tariffLocalities);
    this._orderReportSections(rep);
    return rep;
  }

  // Entidades federativas cuyo polígono intersecta el radio. Usa el bbox del
  // polígono como prueba rápida (precisa para radios ≥10 km).
  _entitiesInRadius(lat, lng, radiusKm){
    const out = [];
    if (!this.geo || !this.geo.estados) return out;
    const seen = new Set();
    const dKm = radiusKm / 111; // aprox grados
    this.geo.estados.features.forEach(f => {
      const bb = this._featureBBox(f.geometry); if (!bb) return;
      // Candidato: bbox expandido por el radio intersecta el círculo
      if (bb.maxLon < lng - dKm || bb.minLon > lng + dKm) return;
      if (bb.maxLat < lat - dKm || bb.minLat > lat + dKm) return;
      // Verificación precisa: el centro del estado cae dentro del radio O
      // el centroide del estado está cerca del círculo
      const cn = this.estCentroid[this._norm(this._propEnt(f.properties)||'')] || this._centroid(f.geometry);
      if (cn) {
        const d = this._haversine(lat, lng, cn[0], cn[1]);
        if (d <= radiusKm + Math.max(bb.maxLon-bb.minLon, bb.maxLat-bb.minLat) * 50) {
          const nom = this._propEnt(f.properties);
          if (nom && !seen.has(nom)) { seen.add(nom); out.push(nom); }
        }
      }
    });
    return out;
  }

  _municipiosInRadius(lat, lng, radiusKm){
    const out = [];
    if (!this._muniGeo) return out;
    const seen = new Set();
    const feats = this._muniGeo.features || [];
    feats.forEach(f => {
      const nom = (f.properties && (f.properties.NOMGEO || f.properties.nombre)) || '';
      const cn = this._centroid(f.geometry);
      if (!cn) return;
      if (this._haversine(lat, lng, cn[0], cn[1]) <= radiusKm) {
        if (nom && !seen.has(nom)) { seen.add(nom); out.push(nom); }
      }
    });
    return out;
  }

  _gerenciasInRadius(lat, lng, radiusKm){
    // GCR se calcula por estado intersectado; devuelve las keys
    const ents = this._entitiesInRadius(lat, lng, radiusKm);
    const gcrs = new Set();
    ents.forEach(ent => {
      const k = this._gerenciaOf(ent);
      if (k) gcrs.add(k);
    });
    return Array.from(gcrs);
  }
  _entitiesInAnalysis(A){
    const features=(this.geo&&this.geo.estados&&this.geo.estados.features)||[];
    const seen=new Set();
    features.forEach(feature=>{
      if(!this._analysisFeatureOverlapsArea(A,feature)) return;
      const name=this._propEnt(feature.properties);
      if(name) seen.add(name);
    });
    return Array.from(seen).sort((a,b)=>a.localeCompare(b,'es'));
  }
  _municipiosInAnalysis(A){
    const geo=this._muniGeo||this._municipiosShortcutGeo;
    const seen=new Set();
    const prepared=this._prepareAnalysisContext(A);
    const representativeMode=!!(A&&A.analysisGeometry&&A.targetKind==='gcr'&&Number(A.bufferKm||0)===0);
    ((geo&&geo.features)||[]).forEach(feature=>{
      if(prepared&&!this._analysisBboxIntersects(feature,prepared.bbox)) return;
      let overlaps=false;
      if(representativeMode&&window.turf){
        try{
          const point=window.turf.pointOnFeature(feature);
          const coordinates=point&&point.geometry&&point.geometry.coordinates;
          overlaps=Array.isArray(coordinates)&&this._analysisContainsPoint(A,coordinates[1],coordinates[0],prepared);
        }catch(e){}
      }else{
        overlaps=this._analysisFeatureOverlapsArea(A,feature);
      }
      if(!overlaps) return;
      const props=feature.properties||{};
      const name=props.NOMGEO||props.nombre||'';
      if(name) seen.add(name);
    });
    return Array.from(seen).sort((a,b)=>a.localeCompare(b,'es'));
  }
  _gerenciasInAnalysis(A){
    const features=(this.geo&&this.geo.gerencias&&this.geo.gerencias.features)||[];
    const keys=new Set();
    features.forEach(feature=>{
      if(this._analysisFeatureOverlapsArea(A,feature)){
        const key=this._gcrKeyFromName(this._gerName(feature.properties));
        if(key) keys.add(key);
      }
    });
    if(!keys.size) this._entitiesInAnalysis(A).forEach(name=>keys.add(this._gerenciaOf(name)));
    return Array.from(keys).filter(Boolean);
  }

  _featureBBox(geom){
    if (!geom) return null;
    let minLon=Infinity, minLat=Infinity, maxLon=-Infinity, maxLat=-Infinity;
    const visit = (c) => {
      if (!Array.isArray(c)) return;
      if (typeof c[0] === 'number' && typeof c[1] === 'number') {
        if (c[0]<minLon) minLon=c[0]; if (c[0]>maxLon) maxLon=c[0];
        if (c[1]<minLat) minLat=c[1]; if (c[1]>maxLat) maxLat=c[1];
        return;
      }
      c.forEach(visit);
    };
    visit(geom.coordinates || geom.geometries || []);
    if (!isFinite(minLon)) return null;
    return { minLon, minLat, maxLon, maxLat };
  }

  // Cache de polos para KPIs: descarga una sola vez y reutiliza.
  // El KPI se recalcula contra el estado de análisis actual cuando se invoca
  // updatePolosKpi() tras cada corrida.
  _fetchPolosCache(){
    if (this._polosCachePromise) return this._polosCachePromise;
    this._polosCachePromise = fetch('/api/podecobi/polos', { credentials:'same-origin' })
      .then(r => r.ok ? r.json() : [])
      .catch(() => []);
    return this._polosCachePromise;
  }
  _updatePolosKpi(){
    const A = this.state.analysis || {};
    if (A.lat==null || A.lng==null) return;
    Promise.all([this._fetchPolosCache(),this._fetchPolosGeoCache()]).then(async ([polos,geo]) => {
      if (!Array.isArray(polos) || !polos.length) { this._polosKpiCache = null; return; }
      const byNumber=new Map();
      ((geo&&geo.features)||[]).forEach(feature=>{
        const number=String((feature.properties||{}).Numero||'').trim();
        if(!number) return;
        if(!byNumber.has(number)) byNumber.set(number,[]);
        byNumber.get(number).push(feature);
      });
      const inR = polos.filter(p => {
        const features=byNumber.get(String(p.numero||'').trim())||[];
        return features.length
          ?features.some(feature=>this._analysisFeatureIntersects(A,feature))
          :(p.centroidLon!=null&&p.centroidLat!=null&&this._analysisContainsPoint(A,p.centroidLat,p.centroidLon));
      });
      if (inR.length === 0) {
        this._polosKpiCache = { label:'PODECOBI en la zona', value:'0', color:'#9B2247', dim:true, sub:'sin intersección territorial' };
      } else if (inR.length === 1) {
        this._polosKpiCache = { label:'PODECOBI intersectado', value:'1', color:'#9B2247', dim:false, sub:inR[0].nombreOficial };
      } else {
        this._polosKpiCache = { label:'PODECOBI en la zona', value:String(inR.length), color:'#9B2247', dim:false, sub:'polos con declaratoria' };
      }
      // Si el reporte está abierto, reconstruirlo para reflejar el KPI actualizado
      if (this.state.reportOpen && this._report) {
        const updated = await this._buildReportAsync();
        if (updated) this._report = updated;
        this.setState({});
      }
    });
  }
  onOpenReport = async () => {
