<div style="display:flex;flex-direction:column;height:100%;width:100%;overflow:hidden;background:#FAF8F5;font-family:'Noto Sans',sans-serif;color:#1c1b1a">

  <header class="dg-header" style="display:flex;align-items:center;justify-content:space-between;gap:12px;padding:8px 16px;background:#fff;border-bottom:1px solid #ECE8E2;box-shadow:0 1px 0 rgba(0,0,0,.02);z-index:30;flex:none;flex-wrap:wrap">
  <!-- Left Side: Title (Without redundant logo) -->
  <div class="dg-brand" style="display:flex;align-items:center;min-width:0;flex:none">
    <div class="dg-brandtext" style="min-width:0;overflow:hidden">
      <div class="dg-title" style="font-family:'Patria',Georgia,serif;font-size:18px;font-weight:700;letter-spacing:-.01em;line-height:1.1;white-space:nowrap;overflow:hidden;text-overflow:ellipsis">Dashboard de Planeación Energética</div>
      <div class="dg-sub" style="font-size:11px;color:#6F6B66;letter-spacing:.01em;margin-top:1px;white-space:nowrap;overflow:hidden;text-overflow:ellipsis">Infraestructura, permisos y proyectos</div>
    </div>
  </div>

  <!-- Center Side: Filters and Tools (Merged from dg-toolbar) -->
  <div class="dg-header-controls" style="display:flex;align-items:center;gap:6px;flex:1 1 auto;justify-content:center">
    <!-- Dropdowns -->
    <select value="{{ filtroEnt }}" onChange="{{ onFiltroEnt }}" style="padding:6px 8px;border:1px solid #ECE8E2;border-radius:8px;font-size:11.5px;font-family:inherit;background:#FAF8F5;color:#1c1b1a;max-width:120px">
      <option value="">Entidad (Todas)</option>
      <sc-for list="{{ entidadesOptions }}" as="ent" hint-placeholder-count="3">
        <option value="{{ ent }}">{{ ent }}</option>
      </sc-for>
    </select>
    
