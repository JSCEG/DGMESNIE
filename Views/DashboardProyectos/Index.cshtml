      doc.setFontSize(8.5); sel.rows.slice(0,8).forEach((r,i)=>{ const colx=mx+(i%2)*278, rowy=sy+Math.floor(i/2)*14; doc.setTextColor(111,107,102); doc.setFont('helvetica','normal'); doc.text(String(r[0])+':', colx, rowy); doc.setTextColor(28,27,26); doc.setFont('helvetica','bold'); doc.text(this._clipText(doc,String(r[1]),150), colx+92, rowy); }); }
    doc.setTextColor(154,149,142); doc.setFontSize(8); doc.text('gob.mx/sener · Fuente: Dirección General de Metodología y Estadísticas del SNIE (DGMESNIE) · CENACE · CFE', M, H-15);
