  }
  _estadoColor(cve){ const n = parseInt(cve,10); return this.ESTADO_PALETTE[(isNaN(n)?0:n) % this.ESTADO_PALETTE.length]; }
  _buildZonas() {
    const L = window.L; this.groups.zonas.clearLayers();
    // Zonas de influencia = radio de 25 km sobre subestaciones ≥230 kV (análisis, no geometría nueva)
    let n=0;
    this.subFeatures.filter(s => s.kv>=230).slice(0,120).forEach(s => {
      const c = L.circle([s.lat, s.lng], { radius:25000, color:'#9AAE3B', weight:1, fillColor:'#9AAE3B', fillOpacity:.08, renderer:this._dataRenderer, pane:'data' });
