  // PDF en dos versiones: carta (reporte) o presentación 16:9 (PowerPoint)
  exportPDF = (mode) => {
    this.closeExport();
    if(!window.jspdf){ this._toast('Preparando módulo PDF…'); return; }
    const { jsPDF }=window.jspdf;
    if(mode==='present') return this._pdfPresent(jsPDF);
    return this._pdfLetter(jsPDF);
  };
  _clipText(doc,t,maxW){ t=String(t); if(doc.getTextWidth(t)<=maxW) return t; while(t.length>1 && doc.getTextWidth(t+'…')>maxW) t=t.slice(0,-1); return t+'…'; }
  _pdfFooter(doc, W, H, landscape, page, total){
    const pad = landscape ? 40 : 46;
    const fy = H - (landscape ? 16 : 18);
    const lineY = fy - (landscape ? 10 : 11);
    doc.setDrawColor(236,232,226); doc.setLineWidth(.9); doc.line(pad, lineY, W-pad, lineY);
    doc.setTextColor(154,149,142); doc.setFont('helvetica','normal'); doc.setFontSize(landscape ? 7.5 : 7.2);
    doc.text('gob.mx/sener · DGMESNIE · CENACE · CFE · Cifras sujetas a verificación en campo', pad, fy);
    doc.setFont('helvetica','bold');
    doc.text('Página '+page+' de '+total, W-pad, fy, { align:'right' });
  }
  _pdfApplyFooters(doc, W, H, landscape, skipPages){
    const total = doc.getNumberOfPages();
    const skip = new Set(skipPages || []);
    for(let p=1; p<=total; p++){
      if (skip.has(p)) continue;
      doc.setPage(p);
      this._pdfFooter(doc, W, H, landscape, p, total);
    }
  }

  // Precarga logos institucionales como dataURL (para portada/contraportada del PDF)
  _preloadLogos = () => {
    this._logo = {};
    const load = (key, src, fmt) => { const im = new Image(); im.onload = () => { try { const c=document.createElement('canvas'); c.width=im.naturalWidth; c.height=im.naturalHeight; c.getContext('2d').drawImage(im,0,0); this._logo[key]={ url:c.toDataURL(fmt||'image/png'), w:im.naturalWidth, h:im.naturalHeight, img:im }; } catch(e){ this._logo[key]={ img:im, w:im.naturalWidth, h:im.naturalHeight }; } }; im.src=src; };
    load('gob','/tablero/assets/logo_gob.png');
    load('sener','/tablero/assets/logo_sener.png');
    load('portada','/tablero/assets/portada_energia.png','image/jpeg'); // imagen de portada aportada por el usuario (eólica + presa + solar)
    load('anexos','/tablero/assets/reno_anexos.png','image/jpeg');
  };
  // Dibuja una imagen con recorte object-fit:cover dentro de [x,y,w,h] (sin deformar ni desbordar)
  _drawImageCover(doc, key, x, y, w, h){
    const l = this._logo && this._logo[key]; if (!l || !l.img) return false;
    try {
      const sc = 2; const cw = Math.round(w*sc), ch = Math.round(h*sc);
      const c = document.createElement('canvas'); c.width=cw; c.height=ch; const ctx=c.getContext('2d');
      const ir = l.img.naturalWidth/l.img.naturalHeight, br = w/h;
      let sw, sh, sx, sy;
      if (ir > br) { sh = l.img.naturalHeight; sw = sh*br; sx = (l.img.naturalWidth-sw)/2; sy = 0; }
      else { sw = l.img.naturalWidth; sh = sw/br; sx = 0; sy = (l.img.naturalHeight-sh)/2; }
      ctx.drawImage(l.img, sx, sy, sw, sh, 0, 0, cw, ch);
      doc.addImage(c.toDataURL('image/jpeg',0.92), 'JPEG', x, y, w, h);
      return true;
    } catch(e){ return false; }
  }
  // Encabezado de logos institucionales (gob · divisoria · sener)
  _pdfLogos(doc, x, y, h){
    const w1 = this._logoImg(doc,'gob', x, y, h, 'left');
    if (w1){ const dvx = x + w1 + 16; doc.setDrawColor(224,220,212); doc.setLineWidth(1); doc.line(dvx, y+3, dvx, y+h-3); this._logoImg(doc,'sener', dvx+16, y, h, 'left'); }
    else this._logoImg(doc,'sener', x, y, h, 'left');
  }
  _logoImg(doc, key, x, y, h, align){ const l=this._logo&&this._logo[key]; if(!l) return 0; const w=h*(l.w/l.h); const px = align==='right' ? x-w : (align==='center' ? x-w/2 : x); doc.addImage(l.url,'PNG',px,y,w,h); return w; }

  // PORTADA institucional (ambos modos). W,H en pt; landscape=true para 16:9
  // Página de título estilo Sistema de Diseño SENER (portada / contraportada)
  // Estructura: logos · kicker · título serif · identificador + filete dorado + subtítulo · imagen a sangre · pie de 3 columnas
  _pdfTitlePage = (doc, W, H, landscape, o) => {
    const pad = landscape ? 52 : 44;
