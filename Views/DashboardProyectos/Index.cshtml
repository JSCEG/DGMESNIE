    const prev = this._prevSelected; this._prevSelected = this.state.selected;
    if (this.state.selected && this.state.selected !== prev && this.state.collapsed.detalle) { this.setState({ collapsed:{ ...this.state.collapsed, detalle:false } }); }
  }
  toggleMobile(name){ this.setState({ mobilePanel: this.state.mobilePanel===name ? null : name }); }

