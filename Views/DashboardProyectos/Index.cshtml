                  <input value="{{ anaLngIn }}" onChange="{{ onAnaLngIn }}" placeholder="Lng · -99.1332" style="flex:1;min-width:0;padding:9px 8px;border:1px solid #ECE8E2;border-radius:8px;font-size:11.5px;font-family:'IBM Plex Mono',monospace;outline:none;background:#fff">
                  <button onClick="{{ onAnaGoCoords }}" title="Ubicar por coordenadas" style="flex:none;padding:9px 12px;border:none;background:#9B2247;color:#fff;border-radius:8px;font-size:11.5px;font-weight:700;cursor:pointer;font-family:inherit" style-hover="background:#8E1F40">Ir</button>
                </div>
