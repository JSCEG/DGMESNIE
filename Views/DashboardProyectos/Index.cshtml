    try{
      this._anaTerritoryBaseLayer=L.geoJSON(baseGeometry,{
        pane:'draw',
        interactive:false,
        style:{color:'#9B2247',weight:2.2,fillColor:'#9B2247',fillOpacity:.10}
      }).addTo(this.map);
