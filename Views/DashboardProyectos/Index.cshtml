        const labelRow=rows.length; rows.push(['Resumen de hallazgos']); merges.push({r:labelRow});
        const n=Math.max(2,...findingRows.map(r=>Array.isArray(r)?r.length:0));
        const head=Array.from({length:n},(_,i)=>i===0?'Concepto':i===1?'Valor':'Dato '+(i+1));
        const hr=rows.length; rows.push(head);
        findingRows.forEach(row=>rows.push(Array.from({length:n},(_,i)=>asNumber((row||[])[i],head[i]))));
        blocks.push({header:hr,last:rows.length-1,cols:n}); maxCols=Math.max(maxCols,n); rows.push([]);
      }
      const chips=Array.isArray(sec.chips)?sec.chips:[];
      if(chips.length || sec.hasChips){
        const labelRow=rows.length; rows.push(['Elementos identificados']); merges.push({r:labelRow});
        const hr=rows.length; rows.push(['No.','Elemento']);
        chips.forEach((chip,i)=>rows.push([i+1,chip==null?'':chip]));
        blocks.push({header:hr,last:rows.length-1,cols:2}); rows.push([]);
      }
      const ws=X.utils.aoa_to_sheet(rows);
      titleBlock(ws,String(sec.title||plan.name),String(sec.kicker||'Análisis territorial')+(sec.key?' · Clave '+sec.key:''),maxCols-1);
      ensure(ws,5,0).s=ST.gold; merge(ws,5,0,5,maxCols-1);
      ensure(ws,6,0).s=ST.note; merge(ws,6,0,6,maxCols-1);
      merges.forEach(m=>{ ensure(ws,m.r,0).s=ST.gold; merge(ws,m.r,0,m.r,maxCols-1); });
      blocks.forEach((b,i)=>paintTable(ws,b.header,b.last,b.cols,i===0));
      ws['!rows']=ws['!rows']||[]; ws['!rows'][6]={hpt:42};
      return finish(ws,widths(rows,Array.from({length:maxCols},(_,i)=>i===0?28:22)),6);
    };
    const sectionSheets=sectionPlans.map(p=>({name:p.name,ws:buildSection(p)}));

    const datasetSheets=datasetPlans.map(plan=>{
      const d=plan.dataset, fields=Array.isArray(d.fields)?d.fields:[], sourceRows=Array.isArray(d.rows)?d.rows:[];
      const data=sourceRows.map(row=>fields.map(field=>asNumber(row&&row[field],field)));
      const rows=[[],[],[],[],[],['Fuente',d.url||'Fuente conectada'],['Registros',sourceRows.length,'Campos',fields.length],fields,...data];
      const ws=X.utils.aoa_to_sheet(rows);
      titleBlock(ws,'Dataset fuente completo',String(d.name||plan.name)+' · sin truncamiento de filas ni campos',Math.max(fields.length-1,3));
      ensure(ws,5,0).s=ST.gold; ensure(ws,5,1).s=ST.note;
      ensure(ws,6,0).s=ST.gold; ensure(ws,6,1).s=numberStyle(ST.cell,ensure(ws,6,1)); ensure(ws,6,2).s=ST.gold; ensure(ws,6,3).s=numberStyle(ST.cell,ensure(ws,6,3));
      paintTable(ws,7,rows.length-1,Math.max(fields.length,1),true);
      const sample=[fields,...data.slice(0,999)];
      return {name:plan.name,ws:finish(ws,widths(sample,fields.map(()=>12)),8)};
    });

    const permitSheets=permitPlans.map(plan=>{
      const source=plan.source||{}, sourceRows=Array.isArray(source.rows)?source.rows:[];
      const preferred=['nombre','numeroPermiso','mercado','entidad','municipio','estatus','tipoPermiso','tecnologia','clasificacion','capacidad','unidadCapacidad','capacidadTexto','distanciaCentroideKm','fechaOtorgamiento','fechaOperacion','fuente'];
      const available=new Set(sourceRows.flatMap(row=>row&&typeof row==='object'?Object.keys(row):[]));
      const fields=[
        ...preferred.filter(field=>available.has(field)),
        ...Array.from(available).filter(field=>!preferred.includes(field)).sort((a,b)=>a.localeCompare(b,'es-MX'))
      ];
      const headers={
        nombre:'Titular',numeroPermiso:'Número de permiso',mercado:'Mercado',entidad:'Entidad',
        municipio:'Municipio',estatus:'Estatus',tipoPermiso:'Tipo de permiso',tecnologia:'Tecnología',
        clasificacion:'Clasificación',capacidad:'Capacidad',unidadCapacidad:'Unidad',
        capacidadTexto:'Capacidad reportada',fechaOtorgamiento:'Fecha de otorgamiento',
        fechaOperacion:'Inicio de operaciones',distanciaCentroideKm:'Distancia al centroide (km)',fuente:'Fuente'
      };
      const tableFields=fields.length?fields:['nombre'];
      const header=tableFields.map(field=>headers[field]||field);
      const data=sourceRows.map(row=>tableFields.map(field=>asNumber(row&&row[field],field)));
      const meta=source.meta||{};
      const cutoff=meta.fechaCorte||meta.FechaCorte||'Sin fecha de corte';
      const detail=(meta.fuente||meta.Fuente||'Inventario institucional')+' · corte '+String(cutoff).slice(0,10);
      const rows=[[],[],[],[],[],['Fuente y corte',detail],['Registros en la cobertura',sourceRows.length,'Campos',tableFields.length],header,...data];
      const ws=X.utils.aoa_to_sheet(rows);
      titleBlock(ws,'Permisos energéticos · fuente territorial completa',String(source.label||plan.name)+' · registros contenidos en la geometría analizada',Math.max(tableFields.length-1,3));
      ensure(ws,5,0).s=ST.gold; ensure(ws,5,1).s=ST.note;
      ensure(ws,6,0).s=ST.gold; ensure(ws,6,1).s=numberStyle(ST.cell,ensure(ws,6,1)); ensure(ws,6,2).s=ST.gold; ensure(ws,6,3).s=numberStyle(ST.cell,ensure(ws,6,3));
      paintTable(ws,7,rows.length-1,Math.max(tableFields.length,1),true);
      const sample=[header,...data.slice(0,999)];
      return {name:plan.name,ws:finish(ws,widths(sample,tableFields.map(()=>14)),8)};
    });

    const networkSheets=networkPlans.map(plan=>{
      const source=plan.source||{};
      const features=Array.isArray(source.features)?source.features:[];
      const edgeFields=[
        ['edge_id','Identificador'],
        ['name','Línea'],
        ['from_name','Subestación origen'],
        ['to_name','Subestación destino'],
        ['voltage_kv','Tensión (kV)'],
        ['network_level_label','Nivel de red'],
        ['circuits','Circuitos'],
        ['length_km','Longitud (km)'],
        ['connection_state','Estado topológico'],
        ['from_confidence','Confianza origen'],
        ['to_confidence','Confianza destino'],
        ['validation_state','Validación'],
        ['source','Fuente']
      ];
      const nodeFields=[
        ['universe_key','Identificador de universo'],
        ['name','Subestación'],
        ['network_level','Nivel de red'],
        ['voltage_kv','Tensión (kV)'],
        ['connection_count','Líneas asociadas'],
        ['connected_line_names','Líneas asociadas · nombres'],
        ['connection_state','Estado topológico'],
        ['connection_validation_state','Validación topológica'],
        ['validation_state','Validación del registro'],
        ['reconciliation_state','Conciliación'],
        ['coordinate_source','Fuente de coordenadas'],
        ['source','Fuente principal'],
        ['sources','Fuentes conciliadas'],
        ['longitude','Longitud'],
        ['latitude','Latitud']
      ];
      const fields=source.kind==='edge'?edgeFields:nodeFields;
      const header=fields.map(field=>field[1]);
      const data=features.map(feature=>{
        const p=(feature&&feature.properties)||{};
        const coordinates=(feature&&feature.geometry&&feature.geometry.type==='Point')
          ?feature.geometry.coordinates||[]
          :[];
        return fields.map(([field])=>{
          let value=field==='longitude'?coordinates[0]:field==='latitude'?coordinates[1]:p[field];
          if(Array.isArray(value)) value=value.join(' · ');
          if(value&&typeof value==='object') value=JSON.stringify(value);
          return asNumber(value,field);
        });
      });
      const meta=source.meta||{};
      const rows=[
        [],[],[],[],[],
        ['Fuente',source.source||meta.source||'DGMESNIE · inventario conciliado y grafo eléctrico'],
        ['Registros en la cobertura',features.length,'Versión',meta.version||'—'],
        header,
        ...data
      ];
      const ws=X.utils.aoa_to_sheet(rows);
      titleBlock(
        ws,
        source.label||'Inventario eléctrico completo',
        'Registros contenidos en la geometría analizada · sin truncamiento',
        Math.max(fields.length-1,3)
      );
      ensure(ws,5,0).s=ST.gold; ensure(ws,5,1).s=ST.note;
      ensure(ws,6,0).s=ST.gold; ensure(ws,6,1).s=numberStyle(ST.cell,ensure(ws,6,1));
      ensure(ws,6,2).s=ST.gold; ensure(ws,6,3).s=ST.note;
      paintTable(ws,7,rows.length-1,fields.length,true);
      const minimums=fields.map(([field])=>{
        if(field==='name'||field==='connected_line_names') return 34;
        if(/source|state|validation|reconciliation/i.test(field)) return 24;
        if(/latitude|longitude|voltage|length|confidence|circuits|count/i.test(field)) return 15;
        return 20;
      });
      return {name:plan.name,ws:finish(ws,widths([header,...data.slice(0,999)],minimums),8)};
    });

    const tariffSheet=tariffPlan?(()=>{
      const source=tariffPlan.source||{};
      const records=Array.isArray(source.registros)?source.registros:[];
      const fields=[
        ['division','División'],['periodo','Periodo'],['esquema','Esquema'],['tarifa','Tarifa'],
        ['sector','Sector'],['nivelTension','Nivel de tensión'],['concepto','Concepto'],
        ['unidades','Unidades'],['segmento','Segmento'],['intervaloHorario','Intervalo horario'],
        ['valor','Valor'],['variacionMensual','Variación mensual'],['tarifaMediaNacional','Tarifa media nacional']
      ];
      const header=fields.map(field=>field[1]);
      const data=records.map(record=>fields.map(field=>asNumber(record&&record[field[0]],field[0])));
      const period=this._tariffPeriodLabel(source.periodo);
      const rows=[
        [],[],[],[],[],
        ['Fuente y periodo',(source.fuente||'CRE / CFE · Histórico DGMESNIE')+' · '+period],
        ['Divisiones intersectadas',Array.isArray(source.divisiones)?source.divisiones.length:0,'Registros',records.length],
        header,
        ...data
      ];
      const ws=X.utils.aoa_to_sheet(rows);
      titleBlock(ws,'Tarifas eléctricas · fuente territorial completa',
        'Último histórico disponible para las divisiones intersectadas; no representa una tarifa vigente.',
        fields.length-1);
      ensure(ws,5,0).s=ST.gold; ensure(ws,5,1).s=ST.note;
      ensure(ws,6,0).s=ST.gold; ensure(ws,6,1).s=numberStyle(ST.cell,ensure(ws,6,1));
      ensure(ws,6,2).s=ST.gold; ensure(ws,6,3).s=numberStyle(ST.cell,ensure(ws,6,3));
      paintTable(ws,7,rows.length-1,fields.length,true);
      return {name:tariffPlan.name,ws:finish(ws,widths([header,...data.slice(0,999)],fields.map(()=>14)),8)};
    })():null;

    const tariffLocalitySheet=tariffLocalityPlan?(()=>{
      const source=tariffLocalityPlan.source||{};
      const localities=Array.isArray(source.localidades)?source.localidades:[];
      const header=['CVEGEO','Localidad','Municipio','Código de municipio','Entidad','Ámbito','División tarifaria','Tarifa de referencia','GDBT','Unidad','Distancia al centroide (km)','Periodo'];
      const data=localities.map(locality=>[
        locality&&locality.cvegeo||'',
        locality&&locality.nombre||'',
        locality&&locality.municipio||'',
        locality&&locality.municipioCodigo||'',
        locality&&locality.entidad||'',
        locality&&locality.ambito||'',
        locality&&locality.division||'',
        locality&&locality.tarifaReferencia||'GDBT',
        locality&&locality.tarifaGdbt==null?'':Number(locality.tarifaGdbt),
        locality&&locality.unidad||'$/kWh',
        locality&&Number.isFinite(locality.distanciaKm)?Number(locality.distanciaKm):'',
        locality&&locality.periodo||source.periodo||''
      ]);
      const rows=[
        [],[],[],[],[],
        ['Nota metodológica','La tarifa corresponde a la división eléctrica aplicable; no es un precio exclusivo de la localidad ni una tarifa vigente.'],
        ['Localidades intersectadas',localities.length,'Divisiones',Array.isArray(source.divisiones)?source.divisiones.length:0],
        header,
        ...data
      ];
      const ws=X.utils.aoa_to_sheet(rows);
      titleBlock(ws,'Localidades y tarifa eléctrica aplicable',
        'Detalle completo de las localidades contenidas en la geometría analizada.',
        header.length-1);
      ensure(ws,5,0).s=ST.gold; ensure(ws,5,1).s=ST.note;
      ensure(ws,6,0).s=ST.gold; ensure(ws,6,1).s=numberStyle(ST.cell,ensure(ws,6,1));
      ensure(ws,6,2).s=ST.gold; ensure(ws,6,3).s=numberStyle(ST.cell,ensure(ws,6,3));
      paintTable(ws,7,rows.length-1,header.length,true);
      return {name:tariffLocalityPlan.name,ws:finish(ws,widths([header,...data.slice(0,999)],[13,28,26,18,24,12,23,18,14,12,22,18]),8)};
    })():null;

    const fuelPriceSheet=fuelPricePlan?(()=>{
      const source=fuelPricePlan.source||{};
      const stations=Array.isArray(source.estaciones)?source.estaciones:[];
      const header=['Estación','Número de permiso','Place ID CNE','Latitud','Longitud','Regular ($/l)','Premium ($/l)','Diésel ($/l)','Distancia al centroide (km)'];
      const data=stations.map(station=>[
        station&&station.nombre||'',
        station&&station.numeroPermiso||'',
        station&&station.placeId!=null?Number(station.placeId):'',
        station&&Number.isFinite(Number(station.latitud))?Number(station.latitud):'',
        station&&Number.isFinite(Number(station.longitud))?Number(station.longitud):'',
        station&&station.regular!=null&&Number.isFinite(Number(station.regular))&&Number(station.regular)>0?Number(station.regular):'',
        station&&station.premium!=null&&Number.isFinite(Number(station.premium))&&Number(station.premium)>0?Number(station.premium):'',
        station&&station.diesel!=null&&Number.isFinite(Number(station.diesel))&&Number(station.diesel)>0?Number(station.diesel):'',
        station&&Number.isFinite(Number(station.distanciaKm))?Number(station.distanciaKm):''
      ]);
      const rows=[
        [],[],[],[],[],
        ['Fuente y consulta',(source.fuente||'CNE · precios reportados por permisionarios')+' · '+String(source.fechaConsulta||R.date||'')],
        ['Estaciones en la cobertura',stations.length,'Modo',source.esRespaldo?'Último dato válido':'Consulta actual'],
        header,
        ...data
      ];
      const ws=X.utils.aoa_to_sheet(rows);
      titleBlock(ws,'Precios de combustibles por estación de servicio',
        'Regular, Premium y Diésel reportados por permisionarios; distancia calculada respecto del centroide del objetivo evaluado.',
        header.length-1);
      ensure(ws,5,0).s=ST.gold; ensure(ws,5,1).s=ST.note;
      ensure(ws,6,0).s=ST.gold; ensure(ws,6,1).s=numberStyle(ST.cell,ensure(ws,6,1));
      ensure(ws,6,2).s=ST.gold; ensure(ws,6,3).s=ST.note;
      paintTable(ws,7,rows.length-1,header.length,true);
      return {name:fuelPricePlan.name,ws:finish(ws,widths([header,...data.slice(0,999)],[34,24,13,13,13,16,16,16,24]),8)};
    })():null;

    const sourceRows=[
      [],[],[],[],[],
      ['Fuente o nota','Detalle','Registros','Campos'],
      ['Sistema institucional','DGMESNIE · Secretaría de Energía · CENACE · CFE','',''],
      ['Fecha de corte',R.date||this._stamp(),'',''],
      ['Cobertura territorial',this._reportMetaValue(R,'Municipio')+', '+this._reportMetaValue(R,'Estado')+' · '+this._reportMetaValue(R,'Cobertura de análisis'),'',''],
      ['Integridad del reporte','Las secciones, tablas, hallazgos y elementos identificados se incorporan completos conforme al modelo compartido del reporte.','',''],
      ['Criterio geográfico','Los registros ubicados por centroide de entidad o gerencia representan una aproximación territorial.','',''],
      ['Validación','Las cifras están sujetas a actualización y verificación en campo.','',''],
      ...(R.inegi?[['INEGI','Banco de Indicadores y DENUE · consulta territorial '+(R.inegi.queriedAt||R.date||this._stamp()),Array.isArray(R.inegi.indicators)?R.inegi.indicators.length:0,'Indicadores']]:[]),
      ...(R.tariffs?[[
        'Tarifas eléctricas',
        (R.tariffs.fuente||'CRE / CFE · Histórico DGMESNIE')+' · '+this._tariffPeriodLabel(R.tariffs.periodo)+' · tarifa por división, no vigente',
        (Array.isArray(R.tariffs.registros)?R.tariffs.registros.length:0)+(Array.isArray(R.tariffs.localidades)?R.tariffs.localidades.length:0),
        'Registros tarifarios y localidades'
      ]]:[]),
      ...(R.fuelPrices?[[
        'Precios por estación CNE',
        (R.fuelPrices.fuente||'CNE · precios reportados por permisionarios')+' · consulta '+String(R.fuelPrices.fechaConsulta||R.date||''),
        Array.isArray(R.fuelPrices.estaciones)?R.fuelPrices.estaciones.length:0,
        'Estaciones con precio'
      ]]:[]),
      ...(R.demandForecast?[[
        'Demanda y pronóstico',
        (R.demandForecast.source||'CENACE')+' · día de operación '+String(R.demandForecast.operatingDate||'—')+
          (R.demandForecast.updatedAt?' · actualización '+new Date(R.demandForecast.updatedAt).toLocaleString('es-MX'):''),
        (Array.isArray(R.demandForecast.regions)?R.demandForecast.regions:[])
          .reduce((total,region)=>total+(Array.isArray(region&&region.hourly)?region.hourly.length:0),0),
        'Series horarias por región'
      ]]:[]),
      ...activeDatasets.map(d=>[d.name||'Dataset activo',d.url||'Fuente conectada',Array.isArray(d.rows)?d.rows.length:0,Array.isArray(d.fields)?d.fields.length:0]),
      ...permitPlans.map(plan=>{
        const source=plan.source||{}, meta=source.meta||{};
        const cutoff=meta.fechaCorte||meta.FechaCorte;
        return [
          'Permisos · '+(source.label||'energía'),
          (meta.fuente||meta.Fuente||'Inventario institucional')+(cutoff?' · corte '+String(cutoff).slice(0,10):''),
          Array.isArray(source.rows)?source.rows.length:0,
          'Registros territoriales'
        ];
      }),
      ...networkPlans.map(plan=>[
        plan.source.label||'Red eléctrica',
        plan.source.source||((plan.source.meta||{}).source)||'DGMESNIE · inventario conciliado y grafo eléctrico',
        Array.isArray(plan.source.features)?plan.source.features.length:0,
        plan.source.kind==='edge'?'Aristas de red':'Subestaciones georreferenciadas'
      ])
    ];
    const sources=X.utils.aoa_to_sheet(sourceRows);
    titleBlock(sources,'Fuentes y notas','Trazabilidad, cobertura y criterios de lectura',3);
    paintTable(sources,5,sourceRows.length-1,4,true);
    finish(sources,[{wch:31},{wch:76},{wch:14},{wch:12}],6);

    X.utils.book_append_sheet(wb,cover,N.cover);
    X.utils.book_append_sheet(wb,index,N.index);
    X.utils.book_append_sheet(wb,zone,N.zone);
    X.utils.book_append_sheet(wb,metricSheet,N.metrics);
    sectionSheets.forEach(p=>X.utils.book_append_sheet(wb,p.ws,p.name));
    datasetSheets.forEach(p=>X.utils.book_append_sheet(wb,p.ws,p.name));
    permitSheets.forEach(p=>X.utils.book_append_sheet(wb,p.ws,p.name));
    networkSheets.forEach(p=>X.utils.book_append_sheet(wb,p.ws,p.name));
    if(tariffSheet) X.utils.book_append_sheet(wb,tariffSheet.ws,tariffSheet.name);
    if(tariffLocalitySheet) X.utils.book_append_sheet(wb,tariffLocalitySheet.ws,tariffLocalitySheet.name);
    if(fuelPriceSheet) X.utils.book_append_sheet(wb,fuelPriceSheet.ws,fuelPriceSheet.name);
    X.utils.book_append_sheet(wb,sources,N.sources);

    X.writeFile(wb,'DGMESNIE_reporte_territorial_'+new Date().toISOString().slice(0,10)+'.xlsx',{cellStyles:true,bookSST:true});
    this._toast('Excel territorial exportado · '+wb.SheetNames.length+' hojas');
  };

  exportXLSX = () => {
    this.closeExport();
    const X=window.XLSX; if(!X){ this._toast('Preparando módulo Excel…'); return; }
    const wb=X.utils.book_new();
    const bd={ style:'thin', color:{rgb:'E6E1DA'} }; const border={ top:bd, bottom:bd, left:bd, right:bd };
    const HEAD={ font:{ bold:true, color:{rgb:'FFFFFF'}, sz:11 }, fill:{ fgColor:{rgb:'9B2247'} }, alignment:{ horizontal:'left', vertical:'center' }, border };
    const TITLE={ font:{ bold:true, color:{rgb:'9B2247'}, sz:15 } };
    const SUB={ font:{ italic:true, color:{rgb:'6F6B66'}, sz:9 } };
    const CELL={ font:{ sz:10 }, alignment:{ vertical:'center' }, border };
    const ALT ={ font:{ sz:10 }, alignment:{ vertical:'center' }, border, fill:{ fgColor:{rgb:'FAF8F5'} } };
    const NUM ={ font:{ sz:10 }, alignment:{ horizontal:'right', vertical:'center' }, border, numFmt:'#,##0' };
    const NUMA={ ...NUM, fill:{ fgColor:{rgb:'FAF8F5'} } };
    // Crea una hoja con encabezado guinda, filas alternadas y bordes
    const sheet=(header, rows, widths, numCols)=>{
      const ws=X.utils.aoa_to_sheet([header, ...rows]); const rg=X.utils.decode_range(ws['!ref']); numCols=numCols||[];
      for(let R=rg.s.r; R<=rg.e.r; R++) for(let C=rg.s.c; C<=rg.e.c; C++){ const ad=X.utils.encode_cell({r:R,c:C}); if(!ws[ad]) ws[ad]={t:'s',v:''}; const alt=R>0 && R%2===0; ws[ad].s = R===0?HEAD : (numCols.includes(C)?(alt?NUMA:NUM):(alt?ALT:CELL)); }
      ws['!cols']=widths.map(w=>({wch:w})); ws['!freeze']={ xSplit:0, ySplit:1 }; ws['!rows']=[{hpt:22}];
      return ws;
    };
    // Resumen + métricas
    const mr=this._metricRows();
    const resWs=X.utils.aoa_to_sheet([['Reporte de planeación energética'],['DGMESNIE · Generado: '+this._stamp()+'   ·   Alcance: '+this.state.scope+'   ·   Mapa base: '+this.state.basemap],[],['Métrica','Valor','Unidad'],...mr]);
    if(resWs['A1']) resWs['A1'].s=TITLE; if(resWs['A2']) resWs['A2'].s=SUB;
    ['A4','B4','C4'].forEach(a=>{ if(resWs[a]) resWs[a].s=HEAD; });
    for(let i=0;i<mr.length;i++){ const R=5+i, alt=i%2===1; ['A','B','C'].forEach((c,ci)=>{ const ad=c+(R); if(resWs[ad]) resWs[ad].s = ci===1?(alt?NUMA:NUM):(alt?ALT:CELL); }); }
    resWs['!cols']=[{wch:34},{wch:16},{wch:10}]; resWs['!merges']=[{s:{r:0,c:0},e:{r:0,c:2}},{s:{r:1,c:0},e:{r:1,c:2}}]; resWs['!rows']=[{hpt:22},{hpt:16}];
    X.utils.book_append_sheet(wb, resWs, 'Resumen');
    // Análisis de zona (si se ejecutó)
    const ar=this._anaRows();
    if(ar.length) X.utils.book_append_sheet(wb, sheet(['Concepto','Valor','Unidad'], ar, [34,18,12], [1]), 'Análisis de zona');
    // Capas
    const capRows=this._activeLayerRows(this.state.analysis,this.state.layers).map(r=>[r.Capa,r.Categoria,r.Activa,r.Conteo]);
    X.utils.book_append_sheet(wb, sheet(['Capa','Categoría','Activa','Conteo'], capRows, [30,22,10,12], [3]), 'Capas');
    // Selección
    const sel=this.state.selected;
