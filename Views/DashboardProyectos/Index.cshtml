      doc.addImage(woman.url,'PNG',landscape?52:18,landscape?64:186,imgW,imgH);
    }

    const center=landscape
      ? {x:414,w:410,dividerY:258,messageY:290,font:14,line:20}
      : {x:350,w:190,dividerY:262,messageY:297,font:11.2,line:16};
    const diamond=landscape?7:6;
    doc.setDrawColor(...gold); doc.setLineWidth(.8);
    doc.line(center.x,center.dividerY,center.x+center.w*.45,center.dividerY);
    doc.line(center.x+center.w*.55,center.dividerY,center.x+center.w,center.dividerY);
    doc.setFillColor(...gold);
    doc.rect(center.x+center.w/2-diamond/2,center.dividerY-diamond/2,diamond,diamond,'F');
    doc.setTextColor(...ink); setFont('body','normal'); doc.setFontSize(center.font);
    const thanks='A todas y todos los que hacen posible, con energía y compromiso, construir un México más justo, soberano y sostenible.';
    const thanksLines=doc.splitTextToSize(thanks,center.w);
    doc.text(thanksLines,center.x+center.w/2,center.messageY,{align:'center',lineHeightFactor:1.35});

    const goldY=landscape?397:600;
    doc.setDrawColor(...gold); doc.setLineWidth(1.25); doc.line(pad,goldY,W-pad,goldY);

    const institutionY=landscape?422:626;
    doc.setTextColor(...burgundy); setFont('bodyBold','bold'); doc.setCharSpace(.8);
    doc.setFontSize(landscape?12:11); doc.text('SECRETARÍA DE ENERGÍA',pad,institutionY); doc.setCharSpace(0);
    doc.setTextColor(...gray); setFont('body','normal'); doc.setFontSize(landscape?10:9.2);
    doc.text('Subsecretaría de Planeación y Transición Energética',pad,institutionY+(landscape?17:16));
    doc.setTextColor(...ink); setFont('body','normal'); doc.setFontSize(landscape?8.5:7.5);
    const unitWidth=landscape?500:292;
    doc.text(doc.splitTextToSize(this.REPORT_UNIT,unitWidth),pad,institutionY+(landscape?32:30),{lineHeightFactor:1.2});

    const socialY=landscape?486:696;
    this._pdfReportSocials(doc,pad,socialY,landscape);
    doc.setDrawColor(...line); doc.setLineWidth(.7); doc.line(pad+(landscape?91:78),socialY-10,pad+(landscape?91:78),socialY+4);
    doc.setTextColor(...burgundy); setFont('bodyBold','bold'); doc.setFontSize(landscape?9.5:8.5);
    doc.text('gob.mx/sener',pad+(landscape?104:90),socialY);

    const barcode={x:pad,y:landscape?500:722,w:landscape?170:150,h:landscape?24:25};
    this._pdfReportBarcode(doc,barcode.x,barcode.y,barcode.w,barcode.h);
    doc.setTextColor(...gray); setFont('mono','normal'); doc.setFontSize(landscape?6.7:6);
    doc.setCharSpace(landscape ? .7 : .55); doc.text(reportCode,barcode.x,barcode.y+barcode.h+(landscape?9:10)); doc.setCharSpace(0);

    const qrSize=landscape?68:70;
    const qrX=W-pad-qrSize, qrY=landscape?443:690;
    this._pdfReportQr(doc,qrX,qrY,qrSize);
    const qrTextX=qrX-(landscape?18:12), qrTextW=landscape?230:135;
    doc.setTextColor(...ink); setFont('title','bold'); doc.setFontSize(landscape?14:11);
    doc.text('Reporte territorial',qrTextX,qrY+(landscape?18:17),{align:'right'});
    doc.setTextColor(...gray); setFont('body','normal'); doc.setFontSize(landscape?8.5:7);
    const context=targetType+' · '+targetLabel;
    doc.text(doc.splitTextToSize(context,qrTextW),qrTextX,qrY+(landscape?33:31),{align:'right',lineHeightFactor:1.2});
    doc.setTextColor(...burgundy); setFont('bodyBold','bold'); doc.setFontSize(landscape?7.5:6.5);
