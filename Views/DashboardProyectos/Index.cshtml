      .dgp{position:fixed !important; left:0 !important; right:0 !important; top:auto !important; bottom:56px !important; width:auto !important; max-width:none !important; max-height:60vh !important; overflow-y:auto; border-radius:18px 18px 0 0 !important; transform:none !important; box-shadow:0 -10px 34px rgba(0,0,0,.22) !important; display:none !important}
