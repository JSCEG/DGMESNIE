    const selected=((this._genericFeats&&this._genericFeats.generacion_distribuida_atlas)||[])
      .find(item=>this._norm(item&&item.props&&item.props.state)===this._norm(state));
    if(!selected||!selected.geometry) return;
    const feature={
      type:'Feature',
      properties:selected.props||{},
      geometry:selected.geometry
    };
    try{
      this._distributedGenerationFocus=window.L.geoJSON(feature,{
        pane:'hl',
        interactive:false,
        style:{
          color:'#9B2247',weight:4,opacity:1,
          fillColor:'#FFFFFF',fillOpacity:.08
        }
      }).addTo(this.map);
      if(fit){
        const bounds=this._distributedGenerationFocus.getBounds();
        if(bounds&&bounds.isValid()) this.map.fitBounds(bounds,{
          ...this._marketViewportPadding(state),
          maxZoom:7,
          animate:true
        });
      }
    }catch(error){}
  }
  _loadDistributedGenerationMarket = (forceRefresh=false,silent=false) => {
    const hasData=!!this.state.distributedGenerationMarketData;
    this.setState({
      marketOpen:true,marketMode:'distributed',
      marketLoading:!hasData&&!silent,marketError:'',
      menuOpen:null,mobilePanel:null,marketLegendOpen:false
    });
    if(this._distributedGenerationMarketPromise){
      return this._distributedGenerationMarketPromise;
    }
    if(!forceRefresh&&hasData){
      return Promise.resolve(this.state.distributedGenerationMarketData);
    }
    this._distributedGenerationMarketPromise=this._distributedGenerationGeo(
      forceRefresh
    ).then(()=>{
      const data=this._distributedGenerationPayload||{};
      const names=Object.keys(data.states||{}).sort((a,b)=>a.localeCompare(b,'es-MX'));
      const preferred=this.state.marketDistributedState==='Nacional'||
        names.includes(this.state.marketDistributedState)
          ?this.state.marketDistributedState
          :'Nacional';
      this.setState({
        distributedGenerationMarketData:data,
        marketDistributedState:preferred,
        marketLoading:false,
        marketError:''
      },()=>this._highlightDistributedGenerationState(preferred,false));
      return data;
    }).catch(error=>{
      this.setState({
        marketLoading:false,
        marketError:hasData?'':(error.message||String(error))
      });
      if(!silent) this._toast('No se pudo cargar la generación distribuida.');
      return null;
    }).finally(()=>{this._distributedGenerationMarketPromise=null;});
    return this._distributedGenerationMarketPromise;
  };
  _openExclusiveMarketLayer(targetKey){
    const layers={...this.state.layers};
    ['demanda_atlas','tarifas_atlas','generacion_distribuida_atlas']
      .filter(key=>key!==targetKey)
      .forEach(otherKey=>{
        if(layers[otherKey]&&layers[otherKey].on){
          const otherGroup=this._layerOf(otherKey);
          try{
            if(otherGroup&&this.map.hasLayer(otherGroup)) this.map.removeLayer(otherGroup);
          }catch(error){}
          layers[otherKey]={...layers[otherKey],on:false};
        }
      });
    this._clearTariffDivisionFocus();
    this._clearDemandRegionFocus();
    this._clearDistributedGenerationFocus();
    this.setState({layers},()=>{
      if(!this.state.layers[targetKey].on) this.toggleLayer(targetKey);
      else if(targetKey==='demanda_atlas') this._loadDemandMarket();
      else if(targetKey==='tarifas_atlas') this._loadTariffMarket();
      else this._loadDistributedGenerationMarket();
    });
  }
  openDemandMarket = () => {
    this._openExclusiveMarketLayer('demanda_atlas');
  };
  openConsumptionMarket = () => {
    this._openExclusiveMarketLayer('tarifas_atlas');
  };
  openDistributedGenerationMarket = () => {
    this._openExclusiveMarketLayer('generacion_distribuida_atlas');
  };
  _syncMarketLayerToggle(key,willOn,layers){
    if(willOn&&key==='demanda_atlas'){
      this._loadDemandMarket();
      return;
    }
    if(willOn&&key==='tarifas_atlas'){
      this._loadTariffMarket();
      return;
    }
    if(willOn&&key==='generacion_distribuida_atlas'){
      this._loadDistributedGenerationMarket();
      return;
    }
    if(!willOn&&key==='demanda_atlas'&&this.state.marketMode==='demand'){
      this._clearDemandRegionFocus();
      if(layers.tarifas_atlas&&layers.tarifas_atlas.on) this._loadTariffMarket();
      else this.setState({marketOpen:false});
    }
    if(!willOn&&key==='tarifas_atlas'&&this.state.marketMode==='consumption'){
      this._clearTariffDivisionFocus();
      if(layers.demanda_atlas&&layers.demanda_atlas.on) this._loadDemandMarket();
      else this.setState({marketOpen:false});
    }
    if(!willOn&&key==='generacion_distribuida_atlas'&&
      this.state.marketMode==='distributed'){
      this._clearDistributedGenerationFocus();
      if(layers.demanda_atlas&&layers.demanda_atlas.on) this._loadDemandMarket();
      else if(layers.tarifas_atlas&&layers.tarifas_atlas.on) this._loadTariffMarket();
      else this.setState({marketOpen:false});
    }
  }
  _marketPlot(series){
    const energyValues=series
      .filter(item=>item.axis!=='temperature')
      .flatMap(item=>item.values)
      .filter(Number.isFinite);
    if(!energyValues.length) return {lines:[],min:0,max:0,tempMin:0,tempMax:0};
    let min=Math.min(...energyValues),max=Math.max(...energyValues);
    const rawSpan=Math.max(1,max-min);
    min=Math.max(0,min-rawSpan*.10);
    max=max+rawSpan*.10;
    const span=Math.max(1,max-min);
    const temperatureValues=series
      .filter(item=>item.axis==='temperature')
      .flatMap(item=>item.values)
      .filter(Number.isFinite);
    let tempMin=0,tempMax=0,tempSpan=1;
    if(temperatureValues.length){
      tempMin=Math.min(...temperatureValues);
      tempMax=Math.max(...temperatureValues);
      const rawTempSpan=Math.max(1,tempMax-tempMin);
      tempMin=tempMin-rawTempSpan*.12;
      tempMax=tempMax+rawTempSpan*.12;
      tempSpan=Math.max(1,tempMax-tempMin);
    }
    const count=Math.max(2,...series.map(item=>item.values.length));
    const x=index=>56+(index/Math.max(1,count-1))*896;
    const y=value=>18+((max-value)/span)*96;
    const yTemperature=value=>18+((tempMax-value)/tempSpan)*96;
    return {
      min,max,tempMin,tempMax,x,y,yTemperature,
      lines:series.map(item=>{
        const scale=item.axis==='temperature'?yTemperature:y;
        const coords=item.values.map((value,index)=>Number.isFinite(value)
          ?{x:x(index),y:scale(value),value}
          :null);
        return {
          key:item.key||'',
          label:item.label||'',
          color:item.color,
          width:item.width||2.4,
          dash:item.dash||'',
          axis:item.axis||'energy',
          coords,
          points:coords.filter(Boolean).map(point=>point.x.toFixed(1)+','+point.y.toFixed(1)).join(' ')
        };
      })
    };
  }
  _marketViewState(S){
    const nf=(value,digits=0)=>Number.isFinite(Number(value))
      ?Number(value).toLocaleString('es-MX',{maximumFractionDigits:digits})
      :'—';
    if(S.marketMode==='distributed'){
      const data=S.distributedGenerationMarketData||{};
      const states=data.states||{};
      const names=Object.keys(states).sort((a,b)=>a.localeCompare(b,'es-MX'));
      const selectedName=S.marketDistributedState==='Nacional'||
        names.includes(S.marketDistributedState)
          ?S.marketDistributedState
          :'Nacional';
      const national=selectedName==='Nacional';
      const stateData=states[selectedName]||{};
      const labels=national
        ?(Array.isArray(data.years)?data.years:[])
        :(Array.isArray(data.periods)?data.periods:[]);
      const values=labels.map(label=>{
        const raw=national
          ?((data.capacityTotalMw||{})[label])
          :((((stateData.series||{})[label]||{}).mw));
        const value=Number(raw);
        return Number.isFinite(value)?value:NaN;
      });
      const contracts=labels.map(label=>{
        const raw=national
          ?((data.contractsTotal||{})[label])
          :((((stateData.series||{})[label]||{}).contracts));
        const value=Number(raw);
        return Number.isFinite(value)?value:NaN;
      });
      const latestIndex=Math.max(0,values.length-1);
      const latestMw=values[latestIndex];
      const latestContracts=contracts[latestIndex];
      const priorMw=values.length>1?values[values.length-2]:NaN;
      const growth=Number.isFinite(latestMw)&&Number.isFinite(priorMw)&&priorMw>0
        ?(latestMw-priorMw)/priorMw*100
        :NaN;
