@using NSIE.Models
@inject IHttpContextAccessor HttpContextAccessor
@inject Microsoft.AspNetCore.Antiforgery.IAntiforgery Antiforgery
@using Microsoft.AspNetCore.Http
@using Newtonsoft.Json

@{
    var httpContext = HttpContextAccessor.HttpContext;
    var perfilUsuarioJson = httpContext.Session.GetString("PerfilUsuario");
    var perfilUsuario = string.IsNullOrEmpty(perfilUsuarioJson) ? null : JsonConvert.DeserializeObject<PerfilUsuario>(perfilUsuarioJson);

    ViewData["Title"] = "Dashboard de Proyectos Energéticos";
    ViewData["NombreUsuario"] = perfilUsuario?.Nombre ?? "Invitado";
    ViewData["RolUsuario"] = perfilUsuario?.Rol ?? "Público";
    ViewData["IDUsuario"] = perfilUsuario?.IdUsuario ?? "0";
    var reportDestinatariosJson = (ViewData["ReportDestinatariosJson"] as string) ?? "[]";
    var antiForgeryToken = Antiforgery.GetAndStoreTokens(Context).RequestToken ?? string.Empty;

    var header = new HeaderViewModel
    {
        Title = "Seguimiento y Análisis de Proyectos Energéticos",
        IconPath = "proyecto.png",
        Description = "Tablero interactivo para el análisis estratégico y monitoreo de proyectos del sector energético nacional.",
        Section = "Monitoreo",
        ModuleInfo = JsonConvert.SerializeObject(new
        {
            title = "Dashboard de Proyectos",
            description = "Herramienta integrada para analizar el avance físico-financiero, geolocalización y estatus regulatorio de proyectos energéticos.",
            functionality = "Explora el tablero integrado interactivo.",
            stage = "Seguimiento",
            roles = new[] {
                new { icon = "eye", text = "Consulta General: Visualización de indicadores y reportes consolidados" }
            },
            order = new { step = 1, description = "Monitoreo de proyectos sectoriales" }
        })
    };
}

@section Styles {
  <link rel="stylesheet" href="~/css/pam-ficha-presentacion.css" asp-append-version="true" />
    <style>
        /* Ocultar el footer de la plataforma */
        footer.footer-snier {
            display: none !important;
        }

        /* Ocultar el preloader por defecto de la plataforma */
        #page-preloader {
            display: none !important;
        }

        /* Estilo para que la sección main-content ocupe exactamente la pantalla completa debajo del header */
        .main-content {
            padding-top: 65px !important;
            padding-left: 0 !important;
            padding-right: 0 !important;
            padding-bottom: 0 !important;
            height: 100vh !important;
            box-sizing: border-box !important;
            display: flex !important;
            flex-direction: column !important;
            overflow: hidden !important;
            margin-left: 0 !important;
            width: 100% !important;
            max-width: 100% !important;
            background: #FAF8F5 !important;
        }

        .dashboard-container-native {
            position: relative;
            width: 100% !important;
            height: 100% !important;
            overflow: hidden;
            display: flex !important;
            flex-direction: column !important;
            flex: 1 1 auto !important;
        }
        
        x-dc {
            display: flex !important;
            flex-direction: column !important;
            width: 100% !important;
            height: 100% !important;
            flex: 1 1 auto !important;
        }

        /* Forzar a que el root de React y sus contenedores ocupen todo el alto disponible sin colapsar */
        #dc-root {
            width: 100% !important;
            height: 100% !important;
            min-height: 0 !important;
            display: flex !important;
            flex-direction: column !important;
            flex: 1 1 auto !important;
        }

        /* El runtime reemplaza x-dc por .sc-host. Tanto el host como el árbol React
           deben participar en el flex; de otro modo Leaflet termina con height: 0. */
        #dc-root > .sc-host,
        #dc-root > .sc-host > :first-child {
            width: 100% !important;
            height: 100% !important;
            min-height: 0 !important;
            display: flex !important;
            flex-direction: column !important;
            flex: 1 1 0% !important;
        }
        
        /* Asegurar que Leaflet se dibuje bien sin cortes y con fuentes institucionales */
        #dg-map-container,
        .leaflet-container {
            width: 100% !important;
            height: 100% !important;
            min-height: 0 !important;
            font-family: 'Noto Sans', sans-serif !important;
        }

        .dg-report {
          --report-guinda: #9B2247;
          --report-guinda-dark: #8E1F40;
          --report-dorado: #E0A12E;
          --report-verde: #0E8A6E;
          --report-tinta: #1c1b1a;
          --report-gris: #6F6B66;
          --report-gris-claro: #9A958E;
          --report-papel: #FAF8F5;
          --report-linea: #ECE8E2;
          font-family: 'Noto Sans PAM', 'Noto Sans', sans-serif !important;
          color: var(--report-tinta);
          background: var(--report-papel);
        }

        .dg-report [style*="Patria"],
        .dg-report__title,
        .dg-report-section__title,
        .dg-report-kpi__value {
          font-family: 'Patria', Georgia, serif !important;
        }

        .dg-report-toolbar {
          position: sticky;
          top: 0;
          z-index: 280;
          min-height: 64px;
          display: grid;
          grid-template-columns: minmax(190px, auto) minmax(180px, 1fr) auto;
          align-items: center;
          gap: 14px;
          padding: 10px 20px;
          border-bottom: 1px solid var(--report-linea);
          background: rgba(255,255,255,.97);
          box-shadow: 0 8px 24px rgba(28,27,26,.08);
          backdrop-filter: blur(12px);
        }

        .dg-report-back,
        .dg-report-action,
        .dg-report-close {
          min-height: 40px;
          display: inline-flex;
          align-items: center;
          justify-content: center;
          gap: 8px;
          border-radius: 7px;
          padding: 0 14px;
          font: 700 12px/1 'Noto Sans PAM', 'Noto Sans', sans-serif;
          cursor: pointer;
          transition: border-color .18s ease, color .18s ease, background .18s ease, transform .18s ease;
        }

        .dg-report-back {
          justify-self: start;
          border: 1px solid var(--report-guinda);
          background: var(--report-guinda);
          color: #fff;
          box-shadow: 0 5px 14px rgba(155,34,71,.2);
        }

        .dg-report-back:hover { background: var(--report-guinda-dark); transform: translateY(-1px); }
        .dg-report-back kbd {
          padding: 2px 6px;
          border: 1px solid rgba(255,255,255,.45);
          border-radius: 4px;
          background: transparent;
          color: inherit;
          font: 600 9px/1 'Noto Sans PAM', sans-serif;
        }

        .dg-report-toolbar__identity { min-width: 0; }
        .dg-report-toolbar__identity strong {
          display: block;
          overflow: hidden;
          color: var(--report-guinda);
          font-size: 10px;
          font-weight: 800;
          letter-spacing: .14em;
          text-overflow: ellipsis;
          text-transform: uppercase;
          white-space: nowrap;
        }
        .dg-report-toolbar__identity span { display:block;margin-top:3px;color:var(--report-gris);font-size:11px; }
        .dg-report-toolbar__actions { display:flex;align-items:center;justify-content:flex-end;gap:7px; }
        .dg-report-action { border:1px solid #D8D1CA;background:#fff;color:#3c4859; }
        .dg-report-action:hover { border-color:var(--report-guinda);color:var(--report-guinda);transform:translateY(-1px); }
        .dg-report-action--primary { border-color:var(--report-guinda);background:var(--report-guinda);color:#fff; }
        .dg-report-action--primary:hover { background:var(--report-guinda-dark);color:#fff; }
        .dg-report-close { border:1px solid #D8D1CA;background:#fff;color:var(--report-guinda); }
        .dg-report-close:hover { border-color:var(--report-guinda);background:#F9EEF2; }

        .dg-report-fab {
          position: fixed;
          right: 18px;
          bottom: 18px;
          z-index: 340;
          min-height: 46px;
          display: inline-flex;
          align-items: center;
          gap: 8px;
          padding: 0 16px;
          border: 1px solid var(--report-guinda);
          border-radius: 999px;
          background: var(--report-guinda);
          color: #fff;
          font: 800 12px/1 'Noto Sans PAM', 'Noto Sans', sans-serif;
          letter-spacing: .02em;
          box-shadow: 0 12px 28px rgba(35, 32, 30, .24);
          cursor: pointer;
          transition: transform .18s ease, background .18s ease;
        }

        .dg-report-fab:hover {
          background: var(--report-guinda-dark);
          transform: translateY(-1px);
        }

        .dg-report-hero { position:relative;overflow:hidden;background:#fff;border-bottom:1px solid var(--report-linea); }
        .dg-report-hero__logos { display:flex;align-items:center;gap:17px;margin-bottom:22px; }
        .dg-report-hero__logos img:first-child { height:34px;width:auto; }
        .dg-report-hero__logos img:last-child { height:28px;width:auto; }
        .dg-report-hero__logos i { width:1px;height:30px;background:#E0DCD4; }
        .dg-report__title { max-width:19ch;font-weight:700 !important;letter-spacing:-.015em !important; }

        .dg-report-content { max-width:1080px !important;padding-top:30px !important; }
        .dg-report-metrics { gap:14px !important; }
        .dg-report-kpi {
          min-height:132px;
          padding:19px 20px 16px !important;
          border:1px solid var(--report-linea) !important;
          border-top:5px solid var(--report-dorado) !important;
          border-radius:0 !important;
          background:#fff;
          box-shadow:none !important;
        }
        .dg-report-kpi__label { color:var(--report-gris) !important;font-size:10px !important;letter-spacing:.10em !important; }
        .dg-report-kpi__value {
          color:var(--report-guinda) !important;
          font-size:34px !important;
          font-weight:700 !important;
          font-family:"IBM Plex Mono",Consolas,"Courier New",monospace !important;
        }

        .dg-report-section {
          padding:28px 30px !important;
          border:1px solid var(--report-linea) !important;
          border-radius:0 !important;
          background:#fff;
          box-shadow:none !important;
        }
        .dg-report-section__head {
          padding-bottom:10px;
          border-bottom:1px solid var(--report-linea);
        }
        .dg-report-section__marker { width:8px !important;height:8px !important;border-radius:50% !important; }
        .dg-report-section__kicker { color:var(--report-guinda) !important;font-size:11px !important;letter-spacing:.14em !important; }
        .dg-report-section__title { margin-top:15px;font-size:29px !important;font-weight:700 !important;line-height:1.08 !important; }
        .dg-report-section__intro { max-width:90ch;font-size:13.5px !important;line-height:1.55 !important; }

        .dg-report-table-wrap { overflow-x:auto;margin:15px 0 18px; }
        .dg-report-table { width:100%;min-width:560px;border-collapse:collapse;color:var(--report-tinta);font-size:12px;font-weight:500; }
        .dg-report-table th,
        .dg-report-table td { padding:10px 12px;text-align:left;vertical-align:middle;border-bottom:1px solid #F0ECE6; }
        .dg-report-table thead th {
          border-bottom:3px solid var(--report-guinda);
          background:#fff;
          color:var(--report-guinda);
          font-size:10px;
          font-weight:800;
          letter-spacing:.07em;
          text-transform:uppercase;
          white-space:nowrap;
        }
        .dg-report-table--gold thead th { border-bottom-color:var(--report-dorado);color:#A06C00; }
        .dg-report-table tbody tr:nth-child(even) { background:rgba(250,248,245,.65); }
        .dg-report-table tbody tr:hover { background:rgba(155,34,71,.05); }
        .dg-report-table td:not(:first-child) {
          font-variant-numeric:tabular-nums;
          font-family:"IBM Plex Mono",Consolas,"Courier New",monospace;
        }

        .dg-report-footnote { border-top:1px solid var(--report-linea);padding-top:14px !important; }

        /* Homologación del modal de envío (pam-envio-*): esta vista no tiene la clase
           .pam-ficha-page, así que los tokens --pam-* de pam-ficha-presentacion.css no
           existen aquí. Se declaran localmente para que el modal luzca consistente con
           el sistema de diseño (antes el botón "Enviar" quedaba transparente por variables
           sin resolver y sólo se veía al pasar el hover, que usa un color fijo). */
        .pam-envio-modal {
          --pam-guinda: #9B2247;
          --pam-guinda-dark: #8E1F40;
          --pam-dorado: #E0A12E;
          --pam-tinta: #1c1b1a;
          --pam-gris: #6F6B66;
          --pam-gris-claro: #9A958E;
          --pam-crema: #FAF8F5;
          --pam-linea: #ECE8E2;
          --pam-linea-suave: #F0ECE6;
          --pam-mono: "IBM Plex Mono", Consolas, "Courier New", monospace;
          font-family: 'Noto Sans PAM', 'Noto Sans', sans-serif;
        }

        @@media (max-width: 900px) {
          .dg-report-toolbar { grid-template-columns:auto 1fr;gap:8px;padding:9px 10px; }
          .dg-report-toolbar__identity { display:none; }
          .dg-report-toolbar__actions { min-width:0;overflow-x:auto;justify-content:flex-start; }
          .dg-report-action { min-width:40px;padding:0 11px; }
          .dg-report-action span { display:none; }
          .dg-report-close span { display:none; }
          .dg-report-back { padding:0 12px;white-space:nowrap; }
          .dg-report-back kbd { display:none; }
          .dg-report-section { padding:22px 18px !important; }
          .dg-report-section__title { font-size:24px !important; }
          .dg-report-fab { right: 12px; bottom: 72px; min-height: 44px; padding: 0 14px; font-size: 11.5px; }
        }
    </style>
}

<div class="dashboard-container-native">
    <x-dc>
        
<helmet>
