                    <input value="{{ anaDirIn }}" onInput="{{ onAnaDirIn }}" onKeyDown="{{ onAnaDirKey }}" placeholder="Calle, colonia, ciudad o lugar…" style="flex:1;min-width:0;padding:9px 10px;border:1px solid #ECE8E2;border-radius:8px;font-size:12px;font-family:inherit;outline:none;background:#fff">
                    <button onClick="{{ onAnaDirSearch }}" style="flex:none;padding:9px 12px;border:none;background:#9B2247;color:#fff;border-radius:8px;font-size:11.5px;font-weight:700;cursor:pointer;font-family:inherit" style-hover="background:#8E1F40">{{ anaDirBtnLabel }}</button>
                  </div>
                  <sc-for list="{{ anaDirResults }}" as="dr" hint-placeholder-count="0">
                    <button onClick="{{ dr.onPick }}" style="display:flex;align-items:flex-start;gap:8px;width:100%;padding:8px 9px;border:1px solid #ECE8E2;background:#fff;border-radius:8px;cursor:pointer;text-align:left;font-family:inherit" style-hover="border-color:#9B2247;background:#FAF8F5">
                      <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="#9B2247" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" style="flex:none;margin-top:2px"><path d="M12 21s-7-5.2-7-11a7 7 0 0 1 14 0c0 5.8-7 11-7 11z"/><circle cx="12" cy="10" r="2.5"/></svg>
                      <span style="font-size:11.5px;font-weight:600;color:#1c1b1a;line-height:1.35">{{ dr.label }}</span>
                    </button>
                  </sc-for>
                </div>
              </sc-if>
            </div>
            <div style="display:flex;flex-direction:column;gap:7px;padding:9px;background:#fff;border:1px solid #ECE8E2;border-radius:9px">
              <div style="display:flex;align-items:center;gap:8px">
                <span style="font-size:9px;font-weight:800;letter-spacing:.11em;text-transform:uppercase;color:#6F6B66">Dataset del análisis</span>
                <span style="flex:1"></span>
                <button onClick="{{ onAnaChooseDataset }}" style="border:none;background:none;color:#9B2247;font-size:10.5px;font-weight:700;cursor:pointer;font-family:inherit;padding:2px">Seleccionar o cargar</button>
              </div>
              <sc-if value="{{ anaNoDatasets }}" hint-placeholder-val="{{ true }}">
                <div style="font-size:11px;color:#9A958E;line-height:1.4">No hay una fuente seleccionada. Puedes cargarla aquí y volverás automáticamente a elegir la ubicación.</div>
              </sc-if>
              <sc-if value="{{ anaHasDatasets }}" hint-placeholder-val="{{ false }}">
                <div style="display:flex;flex-direction:column;gap:5px">
                  <sc-for list="{{ anaDatasets }}" as="ads" hint-placeholder-count="1">
                    <label style="display:flex;align-items:center;gap:8px;padding:6px 7px;border-radius:7px;background:#FAF8F5;cursor:pointer">
                      <input type="checkbox" checked="{{ ads.active }}" onChange="{{ ads.onToggle }}" style="width:14px;height:14px;accent-color:#9B2247;cursor:pointer;flex:none">
                      <span style="width:8px;height:8px;border-radius:50%;background:{{ ads.color }};flex:none"></span>
                      <span style="flex:1;min-width:0;display:flex;flex-direction:column;gap:1px">
                        <span style="font-size:11.5px;font-weight:700;color:#1c1b1a;white-space:nowrap;overflow:hidden;text-overflow:ellipsis">{{ ads.name }}</span>
                        <span style="font-size:9.5px;color:#9A958E">{{ ads.status }}</span>
                      </span>
                    </label>
                  </sc-for>
                </div>
              </sc-if>
            </div>
            <sc-if value="{{ anaHasMarker }}" hint-placeholder-val="{{ false }}">
              <div style="display:flex;align-items:center;gap:8px;padding:7px 9px;background:#fff;border:1px solid #ECE8E2;border-radius:8px">
                <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="#9B2247" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" style="flex:none"><path d="M12 21s-7-5.2-7-11a7 7 0 0 1 14 0c0 5.8-7 11-7 11z"/><circle cx="12" cy="10" r="2.5"/></svg>
                <span style="flex:1;min-width:0;display:flex;flex-direction:column;gap:1px">
                  <span style="font-size:11px;font-weight:700;color:#1c1b1a;line-height:1.2">{{ anaEstado }}</span>
                  <span style="font-size:9.5px;color:#9A958E;font-family:'IBM Plex Mono',monospace">{{ anaCoordLabel }} · arrastra el pin para mover</span>
                </span>
                <button onClick="{{ onAnaPlace }}" title="Reubicar con clic en el mapa" style="border:1px solid #ECE8E2;background:#fff;cursor:pointer;color:#6F6B66;display:flex;padding:4px;border-radius:6px" style-hover="color:#9B2247;border-color:#9B2247"><svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="9"/><path d="M12 3v3M12 18v3M3 12h3M18 12h3"/></svg></button>
              </div>
              <div style="display:flex;flex-direction:column;gap:5px">
                <span style="font-size:9px;font-weight:800;letter-spacing:.11em;text-transform:uppercase;color:#6F6B66">Radio de análisis</span>
                <div style="display:flex;flex-wrap:wrap;gap:5px">
                  <sc-for list="{{ anaRadii }}" as="r" hint-placeholder-count="6">
                    <button onClick="{{ r.onPick }}" style="flex:1;min-width:46px;padding:7px 0;border:1px solid {{ r.border }};background:{{ r.bg }};color:{{ r.fg }};border-radius:7px;font-size:10.5px;font-weight:700;cursor:pointer;font-family:'IBM Plex Mono',monospace">{{ r.label }}</button>
                  </sc-for>
                </div>
              </div>
              <div style="display:flex;flex-direction:column;gap:6px">
                <span style="font-size:9px;font-weight:800;letter-spacing:.11em;text-transform:uppercase;color:#6F6B66">Escenarios rápidos</span>
                <div style="display:flex;flex-wrap:wrap;gap:5px">
                  <sc-for list="{{ anaPresets }}" as="pr" hint-placeholder-count="5">
                    <button onClick="{{ pr.onClick }}" title="{{ pr.hint }}" style="{{ pr.style }}">{{ pr.label }}</button>
                  </sc-for>
                </div>
              </div>
              <div style="display:flex;flex-direction:column;gap:2px;max-height:26vh;overflow-y:auto">
                <div style="display:flex;align-items:center;gap:8px;margin-bottom:3px">
                  <span style="font-size:9px;font-weight:800;letter-spacing:.11em;text-transform:uppercase;color:#6F6B66">Capas seleccionadas</span>
                  <span style="flex:1"></span>
                  <span style="font-size:10px;font-weight:700;font-family:'IBM Plex Mono',monospace;color:#9B2247;background:rgba(155,34,71,.08);padding:1px 8px;border-radius:20px">{{ anaSelCount }}</span>
                </div>
                <sc-for list="{{ anaLayerCats }}" as="ac" hint-placeholder-count="3">
                <div style="display:flex;align-items:center;gap:7px;padding:6px 5px 2px">
                  <span style="font-size:8.5px;font-weight:800;letter-spacing:.1em;text-transform:uppercase;color:#9A958E">{{ ac.name }}</span>
                  <span style="flex:1;height:1px;background:#ECE8E2"></span>
                </div>
                <sc-for list="{{ ac.items }}" as="al" hint-placeholder-count="3">
                  <label style="display:flex;align-items:center;gap:8px;padding:4px 5px;border-radius:7px;cursor:pointer" style-hover="background:#fff">
                    <input type="checkbox" checked="{{ al.sel }}" onChange="{{ al.onToggle }}" style="width:14px;height:14px;accent-color:#9B2247;cursor:pointer;flex:none">
                    <span style="width:20px;height:20px;border-radius:6px;flex:none;display:flex;align-items:center;justify-content:center;font-size:8px;font-weight:800;color:#fff;background:{{ al.color }}">{{ al.code }}</span>
                    <span style="flex:1;font-size:11.5px;font-weight:600;color:#1c1b1a;line-height:1.2;min-width:0;white-space:nowrap;overflow:hidden;text-overflow:ellipsis">{{ al.label }}</span>
                    <sc-if value="{{ al.showCount }}" hint-placeholder-val="{{ false }}"><span style="font-size:10px;font-weight:700;font-family:'IBM Plex Mono',monospace;color:#0E8A6E;background:rgba(14,138,110,.09);padding:1px 6px;border-radius:20px;flex:none">{{ al.countLabel }}</span></sc-if>
                  </label>
                </sc-for>
                </sc-for>
              </div>
              <button onClick="{{ onAnaRun }}" style="width:100%;display:flex;align-items:center;justify-content:center;gap:7px;padding:10px;border:none;border-radius:9px;font-size:12.5px;font-weight:700;cursor:pointer;font-family:inherit;color:#fff;background:{{ anaRunBg }}">
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><circle cx="11" cy="11" r="7"/><path d="m21 21-4.3-4.3"/></svg>{{ anaRunLabel }}</button>
            </sc-if>
      </div>
    </div>
    </sc-if>

    <!-- MENÚ: Datasets externos (anclado a la barra de búsqueda) -->
    <section class="dgp{{ datasetsMob }}" style="{{ datasetsStyle }}">
      <div style="display:flex;align-items:center;justify-content:space-between;padding:12px 14px;border-bottom:1px solid #F0ECE6;background:#fff">
        <div style="display:flex;align-items:center;gap:9px">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="#1E9CB8" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><ellipse cx="12" cy="5" rx="8" ry="3"/><path d="M4 5v14c0 1.7 3.6 3 8 3s8-1.3 8-3V5"/><path d="M4 12c0 1.7 3.6 3 8 3s8-1.3 8-3"/></svg>
          <span style="font-size:13px;font-weight:700;letter-spacing:.01em">Datasets externos</span>
        </div>
        <button onClick="{{ onCloseDatasets }}" title="Cerrar" style="border:none;background:none;cursor:pointer;color:#9A958E;display:flex;padding:2px" style-hover="color:#1c1b1a"><svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round"><path d="M18 6 6 18M6 6l12 12"></path></svg></button>
      </div>
      <sc-if value="{{ datasetsOpen }}" hint-placeholder-val="{{ true }}">
      <div style="padding:11px 12px 12px">
        <button onClick="{{ onOpenConnect }}" style="width:100%;display:flex;align-items:center;justify-content:center;gap:7px;padding:9px;border:1.5px dashed #C9A24B;background:rgba(224,161,46,.08);color:#9B2247;border-radius:9px;font-size:12px;font-weight:700;cursor:pointer;font-family:inherit;margin-bottom:10px" style-hover="background:rgba(224,161,46,.16)">
          <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 5v14"/><path d="M5 12h14"/></svg>Conectar dataset (Sheets · CSV · JSON)</button>
        <sc-if value="{{ hasDatasets }}" hint-placeholder-val="{{ true }}">
        <div style="display:flex;flex-direction:column;gap:7px">
          <sc-for list="{{ datasetsList }}" as="ds" hint-placeholder-count="2">
            <div style="border:1px solid #ECE8E2;border-radius:9px;padding:9px 10px;background:#fff">
              <div style="display:flex;align-items:center;gap:8px;margin-bottom:5px">
                <span style="width:8px;height:8px;border-radius:50%;flex:none;background:{{ ds.color }}"></span>
                <span style="flex:1;font-size:12px;font-weight:700;line-height:1.15;color:#1c1b1a;white-space:nowrap;overflow:hidden;text-overflow:ellipsis">{{ ds.name }}</span>
                <span style="font-size:8.5px;font-weight:800;letter-spacing:.08em;text-transform:uppercase;color:#fff;background:{{ ds.typeColor }};padding:2px 6px;border-radius:5px">{{ ds.type }}</span>
              </div>
              <div style="font-size:10.5px;color:#6F6B66;font-family:'IBM Plex Mono',monospace;margin-bottom:7px">{{ ds.meta }}</div>
              <div style="display:flex;align-items:center;gap:8px">
                <label style="display:flex;align-items:center;gap:6px;cursor:pointer;flex:1">
                  <input type="checkbox" checked="{{ ds.active }}" onChange="{{ ds.onToggle }}" style="width:14px;height:14px;accent-color:#1E9CB8;cursor:pointer">
                  <span style="font-size:11px;color:#3a3a3a">{{ ds.activeLabel }}</span>
                </label>
                <button onClick="{{ ds.onRemove }}" style="border:none;background:none;cursor:pointer;color:#9A958E;display:flex;padding:3px" title="Quitar dataset">
                  <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M18 6 6 18M6 6l12 12"/></svg>
                </button>
              </div>
            </div>
          </sc-for>
        </div>
        </sc-if>
        <sc-if value="{{ noDatasets }}" hint-placeholder-val="{{ true }}">
        <div style="font-size:11px;color:#9A958E;line-height:1.5;padding:4px 2px">Sin datasets vinculados. Conecta una liga pública y relaciona sus campos con una capa por campo llave (id_subestacion, clave_permiso, cve_ent…).</div>
        </sc-if>
      </div>
      </sc-if>
    </section>

    <!-- Tab flotante para reabrir el panel de detalle cuando está oculto -->
    <sc-if value="{{ detalleHidden }}" hint-placeholder-val="{{ false }}">
    <button class="dg-detailtab" onClick="{{ onReopenDetalle }}" title="Mostrar detalle del elemento" style="position:absolute;top:74px;right:0;z-index:23;display:flex;align-items:center;gap:7px;padding:10px 12px 10px 13px;border:1px solid #ECE8E2;border-right:none;background:#fff;color:#9B2247;border-radius:10px 0 0 10px;font-size:12px;font-weight:700;cursor:pointer;font-family:inherit;box-shadow:-6px 4px 18px rgba(0,0,0,.10);animation:dgFade .25s ease both" style-hover="background:#FAF8F5">
      <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="#9B2247" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 21s-7-5.2-7-11a7 7 0 0 1 14 0c0 5.8-7 11-7 11z"/><circle cx="12" cy="10" r="2.5"/></svg>
      <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="#9A958E" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><path d="m15 18-6-6 6-6"/></svg>
    </button>
    </sc-if>

    <!-- PANEL: Detalle del elemento seleccionado — barra lateral fija en desktop, hoja inferior en móvil -->
    <section class="dgp{{ detalleMob }}" style="{{ detalleStyle }}">
      <div style="display:flex;align-items:center;justify-content:space-between;padding:12px 14px;border-bottom:1px solid #F0ECE6;background:#fff;flex:none">
        <div style="display:flex;align-items:center;gap:9px">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="#9B2247" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 21s-7-5.2-7-11a7 7 0 0 1 14 0c0 5.8-7 11-7 11z"/><circle cx="12" cy="10" r="2.5"/></svg>
          <span style="font-size:13px;font-weight:700;letter-spacing:.01em">Detalle del elemento</span>
        </div>
        <button onClick="{{ onCollapseDetalle }}" style="border:none;background:none;cursor:pointer;color:#9A958E;display:flex;padding:2px">{{ detalleChevron }}</button>
      </div>
      <sc-if value="{{ detalleOpen }}" hint-placeholder-val="{{ true }}">
      <div style="padding:0;flex:1;overflow-y:auto;display:flex;flex-direction:column">
        <sc-if value="{{ hasSelection }}" hint-placeholder-val="{{ true }}">
        <div style="animation:dgFade .25s ease both">
          <sc-if value="{{ anaBackVisible }}" hint-placeholder-val="{{ false }}">
          <button onClick="{{ onAnaBack }}" style="display:flex;align-items:center;gap:7px;width:calc(100% - 24px);margin:10px 12px 0;padding:8px 11px;border:1px solid rgba(155,34,71,.35);background:rgba(155,34,71,.05);color:#9B2247;border-radius:9px;font-size:11.5px;font-weight:700;cursor:pointer;font-family:inherit" style-hover="background:rgba(155,34,71,.10)">
            <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><path d="m15 18-6-6 6-6"/></svg>Volver al resumen del análisis</button>
          </sc-if>
          <div style="padding:14px 16px 12px;border-bottom:1px solid #F0ECE6">
            <div style="font-size:9.5px;font-weight:700;letter-spacing:.14em;text-transform:uppercase;color:{{ selColor }};margin-bottom:4px">{{ selKicker }}</div>
            <div style="font-family:'Patria',Georgia,serif;font-size:18px;font-weight:600;line-height:1.15;letter-spacing:-.01em">{{ selName }}</div>
            <sc-if value="{{ reportBtnVisible }}" hint-placeholder-val="{{ false }}">
            <button onClick="{{ onOpenReport }}" style="display:flex;align-items:center;justify-content:center;gap:7px;width:100%;margin-top:11px;padding:10px;border:none;background:#9B2247;color:#fff;border-radius:9px;font-size:12.5px;font-weight:700;cursor:pointer;font-family:inherit" style-hover="background:#8E1F40">
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><path d="M14 2v6h6"/><path d="M8 13h8M8 17h5"/></svg>Ver reporte territorial completo</button>
            </sc-if>
          </div>
          <div style="padding:6px 16px 14px">
            <sc-for list="{{ detalleRows }}" as="row" hint-placeholder-count="8">
              <div style="display:flex;align-items:baseline;justify-content:space-between;gap:14px;padding:7px 0;border-bottom:1px solid #F6F3EF">
                <span style="font-size:11px;color:#9A958E;font-weight:600;letter-spacing:.02em;flex:none">{{ row.label }}</span>
                <span style="font-size:12.5px;color:#1c1b1a;font-weight:600;text-align:right;line-height:1.3">{{ row.value }}</span>
              </div>
            </sc-for>
          </div>
        </div>
        </sc-if>
        <sc-if value="{{ noSelection }}" hint-placeholder-val="{{ true }}">
        <div style="padding:30px 20px;text-align:center;flex:1">
          <div style="width:46px;height:46px;border-radius:50%;background:#FAF8F5;display:flex;align-items:center;justify-content:center;margin:0 auto 12px">
            <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="#C9A24B" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M12 21s-7-5.2-7-11a7 7 0 0 1 14 0c0 5.8-7 11-7 11z"/><circle cx="12" cy="10" r="2.5"/></svg>
          </div>
          <div style="font-size:12.5px;color:#6F6B66;line-height:1.5">Selecciona una subestación, línea, permiso o proyecto en el mapa para ver su ficha.</div>
        </div>
        </sc-if>
        <div style="border-top:1px solid #F0ECE6;padding:11px 16px 14px;background:#FCFBF9;margin-top:auto">
          <div style="display:flex;align-items:center;gap:8px;margin-bottom:9px">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="#0E8A6E" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M3 3v18h18"></path><path d="m7 14 3-4 3 3 4-6"></path></svg>
            <span style="font-size:9.5px;font-weight:800;letter-spacing:.13em;text-transform:uppercase;color:#0E8A6E">Cálculos y métricas</span>
            <span style="font-size:10px;color:#9A958E;font-family:'IBM Plex Mono',monospace">{{ scopeLabel }}</span>
          </div>
          <div style="display:grid;grid-template-columns:1fr 1fr;gap:8px">
            <sc-for list="{{ metricsList }}" as="m" hint-placeholder-count="6">
              <div style="background:#fff;border:1px solid #ECE8E2;border-left:4px solid {{ m.accent }};border-radius:9px;padding:8px 10px">
                <div style="font-size:9.5px;color:#6F6B66;font-weight:600;letter-spacing:.02em;line-height:1.25;margin-bottom:5px;min-height:24px">{{ m.label }}</div>
                <div style="display:flex;align-items:baseline;gap:3px">
                  <span style="font-family:'Patria',Georgia,serif;font-size:21px;font-weight:600;line-height:1;color:#1c1b1a">{{ m.value }}</span>
                  <span style="font-size:10.5px;color:#9A958E;font-weight:600">{{ m.unit }}</span>
                </div>
              </div>
            </sc-for>
          </div>
        </div>
      </div>
      </sc-if>
    </section>

    <!-- MODAL: Conectar dataset -->
    <sc-if value="{{ connectOpen }}" hint-placeholder-val="{{ false }}">
    <div onClick="{{ onCloseConnect }}" style="position:absolute;inset:0;z-index:50;background:rgba(28,27,26,.42);backdrop-filter:blur(3px);display:flex;align-items:center;justify-content:center;padding:30px">
      <div onClick="{{ stopProp }}" style="width:560px;max-width:100%;max-height:100%;overflow:auto;background:#fff;border-radius:16px;box-shadow:0 24px 70px rgba(0,0,0,.32);border-top:4px solid #9B2247;animation:dgFade .25s ease both">
        <div style="display:flex;align-items:flex-start;justify-content:space-between;padding:20px 24px 16px;border-bottom:1px solid #F0ECE6">
          <div>
            <div style="font-size:9.5px;font-weight:700;letter-spacing:.14em;text-transform:uppercase;color:#9B2247;margin-bottom:4px">Fuentes externas · integración</div>
            <div style="font-family:'Patria',Georgia,serif;font-size:21px;font-weight:600;letter-spacing:-.01em">Conectar dataset</div>
          </div>
          <button onClick="{{ onCloseConnect }}" style="border:none;background:#FAF8F5;border-radius:8px;width:32px;height:32px;cursor:pointer;display:flex;align-items:center;justify-content:center;color:#6F6B66">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M18 6 6 18M6 6l12 12"/></svg>
          </button>
        </div>

        <div style="padding:20px 24px">
          <sc-if value="{{ catalogLoading }}" hint-placeholder-val="{{ false }}">
          <div style="min-height:330px;display:flex;flex-direction:column;align-items:center;justify-content:center;text-align:center;padding:28px 20px;animation:dgFade .2s ease both">
            <span style="width:38px;height:38px;border:3px solid #F0ECE6;border-top-color:#9B2247;border-radius:50%;display:inline-block;animation:dgSpin .8s linear infinite;margin-bottom:18px"></span>
            <div style="font-family:'Patria',Georgia,serif;font-size:20px;font-weight:600;color:#1c1b1a;margin-bottom:5px">Preparando dataset</div>
            <div style="font-size:12.5px;font-weight:700;color:#9B2247;margin-bottom:9px">{{ catalogLoadingName }}</div>
            <div style="max-width:330px;font-size:11.5px;line-height:1.55;color:#7B7771">Leyendo la fuente, detectando su ubicación y vinculándola al análisis. Los campos ya configurados no necesitan mostrarse.</div>
            <div style="display:flex;align-items:center;gap:7px;margin-top:18px;color:#9A958E;font-size:10px;font-weight:700;letter-spacing:.04em;text-transform:uppercase">
              <span>Leer</span><span style="color:#D8D3CC">•</span><span>Detectar</span><span style="color:#D8D3CC">•</span><span>Vincular</span>
            </div>
          </div>
          </sc-if>
          <sc-if value="{{ catalogIdle }}" hint-placeholder-val="{{ true }}">
          <!-- Paso 1 -->
          <div style="font-size:11px;font-weight:700;color:#1c1b1a;margin-bottom:9px;display:flex;align-items:center;gap:8px"><span style="width:18px;height:18px;border-radius:50%;background:#9B2247;color:#fff;font-size:10px;display:flex;align-items:center;justify-content:center;font-weight:800">1</span>Pega la liga pública del dataset</div>
          <div style="display:flex;gap:6px;margin-bottom:8px">
            <sc-for list="{{ typeChips }}" as="tc" hint-placeholder-count="3">
              <button onClick="{{ tc.onClick }}" style="{{ tc.style }}">{{ tc.label }}</button>
            </sc-for>
          </div>
          <div style="display:flex;gap:8px;margin-bottom:6px">
            <input value="{{ connectUrl }}" onInput="{{ onConnectUrlInput }}" placeholder="https://docs.google.com/spreadsheets/d/…/edit" style="flex:1;padding:10px 12px;border:1px solid #ECE8E2;border-radius:9px;font-size:12.5px;font-family:'IBM Plex Mono',monospace;background:#FAF8F5">
            <button onClick="{{ onLoadFields }}" style="padding:10px 16px;border:1px solid #9B2247;background:#9B2247;color:#fff;border-radius:9px;font-size:12.5px;font-weight:700;cursor:pointer;font-family:inherit;white-space:nowrap" style-hover="background:#8E1F40">Leer campos</button>
          </div>
          <div style="display:flex;flex-wrap:wrap;gap:6px;margin-bottom:4px">
            <span style="font-size:10.5px;color:#9A958E;align-self:center">Ejemplos:</span>
            <sc-for list="{{ presets }}" as="ps" hint-placeholder-count="3">
              <button onClick="{{ ps.onClick }}" style="padding:5px 10px;border:1px solid #ECE8E2;background:#FAF8F5;color:#6F6B66;border-radius:20px;font-size:11px;cursor:pointer;font-family:inherit" style-hover="border-color:#C9A24B;color:#9B2247">{{ ps.label }}</button>
            </sc-for>
          </div>

          <!-- Catálogo DGMESNIE: fuentes registradas (editable: agregar / quitar, persiste en el navegador) -->
          <div style="margin-top:16px">
            <div style="display:flex;align-items:center;gap:8px;margin-bottom:8px">
              <span style="font-size:11px;font-weight:700;color:#1c1b1a">Catálogo DGMESNIE</span>
              <span style="font-size:10px;font-weight:700;font-family:'IBM Plex Mono',monospace;color:#9B2247;background:rgba(155,34,71,.08);padding:1px 8px;border-radius:20px">{{ catCount }} fuentes</span>
              <span style="flex:1"></span>
              <span style="font-size:10px;color:#9A958E">clic para conectar</span>
            </div>
            <div style="max-height:210px;overflow-y:auto;border:1px solid #F0ECE6;border-radius:10px;background:#FAF8F5">
              <sc-for list="{{ catItems }}" as="ct" hint-placeholder-count="5">
                <div style="display:flex;align-items:center;gap:8px;padding:0 4px 0 0;border-bottom:1px solid #F0ECE6">
                  <button onClick="{{ ct.onConnect }}" style="flex:1;min-width:0;display:flex;flex-direction:column;gap:1px;padding:8px 11px;border:none;background:none;cursor:pointer;text-align:left;font-family:inherit" style-hover="background:#fff">
                    <span style="font-size:12px;font-weight:700;color:#1c1b1a;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;max-width:100%">{{ ct.name }}</span>
                    <span style="font-size:10px;color:#9A958E;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;max-width:100%">{{ ct.desc }}</span>
                  </button>
                  <button onClick="{{ ct.onRemove }}" title="Quitar del catálogo" style="flex:none;border:none;background:none;cursor:pointer;color:#C7C2BA;display:flex;padding:6px" style-hover="color:#9B2247">
                    <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round"><path d="M18 6 6 18M6 6l12 12"/></svg>
                  </button>
                </div>
              </sc-for>
            </div>
            <div style="display:flex;gap:6px;margin-top:8px">
              <input value="{{ catName }}" onInput="{{ onCatName }}" placeholder="Nombre de la fuente" style="flex:1;min-width:0;padding:8px 10px;border:1px solid #ECE8E2;border-radius:8px;font-size:11.5px;font-family:inherit;background:#fff">
              <input value="{{ catUrl }}" onInput="{{ onCatUrl }}" placeholder="URL pública (CSV/TSV publicado)" style="flex:1.4;min-width:0;padding:8px 10px;border:1px solid #ECE8E2;border-radius:8px;font-size:11px;font-family:'IBM Plex Mono',monospace;background:#fff">
              <button onClick="{{ onCatAdd }}" style="flex:none;padding:8px 13px;border:1px solid #9B2247;background:#fff;color:#9B2247;border-radius:8px;font-size:11.5px;font-weight:700;cursor:pointer;font-family:inherit" style-hover="background:rgba(155,34,71,.06)">Agregar</button>
            </div>
          </div>

          <!-- Paso 2: campos + mapeo -->
          <sc-if value="{{ hasFields }}" hint-placeholder-val="{{ false }}">
          <div style="margin-top:20px;animation:dgFade .25s ease both">
            <div style="font-size:11px;font-weight:700;color:#1c1b1a;margin-bottom:9px;display:flex;align-items:center;gap:8px"><span style="width:18px;height:18px;border-radius:50%;background:#9B2247;color:#fff;font-size:10px;display:flex;align-items:center;justify-content:center;font-weight:800">2</span>Campos detectados <span style="font-weight:500;color:#9A958E">· {{ fieldsCount }} columnas · {{ fieldsRows }} filas</span></div>
            <div style="display:flex;flex-wrap:wrap;gap:5px;margin-bottom:16px;padding:11px;background:#FAF8F5;border:1px solid #F0ECE6;border-radius:10px">
              <sc-for list="{{ fieldChips }}" as="fc" hint-placeholder-count="6">
                <span style="font-size:11px;font-weight:600;font-family:'IBM Plex Mono',monospace;color:{{ fc.color }};background:#fff;border:1px solid #ECE8E2;padding:4px 9px;border-radius:6px">{{ fc.name }}</span>
              </sc-for>
            </div>

            <div style="display:flex;align-items:flex-start;gap:9px;padding:10px 12px;border-radius:9px;margin-bottom:14px;background:{{ geoNoteBg }};border:1px solid {{ geoNoteBorder }}">
              <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="{{ geoNoteColor }}" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" style="flex:none;margin-top:1px"><path d="M12 21s-7-5.2-7-11a7 7 0 0 1 14 0c0 5.8-7 11-7 11z"/><circle cx="12" cy="10" r="2.5"/></svg>
              <span style="flex:1;font-size:11.5px;line-height:1.5;color:#3a3a3a"><b style="color:{{ geoNoteColor }}">{{ geoLevelLabel }}</b> · {{ geoNote }}</span>
            </div>
            <div style="font-size:11px;font-weight:700;color:#1c1b1a;margin-bottom:9px;display:flex;align-items:center;gap:8px"><span style="width:18px;height:18px;border-radius:50%;background:#9B2247;color:#fff;font-size:10px;display:flex;align-items:center;justify-content:center;font-weight:800">3</span>Relaciona con una capa por campo llave <span style="font-weight:500;color:#9A958E">· ajusta sólo si la detección automática no acertó</span></div>
            <div style="display:flex;gap:10px;margin-bottom:18px">
              <div style="flex:1">
                <div style="font-size:10px;color:#9A958E;font-weight:600;margin-bottom:5px;letter-spacing:.02em">CAPA GEOGRÁFICA</div>
                <select value="{{ layerTarget }}" onChange="{{ onSelectTarget }}" style="width:100%;padding:9px 10px;border:1px solid #ECE8E2;border-radius:9px;font-size:12.5px;font-family:inherit;background:#FAF8F5">
                  <option value="subestaciones">Subestaciones eléctricas</option>
                  <option value="lineas">Líneas de transmisión</option>
                  <option value="gerencias">Gerencias de control</option>
                  <option value="permisos">Permisos de generación</option>
                  <option value="proyectos">Proyectos de convocatorias</option>
                </select>
              </div>
              <div style="display:flex;align-items:flex-end;padding-bottom:10px;color:#C9A24B">
                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14"/><path d="m13 6 6 6-6 6"/></svg>
              </div>
              <div style="flex:1">
                <div style="font-size:10px;color:#9A958E;font-weight:600;margin-bottom:5px;letter-spacing:.02em">CAMPO LLAVE</div>
                <select value="{{ keyField }}" onChange="{{ onSelectKey }}" style="width:100%;padding:9px 10px;border:1px solid #ECE8E2;border-radius:9px;font-size:12.5px;font-family:inherit;background:#FAF8F5">
                  <option value="">(Sin campo llave · sólo ubicación)</option>
                  <sc-for list="{{ keyOptions }}" as="ko" hint-placeholder-count="4">
                    <option value="{{ ko }}">{{ ko }}</option>
                  </sc-for>
                </select>
              </div>
            </div>
            <button onClick="{{ onConfirmBind }}" style="width:100%;padding:12px;border:none;background:#0E8A6E;color:#fff;border-radius:10px;font-size:13px;font-weight:700;cursor:pointer;font-family:inherit;display:flex;align-items:center;justify-content:center;gap:8px" style-hover="background:#0c7960">
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="#fff" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><path d="M20 6 9 17l-5-5"/></svg>Vincular dataset al mapa</button>
          </div>
          </sc-if>
          </sc-if>
        </div>
      </div>
    </div>
    </sc-if>

    <!-- Barra de carga por capa -->
    <sc-if value="{{ barOn }}" hint-placeholder-val="{{ false }}">
    <div style="position:absolute;left:50%;top:64px;transform:translateX(-50%);z-index:55;min-width:280px;max-width:80%;background:#fff;border:1px solid #ECE8E2;border-radius:11px;box-shadow:0 8px 24px rgba(0,0,0,.14);padding:11px 15px 12px;animation:dgFade .2s ease both">
      <div style="display:flex;align-items:center;gap:9px;margin-bottom:9px">
        <span style="width:14px;height:14px;border:2px solid #F0ECE6;border-top-color:#9B2247;border-radius:50%;display:inline-block;animation:dgSpin .8s linear infinite;flex:none"></span>
        <span style="font-size:12px;font-weight:700;color:#1c1b1a;white-space:nowrap;overflow:hidden;text-overflow:ellipsis">{{ barLabel }}</span>
      </div>
      <div style="position:relative;height:4px;background:#F0ECE6;border-radius:2px;overflow:hidden">
        <span style="position:absolute;top:0;height:100%;border-radius:2px;background:linear-gradient(90deg,#9B2247,#E0A12E);animation:dgBar 1.15s ease-in-out infinite"></span>
      </div>
    </div>
    </sc-if>

    <!-- Toast -->
    <sc-if value="{{ hasToast }}" hint-placeholder-val="{{ false }}">
    <div style="position:absolute;left:50%;bottom:26px;transform:translateX(-50%);z-index:60;background:#1c1b1a;color:#fff;padding:11px 18px;border-radius:10px;font-size:12.5px;font-weight:600;box-shadow:0 10px 30px rgba(0,0,0,.3);display:flex;align-items:center;gap:9px;animation:dgFade .25s ease both">
      <span style="width:8px;height:8px;border-radius:50%;background:#E0A12E"></span>{{ toast }}
    </div>
    </sc-if>

    <!-- MODAL: opciones de exportación PNG -->
    <sc-if value="{{ pngAsk }}" hint-placeholder-val="{{ false }}">
    <div onClick="{{ closePng }}" style="position:absolute;inset:0;z-index:60;background:rgba(28,27,26,.42);backdrop-filter:blur(3px);display:flex;align-items:center;justify-content:center;padding:30px">
      <div onClick="{{ stopProp }}" style="width:412px;max-width:100%;background:#fff;border-radius:16px;box-shadow:0 24px 70px rgba(0,0,0,.32);border-top:4px solid #9B2247;overflow:hidden;animation:dgFade .22s ease both">
        <div style="display:flex;align-items:flex-start;justify-content:space-between;padding:20px 22px 14px;border-bottom:1px solid #F0ECE6">
          <div>
            <div style="font-size:9.5px;font-weight:700;letter-spacing:.14em;text-transform:uppercase;color:#9B2247;margin-bottom:4px">Exportar PNG · alta resolución</div>
            <div style="font-family:'Patria',Georgia,serif;font-size:19px;font-weight:600">¿Qué deseas sobreponer al mapa?</div>
          </div>
          <button onClick="{{ closePng }}" style="border:none;background:#FAF8F5;border-radius:8px;width:30px;height:30px;cursor:pointer;display:flex;align-items:center;justify-content:center;color:#6F6B66;flex:none"><svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M18 6 6 18M6 6l12 12"/></svg></button>
        </div>
        <div style="padding:14px 22px 6px;display:flex;flex-direction:column;gap:4px">
          <sc-for list="{{ pngOptions }}" as="op" hint-placeholder-count="3">
            <label style="display:flex;align-items:center;gap:12px;padding:11px 12px;border:1px solid #ECE8E2;border-radius:10px;cursor:pointer" style-hover="background:#FAF8F5">
              <input type="checkbox" checked="{{ op.on }}" onChange="{{ op.onToggle }}" style="width:17px;height:17px;accent-color:#9B2247;cursor:pointer;flex:none">
              <span style="width:30px;height:30px;border-radius:8px;flex:none;display:flex;align-items:center;justify-content:center;background:{{ op.bg }}">{{ op.icon }}</span>
              <span style="flex:1"><span style="display:block;font-size:13px;font-weight:700;color:#1c1b1a">{{ op.label }}</span><span style="display:block;font-size:11px;color:#9A958E">{{ op.sub }}</span></span>
            </label>
          </sc-for>
        </div>
        <div style="display:flex;gap:10px;padding:14px 22px 20px">
          <button onClick="{{ closePng }}" style="flex:none;padding:11px 16px;border:1px solid #ECE8E2;background:#fff;color:#6F6B66;border-radius:10px;font-size:12.5px;font-weight:600;cursor:pointer;font-family:inherit">Cancelar</button>
          <button onClick="{{ onDoExportPNG }}" style="flex:1;padding:11px;border:none;background:#9B2247;color:#fff;border-radius:10px;font-size:13px;font-weight:700;cursor:pointer;font-family:inherit;display:flex;align-items:center;justify-content:center;gap:8px" style-hover="background:#8E1F40"><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="#fff" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 3v12"/><path d="m7 10 5 5 5-5"/><path d="M5 21h14"/></svg>Descargar PNG</button>
        </div>
      </div>
    </div>
    </sc-if>

    <!-- Loader -->
    <sc-if value="{{ loading }}" hint-placeholder-val="{{ false }}">
    <div style="position:absolute;left:50%;top:50%;transform:translate(-50%,-50%);z-index:40;background:#fff;border:1px solid #ECE8E2;border-radius:12px;padding:18px 26px;box-shadow:0 10px 30px rgba(0,0,0,.14);display:flex;align-items:center;gap:13px">
      <span style="width:20px;height:20px;border:2.5px solid #F0ECE6;border-top-color:#9B2247;border-radius:50%;display:inline-block;animation:dgSpin .8s linear infinite"></span>
      <span style="font-size:12.5px;font-weight:600;color:#3a3a3a">{{ loadingMsg }}</span>
    </div>
    </sc-if>

    <!-- REPORTE TERRITORIAL: vista completa alineada al sistema de fichas PAM -->
    <sc-if value="{{ reportOpen }}" hint-placeholder-val="{{ false }}">
    <div class="dg-report" data-screen-label="Reporte territorial" role="dialog" aria-modal="true" aria-label="Reporte de análisis territorial" style="position:fixed;top:65px;left:0;right:0;bottom:0;z-index:1200;overflow-y:auto">
      <div class="dg-report-toolbar" aria-label="Acciones del reporte territorial">
        <button class="dg-report-back" onClick="{{ onCloseReport }}" title="Cerrar reporte y regresar al mapa">
          <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="m15 18-6-6 6-6"/></svg>
          <span>Regresar al mapa</span><kbd>Esc</kbd>
        </button>
        <div class="dg-report-toolbar__identity">
          <strong>DGMESNIE · Reporte de análisis territorial</strong>
          <span>{{ reportDate }}</span>
        </div>
        <div class="dg-report-toolbar__actions">
          <button class="dg-report-action" onClick="{{ onWmToggle }}" title="Marca de agua: logo SENER + fecha en el mapa exportado">
            <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.1" stroke-linecap="round" stroke-linejoin="round"><path d="M12 21s-6-4.35-6-9.9a6 6 0 0 1 12 0c0 5.55-6 9.9-6 9.9z" transform="rotate(180 12 12)"/></svg><span>Marca de agua</span>
          </button>
          <button class="dg-report-action dg-report-action--primary" onClick="{{ onReportPDF }}" title="Descargar reporte en PDF">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 3v12"/><path d="m7 10 5 5 5-5"/><path d="M4 21h16"/></svg><span>PDF</span>
          </button>
          <button class="dg-report-action" onClick="{{ onReportPdfPpt }}" title="PDF horizontal 16:9 (tipo presentación)">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="2" y="3" width="20" height="14" rx="2"/><path d="M8 21h8M12 17v4"/></svg><span>16:9</span>
          </button>
          <button class="dg-report-action" onClick="{{ onReportXLSX }}" title="Excel con métricas, análisis y datasets">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="3" width="18" height="18" rx="2"/><path d="M3 9h18M3 15h18M9 3v18"/></svg><span>Excel</span>
          </button>
          <button class="dg-report-action" onClick="{{ onReportPNG }}" title="Sólo la imagen del mapa (PNG alta resolución)">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="3" width="18" height="18" rx="2"/><circle cx="9" cy="9" r="2"/><path d="m21 15-4.5-4.5L6 21"/></svg><span>PNG</span>
          </button>
          <button class="dg-report-close" onClick="{{ onCloseReport }}" title="Cerrar reporte y regresar al mapa" aria-label="Cerrar reporte y regresar al mapa">
            <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round"><path d="M18 6 6 18M6 6l12 12"/></svg><span>Cerrar</span>
          </button>
        </div>
      </div>
      <!-- Portada editorial basada en las fichas PAM -->
      <div class="dg-report-hero">
        <img src="/tablero/assets/portada_energia.png" alt="Infraestructura energética" style="position:absolute;inset:0;width:100%;height:100%;object-fit:cover">
        <div style="position:absolute;inset:0;background:linear-gradient(100deg,rgba(255,255,255,.98) 0%,rgba(255,255,255,.94) 50%,rgba(255,255,255,.15) 100%)"></div>
        <div style="position:relative;max-width:1080px;margin:0 auto;padding:34px 22px 38px">
          <div class="dg-report-hero__logos">
            <img src="/img/pamrnt/logo_gob.png" alt="Gobierno de México">
            <i></i>
            <img src="/img/pamrnt/logo_sener.png" alt="Secretaría de Energía">
          </div>
          <div style="font-size:11px;font-weight:800;letter-spacing:.18em;text-transform:uppercase;color:#9B2247;margin-bottom:10px">Evaluación de sitio estratégico</div>
          <div class="dg-report__title" style="font-size:clamp(32px,5vw,48px);line-height:1.03;color:#1c1b1a;text-wrap:balance">Reporte de análisis territorial</div>
          <div style="height:3px;width:92px;background:#E0A12E;margin:18px 0"></div>
          <div style="display:flex;flex-wrap:wrap;gap:8px;max-width:780px">
            <sc-for list="{{ reportMeta }}" as="mt" hint-placeholder-count="6">
              <span style="display:flex;align-items:baseline;gap:7px;padding:7px 12px;background:#fff;border:1px solid #ECE8E2">
                <span style="font-size:9px;font-weight:800;letter-spacing:.08em;text-transform:uppercase;color:#9B2247">{{ mt.label }}</span>
                <span style="font-size:12px;font-weight:700;color:#1c1b1a">{{ mt.value }}</span>
              </span>
            </sc-for>
          </div>
        </div>
      </div>
      <div class="dg-report-content" style="margin:0 auto;padding:24px 16px 70px;display:flex;flex-direction:column;gap:22px">
        <!-- KPIs: patrón de fichas PAM, borde superior dorado y cifra Patria -->
        <div class="dg-report-metrics" style="display:grid;grid-template-columns:repeat(auto-fit,minmax(150px,1fr))">
          <sc-for list="{{ reportMetrics }}" as="rm" hint-placeholder-count="4">
            <div class="dg-report-kpi" style="opacity:{{ rm.op }};display:flex;flex-direction:column;gap:2px">
              <div style="display:flex;align-items:center;gap:7px">
                <span style="width:8px;height:8px;border-radius:50%;flex:none;background:{{ rm.color }}"></span>
                <span class="dg-report-kpi__label" style="font-weight:800;text-transform:uppercase;line-height:1.2">{{ rm.label }}</span>
              </div>
              <div class="dg-report-kpi__value" style="line-height:1.05;letter-spacing:-.015em;margin-top:6px">{{ rm.value }}</div>
              <div style="font-size:10.5px;color:#9A958E;font-weight:600;line-height:1.3">{{ rm.sub }}</div>
            </div>
          </sc-for>
        </div>
        <!-- Secciones de contenido -->
        <sc-for list="{{ reportSections }}" as="sec" hint-placeholder-count="4">
          <section class="dg-report-section" data-screen-label="{{ sec.title }}">
            <div class="dg-report-section__head" style="display:flex;align-items:center;gap:10px">
              <span class="dg-report-section__marker" style="background:{{ sec.color }};display:block;flex:none"></span>
              <span class="dg-report-section__kicker" style="font-weight:800;text-transform:uppercase">{{ sec.kicker }}</span>
            </div>
            <div class="dg-report-section__title" style="letter-spacing:-.01em">{{ sec.title }}</div>
            <div class="dg-report-section__intro" style="color:#6F6B66;margin:9px 0 14px;text-wrap:pretty">{{ sec.intro }}</div>
            <sc-if value="{{ sec.hasTable }}" hint-placeholder-val="{{ false }}">
              <div class="dg-report-table-wrap"><table class="dg-report-table">
                <thead><tr>
                  <sc-for list="{{ sec.table.head }}" as="th" hint-placeholder-count="4"><th>{{ th }}</th></sc-for>
                </tr></thead>
                <tbody>
                  <sc-for list="{{ sec.table.rows }}" as="tr" hint-placeholder-count="5"><tr>
                    <sc-for list="{{ tr }}" as="td" hint-placeholder-count="4"><td>{{ td }}</td></sc-for>
                  </tr></sc-for>
                </tbody>
              </table></div>
            </sc-if>
            <sc-if value="{{ sec.hasTable2 }}" hint-placeholder-val="{{ false }}">
              <div class="dg-report-table-wrap"><table class="dg-report-table dg-report-table--gold">
                <thead><tr>
                  <sc-for list="{{ sec.table2.head }}" as="th2" hint-placeholder-count="4"><th>{{ th2 }}</th></sc-for>
                </tr></thead>
                <tbody>
                  <sc-for list="{{ sec.table2.rows }}" as="tr2" hint-placeholder-count="5"><tr>
                    <sc-for list="{{ tr2 }}" as="td2" hint-placeholder-count="4"><td>{{ td2 }}</td></sc-for>
                  </tr></sc-for>
                </tbody>
              </table></div>
            </sc-if>
            <sc-if value="{{ sec.hasRows }}" hint-placeholder-val="{{ false }}">
              <div style="display:flex;flex-direction:column">
                <sc-for list="{{ sec.rowItems }}" as="rw" hint-placeholder-count="4">
                  <div style="display:flex;align-items:baseline;justify-content:space-between;gap:14px;padding:8px 0;border-bottom:1px solid #F6F3EF">
                    <span style="font-size:12px;color:#6F6B66;font-weight:600">{{ rw.label }}</span>
                    <span style="font-size:12.5px;color:{{ rw.color }};font-weight:700;text-align:right">{{ rw.value }}</span>
                  </div>
                </sc-for>
              </div>
            </sc-if>
            <sc-if value="{{ sec.hasChips }}" hint-placeholder-val="{{ false }}">
              <div style="display:flex;flex-wrap:wrap;gap:6px;margin-top:12px">
                <sc-for list="{{ sec.chips }}" as="ch" hint-placeholder-count="5">
                  <span style="padding:4px 11px;background:#FAF8F5;border:1px solid #ECE8E2;border-radius:20px;font-size:11px;font-weight:600;color:#3a3a3a">{{ ch }}</span>
                </sc-for>
              </div>
            </sc-if>
          </section>
        </sc-for>
        <div style="text-align:center;font-size:11px;color:#9A958E;padding-top:6px">Dirección General de Metodología y Estadísticas del SNIE (DGMESNIE) · SENER · CENACE · CFE · Cifras sujetas a verificación en campo</div>
      </div>
      <button class="dg-report-fab" onClick="{{ onCloseReport }}" title="Volver al mapa" aria-label="Volver al mapa">
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><path d="m15 18-6-6 6-6"/></svg>
        <span>Volver al mapa</span>
      </button>

    </div>
    </sc-if>

    <sc-if value="{{ reportSendOpen }}" hint-placeholder-val="{{ false }}">
    <div class="pam-envio-modal" style="position:fixed;inset:0;z-index:1300">
      <div class="pam-envio-backdrop" onClick="{{ onCloseReportSend }}"></div>
      <div class="pam-envio-dialog" role="dialog" aria-modal="true" aria-labelledby="pam-envio-titulo-dg">
        <div class="pam-envio-head">
          <div>
            <h3 id="pam-envio-titulo-dg">Enviar reporte por correo</h3>
            <p>Reporte territorial DGMESNIE · se genera y se adjunta al correo.</p>
          </div>
          <button type="button" class="pam-envio-x" onClick="{{ onCloseReportSend }}" aria-label="Cerrar"><i class="fas fa-xmark"></i></button>
        </div>
        <div style="padding:14px 16px 0">
          <label class="pam-envio-label">Formato del archivo</label>
          <div class="pam-envio-formato">
            <label><input type="radio" checked="{{ reportSendFmtPdf }}" onChange="{{ onSendFmtPdf }}" /><span><i class="fas fa-file-pdf"></i> PDF carta</span></label>
            <label><input type="radio" checked="{{ reportSendFmtPpt }}" onChange="{{ onSendFmtPpt }}" /><span><i class="fas fa-file-pdf"></i> PDF 16:9</span></label>
          </div>

          <label class="pam-envio-label" for="dg-envio-buscar">Destinatarios <span>(uno o más)</span></label>
          <input type="search" id="dg-envio-buscar" class="pam-envio-buscar" value="{{ reportSendQuery }}" onInput="{{ onSendQueryInput }}" placeholder="Buscar por nombre o correo…" autocomplete="off" />
          <div class="pam-envio-lista" id="dg-envio-lista" role="listbox" aria-multiselectable="true">
            <sc-if value="{{ reportSendNoRecipients }}" hint-placeholder-val="{{ false }}">
              <div class="pam-envio-vacio">No hay usuarios con correo registrado.</div>
            </sc-if>
            <sc-if value="{{ reportSendHasRecipients }}" hint-placeholder-val="{{ false }}">
              <sc-for list="{{ reportSendRecipients }}" as="u" hint-placeholder-count="6">
                <label class="pam-envio-item">
                  <input type="checkbox" checked="{{ u.on }}" onChange="{{ u.onToggle }}" />
                  <span class="pam-envio-item__ini">{{ u.ini }}</span>
                  <span class="pam-envio-item__info">
                    <strong>{{ u.nombre }}</strong>
                    <small>{{ u.detalle }}</small>
                  </span>
                </label>
              </sc-for>
            </sc-if>
          </div>

          <label class="pam-envio-label" for="dg-envio-msg">Mensaje adicional <span>(opcional)</span></label>
          <textarea id="dg-envio-msg" rows="2" class="pam-envio-mensaje" value="{{ reportSendMsg }}" onInput="{{ onSendMsgInput }}" placeholder="Ej. Se comparte para la reunión de seguimiento."></textarea>

          <sc-if value="{{ reportSendFeedbackOn }}" hint-placeholder-val="{{ false }}">
            <div class="pam-envio-feedback {{ reportSendFeedbackClass }}">{{ reportSendFeedback }}</div>
          </sc-if>

          <div class="pam-envio-actions">
            <button type="button" class="pam-envio-btn pam-envio-btn--cancel" onClick="{{ onCloseReportSend }}">Cancelar</button>
            <button type="button" class="pam-envio-btn pam-envio-btn--send" onClick="{{ onSubmitReportSend }}" disabled="{{ reportSendBusy }}">
              <i class="fas fa-paper-plane" aria-hidden="true"></i> {{ reportSendBtnLabel }}
            </button>
          </div>
        </div>
      </div>
    </div>
    </sc-if>

    <!-- Barra de pestañas (solo móvil) -->
    <div class="dg-tabbar" style="position:fixed;left:0;right:0;bottom:0;z-index:80;height:56px;background:#fff;border-top:1px solid #ECE8E2;box-shadow:0 -4px 16px rgba(0,0,0,.10)">
      <sc-for list="{{ mobileTabs }}" as="tb" hint-placeholder-count="4">
        <button onClick="{{ tb.onClick }}" style="{{ tb.style }}">
          <span style="display:flex">{{ tb.icon }}</span>
          <span style="font-size:9.5px;font-weight:700;letter-spacing:.01em">{{ tb.label }}</span>
          <sc-if value="{{ tb.badge }}" hint-placeholder-val="{{ false }}"><span style="position:absolute;top:6px;right:50%;margin-right:-20px;min-width:15px;height:15px;padding:0 4px;border-radius:8px;background:#9B2247;color:#fff;font-size:8.5px;font-weight:800;display:flex;align-items:center;justify-content:center">{{ tb.badge }}</span></sc-if>
        </button>
      </sc-for>
    </div>

  </div>
</div>

    </x-dc>
    
