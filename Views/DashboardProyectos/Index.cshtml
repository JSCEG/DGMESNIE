      const reference=series.find(point=>String(point&&point.year)===referenceYear)||
        series.filter(point=>point&&point.isComplete!==false).slice(-1)[0]||{};
      return {
        division:name,
        year:String(reference.year||referenceYear||'—'),
        users:number(reference.users),
        energyGwh:number(reference.energyGwh),
        intensity:number(reference.intensityKwhPerUser),
        series
      };
    });
