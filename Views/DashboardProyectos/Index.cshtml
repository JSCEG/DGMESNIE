          (this._subMarkers || []).forEach(m => { const s = m._rec; if (s && this._haversine(A.lat, A.lng, s.lat, s.lng) <= A.radiusKm) { g.addLayer(m); set.add(s); } });
          this._anaSubSet = set; n = set.size;
          if (!n) nearKm = (this._nearestSubs(A.lat, A.lng, 1)[0]||{}).dist || null;
        } else if (key === 'lineas') {
