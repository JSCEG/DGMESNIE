  _loadDemandMarket = (forceRefresh=false,silent=false) => {
    const hasData=!!this.state.demandMarketData;
    this.setState(
      {
        marketOpen:true,marketMode:'demand',
        marketLoading:!hasData&&!silent,marketError:'',
        menuOpen:null,mobilePanel:null,marketLegendOpen:false
      },
      ()=>this._scheduleDemandViewportFit(this.state.marketRegion)
    );
    if(this._demandMarketPromise) return this._demandMarketPromise;
    if(!forceRefresh&&hasData) return Promise.resolve(this.state.demandMarketData);
    const demandUrl='/DashboardProyectos/AtlasSen/Demanda?hourly=true'+
      (forceRefresh?'&ts='+Date.now():'');
    this._demandMarketPromise=fetch(demandUrl,{
      cache:'no-store',
      headers:{'Accept':'application/json','Cache-Control':'no-cache'}
    })
      .then(response=>{
        if(!response.ok) throw new Error('HTTP '+response.status);
        return response.json();
      })
      .then(data=>{
        const regions=data&&data.regions?Object.keys(data.regions):[];
        const national=regions.find(name=>this._norm(name).includes('sistemainterconectadonacional')||this._norm(name)==='sin');
        const preferred=regions.includes(this.state.marketRegion)
          ?this.state.marketRegion
          :(national||(regions[0]||''));
        this.setState({
          demandMarketData:data,
          marketRegion:preferred,
          marketLoading:false,
          marketError:''
        },()=>{
          this._highlightDemandRegion(preferred,false);
          this._loadDemandWeather(preferred);
          this._scheduleDemandViewportFit(preferred);
        });
        return data;
      })
      .catch(error=>{
        this.setState({
          marketLoading:false,
          marketError:hasData?'':(error.message||String(error))
        });
        if(!silent) this._toast('No se pudo cargar la serie horaria de demanda.');
        return null;
      })
      .finally(()=>{this._demandMarketPromise=null;});
    return this._demandMarketPromise;
  };
  _loadTariffMarket = (forceRefresh=false,silent=false) => {
    const hasData=!!this.state.tariffMarketData;
    this.setState({
      marketOpen:true,marketMode:'consumption',
      marketLoading:!hasData&&!silent,marketError:'',
      menuOpen:null,mobilePanel:null,marketLegendOpen:false
    });
    if(this._tariffMarketPromise) return this._tariffMarketPromise;
    if(!forceRefresh&&hasData) return Promise.resolve(this.state.tariffMarketData);
    const tariffUrl='/DashboardProyectos/AtlasSen/Divisiones/Series'+
      (forceRefresh?'?ts='+Date.now():'');
    this._tariffMarketPromise=fetch(tariffUrl,{
      cache:'no-store',
      headers:{'Accept':'application/json','Cache-Control':'no-cache'}
    })
      .then(response=>{
        if(!response.ok) throw new Error('HTTP '+response.status);
        return response.json();
      })
      .then(data=>{
        const divisions=data&&data.divisions?Object.keys(data.divisions).sort((a,b)=>a.localeCompare(b,'es')):[];
        const preferred=divisions.includes(this.state.marketDivision)
          ?this.state.marketDivision
          :(divisions[0]||'');
        this.setState({
          tariffMarketData:data,
          marketDivision:preferred,
          marketLoading:false,
          marketError:''
        },()=>{
          this._restyleTariffLayer();
          this._highlightTariffDivision(preferred,false);
          this._scheduleTariffViewportFit(preferred);
        });
        return data;
      })
      .catch(error=>{
        this.setState({
          marketLoading:false,
          marketError:hasData?'':(error.message||String(error))
        });
        if(!silent) this._toast('No se pudo cargar la serie histórica de usuarios y consumo.');
        return null;
      })
      .finally(()=>{this._tariffMarketPromise=null;});
    return this._tariffMarketPromise;
