      const title=doc.splitTextToSize(String(sub.title||'Detalle'),width); doc.text(title,x,y); y+=title.length*(cfg.landscape?16:14)+4;
      this._setReportFont(doc,'body','normal'); doc.setFontSize(cfg.landscape?8.6:8);
      const intro=doc.splitTextToSize(String(sub.intro||''),width);
      intro.forEach(line=>{
        if(y+lh>cfg.maxY) nextPage();
        doc.setTextColor(111,107,102); this._setReportFont(doc,'body','normal');
        doc.setFontSize(cfg.landscape?8.6:8); doc.text(line,x,y); y+=lh;
      });
      if(intro.length) y+=6;
      const rows=Array.isArray(sub.rows)?sub.rows:[];
      rows.forEach((row,ri)=>{
        this._setReportFont(doc,'body','normal'); doc.setFontSize(cfg.landscape?8.5:7.9);
        const labels=doc.splitTextToSize(String((row||[])[0]||''),labelW-10);
        this._setReportFont(doc,'mono','normal');
        const values=doc.splitTextToSize(String((row||[])[1]==null?'—':row[1]),valueW-10);
        const count=Math.max(labels.length,values.length,1),rh=count*lh+8;
        if(y+rh>cfg.maxY) nextPage();
        if(ri%2===1){ doc.setFillColor(252,250,249); doc.rect(x,y,width,rh,'F'); }
        doc.setTextColor(111,107,102); this._setReportFont(doc,'body','normal');
        doc.setFontSize(cfg.landscape?8.5:7.9); doc.text(labels,x+5,y+10);
        doc.setTextColor(28,27,26); this._setReportFont(doc,'mono','normal');
        doc.setFontSize(cfg.landscape?8.5:7.9); doc.text(values,valueX,y+10);
        doc.setDrawColor(240,236,230); doc.setLineWidth(.55); doc.line(x,y+rh,x+width,y+rh);
        y+=rh;
      });
      if(sub.hasTable&&sub.table&&Array.isArray(sub.table.head)&&sub.table.head.length){
        ensure(44);
        y+=8;
        y=this._pdfReportTable(doc,sub.table,{
          x,y,width,maxY:cfg.maxY,landscape:cfg.landscape,gold:false,
          newPage:()=>nextPage(),
        });
      }
      y+=12;
    });
    return y;
  }
  _pdfReportCharts(doc,charts,cfg){
    const data=(Array.isArray(charts)?charts:[]).filter(chart=>chart&&Array.isArray(chart.data)&&chart.data.length).slice(0,2);
    if(!data.length) return cfg.y;
    const rgb=hex=>{
      const match=/^#?([\da-f]{2})([\da-f]{2})([\da-f]{2})$/i.exec(String(hex||''));
      return match?[parseInt(match[1],16),parseInt(match[2],16),parseInt(match[3],16)]:[155,34,71];
    };
    const gap=cfg.landscape?18:16;
    const landscapeColumns=cfg.landscape&&data.length>1?2:1;
    const cardW=cfg.landscape&&landscapeColumns===2?(cfg.width-gap)/2:cfg.width;
    const requestedCardHeight=Number(cfg.maxCardHeight);
    const maxCardHeight=Number.isFinite(requestedCardHeight)
      ?Math.max(150,requestedCardHeight)
      :248;
    const cardH=cfg.landscape?cfg.maxY-cfg.y:Math.min(maxCardHeight,(cfg.maxY-cfg.y-gap)/Math.max(1,data.length));
    const drawCard=(chart,index)=>{
      const x=cfg.landscape&&landscapeColumns===2?cfg.x+index*(cardW+gap):cfg.x;
      const top=cfg.landscape?cfg.y:cfg.y+index*(cardH+gap);
      doc.setFillColor(255,255,255); doc.setDrawColor(224,220,212); doc.setLineWidth(.8);
      doc.roundedRect(x,top,cardW,cardH,5,5,'FD');
      doc.setFillColor(224,161,46); doc.rect(x,top,cardW,4,'F');
      const chartGroup=chart.group==='inegi'
        ?'CONTEXTO TERRITORIAL · INEGI'
        :(chart.group==='tariffs'||chart.group==='fuel-prices'
          ?'PRECIOS ENERGÉTICOS'
          :(chart.group==='demand'
            ?'OPERACIÓN DEL SISTEMA'
            :(chart.group==='consumption'
              ?'OPERACIÓN Y MERCADO'
              :(chart.group==='energy-permits'?'PERMISOS ENERGÉTICOS':'INFRAESTRUCTURA ELÉCTRICA'))));
      doc.setTextColor(155,34,71); this._setReportFont(doc,'kicker','bold'); doc.setFontSize(cfg.landscape?8:7.5);
      doc.setCharSpace(.55); doc.text(chartGroup,x+15,top+20); doc.setCharSpace(0);
      doc.setTextColor(28,27,26); this._setReportFont(doc,'title','bold'); doc.setFontSize(cfg.landscape?16:14);
      const titleLines=doc.splitTextToSize(String(chart.title||'Perfil eléctrico'),cardW-30);
      doc.text(titleLines,x+15,top+41);
      let cy=top+41+titleLines.length*(cfg.landscape?17:15);
      doc.setTextColor(111,107,102); this._setReportFont(doc,'body','normal'); doc.setFontSize(cfg.landscape?8.5:7.8);
      const subtitleLines=doc.splitTextToSize(String(chart.subtitle||''),cardW-30);
      doc.text(subtitleLines,x+15,cy); cy+=subtitleLines.length*(cfg.landscape?10:9)+11;

      if(chart.type==='timeseries'){
        const chartSeries=(Array.isArray(chart.series)?chart.series:[])
          .map(series=>({...series,values:(Array.isArray(series.values)?series.values:[])
            .map(value=>value==null||value===''?null:Number(value))}));
        const values=chartSeries.flatMap(series=>series.values).filter(Number.isFinite);
        const pointCount=Math.max(2,...chartSeries.map(series=>series.values.length));
        if(values.length){
          let minValue=Math.min(...values),maxValue=Math.max(...values);
          const rawSpan=Math.max(1,maxValue-minValue);
          minValue=Math.max(0,minValue-rawSpan*.10);
          maxValue=maxValue+rawSpan*.10;
          const span=Math.max(1,maxValue-minValue);
          const legendY=cy+2;
          let legendX=x+15;
          chartSeries.forEach(series=>{
            const color=rgb(series.color);
            doc.setDrawColor(color[0],color[1],color[2]); doc.setLineWidth(series.key==='demand'?2.1:1.5);
            doc.setLineDashPattern(series.dash?[4,3]:[],0);
            doc.line(legendX,legendY,legendX+18,legendY);
            doc.setLineDashPattern([],0);
            doc.setTextColor(58,58,58); this._setReportFont(doc,'bodyBold','bold'); doc.setFontSize(cfg.landscape?7.8:7.1);
            doc.text(String(series.label||'Serie'),legendX+24,legendY+2.5);
            legendX+=24+Math.max(54,doc.getTextWidth(String(series.label||'Serie'))+16);
          });
          const plotLeft=x+(cfg.landscape?48:45);
          const plotRight=x+cardW-18;
          const plotTop=legendY+15;
          const plotBottom=top+cardH-33;
          const plotW=Math.max(80,plotRight-plotLeft);
          const plotH=Math.max(65,plotBottom-plotTop);
          const px=index=>plotLeft+(index/Math.max(1,pointCount-1))*plotW;
          const py=value=>plotTop+((maxValue-value)/span)*plotH;
          [maxValue,(maxValue+minValue)/2,minValue].forEach((value,gridIndex)=>{
            const gy=plotTop+(gridIndex/2)*plotH;
            doc.setDrawColor(gridIndex===2?216:236,gridIndex===2?211:232,gridIndex===2?204:226); doc.setLineWidth(.55);
            doc.line(plotLeft,gy,plotRight,gy);
            doc.setTextColor(111,107,102); this._setReportFont(doc,'mono','normal'); doc.setFontSize(cfg.landscape?7.2:6.6);
            doc.text((value/1000).toLocaleString('es-MX',{maximumFractionDigits:1}),plotLeft-7,gy+2.5,{align:'right'});
          });
          chartSeries.forEach(series=>{
            const color=rgb(series.color);
            doc.setDrawColor(color[0],color[1],color[2]); doc.setLineWidth(series.key==='demand'?2.1:1.45);
            doc.setLineDashPattern(series.dash?[4,3]:[],0);
            let previous=null;
            series.values.forEach((value,index)=>{
              if(!Number.isFinite(value)){ previous=null; return; }
              const current={x:px(index),y:py(value)};
              if(previous) doc.line(previous.x,previous.y,current.x,current.y);
              previous=current;
            });
            doc.setLineDashPattern([],0);
          });
          const labels=Array.isArray(chart.data)?chart.data:[];
          const tickIndexes=[0,Math.round((pointCount-1)*.25),Math.round((pointCount-1)*.5),Math.round((pointCount-1)*.75),pointCount-1]
            .filter((value,index,array)=>array.indexOf(value)===index);
          tickIndexes.forEach((pointIndex,tickIndex)=>{
            const tx=px(pointIndex);
            doc.setDrawColor(216,211,204); doc.setLineWidth(.45); doc.line(tx,plotBottom,tx,plotBottom+4);
            doc.setTextColor(111,107,102); this._setReportFont(doc,'mono','normal'); doc.setFontSize(cfg.landscape?7:6.4);
            const label=String((labels[pointIndex]||{}).label||'');
            doc.text(label,tx,plotBottom+12,{align:tickIndex===0?'left':(tickIndex===tickIndexes.length-1?'right':'center')});
          });
          doc.setTextColor(111,107,102); this._setReportFont(doc,'bodyBold','bold'); doc.setFontSize(cfg.landscape?7:6.4);
          doc.text('GW',plotLeft-7,plotTop-6,{align:'right'});
        }
        doc.setTextColor(154,149,142); this._setReportFont(doc,'bodyBold','bold'); doc.setFontSize(cfg.landscape?7:6.6);
        doc.text(this._clipText(doc,String(chart.source||'Fuente: CENACE'),cardW-30).toUpperCase(),x+15,top+cardH-11);
        return;
      }

      const rows=chart.data.slice(0,6);
      const maxValue=Math.max(1,...rows.map(item=>Number(item.value)||0));
      const labelW=cfg.landscape?125:146;
      const valueW=cfg.landscape?74:78;
      const barX=x+15+labelW, barW=Math.max(54,cardW-30-labelW-valueW);
      const available=Math.max(70,top+cardH-28-cy);
      const rowH=Math.max(22,Math.min(cfg.landscape?43:31,available/Math.max(rows.length,1)));
      rows.forEach((item,rowIndex)=>{
        const rowY=cy+rowIndex*rowH;
        const value=Number(item.value)||0;
        doc.setTextColor(58,58,58); this._setReportFont(doc,'bodyBold','bold'); doc.setFontSize(cfg.landscape?8.2:7.4);
        const rawLabel=String(item.label||'Dato');
        const splitLabel=doc.splitTextToSize(rawLabel,labelW-9);
        const labelLines=splitLabel.length>2
          ? [splitLabel[0],this._clipText(doc,splitLabel.slice(1).join(' '),labelW-9)]
          : splitLabel;
        const labelLineH=cfg.landscape?8.8:7.8;
        const labelY=rowY+rowH*.5-((labelLines.length-1)*labelLineH)/2+labelLineH*.25;
        doc.text(labelLines,x+15,labelY,{lineHeightFactor:1.05});
        doc.setFillColor(246,243,239); doc.roundedRect(barX,rowY+rowH*.25,barW,rowH*.42,3,3,'F');
        const color=rgb(item.color);
        doc.setFillColor(color[0],color[1],color[2]);
        doc.roundedRect(barX,rowY+rowH*.25,Math.max(2,barW*(value/maxValue)),rowH*.42,3,3,'F');
        doc.setTextColor(28,27,26); this._setReportFont(doc,'mono','bold'); doc.setFontSize(cfg.landscape?8:7.2);
        doc.text(this._reportChartValueText(chart,value),x+cardW-15,rowY+rowH*.62,{align:'right'});
      });
      doc.setTextColor(154,149,142); this._setReportFont(doc,'bodyBold','bold'); doc.setFontSize(cfg.landscape?7:6.6);
      doc.text(this._clipText(doc,String(chart.source||'Fuente: SENER'),cardW-30).toUpperCase(),x+15,top+cardH-11);
    };
    data.forEach(drawCard);
    return cfg.landscape?cfg.maxY:cfg.y+data.length*(cardH+gap)-gap;
  }
  async _writeReportPDF(R, opts){
    const O=opts||{};
    const J=window.jspdf&&window.jspdf.jsPDF;
    if(!J){ this._toast('Preparando módulo PDF…'); return; }

    const doc=new J({unit:'pt',format:'letter',orientation:'portrait',compress:true,putOnlyUsedFonts:true});
    // Patria se registra una sola vez y jsPDF sólo embebe las variantes usadas.
    // Esto evita la duplicación que infló el adjunto y mantiene el PDF apto para correo.
    await this._initReportFonts(doc);
    const W=612,H=792,M=46,MAX_Y=H-58,indexPage=2;
    const sections=Array.isArray(R&&R.sections)?R.sections:[];
    const metrics=Array.isArray(R&&R.metrics)?R.metrics:[];
    const charts=Array.isArray(R&&R.charts)?R.charts:[];
    const folios={};
    const rgb=(hex,fallback)=>{
      const m=/^#?([\da-f]{2})([\da-f]{2})([\da-f]{2})$/i.exec(String(hex||''));
      return m?[parseInt(m[1],16),parseInt(m[2],16),parseInt(m[3],16)]:(fallback||[155,34,71]);
    };
    const addReportPage=(kicker,title,aside,folio)=>{
      doc.addPage('letter','portrait');
      const page=doc.getNumberOfPages();
      if(folio) folios[page]=folio;
      const y=this._pdfReportPageHead(doc,W,false,kicker,title,aside);
      return {page,y:y+12};
    };

    // 1 · Portada institucional y 2 · reserva del índice navegable.
    this._pdfReportCover(doc,R,W,H,false);
    doc.addPage('letter','portrait');
    folios[indexPage]='ÍNDICE';

    // 3 · Leyenda idéntica a la visible en el dashboard.
    let pageInfo=addReportPage('Leyenda del mapa','Capas y simbología','Estado de las capas al exportar','01');
    const legendPage=pageInfo.page;
    this._pdfReportLegend(doc,R&&R.legendGroups,{
      x:M,y:pageInfo.y,width:W-M*2,maxY:MAX_Y,landscape:false,
      newPage:()=>addReportPage('Leyenda del mapa','Capas y simbología · continuación','Estado al exportar','01').y,
    });

    // 4 · Zona evaluada y mapa del análisis.
    pageInfo=addReportPage('Zona evaluada','Mapa del análisis','Encuadre activo al exportar','02');
    const zonePage=pageInfo.page;
    let y=pageInfo.y;
    const meta=Array.isArray(R&&R.meta)?R.meta:[];
    const metaCols=2,metaGap=10,metaW=(W-M*2-metaGap)/metaCols,metaH=42;
    const metaRows=Math.ceil(meta.length/metaCols);
    const mapMaxH=Math.max(175,Math.min(340,MAX_Y-y-(metaRows*metaH+58)));
    const mapH=this._fitMap(doc,M,y,W-M*2,mapMaxH);
    if(mapH){
      y+=mapH+13;
    }else{
      doc.setFillColor(250,248,245); doc.setDrawColor(236,232,226); doc.roundedRect(M,y,W-M*2,76,4,4,'FD');
      doc.setTextColor(155,34,71); this._setReportFont(doc,'bodyBold','bold'); doc.setFontSize(10);
      doc.text('Mapa no disponible para exportación',M+14,y+29);
      doc.setTextColor(111,107,102); this._setReportFont(doc,'body','normal'); doc.setFontSize(8.5);
      doc.text('El encuadre actual no permite capturar el mapa. Pruebe con la base Color, Claro u Oscuro y genere el reporte de nuevo.',M+14,y+48);
      y+=91;
    }
    doc.setTextColor(155,34,71); this._setReportFont(doc,'kicker','bold'); doc.setFontSize(8); doc.setCharSpace(.7);
    doc.text('FICHA DE LA ZONA',M,y); doc.setCharSpace(0); y+=11;
    meta.forEach((row,i)=>{
      const cx=M+(i%metaCols)*(metaW+metaGap),cy=y+Math.floor(i/metaCols)*metaH;
      doc.setFillColor(i%2?250:255,i%2?248:255,i%2?245:255); doc.setDrawColor(236,232,226); doc.roundedRect(cx,cy,metaW,metaH-6,3,3,'FD');
      doc.setTextColor(154,149,142); this._setReportFont(doc,'bodyBold','bold'); doc.setFontSize(6.8);
      doc.text(this._clipText(doc,String((row||[])[0]||'').toUpperCase(),metaW-16),cx+8,cy+12);
      const value=this._clipText(doc,String((row||[])[1]==null?'—':row[1]),metaW-16);
      const url=String((row||[])[2]||'').trim();
      doc.setTextColor(url?155:28,url?34:27,url?71:26); this._setReportFont(doc,'bodyBold','bold'); doc.setFontSize(9);
      doc.text(value,cx+8,cy+27);
      if(url){
        const linkW=Math.min(metaW-16,doc.getTextWidth(value));
        doc.setDrawColor(155,34,71); doc.setLineWidth(.55); doc.line(cx+8,cy+29,cx+8+linkW,cy+29);
        doc.link(cx+6,cy+16,linkW+6,16,{url});
      }
    });

    // Indicador agregado de "todo en cero": se evalúa al inicio porque se usa
    // antes de declarar (en la sección de métricas del PDF).
    const allDim = metrics.length > 0 && metrics.every(m => m && m.dim);

    // 5 · Indicadores. Se omite si todas las métricas están en cero.
    let metricsPage=null;
    if(!allDim){
      const addMetricsPage=(continuation)=>addReportPage('Indicadores territoriales',continuation?'Métricas del análisis · continuación':'Métricas del análisis',R.date||'Reporte territorial','03');
      pageInfo=addMetricsPage(false);
      metricsPage=pageInfo.page;
      y=pageInfo.y;
      const metricGap=11,metricW=(W-M*2-metricGap)/2;
      const measureMetric=(mt)=>{
        this._setReportFont(doc,'bodyBold','bold'); doc.setFontSize(7.4);
        const label=doc.splitTextToSize(String((mt&&mt.label)||'Indicador').toUpperCase(),metricW-26);
        this._setReportFont(doc,'title','bold'); doc.setFontSize(18);
        const value=doc.splitTextToSize(String(mt&&mt.value!=null?mt.value:'—'),metricW-26);
        this._setReportFont(doc,'body','normal'); doc.setFontSize(7.4);
        const sub=doc.splitTextToSize(String((mt&&mt.sub)||''),metricW-26);
        return {label,value,sub,h:Math.max(70,18+label.length*8.5+value.length*18+sub.length*9)};
      };
      const drawMetric=(mt,box,cx,cy,rowH)=>{
        const accent=rgb(mt&&mt.color,mt&&mt.dim?[154,149,142]:[155,34,71]);
        doc.setFillColor(mt&&mt.dim?250:255,mt&&mt.dim?248:255,mt&&mt.dim?245:255);
        doc.setDrawColor(236,232,226); doc.roundedRect(cx,cy,metricW,rowH-7,4,4,'FD');
        doc.setFillColor(accent[0],accent[1],accent[2]); doc.rect(cx,cy,4,rowH-7,'F');
        let ty=cy+15;
        doc.setTextColor(111,107,102); this._setReportFont(doc,'bodyBold','bold'); doc.setFontSize(7.4); doc.text(box.label,cx+13,ty); ty+=box.label.length*8.5+3;
        doc.setTextColor(mt&&mt.dim?111:155,mt&&mt.dim?107:34,mt&&mt.dim?102:71); this._setReportFont(doc,'title','bold'); doc.setFontSize(18); doc.text(box.value,cx+13,ty+12); ty+=box.value.length*18+3;
        if(box.sub.length){ doc.setTextColor(111,107,102); this._setReportFont(doc,'body','normal'); doc.setFontSize(7.4); doc.text(box.sub,cx+13,ty+7); }
      };
      for(let i=0;i<metrics.length;i+=2){
        const left=measureMetric(metrics[i]),right=i+1<metrics.length?measureMetric(metrics[i+1]):null;
        const rowH=Math.max(left.h,right?right.h:0);
        if(y+rowH>MAX_Y){ pageInfo=addMetricsPage(true); y=pageInfo.y; }
        drawMetric(metrics[i],left,M,y,rowH);
        if(right) drawMetric(metrics[i+1],right,M+metricW+metricGap,y,rowH);
        y+=rowH+5;
      }
    }
    if(allDim){
      doc.setTextColor(111,107,102); this._setReportFont(doc,'body','italic'); doc.setFontSize(9);
      doc.text('Ningún indicador con elementos en la cobertura. Revise la ubicación o amplíe el buffer de análisis.',M,y+8);
    } else if(!metrics.length){
      doc.setTextColor(111,107,102); this._setReportFont(doc,'body','italic'); doc.setFontSize(9);
      doc.text('No se registraron indicadores para esta corrida.',M,y+8);
    }

    const demandCharts=charts.filter(chart=>chart&&chart.group==='demand');
    const electricCharts=charts.filter(chart=>chart&&chart.group!=='inegi'&&chart.group!=='tariffs'&&chart.group!=='demand'&&chart.group!=='consumption');
    const tariffCharts=charts.filter(chart=>chart&&chart.group==='tariffs');
    const inegiCharts=charts.filter(chart=>chart&&chart.group==='inegi');
    let electricChartPage=null,demandChartPage=null,tariffChartPage=null,inegiChartPage=null,chartPageCount=0;
    let electricChartFolio=null,demandChartFolio=null,tariffChartFolio=null,inegiChartFolio=null;
    if(electricCharts.length){
      electricChartFolio=String(4+chartPageCount).padStart(2,'0');
      pageInfo=addReportPage('Perfil eléctrico','Capacidad y tensión en la zona','Activos dentro de la cobertura',electricChartFolio);
      electricChartPage=pageInfo.page; chartPageCount++;
      this._pdfReportCharts(doc,electricCharts,{x:M,y:pageInfo.y,width:W-M*2,maxY:MAX_Y,landscape:false});
    }
    if(demandCharts.length){
      demandChartFolio=String(4+chartPageCount).padStart(2,'0');
      pageInfo=addReportPage('Operación del sistema','Demanda y pronóstico por hora','Regiones de control en la cobertura',demandChartFolio);
      demandChartPage=pageInfo.page; chartPageCount++;
      this._pdfReportCharts(doc,demandCharts,{x:M,y:pageInfo.y,width:W-M*2,maxY:MAX_Y,landscape:false});
    }
    if(tariffCharts.length){
      tariffChartFolio=String(4+chartPageCount).padStart(2,'0');
      pageInfo=addReportPage('Precios energéticos','Tarifas eléctricas por división','Último histórico disponible',tariffChartFolio);
      tariffChartPage=pageInfo.page; chartPageCount++;
      this._pdfReportCharts(doc,tariffCharts,{x:M,y:pageInfo.y,width:W-M*2,maxY:MAX_Y,landscape:false});
    }
    if(inegiCharts.length){
      inegiChartFolio=String(4+chartPageCount).padStart(2,'0');
      pageInfo=addReportPage('Contexto territorial · INEGI','Perfil sociodemográfico y económico','Indicadores oficiales',inegiChartFolio);
      inegiChartPage=pageInfo.page; chartPageCount++;
      this._pdfReportCharts(doc,inegiCharts,{x:M,y:pageInfo.y,width:W-M*2,maxY:MAX_Y,landscape:false});
    }

    // Secciones analíticas: cada una inicia en página propia y puede continuar tantas veces como sea necesario.
    // Se filtran secciones sin contenido real (tablas vacías, sin chips ni filas informativas).
    const hasContent=(sec)=>{
      const t1=(sec.table&&sec.table.rows&&sec.table.rows.length>0);
      const t2=(sec.table2&&sec.table2.rows&&sec.table2.rows.length>0);
      const rowVals=(sec.rows||[]).map(r=>String(r[1]||''));
      const rowUseful=rowVals.some(v=>v&&!/^(no analizada|ninguno)/.test(v));
      const ch=(sec.chips&&sec.chips.length>0);
      const sub=(sec.subSections&&sec.subSections.length>0);
      return t1||t2||(sec.hasRows&&rowUseful)||(sec.hasChips&&ch)||sub||
        !!sec.hasMap||!!(sec.mapGallery&&sec.mapGallery.length);
    };
    const nonEmptySections=sections.filter(hasContent);
    const indexEntries=[
      {group:'Panorama general',folio:'01',title:'Leyenda del mapa y estado de capas',page:legendPage},
      {group:'Panorama general',folio:'02',title:'Zona evaluada y mapa del análisis',page:zonePage},
    ];
    if(!allDim) indexEntries.push({group:'Panorama general',folio:'03',title:'Indicadores de la cobertura analizada',page:metricsPage});
    if(electricChartPage) indexEntries.push({group:'Panorama general',folio:electricChartFolio,title:'Perfil eléctrico de la zona',page:electricChartPage});
    if(demandChartPage) indexEntries.push({group:'Panorama general',folio:demandChartFolio,title:'Demanda y pronóstico por región',page:demandChartPage});
    if(tariffChartPage) indexEntries.push({group:'Panorama general',folio:tariffChartFolio,title:'Tarifas eléctricas por división',page:tariffChartPage});
    if(inegiChartPage) indexEntries.push({group:'Panorama general',folio:inegiChartFolio,title:'Perfil sociodemográfico y económico',page:inegiChartPage});
    nonEmptySections.forEach((sec)=>{
      const folio=String(sections.indexOf(sec)+4+chartPageCount).padStart(2,'0');
      const addSectionPage=(continuation)=>{
        const info=addReportPage(sec.kicker||'Análisis territorial',continuation?String(sec.title||'Sección')+' · continuación':sec.title||'Sección',folio,folio);
        return info;
      };
      let sectionPage=addSectionPage(false);
      indexEntries.push({group:'Secciones de análisis',folio,title:String(sec.title||'Sección'),page:sectionPage.page});
      y=sectionPage.y;
      const nextSectionPage=()=>{ sectionPage=addSectionPage(true); y=sectionPage.y; return y; };

      doc.setTextColor(111,107,102); this._setReportFont(doc,'body','normal'); doc.setFontSize(9);
      const intro=doc.splitTextToSize(String(sec.intro||''),W-M*2);
      intro.forEach(line=>{
        if(y+12>MAX_Y) nextSectionPage();
        doc.text(line,M,y); y+=12;
      });
      if(intro.length) y+=7;
      if(sec.hasMap&&sec.mapDataUrl){
        const estimatedMapHeight=285;
        if(y+estimatedMapHeight>MAX_Y) nextSectionPage();
        y=this._pdfReportThematicMap(doc,sec,{
          x:M,y,width:W-M*2,maxHeight:250,landscape:false
        });
      }
      (sec.mapGallery||[]).forEach(mapItem=>{
        if(y+285>MAX_Y) nextSectionPage();
        y=this._pdfReportThematicMap(doc,mapItem,{
          x:M,y,width:W-M*2,maxHeight:250,landscape:false
        });
      });
      const sectionCharts=Array.isArray(sec.charts)?sec.charts:[];
      const chartOffset=sec.key==='inegi'
        ?Math.min(2,sectionCharts.length)
        :(sec.key==='tarifas-electricas'
          ?Math.min(1,sectionCharts.length)
          :(sec.key==='demanda-pronostico'?Math.min(2,sectionCharts.length):0));
      sectionCharts.slice(chartOffset).forEach(chart=>{
        if(y+278>MAX_Y) nextSectionPage();
        y=this._pdfReportCharts(doc,[chart],{
          x:M,y,width:W-M*2,maxY:MAX_Y,landscape:false,
          maxCardHeight:sec.key==='usuarios-consumo'?198:undefined
        })+14;
      });

      const drawTable=(table,gold)=>{
        if(!table||!Array.isArray(table.head)||!table.head.length) return;
        if(y+54>MAX_Y) nextSectionPage();
        y=this._pdfReportTable(doc,table,{
          x:M,y,width:W-M*2,maxY:MAX_Y,landscape:false,gold:!!gold,
          newPage:()=>nextSectionPage(),
        });
      };
      if(sec.hasTable) drawTable(sec.table,false);
      if(sec.hasTable2) drawTable(sec.table2,true);

      const rows=sec.hasRows&&Array.isArray(sec.rows)?sec.rows:[];
      if(rows.length){
        if(y+30>MAX_Y) nextSectionPage();
        doc.setTextColor(155,34,71); this._setReportFont(doc,'kicker','bold'); doc.setFontSize(8); doc.setCharSpace(.65);
        doc.text('RESUMEN DE HALLAZGOS',M,y); doc.setCharSpace(0); y+=13;
        const labelW=190,valueX=M+labelW+12,valueW=W-M-valueX,lh=10;
        rows.forEach((row,ri)=>{
          this._setReportFont(doc,'body','normal'); doc.setFontSize(8.2);
          const labels=doc.splitTextToSize(String((row||[])[0]==null?'':row[0]),labelW-12);
          this._setReportFont(doc,'bodyBold','bold');
          const values=doc.splitTextToSize(String((row||[])[1]==null?'':row[1]),valueW-10);
          const lineCount=Math.max(labels.length,values.length,1);
          let offset=0;
          while(offset<lineCount){
            let available=Math.floor((MAX_Y-y-10)/lh);
            if(available<1){ nextSectionPage(); available=Math.max(1,Math.floor((MAX_Y-y-10)/lh)); }
            const take=Math.min(lineCount-offset,available),rh=take*lh+9;
            if(ri%2===1){ doc.setFillColor(250,248,245); doc.rect(M,y,W-M*2,rh,'F'); }
            doc.setTextColor(111,107,102); this._setReportFont(doc,'body','normal'); doc.setFontSize(8.2);
            const labelChunk=labels.slice(offset,offset+take); if(labelChunk.length) doc.text(labelChunk,M+6,y+11);
            doc.setTextColor(28,27,26); this._setReportFont(doc,'bodyBold','bold');
            const valueChunk=values.slice(offset,offset+take); if(valueChunk.length) doc.text(valueChunk,valueX,y+11);
            doc.setDrawColor(240,236,230); doc.setLineWidth(.55); doc.line(M,y+rh,W-M,y+rh);
            y+=rh; offset+=take;
          }
        });
        y+=9;
      }

      const chips=sec.hasChips&&Array.isArray(sec.chips)?sec.chips:[];
      if(chips.length){
        if(y+32>MAX_Y) nextSectionPage();
        doc.setTextColor(155,34,71); this._setReportFont(doc,'kicker','bold'); doc.setFontSize(8); doc.setCharSpace(.65);
        doc.text('ELEMENTOS IDENTIFICADOS',M,y); doc.setCharSpace(0); y+=13;
        const chipGap=9,chipW=(W-M*2-chipGap)/2;
        for(let i=0;i<chips.length;i+=2){
          this._setReportFont(doc,'body','normal'); doc.setFontSize(8);
          const left=doc.splitTextToSize(String(chips[i]),chipW-18);
          const right=i+1<chips.length?doc.splitTextToSize(String(chips[i+1]),chipW-18):null;
          const chipH=Math.max(24,10+Math.max(left.length,right?right.length:0)*10);
          if(y+chipH>MAX_Y) nextSectionPage();
          const drawChip=(lines,cx)=>{
            doc.setFillColor(250,248,245); doc.setDrawColor(224,220,212); doc.roundedRect(cx,y,chipW,chipH-5,7,7,'FD');
            doc.setTextColor(58,58,58); this._setReportFont(doc,'body','normal'); doc.setFontSize(8); doc.text(lines,cx+9,y+13);
          };
          drawChip(left,M); if(right) drawChip(right,M+chipW+chipGap);
          y+=chipH;
        }
      }
      if(sec.hasSubSections&&Array.isArray(sec.subSections)&&sec.subSections.length){
        y=this._pdfReportSubSections(doc,sec.subSections,{
          x:M,y:y+10,width:W-M*2,maxY:MAX_Y,landscape:false,
          newPage:()=>nextSectionPage(),
        });
      }
    });

    // Contraportada, índice y navegación interna.
    doc.addPage('letter','portrait');
    const backPage=doc.getNumberOfPages();
    this._pdfReportBack(doc,W,H,false,R);
    this._pdfReportIndex(doc,W,H,false,indexEntries,indexPage);
    this._pdfApplyReportFooters(doc,W,H,false,indexPage,backPage,folios);

    if(O.returnData) return {base64:doc.output('datauristring'),sizeBytes:doc.output('arraybuffer').byteLength};
    doc.save('DGMESNIE_reporte_territorial_'+new Date().toISOString().slice(0,10)+'.pdf');
    this._toast('Reporte PDF exportado');
  }
  async _writeReportPDFPresent(R, opts){
    const O=opts||{};
    const J=window.jspdf&&window.jspdf.jsPDF;
    if(!J){ this._toast('Preparando módulo PDF…'); return; }

    const doc=new J({unit:'pt',format:[960,540],orientation:'landscape',compress:true,putOnlyUsedFonts:true});
    await this._initReportFonts(doc);
    const W=960,H=540,M=40,MAX_Y=494,indexPage=2;
    const sections=Array.isArray(R&&R.sections)?R.sections:[];
    const metrics=Array.isArray(R&&R.metrics)?R.metrics:[];
    const charts=Array.isArray(R&&R.charts)?R.charts:[];
    const meta=Array.isArray(R&&R.meta)?R.meta:[];
    const folios={};
    const indexEntries=[];
    const allDim=metrics.length>0&&metrics.every(m=>m&&m.dim);
    const rgb=(hex,fallback)=>{
      const m=/^#?([\da-f]{2})([\da-f]{2})([\da-f]{2})$/i.exec(String(hex||''));
      return m?[parseInt(m[1],16),parseInt(m[2],16),parseInt(m[3],16)]:(fallback||[155,34,71]);
    };
    const addReportPage=(kicker,title,aside,folio)=>{
      doc.addPage([960,540],'landscape');
      const page=doc.getNumberOfPages();
      if(folio) folios[page]=folio;
      return {page,y:this._pdfReportPageHead(doc,W,true,kicker,title,aside)+8};
    };

    // 1 · Portada territorial PAM y 2 · reserva para el índice navegable a dos columnas.
    this._pdfReportCover(doc,R,W,H,true);
    doc.addPage([960,540],'landscape');
    folios[indexPage]='ÍNDICE';

    // 3 · Leyenda idéntica a la visible en el dashboard.
    let pageInfo=addReportPage('Leyenda del mapa','Capas y simbología','Estado de las capas al exportar','01');
    const legendPage=pageInfo.page;
    indexEntries.push({group:'Panorama general',folio:'01',title:'Leyenda del mapa y estado de capas',page:legendPage});
    this._pdfReportLegend(doc,R&&R.legendGroups,{
      x:M,y:pageInfo.y,width:W-M*2,maxY:MAX_Y,landscape:true,
      newPage:()=>addReportPage('Leyenda del mapa','Capas y simbología · continuación','Estado al exportar','01').y,
    });

    // 4 · Zona evaluada: mapa activo y ficha territorial completa.
    pageInfo=addReportPage('Zona evaluada','Mapa del análisis','Encuadre activo al exportar','02');
    const zonePage=pageInfo.page;
    indexEntries.push({group:'Panorama general',folio:'02',title:'Zona evaluada y mapa del análisis',page:zonePage});
    let y=pageInfo.y;
    const mapW=552,mapMaxH=Math.min(292,MAX_Y-y-34);
    const mapH=this._fitMap(doc,M,y,mapW,mapMaxH);
    if(!mapH){
      doc.setFillColor(250,248,245); doc.setDrawColor(236,232,226); doc.roundedRect(M,y,mapW,110,5,5,'FD');
      doc.setTextColor(155,34,71); this._setReportFont(doc,'bodyBold','bold'); doc.setFontSize(12);
      doc.text('Mapa no disponible para exportación',M+18,y+40);
      doc.setTextColor(111,107,102); this._setReportFont(doc,'body','normal'); doc.setFontSize(9);
      doc.text('El encuadre actual no permite capturar el mapa. Pruebe con la base Color, Claro u Oscuro y genere el reporte de nuevo.',M+18,y+62);
    }

    const metaX=M+mapW+28,metaW=W-M-metaX;
    let metaY=y;
    doc.setTextColor(155,34,71); this._setReportFont(doc,'kicker','bold'); doc.setFontSize(9); doc.setCharSpace(.7);
    doc.text('FICHA TERRITORIAL',metaX,metaY); doc.setCharSpace(0); metaY+=13;
    const measureMeta=(row,width)=>{
      this._setReportFont(doc,'bodyBold','bold'); doc.setFontSize(7.2);
      const label=doc.splitTextToSize(String((row||[])[0]||'').toUpperCase(),width-20);
      this._setReportFont(doc,'bodyBold','bold'); doc.setFontSize(10);
      const value=doc.splitTextToSize(String((row||[])[1]==null?'—':row[1]),width-20);
      return {label,value,url:String((row||[])[2]||'').trim(),h:Math.max(43,18+label.length*8+value.length*11)};
    };
    const drawMeta=(box,x,top,width)=>{
      doc.setFillColor(250,248,245); doc.setDrawColor(236,232,226); doc.roundedRect(x,top,width,box.h-5,4,4,'FD');
      doc.setTextColor(154,149,142); this._setReportFont(doc,'bodyBold','bold'); doc.setFontSize(7.2); doc.text(box.label,x+10,top+12);
      const valueY=top+13+box.label.length*8;
      doc.setTextColor(box.url?155:28,box.url?34:27,box.url?71:26); this._setReportFont(doc,'bodyBold','bold'); doc.setFontSize(10); doc.text(box.value,x+10,valueY);
      if(box.url){
        const linkW=Math.min(width-20,doc.getTextWidth(String(box.value[0]||'')));
        doc.setDrawColor(155,34,71); doc.setLineWidth(.6); doc.line(x+10,valueY+2,x+10+linkW,valueY+2);
        doc.link(x+7,valueY-11,linkW+7,16,{url:box.url});
      }
    };
    let metaIndex=0;
    while(metaIndex<meta.length){
      const box=measureMeta(meta[metaIndex],metaW);
      if(metaY+box.h>MAX_Y) break;
      drawMeta(box,metaX,metaY,metaW); metaY+=box.h; metaIndex++;
    }
    while(metaIndex<meta.length){
      pageInfo=addReportPage('Zona evaluada','Ficha territorial · continuación','Datos del sitio','02');
      let cy=pageInfo.y;
      const gap=14,cardW=(W-M*2-gap)/2;
      while(metaIndex<meta.length){
        const left=measureMeta(meta[metaIndex],cardW);
        const right=metaIndex+1<meta.length?measureMeta(meta[metaIndex+1],cardW):null;
        const rowH=Math.max(left.h,right?right.h:0);
        if(cy+rowH>MAX_Y) break;
        drawMeta(left,M,cy,cardW);
        if(right) drawMeta(right,M+cardW+gap,cy,cardW);
        cy+=rowH; metaIndex+=right?2:1;
      }
      if(cy===pageInfo.y){
        const box=measureMeta(meta[metaIndex],W-M*2);
        drawMeta(box,M,cy,W-M*2); metaIndex++;
      }
    }

    // Indicadores: todas las tarjetas continúan en las láminas necesarias, sin cortes por cantidad.
    let metricsPage=null;
    if(!allDim){
      const addMetricsPage=(continuation)=>addReportPage('Indicadores territoriales',continuation?'Métricas del análisis · continuación':'Métricas del análisis',R&&R.date?R.date:'Reporte territorial','03');
      pageInfo=addMetricsPage(false);
      metricsPage=pageInfo.page;
      indexEntries.push({group:'Panorama general',folio:'03',title:'Indicadores de la cobertura analizada',page:metricsPage});
      y=pageInfo.y;
      const metricGap=12,metricW=(W-M*2-metricGap*2)/3;
      const measureMetric=(metric,width)=>{
        this._setReportFont(doc,'bodyBold','bold'); doc.setFontSize(8);
        const label=doc.splitTextToSize(String((metric&&metric.label)||'Indicador').toUpperCase(),width-28);
        this._setReportFont(doc,'title','bold'); doc.setFontSize(20);
        const value=doc.splitTextToSize(String(metric&&metric.value!=null?metric.value:'—'),width-28);
        this._setReportFont(doc,'body','normal'); doc.setFontSize(8);
        const sub=doc.splitTextToSize(String((metric&&metric.sub)||''),width-28);
        return {label,value,sub,h:Math.max(80,21+label.length*9+value.length*21+sub.length*10)};
      };
      const drawMetric=(metric,box,x,top,width,height)=>{
        const accent=rgb(metric&&metric.color,metric&&metric.dim?[154,149,142]:[155,34,71]);
        doc.setFillColor(metric&&metric.dim?250:255,metric&&metric.dim?248:255,metric&&metric.dim?245:255);
        doc.setDrawColor(236,232,226); doc.roundedRect(x,top,width,height-6,5,5,'FD');
        doc.setFillColor(accent[0],accent[1],accent[2]); doc.rect(x,top,5,height-6,'F');
        let ty=top+16;
        doc.setTextColor(111,107,102); this._setReportFont(doc,'bodyBold','bold'); doc.setFontSize(8); doc.text(box.label,x+15,ty);
        ty+=box.label.length*9+4;
        doc.setTextColor(metric&&metric.dim?111:155,metric&&metric.dim?107:34,metric&&metric.dim?102:71);
        this._setReportFont(doc,'title','bold'); doc.setFontSize(20); doc.text(box.value,x+15,ty+14);
        ty+=box.value.length*21+3;
        if(box.sub.length){ doc.setTextColor(111,107,102); this._setReportFont(doc,'body','normal'); doc.setFontSize(8); doc.text(box.sub,x+15,ty+7); }
      };
      for(let i=0;i<metrics.length;i+=3){
        const group=metrics.slice(i,i+3);
        let boxes=group.map(metric=>measureMetric(metric,metricW));
        let rowH=Math.max.apply(null,boxes.map(box=>box.h));
        if(rowH>MAX_Y-pageInfo.y){
          group.forEach(metric=>{
            const fullBox=measureMetric(metric,W-M*2);
            if(y+fullBox.h>MAX_Y){ pageInfo=addMetricsPage(true); y=pageInfo.y; }
            drawMetric(metric,fullBox,M,y,W-M*2,fullBox.h); y+=fullBox.h+5;
          });
          continue;
        }
        if(y+rowH>MAX_Y){ pageInfo=addMetricsPage(true); y=pageInfo.y; }
        group.forEach((metric,ci)=>drawMetric(metric,boxes[ci],M+ci*(metricW+metricGap),y,metricW,rowH));
        y+=rowH+6;
      }
    }
    if(allDim){
      doc.setTextColor(111,107,102); this._setReportFont(doc,'body','italic'); doc.setFontSize(10);
      doc.text('Ningún indicador con elementos en la cobertura. Revise la ubicación o amplíe el buffer de análisis.',M,y+10);
    } else if(!metrics.length){
      doc.setTextColor(111,107,102); this._setReportFont(doc,'body','italic'); doc.setFontSize(10);
      doc.text('No se registraron indicadores para esta corrida.',M,y+10);
    }

    const demandCharts=charts.filter(chart=>chart&&chart.group==='demand');
    const electricCharts=charts.filter(chart=>chart&&chart.group!=='inegi'&&chart.group!=='tariffs'&&chart.group!=='demand'&&chart.group!=='consumption');
    const tariffCharts=charts.filter(chart=>chart&&chart.group==='tariffs');
    const inegiCharts=charts.filter(chart=>chart&&chart.group==='inegi');
    let chartPageCount=0;
    if(electricCharts.length){
      const folio=String(4+chartPageCount).padStart(2,'0');
      pageInfo=addReportPage('Perfil eléctrico','Capacidad y tensión en la zona','Activos dentro de la cobertura',folio);
      indexEntries.push({group:'Panorama general',folio,title:'Perfil eléctrico de la zona',page:pageInfo.page});
      this._pdfReportCharts(doc,electricCharts,{x:M,y:pageInfo.y,width:W-M*2,maxY:MAX_Y,landscape:true});
      chartPageCount++;
    }
    if(demandCharts.length){
      const folio=String(4+chartPageCount).padStart(2,'0');
      pageInfo=addReportPage('Operación del sistema','Demanda y pronóstico por hora','Regiones de control en la cobertura',folio);
      indexEntries.push({group:'Panorama general',folio,title:'Demanda y pronóstico por región',page:pageInfo.page});
      this._pdfReportCharts(doc,demandCharts,{x:M,y:pageInfo.y,width:W-M*2,maxY:MAX_Y,landscape:true});
      chartPageCount++;
    }
    if(tariffCharts.length){
      const folio=String(4+chartPageCount).padStart(2,'0');
      pageInfo=addReportPage('Precios energéticos','Tarifas eléctricas por división','Último histórico disponible',folio);
      indexEntries.push({group:'Panorama general',folio,title:'Tarifas eléctricas por división',page:pageInfo.page});
      this._pdfReportCharts(doc,tariffCharts,{x:M,y:pageInfo.y,width:W-M*2,maxY:MAX_Y,landscape:true});
      chartPageCount++;
    }
    if(inegiCharts.length){
      const folio=String(4+chartPageCount).padStart(2,'0');
      pageInfo=addReportPage('Contexto territorial · INEGI','Perfil sociodemográfico y económico','Indicadores oficiales',folio);
      indexEntries.push({group:'Panorama general',folio,title:'Perfil sociodemográfico y económico',page:pageInfo.page});
      this._pdfReportCharts(doc,inegiCharts,{x:M,y:pageInfo.y,width:W-M*2,maxY:MAX_Y,landscape:true});
      chartPageCount++;
    }

    // Secciones analíticas PAM: introducciones, tablas, hallazgos y chips continúan sin truncarse.
    const hasContent=(sec)=>{
      const t1=(sec&&sec.table&&sec.table.rows&&sec.table.rows.length>0);
      const t2=(sec&&sec.table2&&sec.table2.rows&&sec.table2.rows.length>0);
      const rowVals=(sec.rows||[]).map(r=>String(r[1]||''));
      const rowUseful=rowVals.some(v=>v&&!/^(no analizada|ninguno)/.test(v));
      const ch=(sec.chips&&sec.chips.length>0);
      const sub=(sec&&sec.subSections&&sec.subSections.length>0);
      return t1||t2||(sec.hasRows&&rowUseful)||(sec.hasChips&&ch)||sub||
        !!(sec&&sec.hasMap)||!!(sec&&sec.mapGallery&&sec.mapGallery.length);
    };
    const nonEmptySections=sections.filter(hasContent);
    nonEmptySections.forEach((sec)=>{
      const folio=String(sections.indexOf(sec)+4+chartPageCount).padStart(2,'0');
      const sectionTitle=String(sec&&sec.title||'Sección');
      const addSectionPage=(continuation)=>addReportPage(sec&&sec.kicker||'Análisis territorial',continuation?sectionTitle+' · continuación':sectionTitle,folio,folio);
      let sectionPage=addSectionPage(false);
      indexEntries.push({group:'Secciones de análisis',folio,title:sectionTitle,page:sectionPage.page});
      y=sectionPage.y;
      const nextSectionPage=()=>{ sectionPage=addSectionPage(true); y=sectionPage.y; return y; };
      const ensureSpace=(height)=>{ if(y+height>MAX_Y) nextSectionPage(); };
      const drawSectionLabel=(text)=>{
        ensureSpace(24);
        doc.setTextColor(155,34,71); this._setReportFont(doc,'kicker','bold'); doc.setFontSize(8.5); doc.setCharSpace(.65);
        doc.text(String(text).toUpperCase(),M,y); doc.setCharSpace(0); y+=15;
      };

      doc.setTextColor(111,107,102); this._setReportFont(doc,'body','normal'); doc.setFontSize(9.5);
      const intro=doc.splitTextToSize(String(sec&&sec.intro||''),W-M*2);
      intro.forEach(line=>{
        if(y+13>MAX_Y) nextSectionPage();
        doc.setTextColor(111,107,102); this._setReportFont(doc,'body','normal'); doc.setFontSize(9.5); doc.text(line,M,y); y+=13;
      });
      if(intro.length) y+=8;
      if(sec&&sec.hasMap&&sec.mapDataUrl){
        const estimatedMapHeight=285;
        if(y+estimatedMapHeight>MAX_Y) nextSectionPage();
        y=this._pdfReportThematicMap(doc,sec,{
          x:M,y,width:W-M*2,maxHeight:245,landscape:true
        });
      }
      (sec&&sec.mapGallery||[]).forEach(mapItem=>{
        if(y+285>MAX_Y) nextSectionPage();
        y=this._pdfReportThematicMap(doc,mapItem,{
          x:M,y,width:W-M*2,maxHeight:245,landscape:true
        });
      });
      const sectionCharts=Array.isArray(sec&&sec.charts)?sec.charts:[];
      const chartOffset=sec&&sec.key==='inegi'
        ?Math.min(2,sectionCharts.length)
        :(sec&&sec.key==='tarifas-electricas'
          ?Math.min(1,sectionCharts.length)
          :(sec&&sec.key==='demanda-pronostico'?Math.min(2,sectionCharts.length):0));
      sectionCharts.slice(chartOffset).forEach(chart=>{
        if(y+270>MAX_Y) nextSectionPage();
        y=this._pdfReportCharts(doc,[chart],{
          x:M,y,width:W-M*2,maxY:MAX_Y,landscape:true
        })+12;
      });

      const normalizeTable=(table)=>{
        const head=Array.isArray(table&&table.head)?table.head:[];
        const rows=Array.isArray(table&&table.rows)?table.rows:[];
        if(!head.length) return {head:[],rows:[]};
        const n=head.length,width=W-M*2,first=n>=5?.30:(n===2?.56:.42);
        const widths=[width*first]; for(let i=1;i<n;i++) widths.push(width*(1-first)/(n-1));
        const out=[];
        rows.forEach(row=>{
          this._setReportFont(doc,'body','normal'); doc.setFontSize(8.2);
          const cells=head.map((_,i)=>doc.splitTextToSize(String((row||[])[i]==null?'':row[i]),Math.max(14,widths[i]-10)));
          const lineCount=Math.max(1,...cells.map(lines=>lines.length));
          for(let offset=0;offset<lineCount;offset+=25){
            out.push(cells.map((lines,i)=>{
              const chunk=lines.slice(offset,offset+25);
              if(chunk.length) return chunk.join('\n');
              return offset&&i===0?'(continuación)':'';
            }));
          }
        });
        return {head,rows:out};
      };
      const drawTable=(table,gold,label)=>{
        const normalized=normalizeTable(table);
        if(!normalized.head.length) return;
        drawSectionLabel(label);
        if(y+52>MAX_Y) nextSectionPage();
        y=this._pdfReportTable(doc,normalized,{
          x:M,y,width:W-M*2,maxY:MAX_Y,landscape:true,gold:!!gold,
          newPage:()=>nextSectionPage(),
        });
      };
      const table1=sec&&sec.table;
      const table2=sec&&sec.table2;
      if((sec&&sec.hasTable)||(table1&&Array.isArray(table1.head)&&table1.head.length)) drawTable(table1,false,sec.tableLabel||'Detalle de la sección');
      if((sec&&sec.hasTable2)||(table2&&Array.isArray(table2.head)&&table2.head.length)) drawTable(table2,true,'Detalle complementario');

      const rows=Array.isArray(sec&&sec.rows)?sec.rows:[];
      if((sec&&sec.hasRows)||rows.length){
        drawSectionLabel('Resumen de hallazgos');
        const labelW=330,valueX=M+labelW+18,valueW=W-M-valueX,lh=11;
        rows.forEach((row,ri)=>{
          this._setReportFont(doc,'body','normal'); doc.setFontSize(9);
          const labels=doc.splitTextToSize(String((row||[])[0]==null?'':row[0]),labelW-14);
          this._setReportFont(doc,'bodyBold','bold');
          const values=doc.splitTextToSize(String((row||[])[1]==null?'':row[1]),valueW-14);
          const lineCount=Math.max(labels.length,values.length,1);
          let offset=0;
          while(offset<lineCount){
            let available=Math.floor((MAX_Y-y-10)/lh);
            if(available<1){ nextSectionPage(); available=Math.max(1,Math.floor((MAX_Y-y-10)/lh)); }
            const take=Math.min(lineCount-offset,available),rowH=take*lh+10;
            if(ri%2===1){ doc.setFillColor(250,248,245); doc.rect(M,y,W-M*2,rowH,'F'); }
            const labelChunk=labels.slice(offset,offset+take);
            const valueChunk=values.slice(offset,offset+take);
            doc.setTextColor(111,107,102); this._setReportFont(doc,'body','normal'); doc.setFontSize(9);
            if(labelChunk.length) doc.text(labelChunk,M+7,y+12);
            doc.setTextColor(28,27,26); this._setReportFont(doc,'bodyBold','bold');
            if(valueChunk.length) doc.text(valueChunk,valueX,y+12);
            doc.setDrawColor(240,236,230); doc.setLineWidth(.6); doc.line(M,y+rowH,W-M,y+rowH);
            y+=rowH; offset+=take;
          }
        });
        y+=8;
      }

      const chips=Array.isArray(sec&&sec.chips)?sec.chips:[];
      if((sec&&sec.hasChips)||chips.length){
        drawSectionLabel('Elementos identificados');
        const chipGap=12,chipW=(W-M*2-chipGap)/2,lh=10.5;
        for(let i=0;i<chips.length;i+=2){
          const left=doc.splitTextToSize(String(chips[i]==null?'':chips[i]),chipW-22);
          const right=i+1<chips.length?doc.splitTextToSize(String(chips[i+1]==null?'':chips[i+1]),chipW-22):[];
          let lo=0,ro=0;
          while(lo<left.length||ro<right.length){
            let available=Math.floor((MAX_Y-y-13)/lh);
            if(available<1){ nextSectionPage(); available=Math.max(1,Math.floor((MAX_Y-y-13)/lh)); }
            const take=Math.min(Math.max(left.length-lo,right.length-ro),available);
            const leftChunk=left.slice(lo,lo+take),rightChunk=right.slice(ro,ro+take);
            const chipH=Math.max(29,14+Math.max(leftChunk.length,rightChunk.length,1)*lh);
            const drawChip=(lines,x)=>{
              doc.setFillColor(250,248,245); doc.setDrawColor(224,220,212); doc.roundedRect(x,y,chipW,chipH-5,8,8,'FD');
              doc.setTextColor(58,58,58); this._setReportFont(doc,'body','normal'); doc.setFontSize(8.5); doc.text(lines,x+11,y+14);
            };
            drawChip(leftChunk,M);
            if(right.length) drawChip(rightChunk,M+chipW+chipGap);
            y+=chipH; lo+=leftChunk.length; ro+=rightChunk.length;
          }
        }
      }
      if(sec&&sec.hasSubSections&&Array.isArray(sec.subSections)&&sec.subSections.length){
        y=this._pdfReportSubSections(doc,sec.subSections,{
          x:M,y:y+10,width:W-M*2,maxY:MAX_Y,landscape:true,
          newPage:()=>nextSectionPage(),
        });
      }
    });

    // Contraportada, índice de la página 2 y navegación interna en todos los folios.
    doc.addPage([960,540],'landscape');
    const backPage=doc.getNumberOfPages();
    this._pdfReportBack(doc,W,H,true,R);
    this._pdfReportIndex(doc,W,H,true,indexEntries,indexPage);
    this._pdfApplyReportFooters(doc,W,H,true,indexPage,backPage,folios);

    if(O.returnData) return {base64:doc.output('datauristring'),sizeBytes:doc.output('arraybuffer').byteLength};
    doc.save('DGMESNIE_reporte_territorial_16x9_'+new Date().toISOString().slice(0,10)+'.pdf');
    this._toast('Reporte PDF 16:9 exportado');
  }
  // Filas del análisis de zona (si se ejecutó) — alimentan Excel, PDF y PNG
  _anaRows(){
    const A=this.state.analysis;
    if(!this._hasCompletedReportAnalysis(A)) return [];
    const centroid=this._analysisCentroidFeature(A);
    const coordinates=centroid&&centroid.geometry&&centroid.geometry.coordinates;
    const centerLat=Array.isArray(coordinates)&&isFinite(coordinates[1])?Number(coordinates[1]):Number(A.lat);
    const centerLng=Array.isArray(coordinates)&&isFinite(coordinates[0])?Number(coordinates[0]):Number(A.lng);
    const rows=[
      ['Zona de análisis',A.targetLabel||A.estado||'—',''],
      ['Cobertura',this._analysisCoverageLabel(A,false),''],
      ['Superficie analizada',+(this._analysisAreaKm2(A)||0).toFixed(1),'km²'],
      ['Centroide de referencia',centerLat.toFixed(4)+', '+centerLng.toFixed(4),'']
    ];
    A.ranKeys.forEach(k=>{ const v=this.state.layers[k]; if(v) rows.push([v.label, v.count||0, 'elementos']); });
    return rows;
  }

  // Compone el mapa (tiles + capas vectoriales) en un canvas a alta resolución
  _captureMap(scale, overlays){
    const mapEl = this.mapRef.current; const w=mapEl.clientWidth, h=mapEl.clientHeight;
    const cv=document.createElement('canvas'); cv.width=Math.round(w*scale); cv.height=Math.round(h*scale);
    const ctx=cv.getContext('2d'); ctx.scale(scale,scale);
    ctx.fillStyle='#e8e4de'; ctx.fillRect(0,0,w,h);
    const base=mapEl.getBoundingClientRect();

    const drawImgEl = (img) => { if(!img.complete||!img.naturalWidth) return; const r=img.getBoundingClientRect(); try{ ctx.drawImage(img, r.left-base.left, r.top-base.top, r.width, r.height); }catch(e){} };
    const drawCanvasEl = (c) => { const r=c.getBoundingClientRect(); try{ ctx.drawImage(c, r.left-base.left, r.top-base.top, r.width, r.height); }catch(e){} };
    // Renderer vectorial (SVG) propio de un pane: hijo DIRECTO del pane, con viewBox de todo el mapa.
    const drawRendererSvg = (svg) => {
      const vb = svg.viewBox && svg.viewBox.baseVal; if(!vb || !vb.width) return;
      const r = svg.getBoundingClientRect();
      ctx.save(); ctx.translate(r.left-base.left - vb.x, r.top-base.top - vb.y);
      svg.querySelectorAll('path').forEach(p=>{
        const d=p.getAttribute('d'); if(!d) return;
        let path; try{ path=new Path2D(d); }catch(e){ return; }
        const st=p.getAttribute('stroke'), fl=p.getAttribute('fill');
        const sw=parseFloat(p.getAttribute('stroke-width')||'2');
        const so=parseFloat(p.getAttribute('stroke-opacity')||'1'), fo=parseFloat(p.getAttribute('fill-opacity')||'0');
        const dash=p.getAttribute('stroke-dasharray');
        try{
          if(fl && fl!=='none'){ ctx.globalAlpha=fo||0; ctx.fillStyle=fl; ctx.fill(path); }
          if(st && st!=='none'){ ctx.globalAlpha=so; ctx.strokeStyle=st; ctx.lineWidth=sw; if(dash) ctx.setLineDash(String(dash).split(/[ ,]+/).map(Number).filter(n=>!isNaN(n))); ctx.stroke(path); ctx.setLineDash([]); }
        }catch(e){}
        ctx.globalAlpha=1;
      });
      ctx.restore();
    };
    // Marcadores divIcon (datasets, pines con glifo): SVG anidado dentro del ícono del marcador.
    // Se redibuja su contenido completo vía Path2D para conservar la forma; si algo falla, cae al punto de color.
    const drawMarkerSvg = (svg) => {
      const r=svg.getBoundingClientRect();
      let drawn=false;
      try{
        const vb = svg.viewBox && svg.viewBox.baseVal;
        const sx = vb && vb.width ? r.width/vb.width : 1, sy = vb && vb.height ? r.height/vb.height : 1;
        ctx.save(); ctx.translate(r.left-base.left, r.top-base.top); ctx.scale(sx, sy);
        svg.querySelectorAll('path,rect,circle').forEach(el=>{
          // desplazamiento de <g transform="translate(x,y)"> (glifos internos)
          let ox=0, oy=0; const g=el.closest('g');
          if (g){ const tm=/translate\(([-\d.]+)[ ,]([-\d.]+)\)/.exec(g.getAttribute('transform')||''); if(tm){ ox=+tm[1]; oy=+tm[2]; } }
          // Los atributos de pintura pueden vivir en un <g> ancestro (glifos): se heredan hacia arriba
          const attr=(nm)=>{ let a=el; while(a && a.tagName && a.tagName.toLowerCase()!=='svg'){ if(a.getAttribute){ const v=a.getAttribute(nm); if(v!=null) return v; } a=a.parentNode; } return null; };
          const fl=attr('fill'), st=attr('stroke'), sw=parseFloat(attr('stroke-width')||'1.5');
          ctx.lineCap='round'; ctx.lineJoin='round';
          ctx.save(); ctx.translate(ox, oy);
          let p=null;
          if (el.tagName==='path'){ const d=el.getAttribute('d'); if(d){ try{ p=new Path2D(d); }catch(e){} } }
          else if (el.tagName==='rect'){ p=new Path2D(); const rx=parseFloat(el.getAttribute('rx')||'0'); const x0=+el.getAttribute('x')||0, y0=+el.getAttribute('y')||0, w0=+el.getAttribute('width')||0, h0=+el.getAttribute('height')||0; if(p.roundRect) p.roundRect(x0,y0,w0,h0,rx); else p.rect(x0,y0,w0,h0); }
          else if (el.tagName==='circle'){ p=new Path2D(); p.arc(+el.getAttribute('cx')||0, +el.getAttribute('cy')||0, +el.getAttribute('r')||0, 0, 7); }
          if (p){
            if (fl && fl!=='none'){ ctx.fillStyle=fl; ctx.fill(p); }
            if (st && st!=='none'){ ctx.strokeStyle=st; ctx.lineWidth=sw; ctx.stroke(p); }
            drawn=true;
          }
          ctx.restore();
        });
        ctx.restore();
      }catch(e){ try{ ctx.restore(); }catch(e2){} }
      if(!drawn){ const fill=(svg.querySelector('[fill]')||{}).getAttribute && svg.querySelector('[fill]').getAttribute('fill'); ctx.beginPath(); ctx.fillStyle=fill||'#9B2247'; ctx.strokeStyle='#fff'; ctx.lineWidth=1.5; ctx.arc(r.left-base.left+r.width/2, r.top-base.top+r.height/2, 6, 0, 7); ctx.fill(); ctx.stroke(); }
    };

    // Recorre TODOS los panes de Leaflet respetando su z-index REAL (no el orden del DOM):
    // gerencias/estados/líneas comparten el pane por defecto (overlayPane, z-index 400) mientras
    // que municipios (410), subestaciones/datasets (data, 430) y otras capas del inventario (genvec,
    // 449) viven en panes propios. Dibujar por orden de documento hacía que los polígonos (con
    // relleno) tapa­ran los puntos/líneas al rasterizar, aunque en pantalla sí se veían por encima.
    const mapPane = mapEl.querySelector('.leaflet-map-pane');
    const panes = mapPane
      ? Array.from(mapPane.children).filter(el => el.classList && el.classList.contains('leaflet-pane'))
      : [];
    panes.sort((a,b) => (parseFloat(getComputedStyle(a).zIndex)||0) - (parseFloat(getComputedStyle(b).zIndex)||0));
    panes.forEach(pane => {
      pane.querySelectorAll('img').forEach(drawImgEl);
      pane.querySelectorAll('canvas').forEach(drawCanvasEl);
      pane.querySelectorAll('svg').forEach(svg => {
        // El renderer vectorial del pane es su hijo DIRECTO; los íconos de marcador (divIcon)
        // quedan anidados un nivel más adentro, dentro del wrapper del marcador.
        if (svg.parentElement === pane) drawRendererSvg(svg); else drawMarkerSvg(svg);
      });
    });

    // Pin de la zona de análisis (divIcon HTML — se dibuja a mano, siempre encima de las capas de datos)
    const A=this.state.analysis;
    if(A && A.lat && this._anaMarker){
      try{
        const p=this.map.latLngToContainerPoint([A.lat, A.lng]);
        ctx.beginPath(); ctx.fillStyle='#9B2247'; ctx.strokeStyle='#fff'; ctx.lineWidth=2;
        ctx.moveTo(p.x-7,p.y-14); ctx.lineTo(p.x+7,p.y-14); ctx.lineTo(p.x,p.y); ctx.closePath(); ctx.fill(); ctx.stroke();
        ctx.beginPath(); ctx.arc(p.x,p.y-20,9,0,7); ctx.fill(); ctx.stroke();
        ctx.beginPath(); ctx.fillStyle='#fff'; ctx.arc(p.x,p.y-20,3.5,0,7); ctx.fill();
      }catch(e){}
    }
    if(overlays) this._drawOverlays(ctx, w, h, overlays);
    // Marca de agua opcional: logo SENER + fecha (esquina inferior izquierda, translúcida)
    if (this.state.wmOn) {
      try {
        ctx.save(); ctx.globalAlpha = .55;
        const l = this._logo && this._logo.sener;
        let x = 12;
        if (l && l.img) { const lh = 26, lw = lh*(l.w/l.h); ctx.drawImage(l.img, x, h-lh-10, lw, lh); x += lw + 10; }
        ctx.globalAlpha = .7; ctx.fillStyle = '#1c1b1a'; ctx.font = "600 11px 'Libre Franklin',sans-serif"; ctx.textBaseline = 'alphabetic';
        ctx.fillText('Secretaría de Energía · '+new Date().toLocaleDateString('es-MX'), x, h-16);
        ctx.restore();
      } catch(e){}
    }
    return cv;
  }
  _mapDataUrl(scale, overlays){ try{ return this._captureMap(scale, overlays).toDataURL('image/png'); }catch(e){ return null; } }
  // Coloca el mapa preservando su proporción real (object-fit:contain) dentro de [x,y,maxW,maxH].
  // Devuelve la altura realmente usada (para fluir el contenido). Centra horizontalmente.
  _fitMap(doc, x, y, maxW, maxH, overlays){
    let cv; try{ cv=this._captureMap(2, overlays); }catch(e){ return 0; }
    const url=cv.toDataURL('image/png'); const ar=cv.width/cv.height;
    let w=maxW, h=w/ar; if(h>maxH){ h=maxH; w=h*ar; }
    const px=x+(maxW-w)/2;
    doc.addImage(url,'PNG',px,y,w,h); doc.setDrawColor(236,232,226); doc.setLineWidth(1); doc.rect(px,y,w,h);
    return h;
  }
  _pdfReportThematicMap(doc,section,cfg){
    const dataUrl=section&&section.mapDataUrl;
    if(!dataUrl) return cfg.y;
    const aspect=Number(section.mapAspect)||1.84;
    let width=cfg.width,height=width/aspect;
    if(height>cfg.maxHeight){ height=cfg.maxHeight; width=height*aspect; }
    const x=cfg.x+(cfg.width-width)/2;
    try{
      doc.addImage(dataUrl,'PNG',x,cfg.y,width,height,undefined,'FAST');
      doc.setDrawColor(226,220,212); doc.setLineWidth(.8); doc.rect(x,cfg.y,width,height);
    }catch(e){ return cfg.y; }
    let y=cfg.y+height+8;
    const caption=String(section.mapCaption||'').trim();
    if(caption){
      doc.setTextColor(111,107,102); this._setReportFont(doc,'body','italic'); doc.setFontSize(cfg.landscape?7.8:7.2);
      const lines=doc.splitTextToSize(caption,cfg.width);
      doc.text(lines,cfg.x,y);
      y+=lines.length*(cfg.landscape?9:8.3)+9;
    }
    return y;
  }

  // ── helpers de dibujo en canvas ──
  _rr(ctx,x,y,w,h,r){ if(ctx.roundRect){ ctx.beginPath(); ctx.roundRect(x,y,w,h,r); } else { ctx.beginPath(); ctx.moveTo(x+r,y); ctx.arcTo(x+w,y,x+w,y+h,r); ctx.arcTo(x+w,y+h,x,y+h,r); ctx.arcTo(x,y+h,x,y,r); ctx.arcTo(x,y,x+w,y,r); ctx.closePath(); } }
  _panel(ctx,x,y,w,h){ ctx.save(); ctx.shadowColor='rgba(0,0,0,.18)'; ctx.shadowBlur=12; ctx.shadowOffsetY=3; this._rr(ctx,x,y,w,h,10); ctx.fillStyle='#fff'; ctx.fill(); ctx.restore(); this._rr(ctx,x,y,w,h,10); ctx.strokeStyle='#ECE8E2'; ctx.lineWidth=1; ctx.stroke(); }
  _clip(ctx,t,maxW){ t=String(t); if(ctx.measureText(t).width<=maxW) return t; while(t.length>1 && ctx.measureText(t+'…').width>maxW) t=t.slice(0,-1); return t+'…'; }
  // Dibuja sobre el PNG los paneles elegidos (leyenda / métricas / detalle)
  _drawOverlays(ctx,w,h,inc){
    const FS="'Noto Sans',system-ui,sans-serif", SE="'Patria',Georgia,serif";
    ctx.textBaseline='alphabetic'; ctx.textAlign='left';
    // Crédito de fuente (siempre) — pastilla centro-superior
    const src='Fuente: Dirección General de Metodología y Estadísticas del SNIE (DGMESNIE)';
    ctx.font='600 9.5px '+FS; const tw=ctx.measureText(src).width, pwS=tw+24, xS=(w-pwS)/2;
    this._panel(ctx,xS,12,pwS,24); ctx.fillStyle='#6F6B66'; ctx.textAlign='left'; ctx.fillText(src, xS+12, 28);
    if(inc.detail && this.state.selected){
      const sel=this.state.selected, pw=250, rows=sel.rows.slice(0,9), ph=58+rows.length*18, x=14, y=14;
      this._panel(ctx,x,y,pw,ph);
      ctx.fillStyle=sel.color; ctx.font='700 9px '+FS; ctx.fillText('● '+sel.kicker.toUpperCase(), x+14, y+22);
      ctx.fillStyle='#1c1b1a'; ctx.font='600 15px '+SE; ctx.fillText(this._clip(ctx,sel.name,pw-28), x+14, y+42);
      let ry=y+64;
      rows.forEach(r=>{ ctx.fillStyle='#9A958E'; ctx.font='600 9.5px '+FS; ctx.textAlign='left'; ctx.fillText(String(r[0]), x+14, ry);
        ctx.fillStyle='#1c1b1a'; ctx.font='600 10.5px '+FS; ctx.textAlign='right'; ctx.fillText(this._clip(ctx,String(r[1]),118), x+pw-14, ry); ry+=18; });
      ctx.textAlign='left';
    }
    if(inc.legend){
      const items=this.LAYERS.filter(c=>this.state.layers[c.key].on).map(c=>({label:this.state.layers[c.key].label,color:c.color,count:this.state.layers[c.key].count}));
      const kv=this.state.layers.lineas.on||this.state.layers.subestaciones.on||
        (this.state.layers.red_lineas&&this.state.layers.red_lineas.on);
      const pw=218, rowsN=items.length+(kv?this.KV_COLORS.length+1:0), ph=30+rowsN*16+10, x=w-pw-14, y=14;
      this._panel(ctx,x,y,pw,ph);
      ctx.fillStyle='#9B2247'; ctx.font='800 9px '+FS; ctx.fillText('LEYENDA · CAPAS ACTIVAS', x+14, y+22);
      let ry=y+40;
      items.forEach(it=>{ ctx.fillStyle=it.color; this._rr(ctx,x+14,ry-9,11,11,3); ctx.fill(); ctx.fillStyle='#3a3a3a'; ctx.font='600 10px '+FS; ctx.textAlign='left'; ctx.fillText(this._clip(ctx,it.label,135),x+32,ry); ctx.fillStyle='#9A958E'; ctx.font='600 9px '+FS; ctx.textAlign='right'; ctx.fillText((it.count||0).toLocaleString('es-MX'),x+pw-14,ry); ry+=16; });
      ctx.textAlign='left';
      if(kv){ ry+=2; ctx.fillStyle='#9B2247'; ctx.font='800 8.5px '+FS; ctx.fillText('TENSIÓN (kV)',x+14,ry); ry+=15;
        this.KV_COLORS.forEach(c=>{
          if(c.color==='#FFFFFF'){ctx.strokeStyle='#8A9099';ctx.lineWidth=5;ctx.beginPath();ctx.moveTo(x+14,ry-4);ctx.lineTo(x+32,ry-4);ctx.stroke();}
          ctx.strokeStyle=c.color;ctx.lineWidth=3;ctx.beginPath();ctx.moveTo(x+14,ry-4);ctx.lineTo(x+32,ry-4);ctx.stroke();
          ctx.fillStyle='#3a3a3a';ctx.font='500 9.5px '+FS;ctx.fillText(c.label,x+40,ry);ry+=15;
        }); }
    }
    if(inc.metrics){
      const mr=this._metricRows(), accents=['#9B2247','#E0A12E','#1E9CB8','#0E8A6E','#C0552E','#9AAE3B'];
      const ph=66, x=14, y=h-ph-12, pw=w-28;
      this._panel(ctx,x,y,pw,ph);
      ctx.fillStyle='#0E8A6E'; ctx.font='800 8.5px '+FS; ctx.textAlign='left'; ctx.fillText('CÁLCULOS Y MÉTRICAS · '+this.state.scope.toUpperCase(), x+14, y+17);
      const n=mr.length, gap=10, cardW=(pw-28-(n-1)*gap)/n;
      mr.forEach((row,i)=>{ const cx=x+14+i*(cardW+gap), cy=y+25;
        ctx.fillStyle=accents[i%6]; ctx.fillRect(cx,cy,3,30);
        ctx.fillStyle='#6F6B66'; ctx.font='600 8px '+FS; ctx.fillText(this._clip(ctx,String(row[0]).toUpperCase(),cardW-12),cx+9,cy+10);
        ctx.fillStyle='#1c1b1a'; ctx.font='600 16px '+SE; const val=(typeof row[1]==='number'?row[1].toLocaleString('es-MX'):String(row[1]))+(row[2]?' '+row[2]:''); ctx.fillText(this._clip(ctx,val,cardW-12),cx+9,cy+28); });
    }
  }

  // PNG: abre el modal de opciones (qué sobreponer)
  exportPNG = () => this.setState({ exportOpen:false, pngAsk:true });
  closePng = () => this.setState({ pngAsk:false });
  setPngInc = (k) => this.setState({ pngInc:{ ...this.state.pngInc, [k]: !this.state.pngInc[k] } });
  doExportPNG = () => {
    this.setState({ pngAsk:false });
    let cv; try{ cv=this._captureMap(2.5, this.state.pngInc); }catch(e){}
    let url=null; try{ url = cv && cv.toDataURL('image/png'); }catch(e){ url=null; }
    if(!url){ this._toast('El mapa satélite no permite exportar PNG (CORS). Cambia a Claro u Oscuro.'); return; }
    this._download(url, 'mapa_planeacion_energetica.png');
    this._toast('PNG de alta resolución exportado');
  };

  // PDF en dos versiones: carta (reporte) o presentación 16:9 (PowerPoint)
  exportPDF = (mode) => {
    this.closeExport();
    if(!window.jspdf){ this._toast('Preparando módulo PDF…'); return; }
    const { jsPDF }=window.jspdf;
    if(mode==='present') return this._pdfPresent(jsPDF);
    return this._pdfLetter(jsPDF);
  };
  _clipText(doc,t,maxW){ t=String(t); if(doc.getTextWidth(t)<=maxW) return t; while(t.length>1 && doc.getTextWidth(t+'…')>maxW) t=t.slice(0,-1); return t+'…'; }
  _pdfFooter(doc, W, H, landscape, page, total){
    const pad = landscape ? 40 : 46;
    const fy = H - (landscape ? 16 : 18);
    const lineY = fy - (landscape ? 10 : 11);
    doc.setDrawColor(236,232,226); doc.setLineWidth(.9); doc.line(pad, lineY, W-pad, lineY);
    doc.setTextColor(154,149,142); doc.setFont('helvetica','normal'); doc.setFontSize(landscape ? 7.5 : 7.2);
    doc.text('gob.mx/sener · DGMESNIE · CENACE · CFE · Cifras sujetas a verificación en campo', pad, fy);
    doc.setFont('helvetica','bold');
    doc.text('Página '+page+' de '+total, W-pad, fy, { align:'right' });
  }
  _pdfApplyFooters(doc, W, H, landscape, skipPages){
    const total = doc.getNumberOfPages();
    const skip = new Set(skipPages || []);
    for(let p=1; p<=total; p++){
      if (skip.has(p)) continue;
      doc.setPage(p);
      this._pdfFooter(doc, W, H, landscape, p, total);
    }
  }

  // Precarga logos institucionales como dataURL (para portada/contraportada del PDF)
  _preloadLogos = () => {
    this._logo = {};
    const load = (key, src, fmt) => { const im = new Image(); im.onload = () => { try { const c=document.createElement('canvas'); c.width=im.naturalWidth; c.height=im.naturalHeight; c.getContext('2d').drawImage(im,0,0); this._logo[key]={ url:c.toDataURL(fmt||'image/png'), w:im.naturalWidth, h:im.naturalHeight, img:im }; } catch(e){ this._logo[key]={ img:im, w:im.naturalWidth, h:im.naturalHeight }; } }; im.src=src; };
    load('gob','/tablero/assets/logo_gob.png');
    load('sener','/tablero/assets/logo_sener.png');
    load('portada','/tablero/assets/portada_energia.png','image/jpeg'); // imagen de portada aportada por el usuario (eólica + presa + solar)
    load('anexos','/tablero/assets/reno_anexos.png','image/jpeg');
    load('pamWoman','/img/pamrnt/mujer.png');
  };
  // Dibuja una imagen con recorte object-fit:cover dentro de [x,y,w,h] (sin deformar ni desbordar)
  _drawImageCover(doc, key, x, y, w, h){
    const l = this._logo && this._logo[key]; if (!l || !l.img) return false;
    try {
      const sc = 2; const cw = Math.round(w*sc), ch = Math.round(h*sc);
      const c = document.createElement('canvas'); c.width=cw; c.height=ch; const ctx=c.getContext('2d');
      const ir = l.img.naturalWidth/l.img.naturalHeight, br = w/h;
      let sw, sh, sx, sy;
      if (ir > br) { sh = l.img.naturalHeight; sw = sh*br; sx = (l.img.naturalWidth-sw)/2; sy = 0; }
      else { sw = l.img.naturalWidth; sh = sw/br; sx = 0; sy = (l.img.naturalHeight-sh)/2; }
      ctx.drawImage(l.img, sx, sy, sw, sh, 0, 0, cw, ch);
      doc.addImage(c.toDataURL('image/jpeg',0.92), 'JPEG', x, y, w, h);
      return true;
    } catch(e){ return false; }
  }
  // Encabezado de logos institucionales (gob · divisoria · sener)
  _pdfLogos(doc, x, y, h){
    const w1 = this._logoImg(doc,'gob', x, y, h, 'left');
    if (w1){ const dvx = x + w1 + 16; doc.setDrawColor(224,220,212); doc.setLineWidth(1); doc.line(dvx, y+3, dvx, y+h-3); this._logoImg(doc,'sener', dvx+16, y, h, 'left'); }
    else this._logoImg(doc,'sener', x, y, h, 'left');
  }
  _logoImg(doc, key, x, y, h, align){ const l=this._logo&&this._logo[key]; if(!l) return 0; const w=h*(l.w/l.h); const px = align==='right' ? x-w : (align==='center' ? x-w/2 : x); doc.addImage(l.url,'PNG',px,y,w,h); return w; }

  // PORTADA institucional (ambos modos). W,H en pt; landscape=true para 16:9
  // Página de título estilo Sistema de Diseño SENER (portada / contraportada)
  // Estructura: logos · kicker · título serif · identificador + filete dorado + subtítulo · imagen a sangre · pie de 3 columnas
  _pdfTitlePage = (doc, W, H, landscape, o) => {
    const pad = landscape ? 52 : 44;
    doc.setFillColor(255,255,255); doc.rect(0,0,W,H,'F');
    // Logos institucionales
    const logoH = landscape ? 30 : 28; const topY = landscape ? 46 : 48;
    this._pdfLogos(doc, pad, topY, logoH);
    // Kicker (mayúsculas, tracking amplio, guinda)
    let y = topY + logoH + (landscape ? 40 : 36);
    doc.setTextColor(155,34,71);
    if(doc._reportFonts) this._setReportFont(doc,'kicker','bold'); else doc.setFont('helvetica','bold');
    doc.setFontSize(landscape ? 11 : 9.5);
    doc.setCharSpace(landscape ? 1.8 : 1.4);
    doc.text(this._clipText(doc, o.kicker, W - pad*2), pad, y);
    doc.setCharSpace(0);
    // Título display (serif)
    doc.setTextColor(28,27,26);
    if(doc._reportFonts) this._setReportFont(doc,'title','bold'); else doc.setFont('times','normal');
    doc.setFontSize(landscape ? 44 : 36);
    const tLines = doc.splitTextToSize(o.title, landscape ? W*0.74 : W - pad*2);
    y += landscape ? 46 : 40; doc.text(tLines, pad, y); y += tLines.length*(landscape ? 44 : 37);
    // Identificador serif guinda + filete dorado + subtítulo
    y += landscape ? 8 : 6;
    if(doc._reportFonts) this._setReportFont(doc,'title','normal'); else doc.setFont('times','normal');
    doc.setTextColor(155,34,71); doc.setFontSize(landscape ? 27 : 23);
    doc.text(o.idText, pad, y);
    const idW = doc.getTextWidth(o.idText);
    doc.setFillColor(224,161,46); doc.rect(pad + idW + 18, y - (landscape ? 8 : 7), landscape ? 76 : 64, landscape ? 3 : 2.6, 'F');
    const subX = pad + idW + 18 + (landscape ? 76 : 64) + 16;
    if(doc._reportFonts) this._setReportFont(doc,'body','normal'); else doc.setFont('helvetica','normal');
    doc.setTextColor(111,107,102); doc.setFontSize(landscape ? 11 : 10);
    doc.text(doc.splitTextToSize(o.subtitle, W - subX - pad), subX, y - 1);
    // Imagen a sangre (banda inferior) con filete dorado superior
    const hasResponsible=!!o.responsible;
    const footH = hasResponsible ? (landscape ? 92 : 112) : (landscape ? 58 : 70);
    const imgY = y + (landscape ? 24 : 28);
    const imgH = (H - footH) - imgY;
    if (imgH > 40) {
      const ok = this._drawImageCover(doc, o.imgKey, pad, imgY, W - pad*2, imgH);
      if (ok) { doc.setFillColor(224,161,46); doc.rect(pad, imgY, W - pad*2, 4, 'F'); }
      else { doc.setFillColor(155,34,71); doc.rect(pad, imgY, W - pad*2, imgH, 'F'); doc.setFillColor(224,161,46); doc.rect(pad, imgY, W - pad*2, 4, 'F'); }
    }
    // Unidad responsable a todo lo ancho + pie de 3 columnas.
    const footTop=H-footH;
    if(hasResponsible){
      const ry=footTop+(landscape?15:17);
      doc.setTextColor(154,149,142);
      if(doc._reportFonts) this._setReportFont(doc,'bodyBold','bold'); else doc.setFont('helvetica','bold');
      doc.setCharSpace(.8); doc.setFontSize(landscape?7.5:7.2);
      doc.text('UNIDAD RESPONSABLE',pad,ry); doc.setCharSpace(0);
      doc.setTextColor(28,27,26);
      if(doc._reportFonts) this._setReportFont(doc,'body','normal'); else doc.setFont('helvetica','normal');
      doc.setFontSize(landscape?9.2:8.5);
      doc.text(doc.splitTextToSize(String(o.responsible),W-pad*2),pad,ry+(landscape?13:12));
    }
    // Pie de 3 columnas (etiqueta gris-claro + valor)
    const fy = footTop + (hasResponsible ? (landscape?62:78) : (landscape?24:28)); const colW = (W - pad*2)/3;
    o.cols.forEach((c,i) => { const cx = pad + i*colW;
      doc.setTextColor(154,149,142);
      if(doc._reportFonts) this._setReportFont(doc,'bodyBold','bold'); else doc.setFont('helvetica','bold');
      doc.setCharSpace(1); doc.setFontSize(landscape ? 8.5 : 8);
      doc.text(String(c[0]).toUpperCase(), cx, fy); doc.setCharSpace(0);
      doc.setTextColor(28,27,26);
      if(doc._reportFonts) this._setReportFont(doc,'bodyBold','bold'); else doc.setFont('helvetica','bold');
      doc.setFontSize(landscape ? 11 : 10.5);
      doc.text(this._clipText(doc, String(c[1]), colW - 12), cx, fy + (landscape ? 15 : 14));
    });
  };

  _pdfCover = (doc, W, H, landscape) => {
    this._pdfTitlePage(doc, W, H, landscape, {
      kicker: 'SUBSECRETARÍA DE PLANEACIÓN Y TRANSICIÓN ENERGÉTICA',
      title: 'Dashboard de Planeación Energética',
      idText: 'Reporte ejecutivo',
