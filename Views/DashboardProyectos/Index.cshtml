  _loadDemandWeather(region){
    const name=String(region||'').trim();
    if(!name||this._isNationalDemandRegion(name)){
      this._demandWeatherRequestId=(this._demandWeatherRequestId||0)+1;
      this.setState({
        marketWeatherData:null,
        marketWeatherRegion:'',
        marketWeatherLoading:false
      });
      return Promise.resolve(null);
    }
    this._marketWeatherCache=this._marketWeatherCache||new Map();
    if(this._marketWeatherCache.has(name)){
      const cached=this._marketWeatherCache.get(name);
      this.setState({
        marketWeatherData:cached,
        marketWeatherRegion:name,
        marketWeatherLoading:false
      });
      return Promise.resolve(cached);
    }
    const requestId=(this._demandWeatherRequestId||0)+1;
    this._demandWeatherRequestId=requestId;
    this.setState({marketWeatherLoading:true});
    return fetch('/DashboardProyectos/AtlasSen/Clima?region='+encodeURIComponent(name),{cache:'no-store'})
      .then(response=>{
        if(!response.ok) throw new Error('HTTP '+response.status);
        return response.json();
      })
      .then(data=>{
        if(this._demandWeatherRequestId!==requestId) return null;
        this._marketWeatherCache.set(name,data);
        this.setState({
          marketWeatherData:data,
          marketWeatherRegion:name,
          marketWeatherLoading:false
        });
        return data;
      })
      .catch(error=>{
        if(this._demandWeatherRequestId===requestId){
          this.setState({
            marketWeatherData:null,
            marketWeatherRegion:name,
            marketWeatherLoading:false
          });
        }
        return null;
      });
  }
