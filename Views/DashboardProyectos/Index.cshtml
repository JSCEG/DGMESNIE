    doc.roundedRect(x,y,size,size,5,5,'FD');
    doc.setFillColor(28,27,26);
    cells.forEach((row,r)=>row.split('').forEach((on,c)=>{
      if(on==='1') doc.rect(x+pad+c*(cell+gap),y+pad+r*(cell+gap),cell,cell,'F');
    }));
