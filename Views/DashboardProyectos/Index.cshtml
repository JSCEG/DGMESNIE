      console.error('Error al enviar reporte:', e);
      this._setReportSendFeedback('Error: ' + (e.message || e), 'error');
    } finally {
      this.setState({ reportSendBusy:false });
    }
  }
  _exportTerritorialPDF = async (fmt) => {
