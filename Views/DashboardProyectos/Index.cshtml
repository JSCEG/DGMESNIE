      subtitle:(evaluationLabels[kind]||evaluationLabels.point)+' · '+shortLabel,
      eyebrow:(evaluationLabels[kind]||evaluationLabels.point)+' · '+shortLabel
    };
  }

  _buildElectricReportCharts(A, ran, feats){
    const charts=[];
    if(ran('centrales')){
      const centralItems=feats('centrales');
      if(centralItems.length){
        const grouped={};
        centralItems.forEach(item=>{
          const props=(item&&item.props)||{};
          const code=this._centralTech(props);
          const label=this._techFull(code);
          const cap=this._centralCapacity(props);
          if(!grouped[code]) grouped[code]={label,color:this._tecColor(code),count:0,capacity:0,capacityCount:0};
          grouped[code].count++;
          if(cap!=null){ grouped[code].capacity+=cap; grouped[code].capacityCount++; }
        });
        const groups=Object.values(grouped);
        const hasCapacity=groups.some(group=>group.capacityCount>0);
        let data=groups.map(group=>({
          label:group.label,
          value:hasCapacity?group.capacity:group.count,
          color:group.color,
          detail:group.count+' '+(group.count===1?'central':'centrales'),
        })).sort((a,b)=>b.value-a.value);
        if(data.length>6){
          const rest=data.slice(5);
          data=data.slice(0,5).concat([{
            label:'Otras tecnologías',
            value:rest.reduce((sum,item)=>sum+item.value,0),
            color:'#8A9099',
            detail:rest.length+' categorías adicionales',
          }]);
        }
        charts.push({
          key:'generation-profile',
          title:hasCapacity?'Capacidad por tecnología':'Centrales por tecnología',
          subtitle:centralItems.length+' '+(centralItems.length===1?'central identificada':'centrales identificadas')+' dentro de la cobertura analizada.',
          unit:hasCapacity?'MW':'centrales',
          decimals:hasCapacity?1:0,
          data,
          source:'Fuente: SENER · Inventario DGMESNIE',
        });
      }
    }

    if(ran('red_se_transmision')||ran('red_se_distribucion')){
      const uniqueSubstations=new Map();
      ['red_se_transmision','red_se_distribucion'].filter(ran).forEach(key=>{
        (this._reportAnalysisLayerGeo(key).features||[]).forEach((feature,index)=>{
          const p=(feature&&feature.properties)||{};
          const coordinates=(feature&&feature.geometry&&feature.geometry.coordinates)||[];
          const id=String(p.universe_key||p.node_id||p.record_key||key+':'+index);
          if(!uniqueSubstations.has(id)){
            uniqueSubstations.set(id,{
              kv:Number(p.voltage_kv)||0,
              props:p,
              lat:Number(coordinates[1]),
              lng:Number(coordinates[0])
            });
          }
        });
      });
      const subItems=[...uniqueSubstations.values()];
      if(subItems.length){
        const buckets=[
          {label:'Menor a 115 kV',color:'#C0552E',value:0},
          {label:'115 a 229 kV',color:'#E0A12E',value:0},
          {label:'230 a 399 kV',color:'#2E6FB0',value:0},
          {label:'400 kV o más',color:'#9B2247',value:0},
          {label:'Sin dato de tensión',color:'#8A9099',value:0},
        ];
        subItems.forEach(sub=>{
          const kv=Number(sub&&sub.kv);
          const bucket=!Number.isFinite(kv)||kv<=0?buckets[4]:(kv<115?buckets[0]:(kv<230?buckets[1]:(kv<400?buckets[2]:buckets[3])));
          bucket.value++;
        });
        charts.push({
          key:'substation-voltage',
          title:'Subestaciones por nivel de tensión',
          subtitle:subItems.length+' '+(subItems.length===1?'subestación identificada':'subestaciones identificadas')+' dentro de la cobertura analizada.',
          unit:'subestaciones',
          decimals:0,
          data:buckets.filter(bucket=>bucket.value>0),
          source:'Fuente: SENER · DGMESNIE',
        });
      }
    }

    return charts.map(chart=>({
      ...chart,
      alt:'Gráfica de '+chart.title.toLowerCase(),
      svgDataUrl:this._reportChartSvg(chart),
    }));
  }

  _buildEnergyPermitReport(A,ran,feats){
    const definitions=[
      {key:'perm_elec',label:'Electricidad',color:'#9B2247'},
      {key:'perm_gn',label:'Gas natural',color:'#2E6FB0'},
      {key:'perm_glp',label:'Gas LP',color:'#E0A12E'},
      {key:'perm_pet',label:'Petrolíferos',color:'#C0552E'},
    ];
    const defs=definitions.filter(def=>ran(def.key));
    if(!defs.length) return {sections:[],charts:[],raw:[]};
    const value=(p,camel,pascal)=>p&&p[camel]!=null?p[camel]:(p&&p[pascal]!=null?p[pascal]:null);
    const formatDate=raw=>{
      if(!raw) return '—';
      const parsed=new Date(raw);
      return Number.isNaN(parsed.getTime())?String(raw):parsed.toLocaleDateString('es-MX');
    };
    const raw=defs.map(def=>({
      key:def.key,label:def.label,
      meta:(this._analysisSourceMeta||{})[def.key]||{},
      rows:feats(def.key).map(item=>{
        const feature=item&&item.geometry
          ?{type:'Feature',properties:item.props||{},geometry:item.geometry}
          :(item&&isFinite(item.lat)&&isFinite(item.lng)
            ?{type:'Feature',properties:item.props||{},geometry:{type:'Point',coordinates:[Number(item.lng),Number(item.lat)]}}
            :null);
        return {
          ...(item&&item.props||{}),
          distanciaCentroideKm:feature?this._distanceFromAnalysisCentroidKm(A,feature):null
        };
      })
    }));
    const groupDefinitions=[
      {
        key:'permits-electricity',
        sourceKeys:['perm_elec'],
        kicker:'Sistema eléctrico autorizado',
        color:'#9B2247',
        title:'Permisos eléctricos y perfil autorizado',
        chartTitle:'Permisos eléctricos por tipo',
        intro:'Permisos eléctricos contenidos en la cobertura, desglosados por modalidad o clasificación y vinculados con la red, subestaciones y centrales del territorio.'
      },
      {
        key:'permits-gas',
        sourceKeys:['perm_gn','perm_glp'],
        kicker:'Gas natural y Gas LP',
        color:'#2E6FB0',
        title:'Permisos de gas natural y Gas LP',
        chartTitle:'Permisos de gas por tipo',
        intro:'Permisos de gas natural y Gas LP contenidos en la cobertura. El mapa integra ductos disponibles y puntos autorizados, conservando simbología distinta por mercado.'
      },
      {
        key:'permits-petroleum',
        sourceKeys:['perm_pet'],
        kicker:'Petrolíferos',
        color:'#C0552E',
        title:'Permisos de petrolíferos y estaciones de servicio',
        chartTitle:'Permisos de petrolíferos por tipo',
        intro:'Permisos de expendio, almacenamiento, distribución y autoconsumo contenidos en la cobertura. Cuando existe correspondencia oficial, se incorporan precios reportados por estación de servicio.'
      }
    ];
    const sections=[],charts=[];
    groupDefinitions.forEach(group=>{
      const sources=raw.filter(source=>group.sourceKeys.includes(source.key));
      if(!sources.length) return;
      const rows=sources.map(source=>{
        const meta=source.meta||{};
        const cutoff=meta.fechaCorte||meta.FechaCorte;
        return [
          source.label,
          source.rows.length.toLocaleString('es-MX')+' en la cobertura'+(cutoff?' · corte '+formatDate(cutoff):'')
        ];
      });
      const detail=sources.flatMap(source=>source.rows.map(p=>({source,p})))
        .sort((a,b)=>{
          const da=new Date(value(a.p,'fechaOtorgamiento','FechaOtorgamiento')||0).getTime()||0;
          const db=new Date(value(b.p,'fechaOtorgamiento','FechaOtorgamiento')||0).getTime()||0;
          return db-da;
        });
      const tableRows=detail.slice(0,20).map(({source,p})=>{
        const cap=value(p,'capacidad','Capacidad');
        const unit=value(p,'unidadCapacidad','UnidadCapacidad')||'';
        const capText=value(p,'capacidadTexto','CapacidadTexto')||'';
        return [
          source.label,
          value(p,'numeroPermiso','NumeroPermiso')||'—',
          String(value(p,'nombre','Nombre')||'—').slice(0,44),
          value(p,'tipoPermiso','TipoPermiso')||value(p,'clasificacion','Clasificacion')||'—',
          cap!=null?Number(cap).toLocaleString('es-MX',{maximumFractionDigits:2})+(unit?' '+unit:''):(capText||'—'),
          p.distanciaCentroideKm!=null&&Number.isFinite(Number(p.distanciaCentroideKm))
            ?Number(p.distanciaCentroideKm).toLocaleString('es-MX',{minimumFractionDigits:1,maximumFractionDigits:1})+' km'
            :'—',
          formatDate(value(p,'fechaOtorgamiento','FechaOtorgamiento'))
        ];
      });
      if(detail.length>20) tableRows.push(['… y '+(detail.length-20).toLocaleString('es-MX')+' permisos más','Ver Excel','','','','','']);
      const counts=new Map();
      detail.forEach(({source,p})=>{
        const label=this._reportPermitLegendLabel(source.key,p);
        const entry=counts.get(this._norm(label))||{label,value:0,color:(definitions.find(def=>def.key===source.key)||{}).color||group.color};
        entry.value++;
        counts.set(this._norm(label),entry);
      });
      let chartData=[...counts.values()].sort((a,b)=>b.value-a.value);
      if(chartData.length>6){
        const others=chartData.slice(5);
        chartData=chartData.slice(0,5).concat([{
          label:'Otros tipos',
          value:others.reduce((sum,item)=>sum+item.value,0),
          color:'#8A9099'
        }]);
      }
      const chart=chartData.length?{
        key:group.key+'-types',
        group:'energy-permits',
        title:group.chartTitle,
        subtitle:detail.length.toLocaleString('es-MX')+' permisos intersectan la cobertura analizada.',
        unit:'permisos',
        decimals:0,
        data:chartData.map(item=>({...item,detail:'permisos dentro de la cobertura'})),
        source:'Fuente: CRE · Inventarios institucionales DGMESNIE'
      }:null;
      const reportChart=chart?{
        ...chart,
        alt:'Gráfica de '+group.chartTitle.toLowerCase(),
        svgDataUrl:this._reportChartSvg(chart)
      }:null;
      const section={
        key:group.key,kicker:group.kicker,color:group.color,
        icon:'M13 2 3 14h7l-1 8 10-12h-7z',
        title:group.title,
        intro:group.intro,
        hasRows:true,rows,hasChips:false,chips:[],
        hasCharts:!!reportChart,charts:reportChart?[reportChart]:[],
        hasTable:tableRows.length>0,
        table:{head:['Mercado','Permiso','Titular / instalación','Tipo','Capacidad','Dist. al centroide','Otorgamiento'],rows:tableRows},
        hasTable2:false,
        source:'CRE · Inventarios institucionales DGMESNIE'
      };
      sections.push(section);
      if(reportChart) charts.push(reportChart);
    });
    return {sections,charts,raw};
  }

  async _loadDemandReportContext(A){
    const ranKeys=Array.isArray(A&&A.ranKeys)?A.ranKeys:[];
    if(!ranKeys.includes('demanda_atlas')) return null;
    let data=this.state.demandMarketData;
    if(!data||!data.regions){
      const response=await fetch('/DashboardProyectos/AtlasSen/Demanda?hourly=true',{cache:'no-store'});
      if(!response.ok) throw new Error('HTTP '+response.status);
      data=await response.json();
    }
    const available=data&&data.regions?Object.keys(data.regions):[];
    if(!available.length) return null;
    const matched=[];
    const addRegion=raw=>{
      const normalized=this._norm(raw);
      if(!normalized) return;
      const exact=available.find(name=>this._norm(name)===normalized);
      const partial=available.find(name=>this._norm(name).includes(normalized)||normalized.includes(this._norm(name)));
      const region=exact||partial;
      if(region&&!matched.includes(region)) matched.push(region);
    };
    ((this._genericFeats||{}).demanda_atlas||[]).forEach(item=>{
      const props=(item&&item.props)||{};
      addRegion(props.region||props.gerencia_nombre||item.nom);
    });
    if(!matched.length&&A&&['gcr','demand-region'].includes(A.targetKind)){
      addRegion(A.targetLabel);
    }
    if(!matched.length&&this.state.marketRegion) addRegion(this.state.marketRegion);
    return {
      data,
      regionNames:matched,
      source:data.source||'CENACE',
      operatingDate:data.operatingDate||'',
      updatedAt:data.updatedAt||''
    };
  }

  _appendDemandToReport(report,context){
    if(!report||!context||!context.data||!context.data.regions) return;
    const regions=context.regionNames
      .map(name=>({name,data:context.data.regions[name]}))
      .filter(item=>item.data);
    if(!regions.length) return;
    const number=value=>value==null||value===''
      ?null
      :(Number.isFinite(Number(value))?Number(value):null);
    const hourLabel=(hour,index,total)=>{
      const numeric=Number(hour);
      if(numeric===24&&index===0) return '00:00';
      if(numeric===24&&index===total-1) return '24:00';
      return String(Number.isFinite(numeric)?numeric:0).padStart(2,'0')+':00';
    };
    const formatMw=value=>value==null?'—':Number(value).toLocaleString('es-MX',{maximumFractionDigits:0})+' MW';
    const charts=[];
    const tableRows=[];
    const rawRegions=[];
    regions.forEach(({name,data})=>{
      const hourly=Array.isArray(data.hourly)?data.hourly:[];
      const latest=data.latest||hourly.filter(point=>number(point&&point.demandaMW)!=null).slice(-1)[0]||{};
      const demand=number(latest.demandaMW);
      const generation=number(latest.generacionMW);
      const forecast=number(latest.pronosticoMW);
      const balance=demand!=null&&generation!=null?generation-demand:null;
      const deviation=demand!=null&&forecast!=null?demand-forecast:null;
      tableRows.push([
        name,
        Number.isFinite(Number(latest.hora))?String(Number(latest.hora)).padStart(2,'0')+':00':'—',
        formatMw(demand),
        formatMw(generation),
        formatMw(forecast),
        formatMw(balance),
        formatMw(deviation)
      ]);
      const points=hourly.map((point,index)=>({
        label:hourLabel(point&&point.hora,index,hourly.length),
        hour:Number(point&&point.hora),
        value:number(point&&point.demandaMW),
        demandMW:number(point&&point.demandaMW),
        generationMW:number(point&&point.generacionMW),
        forecastMW:number(point&&point.pronosticoMW),
        detail:'Demanda, generación y pronóstico horario'
      }));
      const series=[
        {key:'demand',label:'Demanda',color:'#1E6FD9',values:points.map(point=>point.demandMW)},
        {key:'generation',label:'Generación',color:'#0E8A6E',values:points.map(point=>point.generationMW)},
        {key:'forecast',label:'Pronóstico',color:'#7A8FA8',dash:'6 5',values:points.map(point=>point.forecastMW)}
      ];
      const chart={
        key:'demand-forecast-'+this._norm(name),
        group:'demand',
        type:'timeseries',
        title:'Demanda y pronóstico - '+name,
        subtitle:'Serie horaria del día de operación '+(context.operatingDate||'reportado')+'. Valores en GW.',
        unit:'MW',
        decimals:0,
        data:points,
        series,
        source:'Fuente: '+context.source+(context.updatedAt?' - actualización '+new Date(context.updatedAt).toLocaleString('es-MX'):'')
      };
      charts.push({
        ...chart,
        alt:'Gráfica horaria de demanda y pronóstico de '+name,
        svgDataUrl:this._reportChartSvg(chart)
      });
      rawRegions.push({name,hourly:points,latest});
    });
    const section={
      key:'demanda-pronostico',
      kicker:'Operación del sistema eléctrico',
      color:'#1E9CB8',
      icon:'M3 12h4l3-8 4 16 3-8h4',
      title:'Demanda y pronóstico por región de control',
      intro:'La cobertura territorial se cruza con las regiones operativas de CENACE. Se presenta la medición horaria, la generación neta y el pronóstico del día de operación para cada región identificada.',
      hasRows:true,
      rows:[
        ['Regiones intersectadas',regions.length.toLocaleString('es-MX')],
        ['Día de operación',context.operatingDate||'—'],
        ['Actualización',context.updatedAt?new Date(context.updatedAt).toLocaleString('es-MX'):'—']
      ],
      hasChips:false,
      chips:[],
      hasCharts:charts.length>0,
      charts,
      hasTable:tableRows.length>0,
      table:{
        head:['Región','Hora','Demanda','Generación','Pronóstico','Balance','Desviación vs. pronóstico'],
        rows:tableRows
      },
      hasTable2:false,
      source:context.source
    };
    const sections=Array.isArray(report.sections)?report.sections:[];
    if(!sections.find(item=>item&&item.key===section.key)){
      const electricalIndex=sections.findIndex(item=>item&&item.key==='elec');
      sections.splice(electricalIndex>=0?electricalIndex+1:1,0,section);
    }
    report.sections=sections;
    report.charts=(Array.isArray(report.charts)?report.charts:[]).concat(charts);
    report.demandForecast={
      source:context.source,
      operatingDate:context.operatingDate,
      updatedAt:context.updatedAt,
      regions:rawRegions
    };
  }

  async _loadConsumptionReportContext(A){
    const ranKeys=Array.isArray(A&&A.ranKeys)?A.ranKeys:[];
    if(!ranKeys.includes('tarifas_atlas')) return null;
    const geo=this._analysisFilteredGeo&&this._analysisFilteredGeo.tarifas_atlas;
    const sourceFeatures=geo
      ?this._normFeatures(geo)
      :((this._genericFeats||{}).tarifas_atlas||[]).map(item=>({
        properties:(item&&item.props)||{},
        geometry:item&&item.geometry
      }));
    const requested=Array.from(new Set(sourceFeatures.map(feature=>{
      const props=(feature&&feature.properties)||{};
      return String(props.division||props.DIVISION||props['DIVISIÓN']||'').trim();
    }).filter(Boolean)));
    if(!requested.length) return null;
    let data=this.state.tariffMarketData;
    if(!data||!data.divisions){
      const response=await fetch('/DashboardProyectos/AtlasSen/Divisiones/Series',{
        cache:'no-store',
        headers:{'Accept':'application/json','Cache-Control':'no-cache'}
      });
      if(!response.ok) throw new Error('HTTP '+response.status);
      data=await response.json();
    }
    const available=Object.keys((data&&data.divisions)||{});
    const divisions=requested.map(name=>{
      const normalized=this._norm(name);
      return available.find(item=>this._norm(item)===normalized);
    }).filter(Boolean);
    return {
      data,
      divisions:Array.from(new Set(divisions)).sort((a,b)=>a.localeCompare(b,'es-MX')),
      source:data.source||'CNE · memorias de cálculo del Suministro Básico',
      referenceYear:data.referenceYear||''
    };
  }

