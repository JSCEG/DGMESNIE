  // ════════════════════ ciclo de vida ════════════════════
  componentDidMount() {
    this._preloadLogos();
    window.__dgPamAnalyze = (projectId) => this._analyzePamById(projectId);
    window.addEventListener('keydown', this.onGlobalKeyDown);
    this._waitFor(() => window.L && window.L.Control && window.L.Control.Draw, () => this._initMap());
    // Catálogo y PAM no son necesarios para pintar el primer cuadro. Se difieren para que no
    // compitan con el contorno territorial ni con las librerías críticas del mapa.
    const loadSecondary=()=>{
      this._loadCatalog();
      this._fetchPamCache().catch(() => {});
    };
    if(typeof window.requestIdleCallback==='function'){
      this._secondaryLoadHandle=window.requestIdleCallback(loadSecondary,{timeout:2200});
    }else{
      this._secondaryLoadTimer=window.setTimeout(loadSecondary,900);
    }
    // La fuente CENACE/Atlas SEN se actualiza durante el día. Una pestaña abierta
    // vuelve a consultar cada cinco minutos mientras la bandeja de demanda está
    // visible; el servidor conserva su propia caché viva con la misma cadencia.
    this._liveDemandTimer=window.setInterval(()=>{
      if(document.visibilityState!=='visible') return;
      const S=this.state||{};
      if(S.marketOpen&&S.marketMode==='demand'&&S.layers&&
        S.layers.demanda_atlas&&S.layers.demanda_atlas.on){
        this._loadDemandMarket(true,true);
      }
    },5*60*1000);
    // Mientras el componente termina de inicializar, todo el árbol está oculto
    // (visibility:hidden en .dg-boot) para evitar el flash de placeholders/skeletons
    // del render server-side (legendOn, capasOpen, modales, etc.). Se destapa al
    // confirmar que el mapa está listo y el preloader desaparece.
    requestAnimationFrame(() => requestAnimationFrame(() => {
      const r = !this.state.booting && this.state.ready;
      if (r) document.documentElement.classList.add('dg-boot-ready');
      else this._bootReadyPoll = setInterval(() => {
        if (!this.state.booting && this.state.ready) {
          document.documentElement.classList.add('dg-boot-ready');
          clearInterval(this._bootReadyPoll); this._bootReadyPoll = null;
        }
      }, 60);
    }));
  }
  componentWillUnmount() {
    window.removeEventListener('keydown', this.onGlobalKeyDown);
    if (window.__dgPamAnalyze) delete window.__dgPamAnalyze;
    if (this._bootReadyPoll) { clearInterval(this._bootReadyPoll); this._bootReadyPoll = null; }
    if (this._reportFeedbackTimer) { clearTimeout(this._reportFeedbackTimer); this._reportFeedbackTimer = null; }
    if (this._liveDemandTimer) { clearInterval(this._liveDemandTimer); this._liveDemandTimer = null; }
    if (this._demandViewportFitTimer) { clearTimeout(this._demandViewportFitTimer); this._demandViewportFitTimer = null; }
    if (this._tariffViewportFitTimer) { clearTimeout(this._tariffViewportFitTimer); this._tariffViewportFitTimer = null; }
    if (this._analysisAbortController) { try { this._analysisAbortController.abort(); } catch(e){} }
    if(this._secondaryLoadHandle&&typeof window.cancelIdleCallback==='function') window.cancelIdleCallback(this._secondaryLoadHandle);
    if(this._secondaryLoadTimer) window.clearTimeout(this._secondaryLoadTimer);
    document.documentElement.classList.remove('dg-report-shell');
  }
  onGlobalKeyDown = (e) => {
    if ((e.key === 'Escape' || e.key === 'Esc') && this.state.mapFullscreen) {
      e.preventDefault();
      this.setState({ mapFullscreen: false }, () => {
        requestAnimationFrame(() => { try { if (this.map) this.map.invalidateSize(); } catch(error){} });
      });
      return;
    }
    if ((e.key === 'Escape' || e.key === 'Esc') && this.state.conv2DecisionTarget) {
      e.preventDefault();
      this.closeConv2Decision();
      return;
    }
    if ((e.key === 'Escape' || e.key === 'Esc') && this.state.conv2ReviewOpen) {
      e.preventDefault();
      this.closeConv2Review();
      return;
    }
    if ((e.key === 'Escape' || e.key === 'Esc') && this.state.reportOpen) {
      e.preventDefault();
      this.onCloseReport();
    }
  }
  _waitFor(cond, cb, n = 0) {
    if (cond()) return cb();
    if (n > 120) { this.setState({ loading:false, toast:'No se pudieron cargar las librerías de mapa.' }); return; }
    setTimeout(() => this._waitFor(cond, cb, n + 1), 80);
  }

  _isClusterLayerKey(key){
    const cfg=(this.LAYERS||[]).find(layer=>layer.key===key);
    if(cfg&&cfg.noCluster) return false;
    return key==='centrales'||key==='permisos'||key==='proyectos'||key==='pam'||this.ENERGY_PERMIT_KEYS.includes(key);
  }
  _clusterGroup(cfg){
    const L=window.L;
    const color=(cfg&&cfg.color)||'#9B2247';
    const options={
      maxClusterRadius:44,
      disableClusteringAtZoom:14,
      showCoverageOnHover:false,
      spiderfyOnMaxZoom:true,
      removeOutsideVisibleBounds:true,
      chunkedLoading:true,
      chunkInterval:35,
      chunkDelay:12,
      iconCreateFunction:cluster=>{
        const count=cluster.getChildCount();
        const label=count>999?'999+':String(count);
        const fontSize=count>999?11:count>99?12:14;
        const html='<svg width="44" height="44" viewBox="0 0 44 44" style="filter:drop-shadow(0 3px 5px rgba(0,0,0,.30))">'
          +'<circle cx="22" cy="22" r="20" fill="#fff" opacity=".96"/>'
          +'<circle cx="22" cy="22" r="16.5" fill="'+color+'" stroke="#fff" stroke-width="2"/>'
          +'<text x="22" y="22.5" text-anchor="middle" dominant-baseline="middle" fill="#fff" font-family="Noto Sans,Arial,sans-serif" font-size="'+fontSize+'" font-weight="800">'+label+'</text>'
          +'</svg>';
        return L.divIcon({className:'',html,iconSize:[44,44],iconAnchor:[22,22]});
      }
    };
    if(cfg&&this.ENERGY_PERMIT_KEYS.includes(cfg.key)) options.clusterPane='permits';
    if(cfg&&(cfg.key==='pam'||cfg.type==='pam')) options.clusterPane='pam';
    if(typeof L.markerClusterGroup==='function') return L.markerClusterGroup(options);
    if(!this._SimpleClusterLayer){
      this._SimpleClusterLayer=L.LayerGroup.extend({
        initialize(clusterOptions){
          L.LayerGroup.prototype.initialize.call(this,[]);
          this._sourceLayers=[];
          this._clusterOptions=clusterOptions||{};
          this._refreshQueued=false;
        },
        addLayer(layer){
          if(layer&&!this._sourceLayers.includes(layer)) this._sourceLayers.push(layer);
          this._queueRefresh();
          return this;
        },
        addLayers(layers){
          (layers||[]).forEach(layer=>{
            if(layer&&!this._sourceLayers.includes(layer)) this._sourceLayers.push(layer);
          });
          this._queueRefresh();
          return this;
        },
        clearLayers(){
          this._sourceLayers=[];
          L.LayerGroup.prototype.clearLayers.call(this);
          return this;
        },
        onAdd(map){
          this._map=map;
          map.on('zoomend moveend resize',this._refresh,this);
          this._refresh();
          L.LayerGroup.prototype.onAdd.call(this,map);
        },
        onRemove(map){
          map.off('zoomend moveend resize',this._refresh,this);
          L.LayerGroup.prototype.onRemove.call(this,map);
          this._map=null;
        },
        _queueRefresh(){
          if(!this._map||this._refreshQueued) return;
          this._refreshQueued=true;
          requestAnimationFrame(()=>{
            this._refreshQueued=false;
            this._refresh();
          });
        },
        _refresh(){
          const map=this._map;
          if(!map) return;
          const zoom=map.getZoom();
          const maxZoom=Number(this._clusterOptions.disableClusteringAtZoom)||14;
          const cellSize=Number(this._clusterOptions.maxClusterRadius)||44;
          const bounds=map.getBounds().pad(.3);
          const direct=[];
          const buckets=new Map();
          this._sourceLayers.forEach(layer=>{
            if(!layer||typeof layer.getLatLng!=='function'){ direct.push(layer); return; }
            const latLng=layer.getLatLng();
            if(!latLng||!bounds.contains(latLng)) return;
            if(zoom>=maxZoom){ direct.push(layer); return; }
            const point=map.project(latLng,zoom);
            const key=Math.floor(point.x/cellSize)+':'+Math.floor(point.y/cellSize);
            if(!buckets.has(key)) buckets.set(key,[]);
            buckets.get(key).push(layer);
          });
          buckets.forEach(items=>{
            if(items.length===1){ direct.push(items[0]); return; }
            const latLngs=items.map(layer=>layer.getLatLng());
            const center=[
              latLngs.reduce((sum,item)=>sum+item.lat,0)/latLngs.length,
              latLngs.reduce((sum,item)=>sum+item.lng,0)/latLngs.length
            ];
            const icon=this._clusterOptions.iconCreateFunction({
              getChildCount:()=>items.length,
              getAllChildMarkers:()=>items.slice()
            });
            const clusterMarker=L.marker(center,{
              icon,
              pane:this._clusterOptions.clusterPane||'markerPane',
              zIndexOffset:900,
              keyboard:false
            });
            clusterMarker.on('click',()=>{
              const clusterBounds=L.latLngBounds(latLngs);
              if(clusterBounds.isValid()) map.fitBounds(clusterBounds.pad(.35),{maxZoom:maxZoom,animate:true});
            });
            direct.push(clusterMarker);
          });
          L.LayerGroup.prototype.clearLayers.call(this);
          direct.forEach(layer=>L.LayerGroup.prototype.addLayer.call(this,layer));
        }
      });
    }
    return new this._SimpleClusterLayer(options);
  }

  _initMap() {
    const L = window.L;
    // Limita la navegación al territorio mexicano (incluye islas del Pacífico).
    // minZoom evita alejarse hasta mostrar el mundo y la viscosidad impide
    // arrastrar el mapa fuera de estos límites.
    const MEXICO_BOUNDS = L.latLngBounds([[14.0, -118.5], [33.5, -86.0]]);
    this.MEXICO_BOUNDS = MEXICO_BOUNDS;
    const map = L.map(this.mapRef.current, {
      zoomControl:false,
      preferCanvas:true,
      attributionControl:false,
      minZoom:5,
      maxZoom:20,
      maxBounds:MEXICO_BOUNDS,
      maxBoundsViscosity:1.0,
      worldCopyJump:false
    })
      .setView([23.6, -102], 5);
    this.map = map;
    L.control.zoom({ position:'topright' }).addTo(map);
    L.control.scale({ position:'bottomleft', imperial:false, metric:true }).addTo(map);
    // Atribución de fuente — Dirección General de Metodología y Estadísticas del SNIE
    L.control.attribution({ position:'bottomleft', prefix:false }).addAttribution('Fuente: <b>Dirección General de Metodología y Estadísticas del SNIE</b> (DGMESNIE) · CENACE · CFE').addTo(map);

    // Mapas base
    this.bases = {
      // Cero solicitudes de mosaicos: el contorno de entidades funciona como base vectorial.
      sinmapa: L.layerGroup(),
      // Mapa base colorido SIN etiquetas ni división política (CartoDB Voyager nolabels) — por defecto
      color:    L.tileLayer('https://{s}.basemaps.cartocdn.com/rastertiles/voyager_nolabels/{z}/{x}/{y}{r}.png', { subdomains:'abcd', maxZoom:20, crossOrigin:'anonymous' }),
      claro:    L.tileLayer('https://{s}.basemaps.cartocdn.com/light_all/{z}/{x}/{y}{r}.png', { subdomains:'abcd', maxZoom:19, crossOrigin:'anonymous' }),
      satelite: L.tileLayer('https://mt{s}.google.com/vt/lyrs=s&x={x}&y={y}&z={z}', { subdomains:['0','1','2','3'], maxZoom:19 }),
      oscuro:   L.tileLayer('https://{s}.basemaps.cartocdn.com/dark_all/{z}/{x}/{y}{r}.png', { subdomains:'abcd', maxZoom:19, crossOrigin:'anonymous' }),
    };
    this.bases[this.state.basemap].addTo(map);
    map.getContainer().style.backgroundColor='#F4F0EA';

    // Los permisos deben recibir el clic aun cuando el contorno del análisis
    // (pane draw) cubra la misma zona. También se usa para sus clústeres.
    map.createPane('permits');
    map.getPane('permits').style.zIndex = '630';
    // Los proyectos PAM deben seguir siendo interactivos cuando el mapa conserva el
    // polígono/buffer del análisis (pane draw, z620). Su pane también contiene clústeres.
    map.createPane('pam');
    map.getPane('pam').style.zIndex = '635';

    // Grupos de capa
    this.groups = {}; this._built = {};
    this.LAYERS.forEach(l => {
      this.groups[l.key]=this._isClusterLayerKey(l.key)?this._clusterGroup(l):L.layerGroup();
    });
    // Pane dedicado de Municipios (encima de polígonos de contexto). Se prende/apaga por visibilidad (sin add/remove → sin errores)
    map.createPane('muni'); map.getPane('muni').style.zIndex = '410';
    this._muRenderer = L.canvas({ pane:'muni', padding:0.5 });
    // Pane de VECTORES del inventario (líneas/polígonos) con renderer SVG: se dibuja siempre al
    // agregarse, respeta el z-index del pane (encima de gerencias/estados) y no depende de redibujos.
    map.createPane('genvec'); map.getPane('genvec').style.zIndex = '449';
    this._svgRenderer = L.svg({ pane:'genvec', padding:0.5 });
    this._svgRenderer.addTo(map); // CLAVE: añadirlo al mapa mantiene su _bounds actualizado (evita 'reading x')
    // Las miles de aristas del grafo usan un canvas exclusivo: evita crear miles de nodos SVG
    // y mantiene el hit-test de líneas separado del resto de capas del inventario.
    map.createPane('graphlines'); map.getPane('graphlines').style.zIndex = '450';
    this._graphRenderer = L.canvas({ pane:'graphlines', padding:0.35, tolerance:5 });
    this._graphRenderer.addTo(map);
    // Etiquetas de tensión dibujadas en un solo canvas y sólo para los trazos
    // visibles. Se evita crear miles de nodos DOM al acercar el mapa.
    map.createPane('graphlabels');
    map.getPane('graphlabels').style.zIndex = '452';
    map.getPane('graphlabels').style.pointerEvents = 'none';
    // Pane de capas de DATOS (puntos/líneas/polígonos del inventario) — encima de los polígonos de contexto (gerencias/estados)
    map.createPane('data'); map.getPane('data').style.zIndex = '430';
    this._dataRenderer = L.canvas({ pane:'data', padding:0.5 });
    this._dataRenderer.addTo(map); // aislado del canvas por defecto (gerencias/estados): una capa de
    // puntos muy grande (p.ej. Lenguas indígenas · 41,903 puntos) no debe poder romper el repintado
    // de las demás capas si su propio redraw falla — cada una en su propio lienzo
    // Pane del área de análisis (dibujo) SIEMPRE por encima de todas las capas
    map.createPane('draw'); map.getPane('draw').style.zIndex = '620';
    // Pane del resaltado (halo del elemento buscado) — por encima de todo
    map.createPane('hl'); map.getPane('hl').style.zIndex = '640'; map.getPane('hl').style.pointerEvents = 'none';
    // Selección de municipio por clic en el mapa (point-in-polygon) — robusto ante el hit-test de canvas
    map.on('click', (e) => this._onMapClick(e));
    window.__dgMap = map; window.__dg = this; // referencia de depuración
    // Blindaje: bug conocido de Leaflet — un L.Marker arrastrable + animación de zoom puede lanzar
    // una excepción interna (async, sin stack útil) en _animateZoom. No rompe nada visible, pero
    // ensucia la consola en CADA setView animado; se protege el prototipo una sola vez.
    [L.Map, L.Marker, L.Tooltip, L.Popup, L.GridLayer, L.SVG, L.Canvas, L.ImageOverlay].forEach(Cls => {
      if (!Cls || !Cls.prototype || !Cls.prototype._animateZoom || Cls.prototype.__zoomGuarded) return;
      const oaz = Cls.prototype._animateZoom;
      Cls.prototype._animateZoom = function(){ try { return oaz.apply(this, arguments); } catch(err){} };
      Cls.prototype.__zoomGuarded = true;
    });
    // se añaden al mapa selectivamente tras cargar, según el toggle de cada capa

    // Capa de dibujo (Leaflet.draw)
    this.drawn = new L.FeatureGroup().addTo(map);
    map.on(L.Draw.Event.CREATED, (e) => this._onDrawCreated(e));

    this._loadBaseGeometries();
  }

  // ════════════════════ carga de geometrías (MOCK CDN → fetch real) ════════════════════
  // MIGRACIÓN: estas tres llamadas equivalen a un /api/layers/{capa}.geojson
  async _loadBaseGeometries() {
    const L = window.L;
    this.setState({ bootMsg:'Cargando contorno territorial…' });
    try {
      // El primer cuadro sólo requiere el contorno. Las 3,000+ líneas y subestaciones se
      // consultan desde la BD únicamente cuando el usuario enciende una capa o ejecuta análisis.
      const [est, ger] = await Promise.all([
        this._mockFetchGeo(this.SRC.estados),
        this._mockFetchGeo(this.SRC.gerencias).catch(() => null),
      ]);
      const lt={type:'FeatureCollection',features:[]};
      const sub={type:'FeatureCollection',features:[]};
      this.geo = { estados:est, lineas:lt, subestaciones:sub, gerencias:ger };

      // Índice de centroides por entidad (para join por cve_ent / nombre)
      this._buildEstadoIndex(est);

      // Subestaciones → circleMarkers (asigna __id incremental como id_subestacion demo)
      this.subFeatures = [];
      (sub.features || []).forEach((f, i) => {
        if (!f.geometry || f.geometry.type !== 'Point') return;
        const [lng, lat] = f.geometry.coordinates;
        const kv = this._kvOf(f.properties);
        const ent = this._stateAt(lat, lng) || this._propEnt(f.properties);
        const rec = { idx:i+1, lat, lng, kv, name:this._nameOf(f.properties, 'Subestación '+(i+1)), ent, props:f.properties };
        this.subFeatures.push(rec);
        const m = L.circleMarker([lat, lng], { ...this._subStyle(kv), renderer: this._dataRenderer, pane:'data' });
        this._guardPath(m);
        (this._subMarkers = this._subMarkers || []).push(m); // lista maestra: el análisis geoespacial filtra la membresía del grupo
        m._rec = rec;
        m.on('click', () => this._selectSub(rec, m));
        this.groups.subestaciones.addLayer(m);
      });

      // Líneas → polyline por kV
      this.lineFeatures = [];
      (lt.features || []).forEach((f) => {
        if (!f.geometry) return;
        const kv = this._kvOf(f.properties);
        const color = this._colorForKv(kv);
        const name = this._nameOf(f.properties, 'Línea de transmisión');
        const addLine = (latlngs) => {
          const pl = L.polyline(latlngs, { color, weight: kv>=400?2.6:1.6, opacity:.85 });
          this._guardPath(pl);
          pl._rec = { name, kv, props:f.properties, km:this._lineKm(latlngs) };
          pl.on('click', () => this._selectLine(pl._rec, pl));
          this.groups.lineas.addLayer(pl);
          this.lineFeatures.push(pl);
        };
        const g = f.geometry;
        if (g.type === 'LineString') addLine(g.coordinates.map(c => [c[1], c[0]]));
        else if (g.type === 'MultiLineString') g.coordinates.forEach(seg => addLine(seg.map(c => [c[1], c[0]])));
      });

      // Gerencias de control → polígonos GCR reales (geometría propia), color institucional
      if (ger && ger.features) {
        this.gerLayer = L.geoJSON(ger, {
          style: (f) => { const c = this.GCR_COLORS[this._gcrKeyFromName(this._gerName(f.properties))] || '#9B2247'; return { color:c, weight:1.5, fillColor:c, fillOpacity:.34 }; },
          onEachFeature: (f, lyr) => {
            this._guardPath(lyr);
            const k = this._gcrKeyFromName(this._gerName(f.properties));
            const nom = this.GCR_NOMBRE[k] || this._gerName(f.properties);
            try { const c = lyr.getBounds().getCenter(); (this._gcrCentroid = this._gcrCentroid || {})[k] = [c.lat, c.lng]; } catch(e){}
            lyr.on('click', (e) => { if (this._pickPolygonAt(e.latlng)) return; this._selectGerencia(k, nom); });
            lyr.on('mouseover', () => lyr.setStyle({ fillOpacity:.55, weight:2.4 }));
            lyr.on('mouseout', () => lyr.setStyle({ fillOpacity:.34, weight:1.5 }));
            lyr.bindTooltip('GCR '+nom, { sticky:true, opacity:.95 });
          },
        });
        this.gerLayer.eachLayer(l => this.groups.gerencias.addLayer(l));
      } else {
        // Respaldo: si el GeoJSON de gerencias falla, dibuja desde estados coloreados por GCR
        this.gerLayer = L.geoJSON(est, {
          style: (f) => { const c = this._gcrColor(this._propEnt(f.properties)); return { color:c, weight:1.2, fillColor:c, fillOpacity:.30 }; },
          onEachFeature: (f, lyr) => { this._guardPath(lyr); const nom=this._propEnt(f.properties)||'Entidad'; const gk=this._gerenciaOf(nom); lyr.on('click',(e)=>{ if(this._pickPolygonAt(e.latlng)) return; this._selectGerencia(gk,this.GCR_NOMBRE[gk]||nom); }); lyr.bindTooltip('GCR '+(this.GCR_NOMBRE[gk]||'—'),{sticky:true}); },
        });
        this.gerLayer.eachLayer(l => this.groups.gerencias.addLayer(l));
      }

      // Estados → capa de referencia (contorno guinda, relleno papel, etiqueta)
      this.estadosLayer = L.geoJSON(est, {
        style: (f) => this._estadoBoundaryStyle(f && f.properties ? (f.properties.CVE_ENT || f.properties.cve_ent) : null),
        onEachFeature: (f, lyr) => {
          this._guardPath(lyr);
          const nom = this._propEnt(f.properties) || 'Entidad';
          const cve = f && f.properties ? (f.properties.CVE_ENT || f.properties.cve_ent) : null;
          lyr.on('click', (e) => { if (this._pickPolygonAt(e.latlng)) return; this._selectEstado(nom, f, lyr); });
          lyr.on('mouseover', () => { try { lyr.setStyle(this._estadoBoundaryStyle(cve, true)); } catch(error){} });
          lyr.on('mouseout', () => { try { lyr.setStyle(this._estadoBoundaryStyle(cve)); } catch(error){} });
          lyr.bindTooltip(nom, { sticky:true, opacity:.95 });
        },
      });
      this.estadosLayer.eachLayer(l => this.groups.estados.addLayer(l));
      this._built.gerencias = this._built.estados = this._built.subestaciones = this._built.lineas = true;

      // Entidades para filtro
      const ents = [...new Set((est.features||[]).map(f => this._propEnt(f.properties)).filter(Boolean))].sort();

      // Conteos
      const layers = { ...this.state.layers };
      layers.subestaciones.count = this.subFeatures.length;
      layers.lineas.count = this.lineFeatures.length;
      layers.gerencias.count = ger && ger.features ? ger.features.length : Object.keys(this.GCR_NOMBRE).length;
      layers.estados.count = (est.features||[]).length;

      // Añade al mapa sólo las capas activas inicialmente
      Object.keys(this.groups).forEach(k => { if (this.state.layers[k].on) this.groups[k].addTo(this.map); });

      this.setState({ ready:true, booting:false, loading:false, layers, entidades:ents }, () => { this.map.invalidateSize(); this._recompute(); });
      this._toast('Base territorial lista · '+ents.length+' entidades · red eléctrica bajo demanda');
    } catch (e) {
      this.setState({ booting:false, loading:false, toast:'Error al cargar geometrías: '+(e.message||e) });
    }
  }
  _distributedGenerationGeo(forceRefresh=false,options){
    if(!forceRefresh&&this._distributedGenerationGeoCache){
      return Promise.resolve(this._distributedGenerationGeoCache);
    }
    if(this._distributedGenerationGeoPromise) return this._distributedGenerationGeoPromise;
    const endpoint='/DashboardProyectos/AtlasSen/GeneracionDistribuida'+
      (forceRefresh?'?ts='+Date.now():'');
    this._distributedGenerationGeoPromise=fetch(endpoint,{
      ...(options||{}),
      cache:'no-store',
      headers:{
        ...((options&&options.headers)||{}),
        Accept:'application/json',
        'Cache-Control':'no-cache'
      }
    }).then(response=>{
      if(!response.ok) throw new Error('HTTP '+response.status);
      return response.json();
    }).then(data=>{
      const states=data&&data.states?data.states:{};
      const aliases=new Map();
      Object.entries(states).forEach(([name,value])=>{
        aliases.set(this._norm(name),value);
        aliases.set(this._norm(String(name).replace(/^Estado de /i,'')),value);
      });
      if(states['Estado de México']) aliases.set(this._norm('México'),states['Estado de México']);
      if(states['Ciudad de México']){
        aliases.set(this._norm('CDMX'),states['Ciudad de México']);
        aliases.set(this._norm('Distrito Federal'),states['Ciudad de México']);
      }
      const features=((this.geo&&this.geo.estados&&this.geo.estados.features)||[])
        .map(feature=>{
          const stateName=this._propEnt((feature&&feature.properties)||{});
          const record=aliases.get(this._norm(stateName));
          if(!record) return null;
          const latest=record.latest||{};
          return {
            type:'Feature',
            geometry:feature.geometry,
            properties:{
              ...((feature&&feature.properties)||{}),
              name:stateName,
              state:stateName,
              macro_region:record.macroRegion||'',
              reference_period:data.referencePeriod||'',
              dg_mw:latest.mw,
              dg_contracts:latest.contracts,
              source:data.source||'CNE · Generación Distribuida y Limpia',
              attribution_url:data.attributionUrl||'',
              license:data.license||'Datos públicos CNE',
              validation_state:data.validationState||'serie_publica_compilada_por_atlas_sen'
            }
          };
        }).filter(Boolean);
      const geo={
        type:'FeatureCollection',
        meta:{
          layer:'generacion_distribuida_atlas_sen',
          generatedUtc:data.generatedUtc,
          features:features.length,
          referencePeriod:data.referencePeriod||'',
          source:data.source||'CNE · Generación Distribuida y Limpia',
          license:data.license||'Datos públicos CNE',
          validationState:data.validationState||'serie_publica_compilada_por_atlas_sen'
        },
        features
      };
      this._distributedGenerationGeoCache=geo;
      this._distributedGenerationPayload=data;
      window.generacion_distribuida_atlas=geo;
      return geo;
    }).finally(()=>{this._distributedGenerationGeoPromise=null;});
    return this._distributedGenerationGeoPromise;
  }
  _mockFetchGeo(url, options) {
    // MOCK: simula latencia de red de un CDN externo y devuelve GeoJSON real.
    if(typeof url==='string'&&url.startsWith('window:')){
      const globalName=url.slice('window:'.length);
      if(globalName==='generacion_distribuida_atlas'){
        return this._distributedGenerationGeo(false,options);
      }
      const payload=window[globalName];
      if(!payload||payload.type!=='FeatureCollection'||!Array.isArray(payload.features)){
        return Promise.reject(new Error('La geometría '+globalName+' no está disponible'));
      }
      return Promise.resolve(payload);
    }
    return fetch(url,options||{}).then(r => { if (!r.ok) throw new Error('HTTP '+r.status); return r.json(); });
  }

  // ════════════════════ índice de estados ════════════════════
  _buildEstadoIndex(est) {
    this.estCentroid = {}; this.estByName = {};
    (est.features||[]).forEach(f => {
      const nom = this._propEnt(f.properties); if (!nom) return;
      const c = this._centroid(f.geometry);
      this.estCentroid[this._norm(nom)] = { lat:c[0], lng:c[1], feature:f };
      this.estByName[this._norm(nom)] = f;
    });
  }
  _centroid(g) {
    let sx=0, sy=0, n=0;
    const acc = (value) => {
      if(!Array.isArray(value)) return;
      if(value.length>=2&&isFinite(value[0])&&isFinite(value[1])){
        sx+=Number(value[0]); sy+=Number(value[1]); n++; return;
      }
      value.forEach(acc);
    };
    if (!g) return [23.6,-102];
    if(g.type==='Feature') return this._centroid(g.geometry);
    if(g.type==='FeatureCollection'){
      (g.features||[]).forEach(f=>{ const c=this._centroid(f.geometry); if(c&&isFinite(c[0])&&isFinite(c[1])){ sx+=c[1];sy+=c[0];n++; } });
    }else if(g.type==='GeometryCollection'){
      (g.geometries||[]).forEach(item=>{ const c=this._centroid(item); if(c&&isFinite(c[0])&&isFinite(c[1])){ sx+=c[1];sy+=c[0];n++; } });
    }else acc(g.coordinates);
    return n ? [sy/n, sx/n] : [23.6,-102];
  }
  _fetchPamCache(force){
    if(!force&&this.state.pamCatalog&&this.state.pamCatalog.length) return Promise.resolve(this.state.pamCatalog);
    if(!force&&this._pamCatalogPromise) return this._pamCatalogPromise;
    this._pamCatalogPromise=fetch('/DashboardProyectos/PamTerritorial?limite=500',{
      method:'GET',credentials:'same-origin',headers:{Accept:'application/json'}
    }).then(async response=>{
      const payload=await response.json().catch(()=>null);
      if(!response.ok) throw new Error(payload&&payload.detail?payload.detail:'HTTP '+response.status);
      const items=Array.isArray(payload)?payload:[];
      this._invalidateSearch();
      this.setState({pamCatalog:items});
      return items;
    }).finally(()=>{ this._pamCatalogPromise=null; });
    return this._pamCatalogPromise;
  }
  _pamValidLocations(item){
    return ((item&&item.ubicaciones)||[]).filter(location=>location&&location.validada&&location.geometria);
  }
  _pamSuggestedLocations(item,highOnly){
    return ((item&&item.ubicaciones)||[]).filter(location=>{
      if(!location||!location.esAsociacionSugerida||!location.geometria) return false;
      return !highOnly||String(location.nivelConfianza||'').toLowerCase()==='alta';
    });
  }
  _pamOperationalLocations(item){
    const validated=this._pamValidLocations(item);
    return validated.length?validated:this._pamSuggestedLocations(item,true);
  }
  _storePamCatalogItem(item){
    if(!item||!Number(item.proyectoId)) return;
    const catalog=[...(this.state.pamCatalog||[])];
    const index=catalog.findIndex(value=>Number(value.proyectoId)===Number(item.proyectoId));
    if(index>=0) catalog[index]=item;
    else catalog.push(item);
    this._invalidateSearch();
    this.setState({pamCatalog:catalog});
  }
  _fetchPamDetail(item){
    const id=Number(item&&item.proyectoId||0);
    if(!Number.isFinite(id)||id<=0) return Promise.resolve(item);
    if(this._pamOperationalLocations(item).length) return Promise.resolve(item);
    this._pamDetailPromises=this._pamDetailPromises||new Map();
    if(this._pamDetailPromises.has(id)) return this._pamDetailPromises.get(id);
    const request=fetch('/DashboardProyectos/PamTerritorial/'+encodeURIComponent(id),{
      credentials:'same-origin',headers:{Accept:'application/json'}
    }).then(async response=>{
      const payload=await response.json().catch(()=>null);
      if(!response.ok) throw new Error(payload&&payload.detail?payload.detail:'HTTP '+response.status);
      this._storePamCatalogItem(payload);
      return payload;
    }).finally(()=>this._pamDetailPromises.delete(id));
    this._pamDetailPromises.set(id,request);
    return request;
  }
  _pamItemFromProperties(p){
    const projectId=Number(p.proyectoId||p.ProyectoId||0);
    const cached=(this.state.pamCatalog||[]).find(item=>Number(item.proyectoId)===projectId);
    if(cached) return cached;
    return {
      proyectoId,
      claveProyecto:p.claveProyecto||p.ClaveProyecto||'',
      nombreProyecto:p.nombreProyecto||p.NombreProyecto||'Proyecto PAM',
      gcr:p.gcr||p.Gcr||'',
      tipoProyecto:p.tipoProyecto||p.TipoProyecto||'',
      etapaProyecto:p.etapaProyecto||p.EtapaProyecto||'',
      estatusLicitacion:p.estatusLicitacion||p.EstatusLicitacion||'',
      zonaAtendida:p.zonaAtendida||p.ZonaAtendida||'',
      elementosEquiposAsociados:p.elementosEquiposAsociados||p.ElementosEquiposAsociados||'',
      fuenteDocumento:p.fuente||p.Fuente||'PAM / PAMRNT',
      fechaCorte:p.fechaCorte||p.FechaCorte||null,
      fichaUrl:p.fichaUrl||p.FichaUrl||'',
      ubicaciones:[]
    };
  }
  _pamGcrKeys(raw){
    const text=String(raw||'').trim();
    if(!text) return [];
    if(this._norm(text)==='varias') return Object.keys(this.GCR_NOMBRE);
    const whole=this._gcrKeyFromName(text);
    if(whole) return [whole];
    const keys=[];
    text.split(/(?:\r?\n|\/+|,|;|\+|\s+y\s+)/i).forEach(part=>{
      const key=this._gcrKeyFromName(part);
      if(key&&!keys.includes(key)) keys.push(key);
    });
    return keys;
  }
  _pamRegionalGeometry(raw){
    const features=[];
    this._pamGcrKeys(raw).forEach(key=>{
      const geo=this._anaGcrShortcutGeometry(key);
      (geo&&geo.features||[]).forEach(feature=>features.push(feature));
    });
    return features.length?{type:'FeatureCollection',features}:null;
  }
  _pamRegionalCenter(raw){
    const geometry=this._pamRegionalGeometry(raw);
    return geometry?this._centroid(geometry):[23.6,-102];
  }
  _preparePamLayerGeoJson(geo){
    return this._fetchPamCache(false).then(items=>{
      const source=geo&&geo.type==='FeatureCollection'?geo:{type:'FeatureCollection',features:[]};
      const originalFeatures=[...(source.features||[])];
      const preciseIds=new Set(
        originalFeatures
          .map(feature=>Number(feature&&feature.properties&&(feature.properties.proyectoId||feature.properties.ProyectoId)||0))
          .filter(id=>Number.isFinite(id)&&id>0)
      );
      const regionalFeatures=[];
      (items||[]).forEach(item=>{
        const projectId=Number(item&&item.proyectoId||0);
        if(!projectId||preciseIds.has(projectId)) return;
        const gcrKeys=this._pamGcrKeys(item.gcr);
        const center=this._pamRegionalCenter(item.gcr);
        const gcrNames=gcrKeys.map(key=>this.GCR_NOMBRE[key]||key).join(' · ');
        regionalFeatures.push({
          type:'Feature',
          geometry:{type:'Point',coordinates:[center[1],center[0]]},
          properties:{
            proyectoId:projectId,
            claveProyecto:item.claveProyecto||'',
            nombreProyecto:item.nombreProyecto||'Proyecto PAM',
            gcr:item.gcr||'',
            tipoProyecto:item.tipoProyecto||'',
            etapaProyecto:item.etapaProyecto||'',
            estatusLicitacion:item.estatusLicitacion||'',
            estadoVigenciaCartera:item.estadoVigenciaCartera||'',
            zonaAtendida:item.zonaAtendida||'',
            elementosEquiposAsociados:item.elementosEquiposAsociados||'',
            fichaUrl:item.fichaUrl||'',
            fechaCorte:item.fechaCorte||null,
            fuente:item.fuenteDocumento||'PAM / PAMRNT',
            esUbicacionRegional:true,
            gcrSinResolver:gcrKeys.length===0,
            gcrKeys,
            etiquetaUbicacion:gcrNames?'Cobertura '+gcrNames:'Cobertura nacional de referencia',
            precisionUbicacion:'regional aproximada por GCR',
            metodoUbicacion:'centroide_gcr_representativo',
            tipoRepresentacion:'referencia_visual_no_oficial'
          }
        });
      });
      const catalogCount=(items||[]).length;
      const preciseCount=(items||[]).filter(item=>preciseIds.has(Number(item.proyectoId))).length;
      const serverMeta=source.meta||{};
      const associatedRedCount=Number(serverMeta.proyectosAsociadosRed||0);
      const associatedConv2Count=Number(serverMeta.proyectosAsociadosConvocatoria||0);
      const regionalCount=Math.max(0,catalogCount-preciseCount);
      const prepared={
        ...source,
        features:[...originalFeatures,...regionalFeatures],
        meta:{
          ...(source.meta||{}),
          catalogoProyectos:catalogCount,
          proyectos:catalogCount,
          proyectosConUbicacionPrecisa:preciseCount,
          proyectosAsociadosRed:associatedRedCount,
          proyectosAsociadosConvocatoria:associatedConv2Count,
          proyectosRegionales:regionalCount,
          elementosAsociados:originalFeatures.length,
          representacionesRegionales:regionalFeatures.length
        }
      };
      this._pamLayerMeta=prepared.meta;
      return prepared;
    });
  }
  _pamShortcutOption(item){
    if(!item) return null;
    const validatedLocations=this._pamValidLocations(item);
    const locations=this._pamOperationalLocations(item);
    let geometry=null,lat=null,lng=null,located=locations.length>0,precision='regional',mode='territory',bufferKm=0,radiusKm=20;
    let detailLocation=null;
    if(located){
      detailLocation=locations.find(location=>location.esPrincipal)||locations[0];
      geometry=locations.length===1
        ?detailLocation.geometria
        :{type:'FeatureCollection',features:locations.map(location=>({
          type:'Feature',
          properties:{ubicacionId:location.ubicacionId,etiqueta:location.etiqueta||''},
          geometry:location.geometria
        }))};
      const center=(isFinite(detailLocation.latitud)&&isFinite(detailLocation.longitud))
        ?[Number(detailLocation.latitud),Number(detailLocation.longitud)]
        :this._centroid(geometry);
      lat=center[0]; lng=center[1];
      precision=detailLocation.esAsociacionSugerida
        ?(detailLocation.metodoUbicacion==='cruce_segunda_convocatoria_v1'
          ?'asociada mediante Segunda Convocatoria'
          :'asociada al catálogo de red')
        :(detailLocation.precisionUbicacion||'exacta');
      const geometryType=String(detailLocation.tipoGeometria||(detailLocation.geometria&&detailLocation.geometria.type)||'');
      const isSinglePoint=locations.length===1&&geometryType==='Point';
      mode=isSinglePoint?'point':'territory';
      radiusKm=Math.max(1,Number(detailLocation.radioSugeridoKm)||20);
      bufferKm=locations.length>1
        ?Math.max(0,Number(detailLocation.radioSugeridoKm)||10)
        :(geometryType==='LineString'||geometryType==='MultiLineString'||geometryType==='MultiPoint'
          ?Math.max(0,Number(detailLocation.radioSugeridoKm)||10)
          :0);
    }else{
      const gcrKeys=this._pamGcrKeys(item.gcr);
      geometry=this._pamRegionalGeometry(item.gcr);
      const center=geometry?this._centroid(geometry):null;
      if(center){lat=center[0];lng=center[1];}
      precision=gcrKeys.length?'regional aproximada por GCR':'regional sin GCR reconocible';
    }
    if(!geometry||!isFinite(lat)||!isFinite(lng)) return null;
    const key=item.claveProyecto||('PAM '+item.proyectoId);
    const detail=[
      key,
      item.tipoProyecto,
      located
        ?(validatedLocations.length
          ?(locations.length>1?locations.length+' elementos · ubicación validada':'ubicación '+precision)
          :(locations.length>1
            ?locations.length+' elementos de red · confianza alta'
            :'asociación de red '+(detailLocation.puntajeCoincidencia||'—')+'/100'))
        :'sin coordenada validada · cobertura GCR aproximada'
    ].filter(Boolean).join(' · ');
    return {
      kind:'pam',
      label:item.nombreProyecto||key,
      detail,
      lat,lng,zoom:located?10:6,color:'#6B3654',code:'PA',
      geometry,
      bufferKm,
      radiusKm,
      analysisMode:mode,
      located,
      precision,
      state:detailLocation&&detailLocation.entidad||'',
      municipality:detailLocation&&detailLocation.municipio||'',
      pamItem:item
    };
  }
  _selectPamItem(item,location){
    if(!item) return;
    const validatedLocations=this._pamValidLocations(item);
    const suggestedLocations=this._pamSuggestedLocations(item,false);
    const highSuggestions=suggestedLocations.filter(value=>String(value.nivelConfianza||'').toLowerCase()==='alta');
    const reviewSuggestions=suggestedLocations.filter(value=>String(value.nivelConfianza||'').toLowerCase()!=='alta');
    const locations=this._pamOperationalLocations(item);
    const primary=location||locations.find(value=>value.esPrincipal)||locations[0]||null;
    const precise=!!primary;
    const cut=primary&&primary.fechaCorte||item.fechaCorte;
    const formatDate=value=>{
      if(!value) return '—';
      const parsed=new Date(value);
      return Number.isNaN(parsed.getTime())?String(value):parsed.toLocaleDateString('es-MX');
    };
    const rows=[
      ['Tipo de infraestructura','Proyecto del PAM / PAMRNT'],
      ['Clave PAM',item.claveProyecto||'—'],
      ['Claves alternas',item.clavesAlternas||'—'],
      ['GCR',item.gcr||'—'],
      ['Tipo de proyecto',item.tipoProyecto||'—'],
      ['Etapa',item.etapaProyecto||'—'],
      ['Estatus',item.estatusLicitacion||item.estadoVigenciaCartera||'—'],
      ['Zona atendida',item.zonaAtendida||'—'],
      ['Elementos asociados',item.elementosEquiposAsociados||'—'],
      ['Ubicaciones validadas',String(validatedLocations.length)],
      ['Asociaciones de red',suggestedLocations.length
        ?highSuggestions.length+' confianza alta · '+reviewSuggestions.length+' por revisar'
        :'0'],
      ['Subgrafo eléctrico','Consultando conexiones…'],
      ['Segunda convocatoria','Consultando evidencia…'],
      ['Diagnóstico de red','Consultando subestaciones y líneas…'],
      ['Precisión',precise
        ?(primary.esAsociacionSugerida?'asociada · pendiente de validación':(primary.precisionUbicacion||'validada'))
        :'regional aproximada'],
      ['Método de ubicación',precise?(primary.metodoUbicacion||'—'):'polígono de la GCR'],
      ['Confianza',primary&&primary.puntajeCoincidencia!=null
        ?primary.puntajeCoincidencia+'/100 · '+(primary.nivelConfianza||'—')
        :'—'],
      ['Evidencias',primary&&Array.isArray(primary.evidencias)&&primary.evidencias.length
        ?primary.evidencias.join(' · ')
        :'—'],
      ['Entidad / municipio',precise?[primary.entidad,primary.municipio].filter(Boolean).join(' · ')||'—':'—'],
      ['Dirección',precise?(primary.direccion||'—'):'—'],
      ['Fuente geográfica',precise?(primary.fuente||'—'):'DGMESNIE · delimitación GCR'],
      ['Corte',formatDate(cut)],
      ['Ficha PAM',item.fichaUrl?window.location.origin+item.fichaUrl:'—']
    ];
    const selected={
      kicker:'PAM / PAMRNT · '+(item.claveProyecto||'proyecto'),
      color:'#6B3654',
      name:item.nombreProyecto||item.claveProyecto||'Proyecto PAM',
      sourceKey:'pam',
      projectId:Number(item.proyectoId||0),
      rows
    };
    this.setState({
      anaOpen:false,
      menuOpen:null,
      collapsed:{...this.state.collapsed,detalle:false},
      selected
    });
    const projectId=Number(item.proyectoId||0);
    if(projectId>0){
      const requestId=(this._pamGraphRequestId||0)+1;
      this._pamGraphRequestId=requestId;
      fetch('/DashboardProyectos/RedElectrica/Grafo/Pam/'+encodeURIComponent(projectId)+'?depth=1',{
        credentials:'same-origin',headers:{Accept:'application/json'}
      }).then(async response=>{
        const payload=await response.json().catch(()=>null);
        if(!response.ok) throw new Error(payload&&payload.detail?payload.detail:'HTTP '+response.status);
        return payload;
      }).then(payload=>{
        if(this._pamGraphRequestId!==requestId||!this.state.selected||this.state.selected.name!==selected.name) return;
        const meta=payload&&payload.geoJson&&payload.geoJson.meta||{};
        const current=this.state.selected||selected;
        const graphRows=(current.rows||rows).map(row=>row[0]==='Subgrafo eléctrico'
          ?['Subgrafo eléctrico',(Number(meta.nodes)||0)+' nodos · '+(Number(meta.edges)||0)+' conexiones · profundidad '+(payload.depth??1)]
          :row);
        const graphSelected={...current,rows:graphRows,metrics:[
          {label:'Nodos del subgrafo',value:String(Number(meta.nodes)||0),unit:'',accent:'#9B2247'},
          {label:'Conexiones',value:String(Number(meta.edges)||0),unit:'',accent:'#E0A12E'},
          {label:'Asociaciones altas',value:String(payload.highConfidenceAssociations??0),unit:'',accent:'#0E8A6E'},
          {label:'Por revisar',value:String(payload.reviewAssociations??0),unit:'',accent:'#A57F2C'}
        ]};
        this.setState({selected:graphSelected},()=>this._recompute());
        const features=payload&&payload.geoJson&&payload.geoJson.features||[];
        const graphResult={nodes:[],edges:[]};
        features.forEach(feature=>{
          const p=feature.properties||{};
          if(p.element_type==='edge') graphResult.edges.push({...p,geometry:feature.geometry});
          else if(p.element_type==='node'&&feature.geometry&&feature.geometry.type==='Point'){
            const coordinates=feature.geometry.coordinates||[];
            graphResult.nodes.push({
              nodeId:p.node_id,name:p.name,latitude:Number(coordinates[1]),longitude:Number(coordinates[0]),isVirtual:!!p.is_virtual
            });
          }
        });
        if(graphResult.nodes.length||graphResult.edges.length) this._renderGraphFocus(graphResult);
      }).catch(error=>{
        if(this._pamGraphRequestId!==requestId||!this.state.selected||this.state.selected.name!==selected.name) return;
        const current=this.state.selected||selected;
        const graphRows=(current.rows||rows).map(row=>row[0]==='Subgrafo eléctrico'
          ?['Subgrafo eléctrico','No disponible · '+(error.message||error)]
          :row);
        this.setState({selected:{...current,rows:graphRows}});
      });
      const evidenceRequestId=(this._pamEvidenceRequestId||0)+1;
      this._pamEvidenceRequestId=evidenceRequestId;
      fetch('/DashboardProyectos/PamTerritorial/'+encodeURIComponent(projectId)+'/EvidenciaConvocatoria',{
        credentials:'same-origin',headers:{Accept:'application/json'}
      }).then(async response=>{
        const payload=await response.json().catch(()=>null);
        if(!response.ok) throw new Error(payload&&payload.detail?payload.detail:'HTTP '+response.status);
        return payload;
      }).then(payload=>{
        if(this._pamEvidenceRequestId!==evidenceRequestId||!this.state.selected||this.state.selected.name!==selected.name) return;
        const matches=Array.isArray(payload&&payload.coincidencias)?payload.coincidencias:[];
        const best=matches[0]||null;
        const evidenceText=matches.length
          ?(Number(payload.coincidenciasAltas||0)+' alta · '+Number(payload.requierenRevision||0)+' por revisar'
            +(best&&best.preFolio?' · '+best.preFolio:''))
          :'Sin coincidencias trazables';
        const networkText=best
          ?[
              best.subestacionDeclarada||best.puntoInterconexion||best.elementoRedCatalogado||'elemento sin nombre',
              best.estadoElementoRed||'sin diagnóstico',
              best.tensionKv!=null?Number(best.tensionKv).toLocaleString('es-MX',{maximumFractionDigits:2})+' kV':''
            ].filter(Boolean).join(' · ')
          :'Sin infraestructura compartida identificada';
        const current=this.state.selected||selected;
        const evidenceRows=(current.rows||rows).map(row=>{
          if(row[0]==='Segunda convocatoria') return ['Segunda convocatoria',evidenceText];
          if(row[0]==='Diagnóstico de red') return ['Diagnóstico de red',networkText];
          return row;
        });
        this.setState({selected:{...current,rows:evidenceRows}});
      }).catch(error=>{
        if(this._pamEvidenceRequestId!==evidenceRequestId||!this.state.selected||this.state.selected.name!==selected.name) return;
        const current=this.state.selected||selected;
        const evidenceRows=(current.rows||rows).map(row=>
          row[0]==='Segunda convocatoria'||row[0]==='Diagnóstico de red'
            ?[row[0],'No disponible · '+(error.message||error)]
            :row);
        this.setState({selected:{...current,rows:evidenceRows}});
      });
    }
  }
  _focusPamItem(item){
    this._fetchPamDetail(item).then(fullItem=>{
      const option=this._pamShortcutOption(fullItem);
      if(!option) throw new Error('El proyecto PAM no tiene una ubicación ni una GCR reconocible');
      if(!this.state.layers.pam.on) this.toggleLayer('pam');
      this._selectPamItem(fullItem);
      this._setHighlight(option.lat,option.lng,'#6B3654');
      if(option.located) this._clearPamRegionalFocus();
      else this._showPamRegionalFocus(option);
      try{
        const bounds=window.L.geoJSON(option.geometry).getBounds();
        if(bounds&&bounds.isValid()) this.map.fitBounds(bounds.pad(.18),{animate:true,maxZoom:13});
        else this.map.setView([option.lat,option.lng],option.zoom||8,{animate:true});
      }catch(e){ this.map.setView([option.lat,option.lng],option.zoom||8,{animate:true}); }
      this._toast(option.located
        ?(option.precision==='asociada al catálogo de red'
          ?'Proyecto PAM asociado con la red · coincidencia de confianza alta pendiente de validación'
          :option.precision==='asociada mediante Segunda Convocatoria'
            ?'Proyecto PAM enriquecido con Segunda Convocatoria · evidencia pendiente de validación'
            :'Proyecto PAM localizado · abre la ficha o analiza su entorno')
        :'Proyecto PAM sin asociación de confianza alta · mostrando su GCR aproximada');
    }).catch(error=>this._toast('No se pudo localizar el proyecto PAM: '+(error.message||error)));
  }
  _analyzePamOption(option){
    if(!option||!option.pamItem) return;
    const item=option.pamItem;
    const key=item.claveProyecto||('PAM '+item.proyectoId);
    if(option.analysisMode==='point'){
      const radiusKm=Math.max(1,Number(option.radiusKm)||20);
      this.setState({analysis:{...this.state.analysis,radiusKm}},()=>this._anaPlace(option.lat,option.lng,{
        kind:'pam',
        label:key+' · '+(item.nombreProyecto||'Proyecto PAM'),
        detail:'Proyecto PAM con ubicación '+option.precision+' · radio sugerido '+radiusKm+' km',
        state:option.state||'',
        municipality:option.municipality||''
      }));
      return;
    }
    this._anaPlaceTerritory({
      ...option,
      kind:option.located?'pam':'pam-regional',
      label:key+' · '+(item.nombreProyecto||'Proyecto PAM'),
      detail:option.located
        ?option.detail
        :'Ubicación regional aproximada; falta validar coordenadas o geometría del proyecto'
    });
  }
  _analyzePamById(projectId){
    const id=Number(projectId);
    if(!Number.isFinite(id)||id<=0) return;
    const cached=(this.state.pamCatalog||[]).find(item=>Number(item.proyectoId)===id);
    const load=cached
      ?this._fetchPamDetail(cached)
      :this._fetchPamDetail({proyectoId:id,ubicaciones:[]});
    load.then(item=>{
      const option=this._pamShortcutOption(item);
      if(!option) throw new Error('El proyecto no tiene ubicación ni GCR reconocible');
      try{ this.map.closePopup(); }catch(e){}
      this._analyzePamOption(option);
    }).catch(error=>this._toast('No se pudo preparar el análisis PAM: '+(error.message||error)));
  }
  _stateAt(lat, lng) {
    if (!this.geo || !this.geo.estados) return null;
    for (const f of (this.geo.estados.features||[])) {
      if (this._inFeature(lng, lat, f.geometry)) return this._propEnt(f.properties);
    }
    return null;
  }

  // ════════════════════ helpers de propiedades ════════════════════
  _kvOf(p){ if(!p) return 0; for(const k in p){ if(/tens|volt|kv/i.test(k)){ const n=parseFloat(String(p[k]).replace(/[^\d.]/g,'')); if(!isNaN(n)) return n; } } return 0; }
  _nameOf(p, fb){ if(!p) return fb; for(const k in p){ if(/nombre|name|nomgeo|clave|subest|linea/i.test(k) && p[k]) return String(p[k]); } return fb; }
  _propEnt(p){ if(!p) return null; for(const k in p){ if(/nomgeo|entidad|estado|nom_ent|edo/i.test(k) && p[k]) return String(p[k]); } return null; }
  _colorForKv(kv){ return (this.KV_COLORS.find(c=>kv>=c.min)||this.KV_COLORS[this.KV_COLORS.length-1]).color; }
  _lineWeightForKv(kv){
    const value=Number(kv)||0;
    if(value>=400) return 4.2;
    if(value>=230) return 3.35;
    if(value>=138) return 2.8;
    if(value>=60) return 2.15;
    if(value>=13.2) return 1.65;
    return 1.35;
  }
  _voltageLabelMinZoom(kv){
    const value=Number(kv)||0;
    if(value>=400) return 6;
    if(value>=230) return 7;
    if(value>=138) return 8;
    if(value>=60) return 8;
    if(value>=13.2) return 10;
    return 11;
  }
  _networkLevelLabel(level){
    return ({
      transmision:'Transmisión',
      subtransmision:'Subtransmisión',
      distribucion:'Distribución'
    })[String(level||'').toLowerCase()]||'Nivel por determinar';
  }
  _networkLevelColor(level){
    return ({
      transmision:'#9B2247',
      subtransmision:'#E0A12E',
      distribucion:'#2E6FB0'
    })[String(level||'').toLowerCase()]||'#8A9099';
  }
  _subStyle(kv){ return { radius: kv>=400?5.5:(kv>=230?4.5:3.6), color:'#fff', weight:1, fillColor:this._colorForKv(kv), fillOpacity:.95 }; }
  _norm(s){ return String(s||'').toLowerCase().normalize('NFD').replace(/[\u0300-\u036f]/g,'').replace(/[^a-z0-9]/g,''); }
  _tecLabel(t){ if(!t) return '—'; const m={FV:'Fotovoltaica',EO:'Eólica',CC:'Ciclo combinado',HID:'Hidroeléctrica',GEO:'Geotérmica',CSP:'Solar concentración',COG:'Cogeneración'}; return m[t] || this._techFull(t) || '—'; }
  _tecColor(t){ return ({FV:'#E0A12E',EO:'#1E9CB8',CC:'#8A9099',HID:'#2E6FB0',GEO:'#C0552E',CSP:'#D98A2B',COG:'#9AAE3B',CI:'#5E6671',BIO:'#5B9A43',H2:'#3BA98C',CARB:'#3A3A3A',NUC:'#7E3B52',TER:'#B0683A',IMP:'#6F6B66'}[t]||'#9B2247'); }
  // Mapea el texto de Tecnología/Energético del GeoJSON de centrales a un código del sistema de diseño
  _centralTech(p){
    const s = this._norm((p && (p['Tecnología'] || p.Tecnologia || p.tecnologia || p.technology || p.Energetico_primario || p.FuenteEnergia)) || '');
    if (!s) return 'TER';
    if (/fotovolt|solarfv/.test(s) || s==='sol') return 'FV';
    if (/concentrac|termosolar|csp/.test(s)) return 'CSP';
    if (/solar/.test(s)) return 'FV'; // «ENERGÍA SOLAR» y variantes genéricas (sin concentración) → fotovoltaica
    if (/eolic|viento|cinetic/.test(s)) return 'EO';
    if (/hidro|agua/.test(s)) return 'HID';
    if (/geoterm/.test(s)) return 'GEO';
    if (/cogener/.test(s)) return 'COG';
    if (/ciclocombinado|combinado/.test(s)) return 'CC';
    if (/nuclear|uranio/.test(s)) return 'NUC';
    if (/carbon|carboelectr|coque/.test(s)) return 'CARB';
    if (/biomasa|bagazo|biogas|licornegro|metano/.test(s)) return 'BIO';
    if (/hidrogeno/.test(s)) return 'H2';
    if (/import/.test(s)) return 'IMP';
    if (/combustioninterna|diesel|turbogas|gasnatural|gas|combustoleo|vapor|termo/.test(s)) return 'TER';
    return 'TER';
  }
  _centralCapacity(p){
    if(!p) return null;
    const raw=p.Capacidad_autorizada_MW ?? p.Capacidad_operacion_MW ?? p.Capacidad_autorizada_MW_1 ?? p.capacidad_mw ?? p.Capacidad_MW;
    if(raw==null||String(raw).trim()==='') return null;
    const n=typeof raw==='number'?raw:parseFloat(String(raw).replace(/,/g,'').replace(/[^\d.\-]/g,''));
    return Number.isFinite(n)&&n>0?n:null;
  }
  _techFull(code){ return ({FV:'Fotovoltaica',CSP:'Solar concentración',EO:'Eólica',HID:'Hidroeléctrica',GEO:'Geotérmica',COG:'Cogeneración',CC:'Ciclo combinado',NUC:'Nucleoeléctrica',CARB:'Carboeléctrica',BIO:'Bioenergía',H2:'Hidrógeno',IMP:'Importación',TER:'Termoeléctrica'}[code]||code); }
  _gerenciaOf(nom){ const n=this._norm(nom); for(const [k,toks] of this.GCR_ASSIGN){ if(toks.some(t=>n.includes(t))) return k; } return 'central'; }
  _gcrColor(nom){ return this.GCR_COLORS[this._gerenciaOf(nom)] || '#0E8A6E'; }
  _gerName(p){ if(!p) return ''; for(const k in p){ if(p[k] && /gerencia|control|region|field1|nombre|name/i.test(k)) return String(p[k]); } return String(Object.values(p)[0]||''); }
  // Resuelve la clave GCR a partir del nombre del feature ("Gerencia de Control Regional Baja California Sur")
  _gcrKeyFromName(name){
    const n = this._norm(name); // ej. gerenciadecontrolregionalbajacaliforniasur
    const aliases={bc:'bcalifornia',bs:'bcsur',bcs:'bcsur',no:'noroeste',ne:'noreste',nt:'norte',pe:'peninsular',or:'oriental',oc:'occidental',ce:'central',vm:'central',se:'oriental'};
    if(aliases[n]) return aliases[n];
    const order = [['bcsur',['bajacaliforniasur']],['mulege',['mulege']],['bcalifornia',['bajacalifornia']],['noroeste',['noroeste']],['noreste',['noreste']],['norte',['norte']],['peninsular',['peninsular']],['oriental',['oriental']],['occidental',['occidental']],['central',['central']]];
    for(const [k,toks] of order){ if(toks.some(t=>n.includes(t))) return k; }
    return '';
  }
  _selectGerencia(k, nom){
    this._clearHighlight(); this._syncMenu('', k);
    const subs = this.subFeatures ? this.subFeatures.filter(s => this._gerenciaOf(s.ent)===k).length : 0;
    const d = window.GCR_DATA && window.GCR_DATA.regiones && window.GCR_DATA.regiones[k];
    const rows = [
      ['Tipo de infraestructura','Gerencia de Control Regional'],
      ['Región de control', nom],
      ['Subestaciones (aprox.)', String(subs)],
    ];
    if (d) rows.push(['Adición de capacidad', d.mw.toLocaleString('es-MX')+' MW']);
    rows.push(['Fuente','CENACE'],['Actualización','2026-01-01']);
    const st = (this.GCR_ASSIGN.find(a => a[0]===k) || [null,[]])[1].length;
    const perm = this.state.datasets.filter(dd=>dd.active).reduce((a,dd)=>a+dd.rows.filter(r=>this._gerenciaOf(this.CVE_ENT[r.cve_ent])===k).length,0);
    const metrics = [
      { label:'Subestaciones (aprox.)', value:String(subs), unit:'', accent:'#9B2247' },
      { label:'Adición de capacidad', value: d? this._nf(d.mw):'—', unit: d?'MW':'', accent:'#E0A12E' },
      { label:'Estados en la región', value:String(st), unit:'', accent:'#1E9CB8' },
      { label:'Permisos/proyectos', value:String(perm), unit:'', accent:'#0E8A6E' },
    ];
    this.setState({ selected:{ kicker:'Gerencia de control', color:this.GCR_COLORS[k]||'#9B2247', name:'GCR '+nom, rows, metrics } });
  }

  // ════════════════════ selección → panel derecho ════════════════════
  _enrich(idSub) {
    // Cruza datasets externos activos por id_subestacion (join cliente)
    const out = {};
    this.state.datasets.filter(d => d.active && d.keyField==='id_subestacion').forEach(d => {
      const row = d.rows.find(r => String(r.id_subestacion)===String(idSub));
      if (row) Object.assign(out, row);
    });
    return out;
  }
  _selectSub(rec, m) {
    if (this._handler) return; // dibujando/midiendo: los clics no seleccionan
    this._selAt = performance.now();
    this._clearHighlight(); this._syncMenu(rec.ent, this._gerenciaOf(rec.ent));
    const ex = this._enrich(rec.idx);
    const cap = ex.capacidad_mw || ex.capacidad_mva;
    const sel = {
      kicker:'Subestación eléctrica', color:'#9B2247', name:rec.name,
      rows:[
        ['Tipo de infraestructura','Subestación de transmisión'],
        ['Entidad federativa', rec.ent || '—'],
        ['Municipio', ex.municipio || ex.zona_carga || '—'],
        ['Capacidad', cap ? (cap+(ex.capacidad_mva?' MVA':' MW')) : '—'],
        ['Tensión', rec.kv ? rec.kv+' kV' : '—'],
        ['Estatus', ex.estatus || 'En operación'],
        ['Propietario', ex.propietario || 'CFE Transmisión'],
        ['Fuente', ex.fuente || 'DGMESNIE · Dir. Gral. de Metodología y Estadísticas del SNIE'],
        ['Actualización', ex.fecha_actualizacion || '2026-01-01'],
      ],
      lat:rec.lat, lng:rec.lng, idx:rec.idx,
    };
    const dist = this._nearestSub({ lat:rec.lat, lng:rec.lng, idx:rec.idx });
    const joined = this.state.datasets.filter(d => d.active && d.keyField==='id_subestacion' && d.rows.some(r => String(r.id_subestacion)===String(rec.idx))).length;
    sel.metrics = [
      { label:'Capacidad instalada', value: cap? this._nf(cap):'—', unit: cap?(ex.capacidad_mva?'MVA':'MW'):'', accent:'#9B2247' },
      { label:'Tensión nominal', value: rec.kv? this._nf(rec.kv):'—', unit: rec.kv?'kV':'', accent:'#E0A12E' },
      { label:'Subestación más cercana', value: dist==null?'—':dist.toFixed(1), unit: dist==null?'':'km', accent:'#1E9CB8' },
      { label:'Registros vinculados', value: String(joined), unit:'', accent:'#0E8A6E' },
    ];
    this._flash(m);
    this.setState({ selected:sel }, () => this._recompute());
    this.map.setView([rec.lat, rec.lng], Math.max(this.map.getZoom(), 7), { animate:true });
  }
  _selectLine(rec, pl) {
    if (this._handler) return; // dibujando/midiendo: los clics no seleccionan
    this._selAt = performance.now();
    this._clearHighlight(); this._syncMenu('', '');
    const sel = { kicker:'Línea de transmisión', color:'#E0A12E', name:rec.name,
      rows:[
        ['Tipo de infraestructura','Línea de transmisión (LT)'],
        ['Tensión', rec.kv ? rec.kv+' kV' : '—'],
        ['Longitud', rec.km ? rec.km.toFixed(1)+' km' : '—'],
        ['Estatus','En operación'],
        ['Fuente','DGMESNIE · Dir. Gral. de Metodología y Estadísticas del SNIE'],
        ['Actualización','2026-01-01'],
      ] };
    const band = (this.KV_COLORS.find(b => (rec.kv||0) >= b.min) || {}).label || '—';
    sel.metrics = [
      { label:'Longitud del tramo', value: rec.km? rec.km.toFixed(1):'—', unit: rec.km?'km':'', accent:'#E0A12E' },
      { label:'Tensión nominal', value: rec.kv? this._nf(rec.kv):'—', unit: rec.kv?'kV':'', accent:'#9B2247' },
      { label:'Clasificación', value: band, unit:'', accent:'#1E9CB8' },
    ];
    this.setState({ selected:sel }, () => this._recompute());
  }
  _selectEstado(nom, f, lyr) {
    this._clearHighlight(); this._syncMenu(nom, this._gerenciaOf(nom));
    const gk = this._gerenciaOf(nom);
    const subs = this.subFeatures ? this.subFeatures.filter(s => s.ent===nom).length : 0;
    const sel = { kicker:'Gerencia de control', color:this.GCR_COLORS[gk], name:'GCR '+(this.GCR_NOMBRE[gk]||'—'),
      rows:[
        ['Tipo de infraestructura','Gerencia de Control Regional'],
        ['Entidad federativa', nom],
        ['Subestaciones en entidad', String(subs)],
        ['Fuente','CENACE · Marco geoestadístico INEGI'],
        ['Actualización','2026-01-01'],
      ] };
    const perm = this.state.datasets.filter(dd=>dd.active).reduce((a,dd)=>a+dd.rows.filter(r=>this.CVE_ENT[r.cve_ent]===nom).length,0);
    sel.metrics = [
      { label:'Subestaciones en entidad', value:String(subs), unit:'', accent:'#9B2247' },
      { label:'Permisos/proyectos', value:String(perm), unit:'', accent:'#0E8A6E' },
    ];
    this.setState({ selected:sel });
  }
  // Getters tolerantes al esquema: buscan el primer campo cuyo NOMBRE coincide con el patrón y
  // cuyo valor no esté vacío ni sea "SIN INFORMACIÓN" (convocatorias/GAT traen otros nombres).
  _dsField(row, re){ for(const k in row){ if(re.test(k)){ const v=row[k]; if(v!=null && String(v).trim() && String(v).trim()!=='SIN INFORMACIÓN') return v; } } return null; }
  _dsNum(row, re){ const v=this._dsField(row, re); if(v==null) return null; const n=parseFloat(String(v).replace(/[^\d.\-]/g,'')); return (isFinite(n) && n!==0) ? n : null; }
  _dsCapacityMw(row){
    const direct=Number(row && row.capacidad_mw);
    if(isFinite(direct) && direct>0) return direct;
    // Las convocatorias pueden traer cientos de columnas que sólo MENCIONAN "capacidad"
    // (perfiles, documentos y SAEE). Se priorizan los campos eléctricos escalares y se
    // descartan URLs/textos para no convertir sus dígitos en un supuesto valor de MW.
    const patterns=[
      /^capacidad generaci[oó]n$/i,
      /^capacidad instalada neta$/i,
      /^capacidad instalada$/i,
      /^capacidad contratada$/i,
      /^capacidad en mw(?:_\d+)?$/i,
      /^capacidad\s*\(mw\)$/i,
      /^mw$/i,
    ];
    for(const re of patterns){
      const raw=this._dsField(row,re);
      if(raw==null || /https?:\/\//i.test(String(raw))) continue;
      const clean=String(raw).trim().replace(/\s/g,'').replace(/,(?=\d{3}(?:\D|$))/g,'').replace(',','.');
      const n=Number(clean.replace(/[^\d.\-]/g,''));
      if(isFinite(n) && n>0 && n<=100000) return n;
    }
    return null;
  }
  _selectDatasetFeature(row, ds, ll) {
    if (this._handler) return; // dibujando/midiendo: los clics no seleccionan
    this._selAt = performance.now();
    const entN = this.CVE_ENT[row.cve_ent] || this._dsField(row, /entidad|nom_ent|^estado$/i) || '';
    this._clearHighlight(); this._syncMenu(entN, entN?this._gerenciaOf(entN):'');
    const isProj = ds.target==='proyectos';
    const tec = this._dsRowTech(row);
    const cap = this._dsCapacityMw(row);
    const kv  = (+row.tension_kv) || this._dsNum(row, /tensi[oó]n|(^|[^a-z])kv/i);
    const est = row.estatus || this._dsField(row, /decisi[oó]n minuta/i) || this._dsField(row, /estatus|^status|etapa|situaci|estado del/i);
    const inv = (+row.inversion_mdp) || this._dsNum(row, /inversi[oó]n/i);
    const fol = row.clave_permiso || this._dsField(row, /folio|clave/i);
    const mun = row.municipio || this._dsField(row, /municipio/i);
    const rows = [
      ['Tipo de infraestructura', isProj ? 'Proyecto de convocatoria' : 'Permiso de generación'],
      ['Tecnología', tec ? this._tecLabel(tec) : '—'],
      ['Entidad federativa', entN || '—'],
      ['Municipio', mun || '—'],
      ['Capacidad', cap ? this._nf(cap)+' MW' : '—'],
      ['Tensión', kv ? this._nf(kv)+' kV' : '—'],
      ['Estatus', est || '—'],
      [isProj?'Folio / clave':'Clave', fol || '—'],
      ['Fuente', row.fuente || ds.name],
      ['Actualización', row.fecha_actualizacion || this._dsField(row, /fecha decisi[oó]n minuta/i) || this._dsField(row, /actualizaci|^fecha/i) || '—'],
    ];
    if (inv) rows.splice(8, 0, ['Inversión', '$'+this._nf(inv)+' MDP']);
    // Campos adicionales del esquema (PVIRCE y similares) — sólo se agregan si existen
    const extras = [
      ['Año', this._dsField(row, /^año$|^anio$/i)],
      ['Mes', this._dsField(row, /^mes$/i)],
      ['Movimiento', this._dsField(row, /adiciones o sustituciones|movimiento/i)],
      ['Grupo / empresa (GIE)', this._dsField(row, /^gie$|grupo de inter/i)],
      ['Renovable', this._dsField(row, /^renovable$/i)],
      ['Gerencia de control', this._dsField(row, /gerencia/i)],
      ['Región de transmisión', this._dsField(row, /regi[oó]n de transmisi/i)],
      ['Contrato / unidad', this._dsField(row, /contrato/i)],
    ].filter(x => x[1]!=null);
    extras.forEach((x,i) => rows.splice(7+i, 0, [x[0], String(x[1])]));
    const metrics = [
      { label:'Capacidad', value: cap?this._nf(cap):'—', unit: cap?'MW':'', accent:'#9B2247' },
      { label:'Tensión', value: kv?this._nf(kv):'—', unit: kv?'kV':'', accent:'#E0A12E' },
    ];
    if (inv) metrics.push({ label:'Inversión', value:this._nf(inv), unit:'MDP', accent:'#1E9CB8' });
    if (inv && cap) metrics.push({ label:'Costo unitario', value:(inv/cap).toFixed(1), unit:'MDP/MW', accent:'#0E8A6E' });
    this.setState({ selected:{ kicker:isProj?'Proyecto de convocatoria':'Permiso de generación', color:this._tecColor(tec), name: this._dsRowName(row), rows, metrics } }, () => this._recompute());
  }
  _flash(m){ if(!m) return; const o=m.options.radius; m.setStyle({ radius:o+4, color:'#9B2247', weight:2.5 }); setTimeout(()=>m.setStyle({ radius:o, color:'#fff', weight:1 }),900); }
  // ── Resaltado del elemento buscado (halo pulsante) ──
  _setHighlight(lat, lng, color){
    const L = window.L; this._clearHighlight();
    if (lat==null || lng==null) return;
    this._hl = L.marker([lat, lng], { pane:'hl', interactive:false, icon: L.divIcon({ className:'', iconSize:[0,0], html:'<div class="dg-pulse" style="--c:'+(color||'#9B2247')+'"><i></i><i></i><i></i></div>' }) }).addTo(this.map);
  }
  _clearHighlight(){
    if (this._hl) { this.map.removeLayer(this._hl); this._hl = null; }
    this._clearPamRegionalFocus();
  }
  // Coherencia mapa ↔ menú: al seleccionar algo, limpia el buscador y ajusta los combos al contexto del elemento
  _syncMenu(entName, gerKey){
    const s=this.state;
    if (s.search==='' && s.filtroEnt===(entName||'') && s.filtroGer===(gerKey||'')) return;
    this.setState({ search:'', filtroEnt: entName||'', filtroGer: gerKey||'' }, () => this._applyFilters());
  }

  // ════════════════════ toggles de capa ════════════════════
  toggleLayer(key) {
    const layers = { ...this.state.layers };
    const willOn = !layers[key].on;
    layers[key] = { ...layers[key], on: willOn };
    const cfg = this.LAYERS.find(l => l.key===key);
    this._invalidateSearch();
    this._syncMarketLayerToggle(key,willOn,layers);

    // Sincroniza el panel "Datasets externos": una capa de tipo dataset (permisos/proyectos)
    // encendida o apagada desde "Capas disponibles" debe reflejarse en el check de cada
    // dataset vinculado a esa capa, para que ambos paneles nunca queden en desacuerdo.
    let datasetsSync = null;
    if (cfg && cfg.type==='dataset' && this.state.datasets.some(d => d.target===key)) {
      datasetsSync = this.state.datasets.map(d => d.target===key ? { ...d, active: willOn } : d);
    }
    if (cfg && cfg.type==='dataset' && datasetsSync) {
      this.setState({ layers, datasets:datasetsSync }, () => this._renderDataset({ target:key }));
      return;
    }

    // Municipios: capa pesada → se prende/apaga por VISIBILIDAD del pane (nunca se quita del mapa → sin errores _removePath)
    if (key==='municipios') {
      if (willOn && !this._built.municipios) { this.setState({ layers, blocking:{ label:'Descargando y dibujando '+cfg.label+(cfg.heavy?' · '+cfg.heavy:'')+'…' } }, () => this._lazyBuild(key, cfg)); return; }
      this.setState({ layers, blocking: willOn ? { label:'Cargando capa: '+cfg.label+'…' } : null });
      setTimeout(() => { this._muniPaneShow(willOn); setTimeout(() => this.setState({ blocking:null }, () => this._recompute()), willOn?160:0); }, willOn?40:0);
      return;
    }

    if (willOn) {
      const summarizedGeo=this._analysisFilteredGeo&&this._analysisFilteredGeo[key];
      if(cfg&&['geo','graph'].includes(cfg.type)&&layers[key].summarized&&summarizedGeo){
        this.setState({ layers, blocking:{ label:'Dibujando '+cfg.label+' desde el resultado del análisis…' } });
        setTimeout(()=>{
          try{
            if(cfg.type==='graph') this._buildElectricGraph(key,summarizedGeo,cfg);
            else this._buildGeneric(key,summarizedGeo,cfg,{render:true});
            const g=this._layerOf(key); if(g) g.addTo(this.map);
            this._built[key]=true;
            this._forceVectorRedraw(key);
            const next={...this.state.layers,[key]:{...this.state.layers[key],on:true,summarized:false}};
            this.setState({layers:next,blocking:null},()=>this._recompute());
          }catch(error){
            const next={...this.state.layers,[key]:{...this.state.layers[key],on:false}};
            this.setState({layers:next,blocking:null});
            this._toast('No se pudo dibujar '+cfg.label+': '+(error.message||error));
          }
        },40);
        return;
      }
      if (cfg && cfg.lazy && !this._built[key]) { this.setState({ layers, blocking:{ label:'Descargando y dibujando '+cfg.label+(cfg.heavy?' · '+cfg.heavy:'')+'…' } }, () => this._lazyBuild(key, cfg)); return; }
      // Preloader en CADA activación de capa: muestra, renderiza y libera al pintar
      this.setState(datasetsSync ? { layers, datasets:datasetsSync, blocking:{ label:'Cargando capa: '+cfg.label+'…' } } : { layers, blocking:{ label:'Cargando capa: '+cfg.label+'…' } });
      setTimeout(() => {
        const g = this._layerOf(key); if (g) g.addTo(this.map);
        if (key==='zonas') this._buildZonas();
        this._forceVectorRedraw(key); // capas canvas re-agregadas necesitan redibujo para pintar en la vista actual
        setTimeout(() => { this._forceVectorRedraw(key); this.setState({ blocking:null }, () => this._recompute()); }, 160);
      }, 40);
    } else {
      const g = this._layerOf(key);
      try { if (g && this.map.hasLayer(g)) this.map.removeLayer(g); } catch(err){ try{ g.clearLayers&&g.clearLayers(); }catch(e2){} }
      if(cfg&&cfg.type==='graph') this._clearGraphFocus();
      const pamWasSelected=key==='pam'&&this._isPamSelection();
      if(key==='pam'){
        this._clearPamInteraction();
        if(pamWasSelected) this._clearHighlight();
      }
      if(key==='tarifas_atlas') this._clearTariffDivisionFocus();
      if(key==='demanda_atlas') this._clearDemandRegionFocus();
      if(key==='generacion_distribuida_atlas'){
        this._clearDistributedGenerationFocus();
      }
      const nextState=datasetsSync ? { layers, datasets:datasetsSync } : { layers };
      if(pamWasSelected){
        nextState.selected=null;
        nextState.collapsed={...this.state.collapsed,detalle:true};
      }
      this.setState(nextState, () => this._recompute());
    }
  }
  // Barra de carga por capa (indeterminada). Para geometrías ya en memoria es breve.
  _showBar(label){ clearTimeout(this._barT); this.setState({ layerBar:{ label } }); }
  _hideBar(){ this.setState({ layerBar:null }); }
  _flashBar(label){ this._showBar('Activando '+label); clearTimeout(this._barT); this._barT=setTimeout(()=>this._hideBar(), 650); }
  // Carga diferida de capas pesadas (p.ej. municipios ~26 MB) — patrón reutilizable
  // para tu lista larga de GeoJSON. MIGRACIÓN: GET /api/layers/{key}.geojson
  _lazyBuild(key, cfg) {
    const layers = { ...this.state.layers }; layers[key] = { ...layers[key], loading:true };
    // Preloader BLOQUEANTE en TODA descarga de capa (feedback claro + evita doble clic que la apague)
    this.setState({ layers, blocking: { label:'Descargando y dibujando '+cfg.label+(cfg.heavy?' · '+cfg.heavy:'')+'…' } });
    const done = (geo) => {
      try {
        if (key==='municipios') this._buildMunicipios(geo);
        else if (cfg.type==='graph') this._buildElectricGraph(key, geo, cfg);
        else this._buildGeneric(key, geo, cfg);
        this._built[key] = true;
      } catch(e){ return fail(e); }
      const obj = this._layerOf(key); if (obj) { try { obj.addTo(this.map); } catch(e){} }
      try { this._forceVectorRedraw(key); } catch(e){}
