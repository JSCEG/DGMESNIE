        : 'FASE 2 · LÍNEAS Y GRAFO GEOJSON',
      conv2ValidationSummary:(()=>{
        const values=S.conv2ReviewValidations||[];
        const count=decision=>values.filter(item=>item.decision===decision).length;
        return [
          count('confirmada')+' firmes',
          count('faltante_confirmada')+' faltantes confirmadas',
          count('rechazada')+' rechazadas',
          count('pendiente')+' pendientes registradas'
        ].join(' · ');
      })(),
      onConv2ReviewStatus:(e)=>this.setState({conv2ReviewStatus:e.target.value||'todos',conv2ReviewPage:0}),
      onConv2ReviewOnlyActive:(e)=>this.setState({conv2ReviewOnlyActive:!!e.target.checked,conv2ReviewPage:0}),
      onConv2ReviewOnlyUnresolved:(e)=>this.setState({conv2ReviewOnlyUnresolved:!!e.target.checked,conv2ReviewPage:0}),
      onConv2ReviewQuery:(e)=>this.setState({conv2ReviewQuery:e.target.value||'',conv2ReviewPage:0}),
      conv2DecisionOpen:!!S.conv2DecisionTarget,
      conv2DecisionBusy:!!S.conv2DecisionBusy,
      conv2DecisionErrorOn:!!S.conv2DecisionError,
      conv2DecisionError:S.conv2DecisionError||'',
      conv2DecisionNote:S.conv2DecisionNote||'',
      onConv2DecisionNote:(e)=>this.setState({conv2DecisionNote:e.target.value||'',conv2DecisionError:''}),
      onCloseConv2Decision:this.closeConv2Decision,
      onSaveConv2Decision:this.saveConv2Decision,
      ...(()=>{
        const target=S.conv2DecisionTarget||{};
        const decision=String(S.conv2DecisionKind||'');
        const isReject=decision==='rechazada';
        const isMissing=decision==='faltante_confirmada';
        const color=isReject?'#9B2247':(isMissing?'#A57F2C':'#0E735C');
        const note=String(S.conv2DecisionNote||'').trim();
        const disabled=!!S.conv2DecisionBusy||note.length<5;
        return {
          conv2DecisionColor:color,
          conv2DecisionKicker:isReject
            ? 'Rechazar evidencia'
            : (isMissing
                ? 'Confirmar ausencia en catálogo'
                : (String(target.tipoElemento||'')==='linea_transmision'
                    ? 'Confirmar línea de transmisión'
                    : 'Confirmar subestación')),
          conv2DecisionName:target.nombreDeclarado||(
            String(target.tipoElemento||'')==='linea_transmision'
              ? 'Línea de transmisión'
              : 'Subestación'
          ),
          conv2DecisionCatalog:target.claveCatalogo
            ? 'Coincidencia propuesta: '+(target.coincidenciaCatalogo||target.claveCatalogo)+' · '+String(target.puntaje||0)+' / 100'
            : (target.coincidenciaInterconexionPublicaFirme
                ? 'Instalación privada no catalogada. Interconexión pública resuelta por separado: '+(target.coincidenciaInterconexionCatalogo||target.nombreInterconexionPublica||'sin nombre')+'.'
                : 'No existe coincidencia de catálogo; la decisión la registrará como faltante confirmada.'),
          conv2DecisionPlaceholder:isReject
            ? 'Explica por qué la referencia no corresponde o no debe utilizarse…'
            : 'Indica el documento, criterio técnico o revisión cartográfica que sustenta la decisión…',
          conv2DecisionSaveDisabled:disabled,
          conv2DecisionSaveLabel:S.conv2DecisionBusy?'Guardando…':'Registrar decisión',
          conv2DecisionSaveStyle:'padding:8px 13px;border:1px solid '+(disabled?'#D8D3CC':color)+';background:'+(disabled?'#F2F0ED':color)+';color:'+(disabled?'#9A958E':'#fff')+';border-radius:8px;font-size:10.5px;font-weight:800;font-family:inherit;cursor:'+(disabled?'not-allowed':'pointer')
        };
      })(),
      conv2ReviewTypes:[
        {key:'subestacion',label:'Subestaciones',onClick:()=>this.setState({conv2ReviewType:'subestacion',conv2ReviewPage:0}),style:'padding:6px 10px;border:none;border-radius:6px;font-size:10.5px;font-weight:800;cursor:pointer;font-family:inherit;background:'+(S.conv2ReviewType==='subestacion'?'#fff':'transparent')+';color:'+(S.conv2ReviewType==='subestacion'?'#9B2247':'#6F6B66')+';box-shadow:'+(S.conv2ReviewType==='subestacion'?'0 1px 4px rgba(0,0,0,.12)':'none')},
        {key:'linea_transmision',label:'Líneas',onClick:()=>this.setState({conv2ReviewType:'linea_transmision',conv2ReviewPage:0}),style:'padding:6px 10px;border:none;border-radius:6px;font-size:10.5px;font-weight:800;cursor:pointer;font-family:inherit;background:'+(S.conv2ReviewType==='linea_transmision'?'#fff':'transparent')+';color:'+(S.conv2ReviewType==='linea_transmision'?'#9B2247':'#6F6B66')+';box-shadow:'+(S.conv2ReviewType==='linea_transmision'?'0 1px 4px rgba(0,0,0,.12)':'none')}
      ],
      conv2ReviewStats:(()=>{
        const d=S.conv2ReviewData||{};
        if(S.conv2ReviewType==='linea_transmision'){
          return [
            {label:'Referencias LT',value:Number(d.referenciasLinea||0).toLocaleString('es-MX'),color:'#E0A12E'},
            {label:'Líneas homologadas',value:Number(d.lineasCatalogadas||0).toLocaleString('es-MX'),color:'#0E735C'},
            {label:'Corredor base',value:Number(d.lineasCorredorCatalogado||0).toLocaleString('es-MX'),color:'#1E7188'},
            {label:'Conectadas · 2 extremos',value:Number(d.lineasConectadasGrafo||0).toLocaleString('es-MX'),color:'#0E8A6E'},
            {label:'Parciales · 1 extremo',value:Number(d.lineasParcialesGrafo||0).toLocaleString('es-MX'),color:'#1E9CB8'},
            {label:'Ambiguas',value:Number(d.lineasAmbiguasGrafo||0).toLocaleString('es-MX'),color:'#A57F2C'},
            {label:'Sin resolver',value:Number(d.lineasSinResolverGrafo||0).toLocaleString('es-MX'),color:'#9B2247'},
            {label:'Menciones sin geometría',value:Number(d.lineasSinGeometria||0).toLocaleString('es-MX'),color:'#8A9099'},
            {label:'Corredores pendientes',value:Number(d.lineasSinGeometriaLogicas||0).toLocaleString('es-MX'),color:'#9A3F27'},
            {label:'Corredores vigentes',value:Number(d.lineasSinGeometriaLogicasVigentes||0).toLocaleString('es-MX'),color:'#9B2247'}
          ];
        }
        return [
          {label:'Universo base',value:Number(d.proyectosUniverso||0).toLocaleString('es-MX'),color:'#6B3654'},
          {label:'Vigentes · Continúa',value:Number(d.proyectosContinuan||0).toLocaleString('es-MX'),color:'#0E8A6E'},
          {label:'Otros estatus',value:Number(d.proyectosOtrosEstatus||0).toLocaleString('es-MX'),color:'#A57F2C'},
          {label:'Sin decisión',value:Number(d.proyectosSinDecision||0).toLocaleString('es-MX'),color:'#8A9099'},
          {label:'Referencias SE',value:Number(d.referenciasSubestacion||0).toLocaleString('es-MX'),color:'#9B2247'},
          {label:'Referencias LT',value:Number(d.referenciasLinea||0).toLocaleString('es-MX'),color:'#E0A12E'},
          {label:'CFE RGD respalda',value:Number(d.subestacionesCfeRgdRespaldadas||0).toLocaleString('es-MX'),color:'#0E735C'},
          {label:'CFE RGD · vigentes',value:Number(d.subestacionesCfeRgdRespaldadasVigentes||0).toLocaleString('es-MX'),color:'#0E8A6E'},
          {label:'CFE RGD · revisión',value:Number(d.subestacionesCfeRgdRevision||0).toLocaleString('es-MX'),color:'#A57F2C'},
          {label:'CFE · territorio incompatible',value:Number(d.subestacionesCfeRgdTerritorioIncompatible||0).toLocaleString('es-MX'),color:'#9B2247'}
        ];
      })(),
      conv2ReviewHeaders:[
        {label:'Referencia declarada / folios',style:'width:19%;padding:8px 10px;text-align:left;font-size:8.5px;letter-spacing:.08em;text-transform:uppercase;color:#9B2247'},
        {label:'Automática / humana',style:'width:12%;padding:8px;text-align:left;font-size:8.5px;letter-spacing:.08em;text-transform:uppercase;color:#9B2247'},
        {label:'Coincidencia',style:'width:14%;padding:8px;text-align:left;font-size:8.5px;letter-spacing:.08em;text-transform:uppercase;color:#9B2247'},
        {label:'Puntaje / kV',style:'width:9%;padding:8px;text-align:left;font-size:8.5px;letter-spacing:.08em;text-transform:uppercase;color:#9B2247'},
        {label:'Territorio',style:'width:11%;padding:8px;text-align:left;font-size:8.5px;letter-spacing:.08em;text-transform:uppercase;color:#9B2247'},
        {label:'Proyectos / fuente',style:'width:10%;padding:8px;text-align:left;font-size:8.5px;letter-spacing:.08em;text-transform:uppercase;color:#9B2247'},
        {label:'Trazabilidad humana',style:'width:12%;padding:8px;text-align:left;font-size:8.5px;letter-spacing:.08em;text-transform:uppercase;color:#9B2247'},
        {label:'Acciones',style:'width:13%;padding:8px;text-align:center;font-size:8.5px;letter-spacing:.08em;text-transform:uppercase;color:#9B2247'}
      ],
      ...(()=>{
        const data=S.conv2ReviewData||{};
        const validations=S.conv2ReviewValidations||[];
        const validationByCandidate=new Map(
          validations.map(item=>[item.candidatoId,item])
        );
        const validationForCandidate=candidate=>{
          const direct=validationByCandidate.get(candidate.candidatoId);
          if(this._conv2ValidationMatchesCandidate(direct,candidate)) return direct;
          const compatible=validations.filter(item=>
            this._conv2ValidationMatchesCandidate(item,candidate)
          );
          return compatible.length===1?compatible[0]:null;
        };
        const query=this._norm(S.conv2ReviewQuery||'');
        const candidates=(data.candidatos||[])
          .filter(candidate=>String(candidate.tipoElemento||'')===(S.conv2ReviewType||'subestacion'))
          .filter(candidate=>(S.conv2ReviewStatus||'todos')==='todos'||String(candidate.estado||'')===S.conv2ReviewStatus)
          .filter(candidate=>!S.conv2ReviewOnlyActive||Number(candidate.proyectosVigentes||0)>0)
          .filter(candidate=>{
            if(S.conv2ReviewOnlyUnresolved===false) return true;
            const validation=validationForCandidate(candidate);
            return !validation||validation.decision==='pendiente';
          })
          .filter(candidate=>{
            if(!query) return true;
            const validation=validationForCandidate(candidate)||{};
            const source=[
              candidate.nombreDeclarado,
              candidate.coincidenciaCatalogo,
              candidate.nombreInterconexionPublica,
              candidate.coincidenciaInterconexionCatalogo,
              candidate.claveInterconexionCatalogo,
              candidate.gcr,
              candidate.entidad,
              candidate.municipio,
              candidate.claveAgrupacionLinea,
              ...(candidate.folios||[]),
              ...(candidate.decisiones||[]),
              ...(candidate.referenciasEquivalentesLinea||[]),
              ...(candidate.codigosCircuitoDeclarados||[]),
              candidate.auditoriaCfeRgd&&candidate.auditoriaCfeRgd.estado,
              ...((candidate.auditoriaCfeRgd&&candidate.auditoriaCfeRgd.hallazgos)||[]),
              ...((candidate.auditoriaCfeRgd&&candidate.auditoriaCfeRgd.coincidencias)||[])
                .flatMap(match=>[
                  match.division,
                  match.zona,
                  match.subestacion,
                  match.banco
                ]),
              validation.decision,
              validation.observacion,
              validation.usuarioNombre
            ].join(' ');
            return this._norm(source).includes(query);
          })
          .sort((a,b)=>{
            const active=Number(b.proyectosVigentes||0)-Number(a.proyectosVigentes||0);
            if(active) return active;
            const priority={revision:0,faltante:1,tramo_sin_geometria:1,corredor_catalogado:2,catalogada:3};
            const status=(priority[String(a.estado||'')]??9)-(priority[String(b.estado||'')]??9);
            if(status) return status;
            return Number(b.puntaje||0)-Number(a.puntaje||0);
          });
        const pageSize=50;
        const maxPage=Math.max(0,Math.ceil(candidates.length/pageSize)-1);
        const page=Math.max(0,Math.min(Number(S.conv2ReviewPage)||0,maxPage));
        const pageCandidates=candidates.slice(page*pageSize,(page+1)*pageSize);
        const buttonStyle=disabled=>'padding:5px 8px;border:1px solid '+(disabled?'#D8D3CC':'#A57F2C')+';background:'+(disabled?'#F2F0ED':'#fff')+';color:'+(disabled?'#9A958E':'#7A5D1D')+';border-radius:7px;font-size:9.5px;font-weight:800;cursor:'+(disabled?'not-allowed':'pointer')+';font-family:inherit';
        return {
          conv2ReviewCount:Number(candidates.length).toLocaleString('es-MX'),
          conv2ReviewEmpty:candidates.length===0,
          conv2ReviewPageLabel:candidates.length
            ? 'Página '+(page+1)+' de '+(maxPage+1)
            : 'Sin páginas',
          conv2ReviewPrevDisabled:page===0,
          conv2ReviewNextDisabled:page>=maxPage,
          conv2ReviewPrevStyle:buttonStyle(page===0),
          conv2ReviewNextStyle:buttonStyle(page>=maxPage),
          onConv2ReviewPrev:()=>this.setState({conv2ReviewPage:Math.max(0,page-1)}),
          onConv2ReviewNext:()=>this.setState({conv2ReviewPage:Math.min(maxPage,page+1)}),
          conv2ReviewRows:pageCandidates.map((candidate,index)=>{
            const meta=this._conv2StatusMeta(candidate.estado);
            const validation=validationForCandidate(candidate);
            const validationMeta=this._conv2ValidationMeta(validation&&validation.decision);
            const tension=candidate.tensionKv!=null?Number(candidate.tensionKv).toLocaleString('es-MX')+' kV':'—';
            const distance=candidate.distanciaInterconexionCalculadaMinimaKm!=null
              ? ' · '+Number(candidate.distanciaInterconexionCalculadaMinimaKm).toFixed(2)+'–'+Number(candidate.distanciaInterconexionCalculadaMaximaKm??candidate.distanciaInterconexionCalculadaMinimaKm).toFixed(2)+' km'
              : '';
            const graphState=String(candidate.estadoConexionGrafo||'');
            const graphLabel=graphState
              ? ' · GRAFO '+graphState.replaceAll('_',' ').toUpperCase()+' · '+String(candidate.extremosResueltosGrafo||0)+'/2 EXTREMOS'
              : '';
            const lineMatchLabel=candidate.coincidenciaParExtremosFirme
              ? ' · PAR DE EXTREMOS FIRME'
              : (candidate.coincidenciaCodigoCircuitoFirme
                  ? ' · CÓDIGO '+(candidate.codigosCircuitoDeclarados||[]).join('/')+' · CORREDOR BASE'
                  : '');
            const cfeState=String(
              candidate.auditoriaCfeRgd&&candidate.auditoriaCfeRgd.estado||''
            );
            const cfeLabel=cfeState==='respaldada'
              ? ' · CFE RGD RESPALDA · VALIDACIÓN PENDIENTE'
              : cfeState==='revision'
                ? ' · CFE RGD REVISIÓN'
                : cfeState==='territorio_incompatible'
                  ? ' · CFE RGD HOMÓNIMO TERRITORIAL'
                  : '';
            const graphEndpoints=[
              candidate.extremoADeclarado
                ? 'A: '+candidate.extremoADeclarado+(candidate.extremoACatalogo?' → '+candidate.extremoACatalogo:'')
                : '',
              candidate.extremoBDeclarado
                ? 'B: '+candidate.extremoBDeclarado+(candidate.extremoBCatalogo?' → '+candidate.extremoBCatalogo:'')
                : ''
            ].filter(Boolean).join(' · ');
            const hasGeometry=!!candidate.geometria||!!candidate.geometriaSubestacionPrivada||!!candidate.geometriaInterconexionPublica||!!candidate.geometriaTopologicaSugerida||!!candidate.geometriaProyectoFuente||!!candidate.geometriaSubestacionFuente;
            const candidateType=String(candidate.tipoElemento||'');
            const canValidate=candidateType==='subestacion'||candidateType==='linea_transmision';
            const hasCatalog=!!candidate.claveCatalogo;
            const confirmDecision=hasCatalog?'confirmada':'faltante_confirmada';
            let validationDetail='Sin decisión humana';
            if(validation){
              const date=validation.fechaDecisionUtc
                ? new Date(validation.fechaDecisionUtc).toLocaleString('es-MX',{dateStyle:'short',timeStyle:'short'})
                : '';
              validationDetail=[
                validation.observacion,
                [validation.usuarioNombre,date].filter(Boolean).join(' · ')
              ].filter(Boolean).join(' — ');
            }
            const actionStyle=(color,bg)=>'padding:5px 7px;border:1px solid '+color+';background:'+bg+';color:'+color+';border-radius:7px;font-size:8.8px;font-weight:800;cursor:pointer;font-family:inherit;line-height:1.15';
            return {
              nombre:candidate.nombreDeclarado||'Sin nombre',
              folios:(candidate.folios||[]).join(' · ')||'Sin folio',
              status:meta.label,
              statusBg:meta.bg,
              statusColor:meta.color,
              validationStatus:validationMeta.label,
              validationBg:validationMeta.bg,
              validationColor:validationMeta.color,
              catalogo:(candidate.coincidenciaCatalogo||(
                candidate.coincidenciaInterconexionPublicaFirme
                  ? 'Privada no catalogada · nodo público: '+(candidate.coincidenciaInterconexionCatalogo||candidate.nombreInterconexionPublica||'—')
                  : 'Sin coincidencia de catálogo'
              ))+(graphEndpoints?' · '+graphEndpoints:''),
              puntaje:String(candidate.puntaje||0)+' / 100 · '+tension+distance+(Number(candidate.mencionesEquivalentesLinea||1)>1?' · '+String(candidate.mencionesEquivalentesLinea)+' MENCIONES EQUIVALENTES':'')+lineMatchLabel+graphLabel+cfeLabel+(candidate.coincidenciaAnexoTecnicoFirme?' · ANEXO TÉCNICO FIRME':(candidate.coincidenciaCorroboracionMultifuenteFirme?' · MULTIFUENTE FIRME':(candidate.homonimoTerritorialDescartado?' · HOMÓNIMO DESCARTADO':(candidate.coincidenciaInterconexionPublicaFirme?' · INTERCONEXIÓN FIRME':(candidate.coincidenciaTopologicaFirme?' · TOPO FIRME':(candidate.coincidenciaTensionTopologicaFirme?' · kV POR RED':(candidate.coincidenciaFuenteGeorreferenciadaFirme?' · FUENTE GEO FIRME':(candidate.coincidenciaAutomaticaFirme?' · AUTO FIRME':'')))))))),
              territorio:[candidate.gcr,candidate.entidad,candidate.municipio].filter(Boolean).join(' · ')||'—',
              proyectos:String(candidate.proyectosRelacionados||0)+' total · '+String(candidate.proyectosVigentes||0)+' vigentes',
              decisiones:(candidate.decisiones||[]).join(' · ')||'Sin decisión',
              validationDetail,
              bg:index%2?'#FCFBF9':'#fff',
              locateDisabled:!hasGeometry,
              locateTitle:hasGeometry
                ? ((candidate.geometriaProyectoFuente||candidate.geometriaSubestacionFuente)&&!candidate.geometria
                    ? 'Localizar el contexto declarado; no representa el trazo físico de la línea'
                    : 'Localizar evidencia en el mapa')
                : 'Sin geometría disponible',
              locateStyle:'padding:5px 8px;border:1px solid '+(hasGeometry?'#9B2247':'#D8D3CC')+';background:'+(hasGeometry?'#fff':'#F2F0ED')+';color:'+(hasGeometry?'#9B2247':'#9A958E')+';border-radius:7px;font-size:9.5px;font-weight:800;cursor:'+(hasGeometry?'pointer':'not-allowed')+';font-family:inherit',
              onLocate:()=>this.locateConv2Candidate(candidate),
              canValidate,
              validationLocked:!canValidate,
              confirmLabel:hasCatalog?'Confirmar':'Confirmar faltante',
              confirmTitle:hasCatalog
                ? 'Confirmar que la referencia corresponde a este elemento del catálogo'
                : 'Confirmar que la referencia no está representada en el catálogo actual',
              confirmStyle:actionStyle(hasCatalog?'#0E735C':'#7A5D1D','#fff'),
              rejectStyle:actionStyle('#9B2247','#fff'),
              onConfirm:()=>this.openConv2Decision(candidate,confirmDecision),
              onReject:()=>this.openConv2Decision(candidate,'rechazada')
            };
          })
        };
      })(),

      // análisis geoespacial
      ...(() => {
        const A = S.analysis;
        const hasSelectedLayer = this.LAYERS.some(c => c.analysis && A.sel[c.key]);
        const hasActiveDataset = S.datasets.some(d=>d.active);
        const anySel = hasSelectedLayer || hasActiveDataset;
        const ranCount = (!A.stale && A.ranKeys.length) ? A.ranKeys.length : 0;
        return {
          anaOpen: S.anaOpen,
          onAnaOpenToggle: this.toggleAnalysisPanel,
          anaBtnStyle: 'position:relative;display:flex;align-items:center;justify-content:center;width:36px;height:36px;border-radius:8px;cursor:pointer;'+((S.anaOpen||A.lat)?'border:1px solid #9B2247;background:#9B2247;color:#fff':'border:1px solid #ECE8E2;background:#fff;color:#6F6B66'),
          anaBadge: ranCount>0, anaBadgeCount: String(ranCount),
          natLayers: this.LAYERS.filter(c => c.cat==='Generación y permisos').map(cfg => { const v = S.layers[cfg.key]; return { key:cfg.key, label:v.label, code:v.code, color:v.color, on:v.on, showCount:v.on&&v.count>0, countLabel:(v.count||0).toLocaleString('es-MX'), onToggle:()=>this.toggleLayer(cfg.key) }; }),
          anaNoMarker: !A.lat, anaHasMarker: !!A.lat,
          anaPlaceLabel: A.placing ? 'Haz clic en el mapa…' : 'Ubicar zona con un clic',
          anaPlaceBg: A.placing ? '#E0A12E' : '#9B2247',
          anaEstado: 'Zona de análisis · '+(A.estado||''),
          anaCoordLabel: A.lat ? (A.lat.toFixed(4)+', '+A.lng.toFixed(4)) : '',
          anaTargetTitle: A.targetLabel||'Punto seleccionado en mapa',
          anaTargetMeta: (()=>{
            if(A.lat==null) return '';
            const coordinates=A.lat.toFixed(5)+', '+A.lng.toFixed(5);
            if(A.analysisGeometry){
              return (A.targetDetail?A.targetDetail+' · ':'')+this._analysisCoverageLabel(A,true);
            }
            const detail=A.targetDetail&&A.targetDetail!==coordinates?A.targetDetail+' · '+coordinates:coordinates;
            return detail+' · arrastra el pin para mover';
          })(),
          anaPointTarget:!A.analysisGeometry,
          anaDistanceLabel:A.analysisGeometry?'Buffer territorial':'Radio de análisis',
          // Modos de ubicación del punto (clic · coordenadas · dirección · territorio)
          anaModes: [ {m:'click',label:'Mapa'}, {m:'coords',label:'Coordenadas'}, {m:'dir',label:'Dirección'}, {m:'territory',label:'Territorio'} ].map(o => {
            const active = (A.mode||'click')===o.m;
            return { label:o.label, onClick:()=>this.anaSetMode(o.m),
              style:'flex:1;padding:7px 4px;border:none;border-radius:7px;font-size:11px;font-weight:700;cursor:pointer;font-family:inherit;white-space:nowrap;background:'+(active?'#fff':'transparent')+';color:'+(active?'#9B2247':'#6F6B66')+';box-shadow:'+(active?'0 1px 4px rgba(0,0,0,.12)':'none') };
          }),
          anaModeClick: (A.mode||'click')==='click',
          anaModeCoords: A.mode==='coords',
          anaModeDir: A.mode==='dir',
          anaModeTerritory: A.mode==='territory',
          anaDirIn: A.dirIn||'',
          onAnaDirIn: this.onAnaDirIn, onAnaDirKey: this.onAnaDirKey, onAnaDirSearch: this.anaDirSearch,
          anaDirBtnLabel: A.dirBusy ? 'Buscando…' : 'Buscar',
          anaDirResults: (A.dirResults||[]).map(r => ({ label:r.label, onPick:()=>this.anaDirPick(r) })),
          anaShortcutTypes: ['gcr','demand','tariff','podecobi','pam','municipality','state'].map(type=>{
            const info=this._anaShortcutInfo(type), active=(A.shortcutType||'gcr')===type;
            return {
              label:info.label,
              onPick:()=>this.anaSetShortcutType(type),
              style:'padding:5px 8px;border:1px solid '+(active?info.color:'#ECE8E2')+';background:'+(active?info.color:'#fff')+';color:'+(active?'#fff':'#6F6B66')+';border-radius:16px;font-size:9.5px;font-weight:800;cursor:pointer;font-family:inherit'
            };
          }),
          anaShortcutQuery:A.shortcutQuery||'',
          onAnaShortcutQuery:this.onAnaShortcutQuery,
          anaShortcutPlaceholder:this._anaShortcutInfo(A.shortcutType||'gcr').placeholder,
          anaShortcutBusy:!!A.shortcutBusy,
          ...(()=>{
            const q=this._norm(A.shortcutQuery||'');
            const filtered=(A.shortcutOptions||[]).filter(o=>!q||this._norm((o.label||'')+' '+(o.detail||'')).includes(q)).slice(0,12);
            return {
              anaShortcutResults:filtered.map(o=>({...o,onPick:()=>this.anaShortcutPick(o)})),
              anaShortcutHasResults:!A.shortcutBusy&&filtered.length>0,
              anaShortcutNoResults:!A.shortcutBusy&&!!q&&filtered.length===0
            };
          })(),
          anaLatIn: A.latIn, anaLngIn: A.lngIn,
          onAnaLatIn: (e)=>this.setState({ analysis:{ ...this.state.analysis, latIn:e.target.value } }),
          onAnaLngIn: (e)=>this.setState({ analysis:{ ...this.state.analysis, lngIn:e.target.value } }),
          onAnaGoCoords: this.anaGoCoords, onAnaPlace: this.anaTogglePlacing, onAnaClear: this.anaClear, onAnaRun: this.anaRun,
          onAnaChooseDataset:this.onAnaChooseDataset,
          anaHasDatasets:S.datasets.length>0,
          anaNoDatasets:S.datasets.length===0,
          anaDatasets:S.datasets.map(d=>{
            const visible=this._datasetRowsForMap(d).length;
            const located=d.geo&&d.geo.placeable!=null?d.geo.placeable:d.rows.length;
            const status=!d.active ? d.rows.length+' filas · inactivo'
              : d.analysisOnly && A.lat==null ? located+' con ubicación de '+d.rows.length+' registros · se mostrarán al ubicar la zona'
              : d.analysisOnly ? visible+' dentro de '+this._analysisCoverageLabel(A,false)+' · '+located+' con ubicación'
              : visible+' registros activos';
            return { name:d.name, color:d.active?d.color:'#C7C2BA', active:d.active, status, onToggle:()=>this.toggleDataset(d.id) };
          }),
          anaRadii: (A.analysisGeometry?[0,2,5,10,20]:[2,4,5,10,20,50]).map(km => {
            const on=A.analysisGeometry?km===A.bufferKm:km===A.radiusKm;
            return {
              label:km+' km',on,bg:on?'#9B2247':'#fff',fg:on?'#fff':'#6F6B66',border:on?'#9B2247':'#ECE8E2',
              onPick:()=>A.analysisGeometry?this.anaSetTerritoryBuffer(km):this.anaSetRadius(km)
            };
          }),
          anaLayerCats: (() => { const order=[], byCat={}; this.LAYERS.filter(c => c.analysis).forEach(cfg => { const v = S.layers[cfg.key]; const ran = A.ranKeys.includes(cfg.key) && !A.stale; const cost=this._analysisCost(cfg.key); if (!byCat[cfg.cat]) { byCat[cfg.cat]=[]; order.push(cfg.cat); } byCat[cfg.cat].push({ key:cfg.key, label:cfg.label, code:cfg.code, color:cfg.color, sel:!!A.sel[cfg.key], showCount:ran, countLabel:(v.count||0).toLocaleString('es-MX'), summarized:!!v.summarized, costVisible:cost.tier!=='light', costLabel:cost.label, costColor:cost.tier==='heavy'?'#9B2247':'#8A6418', costBg:cost.tier==='heavy'?'rgba(155,34,71,.09)':'rgba(224,161,46,.12)', onToggle:()=>this.anaToggleSel(cfg.key) }); }); return order.map(name => ({ name, items:byCat[name] })); })(),
          // Escenarios (presets) — un chip resalta si la selección actual coincide exactamente
          anaSelCount: (() => { const n = Object.keys(A.sel).filter(k => A.sel[k]).length; return n===0 ? '0' : n+' de '+this.LAYERS.filter(c=>c.analysis).length; })(),
          anaPresets: this.ANA_PRESETS.map(pr => {
            const selKeys = Object.keys(A.sel).filter(k => A.sel[k]).sort();
            const prKeys = (pr.keys==='ALL'
              ? this.LAYERS.filter(c=>c.analysis).map(c=>c.key)
              : pr.keys==='RECOMMENDED'
                ? this._analysisRecommendedKeys(A)
                : [...pr.keys]).sort();
            const active = selKeys.length===prKeys.length && selKeys.every((k,i)=>k===prKeys[i]);
            return { label:pr.label, hint:pr.hint, onClick:()=>this.anaApplyPreset(pr.keys,pr.key),
              style:`padding:6px 11px;border:1px solid ${active?pr.color:'#ECE8E2'};background:${active?pr.color:'#fff'};color:${active?'#fff':'#3a3a3a'};border-radius:20px;font-size:11px;font-weight:600;cursor:pointer;font-family:inherit;white-space:nowrap;transition:background .12s` };
          }),
          anaAnalysisWarningVisible: A.profile==='intensive'||(this._analysisIsRegional(A)&&Object.keys(A.sel).filter(key=>A.sel[key]&&this._analysisCost(key).tier==='heavy').length>0),
          anaAnalysisWarning: (() => {
            const keys=Object.keys(A.sel).filter(key=>A.sel[key]);
            const mb=this._analysisEstimateMb(keys);
            if(A.profile==='intensive') return 'Modo intensivo: '+keys.length+' capas y hasta '+mb.toLocaleString('es-MX',{maximumFractionDigits:0})+' MB. Se ejecutará por etapas; las capas masivas se resumirán y podrás dibujarlas después.';
            return 'Territorio amplio con capas pesadas. Se calcularán sus conteos, pero las capas con miles de elementos podrán quedar en modo resumen para mantener fluido el mapa.';
          })(),
          anaRunLabel: A.running ? 'Analizando…' : ((A.ranKeys.length && A.stale?'Actualizar análisis · ':'Ejecutar análisis · ')+this._analysisCoverageLabel(A,false)),
          anaRunBg: (anySel && !A.running) ? '#0E8A6E' : '#C7C2BA',
        };
      })(),

      // datasets
      // datasets — menú desplegable anclado a la barra (icono en el buscador)
      datasetsStyle: { position:'absolute', zIndex:44, top:'16px', left:'16px', width:'306px', background:'#fff', border:'1.5px solid #E5DFD6', borderRadius:'13px', boxShadow:'0 18px 44px rgba(0,0,0,.18)', display: S.menuOpen==='datasets' ? 'block' : 'none', overflow:'hidden', animation:'dgFade .18s ease both' },
      datasetsOpen: true,
      onDatasetsMenuToggle: this.toggleDatasetsMenu,
      onCloseDatasets: () => this.setState({ menuOpen:null, mobilePanel:null }),
      datasetsBtnStyle: 'position:relative;display:flex;align-items:center;justify-content:center;width:36px;height:36px;border-radius:8px;cursor:pointer;'+(S.menuOpen==='datasets'?'border:1px solid #1E9CB8;background:#1E9CB8;color:#fff':'border:1px solid #ECE8E2;background:#fff;color:#6F6B66'),
      datasetsBadge: S.datasets.length>0,
      datasetsBadgeCount: String(S.datasets.length),
      onOpenConnect:this.onOpenConnect,
      hasDatasets: S.datasets.length>0, noDatasets: S.datasets.length===0,
      datasetsList: S.datasets.map(d => { const visible=this._datasetRowsForMap(d).length; const located=d.geo&&d.geo.placeable!=null?d.geo.placeable:d.rows.length; return { id:d.id, name:d.name, color:d.color, type:d.type.toUpperCase(), typeColor: d.type==='json'?'#1E9CB8':d.type==='csv'?'#0E8A6E':'#E0A12E', meta:`${d.rows.length} filas · ${located} con ubicación · llave: ${d.keyField} → ${L[d.target].label}`, active:d.active, activeLabel: d.active?(d.analysisOnly?(S.analysis.lat==null?'Listo · esperando ubicación':visible+' dentro de '+this._analysisCoverageLabel(S.analysis,false)):'Activo en el mapa'):'Inactivo', onToggle:()=>this.toggleDataset(d.id), onRemove:()=>this.removeDataset(d.id) }; }),

      // detalle — barra lateral derecha en desktop (el CSS móvil .dgp la convierte en hoja inferior)
      detalleStyle: (() => { const hid=S.collapsed.detalle; const st={ position:'absolute', zIndex:22, top:0, right:0, bottom:0, width:'320px', background:'#fff', borderLeft:'1px solid #ECE8E2', boxShadow:'-10px 0 28px rgba(0,0,0,.08)', display:'flex', flexDirection:'column', overflow:'hidden', transition:'transform .32s cubic-bezier(.2,.7,.2,1)', transform: hid?'translateX(100%)':'translateX(0)' }; return st; })(),
      // tab flotante para reabrir el panel cuando está oculto
      // ── Reporte territorial ──
      reportOpen: !!S.reportOpen,
      onCloseReport: this.onCloseReport, onReportPDF: this.onReportPdfClick, onOpenReport: this.onOpenReport,
      // Exportaciones adicionales desde el reporte + marca de agua opcional (logo SENER + fecha)
      onReportPdfPpt: this.onReportPdfPptClick,
      onReportXLSX: this.exportReportXLSX,
      onReportPNG: () => this.doExportPNG(),
      onOpenReportSend: this.onOpenReportSend,
      onCloseReportSend: this.onCloseReportSend,
      onSubmitReportSend: this.onSubmitReportSend,
      onWmToggle: () => { const wmOn = !S.wmOn; this.setState({ wmOn }); this._toast(wmOn ? 'Marca de agua activada: logo SENER + fecha en el mapa exportado' : 'Marca de agua desactivada'); },
      wmBtnStyle: 'display:flex;align-items:center;gap:6px;padding:9px 11px;border:1px solid '+(S.wmOn?'#E0A12E':'rgba(255,255,255,.28)')+';background:'+(S.wmOn?'rgba(224,161,46,.22)':'none')+';color:'+(S.wmOn?'#E0A12E':'rgba(255,255,255,.9)')+';border-radius:9px;font-size:11.5px;font-weight:700;cursor:pointer;font-family:inherit;flex:none;white-space:nowrap',
      reportBtnVisible: !!(S.selected && S.selected.isAnaSummary && this._hasCompletedReportAnalysis(S.analysis)),
      reportDate: (this._report||{}).date || '',
      reportEyebrow: ((this._report||{}).target||{}).eyebrow || 'Evaluación de sitio estratégico',
      reportMeta: ((this._report||{}).meta||[]).map(r => ({ label:r[0], value:r[1] })),
      reportMetrics: ((this._report||{}).metrics || []).map(m => ({ ...m, op: m.dim ? '.62' : '1', vcolor: m.dim ? '#9A958E' : '#1c1b1a', sub: m.sub||'' })),
      reportHasCharts: !!(((this._report||{}).charts||[]).filter(chart=>chart&&chart.group!=='inegi'&&chart.group!=='tariffs'&&chart.group!=='demand'&&chart.group!=='consumption'&&chart.svgDataUrl).length),
      reportCharts: ((this._report||{}).charts||[]).filter(chart=>chart&&chart.group!=='inegi'&&chart.group!=='tariffs'&&chart.group!=='demand'&&chart.group!=='consumption'&&chart.svgDataUrl),
      reportSections: ((this._report||{}).sections||[]).map(sec => ({
        ...sec,
        rowItems: (sec.rows||[]).map(r => ({ label:r[0], value:r[1], color: r[1]==='no analizada' ? '#9A958E' : '#1c1b1a' })),
        subSections: (sec.subSections||[]).map(sub => ({
          ...sub,
          rowItems: (sub.rows||[]).map(r => ({ label:r[0], value:r[1] })),
        })),
      })),
      reportSendOpen: !!S.reportSendOpen,
      reportSendFmtPdf: S.reportSendFmt!=='pdf16x9',
      reportSendFmtPpt: S.reportSendFmt==='pdf16x9',
      reportSendReady: this._hasCompletedReportAnalysis(S.analysis),
      reportSendDisabled: !this._hasCompletedReportAnalysis(S.analysis),
      reportSendTitle: this._hasCompletedReportAnalysis(S.analysis)
        ? 'Enviar reporte por correo'
        : 'Ejecuta una corrida de análisis para habilitar el envío',
      reportSendTopBtnStyle: (() => {
        const on = this._hasCompletedReportAnalysis(S.analysis);
        return 'display:flex;align-items:center;gap:5px;padding:6px 10px;border:1px solid '+(on?'#9B2247':'#D8D3CC')+';background:'+(on?'#fff':'#F2F0ED')+';color:'+(on?'#9B2247':'#9A958E')+';border-radius:8px;font-size:11.5px;font-weight:700;cursor:'+(on?'pointer':'not-allowed')+';font-family:inherit';
      })(),
      onSendFmtPdf: () => this.setState({ reportSendFmt:'pdf' }),
      onSendFmtPpt: () => this.setState({ reportSendFmt:'pdf16x9' }),
      reportSendQuery: S.reportSendQuery||'',
      onSendQueryInput: (e) => this.setState({ reportSendQuery:e.target.value||'' }),
      reportSendMsg: S.reportSendMsg||'',
      onSendMsgInput: (e) => this.setState({ reportSendMsg:e.target.value||'' }),
      reportSendBusy: !!S.reportSendBusy,
      reportSendBtnLabel: S.reportSendBusy ? 'Enviando…' : 'Enviar reporte',
      reportSendFeedbackOn: !!S.reportSendFeedback,
      reportSendFeedback: S.reportSendFeedback || '',
      reportSendFeedbackClass: S.reportSendFeedbackType==='ok' ? 'is-ok' : (S.reportSendFeedbackType==='error' ? 'is-error' : 'is-info'),
      reportSendRecipients: (() => {
        const q = (S.reportSendQuery||'').trim().toLowerCase();
        return this.REPORT_RECIPIENTS
          .filter(u => !q || String(u.Nombre||'').toLowerCase().includes(q) || String(u.Correo||'').toLowerCase().includes(q))
          .map(u => ({
            id:u.IdUsuario,
            nombre:u.Nombre||'Sin nombre',
            detalle:(u.Correo||'') + (u.Cargo ? (' · '+u.Cargo) : ''),
            ini: (String(u.Nombre||'?').trim().charAt(0) || '?').toUpperCase(),
            on: !!S.reportSendSel[u.IdUsuario],
            onToggle: () => this.setState({ reportSendSel:{ ...this.state.reportSendSel, [u.IdUsuario]: !this.state.reportSendSel[u.IdUsuario] } })
          }));
      })(),
      reportSendHasRecipients: this.REPORT_RECIPIENTS.length>0,
      reportSendNoRecipients: this.REPORT_RECIPIENTS.length===0,
      // "Volver al resumen del análisis": visible cuando hay un resumen guardado y se está viendo otro elemento
      anaBackVisible: !!(this._anaSummary && S.selected && !S.selected.isAnaSummary),
      onAnaBack: () => { this._clearHighlight(); this.setState({ selected:this._anaSummary }); if (this._anaCircle) { try { this.map.fitBounds(this._anaCircle.getBounds().pad(0.25), { animate:true }); } catch(e){} } },
      detalleHidden: S.collapsed.detalle && !!S.selected,
      // La leyenda se corre sólo cuando el panel de detalle está visible
      bottomRightOffset: S.collapsed.detalle ? '14px' : '336px',
      bottomRightBottom: S.marketOpen
        ?(S.marketExpanded?'min(64vh,594px)':'284px')
        :'14px',
      onReopenDetalle:()=>this._collapse('detalle'),
      detalleOpen: true, detalleChevron:this._chevron(true),
      onDragDetalle:(e)=>this._startDrag('detalle',e), onCollapseDetalle:()=>this._collapse('detalle'),
      hasSelection: !!S.selected, noSelection: !S.selected,
      selKicker: S.selected?S.selected.kicker:'', selName: S.selected?S.selected.name:'', selColor: S.selected?S.selected.color:'#9B2247',
      detalleRows: S.selected? S.selected.rows.map(r=>{
        const v = r[1] || '—';
        const absoluteUrl = typeof v === 'string' ? this._toAbsoluteUrl(v) : '';
        const isUrl = Boolean(absoluteUrl) && v !== '—';
        return { label:r[0], value: isUrl ? this._urlLabel(absoluteUrl) : v, hasUrl: isUrl, url: isUrl ? absoluteUrl : '' };
      }) : [],

      // métricas — contextuales al elemento seleccionado; si no hay selección con métricas,
      // muestra el resumen del ámbito visible / área dibujada.
      scopeLabel: (S.selected && S.selected.metrics) ? ('· '+String(S.selected.name||'').slice(0,26)) : ('· '+S.scope),
      metricsList: (S.selected && S.selected.metrics) ? S.selected.metrics : [
        { label:'Capacidad total seleccionada', value:fmt(m.capacidad), unit:'MW', accent:'#9B2247' },
        { label:'Subestaciones visibles', value:fmt(m.subs), unit:'', accent:'#E0A12E' },
        { label:'Km de líneas visibles', value:fmt(m.km), unit:'km', accent:'#1E9CB8' },
        { label:'Permisos de generación', value:fmt(m.permisos), unit:'', accent:'#0E8A6E' },
        { label:'Proyectos activos', value:fmt(m.proyectos), unit:'', accent:'#C0552E' },
        { label:'Distancia al más cercano', value: m.distancia==null?'—':m.distancia.toFixed(1), unit: m.distancia==null?'':'km', accent:'#9AAE3B' },
      ],

      // modal
      connectOpen:S.connectOpen, onCloseConnect:this.onCloseConnect, stopProp:this.stopProp,
      catalogLoading:!!S.catalogLoading, catalogIdle:!S.catalogLoading, catalogLoadingName:S.catalogLoadingName||'Dataset seleccionado',
      connectUrl:S.connectUrl, onConnectUrlInput:this.onConnectUrlInput, onLoadFields:this.onLoadFields,
      typeChips:[ tcChips('sheets','Google Sheets'), tcChips('csv','CSV'), tcChips('json','JSON') ],
      // catálogo DGMESNIE (editable)
      catItems: (S.catalog||[]).map(c => ({ name:c.name, desc:c.desc||'', onConnect:()=>this.catConnect(c), onRemove:()=>this.catRemove(c.id) })),
      catCount: String((S.catalog||[]).length),
      catName: S.catName||'', catUrl: S.catUrl||'',
      onCatName: (e)=>this.setState({ catName:e.target.value }),
      onCatUrl: (e)=>this.setState({ catUrl:e.target.value }),
      onCatAdd: this.catAdd,
      presets:[
        { label:'Permisos CRE (CSV)', onClick:()=>this.loadPreset('permisos') },
        { label:'Proyectos CFE (JSON)', onClick:()=>this.loadPreset('proyectos') },
        { label:'Atributos subestaciones (Sheets)', onClick:()=>this.loadPreset('atributos') },
      ],
      hasFields: !!S.fields,
      fieldsCount: S.fields? S.fields.fields.length : 0,
      fieldsRows: S.fields? S.fields.rows.length : 0,
      fieldChips: S.fields? S.fields.fields.map(f => ({ name:f, color: /id_|clave_|nombre_|cve_|gerencia|zona_/.test(f)?'#9B2247':'#3a3a3a' })) : [],
      // Nota de vinculación geográfica auto-detectada
      geoLevelLabel: (() => { const g=S.fields&&S.fields.geo; if(!g) return ''; return { coords:'Coordenadas propias', sub:'Vía subestaciones', ent:'Nivel territorial', none:'Sin vínculo al mapa' }[g.level]||''; })(),
      geoNote: (S.fields && S.fields.geo && S.fields.geo.note) || '',
      geoNoteColor: (() => { const g=S.fields&&S.fields.geo; if(!g) return '#0E8A6E'; return g.level==='none' ? '#C0552E' : g.level==='ent' ? '#E0A12E' : '#0E8A6E'; })(),
      geoNoteBg: (() => { const g=S.fields&&S.fields.geo; if(!g) return '#fff'; return g.level==='none' ? 'rgba(192,85,46,.07)' : g.level==='ent' ? 'rgba(224,161,46,.09)' : 'rgba(14,138,110,.07)'; })(),
      geoNoteBorder: (() => { const g=S.fields&&S.fields.geo; if(!g) return '#ECE8E2'; return g.level==='none' ? 'rgba(192,85,46,.3)' : g.level==='ent' ? 'rgba(224,161,46,.35)' : 'rgba(14,138,110,.3)'; })(),
      keyOptions: S.fields? S.fields.fields : [],
      keyField:S.keyField, layerTarget:S.layerTarget,
      onSelectKey:this.onSelectKey, onSelectTarget:this.onSelectTarget, onConfirmBind:this.onConfirmBind,
    };
  }
}
</script>
</div>

@section Scripts {
    <script>
        // Definir la ruta base para assets y recursos estáticos
        window.__tableroBaseUrl = "@Url.Content("~/tablero")";
