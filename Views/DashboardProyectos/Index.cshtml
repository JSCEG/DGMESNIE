    const targetType=String(target.typeLabel||target.kind||'Punto').trim();
    const targetLabel=String(target.label||target.detail||'Ubicación seleccionada').trim();
    const codeType=targetType.normalize('NFD').replace(/[\u0300-\u036f]/g,'').replace(/[^A-Za-z0-9]+/g,'_').replace(/^_+|_+$/g,'').toUpperCase().slice(0,16)||'PUNTO';
    const reportCode='SENER·DGMESNIE·'+codeType+'·'+new Date().getFullYear();
    const setFont=(role,style)=>{
      if(doc._reportFonts) this._setReportFont(doc,role,style||'normal');
      else doc.setFont(role==='title'?'times':'helvetica',style==='bold'?'bold':'normal');
    };

    doc.setFillColor(255,255,255); doc.rect(0,0,W,H,'F');
    this._pdfLogos(doc,pad,landscape?34:38,landscape?30:28);

    const band=landscape
      ? {x:232,y:116,w:W-pad-232,h:90,textX:344,textY:177,font:54}
      : {x:142,y:126,w:W-pad-142,h:100,textX:350,textY:193,font:39};
    doc.setFillColor(...burgundy); doc.rect(band.x,band.y,band.w,band.h,'F');
    doc.setTextColor(255,255,255); setFont('title','bold'); doc.setFontSize(band.font);
