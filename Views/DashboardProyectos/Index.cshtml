            ['Contacto federal', cf ? (cf.nombre+(cf.cargo?' · '+cf.cargo:'')+(cf.correo?' · '+cf.correo:'')) : '—'],
            ['Contacto estatal', ce ? (ce.nombre+(ce.cargo?' · '+ce.cargo:'')+(ce.correo?' · '+ce.correo:'')) : '—'],
            ['Inversión', pol.inversion || '—'],
