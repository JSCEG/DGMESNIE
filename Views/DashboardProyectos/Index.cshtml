  _analysisRequestBbox(A){
    if(!A||!isFinite(A.lat)||!isFinite(A.lng)) return null;
    if(A.analysisGeometry&&window.turf){
      try{
        const bbox=window.turf.bbox(this._asFeatureCollection(A.analysisGeometry));
        if(Array.isArray(bbox)&&bbox.length===4&&bbox.every(Number.isFinite)){
          return {minLon:bbox[0],minLat:bbox[1],maxLon:bbox[2],maxLat:bbox[3]};
        }
      }catch(e){}
    }
    const radius=Math.max(0.5,Number(A.radiusKm)||1);
    const latDelta=radius/111;
    const lonDelta=radius/(111*Math.max(.2,Math.cos(Number(A.lat)*Math.PI/180)));
    return {
      minLon:Number(A.lng)-lonDelta,minLat:Number(A.lat)-latDelta,
      maxLon:Number(A.lng)+lonDelta,maxLat:Number(A.lat)+latDelta
    };
  }
  _applyLayerScope(cfg,geo){
    if(!cfg||cfg.permitScope!=='generation'||!geo||!Array.isArray(geo.features)) return geo;
    const normalized=value=>String(value||'')
      .normalize('NFD').replace(/[\u0300-\u036f]/g,'')
      .toUpperCase().replace(/[^A-Z0-9]+/g,' ').trim();
    const features=geo.features.filter(feature=>{
      const p=(feature&&feature.properties)||{};
      const permitType=normalized(p.tipoPermiso||p.TipoPermiso);
      const classification=normalized(p.clasificacion||p.Clasificacion);
      return !/\b(?:IMP|EXP)\b/.test(permitType)&&
        !/\b(?:IMPORTACION|EXPORTACION)\b/.test(classification);
    });
    return {
      ...geo,
      meta:{...(geo.meta||{}),conteo:features.length,scope:'generacion'},
      features
    };
  }
  async _fetchAnalysisGeo(cfg,A,signal){
    if(!cfg||!cfg.api) return this._mockFetchGeo(cfg&&cfg.src,{signal});
    const bbox=this._analysisRequestBbox(A);
    if(!bbox) throw new Error('No fue posible determinar la cobertura territorial');
    const params=new URLSearchParams({
      tipo:cfg.api,
      minLat:bbox.minLat.toFixed(6),minLon:bbox.minLon.toFixed(6),
      maxLat:bbox.maxLat.toFixed(6),maxLon:bbox.maxLon.toFixed(6)
    });
    const endpoint='/DashboardProyectos/PermisosEnergeticos?'+params.toString();
    let lastError=null;
    // La base institucional puede tardar algunos segundos en reabrir su
    // conexión después de un despliegue o de un periodo sin tráfico. En el
    // escenario intensivo no conviene declarar estas capas ausentes por un
    // fallo transitorio de arranque.
    const retryDelays=[0,900,1800,3000,4500,6000];
    for(let attempt=0;attempt<retryDelays.length;attempt++){
      if(signal&&signal.aborted){
        const aborted=new Error('Análisis cancelado');
        aborted.name='AbortError';
        throw aborted;
      }
      if(retryDelays[attempt]){
        await new Promise(resolve=>setTimeout(resolve,retryDelays[attempt]));
      }
      try{
        const response=await fetch(endpoint,{
          method:'GET',credentials:'same-origin',signal,cache:'no-store',
          headers:{Accept:'application/geo+json, application/json','Cache-Control':'no-cache'}
        });
        const payload=await response.json().catch(()=>null);
        if(!response.ok){
          const message=payload&&payload.detail?payload.detail:'HTTP '+response.status;
          throw new Error(message);
        }
        if(!payload||payload.type!=='FeatureCollection'||!Array.isArray(payload.features)){
          throw new Error('La fuente devolvió un formato territorial no válido');
        }
        return this._applyLayerScope(cfg,payload);
      }catch(error){
        if(error&&error.name==='AbortError') throw error;
        lastError=error;
      }
    }
    throw lastError||new Error('La fuente de permisos no respondió');
  }
  _analysisRecommendedKeys(A){
    const essential=['red_se_transmision','red_se_distribucion','red_lineas','centrales','ductos_imp','ductos_sis','presas'];
    return this._analysisIsRegional(A)?essential:[...this.ANA_RECOMMENDED];
  }
  _analysisEstimateMb(keys){
    return (keys||[]).reduce((total,key)=>total+(Number(this._analysisCost(key).mb)||0),0);
  }
  _analysisIsRegional(A){
    if(!A) return false;
    if(['gcr','state','demand-region','tariff-division'].includes(A.targetKind)) return true;
    const area=this._analysisAreaKm2(A);
    return Number.isFinite(area)&&area>=20000;
  }
  _analysisOrderedKeys(keys){
    const rank={light:0,medium:1,heavy:2};
    const order=new Map(this.LAYERS.map((layer,index)=>[layer.key,index]));
    return [...(keys||[])].sort((a,b)=>{
      const tier=(rank[this._analysisCost(a).tier]||0)-(rank[this._analysisCost(b).tier]||0);
      return tier||(order.get(a)||0)-(order.get(b)||0);
    });
  }
  _analysisStage(key){
    const tier=this._analysisCost(key).tier;
    return tier==='heavy'?'Capas masivas':tier==='medium'?'Contexto territorial':'Infraestructura esencial';
  }
  _analysisSelectionKey(A){
    if(!A) return 'none';
    const parts=A.analysisGeometry
      ? [A.targetKind||'territory',A.targetStateCode||'',A.targetMunicipalityCode||'',A.targetLabel||'',Number(A.bufferKm)||0,Math.round((this._analysisAreaKm2(A)||0)*10)]
      : ['point',Number(A.lat||0).toFixed(5),Number(A.lng||0).toFixed(5),Number(A.radiusKm)||0];
    return parts.join('|');
  }
  _analysisCachedResult(key){
    if(!this._analysisResultCache) return null;
    const value=this._analysisResultCache.get(key);
    if(value){ this._analysisResultCache.delete(key); this._analysisResultCache.set(key,value); }
    return value||null;
  }
  _cacheAnalysisResult(key,value){
    this._analysisResultCache=this._analysisResultCache||new Map();
    if(this._analysisResultCache.has(key)) this._analysisResultCache.delete(key);
    this._analysisResultCache.set(key,value);
    while(this._analysisResultCache.size>this.ANA_RESULT_CACHE_LIMIT){
      const oldest=this._analysisResultCache.keys().next().value;
      this._analysisResultCache.delete(oldest);
    }
  }
  _insideMexico(lat, lng){
    if (this.geo && this.geo.estados) { for (const f of (this.geo.estados.features||[])) { if (this._inFeature(lng, lat, f.geometry)) return this._propEnt(f.properties) || 'México'; } return null; }
    return (lat>=14.3 && lat<=32.8 && lng>=-118.5 && lng<=-86.5) ? 'México' : null; // fallback bbox
  }
  _asFeatureCollection(geo){
    if(!geo) return null;
    if(geo.type==='FeatureCollection') return geo;
    if(geo.type==='Feature') return {type:'FeatureCollection',features:[geo]};
    if(geo.type&&geo.coordinates) return {type:'FeatureCollection',features:[{type:'Feature',properties:{},geometry:geo}]};
    return null;
