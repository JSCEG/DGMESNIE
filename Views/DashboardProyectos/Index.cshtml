      doc.setFillColor(i%2?250:255,i%2?248:255,i%2?245:255); doc.setDrawColor(236,232,226); doc.roundedRect(cx,cy,metaW,metaH-6,3,3,'FD');
      doc.setTextColor(154,149,142); doc.setFont('helvetica','bold'); doc.setFontSize(6.8);
      doc.text(this._clipText(doc,String((row||[])[0]||'').toUpperCase(),metaW-16),cx+8,cy+12);
      doc.setTextColor(28,27,26); doc.setFont('helvetica','bold'); doc.setFontSize(9);
      doc.text(this._clipText(doc,String((row||[])[1]==null?'—':row[1]),metaW-16),cx+8,cy+27);
    });

    // 4 · Todos los indicadores. Las tarjetas continúan en páginas adicionales sin recortes.
    const addMetricsPage=(continuation)=>addReportPage('Indicadores del radio',continuation?'Métricas del análisis · continuación':'Métricas del análisis',R.date||'Reporte territorial','02');
    pageInfo=addMetricsPage(false);
