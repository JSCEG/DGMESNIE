        targetDetail:'Geometría territorial'+(option.detail?' · '+option.detail:''),
        targetState:option.state||'',
        targetMunicipality:option.municipality||'',
        targetStateCode:option.stateCode||'',
        targetMunicipalityCode:option.municipalityCode||''
      }
    },()=>{
      this._renderZonalDatasets();
      this._recompute();
      try{ if(bounds&&bounds.isValid()) this.map.fitBounds(bounds.pad(.12),{animate:true}); }catch(e){}
    });
    this._toast('Territorio listo · '+this._analysisCoverageLabel({analysisGeometry:effective,bufferKm},true)+(hadRun?' · actualiza el análisis':' · elige capas'));
  }
  _anaPlace(lat, lng, target){
    const estado = this._insideMexico(lat, lng);
    if (!estado) { this._toast('El punto debe estar dentro de México'); return; }
    const chosenTarget = target || {
      kind:'point',
      label:'Punto seleccionado en mapa',
      detail:lat.toFixed(5)+', '+lng.toFixed(5)
    };
    const L = window.L;
    this._clearAnalysisTerritoryLayers();
    if (!this._anaMarker) {
      const ic = L.divIcon({ className:'', iconSize:[30,40], iconAnchor:[15,38], html:'<svg width="30" height="40" viewBox="0 0 30 40"><path d="M15 1C7.8 1 2 6.8 2 14c0 9.6 13 25 13 25s13-15.4 13-25C28 6.8 22.2 1 15 1z" fill="#9B2247" stroke="#fff" stroke-width="2"/><circle cx="15" cy="14" r="5" fill="#fff"/></svg>' });
      this._anaMarker = L.marker([lat, lng], { icon:ic, draggable:true, zIndexOffset:900 }).addTo(this.map);
      this._anaMarker.on('dragend', () => {
        const p = this._anaMarker.getLatLng();
        const est2 = this._insideMexico(p.lat, p.lng);
        if (!est2) { this._toast('El punto debe estar dentro de México'); this._anaMarker.setLatLng([this.state.analysis.lat, this.state.analysis.lng]); return; }
        this._anaPlace(p.lat, p.lng, {
          kind:'coordinate',
          label:'Coordenadas ajustadas manualmente',
          detail:p.lat.toFixed(5)+', '+p.lng.toFixed(5)
        });
      });
    } else this._anaMarker.setLatLng([lat, lng]);
    // Renderer SVG PROPIO para los trazos del análisis/medición: el canvas compartido con
    // gerencias/estados perdía el círculo al apagar esas capas (redibujo parcial del renderer).
    if (!this._drawR) { try { this._drawR = L.svg({ pane:'draw', padding:0.5 }); this._drawR.addTo(this.map); } catch(e){} }
    if (!this._anaCircle) { try { this._anaCircle = L.circle([lat, lng], { renderer:this._drawR, radius:this.state.analysis.radiusKm*1000, color:'#9B2247', weight:1.6, dashArray:'7 6', fillColor:'#9B2247', fillOpacity:.05, interactive:false }).addTo(this.map); this._guardPath(this._anaCircle); } catch(e){} }
    else this._anaCircle.setLatLng([lat, lng]);
    this.map.getContainer().style.cursor = '';
    const hadRun = this.state.analysis.ranKeys.length > 0;
    const hasSelection=Object.keys(this.state.analysis.sel||{}).some(key=>this.state.analysis.sel[key]);
    const recommended=this._analysisRecommendedKeys({...this.state.analysis,targetKind:chosenTarget.kind||'point',analysisGeometry:null});
    const selection=hasSelection?this.state.analysis.sel:Object.fromEntries(recommended.map(key=>[key,true]));
    this.setState({ anaOpen:true, menuOpen:null, selected:null, collapsed:{ ...this.state.collapsed, detalle:true }, analysis: {
      ...this.state.analysis,
      placing:false, lat, lng, estado, stale:true, latIn:lat.toFixed(5), lngIn:lng.toFixed(5),
      sel:selection,profile:hasSelection?this.state.analysis.profile:'recommended',
      progress:null,cancelled:false,intensiveConfirmed:false,
      bufferKm:0,territoryGeometry:null,analysisGeometry:null,territoryAreaKm2:null,
      targetKind:chosenTarget.kind||'point',
      targetLabel:chosenTarget.label||'Punto seleccionado en mapa',
      targetDetail:chosenTarget.detail||'',
      targetState:chosenTarget.state||'',
      targetMunicipality:chosenTarget.municipality||'',
      targetStateCode:'',
      targetMunicipalityCode:''
    } }, () => {
      this._renderZonalDatasets();
      this._recompute();
      try { this.map.fitBounds(this._anaCircle.getBounds().pad(0.3), { animate:true }); } catch(e){}
    });
    this._toast('Zona de análisis en '+estado+(hadRun?' · actualiza el análisis':' · elige capas y radio'));
  }
  anaTogglePlacing = () => {
    const placing = !this.state.analysis.placing;
    this.map.getContainer().style.cursor = placing ? 'crosshair' : '';
    // Al entrar en modo colocación se cierra el dropdown para despejar el mapa; se reabre al colocar
    this.setState({ analysis: { ...this.state.analysis, placing }, anaOpen: placing ? false : this.state.anaOpen });
    if (placing) this._toast('Haz clic en el mapa para ubicar la zona de análisis');
  };
  anaGoCoords = () => {
    const A = this.state.analysis;
    const lat = parseFloat(String(A.latIn).replace(',', '.')), lng = parseFloat(String(A.lngIn).replace(',', '.'));
    if (!isFinite(lat) || !isFinite(lng)) { this._toast('Coordenadas inválidas — usa decimales, p.ej. 19.4326, -99.1332'); return; }
    this._anaPlace(lat, lng, {
      kind:'coordinate',
      label:'Coordenadas ingresadas',
      detail:lat.toFixed(5)+', '+lng.toFixed(5)
    });
    this.map.setView([lat, lng], Math.max(this.map.getZoom(), 8), { animate:true });
  };
  // ── Geocodificador de direcciones (Nominatim · restringido a México) ──
  anaSetMode = (m) => this.setState({ analysis:{ ...this.state.analysis, mode:m } }, () => {
    if (m==='territory' && !(this.state.analysis.shortcutOptions||[]).length) {
      this.anaLoadShortcutOptions(this.state.analysis.shortcutType||'gcr');
    }
  });
  onAnaDirIn = (e) => this.setState({ analysis:{ ...this.state.analysis, dirIn:e.target.value } });
  onAnaDirKey = (e) => { if (e.key==='Enter') this.anaDirSearch(); };
  _geocode(q){
    const url = 'https://nominatim.openstreetmap.org/search?format=jsonv2&countrycodes=mx&limit=5&q='+encodeURIComponent(q);
    return fetch(url, { headers:{ 'Accept':'application/json' } })
      .then(r => { if(!r.ok) throw new Error('HTTP '+r.status); return r.json(); })
      .then(rs => rs.map(r => ({ label:r.display_name, lat:+r.lat, lng:+r.lon })).filter(r => isFinite(r.lat) && isFinite(r.lng)));
  }
  anaDirSearch = () => {
    const q = (this.state.analysis.dirIn||'').trim();
    if (q.length < 3) { this._toast('Escribe al menos 3 caracteres de la dirección'); return; }
    this.setState({ analysis:{ ...this.state.analysis, dirBusy:true, dirResults:[] } });
    this._geocode(q).then(rs => {
      this.setState({ analysis:{ ...this.state.analysis, dirBusy:false, dirResults:rs } });
      if (!rs.length) this._toast('Sin resultados en México para «'+q+'»');
    }).catch(() => { this.setState({ analysis:{ ...this.state.analysis, dirBusy:false } }); this._toast('El servicio de direcciones no respondió — intenta de nuevo'); });
  };
  anaDirPick = (r) => {
    this.setState({ analysis:{ ...this.state.analysis, dirResults:[], dirIn:r.label.split(',').slice(0,2).join(',') } });
    this._anaPlace(r.lat, r.lng, {
      kind:'address',
      label:r.label.split(',').slice(0,3).join(','),
      detail:'Resultado del buscador de direcciones'
    });
    this.map.setView([r.lat, r.lng], Math.max(this.map.getZoom(), 12), { animate:true });
  };
  _anaShortcutInfo(type){
    return {
      gcr:{ label:'GCR', code:'GC', color:'#9B2247', placeholder:'Buscar gerencia de control…' },
      demand:{ label:'Demanda', code:'DM', color:'#1E9CB8', placeholder:'Buscar región CENACE…' },
      tariff:{ label:'Usuarios/consumo', code:'UC', color:'#0E8A6E', placeholder:'Buscar división tarifaria CFE…' },
      podecobi:{ label:'PODECOBI', code:'PO', color:'#9B2247', placeholder:'Buscar polo de desarrollo…' },
      pam:{ label:'PAM', code:'PA', color:'#6B3654', placeholder:'Buscar clave o proyecto PAM…' },
      municipality:{ label:'Municipio', code:'MU', color:'#C9A24B', placeholder:'Buscar municipio o entidad…' },
      state:{ label:'Estado', code:'ED', color:'#0E8A6E', placeholder:'Buscar entidad federativa…' },
    }[type] || { label:'Territorio', code:'TR', color:'#6F6B66', placeholder:'Buscar territorio…' };
  }
  _anaGcrShortcutCenter(key){
    const direct=this._gcrCentroid&&this._gcrCentroid[key];
    if(direct&&isFinite(direct[0])&&isFinite(direct[1])) return direct;
    const pts=Object.values(this.estCentroid||{}).filter(c=>c&&c.feature&&this._gerenciaOf(this._propEnt(c.feature.properties)||'')===key);
    if(!pts.length) return null;
    return [pts.reduce((s,c)=>s+c.lat,0)/pts.length,pts.reduce((s,c)=>s+c.lng,0)/pts.length];
  }
  _anaGcrShortcutGeometry(key){
    const source=(this.geo&&this.geo.gerencias&&this.geo.gerencias.features)||[];
    let features=source.filter(feature=>this._gcrKeyFromName(this._gerName(feature.properties))===key);
    if(!features.length){
      features=((this.geo&&this.geo.estados&&this.geo.estados.features)||[])
        .filter(feature=>this._gerenciaOf(this._propEnt(feature.properties)||'')===key);
    }
    return features.length?{type:'FeatureCollection',features}:null;
  }
  _anaMunicipiosShortcutGeo(){
    if(this._muniGeo) return Promise.resolve(this._muniGeo);
    if(this._municipiosShortcutGeo) return Promise.resolve(this._municipiosShortcutGeo);
    if(this._municipiosShortcutPromise) return this._municipiosShortcutPromise;
    this._municipiosShortcutPromise=this._mockFetchGeo(this.SRC.municipios).then(geo=>{
      this._municipiosShortcutGeo=geo;
      return geo;
    }).finally(()=>{ this._municipiosShortcutPromise=null; });
    return this._municipiosShortcutPromise;
  }
  _anaAtlasShortcutGeo(key,url){
    this._rawGeo=this._rawGeo||{};
    if(this._rawGeo[key]) return Promise.resolve(this._rawGeo[key]);
    const records=((this._genericFeats&&this._genericFeats[key])||[]);
    if(records.length){
      return Promise.resolve({
        type:'FeatureCollection',
        features:records.filter(item=>item&&item.geometry).map(item=>({
          type:'Feature',properties:item.props||{},geometry:item.geometry
        }))
      });
    }
    this._anaAtlasShortcutPromises=this._anaAtlasShortcutPromises||{};
    if(this._anaAtlasShortcutPromises[key]) return this._anaAtlasShortcutPromises[key];
    this._anaAtlasShortcutPromises[key]=this._mockFetchGeo(url).then(geo=>{
      this._rawGeo[key]=geo;
      return geo;
    }).finally(()=>{ delete this._anaAtlasShortcutPromises[key]; });
    return this._anaAtlasShortcutPromises[key];
  }
  _fetchPolosGeoCache(){
    if(this._polosGeoCachePromise) return this._polosGeoCachePromise;
    this._polosGeoCachePromise=fetch('/api/podecobi/geojson',{credentials:'same-origin'})
      .then(response=>response.ok?response.json():{type:'FeatureCollection',features:[]})
      .catch(()=>({type:'FeatureCollection',features:[]}));
    return this._polosGeoCachePromise;
  }
  anaLoadShortcutOptions = (type) => {
    const selectedType=type||'gcr';
    const token=(this._anaShortcutLoadToken||0)+1;
    this._anaShortcutLoadToken=token;
    this.setState({ analysis:{ ...this.state.analysis, shortcutType:selectedType, shortcutQuery:'', shortcutOptions:[], shortcutBusy:true } });
    let load;
    if(selectedType==='gcr'){
      load=Promise.resolve(Object.keys(this.GCR_NOMBRE).map(key=>{
        const center=this._anaGcrShortcutCenter(key);
        const geometry=this._anaGcrShortcutGeometry(key);
        return center&&geometry?{
          kind:'gcr',label:'GCR '+this.GCR_NOMBRE[key],detail:'Gerencia de control regional',
          lat:center[0],lng:center[1],zoom:6,color:this.GCR_COLORS[key]||'#9B2247',code:'GC',geometry
        }:null;
      }).filter(Boolean));
    } else if(selectedType==='demand'){
      load=this._anaAtlasShortcutGeo(
        'demanda_atlas',
        '/DashboardProyectos/AtlasSen/Demanda/GeoJson'
      ).then(geo=>(geo.features||[]).map(feature=>{
        const props=feature.properties||{};
        const region=String(props.region||props.gerencia_nombre||'').trim();
        const center=this._centroid(feature.geometry);
        return region&&center?{
          kind:'demand-region',
          label:'Región CENACE '+region,
          detail:'Zona para demanda, generación y pronóstico',
          lat:center[0],lng:center[1],zoom:6,
          color:this._atlasLayerColor(
            this.LAYERS.find(layer=>layer.key==='demanda_atlas'),
            props
          ),
          code:'DM',
          geometry:{type:'Feature',properties:props,geometry:feature.geometry}
        }:null;
      }).filter(Boolean).sort((a,b)=>a.label.localeCompare(b.label,'es')));
    } else if(selectedType==='tariff'){
      load=this._anaAtlasShortcutGeo(
        'tarifas_atlas',
        '/DashboardProyectos/AtlasSen/Divisiones/GeoJson'
      ).then(geo=>(geo.features||[]).map(feature=>{
        const props=feature.properties||{};
        const division=String(props.division||'').trim();
        const center=this._centroid(feature.geometry);
        return division&&center?{
          kind:'tariff-division',
          label:'División CFE '+division,
          detail:'Zona para usuarios, consumo e intensidad',
          lat:center[0],lng:center[1],zoom:7,
          color:this._tariffMetricColor(props,this.state.marketMetric),
          code:'UC',
          geometry:{type:'Feature',properties:props,geometry:feature.geometry}
        }:null;
      }).filter(Boolean).sort((a,b)=>a.label.localeCompare(b.label,'es')));
    } else if(selectedType==='state'){
      load=Promise.resolve((this.state.entidades||[]).map(name=>{
        const center=this.estCentroid&&this.estCentroid[this._norm(name)];
        return center?{
          kind:'state',label:name,detail:'Entidad federativa',
          state:name,stateCode:String((center.feature.properties||{}).CVE_ENT||(center.feature.properties||{}).cve_ent||'').padStart(2,'0'),
          lat:center.lat,lng:center.lng,zoom:7,color:'#0E8A6E',code:'ED',geometry:center.feature
        }:null;
      }).filter(Boolean));
    } else if(selectedType==='podecobi'){
      load=Promise.all([this._fetchPolosCache(),this._fetchPolosGeoCache()]).then(([polos,geo])=>{
        const byNumber=new Map();
        ((geo&&geo.features)||[]).forEach(feature=>{
          const number=String((feature.properties||{}).Numero||'').trim();
          if(!number) return;
          if(!byNumber.has(number)) byNumber.set(number,[]);
          byNumber.get(number).push(feature);
        });
        return (polos||[]).map(p=>{
          const features=byNumber.get(String(p.numero||'').trim())||[];
          return p.centroidLat!=null&&p.centroidLon!=null&&features.length?{
            kind:'podecobi',
            label:p.nombreOficial||('PODECOBI '+(p.numero||'')),
            detail:[p.estado,p.municipio,p.etapa].filter(Boolean).join(' · '),
            state:p.estado||'',municipality:p.municipio||'',
            lat:+p.centroidLat,lng:+p.centroidLon,zoom:10,color:'#9B2247',code:'PO',
            geometry:{type:'FeatureCollection',features}
          }:null;
        }).filter(Boolean).sort((a,b)=>a.label.localeCompare(b.label,'es'));
      });
    } else if(selectedType==='pam'){
      load=this._fetchPamCache().then(items=>(items||[])
        .map(item=>this._pamShortcutOption(item))
        .filter(Boolean)
        .sort((a,b)=>a.label.localeCompare(b.label,'es')));
    } else {
      load=this._anaMunicipiosShortcutGeo().then(geo=>(geo.features||[]).map(f=>{
        const p=f.properties||{}, name=p.NOMGEO||p.nombre||'';
        const entKey=String(p.CVE_ENT||p.cve_ent||'').padStart(2,'0');
        const ent=this.CVE_ENT[entKey]||this._propEnt(p)||'';
        const center=this._centroid(f.geometry);
        return name&&center?{
          kind:'municipality',label:name+(ent?', '+ent:''),
          detail:'Municipio'+(p.CVEGEO?' · CVEGEO '+p.CVEGEO:''),
          state:ent,municipality:name,stateCode:entKey,
          municipalityCode:String(p.CVE_MUN||p.cve_mun||(p.CVEGEO?String(p.CVEGEO).slice(-3):'')).padStart(3,'0'),
          lat:center[0],lng:center[1],zoom:10,color:'#C9A24B',code:'MU',
          geometry:{type:'Feature',properties:p,geometry:f.geometry}
        }:null;
      }).filter(Boolean).sort((a,b)=>a.label.localeCompare(b.label,'es')));
    }
    return load.then(options=>{
      if(this._anaShortcutLoadToken!==token) return;
      this.setState({ analysis:{ ...this.state.analysis, shortcutType:selectedType, shortcutOptions:options, shortcutBusy:false } });
    }).catch(e=>{
      if(this._anaShortcutLoadToken!==token) return;
      this.setState({ analysis:{ ...this.state.analysis, shortcutType:selectedType, shortcutOptions:[], shortcutBusy:false } });
      this._toast('No se pudo cargar el catálogo territorial: '+(e.message||e));
    });
  };
  anaSetShortcutType = (type) => this.anaLoadShortcutOptions(type);
  onAnaShortcutQuery = (e) => this.setState({ analysis:{ ...this.state.analysis, shortcutQuery:e.target.value } });
  anaShortcutPick = (option) => {
    if(!option||!isFinite(option.lat)||!isFinite(option.lng)) return;
    this.setState({ analysis:{ ...this.state.analysis, shortcutQuery:option.label } });
    if(option.kind==='pam'){
      this._analyzePamOption(option);
      return;
    }
    if(option.geometry){
      this._anaPlaceTerritory(option);
      return;
    }
    this._toast('El territorio seleccionado no tiene una geometría disponible');
  };
  // Respaldo del buscador del header: si no hay coincidencia local, busca como dirección
  _searchAddress(q){
    this._toast('Buscando dirección…');
    this._geocode(q).then(rs => {
      if (!rs.length) { this._toast('Sin resultados en México para «'+q+'»'); return; }
      const r = rs[0];
      this.map.setView([r.lat, r.lng], 13, { animate:true });
      this._setHighlight(r.lat, r.lng, '#1E9CB8');
      this.setState({ search:'' });
      this._toast(r.label.split(',').slice(0,3).join(','));
      this._anaFromSearch({ ll:[r.lat, r.lng] });
    }).catch(() => this._toast('El servicio de direcciones no respondió'));
  }
  // Una ubicación elegida en el buscador reubica la zona de análisis cuando el análisis está
  // en uso (panel abierto o modo colocación) — así el radio y las capas aplican sobre ella.
  _anaFromSearch(e){
    if (!e || !e.ll || !isFinite(e.ll[0]) || !isFinite(e.ll[1])) return;
    const A = this.state.analysis;
    if (this.state.anaOpen || A.placing || A.lat) {
      if(e.pamItem){
        const option=this._pamShortcutOption(e.pamItem);
        if(option) this._analyzePamOption(option);
        return;
      }
      const rawKind=String(e.kind||'').toLowerCase();
      const kind=rawKind.includes('gerencia')?'gcr':rawKind.includes('municipio')?'municipality':rawKind.includes('estado')?'state':rawKind.includes('podecobi')?'podecobi':'point';
      this._anaPlace(e.ll[0], e.ll[1], {
        kind,
        label:e.label||'Ubicación seleccionada',
        detail:e.kind||'Resultado del buscador'
      });
    }
  }
  anaSetRadius = (km) => {
    // El estado se actualiza SIEMPRE primero: un fallo de dibujo de Leaflet no debe impedir
    // el cambio de radio (síntoma: tras ejecutar un análisis, setRadius lanzaba una excepción
    // interna ('reading x') y el clic en la pastilla de radio se perdía por completo).
    this.setState({ analysis: { ...this.state.analysis, radiusKm:km, stale:true,progress:null,cancelled:false,intensiveConfirmed:false } }, () => {
      this._renderZonalDatasets();
      this._recompute();
    });
    const A = this.state.analysis;
    if (A.lat == null) return;
    // El círculo se recrea desde cero: garantiza la re-proyección y el redibujo aunque el
    // renderer compartido haya quedado en mal estado tras un análisis (fitBounds animado)
    const L = window.L;
    try { if (this._anaCircle) this.map.removeLayer(this._anaCircle); } catch(e) {}
    this._anaCircle = null;
    try {
      if (!this._drawR) { try { this._drawR = L.svg({ pane:'draw', padding:0.5 }); this._drawR.addTo(this.map); } catch(e){} }
      this._anaCircle = L.circle([A.lat, A.lng], { renderer:this._drawR, radius:km*1000, color:'#9B2247', weight:1.6, dashArray:'7 6', fillColor:'#9B2247', fillOpacity:.05, interactive:false }).addTo(this.map);
      this._guardPath(this._anaCircle);
      this.map.fitBounds(this._anaCircle.getBounds().pad(0.3), { animate:true });
    } catch(e) {}
  };
  anaSetTerritoryBuffer = (km) => {
    const A=this.state.analysis;
    if(!A||!A.territoryGeometry) return;
    const bufferKm=Math.max(0,Number(km)||0);
    const effective=this._bufferTerritoryGeometry(A.territoryGeometry,bufferKm);
    if(!effective) return;
    const area=this._analysisAreaKm2({analysisGeometry:effective});
    const bounds=this._renderAnalysisTerritory(A.territoryGeometry,effective,bufferKm);
    this.setState({analysis:{
      ...A,bufferKm,analysisGeometry:effective,territoryAreaKm2:area,stale:true,
      progress:null,cancelled:false,intensiveConfirmed:false
    }},()=>{
      this._renderZonalDatasets();
      this._recompute();
      try{ if(bounds&&bounds.isValid()) this.map.fitBounds(bounds.pad(.12),{animate:true}); }catch(e){}
    });
  };
  anaToggleSel = (key) => {
    const A = this.state.analysis;
    this._report=null;
    document.documentElement.classList.remove('dg-report-shell');
    this.setState({
      selected:null,reportOpen:false,reportSendOpen:false,
      analysis: {
        ...A,sel:{...A.sel,[key]:!A.sel[key]},
        stale:true,profile:'custom',intensiveConfirmed:false
      }
    });
  };
  // Escenarios: aplica un conjunto de capas de un solo golpe (o vacía la selección con []).
  anaApplyPreset = (keys,profile) => {
    const A = this.state.analysis;
    if (keys === 'RECOMMENDED') keys = this._analysisRecommendedKeys(A);
    if (keys === 'ALL') keys = this.LAYERS.filter(c => c.analysis).map(c => c.key);
    const sel = {}; keys.forEach(k => sel[k] = true);
    this._report=null;
    document.documentElement.classList.remove('dg-report-shell');
    this.setState({
      selected:null,reportOpen:false,reportSendOpen:false,
      analysis: {
        ...A,sel,stale:true,profile:profile||'custom',progress:null,cancelled:false,
        intensiveConfirmed:false
      }
    });
    if(profile==='intensive'){
      const mb=this._analysisEstimateMb(keys);
      this._toast('Modo intensivo seleccionado · '+keys.length+' capas · ejecuta el análisis para actualizar el reporte · hasta '+mb.toLocaleString('es-MX',{maximumFractionDigits:0})+' MB');
    }
  };
  // Grupos de capas por escenario — se usan tanto para aplicar como para detectar cuál está activo.
  ANA_PRESETS = [
    { key:'recommended', label:'Recomendado', color:'#0E8A6E', hint:'Territorios amplios: infraestructura esencial. Zonas locales: agrega áreas naturales principales.', keys:'RECOMMENDED' },
    { key:'ambiental',   label:'Ambiental',   color:'#0E8A6E', hint:'ANP, RAMSAR, conservación y áreas estatales',        keys:['anp','anp_est','conserv','ramsar'] },
    { key:'social',      label:'Social',      color:'#9B2247', hint:'Pueblos, lenguas, localidades y regiones indígenas', keys:['atlas_pi','lenguas','loc_ind','reg_ind','ruta_wx'] },
    { key:'cultural',    label:'Cultural',    color:'#C0552E', hint:'Sitios y zonas arqueológicas · zonas históricas',    keys:['arqueo','za_pub','z_hist'] },
    { key:'territorial', label:'Territorial', color:'#1E9CB8', hint:'Red eléctrica, ductos, presas y núcleos agrarios',   keys:['red_se_transmision','red_se_distribucion','red_lineas','centrales','presas','ran','ductos_imp','ductos_sis'] },
    { key:'permits',     label:'Permisos energéticos', color:'#9B2247', hint:'Electricidad e hidrocarburos autorizados dentro de la cobertura', keys:['perm_elec','perm_gn','perm_glp','perm_pet'] },
    { key:'prices',      label:'Precios energéticos', color:'#A57F2C', hint:'Divisiones tarifarias y último histórico eléctrico disponible', keys:['tarifas_div'] },
    { key:'intensive',   label:'Todos · intensivo', color:'#1c1b1a', hint:'Todas las capas; las fuentes masivas se procesan al final y se resumen en territorios amplios', keys:'ALL' },
    { key:'ninguno',     label:'Ninguno',     color:'#6F6B66', hint:'Quitar todas las capas seleccionadas',               keys:[] },
  ];
  anaClear = () => {
    if(this._analysisAbortController){ try{ this._analysisAbortController.abort(); }catch(e){} this._analysisAbortController=null; }
    this._analysisRunId=(this._analysisRunId||0)+1;
    this._anaSummary = null;
    if (this._anaMarker) { try { this.map.removeLayer(this._anaMarker); } catch(e){} this._anaMarker = null; }
    if (this._anaCircle) { try { this.map.removeLayer(this._anaCircle); } catch(e){} this._anaCircle = null; }
    this._clearAnalysisTerritoryLayers();
    this._preparedAnalysisContext=null;
    this._analysisFilteredGeo={};
    this._analysisSourceMeta={};
    this._analysisPreparedKey={};
    const layers = { ...this.state.layers };
    this.state.analysis.ranKeys.forEach(k => {
      const g = this.groups[k]; if (g) { try { g.clearLayers(); this.map.removeLayer(g); } catch(e){} }
      if (this._genericFeats) delete this._genericFeats[k];
      layers[k] = { ...layers[k], on:false, count:0, summarized:false, analyzed:false };
    });
    this._anaSubSet = null; this._anaLineSet = null;
    this.map.getContainer().style.cursor = '';
    this._invalidateSearch();
    this.setState({ layers, selected:null, collapsed:{ ...this.state.collapsed, detalle:true }, analysis: {
      placing:false, lat:null, lng:null, estado:'', radiusKm:this.state.analysis.radiusKm, bufferKm:0,
      territoryGeometry:null, analysisGeometry:null, territoryAreaKm2:null,
      sel:{}, ranKeys:[],
      stale:false, running:false, profile:'recommended',progress:null,cancelled:false,
      intensiveConfirmed:false,mode:'click', latIn:'', lngIn:'', dirIn:'', dirResults:[],
      shortcutType:'gcr', shortcutQuery:'', shortcutOptions:[], shortcutBusy:false,
      targetKind:'', targetLabel:'', targetDetail:'', targetState:'', targetMunicipality:'',
      targetStateCode:'', targetMunicipalityCode:''
    } }, () => {
      this._renderZonalDatasets();
      this._recompute();
    });
  };
  // Filtra un GeoJSON contra el círculo cuando el objetivo es puntual; los atajos territoriales
  // usan la geometría efectiva (polígono original o su buffer) mediante _filterByAnalysis.
  // Distancia al feature MÁS CERCANO de un GeoJSON (muestreo de vértices) — para explicar los ceros
  _nearestFeatKm(geo, lat, lng){
    let best=Infinity; const feats=this._normFeatures(geo);
    feats.forEach(f=>{ const gm=f.geometry; if(!gm) return; const pts=[]; const acc=(x)=>{ if(!Array.isArray(x)) return; if(!Array.isArray(x[0])){ pts.push(x); return; } x.forEach(acc); }; acc(gm.coordinates||[]); const step=Math.max(1,Math.floor(pts.length/30)); for(let i=0;i<pts.length;i+=step){ const p=pts[i]; if(!p||!isFinite(p[0])||!isFinite(p[1])) continue; const d=this._haversine(lat,lng,p[1],p[0]); if(d<best)best=d; } });
    return isFinite(best)? best : null;
  }
  _filterByRadius(geo, lat, lng, km){
    const feats = this._normFeatures(geo); const out = [];
    const degLat = km/111, degLng = km/(111*Math.max(.2, Math.cos(lat*Math.PI/180))); // pre-filtro bbox barato
    const anyNear = (c) => {
      if (!Array.isArray(c)) return false;
      if (!Array.isArray(c[0])) { const dy=Math.abs(c[1]-lat), dx=Math.abs(c[0]-lng); if (dy>degLat||dx>degLng) return false; return this._haversine(lat, lng, c[1], c[0]) <= km; }
      return c.some(anyNear);
    };
    const near = (gm) => { if (!gm) return false; if (gm.type==='GeometryCollection') return (gm.geometries||[]).some(near); if (anyNear(gm.coordinates)) return true; return (gm.type==='Polygon'||gm.type==='MultiPolygon') && this._inFeature(lng, lat, gm); };
    feats.forEach(f => { try { if (near(f.geometry)) out.push(f); } catch(e){} });
    return { type:'FeatureCollection', features: out };
  }
  anaCancel = () => {
    const progress=this.state.analysis&&this.state.analysis.progress;
    if(this._analysisAbortController){ try{ this._analysisAbortController.abort(); }catch(e){} }
    this._analysisRunId=(this._analysisRunId||0)+1;
    this.setState({
      blocking:null,
      analysis:{...this.state.analysis,running:false,progress:null,cancelled:true,stale:true}
    });
    this._toast('Análisis cancelado'+(progress&&progress.completed?' · '+progress.completed+' capa(s) procesada(s)':''));
  };
  anaRun = async () => {
    const A = this.state.analysis;
    if(A.running) return;
    if (!A.lat) { this._toast('Primero ubica la zona de análisis en el mapa'); return; }
    const selectedKeys = this.LAYERS.filter(c => c.analysis && A.sel[c.key]).map(c => c.key);
    const selKeys = this._analysisOrderedKeys(selectedKeys);
    const activeDatasets=this.state.datasets.filter(d=>d.active);
    if (!selKeys.length && !activeDatasets.length) { this._toast('Selecciona al menos una capa o un dataset para analizar'); return; }
    const regional=this._analysisIsRegional(A);
    const allCount=this.LAYERS.filter(c=>c.analysis).length;
    const intensive=A.profile==='intensive'||selKeys.length===allCount;
    const estimatedMb=this._analysisEstimateMb(selKeys);
    if(intensive&&regional&&!A.intensiveConfirmed){
      const accepted=window.confirm(
        'Este análisis territorial intensivo procesará '+selKeys.length+' capas y hasta '+
        estimatedMb.toLocaleString('es-MX',{maximumFractionDigits:0})+
        ' MB de fuentes nacionales. Las capas masivas se resumirán y podrán encenderse después. ¿Continuar?'
      );
      if(!accepted) return;
    }
    if(this._analysisAbortController){ try{ this._analysisAbortController.abort(); }catch(e){} }
    const controller=new AbortController();
    this._analysisAbortController=controller;
    const runId=(this._analysisRunId||0)+1;
    this._analysisRunId=runId;
    const ensureActive=()=>{
      if(controller.signal.aborted||runId!==this._analysisRunId){
        const error=new Error('Análisis cancelado'); error.name='AbortError'; throw error;
      }
    };
    this._rawGeo = this._rawGeo || {};
    this._analysisFilteredGeo={};
    this._analysisSourceMeta={};
    const coverageLabel=this._analysisCoverageLabel(A,false);
    const prepared=this._prepareAnalysisContext(A);
    const selectionKey=this._analysisSelectionKey(A);
    let processedMb=0;
    const completedKeys=[];
    const failedKeys=[];
    const layers = { ...this.state.layers };
    this.setState({
      analysis:{...A,running:true,progress:{completed:0,total:selKeys.length,label:'Preparando análisis',stage:'Preparación',mb:0,totalMb:estimatedMb},cancelled:false,intensiveConfirmed:intensive&&regional},
      blocking:{label:'Preparando '+coverageLabel+'…'}
    });
    // Apaga capas de un análisis anterior que ya no están seleccionadas
    A.ranKeys.filter(k => !selKeys.includes(k)).forEach(k => {
      const g = this.groups[k]; if (g) { try { g.clearLayers(); this.map.removeLayer(g); } catch(e){} }
      if (this._genericFeats) delete this._genericFeats[k];
      layers[k] = { ...layers[k], on:false, count:0, summarized:false, analyzed:false };
    });
    await new Promise(resolve=>setTimeout(resolve,0));
    try{
      for(let i=0;i<selKeys.length;i++){
        ensureActive();
        const key=selKeys[i];
        const cfg=this.LAYERS.find(c=>c.key===key);
        const cost=this._analysisCost(key);
        const inMemory=(key==='subestaciones'||key==='lineas');
        const stage=this._analysisStage(key);
        const setProgress=(fraction,label)=>{
          const mb=processedMb+(Number(cost.mb)||0)*Math.max(0,Math.min(1,fraction||0));
          const pct=Math.round(((i+Math.max(0,Math.min(1,fraction||0)))/Math.max(1,selKeys.length))*100);
          const progress={completed:i,total:selKeys.length,label:label||cfg.label,stage,mb,totalMb:estimatedMb,pct};
          this.setState({
            analysis:{...this.state.analysis,running:true,progress},
            blocking:{label:pct+'% · '+stage+' · '+cfg.label}
          });
        };
        setProgress(0,cfg.label);
        try{
          let n=0,nearKm=null,summarized=false,reusedPrepared=false;
          const layerCacheKey=selectionKey+'|'+key;
          const preparedKey=this._analysisPreparedKey&&this._analysisPreparedKey[key];
          if(key==='subestaciones'){
            const cached=this._analysisCachedResult(layerCacheKey);
            const set=cached&&preparedKey===layerCacheKey?cached.set:new Set();
            reusedPrepared=!!(cached&&preparedKey===layerCacheKey);
            if(!reusedPrepared){
              const g=this.groups.subestaciones; g.clearLayers();
              (this._subMarkers||[]).forEach(marker=>{
                const sub=marker._rec;
                if(sub&&this._analysisContainsPoint(A,sub.lat,sub.lng,prepared)){ g.addLayer(marker); set.add(sub); }
              });
              this._cacheAnalysisResult(layerCacheKey,{set,count:set.size});
            }
            this._anaSubSet=set; n=set.size;
            if(!n&&!regional) nearKm=(this._nearestSubs(A.lat,A.lng,1)[0]||{}).dist||null;
          }else if(key==='lineas'){
            const cached=this._analysisCachedResult(layerCacheKey);
            const set=cached&&preparedKey===layerCacheKey?cached.set:new Set();
            reusedPrepared=!!(cached&&preparedKey===layerCacheKey);
            if(!reusedPrepared){
              const g=this.groups.lineas; g.clearLayers();
              (this.lineFeatures||[]).forEach(polyline=>{
                let points=polyline.getLatLngs(); while(Array.isArray(points[0])) points=points.flat();
                const feature={type:'Feature',properties:{},geometry:{type:'LineString',coordinates:points.map(point=>[point.lng,point.lat])}};
                if(this._analysisFeatureIntersects(A,feature,prepared)){ g.addLayer(polyline); set.add(polyline); }
              });
              this._cacheAnalysisResult(layerCacheKey,{set,count:set.size});
            }
            this._anaLineSet=set; n=set.size;
            if(!n&&!regional) nearKm=(this._nearestLines(A.lat,A.lng,1)[0]||{}).dist||null;
          }else{
            const cached=this._analysisCachedResult(layerCacheKey);
            let geo=null;
            let filtered;
            let sourceMeta=null;
            if(cached){
              filtered=cached.geo;
              nearKm=cached.nearKm||null;
              sourceMeta=cached.meta||null;
              setProgress(1,cfg.label+' · caché');
            }else{
              geo=cfg.api
                ?await this._fetchAnalysisGeo(cfg,A,controller.signal)
                :(this._rawGeo[key]||await this._mockFetchGeo(cfg.src,{signal:controller.signal}));
              ensureActive();
              if(!cfg.api) this._rawGeo[key]=geo;
              sourceMeta=geo&&geo.meta?geo.meta:null;
              filtered=await this._filterByAnalysisAsync(geo,A,prepared,controller.signal,fraction=>setProgress(fraction,cfg.label));
              if(sourceMeta&&filtered) filtered={...filtered,meta:sourceMeta};
              ensureActive();
            }
            const featureCount=(filtered.features||[]).length;
            summarized=regional&&(
              (cost.tier==='heavy'&&featureCount>750)||
              featureCount>3000
            );
            this._analysisFilteredGeo[key]=filtered;
            const previousSummarized=!!layers[key].summarized;
            const canReusePrepared=!!(cached&&preparedKey===layerCacheKey&&
              (previousSummarized===summarized||(!previousSummarized&&summarized)));
            reusedPrepared=canReusePrepared;
            if(canReusePrepared){
              n=Number(cached.count)||0;
            }else if(cfg.type==='graph'){
              n=summarized?featureCount:this._buildElectricGraph(key,filtered,cfg);
            }else{
              n=this._buildGeneric(key,filtered,cfg,{render:!summarized});
            }
            if(cfg.type==='graph'&&!summarized){
              if(cfg.graphPart==='edges') this._anaLineSet=new Set(this.lineFeatures||[]);
              else this._anaSubSet=new Set(this.subFeatures||[]);
            }
            if(!n&&geo&&!regional&&cost.tier!=='heavy') nearKm=this._nearestFeatKm(geo,A.lat,A.lng);
            if(sourceMeta) this._analysisSourceMeta[key]=sourceMeta;
            if(!cached) this._cacheAnalysisResult(layerCacheKey,{geo:filtered,nearKm,count:n,meta:sourceMeta});
          }
          ensureActive();
          this._analysisPreparedKey=this._analysisPreparedKey||{};
          this._analysisPreparedKey[key]=layerCacheKey;
          this._built[key]=true;
          const group=this.groups[key];
          if(group){
            if(summarized){ try{ if(this.map.hasLayer(group)) this.map.removeLayer(group); }catch(e){} }
            else if(!this.map.hasLayer(group)) group.addTo(this.map);
          }
          if(!summarized&&!reusedPrepared){ try{ this._forceVectorRedraw(key); }catch(e){} }
          layers[key]={...layers[key],on:!summarized,count:n,nearest:nearKm,analyzed:true,summarized,loading:false};
          completedKeys.push(key);
          processedMb+=Number(cost.mb)||0;
          const progress={completed:completedKeys.length,total:selKeys.length,label:cfg.label,stage,mb:processedMb,totalMb:estimatedMb,pct:Math.round((completedKeys.length/Math.max(1,selKeys.length))*100)};
          this.setState({layers:{...layers},analysis:{...this.state.analysis,running:true,progress}});
          await new Promise(resolve=>setTimeout(resolve,0));
        }catch(error){
          if(error&&error.name==='AbortError') throw error;
          console.warn('[Análisis territorial] No se pudo procesar '+key+':',error);
          failedKeys.push(key);
          layers[key]={...layers[key],on:false,count:0,loading:false,analyzed:false,summarized:false};
          processedMb+=Number(cost.mb)||0;
        }
      }
      ensureActive();
      this._invalidateSearch();
      const okKeys = [...completedKeys];
      // Construye un RESUMEN de la zona analizada (conteo por tipo de elemento) y lo muestra en el
      // panel de detalle en vez del detalle de un solo punto.
      const sumRows = okKeys.map(k => {
        const cfg=this.LAYERS.find(c=>c.key===k)||{},ct=layers[k].count||0,nr=layers[k].nearest;
        const suffix=layers[k].summarized?' · resumida; encender para dibujar':'';
        return [cfg.label||k,(ct>0?ct.toLocaleString('es-MX'):(nr?'0 · a '+Math.round(nr)+' km el más cercano':'0'))+suffix];
      });
      failedKeys.forEach(k => { const cfg = this.LAYERS.find(c=>c.key===k) || {}; sumRows.push([cfg.label||k, 'fuente no disponible']); });
      // Datasets externos activos: registros dentro de la cobertura (también van a métricas y reporte)
      const dsParts = this.state.datasets.filter(d=>d.active).map(d => {
        let inR=0; d.rows.forEach(r => { const ll=this._placeRow(r,d); if (ll && this._analysisContainsPoint(A,ll[0],ll[1],prepared)) inR++; });
        return { name:d.name, inR, total:d.rows.length, color:d.color };
      });
      dsParts.forEach(p => sumRows.push(['Dataset · '+p.name, this._nf(p.inR)+' de '+this._nf(p.total)]));
      sumRows.push(['Cobertura de análisis', this._analysisCoverageLabel(A,true)]);
      const centroid=this._analysisCentroidFeature(A);
      const centroidCoordinates=centroid&&centroid.geometry&&centroid.geometry.coordinates;
      const centroidLat=Array.isArray(centroidCoordinates)&&isFinite(centroidCoordinates[1])?Number(centroidCoordinates[1]):Number(A.lat);
      const centroidLng=Array.isArray(centroidCoordinates)&&isFinite(centroidCoordinates[0])?Number(centroidCoordinates[0]):Number(A.lng);
      sumRows.push(['Centroide de referencia', centroidLat.toFixed(4)+', '+centroidLng.toFixed(4)]);
      const totalEl = okKeys.reduce((s,k)=>s+(layers[k].count||0),0) + dsParts.reduce((s,p)=>s+p.inR,0);
      // Métricas rápidas: las capas con MÁS elementos primero (evita mostrar puros ceros
      // cuando las primeras capas seleccionadas no tienen presencia en el radio)
      const pool = [...okKeys].map(k=>{ const cfg=this.LAYERS.find(c=>c.key===k)||{}; return { label:cfg.label||k, count:layers[k].count||0, color:cfg.color||'#9B2247' }; })
        .concat(dsParts.map(p=>({ label:p.name, count:p.inR, color:p.color||'#1E9CB8' })));
      const sumMetrics = pool.sort((a,b)=>b.count-a.count).slice(0,6).map(p=>({ label:p.label, value:p.count.toLocaleString('es-MX'), unit:'', accent:p.color }));
      const selectedTarget=A.targetLabel||A.estado||'Zona';
      sumRows.unshift(['Objetivo evaluado',selectedTarget]);
      const anaSelected = { kicker:'Análisis de zona · '+coverageLabel, color:'#9B2247', name:selectedTarget+' — '+totalEl.toLocaleString('es-MX')+' elementos', rows:sumRows, metrics:sumMetrics, isAnaSummary:true };
      this._anaSummary = anaSelected; // se conserva para poder VOLVER al resumen tras ver otro elemento
      this.setState({ layers, blocking:null, anaOpen:false, menuOpen:null, selected:anaSelected, collapsed:{ ...this.state.collapsed, detalle:false }, analysis: { ...this.state.analysis, running:false, progress:null, cancelled:false, stale:false, ranKeys:okKeys } }, () => this._recompute());
      try {
        const focusLayer=this._anaTerritoryBufferLayer||this._anaTerritoryBaseLayer||this._anaCircle;
        if(focusLayer) this.map.fitBounds(focusLayer.getBounds().pad(0.25),{animate:true});
      } catch(e){}
      // Refresca el KPI de PODECOBI con la nueva zona/radio del análisis
      this._updatePolosKpi();
      const total = okKeys.reduce((s,k) => s+(layers[k].count||0), 0) + dsParts.reduce((s,p)=>s+p.inR,0);
      const summarizedCount=okKeys.filter(key=>layers[key].summarized).length;
      this._toast('Análisis listo · '+total.toLocaleString('es-MX')+' elementos · '+coverageLabel+(summarizedCount?' · '+summarizedCount+' capa(s) resumida(s)':'')+(failedKeys.length?' · '+failedKeys.length+' capa(s) sin fuente disponible':''));
      if(this._analysisAbortController===controller) this._analysisAbortController=null;
    }catch(error){
      const aborted=(error&&error.name==='AbortError')||controller.signal.aborted||runId!==this._analysisRunId;
      if(this._analysisAbortController===controller) this._analysisAbortController=null;
      this.setState({
        layers:{...layers},
        blocking:null,
        analysis:{...this.state.analysis,running:false,progress:null,cancelled:aborted,stale:true,ranKeys:[...completedKeys]}
      });
      if(!aborted) this._toast('Error en el análisis: '+(error.message||error));
    }
  };
  _pickPolygonAt(latlng){
    // Resuelve la capa territorial bajo el clic por point-in-polygon, de lo más específico a lo
    // más general: municipio → estado → gerencia. Necesario porque los panes superiores (data/
    // genvec/muni) capturan el clic del ratón y los polígonos de contexto nunca lo reciben directo.
    if (this.state.layers.municipios.on && this._muniGeo) {
      for (const f of (this._muniGeo.features||[])) { if (this._inFeature(latlng.lng, latlng.lat, f.geometry)) { this._selectMunicipio(f.properties||{}); return true; } }
    }
    const est = this.geo && this.geo.estados && (this.geo.estados.features||[]);
    if (this.state.layers.estados.on && est) {
      for (const f of est) { if (this._inFeature(latlng.lng, latlng.lat, f.geometry)) { const nom=this._propEnt(f.properties)||'Entidad'; this._selectEstado(nom, f); return true; } }
    }
    if (this.state.layers.gerencias.on && est) {
      for (const f of est) { if (this._inFeature(latlng.lng, latlng.lat, f.geometry)) { const ent=this._propEnt(f.properties)||''; const gk=this._gerenciaOf(ent); this._selectGerencia(gk, this.GCR_NOMBRE[gk]||ent); return true; } }
    }
    return false;
  }
  _onMapClick(e){
    // Mientras se dibuja/mide, los clics son vértices del trazo — NO seleccionan ni mueven nada
    if (this._handler || this.state.measure) return;
    // Modo "ubicar zona de análisis": el clic coloca el marcador y NO selecciona nada más
    if (this.state.analysis.placing) { this._anaPlace(e.latlng.lat, e.latlng.lng); return; }
    // Si este mismo clic ya seleccionó un elemento puntual (subestación, línea, permiso…),
    // no se sobreescribe con el polígono territorial que queda debajo
    if (this._selAt && (performance.now() - this._selAt) < 350) return;
    this._clearHighlight();
    this._pickPolygonAt(e.latlng);
  }
  // Municipios usa pane dedicado (visibilidad); el resto son grupos normales
  _layerOf(key){ return key==='municipios' ? this.muniLyr : this.groups[key]; }
  _muniPaneShow(show){ const p = this.map.getPane('muni'); if (p) p.style.display = show ? '' : 'none'; }
  // Blinda el dibujo de CUALQUIER capa vectorial (canvas compartido): si un trazo falla al
  // proyectarse, no debe abortar el redibujo de TODAS las demás capas que comparten el mismo
  // renderer por defecto de Leaflet — un solo trazo roto puede, si no se blinda, dejar capas
  // enteras (incluida una recién activada, p.ej. un dataset de miles de puntos) invisibles sin
  // ningún error en consola. Se aplica a TODO Path que toque el renderer compartido: genéricas,
  // subestaciones, líneas, gerencias, estados y zonas de influencia.
  _guardPath(lyr) {
    if (lyr && lyr._updatePath && !lyr.__pathGuarded) {
      const o = lyr._updatePath.bind(lyr);
      lyr._updatePath = function () { try { o(); } catch (e) {} };
      lyr.__pathGuarded = true;
    }
    return lyr;
  }
  // Nube de puntos en UN solo canvas propio (no una capa Leaflet por punto). Para inventarios muy
  // grandes (decenas de miles de elementos, p.ej. Lenguas indígenas · 41,903 o el Atlas de pueblos
  // indígenas · 36 mil puntos) crear un L.circleMarker POR PUNTO desborda el renderer canvas de
  // Leaflet: su ciclo interno de redibujo puede fallar a medio camino y dejar la capa "activa" y
  // con conteo correcto en el panel, pero sin un solo punto pintado — justo el síntoma reportado.
  // Dibujar todos los puntos en una sola pasada de canvas evita ese límite y es además más rápido.
  _makePointCloud(points, color, onPick) {
    const L = window.L;
    if (!this._CloudLayer) {
      this._CloudLayer = L.Layer.extend({
        onAdd(map) {
          this._map = map;
          this._canvas = L.DomUtil.create('canvas', 'dg-cloud');
          this._canvas.style.position = 'absolute';
          this._canvas.style.pointerEvents = 'auto';
          map.getPanes().overlayPane.appendChild(this._canvas);
          this._onMove = () => { try { this._redraw(); } catch(e){} };
          map.on('move zoom resize moveend zoomend', this._onMove);
          this._onClick = (e) => this._handleClick(e);
          this._canvas.addEventListener('click', this._onClick);
          this._redraw();
        },
        onRemove(map) {
          L.DomUtil.remove(this._canvas);
          map.off('move zoom resize moveend zoomend', this._onMove);
          this._canvas.removeEventListener('click', this._onClick);
        },
        _redraw() {
          const map = this._map, size = map.getSize();
          const topLeft = map.containerPointToLayerPoint([0, 0]);
          L.DomUtil.setPosition(this._canvas, topLeft);
          if (this._canvas.width !== size.x) this._canvas.width = size.x;
          if (this._canvas.height !== size.y) this._canvas.height = size.y;
          const ctx = this._canvas.getContext('2d');
          ctx.clearRect(0, 0, size.x, size.y);
          ctx.fillStyle = this._color; ctx.strokeStyle = '#fff'; ctx.lineWidth = 0.8;
          const bounds = map.getBounds().pad(0.15);
          this._visible = [];
          for (const pt of this._pts) {
            if (!isFinite(pt.lat) || !isFinite(pt.lng) || !bounds.contains([pt.lat, pt.lng])) continue;
            const p = map.latLngToContainerPoint([pt.lat, pt.lng]);
            ctx.beginPath(); ctx.arc(p.x, p.y, 3, 0, Math.PI * 2); ctx.fill(); ctx.stroke();
            this._visible.push({ x:p.x, y:p.y, pt });
          }
        },
        _handleClick(e) {
          const rect = this._canvas.getBoundingClientRect();
          const x = e.clientX - rect.left, y = e.clientY - rect.top;
          let best = null, bestD = 64; // radio de acierto ~8px al cuadrado
          (this._visible || []).forEach(v => { const d = (v.x-x)*(v.x-x) + (v.y-y)*(v.y-y); if (d < bestD) { bestD = d; best = v.pt; } });
          if (best && this._onPick) this._onPick(best);
        },
      });
    }
    const layer = new this._CloudLayer();
    layer._pts = points; layer._color = color; layer._onPick = onPick;
    return layer;
  }
  _countGenericFeatures(geo){
    let count=0;
    const walk=(gm)=>{
      if(!gm) return;
      const type=gm.type;
      if(type==='Point'||type==='LineString'||type==='Polygon') count++;
      else if(type==='MultiPoint'||type==='MultiLineString'||type==='MultiPolygon') count+=(gm.coordinates||[]).length;
      else if(type==='GeometryCollection') (gm.geometries||[]).forEach(walk);
    };
    this._normFeatures(geo).forEach(feature=>walk(feature.geometry));
    return count;
  }
  _makeVoltageLabelLayer(records){
    const L=window.L;
    if(!this._VoltageLabelLayer){
      this._VoltageLabelLayer=L.Layer.extend({
        initialize(items){ this._items=items||[]; this._frame=null; },
        onAdd(map){
          this._map=map;
          this._canvas=L.DomUtil.create('canvas','dg-voltage-labels');
          this._canvas.style.position='absolute';
          this._canvas.style.pointerEvents='none';
          map.getPane('graphlabels').appendChild(this._canvas);
          map.on('move zoom resize moveend zoomend',this._queue,this);
          this._queue();
        },
        onRemove(map){
          map.off('move zoom resize moveend zoomend',this._queue,this);
          if(this._frame){ cancelAnimationFrame(this._frame); this._frame=null; }
          if(this._canvas) L.DomUtil.remove(this._canvas);
          this._canvas=null; this._map=null;
        },
        _queue(){
          if(this._frame) return;
          this._frame=requestAnimationFrame(()=>{
            this._frame=null;
            try{this._redraw();}catch(error){}
          });
        },
        _redraw(){
          const map=this._map,canvas=this._canvas;
          if(!map||!canvas) return;
          const size=map.getSize(),dpr=Math.min(2,window.devicePixelRatio||1);
          const topLeft=map.containerPointToLayerPoint([0,0]);
          L.DomUtil.setPosition(canvas,topLeft);
          const pixelWidth=Math.max(1,Math.round(size.x*dpr));
          const pixelHeight=Math.max(1,Math.round(size.y*dpr));
          if(canvas.width!==pixelWidth) canvas.width=pixelWidth;
          if(canvas.height!==pixelHeight) canvas.height=pixelHeight;
          canvas.style.width=size.x+'px'; canvas.style.height=size.y+'px';
          const ctx=canvas.getContext('2d');
          ctx.setTransform(dpr,0,0,dpr,0,0);
          ctx.clearRect(0,0,size.x,size.y);
          const zoom=map.getZoom(),bounds=map.getBounds().pad(.12);
          const occupied=[];
          let shown=0;
          for(const item of this._items){
            if(shown>=110||zoom<item.minZoom||!item.bounds.intersects(bounds)) continue;
            let best=null;
            (item.segments||[]).forEach(segment=>{
              for(let i=1;i<segment.length;i++){
                const a=map.latLngToContainerPoint(segment[i-1]);
                const b=map.latLngToContainerPoint(segment[i]);
                const mx=(a.x+b.x)/2,my=(a.y+b.y)/2;
                if(mx<-70||my<-40||mx>size.x+70||my>size.y+40) continue;
                const dx=b.x-a.x,dy=b.y-a.y,length=Math.sqrt(dx*dx+dy*dy);
                if(length>=34&&(!best||length>best.length)) best={a,b,mx,my,dx,dy,length};
              }
            });
            if(!best) continue;
            const fontSize=zoom>=10?11:10;
            ctx.font='800 '+fontSize+'px "IBM Plex Mono",monospace';
            const width=ctx.measureText(item.label).width+22,height=fontSize+14;
            const box={x1:best.mx-width/2,y1:best.my-height/2,x2:best.mx+width/2,y2:best.my+height/2};
            if(occupied.some(other=>!(box.x2<other.x1||box.x1>other.x2||box.y2<other.y1||box.y1>other.y2))) continue;
            occupied.push(box);
            let angle=Math.atan2(best.dy,best.dx);
            if(angle>Math.PI/2) angle-=Math.PI;
            if(angle<-Math.PI/2) angle+=Math.PI;
            ctx.save();
            ctx.translate(best.mx,best.my);
            ctx.rotate(angle);
            ctx.textAlign='center'; ctx.textBaseline='middle'; ctx.lineJoin='round';
            ctx.strokeStyle=item.darkHalo?'rgba(17,24,39,.92)':'rgba(255,255,255,.94)';
            ctx.lineWidth=3.8;
            ctx.strokeText(item.label,0,0);
            ctx.fillStyle=item.color;
            ctx.fillText(item.label,0,0);
            ctx.restore();
            shown++;
          }
        }
      });
    }
    return new this._VoltageLabelLayer(records);
  }
  _buildElectricGraph(key, geo, cfg){
    const L=window.L;
    const group=this.groups[key];
    group.clearLayers();
    this._clearGraphFocus();
    this._graphNodeById=this._graphNodeById||new Map();
    this._graphEdgeById=this._graphEdgeById||new Map();
    const searchRecords=[];
    const graphLineRecords=[];
    const graphSubstationRecords=[];
    const features=this._normFeatures(geo);
    // El grafo formal identifica explícitamente nodos/aristas. El inventario conciliado de
    // subestaciones también es una fuente válida de nodos y se acepta por geometría para que una
    // etiqueta de procedencia no deje la capa "activa" con contador, pero sin puntos dibujados.
    const edges=features.filter(feature=>{
      const p=feature.properties||{};
      return p.element_type==='edge'||(
        cfg.graphPart==='edges'&&
        feature.geometry&&
        (feature.geometry.type==='LineString'||feature.geometry.type==='MultiLineString')
      );
    });
    const nodes=features.filter(feature=>{
      const p=feature.properties||{};
      return p.element_type==='node'||p.element_type==='substation_inventory'||(
        cfg.graphPart==='nodes'&&feature.geometry&&feature.geometry.type==='Point'
      );
    });
    const labelRecords=[];
    const lineSegments=geometry=>{
      if(!geometry) return [];
      if(geometry.type==='LineString') return [geometry.coordinates||[]];
      if(geometry.type==='MultiLineString') return geometry.coordinates||[];
      return [];
    };
    const toLatLngs=segment=>(segment||[])
      .filter(coordinate=>Array.isArray(coordinate)&&isFinite(coordinate[0])&&isFinite(coordinate[1]))
      .map(coordinate=>[Number(coordinate[1]),Number(coordinate[0])]);

    edges.forEach(feature=>{
      const p=feature.properties||{};
      const edgeId=String(p.edge_id||'');
      const state=String(p.connection_state||'sin_resolver');
      const kv=Number(p.voltage_kv)||0;
      const color=this._colorForKv(kv);
      const dash=state==='conectada'?null:(state==='parcial'?'7 5':'3 6');
      const weight=this._lineWeightForKv(kv);
      const labelSegments=[];
      let labelBounds=null;
      lineSegments(feature.geometry).forEach(segment=>{
        const latlngs=toLatLngs(segment);
        if(latlngs.length<2) return;
        labelSegments.push(latlngs.map(latlng=>L.latLng(latlng[0],latlng[1])));
        const segmentBounds=L.latLngBounds(latlngs);
        labelBounds=labelBounds?labelBounds.extend(segmentBounds):segmentBounds;
        if(color.toUpperCase()==='#FFFFFF'){
          const casing=L.polyline(latlngs,{
            color:'#27313B',weight:weight+2.1,opacity:state==='sin_resolver' ? .42 : .78,
            dashArray:dash,renderer:this._graphRenderer,pane:'graphlines',
            noClip:false,smoothFactor:.7,interactive:false
          });
          this._guardPath(casing);
          group.addLayer(casing);
        }
        const line=L.polyline(latlngs,{
          color,weight,opacity:state==='sin_resolver' ? .42 : (state==='parcial' ? .72 : .9),
          dashArray:dash,renderer:this._graphRenderer,pane:'graphlines',noClip:false,smoothFactor:.7
        });
        this._guardPath(line);
        line._rec={
          name:String(p.name||'Línea de transmisión'),
          kv,
          props:p,
          km:Number(p.length_km)||this._lineKm(latlngs)
        };
        graphLineRecords.push(line);
        line.bindTooltip(
          String(p.name||'Línea de transmisión')+(kv?' · '+kv.toLocaleString('es-MX')+' kV':''),
          {sticky:true}
        );
        line.on('click',event=>{
          this._selAt=performance.now();
          try{if(event&&event.originalEvent)L.DomEvent.stopPropagation(event.originalEvent);}catch(error){}
          this._selectGraphEdge(p,line);
        });
        group.addLayer(line);
        if(edgeId&&!this._graphEdgeById.has(edgeId)){
          this._graphEdgeById.set(edgeId,{props:p,layer:line,geometry:feature.geometry});
        }
      });
      if(kv>0&&labelBounds&&labelSegments.length){
        labelRecords.push({
          label:kv.toLocaleString('es-MX',{maximumFractionDigits:1})+' kV',
          color,minZoom:this._voltageLabelMinZoom(kv),kv,
          darkHalo:color.toUpperCase()==='#FFFFFF'||color.toUpperCase()==='#F2C94C',
          segments:labelSegments,bounds:labelBounds
        });
      }
    });

    nodes.forEach(feature=>{
      const p=feature.properties||{};
      const coordinates=(feature.geometry&&feature.geometry.coordinates)||[];
      if(!isFinite(coordinates[0])||!isFinite(coordinates[1])) return;
      const lng=Number(coordinates[0]),lat=Number(coordinates[1]);
      const nodeId=String(p.node_id||'');
      const virtual=!!p.is_virtual;
      const transmission=cfg.graphNodeKind==='transmission'||String(p.network_level)==='transmision';
      const undetermined=String(p.network_level)==='indeterminado';
      const markerColor=transmission?'#8E9AAD':(undetermined?'#8A9099':'#FFFFFF');
      const markerFill=transmission?'#111820':(undetermined?'#8A9099':'#FF9652');
      const marker=L.circleMarker([lat,lng],{
        radius:virtual?2.5:(transmission?(Number(p.voltage_kv)>=400?6.2:5.4):3.2),
        color:virtual?'#fff':markerColor,
        weight:virtual ? .8 : (transmission ? 1.7 : 1),
        fillColor:virtual?'#8A9099':markerFill,
        fillOpacity:virtual ? .58 : (transmission||undetermined ? 0 : .92),
        dashArray:undetermined?'2 2':null,
        renderer:this._dataRenderer,
        pane:'data'
      });
      this._guardPath(marker);
      marker.bindTooltip(String(p.name||(virtual?'Extremo sin resolver':'Subestación')),{
        sticky:true
      });
      marker.on('click',event=>{
        this._selAt=performance.now();
        try{if(event&&event.originalEvent)L.DomEvent.stopPropagation(event.originalEvent);}catch(error){}
        if(nodeId) this._selectGraphNode(p,marker);
        else this._selectInventorySubstation(p,marker);
      });
      group.addLayer(marker);
      if(nodeId) this._graphNodeById.set(nodeId,{props:p,marker,lat,lng});
      if(!virtual){
        graphSubstationRecords.push({
          idx:String(p.universe_key||p.node_id||key+':'+lat.toFixed(6)+':'+lng.toFixed(6)),
          lat,lng,kv:Number(p.voltage_kv)||0,
          name:String(p.name||'Subestación'),
          ent:String(p.state||p.entidad||p.region||''),
          props:p
        });
        searchRecords.push({
          nom:String(p.name||'Subestación'),
          lat,lng,props:p,marker,geometry:feature.geometry
        });
      }
    });

    this._genericFeats=this._genericFeats||{};
    this._genericFeats[key]=searchRecords;
    this._genericCount=this._genericCount||{};
    this._genericCount[key]=cfg.graphPart==='edges'
      ?(Number(geo&&geo.meta&&geo.meta.edges)||edges.length)
      :(Number(geo&&geo.meta&&geo.meta.nodes)||nodes.length);
    if(cfg.graphPart==='edges'){
      this._networkLineFeaturesByLayer=this._networkLineFeaturesByLayer||{};
      this._networkLineFeaturesByLayer[key]=graphLineRecords;
      this.lineFeatures=Object.values(this._networkLineFeaturesByLayer).flat();
    }else{
      this._networkSubFeaturesByLayer=this._networkSubFeaturesByLayer||{};
      this._networkSubFeaturesByLayer[key]=graphSubstationRecords;
      const unique=new Map();
      Object.values(this._networkSubFeaturesByLayer).flat().forEach(record=>{
        const p=record.props||{};
        const id=String(p.universe_key||p.node_id||record.idx);
        if(!unique.has(id)) unique.set(id,record);
      });
      this.subFeatures=[...unique.values()];
    }
    this._vectorPathLayers=this._vectorPathLayers||{};
    this._vectorPathLayers[key]=edges.length>0;
    if(labelRecords.length){
      labelRecords.sort((a,b)=>b.kv-a.kv);
      group.addLayer(this._makeVoltageLabelLayer(labelRecords));
    }
    this._graphMeta=geo&&geo.meta?geo.meta:null;
    return nodes.length+edges.length;
  }
  _selectInventorySubstation(p,marker){
    if(this._handler) return;
    this._selAt=performance.now();
    this._clearHighlight();
    this._clearGraphFocus();
    const point=marker&&marker.getLatLng?marker.getLatLng():null;
    const lat=point?point.lat:null;
    const lng=point?point.lng:null;
    const networkLabel=this._networkLevelLabel(p.network_level);
    const networkColor=this._colorForKv(Number(p.voltage_kv)||0);
    const sources=Array.isArray(p.sources)?p.sources.join(' · '):(p.source||'—');
    const connectedLineNames=Array.isArray(p.connected_line_names)
      ?[...new Set(p.connected_line_names.filter(Boolean))]:[];
    const connectionCount=Number(p.connection_count)||connectedLineNames.length||0;
    const connectionNames=connectedLineNames.length
      ?connectedLineNames.slice(0,14).join(' · ')+(connectedLineNames.length>14?' · …':'')
      :'Sin líneas asociadas';
    const selected={
      kicker:'Inventario eléctrico · referencia georreferenciada',
      color:networkColor,
      name:String(p.name||'Subestación'),
      rows:[
        ['Tipo de infraestructura','Subestación eléctrica · inventario conciliado'],
        ['Nivel de red',networkLabel],
        ['Identificador de universo',p.universe_key||'—'],
        ['Tensión',p.voltage_kv?Number(p.voltage_kv).toLocaleString('es-MX')+' kV':'—'],
        ['Fuentes del registro',sources],
        ['Fuente de coordenadas',p.coordinate_source||'—'],
        ['Estado de conciliación',p.reconciliation_state||'Pendiente'],
        ['Estado de validación',p.validation_state||'Pendiente de revisión humana'],
        ['Líneas asociadas',connectionNames],
        ['Estado topológico',p.connection_validation_state||(connectionCount?'Asociación automática':'Sin asociación')]
      ],
      metrics:[
        {label:'Líneas asociadas',value:String(connectionCount),unit:'',accent:'#9B2247'},
        {label:'Tensión nominal',value:p.voltage_kv?this._nf(Number(p.voltage_kv)):'—',unit:p.voltage_kv?'kV':'',accent:'#E0A12E'},
        {label:'Ubicación',value:'Referencia',unit:'',accent:'#1E9CB8'}
      ],
      lat,lng
    };
    this._flash(marker);
    this.setState({selected},()=>this._recompute());
    const connectedEdgeIds=Array.isArray(p.connected_line_ids)
      ?p.connected_line_ids.map(String):[];
    const focusEdges=connectedEdgeIds
      .map(edgeId=>this._graphEdgeById&&this._graphEdgeById.get(edgeId))
      .filter(Boolean)
      .map(record=>({...record.props,geometry:record.geometry}));
    if(focusEdges.length){
      this._renderGraphFocus({
        nodes:[{latitude:lat,longitude:lng,isVirtual:false}],
        edges:focusEdges
      });
    }
    if(isFinite(lat)&&isFinite(lng)){
      this.map.setView([lat,lng],Math.max(this.map.getZoom(),8),{animate:true});
    }
  }
  _selectGraphNode(p,marker){
    if(this._handler) return;
    const nodeId=String(p.node_id||'');
    if(!nodeId) return;
    this._selAt=performance.now();
    this._clearHighlight();
    this._clearGraphFocus();
    const lat=marker&&marker.getLatLng?marker.getLatLng().lat:null;
    const lng=marker&&marker.getLatLng?marker.getLatLng().lng:null;
    const virtual=!!p.is_virtual;
    const networkLabel=this._networkLevelLabel(p.network_level);
    const networkColor=this._colorForKv(Number(p.voltage_kv)||0);
    const baseRows=[
      ['Tipo de infraestructura',virtual?'Nodo topológico pendiente':'Subestación eléctrica'],
      ['Nivel de red',networkLabel],
      ['Identificador del grafo',nodeId],
      ['Tensión',p.voltage_kv?Number(p.voltage_kv).toLocaleString('es-MX')+' kV':'—'],
      ['Grado topológico',String(p.degree??0)+' conexiones'],
      ['Componente eléctrico',p.component_id||'—'],
      ['Estado de validación',p.validation_state||(virtual?'Pendiente de validar':'Nodo catalogado')],
      ['Conexiones','Consultando…'],
      ['Fuente',p.source||'DGMESNIE · grafo eléctrico']
    ];
    const selected={
      kicker:virtual?'Grafo eléctrico · nodo virtual':'Grafo eléctrico · subestación',
      color:virtual?'#8A9099':networkColor,
      name:String(p.name||(virtual?'Extremo sin resolver':'Subestación')),
      rows:baseRows,
      metrics:[
        {label:'Conexiones directas',value:String(p.degree??0),unit:'',accent:'#9B2247'},
        {label:'Tensión nominal',value:p.voltage_kv?this._nf(Number(p.voltage_kv)):'—',unit:p.voltage_kv?'kV':'',accent:'#E0A12E'},
        {label:'Componente',value:String(p.component_id||'—').replace('cmp:',''),unit:'',accent:'#1E9CB8'}
      ],
      lat,lng
    };
    this._flash(marker);
    this.setState({selected},()=>this._recompute());
    if(isFinite(lat)&&isFinite(lng)) this.map.setView([lat,lng],Math.max(this.map.getZoom(),8),{animate:true});
    const requestId=(this._graphNodeRequestId||0)+1;
    this._graphNodeRequestId=requestId;
    fetch('/DashboardProyectos/RedElectrica/Grafo/Nodos/'+encodeURIComponent(nodeId)+'/Vecinos?depth=1',{
      credentials:'same-origin',headers:{Accept:'application/json'}
    }).then(async response=>{
      const payload=await response.json().catch(()=>null);
      if(!response.ok) throw new Error(payload&&payload.detail?payload.detail:'HTTP '+response.status);
      return payload;
    }).then(result=>{
      if(this._graphNodeRequestId!==requestId||!this.state.selected||this.state.selected.name!==selected.name) return;
      const neighbors=(result.nodes||[]).filter(node=>node.nodeId!==nodeId);
      const realNeighbors=neighbors.filter(node=>!node.isVirtual);
      const lines=result.edges||[];
      const rows=baseRows.filter(row=>row[0]!=='Conexiones');
      rows.splice(7,0,
        ['Líneas conectadas',lines.length?lines.slice(0,14).map(edge=>edge.name).join(' · '):'Sin líneas conectadas'],
        ['Subestaciones vecinas',realNeighbors.length?realNeighbors.slice(0,14).map(node=>node.name).join(' · '):'Sin subestaciones vecinas'],
        ['Extremos de línea sin resolver',String(neighbors.filter(node=>node.isVirtual).length)]
      );
      const next={...selected,rows,metrics:[
        {label:'Líneas conectadas',value:String(lines.length),unit:'',accent:'#9B2247'},
        {label:'Subestaciones vecinas',value:String(realNeighbors.length),unit:'',accent:'#0E8A6E'},
        {label:'Tensión nominal',value:p.voltage_kv?this._nf(Number(p.voltage_kv)):'—',unit:p.voltage_kv?'kV':'',accent:'#E0A12E'},
        {label:'Componente',value:String(p.component_id||'—').replace('cmp:',''),unit:'',accent:'#1E9CB8'}
      ]};
      this.setState({selected:next},()=>this._recompute());
      this._renderGraphFocus(result);
    }).catch(error=>{
      if(this._graphNodeRequestId!==requestId||!this.state.selected||this.state.selected.name!==selected.name) return;
      const rows=baseRows.map(row=>row[0]==='Conexiones'?['Conexiones','No disponibles · '+(error.message||error)]:row);
      this.setState({selected:{...selected,rows}});
    });
  }
  _selectGraphEdge(p,line){
    if(this._handler) return;
    this._selAt=performance.now();
    this._clearHighlight();
    this._clearGraphFocus();
    const from=this._graphNodeById&&this._graphNodeById.get(String(p.from_id||''));
    const to=this._graphNodeById&&this._graphNodeById.get(String(p.to_id||''));
    const fromName=from&&from.props?from.props.name:(p.from_name||p.from_id||'—');
    const toName=to&&to.props?to.props.name:(p.to_name||p.to_id||'—');
    const state=String(p.connection_state||'sin_resolver');
    const networkLabel=this._networkLevelLabel(p.network_level);
    const networkColor=this._colorForKv(Number(p.voltage_kv)||0);
    const selected={
      kicker:'Grafo eléctrico · '+networkLabel.toLowerCase(),
      color:networkColor,
      name:String(p.name||'Línea eléctrica'),
      rows:[
        ['Tipo de infraestructura','Arista de la red eléctrica'],
        ['Nivel de red',networkLabel],
        ['Subestación origen',String(fromName)],
        ['Subestación destino',String(toName)],
        ['Estado topológico',state.replace('_',' ')],
        ['Confianza origen',String(p.from_confidence??0)+'/100 · '+String(p.from_resolution||'—')],
        ['Confianza destino',String(p.to_confidence??0)+'/100 · '+String(p.to_resolution||'—')],
        ['Tensión',p.voltage_kv?Number(p.voltage_kv).toLocaleString('es-MX')+' kV':'—'],
        ['Circuitos',p.circuits??'—'],
        ['Longitud geométrica',p.length_km?Number(p.length_km).toLocaleString('es-MX',{maximumFractionDigits:2})+' km':'—'],
        ['Estado de validación',p.validation_state||'—'],
        ['Fuente',p.source||'DGMESNIE · grafo eléctrico']
      ],
      metrics:[
        {label:'Longitud',value:p.length_km?Number(p.length_km).toFixed(1):'—',unit:p.length_km?'km':'',accent:'#E0A12E'},
        {label:'Tensión',value:p.voltage_kv?this._nf(Number(p.voltage_kv)):'—',unit:p.voltage_kv?'kV':'',accent:'#9B2247'},
        {label:'Confianza mínima',value:String(Math.min(Number(p.from_confidence)||0,Number(p.to_confidence)||0)),unit:'/100',accent:state==='conectada'?'#0E8A6E':'#A57F2C'}
      ]
    };
    this.setState({selected},()=>this._recompute());
    const edgeRecord=this._graphEdgeById&&this._graphEdgeById.get(String(p.edge_id||''));
    const fallbackEndpoint=(prefix,name)=> {
      const lat=Number(p[prefix+'_latitude']),lng=Number(p[prefix+'_longitude']);
      return isFinite(lat)&&isFinite(lng)
        ?{nodeId:String(p[prefix+'_id']||''),name:String(name||'Extremo de línea'),latitude:lat,longitude:lng,isVirtual:false}
        :null;
    };
    this._renderGraphFocus({
      nodes:[
        from&&from.props?this._graphNodeModel(from):fallbackEndpoint('from',fromName),
        to&&to.props?this._graphNodeModel(to):fallbackEndpoint('to',toName)
      ].filter(Boolean),
      edges:[{...p,geometry:edgeRecord&&edgeRecord.geometry}]
    });
    try{if(line&&line.getBounds)this.map.fitBounds(line.getBounds().pad(.35),{maxZoom:11,animate:true});}catch(error){}
  }
  _graphNodeModel(record){
    if(!record||!record.props) return null;
