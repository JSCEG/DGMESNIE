    { key:'red_se_transmision', cat:'Red eléctrica',      panelCat:'Operación y mercado', panelSection:'Eléctrico', panelGroupOrder:10, panelSectionOrder:10, panelOrder:40, label:'Subestaciones de transmisión', code:'ST', color:'#AEB8C6', type:'graph', graphPart:'nodes', graphNodeKind:'transmission', lazy:true, analysis:true, showInLayerPanel:true, compactPoints:true, src:'/DashboardProyectos/RedElectrica/InventarioSubestaciones/GeoJson?networkLevel=transmision', on:false },
