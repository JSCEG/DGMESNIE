  _pdfReportTable(doc,tb,cfg){
    const head=(tb&&tb.head)||[], rows=(tb&&tb.rows)||[]; if(!head.length) return cfg.y;
    const n=head.length, x=cfg.x, width=cfg.width, first=n>=5?.30:(n===2?.56:.42);
    const widths=[width*first]; for(let i=1;i<n;i++) widths.push(width*(1-first)/(n-1));
    const xs=[x]; for(let i=1;i<n;i++) xs.push(xs[i-1]+widths[i-1]);
    const pad=5, fs=cfg.landscape?8.2:7.7, lh=cfg.landscape?10:9.5, accent=cfg.gold?[224,161,46]:[155,34,71];
    const numeric=v=>/^[\d\s.,%+\-]+(?:\s?(?:MW|MVA|kV|km|m2|ha|USD|MXN))?$/i.test(String(v==null?'':v).trim());
    let y=cfg.y;
    const drawHead=()=>{
      const cells=head.map((h,i)=>doc.splitTextToSize(String(h),Math.max(14,widths[i]-pad*2)));
      const hh=Math.max(cfg.landscape?22:21,...cells.map(c=>c.length*lh+9));
      doc.setFillColor(accent[0],accent[1],accent[2]); doc.rect(x,y,width,hh,'F');
      doc.setTextColor(255,255,255); doc.setFont('helvetica','bold'); doc.setFontSize(fs); doc.setCharSpace(.25);
      cells.forEach((c,i)=>doc.text(c,xs[i]+pad,y+12)); doc.setCharSpace(0); y+=hh;
    };
    drawHead();
    rows.forEach((row,ri)=>{
      const cells=head.map((_,i)=>doc.splitTextToSize(String((row||[])[i]==null?'':row[i]),Math.max(14,widths[i]-pad*2)));
      const rh=Math.max(cfg.landscape?19:18,...cells.map(c=>c.length*lh+8));
      if(y+rh>cfg.maxY){ y=cfg.newPage(); drawHead(); }
      if(ri%2===1){ doc.setFillColor(250,248,245); doc.rect(x,y,width,rh,'F'); }
      doc.setDrawColor(240,236,230); doc.setLineWidth(.55); doc.line(x,y+rh,x+width,y+rh);
      cells.forEach((c,i)=>{
        const isNum=i>0&&numeric((row||[])[i]); doc.setTextColor(28,27,26); doc.setFont(isNum?'courier':'helvetica',isNum?'bold':'normal'); doc.setFontSize(fs);
        if(isNum&&c.length===1) doc.text(c[0],xs[i]+widths[i]-pad,y+12,{align:'right'}); else doc.text(c,xs[i]+pad,y+12);
      });
      y+=rh;
    });
    return y+8;
  }
  _writeReportPDF(R, opts){
