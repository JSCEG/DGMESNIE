  _filterByAnalysis(geo,A,context){
    if(!A||!A.analysisGeometry) return this._filterByRadius(geo,A.lat,A.lng,A.radiusKm);
    const features=this._normFeatures(geo).filter(feature=>this._analysisFeatureIntersects(A,{
      type:'Feature',properties:feature.properties||{},geometry:feature.geometry
