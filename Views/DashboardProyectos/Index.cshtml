      item.division,
      item.year,
      fmt(item.users,0),
      item.energyGwh==null?'—':fmt(item.energyGwh,1)+' GWh',
      item.intensity==null?'—':fmt(item.intensity,0)+' kWh/usuario'
    ]);
    const section={
      key:'usuarios-consumo',
      kicker:'Operación y mercado eléctrico',
      color:'#2E6FB0',
      icon:'M4 19v-7m6 7V5m6 14V9m4 10H2',
      title:'Usuarios y consumo por división tarifaria CFE',
      intro:'La cobertura territorial se cruza con las divisiones tarifarias de CFE. Para cada división identificada se presentan usuarios estimados, ventas de energía e intensidad de consumo con el último año completo comparable.',
      hasRows:true,
      rows:[
