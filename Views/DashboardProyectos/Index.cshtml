  _energyPermitRows(cfg,p,nom,location,detail){
    const value=(camel,pascal)=>this._permitValue(p,camel,pascal);
    const formatDate=date=>{
      if(!date) return '—';
      const parsed=new Date(date);
      return Number.isNaN(parsed.getTime())?String(date):parsed.toLocaleDateString('es-MX');
    };
    const feature=Array.isArray(location)&&isFinite(location[0])&&isFinite(location[1])
      ?{type:'Feature',properties:{},geometry:{type:'Point',coordinates:[Number(location[1]),Number(location[0])]}}
      :null;
    const distance=feature?this._distanceFromAnalysisCentroidKm(this.state.analysis,feature):null;
    const rows=[
      ['Tipo de infraestructura','Permiso energético autorizado'],
      ['Mercado',value('mercado','Mercado')||cfg.label],
      ['Número de permiso',value('numeroPermiso','NumeroPermiso')||'—'],
      ['Titular / instalación',value('nombre','Nombre')||nom||'—'],
      ['Tipo de permiso',value('tipoPermiso','TipoPermiso')||'—'],
      ['Clasificación',value('clasificacion','Clasificacion')||'—'],
      ['Tecnología',value('tecnologia','Tecnologia')||'—'],
      ['Capacidad',this._energyPermitCapacity(p)],
      ['Entidad',value('entidad','Entidad')||'—'],
      ['Municipio',value('municipio','Municipio')||'—'],
      ['Estatus',value('estatus','Estatus')||'—'],
      ['Fecha de otorgamiento',formatDate(value('fechaOtorgamiento','FechaOtorgamiento'))],
      ['Inicio de operaciones',formatDate(value('fechaOperacion','FechaOperacion'))],
    ];
    if(Number.isFinite(distance)){
      rows.push(['Distancia al centroide',distance.toLocaleString('es-MX',{minimumFractionDigits:1,maximumFractionDigits:1})+' km']);
    }
    if(feature){
      rows.push(['Coordenadas',Number(location[0]).toFixed(5)+', '+Number(location[1]).toFixed(5)]);
    }
    const permit=value('numeroPermiso','NumeroPermiso');
    if(permit&&cfg&&cfg.api){
      rows.push(['Ficha institucional',window.location.origin+'/DashboardProyectos/PermisosEnergeticos/Ficha?'+new URLSearchParams({
        tipo:String(cfg.api),
        numeroPermiso:String(permit)
      }).toString()]);
    }
    const used=new Set(rows.map(row=>this._norm(row[0])));
    ((detail&&detail.campos)||[]).forEach(field=>{
      const label=String(field&&field.etiqueta||field&&field.clave||'Dato').trim();
      const raw=field&&field.valor;
      if(!label||raw==null||String(raw).trim()===''||used.has(this._norm(label))) return;
      let display=String(raw);
      if(/fecha|vigencia|suspensi[oó]n/i.test(label)&&/^\d{4}-\d{2}-\d{2}$/.test(display)){
        const date=new Date(display+'T00:00:00');
        if(!Number.isNaN(date.getTime())) display=date.toLocaleDateString('es-MX');
      }
      rows.push([label,display]);
      used.add(this._norm(label));
    });
    rows.push(['Fuente',(detail&&detail.fuente)||value('fuente','Fuente')||'CRE · DGMESNIE']);
    return rows;
  }
  _loadEnergyPermitDetail(cfg,p){
    const type=cfg&&cfg.api;
    const permit=this._permitValue(p,'numeroPermiso','NumeroPermiso');
    if(!type||!permit) return Promise.resolve(null);
    this._permitDetailCache=this._permitDetailCache||new Map();
    const key=type+'|'+String(permit).trim();
    if(this._permitDetailCache.has(key)) return this._permitDetailCache.get(key);
    const params=new URLSearchParams({tipo:type,numeroPermiso:String(permit).trim()});
    const request=fetch('/DashboardProyectos/PermisosEnergeticos/Detalle?'+params.toString(),{
      method:'GET',credentials:'same-origin',headers:{Accept:'application/json'}
    }).then(async response=>{
      if(response.status===404) return null;
      const payload=await response.json().catch(()=>null);
      if(!response.ok) throw new Error(payload&&payload.detail?payload.detail:'HTTP '+response.status);
      return payload;
    }).catch(error=>{
      this._permitDetailCache.delete(key);
      throw error;
    });
    this._permitDetailCache.set(key,request);
    return request;
  }
  _selectGeneric(cfg, p, nom, location){
    this._selAt = performance.now();
    this._clearHighlight();
    this._clearPamRegionalFocus();
    const ent = this.CVE_ENT[p.CVE_ENT||p.cve_ent] || this._propEnt(p) || p['Ubicación'] || p.Ubicacion || '';
    this._syncMenu(ent, ent?this._gerenciaOf(ent):'');
    if(cfg.type==='pam'){
      const item=this._pamItemFromProperties(p);
      const regional=!!(p.esUbicacionRegional||p.EsUbicacionRegional);
      if(regional){
        const option=this._pamShortcutOption(item);
        this._selectPamItem(item,null);
        if(option) this._showPamRegionalFocus(option);
        this._fetchPamDetail(item).then(detail=>{
          if(detail) this._selectPamItem(detail,null);
        }).catch(()=>{});
        return;
      }
      const locationId=Number(p.ubicacionId||p.UbicacionId||0);
      const storedLocation=((item&&item.ubicaciones)||[]).find(value=>Number(value.ubicacionId)===locationId)||null;
      const resolvedLocation=storedLocation||{
        ubicacionId:locationId,
        etiqueta:p.etiquetaUbicacion||p.EtiquetaUbicacion||nom||'Elemento de red',
        latitud:p.latitud??p.Latitud??(location&&location[0]),
        longitud:p.longitud??p.Longitud??(location&&location[1]),
        precisionUbicacion:p.precisionUbicacion||p.PrecisionUbicacion||'asociada',
        metodoUbicacion:p.metodoUbicacion||p.MetodoUbicacion||'cruce_catalogo_red_v1',
        fuente:p.fuente||p.Fuente||'Catálogo de red DGMESNIE',
        fechaCorte:p.fechaCorte||p.FechaCorte||null,
        validada:!!(p.validada||p.Validada),
        esAsociacionSugerida:!!(p.esAsociacionSugerida||p.EsAsociacionSugerida),
        puntajeCoincidencia:p.puntajeCoincidencia??p.PuntajeCoincidencia??null,
        nivelConfianza:p.nivelConfianza||p.NivelConfianza||'',
        tipoElementoRed:p.tipoElementoRed||p.TipoElementoRed||'',
        claveElementoRed:p.claveElementoRed||p.ClaveElementoRed||'',
        evidencias:p.evidencias||p.Evidencias||[]
      };
      const detailItem=storedLocation?item:{...item,ubicaciones:[...((item&&item.ubicaciones)||[]),resolvedLocation]};
      this._selectPamItem(detailItem,resolvedLocation);
      return;
    }
    // PODECOBI → ficha curada desde el backend (cabecera + vocaciones + contactos + fuentes).
    // El GeoJSON del mapa solo trae geometría + campos índice; el detalle se obtiene
    // consultando /api/podecobi/polos/{numero} que sirve datos estructurados desde la BD.
    if (cfg.type === 'podecobi') {
      const numero = p.Numero || p.numero;
      if (!numero) { this._toast('Polo sin identificador'); return; }
      const codigoEtapa = (p.Etapa||'').toUpperCase();
      const codigoColor = codigoEtapa === 'EJECUCION' ? '#0E8A6E'
                        : codigoEtapa === 'PREINVERSION' ? '#E0A12E'
                        : '#9B2247';
      const rows = [
        ['Tipo de infraestructura','Polo de Desarrollo · PODECOBI'],
        ['Estado', p.Estado || '—'],
        ['Municipio', p.Municipio || '—'],
        ['Etapa', p.Etapa || '—'],
        ['Superficie oficial (DOF)', p.AreaOficialHa!=null ? Number(p.AreaOficialHa).toLocaleString('es-MX',{maximumFractionDigits:2})+' ha' : '—'],
        ['Superficie GeoJSON', p.AreaGeojsonHa!=null ? Number(p.AreaGeojsonHa).toLocaleString('es-MX',{maximumFractionDigits:2})+' ha' : '—'],
        ['Fuente','DOF/SIDOF + DGMESNIE · BD dgmesnie.PODECOBI'],
        ['Detalle', `Abriendo ficha ${numero}…`],
      ];
      this.setState({
