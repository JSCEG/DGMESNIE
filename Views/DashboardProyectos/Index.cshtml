  // Ícono-mosaico por tecnología (chip redondeado con glifo blanco) — set del sistema de diseño SENER
  _techIcon(code){
    const L = window.L; const color = this._tecColor(code); const glyph = this._techGlyph(code);
    const html = '<svg width="24" height="24" viewBox="0 0 26 26" style="filter:drop-shadow(0 1px 2.5px rgba(0,0,0,.4))">'
      + '<rect x="2" y="2" width="22" height="22" rx="6" fill="'+color+'" stroke="#fff" stroke-width="1.6"/>'+glyph+'</svg>';
    return L.divIcon({ className:'', iconSize:[24,24], iconAnchor:[12,12], popupAnchor:[0,-11], html });
  }
  _dsIcon(color, isProj, tech) {
    const L = window.L;
    const glyph = this._techGlyph(tech);
    if (isProj) {
      // proyecto = pin/gota con glifo (ancla inferior)
      const html = '<svg width="30" height="38" viewBox="0 0 30 38" style="filter:drop-shadow(0 3px 4px rgba(0,0,0,.35))">'
        + '<path d="M15 37C15 37 27 22 27 13A12 12 0 0 0 3 13C3 22 15 37 15 37Z" fill="'+color+'" stroke="#fff" stroke-width="2"/>'
        + '<g transform="translate(2,0)">'+glyph+'</g></svg>';
      return L.divIcon({ className:'', iconSize:[30,38], iconAnchor:[15,37], popupAnchor:[0,-32], html });
    }
    // permiso = chip cuadrado con glifo
    const html = '<svg width="28" height="28" viewBox="0 0 26 26" style="filter:drop-shadow(0 2px 3px rgba(0,0,0,.32))">'
      + '<rect x="2.5" y="2.5" width="21" height="21" rx="5" fill="'+color+'" stroke="#fff" stroke-width="2"/>'+glyph+'</svg>';
    return L.divIcon({ className:'', iconSize:[28,28], iconAnchor:[14,14], popupAnchor:[0,-12], html });
