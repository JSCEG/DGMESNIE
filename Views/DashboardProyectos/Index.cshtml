    @@keyframes dgFade{from{opacity:0;transform:translateY(8px)}to{opacity:1;transform:none}}
    @@keyframes dgSpin{to{transform:rotate(360deg)}}
    @@keyframes dgBar{0%{left:-45%;width:45%}50%{width:60%}100%{left:100%;width:45%}}
    .dg-pulse{position:absolute;left:0;top:0}
    .dg-pulse i{position:absolute;left:0;top:0;transform:translate(-50%,-50%);border-radius:50%;border:3px solid var(--c);box-sizing:border-box}
    .dg-pulse i:nth-child(1){width:16px;height:16px;background:var(--c);opacity:.85}
    .dg-pulse i:nth-child(2){width:16px;height:16px;animation:dgPulse 1.5s ease-out infinite}
    .dg-pulse i:nth-child(3){width:16px;height:16px;animation:dgPulse 1.5s ease-out .75s infinite}
    @@keyframes dgPulse{0%{width:14px;height:14px;opacity:.9}100%{width:60px;height:60px;opacity:0}}
    input:focus,select:focus{outline:2px solid rgba(155,34,71,.35);outline-offset:0}
    /* Los controles de la barra del mapa no se comprimen: la barra hace scroll horizontal */
    .dg-toolbar > *{flex:none}
    /* Los controles de Leaflet (zoom, escala) bajan para no quedar debajo de la barra de controles */
    /* .leaflet-top override removed to show zoom controls +/- */
    .dg-measure-tip{background:#fff;border:1px solid #9B2247;border-radius:6px;color:#9B2247;font-weight:700;font-family:'IBM Plex Mono',monospace;font-size:11px;padding:2px 7px}
    /* ── Colapso intermedio (tablet / ventana angosta) antes del modo celular ── */
    @@media (max-width: 1180px){
