      yaxisUnit:'GW',
      yaxis:[plot.max,(plot.max+plot.min)/2,plot.min].map((value,index)=>({
        y:[18,66,114][index],
        top:([18,66,114][index]/150*100).toFixed(2),
        label:nf(value/1000,1),
        stroke:index===2?'#D8D3CC':'#ECE8E2'
      })),
      temperatureAxisVisible:hasTemperature,
      temperatureYaxis:hasTemperature
        ?[plot.tempMax,(plot.tempMax+plot.tempMin)/2,plot.tempMin].map((value,index)=>({
            top:([18,66,114][index]/150*100).toFixed(2),
