        <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="#9B2247" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="9"/><circle cx="12" cy="12" r="4.5"/><circle cx="12" cy="12" r="1" fill="#9B2247"/></svg>
