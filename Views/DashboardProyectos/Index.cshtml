  _pdfReportPageHead(doc, W, landscape, kicker, title, aside){
    const M=landscape?40:46, top=landscape?42:48;
    doc.setFillColor(155,34,71); doc.rect(0,0,W,landscape?7:6,'F');
    doc.setFillColor(224,161,46); doc.rect(W*.62,0,W*.38,landscape?7:6,'F');
    doc.setTextColor(155,34,71); doc.setFont('helvetica','bold'); doc.setFontSize(landscape?9:8);
    doc.setCharSpace(.75); doc.text(String(kicker||'REPORTE TERRITORIAL').toUpperCase(),M,top); doc.setCharSpace(0);
    if(aside){ doc.setTextColor(154,149,142); doc.setFont('helvetica','normal'); doc.text(String(aside).toUpperCase(),W-M,top,{align:'right'}); }
    doc.setDrawColor(236,232,226); doc.setLineWidth(.8); doc.line(M,top+10,W-M,top+10);
    doc.setTextColor(28,27,26); doc.setFont('times','bold'); doc.setFontSize(landscape?25:20);
    const lines=doc.splitTextToSize(String(title||''),W-M*2); doc.text(lines,M,top+(landscape?39:35));
    const y=top+(landscape?39:35)+lines.length*(landscape?25:20);
    doc.setDrawColor(224,161,46); doc.setLineWidth(1.4); doc.line(M,y-8,M+(landscape?180:145),y-8);
    return y+5;
  }
  _pdfReportIndex(doc, W, H, landscape, entries, indexPage){
    const M=landscape?52:46;
    doc.setPage(indexPage||2); doc.setFillColor(255,255,255); doc.rect(0,0,W,H,'F');
    let top=this._pdfReportPageHead(doc,W,landscape,'Contenido','Índice','Índice navegable')+(landscape?10:12);
    const cols=landscape?2:1, gap=landscape?56:0, cw=(W-M*2-gap*(cols-1))/cols;
    const chunks=[]; if(cols===1) chunks.push(entries); else { const cut=Math.ceil(entries.length/2); chunks.push(entries.slice(0,cut),entries.slice(cut)); }
    const links=[];
    chunks.forEach((chunk,ci)=>{
      const x=M+ci*(cw+gap); let y=top, lastGroup='';
      chunk.forEach(e=>{
        if(e.group!==lastGroup){
          if(lastGroup) y+=landscape?8:10;
          doc.setTextColor(155,34,71); doc.setFont('helvetica','bold'); doc.setFontSize(landscape?9:8);
          doc.setCharSpace(.8); doc.text(String(e.group).toUpperCase(),x,y); doc.setCharSpace(0); y+=landscape?22:23; lastGroup=e.group;
        }
        doc.setTextColor(155,34,71); doc.setFont('courier','bold'); doc.setFontSize(landscape?11:10); doc.text(e.folio,x,y);
        doc.setTextColor(28,27,26); doc.setFont('helvetica','normal'); doc.setFontSize(landscape?11:10.5);
        const tx=x+(landscape?38:34), pageX=x+cw;
        const title=this._clipText(doc,e.title,cw-(landscape?80:76)); doc.text(title,tx,y);
        const start=tx+doc.getTextWidth(title)+8, end=pageX-26;
        if(end>start){ doc.setDrawColor(190,184,176); doc.setLineWidth(.6); if(doc.setLineDashPattern) doc.setLineDashPattern([1.2,2.2],0); doc.line(start,y-2,end,y-2); if(doc.setLineDashPattern) doc.setLineDashPattern([],0); }
        doc.setTextColor(111,107,102); doc.setFont('courier','bold'); doc.text(String(e.page),pageX,y,{align:'right'});
        links.push({x,y:y-(landscape?13:12),w:cw,h:landscape?18:17,page:e.page});
        y+=landscape?28:27;
      });
    });
    links.forEach(l=>doc.link(l.x,l.y,l.w,l.h,{pageNumber:l.page}));
