      this.setState({ layers, blocking:null, anaOpen:false, menuOpen:null, selected:anaSelected, collapsed:{ ...this.state.collapsed, detalle:false }, analysis: { ...this.state.analysis, running:false, stale:false, ranKeys:okKeys } }, () => this._recompute());
      try { this.map.fitBounds(this._anaCircle.getBounds().pad(0.25), { animate:true }); } catch(e){}
      const total = okKeys.reduce((s,k) => s+(layers[k].count||0), 0) + dsParts.reduce((s,p)=>s+p.inR,0);
      this._toast('Análisis listo · '+total.toLocaleString('es-MX')+' elementos en '+A.radiusKm+' km'+(failedKeys.length?' · '+failedKeys.length+' capa(s) sin fuente disponible':''));
