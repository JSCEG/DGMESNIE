  toggleDataset = (id) => {
    this._invalidateSearch();
    const datasets = this.state.datasets.map(d => d.id===id ? { ...d, active:!d.active } : d);
    const ds = datasets.find(d => d.id===id);
    if (['permisos','proyectos'].includes(ds.target)) {
      this.setState({ datasets }, () => this._renderDataset(ds));
    } else this.setState({ datasets }, () => this._recompute());
  };
  removeDataset = (id) => {
    this._invalidateSearch();
    const ds = this.state.datasets.find(d => d.id===id);
    const remaining = this.state.datasets.filter(d => d.id!==id);
    if (ds && ['permisos','proyectos'].includes(ds.target)) {
      this.setState({ datasets:remaining }, () => this._renderDataset({ target:ds.target }));
      return;
    }
    this.setState({ datasets: remaining }, () => this._recompute());
  };

  // ════════════════════ herramientas ════════════════════
  // Medición de distancia PROPIA (sin leaflet.draw): clic agrega puntos, doble clic termina.
  onToggleMeasure = () => {
    const measure = !this.state.measure;
    this.setState({ measure, drawing:false });
    this._stopDraw();
    if (measure) this._measureStart(); else this._measureFinish();
  };
  _measureStart(){
    const L = window.L;
    this._mPts = []; this._mLine = null;
    this.map.doubleClickZoom.disable();
    this.map.getContainer().style.cursor = 'crosshair';
    this._mClick = (e) => {
      this._mPts.push(e.latlng);
      if (!this._drawR) { try { this._drawR = L.svg({ pane:'draw', padding:0.5 }); this._drawR.addTo(this.map); } catch(e){} }
      if (!this._mLine) { this._mLine = L.polyline(this._mPts, { renderer:this._drawR, color:'#9B2247', weight:3, dashArray:'6 5', interactive:false }).addTo(this.drawn); this._guardPath(this._mLine); }
      else this._mLine.setLatLngs(this._mPts);
      const km = this._mKm();
      if (this._mPts.length > 1) {
        if (!this._mTip) this._mTip = L.tooltip({ permanent:true, className:'dg-measure-tip', direction:'top' });
        this._mTip.setLatLng(e.latlng).setContent(km.toFixed(2)+' km');
        if (!this.map.hasLayer(this._mTip)) this._mTip.addTo(this.map);
      }
    };
    this._mDbl = (e) => { window.L.DomEvent.stop(e); this._measureFinish(); };
    this.map.on('click', this._mClick);
    this.map.on('dblclick', this._mDbl);
    this._toast('Clic para agregar puntos · doble clic para terminar');
  }
  _mKm(){ let km=0; for(let i=1;i<(this._mPts||[]).length;i++) km += this.map.distance(this._mPts[i-1], this._mPts[i])/1000; return km; }
  _measureFinish(){
    if (this._mClick) { this.map.off('click', this._mClick); this._mClick = null; }
    if (this._mDbl) { this.map.off('dblclick', this._mDbl); this._mDbl = null; }
    this.map.getContainer().style.cursor = '';
    setTimeout(() => { try { this.map.doubleClickZoom.enable(); } catch(e){} }, 250);
    const km = this._mKm();
    if (this._mPts && this._mPts.length > 1) this._toast('Distancia medida: '+km.toFixed(2)+' km');
    else { if (this._mLine) this.drawn.removeLayer(this._mLine); if (this._mTip) { try{ this.map.removeLayer(this._mTip); }catch(e){} this._mTip=null; } }
    this._mPts = []; this._mLine = null;
    if (this.state.measure) this.setState({ measure:false });
  }
  onToggleDraw = () => {
    const drawing = !this.state.drawing;
    this.setState({ drawing, measure:false });
    this._stopDraw();
    if (drawing) { this.map.doubleClickZoom.disable(); this._handler = new window.L.Draw.Polygon(this.map, { shapeOptions:{ color:'#0E8A6E', weight:2.5, fillColor:'#0E8A6E', fillOpacity:.12, pane:'draw', interactive:false } }); this._handler.enable(); this._toast('Dibuja un polígono de análisis'); }
  };
  _stopDraw(){ if (this._handler) { try{ this._handler.disable(); }catch(e){} this._handler=null; } try{ setTimeout(()=>this.map.doubleClickZoom.enable(), 250); }catch(e){} }
  onClearTools = () => {
    if (this.state.measure) this._measureFinish();
    if (this._mTip) { try{ this.map.removeLayer(this._mTip); }catch(e){} this._mTip=null; }
    this.drawn.clearLayers(); this._stopDraw();
    this.setState({ measure:false, drawing:false, scope:'Visible', selected:this.state.selected }, () => this._recompute());
    this._toast('Herramientas limpiadas');
  };
  _onDrawCreated(e) {
    const L = window.L; const layer = e.layer;
    if (e.layerType==='polyline') {
      const ll = layer.getLatLngs(); let km=0;
      for (let i=1;i<ll.length;i++) km += this.map.distance(ll[i-1], ll[i])/1000;
      this.drawn.addLayer(layer); layer.bindPopup('Distancia: <b>'+km.toFixed(2)+' km</b>').openPopup();
      this.setState({ measure:false }); this._stopDraw();
      this._toast('Distancia medida: '+km.toFixed(2)+' km');
    } else { // polígono de análisis
      this.drawn.clearLayers(); this.drawn.addLayer(layer);
      this.setState({ drawing:false, scope:'Área dibujada' }); this._stopDraw();
      this._recomputeInPolygon(layer);
    }
  }

  // ════════════════════ métricas ════════════════════
  _nf(n){ return (n==null||isNaN(n))?'—':Math.round(n).toLocaleString('es-MX'); }
  _recompute() {
    if (!this.map || !this.subFeatures) return;
    const b = this.map.getBounds();
    const visSubs = this._visibleSubs(b);
    const km = this._visibleLinesKm(b);
    const dsPerm = this.state.datasets.filter(d => d.active && d.target==='permisos');
    const dsProj = this.state.datasets.filter(d => d.active && d.target==='proyectos');
    const permisos = dsPerm.reduce((a,d)=>a+this._datasetRowsForMap(d).length,0);
    const proyectos = dsProj.reduce((a,d)=>a+this._datasetRowsForMap(d).length,0);
    let capacidad = dsProj.reduce((a,d)=>a+this._datasetRowsForMap(d).reduce((x,r)=>x+(+r.capacidad_mw||0),0),0)
                  + dsPerm.reduce((a,d)=>a+this._datasetRowsForMap(d).reduce((x,r)=>x+(+r.capacidad_mw||0),0),0);
    let distancia = null;
    const sel = this.state.selected;
    if (sel && sel.lat!=null) distancia = this._nearestSub(sel);
    this.setState({ metrics:{ capacidad, subs:visSubs, km, permisos, proyectos, distancia }, scope:'Visible' });
  }
  _recomputeInPolygon(layer) {
    const poly = layer.getLatLngs()[0].map(p => [p.lng, p.lat]);
    const inside = (lng,lat) => this._pip(lng, lat, poly);
    const subs = this.subFeatures.filter(s => inside(s.lng, s.lat));
    let km=0; this.lineFeatures.forEach(pl => { const mid=pl.getBounds().getCenter(); if (inside(mid.lng, mid.lat)) km += pl._rec.km||0; });
    let capacidad=0, permisos=0, proyectos=0;
    this.state.datasets.filter(d=>d.active).forEach(d => this._datasetRowsForMap(d).forEach(r => {
      const ll = this._placeRow(r, d); if (!ll) return;
      if (inside(ll[1], ll[0])) { if (d.target==='proyectos') proyectos++; else if (d.target==='permisos') permisos++; capacidad += (+r.capacidad_mw||0); }
    }));
    let distancia = null; const sel=this.state.selected; if (sel && sel.lat!=null) distancia=this._nearestSub(sel);
    this.setState({ metrics:{ capacidad, subs:subs.length, km, permisos, proyectos, distancia }, scope:'Área dibujada' });
    this._toast('Análisis del área: '+subs.length+' subestaciones · '+km.toFixed(0)+' km · '+capacidad.toLocaleString()+' MW');
  }
  // Con análisis geoespacial activo, las métricas cuentan SOLO lo que está dentro del buffer
  _visibleSubs(b){ if(!this.state.layers.subestaciones.on) return 0; return this.subFeatures.filter(s => b.contains([s.lat,s.lng]) && (!this._anaSubSet || this._anaSubSet.has(s))).length; }
  _visibleLinesKm(b){ if(!this.state.layers.lineas.on) return 0; let km=0; this.lineFeatures.forEach(pl=>{ if(this._anaLineSet && !this._anaLineSet.has(pl)) return; if(b.intersects(pl.getBounds())) km+=pl._rec.km||0; }); return km; }
  _nearestSub(sel){ let best=Infinity; this.subFeatures.forEach(s=>{ if(s.idx===sel.idx) return; const d=this._haversine(sel.lat,sel.lng,s.lat,s.lng); if(d<best) best=d; }); return best===Infinity?null:best; }
  _lineKm(ll){ let km=0; for(let i=1;i<ll.length;i++) km+=this._haversine(ll[i-1][0],ll[i-1][1],ll[i][0],ll[i][1]); return km; }
  _haversine(la1,lo1,la2,lo2){ const R=6371,r=Math.PI/180; const dLa=(la2-la1)*r,dLo=(lo2-lo1)*r; const a=Math.sin(dLa/2)**2+Math.cos(la1*r)*Math.cos(la2*r)*Math.sin(dLo/2)**2; return 2*R*Math.asin(Math.sqrt(a)); }
  _pip(x,y,poly){ let inside=false; for(let i=0,j=poly.length-1;i<poly.length;j=i++){ const xi=poly[i][0],yi=poly[i][1],xj=poly[j][0],yj=poly[j][1]; const hit=((yi>y)!==(yj>y))&&(x<(xj-xi)*(y-yi)/(yj-yi)+xi); if(hit) inside=!inside; } return inside; }
  _inFeature(x,y,g){ if(!g) return false; if(g.type==='Polygon') return this._inRings(x,y,g.coordinates); if(g.type==='MultiPolygon') return g.coordinates.some(p=>this._inRings(x,y,p)); return false; }
  _inRings(x,y,rings){ if(!this._pip(x,y,rings[0])) return false; for(let i=1;i<rings.length;i++) if(this._pip(x,y,rings[i])) return false; return true; }

  // ════════════════════ filtros / búsqueda ════════════════════
  onSearchInput = (e) => this.setState({ search:e.target.value });
  onSearchKey = (e) => {
    if (e.key==='Enter') { const q=this._norm(this.state.search); if(!q) return; const m=this._searchIndex().filter(x=>x.n.includes(q))[0]; if(m){ m.go(); this.setState({ search:'' }); this._anaFromSearch(m); } else this._searchAddress(this.state.search.trim()); }
    else if (e.key==='Escape') this.setState({ search:'' });
  };
  // Índice de búsqueda flexible — depende de las CAPAS y DATASETS activos
  _invalidateSearch(){ this._searchCache = null; }
  _searchIndex(){
    if (this._searchCache) return this._searchCache;
    const out=[]; const L=this.state.layers;
    // Subestaciones/líneas acotadas al buffer del análisis geoespacial (si hay uno activo)
    if (L.subestaciones.on && this.subFeatures) this.subFeatures.filter(s => !this._anaSubSet || this._anaSubSet.has(s)).forEach(s => out.push({ label:s.name, kind:'Subestación', color:'#9B2247', n:this._norm(s.name+' '+(s.ent||'')), ll:[s.lat,s.lng], go:()=>{ this.map.setView([s.lat,s.lng],9,{animate:true}); this._selectSub(s,null); this._setHighlight(s.lat,s.lng,'#9B2247'); } }));
    if (L.gerencias.on) Object.entries(this.GCR_NOMBRE).forEach(([k,nom]) => out.push({ label:'GCR '+nom, kind:'Gerencia de control', color:this.GCR_COLORS[k], n:this._norm('gcr '+nom), ll:(this._gcrCentroid&&this._gcrCentroid[k])||null, go:()=>{ const c=this._gcrCentroid&&this._gcrCentroid[k]; if(c) this.map.setView(c,6,{animate:true}); this._selectGerencia(k,nom); if(c) this._setHighlight(c[0],c[1],this.GCR_COLORS[k]); } }));
    if (L.estados.on && this.geo && this.geo.estados) this.geo.estados.features.forEach(f => { const nom=this._propEnt(f.properties); if(!nom) return; const c=this.estCentroid[this._norm(nom)]; out.push({ label:nom, kind:'Estado', color:'#0E8A6E', n:this._norm(nom), ll:c?[c.lat,c.lng]:null, go:()=>{ if(c) this.map.setView([c.lat,c.lng],7,{animate:true}); this._selectEstado(nom,f); if(c) this._setHighlight(c.lat,c.lng,'#0E8A6E'); } }); });
    if (L.municipios.on && this.muniFeatures) this.muniFeatures.forEach(mu => out.push({ label:mu.name, kind:'Municipio'+(mu.ent?' · '+mu.ent:''), color:'#C9A24B', n:this._norm(mu.name+' '+(mu.ent||'')), ll:[mu.lat,mu.lng], go:()=>{ this.map.setView([mu.lat,mu.lng],9,{animate:true}); this.setState({ selected:{ kicker:'Municipio', color:'#C9A24B', name:mu.name, rows:[['Tipo de infraestructura','División municipal'],['Entidad federativa', mu.ent||'—'],['Fuente','Marco geoestadístico · INEGI'],['Actualización','2026-01-01']] } }); this._setHighlight(mu.lat,mu.lng,'#C9A24B'); } }));
    if (L.lineas.on && this.lineFeatures) this.lineFeatures.filter(pl => !this._anaLineSet || this._anaLineSet.has(pl)).forEach(pl => { const r = pl._rec; if (!r || !r.name) return; out.push({ label:r.name, kind:'Línea de transmisión · '+r.kv+' kV', color:'#E0A12E', n:this._norm(r.name+' '+r.kv), ll:(()=>{ try { const c=pl.getBounds().getCenter(); return [c.lat,c.lng]; } catch(e){ return null; } })(), go:()=>{ let c=null; try { const b=pl.getBounds(); c=b.getCenter(); this.map.fitBounds(b.pad(0.3),{animate:true}); } catch(e){} this._selectLine(r, pl); if (c) this._setHighlight(c.lat, c.lng, '#E0A12E'); } }); });
    // Capas genéricas del inventario (ANP, presas, lenguas, sitios, etc.) — sólo si están
    // encendidas y ya construidas. Se deduplica por nombre dentro de cada capa (p.ej. una
    // lengua aparece en miles de localidades): una sugerencia por nombre, a su primera ubicación.
    this.LAYERS.forEach(cfg => {
      if (cfg.type!=='geo' || !L[cfg.key] || !L[cfg.key].on) return;
      const fs = (this._genericFeats || {})[cfg.key]; if (!fs) return;
      const seen = new Set();
      fs.forEach(ft => { const n = this._norm(ft.nom); if (!n || seen.has(n)) return; seen.add(n); out.push({ label:ft.nom, kind:cfg.label, color:cfg.color, n, ll:[ft.lat,ft.lng], go:()=>{ this.map.setView([ft.lat, ft.lng], 9, {animate:true}); this._selectGeneric(cfg, ft.props, ft.nom); this._setHighlight(ft.lat, ft.lng, cfg.color); } }); });
    });
    // Los datasets de permisos/proyectos sólo aparecen en el buscador si además su capa
    // en "Capas disponibles" está encendida — evita sugerir elementos que no se ven en el mapa.
    this.state.datasets.filter(d => d.active && (!['permisos','proyectos'].includes(d.target) || L[d.target].on)).forEach(d => this._datasetRowsForMap(d).forEach(r => { const label=this._dsRowName(r); const _tec=this._dsRowTech(r); out.push({ label, kind:(d.target==='proyectos'?'Proyecto':'Permiso')+' · '+this._tecLabel(_tec), color:this._tecColor(_tec), n:this._norm(label+' '+(r.municipio||'')+' '+(r.clave_permiso||'')), ll:this._placeRow(r,d), go:()=>{ const ll=this._placeRow(r,d); if(ll) this.map.setView(ll,8,{animate:true}); this._selectDatasetFeature(r,d,ll); if(ll) this._setHighlight(ll[0],ll[1],this._tecColor(r.tecnologia)); } }); }));
    this._searchCache=out; return out;
  }
  _suggestions(){ const q=this._norm(this.state.search); if(q.length<2) return []; return this._searchIndex().filter(e=>e.n.includes(q)).slice(0,8); }
  // Capa auto-encendida por un combo (para regresarla a su estado al limpiar el filtro)
  _ensureAuto(key){ if(!this.state.layers[key].on){ this._autoLayer=this._autoLayer||{}; this._autoLayer[key]=true; this.toggleLayer(key); } }
  _revertAuto(key){ if(this._autoLayer && this._autoLayer[key]){ this._autoLayer[key]=false; if(this.state.layers[key].on) this.toggleLayer(key); } }

  onFiltroEnt = (e) => {
    const filtroEnt = e.target.value;
    this.setState({ filtroEnt }, () => {
      this._applyFilters();
      if (filtroEnt) {
        this._ensureAuto('estados'); // muestra la capa de estados aunque no estuviera activa
        const f = this.estByName[this._norm(filtroEnt)]; if (f) this._selectEstado(filtroEnt, f);
        const c = this.estCentroid[this._norm(filtroEnt)];
        if (c) { this.map.setView([c.lat,c.lng],7,{animate:true}); this._setHighlight(c.lat,c.lng,'#0E8A6E'); }
      } else { this._revertAuto('estados'); this._clearHighlight(); this.map.setView([23.6,-102],5,{animate:true}); }
    });
  };
  onFiltroGer = (e) => {
    const filtroGer = e.target.value;
    this.setState({ filtroGer }, () => {
      this._applyFilters();
      if (filtroGer) {
        this._ensureAuto('gerencias'); // muestra la capa de gerencias aunque no estuviera activa
        const nom = this.GCR_NOMBRE[filtroGer]; this._selectGerencia(filtroGer, nom);
        const c = this._gcrCentroid && this._gcrCentroid[filtroGer];
        if (c) { this.map.setView(c,6,{animate:true}); this._setHighlight(c[0],c[1],this.GCR_COLORS[filtroGer]); }
      } else { this._revertAuto('gerencias'); this._clearHighlight(); this.map.setView([23.6,-102],5,{animate:true}); }
    });
  };
  onFiltroTec = (e) => { this.setState({ filtroTec:e.target.value }, () => this._applyFilters()); };
  _applyFilters() {
    const ent = this.state.filtroEnt; const tec = this.state.filtroTec; const ger = this.state.filtroGer;
    // subestaciones por entidad y/o gerencia
    this.groups.subestaciones.eachLayer(m => {
      const r=m._rec; const show = (!ent || r.ent===ent) && (!ger || this._gerenciaOf(r.ent)===ger);
      m.setStyle({ opacity: show?1:0.08, fillOpacity: show?.95:0.05 });
    });
    // permisos/proyectos por tecnología (re-render con filtro)
    this.state.datasets.filter(d=>d.active && ['permisos','proyectos'].includes(d.target)).forEach(d => {
      this.groups[d.target].eachLayer(()=>{});
    });
    this._recompute();
    if (tec) this._toast('Filtro de tecnología: '+this._tecLabel(tec));
  }

  _reloadDataset(ds){
    const url=(ds.url||'').trim();
    if (!/^https?:\/\//i.test(url)) return Promise.resolve({ dataset:ds, meta:null });
    const isJson = ds.type==='json' || /\.json($|\?)/i.test(url);
    const fetchUrl = /docs\.google\.com/.test(url) ? this._sheetCsvUrl(url) : url;
    return fetch(fetchUrl, { cache:'no-store' }).then(r=>{ if(!r.ok) throw new Error('HTTP '+r.status); return r.text(); }).then(txt=>{
      let fields, rows;
      if (isJson) { let j=JSON.parse(txt); const arr=Array.isArray(j)?j:(j.rows||j.data||j.features||[]); const flat=arr.map(x=>x.properties||x); fields=[...new Set(flat.flatMap(o=>Object.keys(o)))]; rows=flat; }
      else { const p=this._parseCSV(txt); fields=p.fields; rows=p.rows; }
      if(!fields.length) throw new Error('sin columnas');
      return this._transformDataset(rows, fields, ds.transform).then(out=>({
        dataset:{ ...ds, fields:out.fields, rows:out.rows, geo:this._datasetGeo(out.fields, out.rows) },
        meta:out.meta
      }));
    });
  }

  // ════════════════════ basemap / header ════════════════════
  toggleAnalysisPanel = () => {
    const opening=!this.state.anaOpen;
    this.setState({
      anaOpen:opening, menuOpen:null, mobilePanel:null, exportOpen:false,
      collapsed:opening ? { ...this.state.collapsed, detalle:true } : this.state.collapsed
    });
  };
  toggleLayersMenu = () => this.setState({ menuOpen:this.state.menuOpen==='capas'?null:'capas', anaOpen:false, exportOpen:false, mobilePanel:null });
  toggleDatasetsMenu = () => this.setState({ menuOpen:this.state.menuOpen==='datasets'?null:'datasets', anaOpen:false, exportOpen:false, mobilePanel:null });
  setBasemap = (key) => {
    if (this.state.basemap===key) return;
    this.map.removeLayer(this.bases[this.state.basemap]);
    this.bases[key].addTo(this.map);
    // re-stack data sobre el tile
    Object.values(this.groups).forEach(g => g.bringToFront && g.bringToFront());
    this.setState({ basemap:key });
  };
  // Restablece una sesión completa, no sólo el zoom: quita datasets, zona, resultados,
  // filtros, paneles y herramientas para volver al mismo mapa limpio del arranque.
  onReset = () => {
    this._anaSummary=null; this._report=null; this._returnToAnalysis=false;
    if (this._anaMarker) { try { this.map.removeLayer(this._anaMarker); } catch(e){} this._anaMarker=null; }
    if (this._anaCircle) { try { this.map.removeLayer(this._anaCircle); } catch(e){} this._anaCircle=null; }
    if (this._mTip) { try { this.map.removeLayer(this._mTip); } catch(e){} this._mTip=null; }
    this._clearHighlight(); this._stopDraw();
    try { this.drawn.clearLayers(); this.map.closePopup(); } catch(e){}
    try { this._muniPaneShow(false); } catch(e){}
    this._anaSubSet=null; this._anaLineSet=null; this._genericFeats={}; this._genericCount={}; this._autoLayer={};
    Object.entries(this.groups||{}).forEach(([key,g]) => {
      if (key!=='gerencias') { try { if (this.map.hasLayer(g)) this.map.removeLayer(g); } catch(e){} }
      if (['permisos','proyectos','zonas'].includes(key) || (this.LAYERS.find(c=>c.key===key)||{}).analysis) { try { g.clearLayers(); } catch(e){} }
    });
    // Las listas maestras permiten recuperar íntegramente red eléctrica tras un análisis filtrado.
    if (this.groups.subestaciones) (this._subMarkers||[]).forEach(m=>this.groups.subestaciones.addLayer(m));
    if (this.groups.lineas) (this.lineFeatures||[]).forEach(pl=>this.groups.lineas.addLayer(pl));
    this.LAYERS.filter(c=>c.analysis && !['subestaciones','lineas'].includes(c.key)).forEach(c=>{ this._built[c.key]=false; });
    try { if (!this.map.hasLayer(this.groups.gerencias)) this.groups.gerencias.addTo(this.map); } catch(e){}
    if (this.state.basemap!=='color') { try { this.map.removeLayer(this.bases[this.state.basemap]); } catch(e){} try { this.bases.color.addTo(this.map); } catch(e){} }
    const layers=this._initLayers();
    layers.gerencias.count=this.groups.gerencias&&this.groups.gerencias.getLayers?this.groups.gerencias.getLayers().length:0;
    layers.estados.count=this.geo&&this.geo.estados?(this.geo.estados.features||[]).length:0;
    layers.municipios.count=this.muniFeatures?this.muniFeatures.length:0;
    layers.subestaciones.count=(this.subFeatures||[]).length;
    layers.lineas.count=(this.lineFeatures||[]).length;
    this.map.getContainer().style.cursor='';
    this.map.setView([23.6,-102],5,{animate:false});
    this._invalidateSearch();
    this.setState({
      basemap:'color', legendOn:true, layers, datasets:[], selected:null,
      search:'', filtroEnt:'', filtroTec:'', filtroGer:'', scope:'Visible',
      measure:false, drawing:false, connectOpen:false, fields:null, connectUrl:'',
      exportOpen:false, anaOpen:false, mobilePanel:null, menuOpen:null, reportOpen:false,
      blocking:null, layerBar:null, collapsed:{ capas:false, datasets:false, detalle:true, metricas:false },
      analysis:{ placing:false, lat:null, lng:null, estado:'', radiusKm:20, sel:{}, ranKeys:[], stale:false, running:false, latIn:'', lngIn:'' }
    }, () => { this._recompute(); this._toast('Nuevo análisis listo · mapa limpio'); });
  };
  onRefresh = () => {
    const online=this.state.datasets.filter(d=>/^https?:\/\//i.test(d.url||''));
    if (!online.length) { this._toast('No hay datasets en línea vinculados para actualizar'); return; }
    this._toast('Sincronizando datasets y Minutas…');
    this.setState({ loading:true, loadingMsg:'Actualizando datos desde Google Sheets…' });
    Promise.all(online.map(d=>this._reloadDataset(d))).then(updated=>{
      const byId={}; updated.forEach(x=>{ byId[x.dataset.id]=x.dataset; });
      const datasets=this.state.datasets.map(d=>byId[d.id]||d);
      this._invalidateSearch();
      this.setState({ datasets, loading:false }, ()=>{
        [...new Set(updated.filter(x=>x.dataset.active).map(x=>x.dataset.target))].forEach(target=>this._renderDataset({ target }));
        const traced=updated.find(x=>x.meta);
        this._toast(traced
          ? 'Datos actualizados · '+traced.meta.kept+' continúan de '+traced.meta.evaluated+' folios evaluados en Minutas'
          : 'Datos actualizados · '+online.length+' dataset(s)');
      });
    }).catch(e=>{
      this.setState({ loading:false });
      this._toast('No se pudieron actualizar los datasets: '+String(e.message||e));
    });
  };
  // ════════════════════ exportación (PNG · PDF carta · Excel) ════════════════════
  onToggleExport = () => this.setState({ exportOpen: !this.state.exportOpen, anaOpen:false, menuOpen:null, mobilePanel:null });
  closeExport = () => this.setState({ exportOpen:false });
  _download(url, name){ const a=document.createElement('a'); a.href=url; a.download=name; document.body.appendChild(a); a.click(); a.remove(); }
  _stamp(){ return new Date().toLocaleString('es-MX'); }
  _activeLayerRows(){ return this.LAYERS.map(c=>{ const v=this.state.layers[c.key]; return { Capa:v.label, Categoria:c.cat, Activa: v.on?'Sí':'No', Conteo: v.count||0 }; }); }
  _metricRows(){ const m=this.state.metrics; return [
    ['Capacidad total seleccionada', Math.round(m.capacidad||0), 'MW'],
    ['Subestaciones visibles', m.subs||0, ''],
    ['Km de líneas visibles', Math.round(m.km||0), 'km'],
    ['Permisos de generación', m.permisos||0, ''],
    ['Proyectos activos', m.proyectos||0, ''],
    ['Distancia al más cercano', m.distancia==null?'—':+m.distancia.toFixed(1), m.distancia==null?'':'km'],
  ]; }
  // ════════════════════ REPORTE TERRITORIAL (vista completa + PDF) ════════════════════
  _nearestSubs(lat, lng, n){
    if (!this.subFeatures) return [];
    return this.subFeatures
      .map(s => ({ name:s.name, ent:s.ent, kv:s.kv, dist:this._haversine(lat, lng, s.lat, s.lng) }))
      .sort((a,b) => a.dist-b.dist).slice(0, n||5);
  }
  _nearestLines(lat, lng, n){
    if (!this.lineFeatures) return [];
    const out = [];
    this.lineFeatures.forEach(pl => {
      const r = pl._rec; if (!r) return;
      let lls = pl.getLatLngs(); while (Array.isArray(lls[0])) lls = lls.flat();
      if (!lls.length) return;
      const step = Math.max(1, Math.floor(lls.length/60));
      let best = Infinity;
      for (let i=0; i<lls.length; i+=step) { const d = this._haversine(lat, lng, lls[i].lat, lls[i].lng); if (d<best) best=d; }
      out.push({ name:r.name||'Línea', kv:r.kv, km:r.km, dist:best });
    });
    return out.sort((a,b) => a.dist-b.dist).slice(0, n||5);
  }
  _buildReport(){
    const A = this.state.analysis;
    if (!A.lat || !A.ranKeys.length) return null;
    const L = this.state.layers;
    const feats = k => ((this._genericFeats||{})[k]||[]);
    const names = (k, n) => { const seen=new Set(), list=[]; feats(k).forEach(f=>{ const nm=f.nom; if(nm && !seen.has(nm)){ seen.add(nm); if(list.length<(n||8)) list.push(nm); } }); return { total:seen.size, list }; };
    const cnt = k => (L[k] && L[k].count) || 0;
    const ran = k => A.ranKeys.includes(k);
    // Texto de conteo con contexto: un cero indica a qué distancia está el elemento más cercano
    const cntTxt = k => { if (!ran(k)) return 'no analizada'; const ct=cnt(k); if (ct>0) return this._nf(ct)+' en el radio'; const nr=L[k]&&L[k].nearest; return nr ? 'ninguno · el más cercano a '+Math.round(nr)+' km' : 'ninguno en el radio'; };
    const gerKey = this._gerenciaOf(A.estado||'');
    let muni = '—';
    if (this._muniGeo) { for (const f of (this._muniGeo.features||[])) { if (this._inFeature(A.lng, A.lat, f.geometry)) { muni = (f.properties && (f.properties.NOMGEO||f.properties.nombre)) || '—'; break; } } }
    const subs = this._nearestSubs(A.lat, A.lng, 5);
    const lines = this._nearestLines(A.lat, A.lng, 5);
    const sections = [];
    // 1 · Conexión eléctrica estratégica (siempre: subestaciones/líneas se cargan al arranque)
    sections.push({ key:'elec', kicker:'Infraestructura eléctrica', color:'#9B2247', icon:'M13 2 3 14h7l-1 8 10-12h-7z', title:'Conexión estratégica a la red',
      intro:'Puntos de interconexión más cercanos al sitio: determinan el costo y la viabilidad técnica del proyecto.',
      rows: [], chips: [], hasChips:false, hasRows:false,
      hasTable:true, table:{ head:['Subestación','Entidad','Tensión','Distancia'], rows: subs.map(s=>[s.name, s.ent||'—', s.kv? this._nf(s.kv)+' kV':'—', s.dist.toFixed(1)+' km']) },
      hasTable2:true, table2:{ head:['Línea de transmisión','Tensión','Longitud','Distancia'], rows: lines.map(l=>[l.name, l.kv? this._nf(l.kv)+' kV':'—', l.km? l.km.toFixed(0)+' km':'—', l.dist.toFixed(1)+' km']) } });
    // 2 · Impacto social — población indígena
    const socKeys = [['atlas_pi','Pueblos indígenas (atlas)'],['lenguas','Lenguas indígenas'],['loc_ind','Localidades indígenas'],['reg_ind','Regiones indígenas'],['ruta_wx','Ruta Wixárika']];
    const socRows = socKeys.map(([k,lab]) => [lab, cntTxt(k)]);
    // Detalle de elementos sociales identificados en el radio (todas las capas sociales analizadas)
    const socDetail = [];
    [['atlas_pi','Pueblo indígena'],['lenguas','Lengua indígena'],['loc_ind','Localidad indígena'],['reg_ind','Región indígena'],['ruta_wx','Ruta Wixárika']].forEach(([k,lab])=>{
      if (!ran(k)) return;
      const seen = new Set();
      feats(k).forEach(f => { const nm=f.nom; if (nm && !seen.has(nm)) { seen.add(nm); if (socDetail.length<14) socDetail.push([String(nm).slice(0,46), lab]); } });
    });
    const socTotal = ['atlas_pi','lenguas','loc_ind','reg_ind','ruta_wx'].filter(ran).reduce((s,k)=>{ const seen=new Set(); feats(k).forEach(f=>f.nom&&seen.add(f.nom)); return s+seen.size; },0);
    if (socTotal > 14) socDetail.push(['… y '+this._nf(socTotal-14)+' elementos más', '']);
    sections.push({ key:'social', kicker:'Impacto social', color:'#C0552E', icon:'M17 21v-2a4 4 0 0 0-3-3.87 M7 21v-2a4 4 0 0 1 4-4h1 M12 11a4 4 0 1 0 0-8 4 4 0 0 0 0 8z', title:'Población y comunidades indígenas',
      intro:'Presencia de comunidades que podrían requerir consulta previa, libre e informada (Convenio 169 OIT).',
      hasRows:true, rows:socRows, hasChips:false, chips:[],
      hasTable:socDetail.length>0, table:{ head:['Elemento identificado','Tipo'], rows:socDetail }, hasTable2:false });
    // 3 · Ambiental
    const ambKeys = [['anp','ANP federales'],['anp_est','ANP estatales'],['conserv','Conservación voluntaria'],['ramsar','Humedales RAMSAR']];
    const ambRows = ambKeys.map(([k,lab]) => [lab, cntTxt(k)]);
    const ambNames = ['anp','anp_est','ramsar','conserv'].filter(ran).map(k=>names(k,5).list).flat().slice(0,10);
    sections.push({ key:'amb', kicker:'Medio ambiente', color:'#0E8A6E', icon:'M11 20A7 7 0 0 1 4 13C4 7 9 3 20 4c1 11-3 16-9 16z M4 21c3-3 6-5 9-6', title:'Áreas naturales protegidas',
      intro:'Superficies bajo protección que condicionan o excluyen el desarrollo del proyecto.',
      hasRows:true, rows:ambRows, hasChips:ambNames.length>0, chips:ambNames, hasTable:false, hasTable2:false });
    // 4 · Patrimonio cultural
    const patKeys = [['arqueo','Sitios arqueológicos'],['za_pub','Zonas arqueológicas'],['z_hist','Zonas históricas']];
    const patRows = patKeys.map(([k,lab]) => [lab, cntTxt(k)]);
    const patNames = ['za_pub','z_hist','arqueo'].filter(ran).map(k=>names(k,5).list).flat().slice(0,10);
    sections.push({ key:'pat', kicker:'Patrimonio cultural', color:'#C9A24B', icon:'M3 22h18 M5 22V10 M19 22V10 M12 2 3 7h18z M9 22v-6h6v6', title:'Patrimonio arqueológico e histórico',
      intro:'Elementos con protección INAH en el entorno del sitio.',
      hasRows:true, rows:patRows, hasChips:patNames.length>0, chips:patNames, hasTable:false, hasTable2:false });
    // 5 · Territorio y tenencia
    const terRows = [
      ['Núcleos agrarios (RAN)', cntTxt('ran')],
      ['Presas', cntTxt('presas')],
      ['Ductos de importación', cntTxt('ductos_imp')],
      ['Ductos SISTRANGAS', cntTxt('ductos_sis')],
      ['Centrales eléctricas', cntTxt('centrales')],
    ];
    const ranNames = ran('ran') ? names('ran',8).list : [];
    sections.push({ key:'ter', kicker:'Territorio', color:'#2E6FB0', icon:'M3 3h7v7H3z M14 3h7v7h-7z M3 14h7v7H3z M14 14h7v7h-7z', title:'Tenencia de la tierra e infraestructura',
      intro:'Núcleos agrarios (posible negociación ejidal/comunal) e infraestructura complementaria.',
      hasRows:true, rows:terRows, hasChips:ranNames.length>0, chips:ranNames, hasTable:false, hasTable2:false });
    // 6 · Datasets vinculados: registros de las fuentes conectadas dentro del radio
    const dsAct = this.state.datasets.filter(d=>d.active);
    if (dsAct.length) {
      const rowsDs=[]; const inRows=[];
      dsAct.forEach(d=>{
        let inR=0;
        d.rows.forEach(r=>{ const ll=this._placeRow(r,d); if(!ll) return; if(this._haversine(A.lat,A.lng,ll[0],ll[1])<=A.radiusKm){ inR++; inRows.push({ r, d }); } });
        rowsDs.push([d.name, this._nf(inR)+' de '+this._nf(d.rows.length)+' registros en el radio']);
      });
      // Detalle de los registros encontrados — sólo los campos más representativos
      const MAXR = 14;
      const tRows = inRows.slice(0, MAXR).map(({r,d}) => {
        const tec = this._dsRowTech(r);
        const cap = (+r.capacidad_mw) || this._dsNum(r, /capacidad|^mw$/i);
        const ent = this.CVE_ENT[r.cve_ent] || this._dsField(r, /entidad|nom_ent|^estado$/i) || '—';
        return [ this._dsRowName(r).slice(0,36), String(d.name).slice(0,26), tec?this._tecLabel(tec):'—', cap?this._nf(cap)+' MW':'—', String(ent).slice(0,16) ];
      });
      if (inRows.length > MAXR) tRows.push(['… y '+this._nf(inRows.length-MAXR)+' registros más (ver Excel)', '', '', '', '']);
      sections.push({ key:'ds', kicker:'Datasets vinculados', color:'#1E9CB8', icon:'M12 8c4.4 0 8-1.3 8-3s-3.6-3-8-3-8 1.3-8 3 3.6 3 8 3z M20 5v14c0 1.7-3.6 3-8 3s-8-1.3-8-3V5 M4 12c0 1.7 3.6 3 8 3s8-1.3 8-3', title:'Registros de datasets en la zona',
        intro:'Filas de las fuentes conectadas (convocatorias, permisos, seguimiento) cuya ubicación cae dentro del radio. Los registros ubicados por territorio (centroide de entidad/gerencia) son aproximados.',
        hasRows:true, rows:rowsDs, hasChips:false, chips:[],
        hasTable:tRows.length>0, table:{ head:['Registro','Dataset','Tecnología','Capacidad','Entidad'], rows:tRows }, hasTable2:false });
    }
    const totalEl = A.ranKeys.reduce((s,k)=>s+cnt(k),0);
    // KPIs dinámicos: primero capas con datos dentro del radio; después capas en cero por cercanía.
    // Se mantienen subestaciones y líneas si están seleccionadas para preservar contexto de red.
    const pri = ['subestaciones','lineas'];
    const pool = A.ranKeys.map(k => ({
      key: k,
      ct: cnt(k),
      nr: (L[k] && Number.isFinite(L[k].nearest)) ? L[k].nearest : Number.POSITIVE_INFINITY,
      label: (L[k] && L[k].label) || k,
      color: (L[k] && L[k].color) || '#9B2247'
    }));
    const used = new Set();
    const ordered = [];
    const pushK = it => { if (!it || used.has(it.key)) return; used.add(it.key); ordered.push(it); };
    pri.forEach(k => pushK(pool.find(p => p.key===k)));
    pool.filter(p => p.ct>0).sort((a,b) => b.ct-a.ct).forEach(pushK);
    pool.filter(p => p.ct===0).sort((a,b) => a.nr-b.nr).forEach(pushK);
    const kpiLayers = ordered.slice(0,7);
    return {
      date: new Date().toLocaleDateString('es-MX', { year:'numeric', month:'long', day:'numeric' }),
      meta: [
        ['Estado', A.estado||'—'], ['Municipio', muni], ['Gerencia de control', 'GCR '+(this.GCR_NOMBRE[gerKey]||'—')],
        ['Coordenadas', A.lat.toFixed(5)+', '+A.lng.toFixed(5)], ['Radio de análisis', A.radiusKm+' km'], ['Capas analizadas', String(A.ranKeys.length)],
      ],
      metrics: [{ label:'Elementos totales', value:this._nf(totalEl), color:'#9B2247', dim:false, sub:'en '+A.radiusKm+' km' }]
        .concat(kpiLayers.map(it => {
          const nrTxt = Number.isFinite(it.nr) ? ('más cercano a '+Math.round(it.nr)+' km') : 'sin presencia en el radio';
          return {
            label: it.label,
            value: this._nf(it.ct),
            color: it.color,
            dim: it.ct===0,
            sub: it.ct>0 ? 'en el radio' : nrTxt
          };
        }))
        .concat(dsAct.map(d => { let inR=0; d.rows.forEach(r=>{ const ll=this._placeRow(r,d); if(ll && this._haversine(A.lat,A.lng,ll[0],ll[1])<=A.radiusKm) inR++; }); return { label:d.name, value:this._nf(inR), color:d.color||'#1E9CB8', dim:inR===0, sub: inR>0 ? 'registros en el radio' : 'sin registros en el radio' }; })),
      sections,
    };
  }
  onOpenReport = () => {
    const rep = this._buildReport();
    if (!rep) { this._toast('Ejecuta primero un análisis de zona'); return; }
    this._report = rep;
    this.setState({ reportOpen:true });
  };
  onCloseReport = () => this.setState({ reportOpen:false, reportSendOpen:false, reportSendBusy:false });
  onOpenReportSend = () => {
    const A = this.state.analysis || {};
    const hasRun = !!(A.lat!=null && A.ranKeys && A.ranKeys.length && !A.stale);
    if (!hasRun) { this._toast('Primero ejecuta una corrida de análisis para habilitar el envío'); return; }
    if (!this._report) {
      const rep = this._buildReport();
      if (!rep) { this._toast('No se pudo preparar el reporte para envío'); return; }
      this._report = rep;
    }
    this.setState({ reportSendOpen:true, reportSendFeedback:'', reportSendFeedbackType:'' });
  }
  onCloseReportSend = () => this.setState({ reportSendOpen:false, reportSendBusy:false, reportSendFeedback:'', reportSendFeedbackType:'' });
  _setReportSendFeedback(msg, type){ this.setState({ reportSendFeedback: msg||'', reportSendFeedbackType: type||'' }); }
  _reportFileName(fmt){
    const f = fmt==='pdf16x9' ? 'pdf16x9' : 'pdf';
    const base = f==='pdf16x9' ? 'DGMESNIE_reporte_territorial_16x9_' : 'DGMESNIE_reporte_territorial_';
    return base + new Date().toISOString().slice(0,10) + '.pdf';
  }
  onSubmitReportSend = async () => {
    if (this.state.reportSendBusy) return;
    const ids = Object.keys(this.state.reportSendSel).filter(k => this.state.reportSendSel[k]).map(k => +k).filter(n => Number.isFinite(n));
    if (!ids.length) { this._setReportSendFeedback('Selecciona al menos un destinatario.', 'error'); return; }
    const fmt = this.state.reportSendFmt==='pdf16x9' ? 'pdf16x9' : 'pdf';
    const R = this._report;
    if (!R) { this._setReportSendFeedback('No hay reporte generado para enviar.', 'error'); return; }
    this.setState({ reportSendBusy:true });
    this._setReportSendFeedback('Generando reporte para adjuntar…', 'info');
    try {
      const archivo = fmt==='pdf16x9' ? this._writeReportPDFPresent(R, { returnData:true }) : this._writeReportPDF(R, { returnData:true });
      if (!archivo || !archivo.base64) throw new Error('No fue posible generar el archivo.');
      this._setReportSendFeedback('Enviando correo…', 'info');
      const res = await fetch('/DashboardProyectos/EnviarReporte', {
        method:'POST',
        headers:{ 'Content-Type':'application/json', 'RequestVerificationToken': this.REPORT_CSRF },
        body: JSON.stringify({
          clavePem: 'ReporteTerritorial',
          formato: fmt,
          archivoBase64: archivo.base64,
          nombreArchivo: this._reportFileName(fmt),
          usuarioIds: ids,
          mensajeAdicional: this.state.reportSendMsg || ''
        })
      });
      let data = {}; try { data = await res.json(); } catch(_e){}
      if (res.ok && data.ok) {
        this._setReportSendFeedback(data.mensaje || 'Reporte enviado.', 'ok');
        this.setState({ reportSendSel:{} });
        setTimeout(() => this.onCloseReportSend(), 1800);
      } else {
        this._setReportSendFeedback(data.mensaje || 'No fue posible enviar el reporte.', 'error');
      }
    } catch (e) {
      this._setReportSendFeedback('Ocurrió un error al enviar. Intenta nuevamente.', 'error');
    } finally {
      this.setState({ reportSendBusy:false });
    }
  }
  exportReportPDF = () => {
    const R = this._report; if (!R) return;
    // El mapa se captura con el ENCUADRE ACTIVO del usuario (su zoom y posición actuales),
    // tal como se ve en pantalla al momento de exportar.
    this.setState({ blocking:{ label:'Componiendo reporte PDF…' } });
    setTimeout(() => {
      try { this._writeReportPDF(R); }
      catch(e) { this._toast('Error al generar el PDF: '+(e.message||e)); }
      finally { this.setState({ blocking:null }); }
    }, 250);
  };
  exportReportPDFPresent = () => {
    const R = this._report; if (!R) return;
    this.setState({ blocking:{ label:'Componiendo reporte 16:9…' } });
    setTimeout(() => {
      try { this._writeReportPDFPresent(R); }
      catch(e) { this._toast('Error al generar el PDF 16:9: '+(e.message||e)); }
      finally { this.setState({ blocking:null }); }
    }, 250);
  };
  _reportMetaValue(R, label){
    const row = ((R&&R.meta)||[]).find(r => String(r[0]).toLowerCase()===String(label).toLowerCase());
    return row ? String(row[1]) : '—';
  }
  _pdfReportCover(doc, R, W, H, landscape){
