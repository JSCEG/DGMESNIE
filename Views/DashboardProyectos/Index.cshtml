  exportReportXLSX = () => {
    const R=this._report;
    if(!R){ this._toast('No hay un reporte territorial generado'); return; }
    const X=window.XLSX;
    if(!X){ this._toast('Preparando módulo Excel…'); return; }

    const wb=X.utils.book_new();
    wb.Props={
      Title:'Reporte institucional de análisis territorial',
      Subject:'Evaluación territorial DGMESNIE',
      Author:'Secretaría de Energía · DGMESNIE',
      Company:'Secretaría de Energía',
      CreatedDate:new Date()
    };

    const C={ guinda:'9B2247', gold:'E0A12E', cream:'FAF8F5', white:'FFFFFF', ink:'1C1B1A', gray:'6F6B66', line:'E6E1DA' };
    const bd={ style:'thin', color:{rgb:C.line} };
    const border={ top:bd, bottom:bd, left:bd, right:bd };
    const ST={
      title:{ font:{bold:true,color:{rgb:C.white},sz:18}, fill:{fgColor:{rgb:C.guinda}}, alignment:{horizontal:'left',vertical:'center',wrapText:true}, border },
      kicker:{ font:{bold:true,color:{rgb:C.guinda},sz:10}, fill:{fgColor:{rgb:C.cream}}, alignment:{vertical:'center',wrapText:true}, border },
      gold:{ font:{bold:true,color:{rgb:C.ink},sz:11}, fill:{fgColor:{rgb:C.gold}}, alignment:{vertical:'center',wrapText:true}, border },
      head:{ font:{bold:true,color:{rgb:C.white},sz:10}, fill:{fgColor:{rgb:C.guinda}}, alignment:{vertical:'center',wrapText:true}, border },
      cell:{ font:{color:{rgb:C.ink},sz:10}, alignment:{vertical:'top',wrapText:true}, border },
      alt:{ font:{color:{rgb:C.ink},sz:10}, fill:{fgColor:{rgb:C.cream}}, alignment:{vertical:'top',wrapText:true}, border },
      note:{ font:{italic:true,color:{rgb:C.gray},sz:9}, alignment:{vertical:'top',wrapText:true}, border },
      link:{ font:{bold:true,underline:true,color:{rgb:C.guinda},sz:10}, fill:{fgColor:{rgb:C.cream}}, alignment:{vertical:'center'}, border }
    };
    const usedNames=new Set();
    const sheetName=(raw)=>{
      let base=String(raw==null?'Hoja':raw).replace(/[\\/?*\[\]:]/g,' ').replace(/[\u0000-\u001f]/g,' ').replace(/\s+/g,' ').trim().replace(/^'+|'+$/g,'');
      if(!base) base='Hoja';
      base=base.slice(0,31);
      let name=base, n=2;
      while(usedNames.has(name.toLocaleLowerCase('es-MX'))){
        const suffix=' ('+(n++)+')';
        name=base.slice(0,31-suffix.length)+suffix;
      }
      usedNames.add(name.toLocaleLowerCase('es-MX'));
      return name;
    };
    // Se reservan primero los nombres contractuales para conservarlos exactamente.
    const N={
      cover:sheetName('Portada'), index:sheetName('Índice'), zone:sheetName('Zona evaluada'),
      metrics:sheetName('Indicadores'), sources:sheetName('Fuentes y notas')
    };
    const sections=Array.isArray(R.sections)?R.sections:[];
    const activeDatasets=(Array.isArray(this.state.datasets)?this.state.datasets:[]).filter(d=>d&&d.active);
    const sectionPlans=sections.map((sec,i)=>({ sec, name:sheetName(sec&&sec.title?sec.title:'Sección '+(i+1)), order:i+1 }));
    const datasetPlans=activeDatasets.map((dataset,i)=>({ dataset, name:sheetName('Datos · '+(dataset.name||('Dataset '+(i+1)))) }));
    const quoteName=(name)=>String(name).replace(/'/g,"''");
    const touch=(ws,r,c)=>{
      const point={r,c};
      if(!ws['!ref']) ws['!ref']=X.utils.encode_range({s:point,e:point});
      else {
        const range=X.utils.decode_range(ws['!ref']);
        range.s.r=Math.min(range.s.r,r); range.s.c=Math.min(range.s.c,c);
        range.e.r=Math.max(range.e.r,r); range.e.c=Math.max(range.e.c,c);
        ws['!ref']=X.utils.encode_range(range);
      }
    };
    const ensure=(ws,r,c)=>{
      touch(ws,r,c);
      const a=X.utils.encode_cell({r,c});
      if(!ws[a]) ws[a]={t:'s',v:''};
      return ws[a];
    };
    const put=(ws,r,c,value,style)=>{
      touch(ws,r,c);
      const a=X.utils.encode_cell({r,c});
      ws[a]={t:typeof value==='number'?'n':typeof value==='boolean'?'b':'s',v:value==null?'':value};
      if(style) ws[a].s=style;
      return ws[a];
    };
    const link=(ws,r,c,label,target)=>{
      const cell=put(ws,r,c,label,ST.link);
      cell.l={Target:"#'"+quoteName(target)+"'!A1",Tooltip:'Ir a '+target};
    };
    const backLink=(ws)=>link(ws,0,0,'← Volver al Índice',N.index);
    const merge=(ws,sr,sc,er,ec)=>{
      ws['!merges']=ws['!merges']||[];
      ws['!merges'].push({s:{r:sr,c:sc},e:{r:er,c:ec}});
      const anchor=ensure(ws,sr,sc), style=anchor.s;
      for(let r=sr;r<=er;r++) for(let c=sc;c<=ec;c++){
        const cell=ensure(ws,r,c);
        if(style) cell.s=style;
      }
    };
    const asNumber=(value,hint)=>{
      if(typeof value==='number' || typeof value==='boolean' || value instanceof Date || value==null) return value;
      const s=String(value).trim();
      const numericHint=/(^|_)(mw|mva|kv|capacidad|tension|distancia|longitud|inversion|anio|año|conteo|cantidad|total|valor)(_|$)|^(valor|total|conteo|cantidad)$/i.test(String(hint||''));
      if(numericHint && /^[-+]?(?:\d{1,3}(?:,\d{3})+|\d+)(?:\.\d+)?$/.test(s)){
        const n=Number(s.replace(/,/g,''));
        if(Number.isFinite(n)) return n;
      }
      return value;
    };
    const numberStyle=(base,cell)=>cell&&cell.t==='n'?{...base,numFmt:Number.isInteger(cell.v)?'#,##0;[Red]-#,##0':'#,##0.00;[Red]-#,##0.00'}:base;
    const paintTable=(ws,headerRow,lastRow,colCount,setFilter)=>{
      for(let c=0;c<colCount;c++) ensure(ws,headerRow,c).s=ST.head;
      for(let r=headerRow+1;r<=lastRow;r++) for(let c=0;c<colCount;c++){
        const cell=ensure(ws,r,c), base=(r-headerRow)%2===0?ST.alt:ST.cell;
        cell.s=numberStyle(base,cell);
      }
      ws['!rows']=ws['!rows']||[];
      ws['!rows'][headerRow]={hpt:28};
      if(setFilter && lastRow>=headerRow) ws['!autofilter']={ref:X.utils.encode_range({s:{r:headerRow,c:0},e:{r:lastRow,c:Math.max(0,colCount-1)}})};
    };
    const widths=(values,minimums)=>{
      const cols=Math.max(minimums?minimums.length:0,...values.map(r=>Array.isArray(r)?r.length:0),1);
      return Array.from({length:cols},(_,c)=>{
        let w=(minimums&&minimums[c])||10;
        for(let r=0;r<Math.min(values.length,1000);r++) w=Math.max(w,Math.min(48,String((values[r]||[])[c]??'').length+2));
        return {wch:Math.min(48,w)};
      });
    };
    const finish=(ws,cols,freezeRow)=>{
      ws['!cols']=cols;
      if(freezeRow) ws['!freeze']={xSplit:0,ySplit:freezeRow,topLeftCell:'A'+(freezeRow+1),activePane:'bottomLeft',state:'frozen'};
      return ws;
    };
    const titleBlock=(ws,title,subtitle,lastCol)=>{
      backLink(ws);
      put(ws,2,0,title,ST.title); merge(ws,2,0,3,lastCol);
      put(ws,4,0,subtitle||'',ST.kicker); merge(ws,4,0,4,lastCol);
      ws['!rows']=ws['!rows']||[]; ws['!rows'][2]={hpt:30}; ws['!rows'][3]={hpt:30}; ws['!rows'][4]={hpt:24};
    };

    const coverRows=Array.from({length:17},()=>[]);
    const cover=X.utils.aoa_to_sheet(coverRows);
    backLink(cover);
    put(cover,2,0,'SUBSECRETARÍA DE PLANEACIÓN Y TRANSICIÓN ENERGÉTICA',ST.kicker); merge(cover,2,0,2,7);
    put(cover,3,0,'Reporte de análisis territorial',ST.title); merge(cover,3,0,5,7);
    put(cover,6,0,'Evaluación institucional de una zona estratégica',ST.gold); merge(cover,6,0,6,7);
    put(cover,8,0,'Fecha de corte',ST.head); put(cover,8,1,R.date||this._stamp(),ST.cell);
    put(cover,9,0,'Ámbito territorial',ST.head); put(cover,9,1,this._reportMetaValue(R,'Municipio')+', '+this._reportMetaValue(R,'Estado'),ST.cell);
    put(cover,10,0,'Radio de análisis',ST.head); put(cover,10,1,this._reportMetaValue(R,'Radio de análisis'),ST.cell);
    put(cover,11,0,'Gerencia de control',ST.head); put(cover,11,1,this._reportMetaValue(R,'Gerencia de control'),ST.cell);
    put(cover,13,0,'Contenido',ST.gold); merge(cover,13,0,13,7);
    put(cover,14,0,'El libro integra la ficha territorial, todos los indicadores, cada sección analítica, las fuentes activas completas y notas metodológicas.',ST.note); merge(cover,14,0,15,7);
    cover['!rows']=[{hpt:22},{hpt:8},{hpt:24},{hpt:31},{hpt:31},{hpt:31},{hpt:26}];
    finish(cover,[{wch:25},{wch:31},{wch:14},{wch:14},{wch:14},{wch:14},{wch:14},{wch:14}],1);

    const allEntries=[
      {name:N.cover,type:'Presentación',description:'Portada institucional'},
      {name:N.index,type:'Navegación',description:'Índice con vínculos internos'},
      {name:N.zone,type:'Panorama general',description:'Ficha completa de la zona evaluada'},
      {name:N.metrics,type:'Panorama general',description:'Indicadores del reporte territorial'},
      ...sectionPlans.map(p=>({name:p.name,type:'Sección de análisis',description:p.sec&&p.sec.title?p.sec.title:'Sección '+p.order})),
      ...datasetPlans.map(p=>({name:p.name,type:'Dataset fuente completo',description:p.dataset.name||'Dataset activo'})),
      {name:N.sources,type:'Trazabilidad',description:'Fuentes, cobertura y notas metodológicas'}
    ];
    const indexRows=[['ÍNDICE DEL LIBRO'],['Seleccione una hoja para navegar dentro del archivo.'],[],['Hoja','Tipo','Contenido'],...allEntries.map(e=>[e.name,e.type,e.description])];
    const index=X.utils.aoa_to_sheet(indexRows);
    index['A1'].s=ST.title; merge(index,0,0,0,2);
    index['A2'].s=ST.kicker; merge(index,1,0,1,2);
    paintTable(index,3,indexRows.length-1,3,true);
    allEntries.forEach((e,i)=>link(index,4+i,0,e.name,e.name));
    index['!rows']=index['!rows']||[]; index['!rows'][0]={hpt:30}; index['!rows'][1]={hpt:24};
    finish(index,[{wch:31},{wch:24},{wch:58}],4);

    const meta=Array.isArray(R.meta)?R.meta:[];
    const zoneRows=[[],[],[],[],[],['Campo','Valor'],...meta.map(row=>[row&&row[0]!=null?row[0]:'',row&&row[1]!=null?row[1]:''])];
    const zone=X.utils.aoa_to_sheet(zoneRows);
    titleBlock(zone,'Zona evaluada','Ficha territorial completa · '+(R.date||this._stamp()),3);
    paintTable(zone,5,zoneRows.length-1,2,true);
    finish(zone,[{wch:31},{wch:58},{wch:16},{wch:16}],6);

    const metrics=Array.isArray(R.metrics)?R.metrics:[];
    const metricRows=metrics.map(m=>[m&&m.label!=null?m.label:'',asNumber(m&&m.value,'valor'),m&&m.sub!=null?m.sub:'',m&&m.color!=null?m.color:'',m&&m.dim?'Sí':'No']);
    const metricsRows=[[],[],[],[],[],['Indicador','Valor','Detalle','Color de referencia','Atenuado'],...metricRows];
    const metricSheet=X.utils.aoa_to_sheet(metricsRows);
    titleBlock(metricSheet,'Indicadores','Métricas completas del radio analizado',4);
    paintTable(metricSheet,5,metricsRows.length-1,5,true);
    finish(metricSheet,widths(metricsRows,[31,18,48,20,12]),6);

    const buildSection=(plan)=>{
      const sec=plan.sec||{}, rows=[[],[],[],[],[],['Introducción'],[sec.intro==null?'':sec.intro],[]];
      const blocks=[], merges=[];
      let maxCols=2;
      const tableKeys=Object.keys(sec).filter(k=>/^table\d*$/.test(k) && sec[k] && Array.isArray(sec[k].head) && Array.isArray(sec[k].rows));
      const tableOrder=k=>k==='table'?1:Number(k.replace('table','')||1);
      tableKeys.sort((a,b)=>tableOrder(a)-tableOrder(b));
      tableKeys.forEach((key,ti)=>{
        const table=sec[key], sourceRows=table.rows, n=Math.max(table.head.length,...sourceRows.map(r=>Array.isArray(r)?r.length:0),1);
        const head=Array.from({length:n},(_,i)=>table.head[i]!=null?table.head[i]:'Campo '+(i+1));
        maxCols=Math.max(maxCols,n);
        const labelRow=rows.length; rows.push([ti===0?'Detalle de la sección':'Detalle complementario']); merges.push({r:labelRow});
        const hr=rows.length; rows.push(head);
        sourceRows.forEach(row=>rows.push(Array.from({length:n},(_,i)=>asNumber((row||[])[i],head[i]))));
        blocks.push({header:hr,last:rows.length-1,cols:n}); rows.push([]);
      });
      const findingRows=Array.isArray(sec.rows)?sec.rows:[];
      if(findingRows.length || sec.hasRows){
        const labelRow=rows.length; rows.push(['Resumen de hallazgos']); merges.push({r:labelRow});
        const n=Math.max(2,...findingRows.map(r=>Array.isArray(r)?r.length:0));
        const head=Array.from({length:n},(_,i)=>i===0?'Concepto':i===1?'Valor':'Dato '+(i+1));
        const hr=rows.length; rows.push(head);
        findingRows.forEach(row=>rows.push(Array.from({length:n},(_,i)=>asNumber((row||[])[i],head[i]))));
        blocks.push({header:hr,last:rows.length-1,cols:n}); maxCols=Math.max(maxCols,n); rows.push([]);
      }
      const chips=Array.isArray(sec.chips)?sec.chips:[];
      if(chips.length || sec.hasChips){
        const labelRow=rows.length; rows.push(['Elementos identificados']); merges.push({r:labelRow});
        const hr=rows.length; rows.push(['No.','Elemento']);
        chips.forEach((chip,i)=>rows.push([i+1,chip==null?'':chip]));
        blocks.push({header:hr,last:rows.length-1,cols:2}); rows.push([]);
      }
      const ws=X.utils.aoa_to_sheet(rows);
      titleBlock(ws,String(sec.title||plan.name),String(sec.kicker||'Análisis territorial')+(sec.key?' · Clave '+sec.key:''),maxCols-1);
      ensure(ws,5,0).s=ST.gold; merge(ws,5,0,5,maxCols-1);
      ensure(ws,6,0).s=ST.note; merge(ws,6,0,6,maxCols-1);
      merges.forEach(m=>{ ensure(ws,m.r,0).s=ST.gold; merge(ws,m.r,0,m.r,maxCols-1); });
      blocks.forEach((b,i)=>paintTable(ws,b.header,b.last,b.cols,i===0));
      ws['!rows']=ws['!rows']||[]; ws['!rows'][6]={hpt:42};
      return finish(ws,widths(rows,Array.from({length:maxCols},(_,i)=>i===0?28:22)),6);
    };
    const sectionSheets=sectionPlans.map(p=>({name:p.name,ws:buildSection(p)}));

    const datasetSheets=datasetPlans.map(plan=>{
      const d=plan.dataset, fields=Array.isArray(d.fields)?d.fields:[], sourceRows=Array.isArray(d.rows)?d.rows:[];
      const data=sourceRows.map(row=>fields.map(field=>asNumber(row&&row[field],field)));
      const rows=[[],[],[],[],[],['Fuente',d.url||'Fuente conectada'],['Registros',sourceRows.length,'Campos',fields.length],fields,...data];
      const ws=X.utils.aoa_to_sheet(rows);
      titleBlock(ws,'Dataset fuente completo',String(d.name||plan.name)+' · sin truncamiento de filas ni campos',Math.max(fields.length-1,3));
      ensure(ws,5,0).s=ST.gold; ensure(ws,5,1).s=ST.note;
      ensure(ws,6,0).s=ST.gold; ensure(ws,6,1).s=numberStyle(ST.cell,ensure(ws,6,1)); ensure(ws,6,2).s=ST.gold; ensure(ws,6,3).s=numberStyle(ST.cell,ensure(ws,6,3));
      paintTable(ws,7,rows.length-1,Math.max(fields.length,1),true);
      const sample=[fields,...data.slice(0,999)];
      return {name:plan.name,ws:finish(ws,widths(sample,fields.map(()=>12)),8)};
    });

    const sourceRows=[
      [],[],[],[],[],
      ['Fuente o nota','Detalle','Registros','Campos'],
      ['Sistema institucional','DGMESNIE · Secretaría de Energía · CENACE · CFE','',''],
      ['Fecha de corte',R.date||this._stamp(),'',''],
      ['Cobertura territorial',this._reportMetaValue(R,'Municipio')+', '+this._reportMetaValue(R,'Estado')+' · '+this._reportMetaValue(R,'Radio de análisis'),'',''],
      ['Integridad del reporte','Las secciones, tablas, hallazgos y elementos identificados se incorporan completos conforme a this._report.','',''],
      ['Criterio geográfico','Los registros ubicados por centroide de entidad o gerencia representan una aproximación territorial.','',''],
      ['Validación','Las cifras están sujetas a actualización y verificación en campo.','',''],
      ...activeDatasets.map(d=>[d.name||'Dataset activo',d.url||'Fuente conectada',Array.isArray(d.rows)?d.rows.length:0,Array.isArray(d.fields)?d.fields.length:0])
    ];
    const sources=X.utils.aoa_to_sheet(sourceRows);
    titleBlock(sources,'Fuentes y notas','Trazabilidad, cobertura y criterios de lectura',3);
    paintTable(sources,5,sourceRows.length-1,4,true);
    finish(sources,[{wch:31},{wch:76},{wch:14},{wch:12}],6);

    X.utils.book_append_sheet(wb,cover,N.cover);
    X.utils.book_append_sheet(wb,index,N.index);
    X.utils.book_append_sheet(wb,zone,N.zone);
    X.utils.book_append_sheet(wb,metricSheet,N.metrics);
    sectionSheets.forEach(p=>X.utils.book_append_sheet(wb,p.ws,p.name));
    datasetSheets.forEach(p=>X.utils.book_append_sheet(wb,p.ws,p.name));
    X.utils.book_append_sheet(wb,sources,N.sources);

    X.writeFile(wb,'DGMESNIE_reporte_territorial_'+new Date().toISOString().slice(0,10)+'.xlsx',{cellStyles:true,bookSST:true});
    this._toast('Excel territorial exportado · '+wb.SheetNames.length+' hojas');
  };

  exportXLSX = () => {
    this.closeExport();
    const X=window.XLSX; if(!X){ this._toast('Preparando módulo Excel…'); return; }
    const wb=X.utils.book_new();
    const bd={ style:'thin', color:{rgb:'E6E1DA'} }; const border={ top:bd, bottom:bd, left:bd, right:bd };
    const HEAD={ font:{ bold:true, color:{rgb:'FFFFFF'}, sz:11 }, fill:{ fgColor:{rgb:'9B2247'} }, alignment:{ horizontal:'left', vertical:'center' }, border };
    const TITLE={ font:{ bold:true, color:{rgb:'9B2247'}, sz:15 } };
    const SUB={ font:{ italic:true, color:{rgb:'6F6B66'}, sz:9 } };
    const CELL={ font:{ sz:10 }, alignment:{ vertical:'center' }, border };
    const ALT ={ font:{ sz:10 }, alignment:{ vertical:'center' }, border, fill:{ fgColor:{rgb:'FAF8F5'} } };
    const NUM ={ font:{ sz:10 }, alignment:{ horizontal:'right', vertical:'center' }, border, numFmt:'#,##0' };
    const NUMA={ ...NUM, fill:{ fgColor:{rgb:'FAF8F5'} } };
    // Crea una hoja con encabezado guinda, filas alternadas y bordes
    const sheet=(header, rows, widths, numCols)=>{
      const ws=X.utils.aoa_to_sheet([header, ...rows]); const rg=X.utils.decode_range(ws['!ref']); numCols=numCols||[];
      for(let R=rg.s.r; R<=rg.e.r; R++) for(let C=rg.s.c; C<=rg.e.c; C++){ const ad=X.utils.encode_cell({r:R,c:C}); if(!ws[ad]) ws[ad]={t:'s',v:''}; const alt=R>0 && R%2===0; ws[ad].s = R===0?HEAD : (numCols.includes(C)?(alt?NUMA:NUM):(alt?ALT:CELL)); }
      ws['!cols']=widths.map(w=>({wch:w})); ws['!freeze']={ xSplit:0, ySplit:1 }; ws['!rows']=[{hpt:22}];
      return ws;
    };
    // Resumen + métricas
    const mr=this._metricRows();
    const resWs=X.utils.aoa_to_sheet([['Reporte de planeación energética'],['DGMESNIE · Generado: '+this._stamp()+'   ·   Alcance: '+this.state.scope+'   ·   Mapa base: '+this.state.basemap],[],['Métrica','Valor','Unidad'],...mr]);
    if(resWs['A1']) resWs['A1'].s=TITLE; if(resWs['A2']) resWs['A2'].s=SUB;
    ['A4','B4','C4'].forEach(a=>{ if(resWs[a]) resWs[a].s=HEAD; });
    for(let i=0;i<mr.length;i++){ const R=5+i, alt=i%2===1; ['A','B','C'].forEach((c,ci)=>{ const ad=c+(R); if(resWs[ad]) resWs[ad].s = ci===1?(alt?NUMA:NUM):(alt?ALT:CELL); }); }
    resWs['!cols']=[{wch:34},{wch:16},{wch:10}]; resWs['!merges']=[{s:{r:0,c:0},e:{r:0,c:2}},{s:{r:1,c:0},e:{r:1,c:2}}]; resWs['!rows']=[{hpt:22},{hpt:16}];
    X.utils.book_append_sheet(wb, resWs, 'Resumen');
    // Análisis de zona (si se ejecutó)
    const ar=this._anaRows();
    if(ar.length) X.utils.book_append_sheet(wb, sheet(['Concepto','Valor','Unidad'], ar, [34,18,12], [1]), 'Análisis de zona');
    // Capas
    const capRows=this._activeLayerRows().map(r=>[r.Capa,r.Categoria,r.Activa,r.Conteo]);
    X.utils.book_append_sheet(wb, sheet(['Capa','Categoría','Activa','Conteo'], capRows, [30,22,10,12], [3]), 'Capas');
    // Selección
    const sel=this.state.selected;
    if(sel) X.utils.book_append_sheet(wb, sheet(['Campo','Valor'], [['Nombre',sel.name],...sel.rows], [26,42]), 'Selección');
    // Una hoja con formato por dataset activo
    let n=0; this.state.datasets.filter(d=>d.active).forEach(d=>{ const cols=d.fields; const rows=d.rows.map(r=>cols.map(c=>r[c])); const widths=cols.map(c=>Math.max(12, Math.min(34, String(c).length+5))); const numCols=cols.map((c,i)=>/(_mw|_mva|_kv|inversion|anio|cve_|capacidad|tension)/i.test(c)?i:-1).filter(i=>i>=0); X.utils.book_append_sheet(wb, sheet(cols, rows, widths, numCols), (d.target+' '+(++n)).slice(0,28)); });
    X.writeFile(wb, 'DGMESNIE_planeacion_energetica_'+new Date().toISOString().slice(0,10)+'.xlsx');
    this._toast('Excel con formato exportado · '+this.state.datasets.filter(d=>d.active).length+' dataset(s)');
  };

  // ════════════════════ paneles: arrastre / colapso ════════════════════
  _startDrag(name, e) {
    if (e.target.closest('button')) return;
    e.preventDefault();
    const rect = this.mainRef.current.getBoundingClientRect();
    const el = e.currentTarget.parentNode;
    const er = el.getBoundingClientRect();
    const off = { x: e.clientX - er.left, y: e.clientY - er.top };
    const move = (ev) => {
      let left = ev.clientX - rect.left - off.x;
      let top = ev.clientY - rect.top - off.y;
      left = Math.max(4, Math.min(left, rect.width - 60));
      top = Math.max(4, Math.min(top, rect.height - 30));
      const pos = { ...this.state.pos, [name]:{ left:left+'px', top:top+'px' } };
      this.setState({ pos });
    };
    const up = () => { window.removeEventListener('mousemove', move); window.removeEventListener('mouseup', up); };
    window.addEventListener('mousemove', move); window.addEventListener('mouseup', up);
  }
  _collapse(name){ const collapsed={ ...this.state.collapsed, [name]:!this.state.collapsed[name] }; this.setState({ collapsed }); }
  // Abre el panel de detalle automáticamente cuando aparece una selección nueva.
  componentDidUpdate(){
    window.__dg = this; // referencia de depuración (se refresca tras hot-reload)
    // Nota: este runtime no pasa prevState a componentDidUpdate — se rastrea manualmente
    const prev = this._prevSelected; this._prevSelected = this.state.selected;
    if (this.state.selected && this.state.selected !== prev && this.state.collapsed.detalle) { this.setState({ collapsed:{ ...this.state.collapsed, detalle:false } }); }
  }
  toggleMobile(name){ this.setState({ mobilePanel: this.state.mobilePanel===name ? null : name }); }

  // ════════════════════ toast ════════════════════
  _toast(msg){ this.setState({ toast:msg }); clearTimeout(this._tt); this._tt=setTimeout(()=>this.setState({ toast:'' }), 3200); }

  // ════════════════════ render values ════════════════════
  _chevron(open){ return React.createElement('svg',{width:16,height:16,viewBox:'0 0 24 24',fill:'none',stroke:'currentColor',strokeWidth:2.4,strokeLinecap:'round',strokeLinejoin:'round'}, React.createElement('path',{d: open?'m6 15 6-6 6 6':'m6 9 6 6 6-6'})); }
  _panelBase(name, w) {
    const collapsed = this.state.collapsed[name];
    return Object.assign({ position:'absolute', zIndex:18, width:w, background:'#fff', border:'1px solid #ECE8E2', borderRadius:'14px', boxShadow:'0 8px 30px rgba(0,0,0,.12)', overflow: collapsed?'hidden':'visible' }, this.state.pos[name]);
  }

  renderVals() {
    const S = this.state;
    const L = S.layers;
    const tcChips = (t,label) => ({ label, onClick:()=>this.setConnectType(t), style:`padding:6px 12px;border:1px solid ${S.connectType===t?'#9B2247':'#ECE8E2'};background:${S.connectType===t?'#9B2247':'#fff'};color:${S.connectType===t?'#fff':'#6F6B66'};border-radius:7px;font-size:11.5px;font-weight:600;cursor:pointer;font-family:inherit` });
    const bmBtn = (k,label) => ({ label, onClick:()=>this.setBasemap(k), style:`padding:6px 13px;border:none;border-radius:7px;font-size:11.5px;font-weight:700;cursor:pointer;font-family:inherit;background:${S.basemap===k?'#9B2247':'transparent'};color:${S.basemap===k?'#fff':'#6F6B66'}` });
    const toolBtn = (active) => `display:flex;align-items:center;justify-content:center;width:36px;height:36px;border:1px solid ${active?'#9B2247':'#ECE8E2'};background:${active?'#9B2247':'#fff'};color:${active?'#fff':'#6F6B66'};border-radius:8px;cursor:pointer`;
    const fmt = (n) => (n==null?'—':Math.round(n).toLocaleString('es-MX'));

    const m = S.metrics;
    return {
      mapRef:this.mapRef, mainRef:this.mainRef,
      capasMob: S.mobilePanel==='capas' ? ' dgp-open' : '',
      datasetsMob: S.mobilePanel==='datasets' ? ' dgp-open' : '',
      detalleMob: S.mobilePanel==='detalle' ? ' dgp-open' : '',
