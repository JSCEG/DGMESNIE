    const radio=this._reportMetaValue(R,'Radio de análisis'), gcr=this._reportMetaValue(R,'Gerencia de control');
    this._pdfTitlePage(doc, W, H, landscape, {
      kicker:'SUBSECRETARÍA DE PLANEACIÓN Y TRANSICIÓN ENERGÉTICA',
      title:'Reporte de análisis territorial',
      idText:radio,
      subtitle:'Evaluación de sitio estratégico · '+municipio+', '+estado+'.',
