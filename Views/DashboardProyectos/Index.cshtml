  _pdfReportBarcode = (doc,x,y,w,h) => {
    const pattern=[2,1,3,1,1,2,4,1,2,2,1,3,2,1,4,2,1,1,3,2,2,1,4,1,1,3,1,2,3,1,2,1];
    const units=pattern.reduce((sum,n)=>sum+n,0);
    const scale=w/units;
    let cx=x;
    doc.setFillColor(28,27,26);
    pattern.forEach((unitsWide,index)=>{
      const bw=unitsWide*scale;
      if(index%2===0) doc.rect(cx,y,bw,h,'F');
      cx+=bw;
    });
  };

  _pdfReportQr = (doc,x,y,size) => {
