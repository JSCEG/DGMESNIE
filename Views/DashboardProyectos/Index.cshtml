      return {label,value,sub,h:Math.max(70,18+label.length*8.5+value.length*18+sub.length*9)};
    };
    const drawMetric=(mt,box,cx,cy,rowH)=>{
      const accent=rgb(mt&&mt.color,mt&&mt.dim?[154,149,142]:[155,34,71]);
      doc.setFillColor(mt&&mt.dim?250:255,mt&&mt.dim?248:255,mt&&mt.dim?245:255);
