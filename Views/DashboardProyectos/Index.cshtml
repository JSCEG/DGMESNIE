    .dg-util[disabled]{
      cursor:not-allowed;
      opacity:.52;
      background:#F2F0ED;
    }
    .dg-estado-boundary{
      filter:drop-shadow(0 1px 1px rgba(0,0,0,.14));
      transition:color .18s ease, weight .18s ease, opacity .18s ease;
      stroke-linejoin:round;
      stroke-linecap:round;
    }
    .dg-estado-boundary.dg-highlight{
      filter:drop-shadow(0 1px 3px rgba(155,34,71,.28));
    }
    .dg-map-fullscreen{
      position:fixed !important;
      inset:0;
      width:100vw !important;
      height:100vh !important;
      z-index:9999;
    }
    .dg-map-fullscreen .dg-map-canvas{
      height:100% !important;
    }
    .dg-map-fullscreen-toggle{
      position:absolute;
      top:12px;
      right:12px;
      z-index:40;
      width:36px;
      height:36px;
      border:1px solid #ECE8E2;
      border-radius:8px;
      background:#fff;
      color:#1c1b1a;
      display:flex;
      align-items:center;
      justify-content:center;
      cursor:pointer;
      box-shadow:0 8px 24px rgba(0,0,0,.16);
    }
    .dg-map-fullscreen-toggle:hover{
      background:#FAF8F5;
      border-color:#9B2247;
      color:#9B2247;
    }
    /* Los controles de Leaflet (zoom, escala) bajan para no quedar debajo de la barra de controles */
    /* .leaflet-top override removed to show zoom controls +/- */
    .dg-measure-tip{background:#fff;border:1px solid #9B2247;border-radius:6px;color:#9B2247;font-weight:700;font-family:'IBM Plex Mono',monospace;font-size:11px;padding:2px 7px}
    .dg-market-tray{
      position:absolute;left:0;right:0;bottom:0;z-index:26;height:270px;
      display:flex;flex-direction:column;background:rgba(255,255,255,.985);
      border-top:1px solid #DCD6CE;box-shadow:0 -12px 34px rgba(28,27,26,.13);
      animation:dgMarketUp .24s cubic-bezier(.2,.7,.2,1) both;
      transition:height .24s cubic-bezier(.2,.7,.2,1)
    }
    .dg-map-stage{position:relative;flex:1;overflow:hidden}
    .dg-map-canvas{position:absolute;inset:0;z-index:0;transition:height .24s cubic-bezier(.2,.7,.2,1)}
    .dg-demand-region-focus,
    .dg-demand-region-focus-halo{
      pointer-events:none;vector-effect:non-scaling-stroke;
      transform-box:fill-box;transform-origin:center
    }
    .dg-demand-region-focus{
      filter:drop-shadow(0 0 7px rgba(155,34,71,.42));
      animation:dgDemandRegionFill 1.7s ease-in-out 2
    }
    .dg-demand-region-focus-halo{
      filter:drop-shadow(0 0 9px rgba(155,34,71,.34));
      animation:dgDemandRegionHalo 1.7s ease-in-out 2
    }
    .leaflet-tooltip.dg-demand-region-label{
      margin:0;padding:6px 10px;border:1px solid rgba(255,255,255,.92);
      border-radius:999px;background:#9B2247;color:#FFF;
      box-shadow:0 4px 16px rgba(54,15,29,.28);
      font-size:10px;font-weight:800;letter-spacing:.025em;
      line-height:1.15;pointer-events:none;white-space:nowrap
    }
    .leaflet-tooltip.dg-demand-region-label:before{display:none}
    @@keyframes dgDemandRegionFill{
      0%,100%{fill-opacity:.24}
      50%{fill-opacity:.42}
    }
    @@keyframes dgDemandRegionHalo{
      0%,100%{stroke-opacity:.22;stroke-width:10px}
      50%{stroke-opacity:.62;stroke-width:18px}
    }
    @@media (prefers-reduced-motion:reduce){
      .dg-demand-region-focus,
      .dg-demand-region-focus-halo{animation:none}
    }
    .dg-market-tray.is-expanded{height:clamp(390px,54vh,520px)}
    @@keyframes dgMarketUp{from{opacity:0;transform:translateY(22px)}to{opacity:1;transform:none}}
    .dg-market-tray__head{height:48px;display:flex;align-items:center;gap:10px;padding:7px 14px;border-bottom:1px solid #ECE8E2;flex:none}
    .dg-market-tray__body{display:grid;grid-template-columns:286px minmax(0,1fr);gap:18px;padding:12px 16px 10px;min-height:0;flex:1}
    .dg-market-kpis{display:grid;grid-template-columns:1fr 1fr;gap:8px;align-content:start}
    .dg-market-kpi{min-width:0;padding:9px 11px;background:#FAF8F5;border:1px solid #ECE8E2;border-radius:9px}
    .dg-market-kpi:first-child{grid-column:1/-1}
    .dg-market-chart{position:relative;min-width:0;min-height:0;border-left:1px solid #F0ECE6;padding-left:18px;display:flex;flex-direction:column}
    .dg-market-plot{
      position:relative;width:min(100%,1800px);min-height:0;aspect-ratio:20/3;
      flex:0 1 auto;margin-inline:auto
    }
    .dg-market-chart svg{display:block;width:100%;height:100%;overflow:visible;touch-action:none}
    .dg-market-chart line,.dg-market-chart polyline,.dg-market-chart circle{vector-effect:non-scaling-stroke}
    .dg-market-chart__head{display:flex;align-items:flex-start;gap:10px;min-height:30px}
    .dg-market-chart__legend{display:flex;align-items:center;justify-content:flex-end;flex-wrap:wrap;gap:6px 10px;font-size:8.5px;font-weight:700;color:#6F6B66}
    .dg-market-chart__source{display:flex;align-items:center;gap:6px;margin-top:auto;min-width:0;font-size:8.5px;color:#9A958E}
    .dg-market-chart__source span:last-child{min-width:0;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}
    @@media (min-width:821px){
      .dg-map-stage.has-market .dg-map-canvas{
        bottom:auto!important;height:max(140px,calc(100% - 270px))!important
      }
      .dg-market-tray.is-expanded .dg-market-tray__body{
        grid-template-columns:minmax(0,1fr);grid-template-rows:auto minmax(0,1fr);gap:10px
      }
      .dg-market-tray.is-expanded .dg-market-kpis{grid-template-columns:repeat(3,minmax(0,1fr))}
      .dg-market-tray.is-expanded .dg-market-kpi:first-child{grid-column:auto}
      .dg-market-tray.is-expanded .dg-market-chart{
        border-left:none;border-top:1px solid #F0ECE6;padding:10px 0 0
      }
      .dg-market-tray.is-expanded .dg-market-plot{
        flex:0 0 auto;height:auto
      }
    }
    @@media (min-width:821px) and (min-height:650px){
      .dg-map-stage.has-market.market-expanded .dg-map-canvas{
        bottom:auto!important;
        height:max(160px,calc(100% - clamp(390px,54vh,520px)))!important
      }
    }
    .dg-market-tooltip{
      position:absolute;top:12px;z-index:3;min-width:172px;padding:9px 10px;
      transform:translateX(10px);pointer-events:none;color:#fff;background:rgba(28,27,26,.96);
      border:1px solid rgba(255,255,255,.14);border-radius:8px;box-shadow:0 8px 22px rgba(0,0,0,.24);
      font:700 10px/1.35 'Noto Sans',sans-serif
    }
    .dg-market-tooltip.is-right{transform:translateX(calc(-100% - 10px))}
    .dg-market-tooltip__row{display:grid;grid-template-columns:8px 1fr auto;align-items:center;gap:6px;margin-top:4px}
    .dg-market-axis{position:absolute;inset:0;pointer-events:none;color:#6F6B66;font:700 10px/1 'Noto Sans',sans-serif}
    .dg-market-axis__unit{position:absolute;left:8px;top:2px;font-weight:800}
    .dg-market-axis__y{position:absolute;left:0;width:7.2%;text-align:right;transform:translateY(-50%)}
    .dg-market-axis__temp-unit{position:absolute;right:4px;top:2px;color:#C96C1B;font-weight:800}
    .dg-market-axis__temp{position:absolute;right:3px;color:#C96C1B;transform:translateY(-50%)}
    .dg-market-axis__x{position:absolute;bottom:10px;white-space:nowrap}
    .dg-market-axis__title{position:absolute;left:50%;bottom:-1px;transform:translateX(-50%);font-size:9.5px}
    .dg-market-expand{
      height:32px;padding:0 11px;border:1px solid #DCD6CE;border-radius:8px;background:#fff;
      color:#6F6B66;font:800 10px/1 'Noto Sans',sans-serif;cursor:pointer;white-space:nowrap
    }
    .dg-market-expand:hover{border-color:#9B2247;color:#9B2247;background:#FFF8FA}
    .dg-legend-toggle{
      display:flex;align-items:center;gap:7px;height:32px;padding:0 11px;
      border:1px solid #DCD6CE;border-radius:999px;background:rgba(255,255,255,.96);
      color:#6F6B66;box-shadow:0 4px 14px rgba(0,0,0,.10);
      font:800 10px/1 'Noto Sans',sans-serif;cursor:pointer
    }
    .dg-legend-toggle:hover,
    .dg-legend-toggle.is-active{border-color:#9B2247;color:#9B2247;background:#FFF8FA}
    .dg-market-select{min-width:218px;max-width:330px;height:34px;padding:0 34px 0 10px;border:1px solid #DCD6CE;border-radius:8px;background:#fff;color:#1c1b1a;font:700 11.5px/1 'Noto Sans',sans-serif}
    .dg-market-tab{height:34px;padding:0 13px;border-radius:8px;border:1px solid #DCD6CE;background:#fff;color:#6F6B66;font:800 10.5px/1 'Noto Sans',sans-serif;letter-spacing:.02em;cursor:pointer}
    .dg-market-tab.is-active{border-color:#9B2247;background:#9B2247;color:#fff}
    .dg-market-metric{padding:5px 9px;border:1px solid #E5DFD6;border-radius:7px;background:#fff;color:#6F6B66;font:700 9.5px/1 'Noto Sans',sans-serif;cursor:pointer}
    .dg-market-metric.is-active{border-color:#1E9CB8;color:#1E6F86;background:rgba(30,156,184,.08)}
    /* ── Colapso intermedio (tablet / ventana angosta) antes del modo celular ── */
    @@media (max-width: 1180px){
      .dg-utxt{display:none}
      .dg-util{padding:9px 10px !important}
    }
    @@media (max-width: 1080px){
      .dg-brandtext{display:none !important}
      .dg-branddiv{display:none !important}
      .dg-brand{flex:0 0 auto !important}
    }
    @@media (max-width: 900px){
      .dg-basemaps{display:none !important}
      .dg-basesep{display:none !important}
      .dg-market-tray__body{grid-template-columns:230px minmax(0,1fr);gap:12px}
      .dg-market-tray__head{flex-wrap:wrap;height:auto;min-height:48px}
      .dg-market-chart__head{flex-wrap:wrap}
      .dg-market-chart__legend{width:100%;justify-content:flex-start}
    }
    /* ── Modo móvil (celular): paneles como hojas inferiores + barra de pestañas ── */
    .dg-tabbar{display:none}
    @@media (max-width: 820px){
      .dg-sub{display:none !important}
      .dg-header{padding:9px 12px !important; gap:10px !important}
      .dg-title{font-size:15px !important; white-space:normal !important; line-height:1.05 !important}
      .dg-brand img{height:30px !important}
      .dg-actions{gap:6px !important}
      .dg-actions button{padding:8px 9px !important; font-size:0 !important}
      .dg-actions button svg{width:17px !important; height:17px !important}
      .dg-actions button.dg-keeptext{font-size:12px !important}
      .dg-basemaps{display:none !important}
      .dg-basesep{display:none !important}
      .dg-headsearch{min-width:0 !important; max-width:none !important}
      .dg-wmtxt{display:none}
      .dg-toolbar{padding:6px 8px !important; gap:6px !important}
      .dg-toolbar select{max-width:130px !important}
      .dg-bottomright{bottom:64px !important; right:8px !important; left:auto !important}
      .dg-legend{max-width:210px !important; max-height:30vh !important}
      /* Objetivos táctiles ≥40px en controles del mapa y menús */
      .dg-toolbar button, .dg-toolbar select{min-height:40px}
      .dg-anadrop button{min-height:38px}
      .dg-anadrop input{min-height:38px}
      .dgp{position:fixed !important; left:0 !important; right:0 !important; top:auto !important; bottom:56px !important; width:auto !important; max-width:none !important; max-height:60vh !important; overflow-y:auto; border-radius:18px 18px 0 0 !important; transform:none !important; box-shadow:0 -10px 34px rgba(0,0,0,.22) !important; display:none !important}
      .dgp.dgp-open{display:block !important}
      .dgp .dg-draghdr{cursor:default !important}
      .dg-anadrop{position:fixed !important; left:0 !important; right:0 !important; top:auto !important; bottom:56px !important; width:auto !important; transform:none !important; max-height:62vh !important; border-radius:18px 18px 0 0 !important; box-shadow:0 -10px 34px rgba(0,0,0,.22) !important}
      .dg-detailtab{top:auto !important; bottom:120px !important}
      .dg-tabbar{display:flex !important}
      .dg-market-tray{position:fixed;height:min(52vh,360px);bottom:56px;overflow:auto}
      .dg-market-tray__head{height:auto;min-height:48px;flex-wrap:wrap}
      .dg-market-tray__body{display:flex;flex-direction:column;padding:10px 12px 14px}
      .dg-market-kpis{grid-template-columns:repeat(3,minmax(0,1fr))}
      .dg-market-kpi:first-child{grid-column:auto}
      .dg-market-chart{border-left:none;border-top:1px solid #F0ECE6;padding:10px 0 0}
      .dg-market-tray.is-expanded{height:calc(100vh - 112px)}
      .dg-market-tray.is-expanded .dg-market-plot{height:auto}
      .dg-market-select{order:5;width:100%;max-width:none}
    }
  </style>
</helmet>
<div class="dg-boot" style="display:flex;flex-direction:column;height:100%;width:100%;overflow:hidden;background:#FAF8F5;font-family:'Noto Sans',sans-serif;color:#1c1b1a;visibility:hidden">
  <!-- Cubre TODA la app durante el render server-side (incluye placeholders de sc-if,
       legendOn, capasOpen, modales, etc.) y se destapa cuando el componente confirma
       booting:false. Sin parpadeo de esqueletos ni leyenda antes del preloader. -->
  <style>
    .dg-boot { visibility: hidden !important; }
    html.dg-boot-ready .dg-boot, body.dg-boot-ready .dg-boot { visibility: visible !important; }
  </style>

  <header class="dg-header">
  <!-- Left Side: Title (Without redundant logo) -->
  <div class="dg-brand">
    <div class="dg-brandtext">
      <div class="dg-title">Dashboard de Planeación Energética</div>
      <div class="dg-sub">Infraestructura, permisos y proyectos</div>
    </div>
  </div>

  <!-- Center Side: Map tools -->
  <div class="dg-header-controls">
    <!-- Map Action Buttons -->
    <button onClick="{{ onCapasMenuToggle }}" title="Capas disponibles" style="{{ capasBtnStyle }};width:32px;height:32px">
      <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m12 2 9 5-9 5-9-5z"></path><path d="m3 12 9 5 9-5"></path><path d="m3 17 9 5 9-5"></path></svg>
      <sc-if value="{{ capasBadge }}" hint-placeholder-val="{{ false }}"><span style="position:absolute;top:-4px;right:-4px;min-width:13px;height:13px;border-radius:8px;background:#9B2247;color:#fff;font-size:8px;font-weight:800;display:flex;align-items:center;justify-content:center;padding:0 2px;font-family:'IBM Plex Mono',monospace">{{ capasBadgeCount }}</span></sc-if>
    </button>

    <button onClick="{{ onAnaOpenToggle }}" title="Análisis geoespacial · capas por zona y radio" style="{{ anaBtnStyle }};width:32px;height:32px">
      <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="9"/><circle cx="12" cy="12" r="4.5"/><circle cx="12" cy="12" r="1" fill="currentColor"/></svg>
      <sc-if value="{{ anaBadge }}" hint-placeholder-val="{{ false }}"><span style="position:absolute;top:-4px;right:-4px;min-width:13px;height:13px;border-radius:8px;background:#0E8A6E;color:#fff;font-size:8px;font-weight:800;display:flex;align-items:center;justify-content:center;padding:0 2px;font-family:'IBM Plex Mono',monospace">{{ anaBadgeCount }}</span></sc-if>
    </button>

    <button onClick="{{ onToggleMeasure }}" title="Medir distancia" style="{{ measureBtnStyle }};width:32px;height:32px">
      <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m15 5 4 4"/><path d="M3 21 21 3"/><path d="m6 12 1.5 1.5"/><path d="m10 8 1.5 1.5"/><path d="m13.5 13.5 1.5 1.5"/></svg>
    </button>

    <button onClick="{{ onClearTools }}" title="Limpiar herramientas" style="display:flex;align-items:center;justify-content:center;width:32px;height:32px;border:1px solid #ECE8E2;background:#fff;color:#6F6B66;border-radius:8px;cursor:pointer">
      <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M3 6h18"/><path d="M8 6V4h8v2"/><path d="m6 6 1 14h10l1-14"/></svg>
    </button>
  </div>

  <!-- Right Side: Search, Basemaps, Actions -->
  <div class="dg-actions-right">
    <div class="dg-headsearch">
      <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="#9A958E" stroke-width="2.2" stroke-linecap="round" style="position:absolute;left:10px;pointer-events:none"><circle cx="11" cy="11" r="7"/><path d="m21 21-4.3-4.3"/></svg>
      <input value="{{ search }}" onInput="{{ onSearchInput }}" onKeyDown="{{ onSearchKey }}" placeholder="Buscar en capas..." style="width:100%;padding:6px 8px 6px 28px;border:1px solid #ECE8E2;border-radius:8px;font-size:12px;font-family:inherit;background:#FAF8F5">
      <sc-if value="{{ hasSuggestions }}" hint-placeholder-val="{{ false }}">
        <div style="position:absolute;left:0;top:calc(100% + 8px);z-index:45;width:300px;max-height:300px;overflow-y:auto;background:#fff;border:1px solid #ECE8E2;border-radius:11px;box-shadow:0 14px 36px rgba(0,0,0,.17);animation:dgFade .15s ease both">
          <div style="padding:8px 12px 5px;font-size:9px;font-weight:800;letter-spacing:.12em;text-transform:uppercase;color:#9A958E">Sugerencias</div>
          <sc-for list="{{ searchSuggestions }}" as="sg" hint-placeholder-count="4">
            <button onClick="{{ sg.onClick }}" style="display:flex;align-items:center;gap:8px;width:100%;padding:8px 10px;border:none;background:none;cursor:pointer;text-align:left;font-family:inherit;border-top:1px solid #F6F3EF" style-hover="background:#FAF8F5">
              <span style="width:7px;height:7px;border-radius:50%;flex:none;background:{{ sg.color }}"></span>
              <span style="flex:1;min-width:0"><span style="display:block;font-size:11.5px;font-weight:600;color:#1c1b1a;white-space:nowrap;overflow:hidden;text-overflow:ellipsis">{{ sg.label }}</span></span>
            </button>
          </sc-for>
        </div>
      </sc-if>
    </div>

    <div class="dg-basemaps">
      <sc-for list="{{ basemaps }}" as="bm" hint-placeholder-count="4">
        <button onClick="{{ bm.onClick }}" style="{{ bm.style }};padding:4px 8px;font-size:11px">{{ bm.label }}</button>
      </sc-for>
    </div>

    <div class="dg-basesep"></div>

    <button class="dg-util" onClick="{{ onRefresh }}" title="Actualizar datos" style-hover="background:#FAF8F5">
      <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="#0E8A6E" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" style="flex:none"><path d="M21 12a9 9 0 1 1-2.6-6.4"/><path d="M21 3v6h-6"/></svg>
      <span class="dg-utxt">Actualizar</span>
    </button>

    <button class="dg-util" onClick="{{ onReset }}" title="Nuevo análisis · limpiar mapa" style-hover="background:#FAF8F5">
      <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="#6F6B66" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" style="flex:none"><path d="M3 12a9 9 0 1 1 9 9"/><path d="m8 16-5 0 0 5"/></svg>
      <span class="dg-utxt">Limpiar</span>
    </button>

    <button class="dg-util" onClick="{{ onToggleMapFullscreen }}" title="{{ mapFullscreenTitle }}" style-hover="background:#FAF8F5">
      <sc-if value="{{ mapFullscreen }}" hint-placeholder-val="{{ false }}">
        <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="#1E9CB8" stroke-width="2.1" stroke-linecap="round" stroke-linejoin="round" style="flex:none">
          <path d="M15 3h6v6M9 21H3v-6M21 21h-6v-6M3 3h6v6M9 3H5v4M21 9v-4h-4M16 21h4v-4M3 15v4h4"/>
        </svg>
      </sc-if>
      <sc-if value="{{ !mapFullscreen }}" hint-placeholder-val="{{ false }}">
        <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="#1E9CB8" stroke-width="2.1" stroke-linecap="round" stroke-linejoin="round" style="flex:none">
          <path d="M8 5H5V8M16 21h3v-3M19 16v3H16M5 16v3h3M8 21h3"/>
          <path d="M4 10V7c0-1.7 3.6-3 8-3"/>
        </svg>
      </sc-if>
      <span class="dg-utxt">{{ mapFullscreen ? 'Salir pantalla' : 'Pantalla completa' }}</span>
    </button>

    <div style="position:relative">
      <button onClick="{{ onToggleExport }}" style="display:flex;align-items:center;gap:5px;padding:6px 10px;border:1px solid #9B2247;background:#9B2247;color:#fff;border-radius:8px;font-size:11.5px;font-weight:600;cursor:pointer;font-family:inherit" style-hover="background:#8E1F40">
        Exportar <svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="#fff" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><path d="m6 9 6 6 6-6"/></svg>
      </button>
      <sc-if value="{{ exportOpen }}" hint-placeholder-val="{{ false }}">
        <div style="position:absolute;right:0;top:calc(100% + 6px);z-index:70;width:240px;background:#fff;border:1px solid #ECE8E2;border-radius:10px;box-shadow:0 14px 40px rgba(0,0,0,.18);overflow:hidden;animation:dgFade .18s ease both">
          <div style="padding:8px 10px;font-size:8.5px;font-weight:800;letter-spacing:.13em;text-transform:uppercase;color:#9B2247;border-bottom:1px solid #F0ECE6">Exportar</div>
          <button type="button" onClick="{{ onExportPNG }}" style="display:flex;align-items:center;gap:8px;width:100%;padding:8px 10px;border:none;background:none;cursor:pointer;font-family:inherit;text-align:left" style-hover="background:#FAF8F5">
            <span style="font-size:11.5px;font-weight:700;color:#1c1b1a">PNG · Alta Resolución</span>
          </button>
