        ['Estado',p.estado||'revisión'],
        ['Tipo de elemento',p.tipo_elemento||'—'],
        ['Referencia declarada',p.nombre||nom||'—'],
        ['Coincidencia de catálogo',p.coincidencia_catalogo||'—'],
        ['Nodo público de interconexión',p.coincidencia_interconexion_catalogo||p.nombre_interconexion_publica||'—'],
        ['Relación privada / pública',p.coincidencia_interconexion_publica_firme?'Declarada por la fuente y resuelta por separado':'—'],
        ['Tensión respaldada por red',p.coincidencia_tension_topologica_firme?'Sí · línea nominal y espacialmente conectada':'—'],
        ['Niveles observados',Array.isArray(p.niveles_tension_red_kv)?p.niveles_tension_red_kv.map(v=>Number(v).toLocaleString('es-MX')+' kV').join(' · '):'—'],
        ['Nivel de red sugerido',this._networkLevelLabel(p.nivel_red_sugerido)],
        ['Contraste Atlas SEN',p.atlas_sen_estado||'Sin auditoría'],
        ['Hallazgos Atlas SEN',p.atlas_sen_hallazgos||'—'],
        ['Homónimo territorial',p.homonimo_territorial_descartado?'Descartado por GCR y distancia extrema':'—'],
        ['Agrupación territorial',p.grupo_territorial_separado?(p.clave_agrupacion_territorial||'Separada'):'—'],
        ['Puntaje',p.puntaje!=null?String(p.puntaje)+'/100':'—'],
        ['Tensión',p.tension_kv!=null?Number(p.tension_kv).toLocaleString('es-MX',{maximumFractionDigits:2})+' kV':'—'],
        ['GCR',p.gcr||'—'],
        ['Entidad / municipio',[p.entidad,p.municipio].filter(Boolean).join(' · ')||'—'],
        ['Proyectos relacionados',String(p.proyectos_relacionados||0)],
        ['Folios',p.folios||'—'],
        ['Evidencias',p.evidencias||'—'],
        ['Validación','Pendiente de revisión humana · no forma parte del grafo oficial'],
        ['Fuente',p.fuente||'Google Sheets · Segunda Convocatoria']
      ];
      this.setState({
        selected:{
          kicker:'Segunda Convocatoria · evidencia de red',
          color:cfg.color,
          name:p.nombre||nom||cfg.label,
          rows
        }
      });
      return;
    }
    // Centrales eléctricas → ficha curada con tecnología y capacidad
    if (cfg.key === 'centrales') {
      const code = this._centralTech(p);
      const cap = p.Capacidad_autorizada_MW || p.Capacidad_operacion_MW || p.Capacidad_autorizada_MW_1;
      const rows = [
        ['Tipo de infraestructura','Central eléctrica'],
        ['Tecnología', this._techFull(code)],
        ['Energético primario', p.Energetico_primario || '—'],
        ['Modalidad', p.Modalidad || p.Tipo_permiso || '—'],
        ['Capacidad autorizada', cap!=null ? (Number(cap).toLocaleString('es-MX')+' MW') : '—'],
        ['Entidad federativa', ent || '—'],
        ['Empresa', p.EmpresaLíder || p.Razón_social || '—'],
        ['Estatus', p.Estatus_instalacion || p.Estatus || '—'],
        ['Permiso', p.NumeroPermiso || '—'],
        ['Fuente','CRE · Inventario DGMESNIE'],
      ];
      this.setState({ selected:{ kicker:'Central · '+this._techFull(code), color:this._tecColor(code), name:(p.Razón_social||p.EmpresaLíder||nom||'Central eléctrica'), rows } });
      return;
    }
    // Ficha 100% dinámica: TODOS los campos con valor del feature (hasta 14), tal como vienen del GeoJSON
    const rows = [['Tipo de infraestructura', cfg.label]];
    const fichaUrl=this._featureFichaUrl(cfg,p);
    if(fichaUrl){
      rows.push(['Ficha',fichaUrl]);
    }
    let n=0; for (const k in p){ if(n>=14) break; const v=p[k]; if(v==null||String(v).trim()==='') continue; rows.push([k.replace(/_/g,' '), String(v).slice(0,80)]); n++; }
    rows.push(['Fuente','Inventario geoespacial · DGMESNIE']);
    this.setState({ selected:{ kicker:cfg.label, color:cfg.color, name:nom||cfg.label, rows } });
  }
  _estadoColor(cve){ const n = parseInt(cve,10); return this.ESTADO_PALETTE[(isNaN(n)?0:n) % this.ESTADO_PALETTE.length]; }
  _estadoBoundaryStyle(cve, hover = false){
    return {
      className: hover ? 'dg-estado-boundary dg-highlight' : 'dg-estado-boundary',
      color: hover ? '#7A2347' : '#9B2247',
      weight: hover ? 1.9 : 1.25,
      opacity: hover ? 1 : .82,
      fillColor: hover ? '#F7F4EE' : '#FAF8F5',
      fillOpacity: hover ? .12 : .05,
    };
  }
  _buildZonas() {
    const L = window.L; this.groups.zonas.clearLayers();
    // Zonas de influencia = radio de 25 km sobre subestaciones ≥230 kV (análisis, no geometría nueva)
    let n=0;
    this.subFeatures.filter(s => s.kv>=230).slice(0,120).forEach(s => {
      const c = L.circle([s.lat, s.lng], { radius:25000, color:'#9AAE3B', weight:1, fillColor:'#9AAE3B', fillOpacity:.08, renderer:this._dataRenderer, pane:'data' });
      this._guardPath(c);
      c.addTo(this.groups.zonas);
      n++;
    });
    const layers = { ...this.state.layers }; layers.zonas.count = n; this.setState({ layers });
  }

  // ════════════════════ datasets externos ════════════════════
  onOpenConnect = () => { this._returnToAnalysis = true; this.setState({ connectOpen:true, anaOpen:false, menuOpen:null }); };
  onAnaChooseDataset = () => {
    this._returnToAnalysis = true;
    this.setState({ connectOpen:true, anaOpen:false, menuOpen:null, collapsed:{ ...this.state.collapsed, detalle:true } });
  };
  onCloseConnect = () => {
    const back = !!this._returnToAnalysis;
    this._returnToAnalysis = false; this._catTransform = null; this._catAnalysisOnly = false; this._catAutoBind = false;
    this.setState({ connectOpen:false, fields:null, connectUrl:'', catalogLoading:false, catalogLoadingName:'', loading:false, anaOpen:back, menuOpen:null });
  };
  stopProp = (e) => e.stopPropagation();
  openConv2Review = () => {
    this.setState({
      conv2ReviewOpen:true,
      menuOpen:null,
      mobilePanel:null,
      anaOpen:false,
      exportOpen:false
    }, () => {
      if (!this.state.conv2ReviewData && !this.state.conv2ReviewLoading) {
        this.loadConv2Review();
      }
    });
  };
  closeConv2Review = () => this.setState({
    conv2ReviewOpen:false,
    conv2DecisionTarget:null,
    conv2DecisionKind:'',
    conv2DecisionNote:'',
    conv2DecisionError:''
  });
  loadConv2Review = (forceRefresh=false) => {
    this.setState({
      conv2ReviewLoading:true,
      conv2ReviewError:''
    });
    const summaryUrl='/DashboardProyectos/PamTerritorial/EvidenciaConvocatoria/Resumen'
      +(forceRefresh?'?refrescar=true&ts='+Date.now():'');
    const requestJson=(url)=>fetch(url,{
      cache:'no-store',
      headers:{'Accept':'application/json','Cache-Control':'no-cache'}
    }).then(response=>{
      if(!response.ok) throw new Error('HTTP '+response.status);
      return response.json();
    });
    const validationsUrl='/DashboardProyectos/PamTerritorial/EvidenciaConvocatoria/Validaciones';
    Promise.all([
      requestJson(summaryUrl),
      requestJson(validationsUrl)
        .then(data=>({data,error:null}))
        .catch(error=>({data:{validaciones:[]},error}))
    ])
      .then(([data,validationResult])=>this.setState({
        conv2ReviewData:data,
        conv2ReviewValidations:Array.isArray(validationResult.data.validaciones)
          ?validationResult.data.validaciones
          :[],
        conv2ReviewLoading:false,
        conv2ReviewError:validationResult.error
          ?'La evidencia cargó, pero la bitácora de decisiones no está disponible. Puedes consultar la mesa y reintentar después.'
          :''
      }))
      .catch(error => {
        const message=String(error.message||error);
        const networkError=/failed to fetch|networkerror|load failed/i.test(message);
        this.setState({
          conv2ReviewLoading:false,
          conv2ReviewError:networkError
            ?'El servicio dejó de responder. Verifica que la aplicación siga activa y pulsa Reintentar.'
            :'No fue posible cargar la evidencia: '+message
        });
      });
  };
  confirmConv2Firmes = () => {
    if(this.state.conv2BulkBusy) return;
    const type=this.state.conv2ReviewType==='linea_transmision'
      ? 'linea_transmision'
      : 'subestacion';
    const label=type==='linea_transmision'
      ? 'líneas con dos extremos firmes'
      : 'subestaciones con evidencia firme';
    if(!window.confirm('Se registrarán únicamente '+label+' de proyectos vigentes y se conservará la trazabilidad. ¿Continuar?')){
      return;
    }
    this.setState({conv2BulkBusy:true,conv2ReviewError:''});
    fetch(
      '/DashboardProyectos/PamTerritorial/EvidenciaConvocatoria/Validaciones/ConfirmarCoincidenciasAutomaticas?tipoElemento='+encodeURIComponent(type),
      {
        method:'POST',
        cache:'no-store',
        headers:{
          'Accept':'application/json',
          'Cache-Control':'no-cache',
          'RequestVerificationToken':this.REPORT_CSRF
        }
      }
    )
      .then(async response=>{
        let payload=null;
        try{ payload=await response.json(); }catch(_){}
        if(!response.ok){
          const message=payload&&(payload.detail||payload.title);
          throw new Error(message||('HTTP '+response.status));
        }
        return payload;
      })
      .then(result=>{
        this.setState({conv2BulkBusy:false});
        this._toast(
          String(result.confirmadasNuevas||0)+' nuevas · '+
          String(result.omitidasConDecision||0)+' ya decididas · '+
          String(result.coincidenciasFirmes||0)+' firmes'
        );
        this.loadConv2Review();
      })
      .catch(error=>this.setState({
        conv2BulkBusy:false,
        conv2ReviewError:String(error.message||error)
      }));
  };
  _conv2StatusMeta(state){
    const key=String(state||'').toLowerCase();
    if(key==='catalogada') return {label:'Catalogada',color:'#0E735C',bg:'rgba(14,138,110,.12)'};
    if(key==='corredor_catalogado') return {label:'Corredor base',color:'#1E7188',bg:'rgba(30,156,184,.12)'};
    if(key==='revision') return {label:'Revisión',color:'#7A5D1D',bg:'rgba(224,161,46,.18)'};
    if(key==='faltante') return {label:'Faltante',color:'#9B2247',bg:'rgba(155,34,71,.11)'};
    if(key==='tramo_sin_geometria') return {label:'Sin geometría',color:'#9A3F27',bg:'rgba(192,85,46,.12)'};
    return {label:key||'Sin referencia',color:'#6F6B66',bg:'#F0ECE6'};
  }
  _conv2ValidationMeta(decision){
    const key=String(decision||'').toLowerCase();
    if(key==='confirmada') return {label:'Firme',color:'#0E735C',bg:'rgba(14,138,110,.12)'};
    if(key==='faltante_confirmada') return {label:'Faltante confirmada',color:'#7A5D1D',bg:'rgba(224,161,46,.18)'};
    if(key==='rechazada') return {label:'Rechazada',color:'#9B2247',bg:'rgba(155,34,71,.11)'};
    if(key==='pendiente') return {label:'Pendiente registrada',color:'#6F6B66',bg:'#F0ECE6'};
    return {label:'Pendiente humana',color:'#6F6B66',bg:'#F0ECE6'};
  }
  _conv2ValidationName(value){
    return this._norm(value)
      .replace(/^(?:cfe)?(?:se|subestacionelectrica)/,'');
  }
  _conv2ValidationMatchesCandidate(validation,candidate){
    if(!validation||!candidate) return false;
    const sameVoltage=validation.tensionKv==null||candidate.tensionKv==null||
      Math.abs(Number(validation.tensionKv)-Number(candidate.tensionKv))<=.11;
    const sameTerritory=
      this._norm(validation.entidad)===this._norm(candidate.entidad)&&
      this._norm(validation.gcr)===this._norm(candidate.gcr);
    const sameName=
      this._conv2ValidationName(validation.nombreDeclarado)===
      this._conv2ValidationName(candidate.nombreDeclarado);
    if(!sameVoltage||!sameTerritory||!sameName) return false;
    const decision=String(validation.decision||'').toLowerCase();
    if(decision==='confirmada'){
      return Boolean(candidate.claveCatalogo)&&
        String(validation.claveCatalogo||'')===String(candidate.claveCatalogo);
    }
    if(decision==='faltante_confirmada'){
      return !candidate.claveCatalogo;
    }
    return true;
  }
  openConv2Decision = (candidate,decision) => {
    const type=String(candidate&&candidate.tipoElemento||'');
    if(!candidate||(type!=='subestacion'&&type!=='linea_transmision')) return;
    this.setState({
      conv2DecisionTarget:candidate,
      conv2DecisionKind:decision,
      conv2DecisionNote:'',
      conv2DecisionError:''
    });
  };
  closeConv2Decision = () => {
    if(this.state.conv2DecisionBusy) return;
    this.setState({
      conv2DecisionTarget:null,
      conv2DecisionKind:'',
      conv2DecisionNote:'',
      conv2DecisionError:''
    });
  };
  saveConv2Decision = () => {
    const candidate=this.state.conv2DecisionTarget;
    const note=String(this.state.conv2DecisionNote||'').trim();
    if(!candidate||note.length<5||this.state.conv2DecisionBusy) return;
    this.setState({conv2DecisionBusy:true,conv2DecisionError:''});
    fetch('/DashboardProyectos/PamTerritorial/EvidenciaConvocatoria/Validaciones',{
      method:'POST',
      cache:'no-store',
      headers:{
        'Accept':'application/json',
        'Content-Type':'application/json',
        'Cache-Control':'no-cache',
        'RequestVerificationToken':this.REPORT_CSRF
      },
      body:JSON.stringify({
        candidatoId:candidate.candidatoId,
        tipoElemento:candidate.tipoElemento,
        decision:this.state.conv2DecisionKind,
        observacion:note
      })
    })
      .then(async response=>{
        let payload=null;
        try{ payload=await response.json(); }catch(_){}
        if(!response.ok){
          const message=payload&&(payload.detail||payload.title);
          throw new Error(message||('HTTP '+response.status));
        }
        return payload;
      })
      .then(async record=>{
        let current=(this.state.conv2ReviewValidations||[])
          .filter(item=>item.candidatoId!==record.candidatoId);
        current.push(record);
        try{
          const validationResponse=await fetch(
            '/DashboardProyectos/PamTerritorial/EvidenciaConvocatoria/Validaciones?ts='+Date.now(),
            {
              cache:'no-store',
              headers:{'Accept':'application/json','Cache-Control':'no-cache'}
            }
          );
          if(validationResponse.ok){
            const validationSnapshot=await validationResponse.json();
            if(Array.isArray(validationSnapshot.validaciones)){
              current=validationSnapshot.validaciones;
            }
          }
        }catch(_){}
        return current;
      })
      .then(current=>{
        this.setState({
          conv2ReviewValidations:current,
          conv2DecisionTarget:null,
          conv2DecisionKind:'',
          conv2DecisionNote:'',
          conv2DecisionBusy:false,
          conv2DecisionError:''
        });
        this._toast('Decisión registrada con trazabilidad');
      })
      .catch(error=>this.setState({
        conv2DecisionBusy:false,
        conv2DecisionError:String(error.message||error)
      }));
  };
  locateConv2Candidate = (candidate) => {
    const catalogGeometry=candidate&&candidate.geometria;
    const privateSubstationGeometry=candidate&&candidate.geometriaSubestacionPrivada;
    const publicInterconnectionGeometry=candidate&&candidate.geometriaInterconexionPublica;
    const topologyGeometry=candidate&&candidate.geometriaTopologicaSugerida;
    const projectSourceGeometry=candidate&&candidate.geometriaProyectoFuente;
    const substationSourceGeometry=candidate&&candidate.geometriaSubestacionFuente;
    if((!catalogGeometry&&!privateSubstationGeometry&&!publicInterconnectionGeometry&&!topologyGeometry&&!projectSourceGeometry&&!substationSourceGeometry) || !window.L || !this.map){
      this._toast('Este candidato todavía no tiene geometría para localizar');
      return;
    }
    try {
      if(this._conv2ReviewFocus){
        this.map.removeLayer(this._conv2ReviewFocus);
        this._conv2ReviewFocus=null;
      }
      this._conv2ReviewFocus=L.featureGroup().addTo(this.map);
      let privateLayer=null;
      let publicLayer=null;
      if(projectSourceGeometry){
        L.geoJSON({
          type:'Feature',
          geometry:projectSourceGeometry,
          properties:{}
        },{
          style:{color:'#6F6B66',weight:2,opacity:.8,fillColor:'#9A958E',fillOpacity:.08,dashArray:'3 6'},
          pointToLayer:(_,latlng)=>L.circleMarker(latlng,{
            radius:6,color:'#fff',weight:2,fillColor:'#6F6B66',fillOpacity:.9
          }),
          onEachFeature:(_,layer)=>layer.bindTooltip('Contexto del proyecto declarado · no representa el trazo físico de la LT')
        }).addTo(this._conv2ReviewFocus);
      }
      if(substationSourceGeometry){
        L.geoJSON({
          type:'Feature',
          geometry:substationSourceGeometry,
          properties:{}
        },{
          style:{color:'#A57F2C',weight:3,opacity:.95,fillColor:'#E0A12E',fillOpacity:.14,dashArray:'6 4'},
          pointToLayer:(_,latlng)=>L.circleMarker(latlng,{
            radius:8,color:'#fff',weight:3,fillColor:'#A57F2C',fillOpacity:1
          }),
          onEachFeature:(_,layer)=>layer.bindTooltip('Contexto de subestación declarado · no confirma el corredor de la LT')
        }).addTo(this._conv2ReviewFocus);
      }
      if(privateSubstationGeometry){
        privateLayer=L.geoJSON({
          type:'Feature',
          geometry:privateSubstationGeometry,
          properties:{}
        },{
          style:{color:'#E0A12E',weight:4,opacity:1,fillColor:'#E0A12E',fillOpacity:.2,dashArray:'7 5'},
          pointToLayer:(_,latlng)=>L.circleMarker(latlng,{
            radius:9,color:'#fff',weight:3,fillColor:'#E0A12E',fillOpacity:1
          }),
          onEachFeature:(_,layer)=>layer.bindTooltip('Subestación privada del proyecto · no es nodo CFE/CENACE')
        }).addTo(this._conv2ReviewFocus);
      }
      if(publicInterconnectionGeometry){
        publicLayer=L.geoJSON({
          type:'Feature',
          geometry:publicInterconnectionGeometry,
          properties:{}
        },{
          style:{color:'#0E735C',weight:4,opacity:1,fillColor:'#0E735C',fillOpacity:.16},
          pointToLayer:(_,latlng)=>L.circleMarker(latlng,{
            radius:8,color:'#fff',weight:3,fillColor:'#0E735C',fillOpacity:1
          }),
          onEachFeature:(_,layer)=>layer.bindTooltip('Nodo público de interconexión · catálogo GeoJSON')
        }).addTo(this._conv2ReviewFocus);
      }
      if(privateLayer&&publicLayer&&candidate.coincidenciaInterconexionPublicaFirme){
        const privateBounds=privateLayer.getBounds();
        const publicBounds=publicLayer.getBounds();
        if(privateBounds.isValid()&&publicBounds.isValid()){
          L.polyline(
            [privateBounds.getCenter(),publicBounds.getCenter()],
            {color:'#0E735C',weight:2,opacity:.9,dashArray:'4 7'}
          )
            .bindTooltip('Relación de interconexión declarada por la fuente · no representa el trazo físico de una línea')
            .addTo(this._conv2ReviewFocus);
        }
      }
      if(catalogGeometry){
        L.geoJSON({
          type:'Feature',
          geometry:catalogGeometry,
          properties:{}
        },{
          style:{color:'#9B2247',weight:4,opacity:1,fillColor:'#9B2247',fillOpacity:.12},
          pointToLayer:(_,latlng)=>L.circleMarker(latlng,{
            radius:7,color:'#fff',weight:3,fillColor:'#9B2247',fillOpacity:1
          }),
          onEachFeature:(_,layer)=>layer.bindTooltip('Punto del catálogo GeoJSON')
        }).addTo(this._conv2ReviewFocus);
      }
      if(topologyGeometry){
        L.geoJSON({
          type:'Feature',
          geometry:topologyGeometry,
          properties:{}
        },{
          style:{color:'#2D6A9F',weight:4,opacity:1,fillColor:'#2D6A9F',fillOpacity:.18,dashArray:'4 4'},
          pointToLayer:(_,latlng)=>L.circleMarker(latlng,{
            radius:8,color:'#fff',weight:3,fillColor:'#2D6A9F',fillOpacity:1
          }),
          onEachFeature:(_,layer)=>layer.bindTooltip('Extremo real de línea · nodo puntual faltante')
        }).addTo(this._conv2ReviewFocus);
      }
      const bounds=this._conv2ReviewFocus.getBounds();
      if(bounds&&bounds.isValid()) this.map.fitBounds(bounds.pad(.35),{animate:true,maxZoom:13});
      const meta=this._conv2StatusMeta(candidate.estado);
      const distanceMin=candidate.distanciaInterconexionCalculadaMinimaKm;
      const distanceMax=candidate.distanciaInterconexionCalculadaMaximaKm;
      const coordinateDistance=distanceMin!=null
        ? (Number(distanceMin).toFixed(3)+(distanceMax!=null&&Math.abs(Number(distanceMax)-Number(distanceMin))>.0005?'–'+Number(distanceMax).toFixed(3):'')+' km')
        : 'Sin distancia calculable';
      const isLineCandidate=String(candidate.tipoElemento||'')==='linea_transmision';
      const cfeAudit=candidate.auditoriaCfeRgd||null;
      const atlasAudit=candidate.auditoriaAtlasSen||null;
      const atlasReferences=atlasAudit
        ? (atlasAudit.matches||[]).slice(0,8).map(match=>
            [
              match.name,
              match.voltageKv!=null?Number(match.voltageKv).toLocaleString('es-MX')+' kV':null,
              this._networkLevelLabel(match.networkLevel),
              match.region,
              match.division
            ].filter(Boolean).join(' · ')
          ).join(' | ')
        : '';
      const cfeAuditLabel=!cfeAudit
        ? 'Sin auditoría'
        : cfeAudit.estado==='respaldada'
          ? 'Respaldo documental · requiere validación humana'
          : cfeAudit.estado==='revision'
            ? 'Coincidencia parcial · requiere revisión'
            : cfeAudit.estado==='territorio_incompatible'
              ? 'Homónimo descartado por territorio'
              : 'Sin coincidencia';
      const cfeBanks=cfeAudit
        ? (cfeAudit.coincidencias||[]).map(match=>
            [
              match.division,
              match.zona,
              match.subestacion,
              match.banco,
              Number(match.tensionAtKv).toLocaleString('es-MX')+'/'+
                Number(match.tensionMtKv).toLocaleString('es-MX')+' kV',
              'p. '+String(match.paginaFuente||'—')
            ].filter(Boolean).join(' · ')
          ).join(' | ')
        : '';
      const rows=[
        ['Estado de revisión',meta.label],
        ['Coincidencia de catálogo',candidate.coincidenciaCatalogo||'Sin coincidencia'],
        ['Subestación privada / propuesta',candidate.coincidenciaInterconexionPublicaFirme?'Sí · se conserva como instalación distinta':'—'],
        ['Interconexión pública declarada',candidate.nombreInterconexionPublica||'—'],
        ['Nodo público resuelto',candidate.coincidenciaInterconexionCatalogo||'—'],
        ['Clave del nodo público',candidate.claveInterconexionCatalogo||'—'],
        ['Distancia privada → nodo público',candidate.distanciaInterconexionPublicaKm!=null?Number(candidate.distanciaInterconexionPublicaKm).toFixed(3)+' km':'—'],
        ['Criterio privada / pública',candidate.coincidenciaInterconexionPublicaFirme?'Firme · campo de interconexión, GCR y tensión compatibles':'—'],
        ['Puntaje automático',String(candidate.puntaje||0)+' / 100'],
        ['Tensión',candidate.tensionKv!=null?Number(candidate.tensionKv).toLocaleString('es-MX')+' kV':'—'],
        ['Auditoría CFE RGD 2026',cfeAuditLabel],
        ['Bancos CFE RGD',cfeBanks||'—'],
        ['Hallazgos CFE RGD',cfeAudit?(cfeAudit.hallazgos||[]).join(' · ')||'—':'—'],
