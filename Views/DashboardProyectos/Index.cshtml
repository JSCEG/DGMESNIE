  mapRef = React.createRef();
  mainRef = React.createRef();
  REPORT_RECIPIENTS = Array.isArray(window.__reportDestinatarios) ? window.__reportDestinatarios : [];
  REPORT_CSRF = window.__reportCsrf || '';
