        let cnt = (key==='municipios') ? (this.muniFeatures?this.muniFeatures.length:0) : (this._genericCount && this._genericCount[key]!=null ? this._genericCount[key] : (geo.features||[]).length);
        if (key === 'podecobi') {
          const polosUnicos = new Set();
          (geo.features||[]).forEach(f => { const n = f.properties && (f.properties.Numero || f.properties.numero); if (n) polosUnicos.add(n); });
          cnt = polosUnicos.size || cnt;
        }
        if(key==='pam'&&geo.meta&&Number.isFinite(Number(geo.meta.proyectos))){
          cnt=Number(geo.meta.proyectos);
        }
        if(cfg.type==='graph'&&geo.meta){
          const graphCount=cfg.graphPart==='edges'?Number(geo.meta.edges):Number(geo.meta.nodes);
          if(Number.isFinite(graphCount)) cnt=graphCount;
        }
        if(cfg.atlasLayer&&geo.meta&&Number.isFinite(Number(geo.meta.features))){
          cnt=Number(geo.meta.features);
        }
        const l2 = { ...this.state.layers }; l2[key] = { ...l2[key], loading:false, count:cnt };
