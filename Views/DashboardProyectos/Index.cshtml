    doc.setTextColor(28,27,26); doc.setFontSize(23); doc.text('Dashboard de Planeación Energética', M, 72);
    doc.setTextColor(111,107,102); doc.setFont('helvetica','normal'); doc.setFontSize(10); doc.text(this._stamp(), W-M, 42, { align:'right' });
