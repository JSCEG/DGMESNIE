      source:'CENACE · actualización '+(data.updatedAt?new Date(data.updatedAt).toLocaleString('es-MX'):'en vivo')+
        (hasTemperature?' · clima Open-Meteo, punto representativo de '+region:'')
    };
  }
  _atlasLayerColor(cfg,p){
    const scale=cfg&&cfg.scale;
    if(scale==='demand'){
      const raw=p&&p.demand_mw;
      const value=raw==null||raw===''?NaN:Number(raw);
      if(!Number.isFinite(value)) return '#C7C2BA';
      if(value<2000) return '#D9EFF5';
      if(value<4000) return '#83C5D2';
      if(value<6500) return '#2D9AB3';
      if(value<9000) return '#2E6FB0';
      return '#9B2247';
    }
    if(scale==='tariff-category'){
      return this._tariffMetricColor(p,this.state.marketMetric);
    }
    if(scale==='distributed-generation'){
      const raw=p&&p.dg_mw;
      const value=raw==null||raw===''?NaN:Number(raw);
      if(!Number.isFinite(value)) return '#D8D3CC';
      if(value<50) return '#D8F3DC';
      if(value<100) return '#95D5B2';
      if(value<200) return '#52B788';
      if(value<400) return '#2D6A4F';
      return '#0B3D2E';
    }
    return (cfg&&cfg.color)||'#9B2247';
  }
  // Constructor GENÉRICO multi-geometría (punto / línea / polígono) — para cualquier GeoJSON del inventario
  _buildGeneric(key, geo, cfg, options) {
    // Construye cada feature DIRECTAMENTE (igual que subestaciones) y la agrega al grupo.
    // Evita el wrapper L.geoJSON, que con renderer canvas dejaba los circleMarker sin dibujar.
    const renderEnabled=!options||options.render!==false;
    const L = window.L; const g = this.groups[key]; g.clearLayers(); const color = cfg.color;
    const feats = this._normFeatures(geo);
    const tariffScale=key==='tarifas_atlas'
      ?this._tariffMetricScaleFromFeatures(feats,this.state.marketMetric)
      :null;
    const featureColor=p=>tariffScale
      ?this._tariffMetricColor(p,this.state.marketMetric,tariffScale)
      :this._atlasLayerColor(cfg,p);
    const guard = (lyr) => this._guardPath(lyr);
    const clustered=this._isClusterLayerKey(key)&&typeof g.addLayers==='function';
    const pendingMarkers=[];
    const bind = (lyr, p, location) => {
      guard(lyr);
      const nom = this._featName(p) || cfg.label;
      lyr.bindTooltip(String(nom), { sticky:true });
      if(this.ENERGY_PERMIT_KEYS.includes(key)){
        lyr.bindPopup(this._energyPermitPopup(cfg,p,nom,location),{maxWidth:370,minWidth:270});
      }else if(cfg.type==='pam'){
        lyr.bindPopup(this._pamPopup(cfg,p,nom),{maxWidth:390,minWidth:285});
      }
      lyr.on('click', event => {
        if(this.ENERGY_PERMIT_KEYS.includes(key)||cfg.type==='pam'){
          try { lyr.openPopup(); } catch(error){}
          try { if(event&&event.originalEvent) L.DomEvent.stopPropagation(event.originalEvent); } catch(error){}
        }
        if(cfg.atlasLayer){
          try { if(event&&event.originalEvent) L.DomEvent.stopPropagation(event.originalEvent); } catch(error){}
        }
        this._selectGeneric(cfg, p, nom, location);
      });
      if(clustered&&lyr instanceof L.Marker) pendingMarkers.push(lyr);
      else g.addLayer(lyr);
    };
    // Normaliza features: lista plana de {geometry, properties} desde FeatureCollection,
    // GeometryCollection, Feature suelto o geometría cruda (incl. GeometryCollection anidada).
    // Registro para el BUSCADOR: una entrada por feature con su coordenada representativa,
    // para que las capas del inventario (ANP, presas, lenguas, sitios, etc.) sean buscables
    // y un clic en la sugerencia centre el mapa y abra la misma ficha que un clic directo.
    const reg = ((this._genericFeats = this._genericFeats || {})[key] = []);
    const rep = (gm) => { // primera coordenada [lat,lng] de cualquier geometría
      if (!gm) return null;
      if (gm.type === 'GeometryCollection') { for (const s of (gm.geometries || [])) { const r = rep(s); if (r) return r; } return null; }
      let c = gm.coordinates; while (Array.isArray(c) && Array.isArray(c[0])) c = c[0];
      return (Array.isArray(c) && isFinite(c[0]) && isFinite(c[1])) ? [c[1], c[0]] : null;
    };
    feats.forEach(f => { try { const ll = rep(f.geometry); if (ll) reg.push({ nom: this._featName(f.properties || {}) || cfg.label, lat: ll[0], lng: ll[1], props: f.properties || {}, geometry:f.geometry }); } catch(e){} });
    // Conteo de puntos para decidir el modo de dibujo
    let pointCount = 0; feats.forEach(f => { const t=f.geometry&&f.geometry.type; if(t==='Point') pointCount++; else if(t==='MultiPoint') pointCount+=f.geometry.coordinates.length; });
    // Pocos puntos → marcadores DOM (ícono lindo); miles → circleMarker en canvas; decenas de miles
    // → nube en un solo canvas propio (ver _makePointCloud)
    const byTech = (cfg.key === 'centrales'||cfg.assetKind==='generation');
    const byPermit = this.ENERGY_PERMIT_KEYS.includes(key);
    const byPam = cfg.type === 'pam';
    // La capa nacional de generación se dibuja como puntos Canvas individuales: mantiene
    // visibles las 1,000+ ubicaciones sin convertir el mapa en bloques de agrupación.
    const lightweightPermitPoints = byPermit && cfg.noCluster;
    const domPoints = byTech || (byPermit&&!lightweightPermitPoints) || byPam || pointCount <= (cfg.compactPoints ? 250 : 1200);
    const useCloud = !domPoints && pointCount > 3000;
    if(!renderEnabled){
      const count=this._countGenericFeatures(geo);
      this._genericCount = this._genericCount || {}; this._genericCount[key] = count;
      this._vectorPathLayers = this._vectorPathLayers || {}; this._vectorPathLayers[key] = false;
      return count;
    }
    const dot = this._dotIcon(color);
    const cloudPts = useCloud ? [] : null;
    const addPoint = (lat, lng, p) => {
      if (!isFinite(lat) || !isFinite(lng)) return;
      const pointColor=featureColor(p);
      if (domPoints) {
        const icon=byTech
          ?this._techIcon(this._centralTech(p))
          :byPermit?this._energyPermitIcon(key,p)
          :byPam?this._pamIcon(p):(cfg.scale?this._dotIcon(pointColor):dot);
        bind(L.marker([lat, lng], {
          icon,
          pane:byPermit?'permits':(byPam?'pam':'markerPane'),
          riseOnHover:true,
          bubblingMouseEvents:!(byPermit||byPam)
        }), p, [lat,lng]);
      }
      else if (useCloud) { cloudPts.push({ lat, lng, props:p }); }
      else { bind(L.circleMarker([lat, lng], { radius:lightweightPermitPoints?2.7:3.4, color:'#fff', weight:.8, fillColor:pointColor, fillOpacity:.9, renderer:this._dataRenderer, pane:'data' }), p); }
    };
    // Sanitiza coords [lng,lat(,z)] → [lat,lng] válido; descarta pares no finitos
    const line = (coords) => (coords||[]).map(c => Array.isArray(c) && isFinite(c[0]) && isFinite(c[1]) ? [c[1], c[0]] : null).filter(Boolean);
    const ring = (rings) => (rings||[]).map(line).filter(r => r.length >= 3);
    // Líneas/polígonos → renderer SVG añadido al mapa (z449): _bounds siempre vigente, append fiable.
    const R = this._svgRenderer;
    let n = 0, sawVectorPath = false;
    const draw = (gm, p) => {
      if (!gm) return; const t = gm.type;
      if (t === 'Point') { const c=gm.coordinates||[]; addPoint(c[1], c[0], p); n++; }
      else if (t === 'MultiPoint') { (gm.coordinates||[]).forEach(c => { addPoint(c[1], c[0], p); n++; }); }
      else if (t === 'LineString') { const ll=line(gm.coordinates); if(ll.length>=2){ const c=featureColor(p); bind(L.polygon(ll, { color:c, weight:2.6, opacity:.95, fill:false, fillOpacity:0, renderer:R, noClip:true, smoothFactor:0 }), p); n++; sawVectorPath=true; } }
      else if (t === 'MultiLineString') { (gm.coordinates||[]).forEach(seg => { const ll=line(seg); if(ll.length>=2){ const c=featureColor(p); bind(L.polygon(ll, { color:c, weight:2.6, opacity:.95, fill:false, fillOpacity:0, renderer:R, noClip:true, smoothFactor:0 }), p); n++; sawVectorPath=true; } }); }
      else if (t === 'Polygon') { const rr=ring(gm.coordinates); if(rr.length){ const c=featureColor(p); bind(L.polygon(rr, { color:c, weight:1.2, fillColor:c, fillOpacity:cfg.scale ? .52 : .32, renderer:R, noClip:true, smoothFactor:0 }), p); n++; sawVectorPath=true; } }
      else if (t === 'MultiPolygon') { (gm.coordinates||[]).forEach(poly => { const rr=ring(poly); if(rr.length){ const c=featureColor(p); bind(L.polygon(rr, { color:c, weight:1.2, fillColor:c, fillOpacity:cfg.scale ? .52 : .32, renderer:R, noClip:true, smoothFactor:0 }), p); n++; sawVectorPath=true; } }); }
      else if (t === 'GeometryCollection') { (gm.geometries||[]).forEach(sub => draw(sub, p)); }
    };
    feats.forEach(f => { try { draw(f.geometry, f.properties || {}); } catch(e){} });
    if(pendingMarkers.length) g.addLayers(pendingMarkers);
    if (useCloud && cloudPts.length) {
      const cloud = this._makePointCloud(cloudPts, color, (pt) => { const nom = this._featName(pt.props) || cfg.label; this._selectGeneric(cfg, pt.props, nom, [pt.lat,pt.lng]); });
      g.addLayer(cloud);
    }
    this._genericCount = this._genericCount || {}; this._genericCount[key] = n;
    // Sólo las capas con trazos SVG (líneas/polígonos) necesitan el redibujo forzado de
    // _forceVectorRedraw (para refrescar los bounds del renderer SVG compartido). Las capas de
    // sólo-puntos (círculos/íconos, a veces decenas de miles) usan el renderer/pane por defecto
    // de Leaflet, que ya se mantiene al día solo — forzar su remove/add en cascada (x3 al cargar)
    // es innecesario y, con datasets grandes (p.ej. Lenguas indígenas · 41,903 puntos), puede
    // colgar o abortar el pintado a medio camino, dejando la capa "activa" pero invisible.
    this._vectorPathLayers = this._vectorPathLayers || {};
    this._vectorPathLayers[key] = sawVectorPath;
    if(key==='tarifas_atlas'&&this.state.marketMode==='consumption'&&
      this.state.marketDivision){
      window.setTimeout(()=>{
        this._highlightTariffDivision(this.state.marketDivision,false);
        this._scheduleTariffViewportFit(this.state.marketDivision);
      },0);
    }
    if(key==='generacion_distribuida_atlas'&&
      this.state.marketMode==='distributed'&&this.state.marketDistributedState){
      window.setTimeout(()=>{
        this._highlightDistributedGenerationState(
          this.state.marketDistributedState,
          false
        );
      },0);
    }
    return n;
  }
  // Normaliza cualquier GeoJSON a lista plana de {geometry, properties}
  _normFeatures(geo){
    if (!geo) return [];
    if (geo.type === 'FeatureCollection') return (geo.features||[]).map(f => ({ geometry:f.geometry, properties:f.properties||{} }));
    if (geo.type === 'GeometryCollection') return (geo.geometries||[]).map(g => ({ geometry:g, properties:{} }));
    if (geo.type === 'Feature') return [{ geometry:geo.geometry, properties:geo.properties||{} }];
    if (geo.type && geo.coordinates) return [{ geometry:geo, properties:{} }]; // geometría cruda
    if (Array.isArray(geo.features)) return geo.features.map(f => ({ geometry:f.geometry, properties:f.properties||{} }));
    return [];
  }
  // Re-dibuja todas las capas 'geo' activas (vectores en canvas) tras un cambio de vista
  _redrawActiveVectors(){
    if (!this._built) return;
    this.LAYERS.forEach(cfg => { if (cfg.type==='geo' && this._built[cfg.key] && this.state.layers[cfg.key] && this.state.layers[cfg.key].on) this._forceVectorRedraw(cfg.key); });
  }
  // Encuadra el mapa a la extensión de una capa (para que el usuario vea los datos al activarla)
  _fitToLayer(key){
    const g = this.groups[key]; if (!g) return;
    try {
      const fg = window.L.featureGroup(g.getLayers().filter(l => l.getBounds || l.getLatLng));
      const b = fg.getBounds();
      if (b && b.isValid()) this.map.fitBounds(b.pad(0.15), { maxZoom: 12, animate: true });
    } catch(e){}
  }
  // Fuerza el redibujo de los renderers canvas usados por una capa vectorial recién agregada
  _forceVectorRedraw(key){
    // Sólo aplica a capas con trazos en el renderer SVG compartido (líneas/polígonos). Las capas
    // de sólo-puntos no lo necesitan (ver nota en _buildGeneric) y, si son muy grandes, el
    // remove/add en cascada puede colgar el hilo principal o abortar el pintado — se omite.
    if (this._vectorPathLayers && this._vectorPathLayers[key] === false) return;
    // Re-añade el grupo cuando el mapa está estable: re-ejecuta el ciclo onAdd→_reset de cada
    // vector en un momento con _bounds vigente, que es lo que faltaba en la adición diferida.
    const obj = this._layerOf(key); if (!obj || !this.map) return;
    this.map.whenReady(() => requestAnimationFrame(() => {
      try { if (this.state.layers[key] && this.state.layers[key].on) { this.map.removeLayer(obj); obj.addTo(this.map); } } catch(e){}
    }));
  }
  _dotIcon(color){
    const L = window.L;
    // SVG (no CSS puro): _captureMap sólo puede reconstruir íconos con contenido vectorial;
    // un <span> con border-radius no deja rastro capturable y desaparecía en PDF/PNG.
    return L.divIcon({ className:'', iconSize:[14,14], iconAnchor:[7,7], popupAnchor:[0,-7],
      html:'<svg width="14" height="14" viewBox="0 0 14 14" style="filter:drop-shadow(0 1px 2.5px rgba(0,0,0,.4))"><circle cx="7" cy="7" r="6" fill="'+color+'" stroke="#fff" stroke-width="2"/></svg>' });
  }
  _pamIcon(p){
    const L=window.L;
    const regional=!!(p&&(p.esUbicacionRegional||p.EsUbicacionRegional));
    const type=String((p&&p.tipoProyecto)||'').toLowerCase();
    const color=regional?'#B47712':type.includes('modern')?'#6B3654':type.includes('ampl')?'#9B2247':'#7E3B52';
    const html='<svg width="32" height="38" viewBox="0 0 32 38" style="filter:drop-shadow(0 3px 4px rgba(0,0,0,.32))">'
      +'<path d="M16 1.5 29 9v15L16 36.5 3 24V9z" fill="#fff" stroke="'+color+'" stroke-width="2"/>'
      +'<path d="M16 5 25.5 10.5v11L16 31 6.5 21.5v-11z" fill="'+color+'"'+(regional?' fill-opacity=".88" stroke="#fff" stroke-width="1.2" stroke-dasharray="2 2"':'')+'/>'
      +(regional
        ?'<text x="16" y="22" text-anchor="middle" font-family="Arial,sans-serif" font-size="10" font-weight="800" fill="#fff">GCR</text>'
        :'<path d="m17.4 8-6 10h4.3l-1 7 6-10h-4.2z" fill="#fff"/>')
      +'</svg>';
    return L.divIcon({className:'',html,iconSize:[32,38],iconAnchor:[16,34],popupAnchor:[0,-31]});
  }
  _pamPopup(cfg,p,nom){
    const esc=value=>this._escapeMapHtml(value);
    const item=this._pamItemFromProperties(p);
    const projectId=Number(item.proyectoId||0);
    const key=item.claveProyecto||'Sin clave';
    const locationLabel=p.etiquetaUbicacion||p.EtiquetaUbicacion||'Ubicación principal';
    const regional=!!(p.esUbicacionRegional||p.EsUbicacionRegional);
    const suggested=!!(p.esAsociacionSugerida||p.EsAsociacionSugerida);
    const score=p.puntajeCoincidencia??p.PuntajeCoincidencia;
    const precision=regional
      ?'Regional aproximada por GCR · no es una coordenada oficial'
      :suggested
      ?'Asociación de red · pendiente de validación'
      :(p.precisionUbicacion||p.PrecisionUbicacion||'validada');
    const fichaUrl=item.fichaUrl||p.fichaUrl||p.FichaUrl||'';
    const ficha=fichaUrl
      ?'<a href="'+esc(fichaUrl)+'" target="_blank" rel="noopener" style="display:flex;justify-content:space-between;align-items:center;padding:9px 11px;border-radius:6px;background:#6B3654;color:#fff;text-decoration:none;font-size:10px;font-weight:800;letter-spacing:.04em">Abrir ficha PAM completa <span aria-hidden="true">↗</span></a>'
      :'';
    const analyze=projectId>0
      ?'<button type="button" onclick="window.__dgPamAnalyze&&window.__dgPamAnalyze('+projectId+')" style="width:100%;margin-top:7px;padding:8px 11px;border:1px solid #6B3654;border-radius:6px;background:#fff;color:#6B3654;font-family:inherit;font-size:10px;font-weight:800;cursor:pointer">Analizar entorno del proyecto</button>'
      :'';
    return '<div style="font-family:Noto Sans,sans-serif;min-width:265px">'
      +'<div style="font-size:9px;font-weight:800;letter-spacing:.12em;text-transform:uppercase;color:#6B3654;margin-bottom:5px">PAM / PAMRNT · '+esc(key)+'</div>'
      +'<div style="font-family:Newsreader,serif;font-size:17px;font-weight:800;line-height:1.1;color:#1C1B1A;margin-bottom:8px">'+esc(item.nombreProyecto||nom||cfg.label)+'</div>'
      +'<div style="display:grid;grid-template-columns:92px 1fr;gap:4px 8px;font-size:11px;line-height:1.35;margin-bottom:10px">'
      +'<span style="color:#77716B">GCR</span><strong>'+esc(item.gcr||'—')+'</strong>'
      +'<span style="color:#77716B">Tipo</span><span>'+esc(item.tipoProyecto||'—')+'</span>'
      +'<span style="color:#77716B">Etapa</span><span>'+esc(item.etapaProyecto||'—')+'</span>'
      +'<span style="color:#77716B">Elemento</span><span>'+esc(locationLabel)+'</span>'
      +'<span style="color:#77716B">Precisión</span><strong>'+esc(precision)+'</strong>'
      +(score!=null?'<span style="color:#77716B">Confianza</span><strong>'+esc(score)+'/100</strong>':'')
      +'</div>'
      +(regional?'<div style="margin:-2px 0 9px;padding:7px 8px;border-left:3px solid #E0A12E;background:#FFF8EA;color:#6F5320;font-size:10px;line-height:1.35">El icono representa la cobertura regional del proyecto. El análisis usa el polígono GCR con buffer 0.</div>':'')
      +ficha+analyze+'</div>';
  }
  // Convierte un valor de URL relativo/absoluto a URL canónica del origen de la app.
  // - Soporta https, rutas relativas con /, rutas sin protocolo que empiezan por //
  // - Descarta esquemas no navegables (javascript:, data:)
  _toAbsoluteUrl(u){
    if (!u) return '';
    const s = String(u).trim();
    if (!s || s === '—') return '';
    if (/^(javascript:|data:)/i.test(s)) return '';
    if (/^https?:\/\//i.test(s)) return s;
    if (s.startsWith('//')) return window.location.protocol + s;
    if (s.startsWith('/')) return window.location.origin + s;
    if (/^www\./i.test(s)) return 'https://' + s;
    return '';
  }
  // Acorta una URL para mostrar en el panel de detalle (sin perder el destino).
  // - Quita protocolo, www., query y hash cuando ya hay un dominio limpio.
  // - Trunca el path si excede N caracteres (conserva inicio/fin).
  _urlLabel(u, maxLen = 36){
    if (!u) return '';
    const absoluteUrl = this._toAbsoluteUrl(u);
    if (!absoluteUrl) return '';
    let s = absoluteUrl.replace(/^https?:\/\//i, '').replace(/^www\./i, '');
    try { const uo = new URL(absoluteUrl); s = uo.host.replace(/^www\./i,'') + (uo.pathname && uo.pathname !== '/' ? uo.pathname : ''); } catch(_) {}
    if (s.length > maxLen) {
      const head = Math.ceil((maxLen - 1) / 2);
      const tail = Math.floor((maxLen - 1) / 2);
      s = s.slice(0, head) + '…' + s.slice(s.length - tail);
    }
    return s;
  }

  _featureFichaUrl(cfg, p){
    if (!p) return '';
    const candidates = [
      'ficha',
      'fichaUrl',
      'ficha_url',
      'ficha_url_path',
      'fichaLink',
      'ficha_link',
      'ficha_pdf',
      'link',
      'linkUrl',
      'link_url',
      'linkPath',
      'url',
      'detailUrl',
      'detail_url',
      'urlDetalle',
      'url_detalle',
      'enlace',
      'enlaceFicha',
      'enlace_ficha',
      'documento',
      'documentoUrl',
      'documento_url',
      'url_pdf'
    ];
    const seen = new Set();
    for (const key of candidates){
      const direct = this._toAbsoluteUrl(p[key]);
      if (direct && !seen.has(direct)) return direct;
      if (direct) seen.add(direct);
      const altKey = key
        .replace(/^([a-z])/, c => c.toUpperCase())
        .replace(/_([a-z])/gi, (_, c) => c.toUpperCase());
      if (altKey !== key){
        const altUrl = this._toAbsoluteUrl(p[altKey]);
        if (altUrl && !seen.has(altUrl)) return altUrl;
        if (altUrl) seen.add(altUrl);
      }
    }
    const fichaField = Object.keys(p).find(k => /(?:ficha|enlace|link|documento|url)/i.test(k));
    if (!fichaField) return '';
    const fallback = this._toAbsoluteUrl(p[fichaField]);
    return fallback && !seen.has(fallback) ? fallback : '';
  }

  _featName(p){
    // Caso lenguas/localidades indígenas: VARIANTE (nombre de la lengua) + NOM_LOC (localidad)
    const va = p.VARIANTE || p.variante || p.Variante;
    if (va && String(va).trim()) { const loc = p.NOM_LOC || p.nom_loc; return String(va).trim() + (loc ? ' · ' + String(loc).trim() : ''); }
    const isNum = (v) => /^[\d.,\s-]+$/.test(String(v).trim());
    // 0ª pasada: claves que SON el nombre (evita que ID_ANP gane sobre NOMBRE)
    for(const k in p){ if(/^(nombre|name|nomgeo|nom_anp|denominaci|titulo)/i.test(k) && p[k]!=null && String(p[k]).trim() && !isNum(p[k])) return String(p[k]); }
    // 1ª pasada: claves con pinta de nombre y valor NO puramente numérico (sin claves de id: ID_ANP, CVE…)
    for(const k in p){ if(/nombre|nomgeo|name|titulo|descrip|localidad|denomin|lengua|variante|sitio|presa|central|pueblo/i.test(k) && !/^(id|cve|clave|num)/i.test(k) && p[k]!=null && String(p[k]).trim() && !isNum(p[k])) return String(p[k]); }
    // 2ª pasada: claves/códigos alfanuméricos (clave de permiso, etc.)
    for(const k in p){ if(/clave|nom_loc|nom_ent|nom_mun/i.test(k) && p[k]!=null && String(p[k]).trim()) return String(p[k]); }
    // Fallback: primer valor de texto no numérico; si no hay, el primero que exista
    const vals = Object.values(p).filter(x=>x!=null&&String(x).trim());
    const txt = vals.find(x=>!isNum(x));
    return txt!=null ? String(txt) : (vals.length ? String(vals[0]) : '');
  }
  _escapeMapHtml(value){
    return String(value==null?'':value)
      .replace(/&/g,'&amp;')
      .replace(/</g,'&lt;')
      .replace(/>/g,'&gt;')
      .replace(/"/g,'&quot;')
      .replace(/'/g,'&#39;');
  }
  _permitValue(p,camel,pascal){
    return p&&p[camel]!=null?p[camel]:(p&&p[pascal]!=null?p[pascal]:null);
  }
  _energyPermitCapacity(p){
    const capacity=this._permitValue(p,'capacidad','Capacidad');
    const unit=this._permitValue(p,'unidadCapacidad','UnidadCapacidad')||'';
    const capacityText=this._permitValue(p,'capacidadTexto','CapacidadTexto')||'';
    if(capacity!=null&&Number.isFinite(Number(capacity))){
      return Number(capacity).toLocaleString('es-MX',{maximumFractionDigits:2})+(unit?' '+unit:'');
    }
    return capacityText||'—';
  }
