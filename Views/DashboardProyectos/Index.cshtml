  async _filterByAnalysisAsync(geo,A,context,signal,onProgress){
    const features=this._normFeatures(geo);
    const selected=[];
    const chunkSize=500;
    for(let offset=0;offset<features.length;offset+=chunkSize){
      if(signal&&signal.aborted){ const error=new Error('Análisis cancelado'); error.name='AbortError'; throw error; }
      const chunk=features.slice(offset,offset+chunkSize);
      if(A&&A.analysisGeometry){
        chunk.forEach(feature=>{
          const candidate={type:'Feature',properties:feature.properties||{},geometry:feature.geometry};
          if(this._analysisFeatureIntersects(A,candidate,context)) selected.push(feature);
        });
      }else{
        const filtered=this._filterByRadius({type:'FeatureCollection',features:chunk},A.lat,A.lng,A.radiusKm);
        selected.push(...(filtered.features||[]));
      }
      if(onProgress) onProgress(Math.min(1,(offset+chunk.length)/Math.max(1,features.length)));
      if(offset+chunk.length<features.length) await new Promise(resolve=>setTimeout(resolve,0));
    }
    return {type:'FeatureCollection',features:selected};
  }
  _analysisFeatureOverlapsArea(A,feature){
    if(!A||!A.analysisGeometry) return this._analysisFeatureIntersects(A,feature);
    const T=window.turf;
    if(!T||!feature||!feature.geometry) return false;
    const candidateType=feature.geometry.type;
    if(candidateType!=='Polygon'&&candidateType!=='MultiPolygon'){
      return this._analysisFeatureIntersects(A,feature);
    }
    try{
      const prepared=this._prepareAnalysisContext(A);
      if(prepared&&!this._analysisBboxIntersects(feature,prepared.bbox)) return false;
      const coverage=(prepared&&prepared.polygons)||this._analysisPolygonFeatures(A);
      const candidates=(T.flatten({type:'FeatureCollection',features:[feature]}).features||[])
        .filter(item=>item&&item.geometry&&item.geometry.type==='Polygon');
      return coverage.some(areaFeature=>candidates.some(candidate=>{
        let overlap=null;
        try{ overlap=T.intersect(candidate,areaFeature); }
        catch(firstError){
          try{ overlap=T.intersect(T.featureCollection([candidate,areaFeature])); }catch(secondError){}
        }
        return overlap&&T.area(overlap)>1000;
      }));
    }catch(e){ return false; }
  }
  _analysisAreaKm2(A){
    if(!A) return null;
