  }
  _tariffMetricDefinition(metric){
    return this.TARIFF_METRIC_DEFINITIONS[metric]||
      this.TARIFF_METRIC_DEFINITIONS.energy;
  }
  _tariffMetricValue(properties,metric){
    const p=properties||{};
    const users=Number(p.users_total);
    const energy=Number(p.energy_gwh);
    if(metric==='users') return Number.isFinite(users)?users:NaN;
    if(metric==='intensity'){
      return Number.isFinite(users)&&users>0&&Number.isFinite(energy)
        ?energy*1000000/users
        :NaN;
    }
    return Number.isFinite(energy)?energy:NaN;
  }
  _tariffMetricScaleFromFeatures(features,metric){
    const values=(features||[])
      .map(feature=>this._tariffMetricValue(
        (feature&&feature.properties)||(feature&&feature.props)||{},
        metric
      ))
      .filter(Number.isFinite)
      .sort((a,b)=>a-b);
    const quantile=fraction=>{
      if(!values.length) return NaN;
      const position=(values.length-1)*fraction;
      const lower=Math.floor(position),upper=Math.ceil(position);
      if(lower===upper) return values[lower];
      return values[lower]+(values[upper]-values[lower])*(position-lower);
    };
    return {
      metric,
      definition:this._tariffMetricDefinition(metric),
      values,
      breaks:[.2,.4,.6,.8].map(quantile)
    };
  }
  _tariffMetricColor(properties,metric,scale){
    const resolved=scale||this._tariffMetricScaleFromFeatures(
      (this._genericFeats&&this._genericFeats.tarifas_atlas)||[],
      metric||this.state.marketMetric
    );
    const value=this._tariffMetricValue(properties,metric||resolved.metric);
    if(!Number.isFinite(value)) return '#D8D3CC';
    const index=(resolved.breaks||[]).findIndex(limit=>value<=limit);
    const palette=(resolved.definition||this._tariffMetricDefinition(metric)).palette;
    return palette[index<0?palette.length-1:index];
  }
  _tariffMetricLegend(metric,features){
    const scale=this._tariffMetricScaleFromFeatures(
      features||((this._genericFeats&&this._genericFeats.tarifas_atlas)||[]),
      metric||this.state.marketMetric
    );
    if(!scale.values.length) return [];
    const definition=scale.definition;
    const format=value=>Number(value).toLocaleString('es-MX',{
      maximumFractionDigits:metric==='users'?0:1
    });
    const edges=[scale.values[0],...scale.breaks,scale.values[scale.values.length-1]];
    return definition.palette.map((color,index)=>({
      color,
      label:index===0
        ?'Hasta '+format(edges[1])+' '+definition.unit
        :(index===definition.palette.length-1
          ?'Más de '+format(edges[index])+' '+definition.unit
          :format(edges[index])+'–'+format(edges[index+1])+' '+definition.unit)
    }));
  }
