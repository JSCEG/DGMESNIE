      // panel de detalle en vez del detalle de un solo punto.
      const sumRows = okKeys.map(k => { const cfg = this.LAYERS.find(c=>c.key===k) || {}; const ct=layers[k].count||0; const nr=layers[k].nearest; return [cfg.label||k, ct>0 ? ct.toLocaleString('es-MX') : (nr ? '0 · a '+Math.round(nr)+' km el más cercano' : '0')]; });
