    });
  };

  // Contraportada del reporte territorial, homologada con el cierre de las fichas PAM.
  _pdfReportBack = (doc, W, H, landscape, report) => {
    const burgundy=[155,34,71], gold=[201,162,75], ink=[28,27,26], gray=[111,107,102], line=[224,220,212];
    const pad=landscape?52:44;
