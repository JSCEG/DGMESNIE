  }
  // Municipios usa pane dedicado (visibilidad); el resto son grupos normales
  _layerOf(key){ return key==='municipios' ? this.muniLyr : this.groups[key]; }
  _muniPaneShow(show){ const p = this.map.getPane('muni'); if (p) p.style.display = show ? '' : 'none'; }
  // Blinda el dibujo de CUALQUIER capa vectorial (canvas compartido): si un trazo falla al
  // proyectarse, no debe abortar el redibujo de TODAS las demás capas que comparten el mismo
  // renderer por defecto de Leaflet — un solo trazo roto puede, si no se blinda, dejar capas
