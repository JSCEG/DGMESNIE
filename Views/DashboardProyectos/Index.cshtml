        <button onClick="{{ onDatasetsMenuToggle }}" style="display:flex;align-items:center;gap:8px;width:100%;padding:9px 12px;border:1px solid #1E9CB8;background:rgba(30,156,184,.06);color:#1E9CB8;border-radius:8px;font-size:12px;font-weight:700;cursor:pointer;justify-content:center;margin-bottom:2px" style-hover="background:rgba(30,156,184,.14)">
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><ellipse cx="12" cy="5" rx="8" ry="3"></ellipse><path d="M4 5v14c0 1.7 3.6 3 8 3s8-1.3 8-3V5"></path><path d="M4 12c0 1.7 3.6 3 8 3s8-1.3 8-3"></path></svg>
