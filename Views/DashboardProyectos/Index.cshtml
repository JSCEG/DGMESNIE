  // ════════════════════ filtros / búsqueda ════════════════════
  onSearchInput = (e) => this.setState({ search:e.target.value });
  onSearchKey = (e) => {
    if (e.key==='Enter') { const q=this._norm(this.state.search); if(!q) return; const m=this._searchIndex().filter(x=>x.n.includes(q))[0]; if(m){ m.go(); this.setState({ search:'' }); this._anaFromSearch(m); } else this._searchAddress(this.state.search.trim()); }
    else if (e.key==='Escape') this.setState({ search:'' });
  };
  // Índice de búsqueda flexible — depende de las CAPAS y DATASETS activos
  _invalidateSearch(){ this._searchCache = null; }
  _searchIndex(){
    if (this._searchCache) return this._searchCache;
    const out=[]; const L=this.state.layers;
    // El catálogo de capas también es buscable aunque la capa esté apagada. Así
    // "Polos de Desarrollo (PODECOBI)" y las demás fuentes pueden activarse
    // directamente desde el autocompletado.
    this.LAYERS.forEach(cfg => {
      if(cfg.hidden) return;
      const aliases = cfg.key==='podecobi' ? ' polos polo desarrollo podecobi '
        :cfg.key==='pam'?' pam pamrnt proyectos ampliacion modernizacion ':' ';
      out.push({
        label:cfg.label,
        kind:cfg.cat+' · '+(L[cfg.key].on?'capa activa':'activar capa'),
        color:cfg.color,
        n:this._norm(cfg.label+' '+cfg.cat+' '+cfg.code+aliases),
        ll:null,
        go:()=>{
          if (!this.state.layers[cfg.key].on) this.toggleLayer(cfg.key);
          else if (this._built[cfg.key]) { try { this._fitToLayer(cfg.key); } catch(e){} }
        }
      });
    });
    (this.state.pamCatalog||[]).forEach(item=>{
      const option=this._pamShortcutOption(item);
      if(!option) return;
      const key=item.claveProyecto||('PAM '+item.proyectoId);
      const locationText=((item.ubicaciones)||[]).map(location=>[
        location.etiqueta,location.direccion,location.entidad,location.municipio,
        location.localidad,location.latitud,location.longitud
      ].filter(value=>value!=null&&String(value).trim()).join(' ')).join(' ');
      out.push({
        label:key+' · '+(item.nombreProyecto||'Proyecto PAM'),
        kind:'Proyecto PAM · '+(option.located?'ubicación validada':'GCR aproximada'),
        color:'#6B3654',
        n:this._norm([
          key,item.clavesAlternas,item.nombreProyecto,item.gcr,item.tipoProyecto,
          item.zonaAtendida,item.elementosEquiposAsociados,locationText
        ].filter(Boolean).join(' ')),
        ll:[option.lat,option.lng],
        pamItem:item,
        go:()=>this._focusPamItem(item)
      });
    });
    // Subestaciones/líneas acotadas al buffer del análisis geoespacial (si hay uno activo)
    if (L.subestaciones.on && this.subFeatures) this.subFeatures.filter(s => !this._anaSubSet || this._anaSubSet.has(s)).forEach(s => out.push({ label:s.name, kind:'Subestación', color:'#9B2247', n:this._norm(s.name+' '+(s.ent||'')), ll:[s.lat,s.lng], go:()=>{ this.map.setView([s.lat,s.lng],9,{animate:true}); this._selectSub(s,null); this._setHighlight(s.lat,s.lng,'#9B2247'); } }));
    if (L.gerencias.on) Object.entries(this.GCR_NOMBRE).forEach(([k,nom]) => out.push({ label:'GCR '+nom, kind:'Gerencia de control', color:this.GCR_COLORS[k], n:this._norm('gcr '+nom), ll:(this._gcrCentroid&&this._gcrCentroid[k])||null, go:()=>{ const c=this._gcrCentroid&&this._gcrCentroid[k]; if(c) this.map.setView(c,6,{animate:true}); this._selectGerencia(k,nom); if(c) this._setHighlight(c[0],c[1],this.GCR_COLORS[k]); } }));
    if (L.estados.on && this.geo && this.geo.estados) this.geo.estados.features.forEach(f => { const nom=this._propEnt(f.properties); if(!nom) return; const c=this.estCentroid[this._norm(nom)]; out.push({ label:nom, kind:'Estado', color:'#0E8A6E', n:this._norm(nom), ll:c?[c.lat,c.lng]:null, go:()=>{ if(c) this.map.setView([c.lat,c.lng],7,{animate:true}); this._selectEstado(nom,f); if(c) this._setHighlight(c.lat,c.lng,'#0E8A6E'); } }); });
    if (L.municipios.on && this.muniFeatures) this.muniFeatures.forEach(mu => out.push({ label:mu.name, kind:'Municipio'+(mu.ent?' · '+mu.ent:''), color:'#C9A24B', n:this._norm(mu.name+' '+(mu.ent||'')), ll:[mu.lat,mu.lng], go:()=>{ this.map.setView([mu.lat,mu.lng],9,{animate:true}); this.setState({ selected:{ kicker:'Municipio', color:'#C9A24B', name:mu.name, rows:[['Tipo de infraestructura','División municipal'],['Entidad federativa', mu.ent||'—'],['Fuente','Marco geoestadístico · INEGI'],['Actualización','2026-01-01']] } }); this._setHighlight(mu.lat,mu.lng,'#C9A24B'); } }));
    if (L.lineas.on && this.lineFeatures) this.lineFeatures.filter(pl => !this._anaLineSet || this._anaLineSet.has(pl)).forEach(pl => { const r = pl._rec; if (!r || !r.name) return; out.push({ label:r.name, kind:'Línea de transmisión · '+r.kv+' kV', color:'#E0A12E', n:this._norm(r.name+' '+r.kv), ll:(()=>{ try { const c=pl.getBounds().getCenter(); return [c.lat,c.lng]; } catch(e){ return null; } })(), go:()=>{ let c=null; try { const b=pl.getBounds(); c=b.getCenter(); this.map.fitBounds(b.pad(0.3),{animate:true}); } catch(e){} this._selectLine(r, pl); if (c) this._setHighlight(c.lat, c.lng, '#E0A12E'); } }); });
    // Capas genéricas del inventario (ANP, presas, lenguas, sitios, etc.) — sólo si están
    // encendidas y ya construidas. Se deduplica por nombre dentro de cada capa (p.ej. una
    // lengua aparece en miles de localidades): una sugerencia por nombre, a su primera ubicación.
    this.LAYERS.forEach(cfg => {
      if (!['geo','graph'].includes(cfg.type) || !L[cfg.key] || !L[cfg.key].on) return;
      const fs = (this._genericFeats || {})[cfg.key]; if (!fs) return;
      const seen = new Set();
      fs.forEach(ft => { const n = this._norm(ft.nom); if (!n || seen.has(n)) return; seen.add(n); out.push({ label:ft.nom, kind:cfg.label, color:cfg.color, n, ll:[ft.lat,ft.lng], go:()=>{ this.map.setView([ft.lat, ft.lng], 9, {animate:true}); if(cfg.type==='graph') this._selectGraphNode(ft.props,ft.marker); else this._selectGeneric(cfg, ft.props, ft.nom, [ft.lat,ft.lng]); this._setHighlight(ft.lat, ft.lng, cfg.color); } }); });
    });
    // Los datasets de permisos/proyectos sólo aparecen en el buscador si además su capa
    // en "Capas disponibles" está encendida — evita sugerir elementos que no se ven en el mapa.
    this.state.datasets.filter(d => d.active && (!['permisos','proyectos'].includes(d.target) || L[d.target].on)).forEach(d => this._datasetRowsForMap(d).forEach(r => { const label=this._dsRowName(r); const _tec=this._dsRowTech(r); out.push({ label, kind:(d.target==='proyectos'?'Proyecto':'Permiso')+' · '+this._tecLabel(_tec), color:this._tecColor(_tec), n:this._norm(label+' '+(r.municipio||'')+' '+(r.clave_permiso||'')), ll:this._placeRow(r,d), go:()=>{ const ll=this._placeRow(r,d); if(ll) this.map.setView(ll,8,{animate:true}); this._selectDatasetFeature(r,d,ll); if(ll) this._setHighlight(ll[0],ll[1],this._tecColor(r.tecnologia)); } }); }));
    this._searchCache=out; return out;
  }
  _suggestions(){ const q=this._norm(this.state.search); if(q.length<2) return []; return this._searchIndex().filter(e=>e.n.includes(q)).slice(0,8); }
  // Capa auto-encendida por un combo (para regresarla a su estado al limpiar el filtro)
  _ensureAuto(key){ if(!this.state.layers[key].on){ this._autoLayer=this._autoLayer||{}; this._autoLayer[key]=true; this.toggleLayer(key); } }
  _revertAuto(key){ if(this._autoLayer && this._autoLayer[key]){ this._autoLayer[key]=false; if(this.state.layers[key].on) this.toggleLayer(key); } }

  onFiltroEnt = (e) => {
    const filtroEnt = e.target.value;
    this.setState({ filtroEnt }, () => {
      this._applyFilters();
      if (filtroEnt) {
        this._ensureAuto('estados'); // muestra la capa de estados aunque no estuviera activa
        const f = this.estByName[this._norm(filtroEnt)]; if (f) this._selectEstado(filtroEnt, f);
        const c = this.estCentroid[this._norm(filtroEnt)];
        if (c) { this.map.setView([c.lat,c.lng],7,{animate:true}); this._setHighlight(c.lat,c.lng,'#0E8A6E'); }
      } else { this._revertAuto('estados'); this._clearHighlight(); this.map.setView([23.6,-102],5,{animate:true}); }
    });
  };
  onFiltroGer = (e) => {
    const filtroGer = e.target.value;
    this.setState({ filtroGer }, () => {
      this._applyFilters();
      if (filtroGer) {
        this._ensureAuto('gerencias'); // muestra la capa de gerencias aunque no estuviera activa
        const nom = this.GCR_NOMBRE[filtroGer]; this._selectGerencia(filtroGer, nom);
        const c = this._gcrCentroid && this._gcrCentroid[filtroGer];
        if (c) { this.map.setView(c,6,{animate:true}); this._setHighlight(c[0],c[1],this.GCR_COLORS[filtroGer]); }
      } else { this._revertAuto('gerencias'); this._clearHighlight(); this.map.setView([23.6,-102],5,{animate:true}); }
    });
  };
  onFiltroTec = (e) => { this.setState({ filtroTec:e.target.value }, () => this._applyFilters()); };
  _applyFilters() {
    const ent = this.state.filtroEnt; const tec = this.state.filtroTec; const ger = this.state.filtroGer;
    // subestaciones por entidad y/o gerencia
    this.groups.subestaciones.eachLayer(m => {
      const r=m._rec; const show = (!ent || r.ent===ent) && (!ger || this._gerenciaOf(r.ent)===ger);
      m.setStyle({ opacity: show?1:0.08, fillOpacity: show?.95:0.05 });
    });
    // permisos/proyectos por tecnología (re-render con filtro)
    this.state.datasets.filter(d=>d.active && ['permisos','proyectos'].includes(d.target)).forEach(d => {
      this.groups[d.target].eachLayer(()=>{});
    });
    this._recompute();
    if (tec) this._toast('Filtro de tecnología: '+this._tecLabel(tec));
  }

  _reloadDataset(ds){
    const url=(ds.url||'').trim();
    if (!/^https?:\/\//i.test(url)) return Promise.resolve({ dataset:ds, meta:null });
    const isJson = ds.type==='json' || /\.json($|\?)/i.test(url);
    const fetchUrl = /docs\.google\.com/.test(url) ? this._sheetCsvUrl(url) : url;
    return fetch(fetchUrl, { cache:'no-store' }).then(r=>{ if(!r.ok) throw new Error('HTTP '+r.status); return r.text(); }).then(txt=>{
      let fields, rows;
      if (isJson) { let j=JSON.parse(txt); const arr=Array.isArray(j)?j:(j.rows||j.data||j.features||[]); const flat=arr.map(x=>x.properties||x); fields=[...new Set(flat.flatMap(o=>Object.keys(o)))]; rows=flat; }
      else { const p=this._parseCSV(txt); fields=p.fields; rows=p.rows; }
      if(!fields.length) throw new Error('sin columnas');
      return this._transformDataset(rows, fields, ds.transform).then(out=>({
        dataset:{ ...ds, fields:out.fields, rows:out.rows, geo:this._datasetGeo(out.fields, out.rows) },
        meta:out.meta
      }));
    });
  }

  // ════════════════════ basemap / header ════════════════════
  toggleAnalysisPanel = () => {
    const opening=!this.state.anaOpen;
    this.setState({
      anaOpen:opening, menuOpen:null, mobilePanel:null, exportOpen:false,
      collapsed:opening ? { ...this.state.collapsed, detalle:true } : this.state.collapsed
    });
  };
  toggleLayersMenu = () => {
    const opening=this.state.menuOpen!=='capas';
    this.setState({
      menuOpen:opening?'capas':null,
      anaOpen:false,exportOpen:false,mobilePanel:null,
      marketLegendOpen:opening?false:this.state.marketLegendOpen
    });
  };
  toggleDatasetsMenu = () => this.setState({ menuOpen:this.state.menuOpen==='datasets'?null:'datasets', anaOpen:false, exportOpen:false, mobilePanel:null });
  setBasemap = (key) => {
    if (this.state.basemap===key||!this.bases[key]) return;
    const current=this.bases[this.state.basemap];
    if(current) this.map.removeLayer(current);
    this.bases[key].addTo(this.map);
    this.map.getContainer().style.backgroundColor=key==='oscuro'?'#111820':'#F4F0EA';
    // re-stack data sobre el tile
    Object.values(this.groups).forEach(g => g.bringToFront && g.bringToFront());
    this.setState({ basemap:key });
  };
  // Restablece una sesión completa, no sólo el zoom: quita datasets, zona, resultados,
  // filtros, paneles y herramientas para volver al mismo mapa limpio del arranque.
  onReset = () => {
    if(this._analysisAbortController){ try{ this._analysisAbortController.abort(); }catch(e){} this._analysisAbortController=null; }
    this._analysisRunId=(this._analysisRunId||0)+1;
    this._clearPamInteraction();
    this._preparedAnalysisContext=null; this._analysisFilteredGeo={}; this._analysisPreparedKey={};
    this._anaSummary=null; this._report=null; this._returnToAnalysis=false;
    if (this._anaMarker) { try { this.map.removeLayer(this._anaMarker); } catch(e){} this._anaMarker=null; }
    if (this._anaCircle) { try { this.map.removeLayer(this._anaCircle); } catch(e){} this._anaCircle=null; }
    if (this._mTip) { try { this.map.removeLayer(this._mTip); } catch(e){} this._mTip=null; }
    if (this._conv2ReviewFocus) { try { this.map.removeLayer(this._conv2ReviewFocus); } catch(e){} this._conv2ReviewFocus=null; }
    this._clearHighlight(); this._clearGraphFocus();
    this._clearDemandRegionFocus(); this._clearTariffDivisionFocus();
    this._stopDraw();
    try { this.drawn.clearLayers(); this.map.closePopup(); } catch(e){}
    try { this._muniPaneShow(false); } catch(e){}
    this._anaSubSet=null; this._anaLineSet=null; this._genericFeats={}; this._genericCount={}; this._autoLayer={};
    this._pamLayerMeta=null;
    Object.entries(this.groups||{}).forEach(([key,g]) => {
      const cfg=this.LAYERS.find(c=>c.key===key)||{};
      if (key!=='estados') { try { if (this.map.hasLayer(g)) this.map.removeLayer(g); } catch(e){} }
      // Leaflet.markercluster emite un warning por cada marcador al ejecutar
      // clearLayers() después de retirar el grupo. Para PAM se sustituye el
      // contenedor completo: queda vacío y sin listeners residuales.
      if(key==='pam'){
        this.groups[key]=this._clusterGroup(cfg);
        return;
      }
      const clearDynamic=cfg.lazy&&key!=='municipios';
      if (clearDynamic||['permisos','proyectos','zonas'].includes(key)||cfg.type==='graph'||cfg.analysis) {
        try { g.clearLayers(); } catch(e){}
      }
    });
    // El inventario/grafo se vuelve a construir bajo demanda desde el GeoJSON conservado en memoria.
    this._networkSubFeaturesByLayer={};
    this._networkLineFeaturesByLayer={};
    this.subFeatures=[];
    this.lineFeatures=[];
    this.LAYERS
      .filter(c=>(c.analysis||c.lazy)&&c.key!=='municipios'&&!['subestaciones','lineas'].includes(c.key))
      .forEach(c=>{ this._built[c.key]=false; });
    this.LAYERS.filter(c=>c.type==='graph').forEach(c=>{this._built[c.key]=false;});
    this._graphNodeById=new Map();
    this._graphEdgeById=new Map();
    try { if (!this.map.hasLayer(this.groups.estados)) this.groups.estados.addTo(this.map); } catch(e){}
    if (this.state.basemap!=='sinmapa') { try { this.map.removeLayer(this.bases[this.state.basemap]); } catch(e){} try { this.bases.sinmapa.addTo(this.map); } catch(e){} }
    this.map.getContainer().style.backgroundColor='#F4F0EA';
    const layers=this._initLayers();
    layers.gerencias.count=this.groups.gerencias&&this.groups.gerencias.getLayers?this.groups.gerencias.getLayers().length:0;
    layers.estados.count=this.geo&&this.geo.estados?(this.geo.estados.features||[]).length:0;
    layers.municipios.count=this.muniFeatures?this.muniFeatures.length:0;
    layers.subestaciones.count=(this.subFeatures||[]).length;
    layers.lineas.count=(this.lineFeatures||[]).length;
    this.map.getContainer().style.cursor='';
    this.map.setView([23.6,-102],5,{animate:false});
    this._invalidateSearch();
    this.setState({
      basemap:'color', legendOn:true, layers, datasets:[], selected:null,
      search:'', filtroEnt:'', filtroTec:'', filtroGer:'', scope:'Visible',
      measure:false, drawing:false, connectOpen:false, fields:null, connectUrl:'',
      exportOpen:false, anaOpen:false, mobilePanel:null, menuOpen:null, reportOpen:false,
      conv2ReviewOpen:false, conv2ReviewLoading:false, conv2ReviewError:'',
      conv2DecisionTarget:null, conv2DecisionKind:'', conv2DecisionNote:'',
      conv2DecisionBusy:false, conv2DecisionError:'',
      blocking:null, layerBar:null, collapsed:{ capas:false, datasets:false, detalle:true, metricas:false },
      analysis:{
        placing:false, lat:null, lng:null, estado:'', radiusKm:20, bufferKm:0,
        territoryGeometry:null, analysisGeometry:null, territoryAreaKm2:null,
        sel:{}, ranKeys:[],
        stale:false, running:false, profile:'recommended',progress:null,cancelled:false,
        intensiveConfirmed:false,mode:'click', latIn:'', lngIn:'', dirIn:'', dirResults:[],
        shortcutType:'gcr', shortcutQuery:'', shortcutOptions:[], shortcutBusy:false,
        targetKind:'', targetLabel:'', targetDetail:'', targetState:'', targetMunicipality:'',
        targetStateCode:'', targetMunicipalityCode:''
      }
    }, () => { this._recompute(); this._toast('Nuevo análisis listo · mapa limpio'); });
  };
  onRefresh = () => {
    const online=this.state.datasets.filter(d=>/^https?:\/\//i.test(d.url||''));
    const marketRequest=this.state.marketOpen
      ?(this.state.marketMode==='demand'
        ?this._loadDemandMarket(true,true)
        :(this.state.marketMode==='consumption'
          ?this._loadTariffMarket(true,true)
          :this._loadDistributedGenerationMarket(true,true)))
      :null;
    if(!online.length&&!marketRequest){
      this._toast('No hay datos en línea activos para actualizar');
      return;
    }
    this._toast('Sincronizando fuentes en línea…');
    this.setState({
      loading:true,
      loadingMsg:this.state.marketOpen
        ?'Actualizando indicadores de operación y mercado…'
        :'Actualizando datos desde Google Sheets…'
    });
    Promise.all([
      Promise.all(online.map(d=>this._reloadDataset(d))),
      marketRequest||Promise.resolve(null)
    ]).then(([updated])=>{
      const byId={}; updated.forEach(x=>{ byId[x.dataset.id]=x.dataset; });
      const datasets=this.state.datasets.map(d=>byId[d.id]||d);
      this._invalidateSearch();
      this.setState({ datasets, loading:false }, ()=>{
        [...new Set(updated.filter(x=>x.dataset.active).map(x=>x.dataset.target))].forEach(target=>this._renderDataset({ target }));
        const traced=updated.find(x=>x.meta);
        this._toast(traced
          ? 'Datos actualizados · '+traced.meta.kept+' continúan de '+traced.meta.evaluated+' folios evaluados en Minutas'
          : 'Datos actualizados · '+(online.length
            ?online.length+' dataset(s) y panel de mercado'
            :'panel de operación y mercado'));
      });
    }).catch(e=>{
      this.setState({ loading:false });
      this._toast('No se pudieron actualizar los datasets: '+String(e.message||e));
    });
  };
  // ════════════════════ exportación (PNG · PDF carta · Excel) ════════════════════
  onToggleExport = () => this.setState({ exportOpen: !this.state.exportOpen, anaOpen:false, menuOpen:null, mobilePanel:null });
  closeExport = () => this.setState({ exportOpen:false });
  _download(url, name){ const a=document.createElement('a'); a.href=url; a.download=name; document.body.appendChild(a); a.click(); a.remove(); }
  _stamp(){ return new Date().toLocaleString('es-MX'); }
  _activeLayerRows(A=this.state.analysis,L=this.state.layers){
    const analysis=A||{};
    const layerState=L||{};
    const selectedKeys = Array.isArray(analysis.ranKeys) && analysis.ranKeys.length ? analysis.ranKeys : [];
    const selectedSet = new Set(selectedKeys);
    const keysToShow = selectedKeys.length ? selectedKeys : this.LAYERS.filter(c => !c.hidden).map(c=>c.key);
    const byKey = new Map(this.LAYERS.filter(c=>!c.hidden).map(c=>[c.key,c]));
    return keysToShow
      .map(key=>{
        const cfg = byKey.get(key) || {};
        const v = layerState[key] || {};
        return cfg.key ? { Capa:v.label || cfg.label || key, Categoria:cfg.cat||'Análisis territorial', Activa: (selectedSet.has(key) ? 'Sí' : (v.on ? 'Sí' : 'No')), Conteo:v.count||0 } : null;
      })
      .filter(Boolean);
  }
  _metricRows(){ const m=this.state.metrics; return [
    ['Capacidad total seleccionada', Math.round(m.capacidad||0), 'MW'],
    ['Subestaciones visibles', m.subs||0, ''],
    ['Km de líneas visibles', Math.round(m.km||0), 'km'],
    ['Permisos de generación', m.permisos||0, ''],
    ['Proyectos activos', m.proyectos||0, ''],
    ['Distancia al más cercano', m.distancia==null?'—':+m.distancia.toFixed(1), m.distancia==null?'':'km'],
  ]; }
  // ════════════════════ REPORTE TERRITORIAL (vista completa + PDF) ════════════════════
  _nearestSubs(lat, lng, n){
    if (!this.subFeatures) return [];
    return this.subFeatures
      .map(s => ({ name:s.name, ent:s.ent, kv:s.kv, dist:this._haversine(lat, lng, s.lat, s.lng) }))
      .sort((a,b) => a.dist-b.dist).slice(0, n||5);
  }
  _nearestLines(lat, lng, n){
    if (!this.lineFeatures) return [];
    const out = [];
    this.lineFeatures.forEach(pl => {
      const r = pl._rec; if (!r) return;
      let lls = pl.getLatLngs(); while (Array.isArray(lls[0])) lls = lls.flat();
      if (!lls.length) return;
      const step = Math.max(1, Math.floor(lls.length/60));
      let best = Infinity;
      for (let i=0; i<lls.length; i+=step) { const d = this._haversine(lat, lng, lls[i].lat, lls[i].lng); if (d<best) best=d; }
      out.push({ name:r.name||'Línea', kv:r.kv, km:r.km, dist:best });
    });
    return out.sort((a,b) => a.dist-b.dist).slice(0, n||5);
  }
  // Construye la sección PODECOBI para el reporte territorial. Solo aparece
  // cuando el radio toca algún polo. Por cada polo intersectado trae el detalle
  // Carga Patria en TrueType: jsPDF 2.5 no interpreta los contornos CFF de
  // los OTF originales. Las variantes TTF se derivan de esos mismos archivos.
  // Si la carga falla, el documento cae a las fuentes PDF estándar.
  async _loadReportFonts(doc){
    const fonts = [
      { url:'/tablero/fonts/patria/Patria-Regular.ttf', name:'Patria', style:'normal' },
      { url:'/tablero/fonts/patria/Patria-Bold.ttf',    name:'Patria', style:'bold'   },
      { url:'/tablero/fonts/ibm-plex-mono/IBMPlexMono-Regular.ttf', name:'IBMPlexMono', style:'normal' },
      { url:'/tablero/fonts/ibm-plex-mono/IBMPlexMono-Bold.ttf',    name:'IBMPlexMono', style:'bold'   },
    ];
    try {
      for (const f of fonts) {
        const resp = await fetch(f.url);
        if (!resp.ok) return null;
        const buf = await resp.arrayBuffer();
        const bytes = new Uint8Array(buf);
        let binary = '';
        const chunkSize = 0x8000;
        for (let offset=0; offset<bytes.length; offset+=chunkSize) {
          binary += String.fromCharCode.apply(null, bytes.subarray(offset, offset+chunkSize));
        }
        const b64 = btoa(binary);
        doc.addFileToVFS(f.name + '-' + f.style + '.ttf', b64);
        doc.addFont(f.name + '-' + f.style + '.ttf', f.name, f.style);
      }
      return { title:'Patria', kicker:'helvetica', body:'helvetica', bodyBold:'helvetica', light:'helvetica', mono:'IBMPlexMono' };
    } catch (e) {
      console.warn('No se pudieron cargar fuentes Patria:', e);
      return null;
    }
  }

  // Helper que aplica la fuente al doc y la guarda para restaurarla después.
  // jsPDF persiste el font entre llamadas, así que solo cambiamos cuando es
  // distinto del actual.
  _setFont(doc, name, style){
    if (doc._lastFont !== name + ':' + style) {
      doc.setFont(name, style);
      doc._lastFont = name + ':' + style;
    }
  }

  _setReportFont(doc, role, style){
    const fallback = { title:'times', kicker:'helvetica', body:'helvetica', bodyBold:'helvetica', light:'helvetica', mono:'courier' };
    const fonts = doc._reportFonts || fallback;
    const name = fonts[role] || fallback[role] || fallback.body;
    this._setFont(doc, name, style || (role==='bodyBold' ? 'bold' : 'normal'));
  }

  async _initReportFonts(doc){
    doc._lastFont = null;
    const fallback = { title:'times', kicker:'helvetica', body:'helvetica', bodyBold:'helvetica', light:'helvetica', mono:'courier' };
    doc._reportFonts = (await this._loadReportFonts(doc)) || fallback;
    return doc._reportFonts;
  }

  // completo desde el backend (vocaciones, contactos, fuentes) y lo presenta
  // como sub-bloques (rows + tabla de contactos).
  _buildPolosSection(A){
    return Promise.all([
      fetch('/api/podecobi/polos', { credentials: 'same-origin' }).then(r => r.ok ? r.json() : []),
      fetch('/api/podecobi/resumen', { credentials: 'same-origin' }).then(r => r.ok ? r.json() : null),
      this._fetchPolosGeoCache(),
    ]).then(([polos, resumen, geo]) => {
      if (!Array.isArray(polos) || !polos.length) return null;

      const byNumber=new Map();
      ((geo&&geo.features)||[]).forEach(feature=>{
        const number=String((feature.properties||{}).Numero||'').trim();
        if(!number) return;
        if(!byNumber.has(number)) byNumber.set(number,[]);
        byNumber.get(number).push(feature);
      });
      const inCoverage = polos.filter(p => {
        const features=byNumber.get(String(p.numero||'').trim())||[];
        if(features.length) return features.some(feature=>this._analysisFeatureIntersects(A,feature));
        return p.centroidLon != null && p.centroidLat != null &&
          this._analysisContainsPoint(A,p.centroidLat,p.centroidLon);
      });

      // Sin intersección: la sección no aparece en el reporte territorial
      if (!inCoverage.length) return null;

      // Trae el detalle de cada polo intersectado en paralelo
      const detallePromises = inCoverage.map(p =>
        fetch('/api/podecobi/polos/' + encodeURIComponent(p.numero), { credentials: 'same-origin' })
          .then(r => r.ok ? r.json() : null)
          .catch(() => null)
      );

      return Promise.all(detallePromises).then(detalles => {
        const totalHa = resumen
          ? Number(resumen.superficieTotalHa || 0).toLocaleString('es-MX', { maximumFractionDigits: 2 })
          : '—';

        // KPIs del universo institucional (4 líneas cortas)
        const rows = [
          ['Universo PODECOBI declarado', `${this._nf(resumen?.totalPolos || polos.length)} polos · 13 entidades · ${totalHa} ha agregadas`],
          ['En ejecución', this._nf(resumen?.enEjecucion ?? '—') + ' polos'],
          ['En preinversión', this._nf(resumen?.enPreinversion ?? '—') + ' polos'],
          ['Corte vigente de la base', resumen?.ultimoCorte || '—'],
        ];

        // Tabla resumen de los intersectados (mismo formato que el reporte nacional)
        const tablaResumen = inCoverage.map(p => [
          p.numero || '—',
          p.nombreOficial || '—',
          p.estado || '—',
          p.municipio || '—',
          p.etapa || '—',
          p.areaOficialHa != null ? Number(p.areaOficialHa).toLocaleString('es-MX', { maximumFractionDigits: 2 }) + ' ha' : '—',
        ]);

        // Detalle por polo: una sub-sección con rows + tabla de contactos.
        // Se aplana al formato del reporte: cada polo genera un bloque hasRows=true
        // con sus campos clave y hasTable=true con los contactos.
        const polosDetalle = [];
        detalles.forEach((d, i) => {
          if (!d || !d.polo) return;
          const pol = d.polo;
          const dato = value => value==null || String(value).trim()==='' ? 'Sin dato registrado' : String(value).trim();
          const voc = (d.vocaciones || []).map(v => dato(v.vocacion)).filter(v => v!=='Sin dato registrado');
          const cf  = (d.contactos || []).find(c => c.ambito === 'FEDERAL');
          const ce  = (d.contactos || []).find(c => c.ambito === 'ESTATAL');
          const fDOF = (d.fuentes || []).find(f => f.tipo === 'DOF' || f.tipo === 'SIDOF');
          const fPM  = (d.fuentes || []).find(f => f.tipo === 'PROYECTOS_MX');

          const rowsPolo = [
            ['Polo', pol.nombreOficial + ' · Núm. ' + pol.numero],
            ['Entidad · Municipio', (pol.estado || '—') + ' · ' + (pol.municipio || '—')],
            ['Etapa · Subetapa', [pol.etapa, pol.subetapa].filter(Boolean).join(' · ') || '—'],
            ['Declaratoria (DOF/SIDOF)', pol.fechaDeclaracion ? new Date(pol.fechaDeclaracion).toLocaleDateString('es-MX') : '—'],
            ['Superficie jurídica', pol.areaOficialHa != null ? Number(pol.areaOficialHa).toLocaleString('es-MX', { maximumFractionDigits: 4 }) + ' ha' : '—'],
            ['Superficie GeoJSON', pol.areaGeojsonHa != null ? Number(pol.areaGeojsonHa).toLocaleString('es-MX', { maximumFractionDigits: 4 }) + ' ha' + (pol.geojsonDeltaPct != null ? ' · Δ ' + Number(pol.geojsonDeltaPct).toFixed(2) + ' %' : '') : '—'],
            ['Demanda eléctrica', pol.demandaElectrica ? pol.demandaElectrica + (pol.demandaElectricaNota ? ' · ' + pol.demandaElectricaNota : '') : '—'],
            ['Demanda máxima', pol.demandaMaxima ? pol.demandaMaxima + (pol.demandaMaximaNota ? ' · ' + pol.demandaMaximaNota : '') : '—'],
            ['Tensión', pol.tension || '—'],
            ['Conexión a red', pol.conexion || '—'],
            ['Gas natural', pol.gasDisponibilidad ? pol.gasDisponibilidad + (pol.gasNota ? ' · ' + pol.gasNota : '') : '—'],
            ['Vocaciones productivas', voc.length ? voc.join(' · ') : 'Sin dato registrado'],
            ['Inversión', dato(pol.inversion)],
            ['Empleos', dato(pol.empleos)],
            ['Avance manual', pol.avanceManualPct != null ? Number(pol.avanceManualPct) + ' %' : '—'],
            ['Ficha Proyectos México', pol.urlProyectosMexico || '—'],
            ['Fuente DOF/SIDOF', fDOF ? (fDOF.url || '—') : '—'],
            ['Verificación', pol.verificacion || '—'],
          ];

          // Tabla de contactos del polo
          const contactosRows = [];
          if (cf) contactosRows.push(['Federal', cf.nombre || '—', cf.cargo || '—', cf.correo || '—', cf.telefono || '—']);
          if (ce) contactosRows.push(['Estatal', ce.nombre || '—', ce.cargo || '—', ce.correo || '—', ce.telefono || '—']);
          if (!contactosRows.length) contactosRows.push(['—', 'Sin contactos registrados', '—', '—', '—']);

          polosDetalle.push({
            kicker: `Polo ${pol.numero} · detalle`,
            color: '#9B2247',
            title: pol.nombreOficial,
            intro: fPM ? `Ficha Proyectos México revisada el ${pol.fechaRevisionPublica ? new Date(pol.fechaRevisionPublica).toLocaleDateString('es-MX') : 's/f'}.` : 'Detalle institucional del polo.',
            hasRows: true, rows: rowsPolo, hasChips: false, chips: [],
            hasTable: true, hasTable2: false,
            table: { head: ['Ámbito', 'Contacto', 'Cargo', 'Correo', 'Teléfono'], rows: contactosRows },
          });
        });

        return {
          key: 'podecobi', kicker: 'Contexto complementario · PODECOBI', color: '#9B2247',
          icon: 'M3 21h18 M5 21V10l7-5 7 5v11 M9 21v-6h6v6',
          title: inCoverage.length === 1
            ? `PODECOBI intersectado: ${inCoverage[0].nombreOficial || 'polo ' + inCoverage[0].numero}`
            : `${inCoverage.length} polos PODECOBI intersectados por la cobertura analizada`,
          intro: 'Polo(s) con declaratoria vigente en DOF/SIDOF cuya geometría intersecta la cobertura territorial. Detalle completo contra la base institucional dgmesnie.PODECOBI.',
          hasRows: true, rows, hasChips: false, chips: [],
          hasTable: true, hasTable2: false,
          hasSubSections: polosDetalle.length > 0,
          table: { head: ['Núm.', 'Polo', 'Entidad', 'Municipio', 'Etapa', 'Superficie (DOF)'], rows: tablaResumen },
          // Sub-secciones de detalle (se renderizan como bloques "rows + tabla" apilados)
          subSections: polosDetalle,
        };
      });
    });
  }

  _legendGroups(interactive){
    const S=this.state, groups=[];
    const dot={w:'10px',h:'10px',r:'50%'}, bar={w:'16px',h:'4px',r:'2px'};
    if (
      S.layers.lineas.on ||
      S.layers.subestaciones.on ||
      (S.layers.red_lineas&&S.layers.red_lineas.on) ||
      (S.layers.red_se_transmision&&S.layers.red_se_transmision.on) ||
      (S.layers.red_se_distribucion&&S.layers.red_se_distribucion.on)
    ) {
      groups.push({
        title:'Tensión (kV)',
        items:this.KV_COLORS.map(c=>({
          color:c.color,label:c.label,...bar,border:c.color==='#FFFFFF'?'1px solid #8A9099':'none',
          hasCount:false,count:'',active:true,cursor:'default',op:1
        }))
      });
    }
    if(
      (S.layers.red_se_transmision&&S.layers.red_se_transmision.on) ||
      (S.layers.red_se_distribucion&&S.layers.red_se_distribucion.on)
    ){
      const stationItems=[];
      if(S.layers.red_se_transmision.on) stationItems.push({
        color:'#FFFFFF',label:'Subestación de transmisión · símbolo hueco',...dot,
        border:'2px solid #8E9AAD',hasCount:true,count:(S.layers.red_se_transmision.count||0).toLocaleString('es-MX'),
        active:true,cursor:'default',op:1
      });
      if(S.layers.red_se_distribucion.on) stationItems.push({
        color:'#FF9652',label:'Subestación de distribución',...dot,
        border:'1px solid #FFFFFF',hasCount:true,count:(S.layers.red_se_distribucion.count||0).toLocaleString('es-MX'),
        active:true,cursor:'default',op:1
      });
      groups.push({title:'Subestaciones',items:stationItems});
    }
    if(S.layers.demanda_atlas&&S.layers.demanda_atlas.on){
      const swatch={w:'16px',h:'10px',r:'2px'};
      groups.push({
        title:'Demanda regional medida',
        items:[
          {color:'#D9EFF5',label:'Menos de 2,000 MW'},
          {color:'#83C5D2',label:'2,000–3,999 MW'},
          {color:'#2D9AB3',label:'4,000–6,499 MW'},
          {color:'#2E6FB0',label:'6,500–8,999 MW'},
          {color:'#9B2247',label:'9,000 MW o más'}
        ].map(item=>({...item,...swatch,hasCount:false,count:'',active:true,cursor:'default',op:1}))
      });
    }
    if(S.layers.tarifas_atlas&&S.layers.tarifas_atlas.on){
      const swatch={w:'16px',h:'10px',r:'2px'};
      const metric=S.marketMetric||'energy';
      const definition=this._tariffMetricDefinition(metric);
      groups.push({
        title:definition.label+' por división CFE',
        items:this._tariffMetricLegend(metric).map(item=>({
          color:item.color,label:item.label,...swatch,
          hasCount:false,count:'',active:true,cursor:'default',op:1
        }))
      });
    }
    if(S.layers.generacion_distribuida_atlas&&S.layers.generacion_distribuida_atlas.on){
      const swatch={w:'16px',h:'10px',r:'2px'};
      groups.push({
        title:'Generación distribuida acumulada',
        items:[
          {color:'#D8F3DC',label:'Menos de 50 MW'},
          {color:'#95D5B2',label:'50–99 MW'},
          {color:'#52B788',label:'100–199 MW'},
          {color:'#2D6A4F',label:'200–399 MW'},
          {color:'#0B3D2E',label:'400 MW o más'}
        ].map(item=>({...item,...swatch,hasCount:false,count:'',active:true,cursor:'default',op:1}))
      });
    }
    if (S.layers.gerencias.on) {
      groups.push({
        title:'Gerencias de control',
        items:Object.keys(this.GCR_NOMBRE).map(k=>({ color:this.GCR_COLORS[k], label:this.GCR_NOMBRE[k], ...dot, hasCount:false, count:'', active:true, cursor:'default', op:1 }))
      });
    }
    if(S.layers.pam&&S.layers.pam.on&&this._pamLayerMeta){
      groups.push({
        title:'Proyectos PAM / PAMRNT',
        items:[
          {
            color:'#6B3654',label:'Asociación de red · pendiente de validación',...dot,
            hasCount:true,count:Number(this._pamLayerMeta.proyectosAsociadosRed||0).toLocaleString('es-MX'),
            active:true,cursor:'default',op:1
          },
          {
            color:'#B47712',label:'Referencia regional GCR · no es coordenada oficial',...dot,
            hasCount:true,count:Number(this._pamLayerMeta.proyectosRegionales||0).toLocaleString('es-MX'),
            active:true,cursor:'default',op:1
          }
        ]
      });
    }
    const analyzedKeys=new Set((S.analysis&&S.analysis.ranKeys)||[]);
    const caps=this.LAYERS.filter(c=>!c.hidden&&
      (!c.analysis || S.layers[c.key].on || analyzedKeys.has(c.key)) &&
      (c.type!=='graph'||interactive||S.layers[c.key].on)
    );
    groups.push({
      title:interactive?'Capas · clic para encender/apagar':'Capas visibles en el mapa base',
      items:caps.map(c=>{
        const v=S.layers[c.key];
        const analyzed=analyzedKeys.has(c.key);
        const visible=interactive?!!v.on:(!!v.on||analyzed);
        const shape=c.graphPart==='edges'?bar:dot;
        return {
          color:visible?c.color:'#C7C2BA', label:v.label+(v.summarized&&interactive?' · resumen':''), ...shape,
          hasCount:v.count>0, count:(v.count||0).toLocaleString('es-MX'),
          active:visible, cursor:interactive?'pointer':'default', op:visible?1:.55,
          onClick:interactive?()=>this.toggleLayer(c.key):null
        };
      })
    });
    if (S.datasets.length) {
      groups.push({
        title:'Datasets externos · zona actual',
        items:S.datasets.map(d=>({
          color:d.active?d.color:'#C7C2BA', label:d.name, ...dot,
          hasCount:true, count:String(this._datasetRowsForMap(d).length),
          active:!!d.active, cursor:interactive?'pointer':'default', op:d.active?1:.55,
          onClick:interactive?()=>this.toggleDataset(d.id):null
        }))
      });
    }
    groups.forEach((g,i)=>{ g.mt = i===0 ? '0' : '12px'; });
    return groups;
  }

  _analysisTarget(A, municipality, gcrKey){
