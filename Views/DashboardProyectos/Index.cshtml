  _marketViewportPadding(region=''){
    const margin=18;
    const fallback={
      paddingTopLeft:[margin,margin],
      paddingBottomRight:[margin,margin]
    };
    if(!this.map||typeof document==='undefined') return fallback;
    const mapElement=this.map.getContainer&&this.map.getContainer();
    if(!mapElement) return fallback;
    const mapRect=mapElement.getBoundingClientRect();
    if(!mapRect.width||!mapRect.height) return fallback;
    let left=margin,right=margin,top=margin,bottom=margin;
    const visibleRect=element=>{
      if(!element) return null;
      const style=window.getComputedStyle(element);
      if(style.display==='none'||style.visibility==='hidden'||Number(style.opacity)===0) return null;
      const rect=element.getBoundingClientRect();
      const intersects=rect.right>mapRect.left&&rect.left<mapRect.right&&
        rect.bottom>mapRect.top&&rect.top<mapRect.bottom;
      return intersects&&rect.width>0&&rect.height>0?rect:null;
    };
    const trayRect=visibleRect(document.querySelector('.dg-market-tray'));
    if(trayRect){
      const overlap=Math.max(
        0,
        mapRect.bottom-Math.max(mapRect.top,trayRect.top)
      );
      const visualLift=Math.min(90,overlap*.20);
      bottom=Math.max(
        bottom,
        Math.round(overlap+visualLift+margin)
      );
    }
    document.querySelectorAll('.dgp,.dg-anadrop').forEach(element=>{
      const rect=visibleRect(element);
      if(!rect||rect.width<160||rect.height<100) return;
      if(rect.left<=mapRect.left+mapRect.width*.5){
        left=Math.max(left,Math.round(Math.min(mapRect.right,rect.right)-mapRect.left+margin));
      }else{
        right=Math.max(right,Math.round(mapRect.right-Math.max(mapRect.left,rect.left)+margin));
      }
    });
    if(this._norm(region).includes('peninsular')){
      right+=Math.round(
        Math.min(132,Math.max(72,mapRect.width*.075))
      );
    }
    left=Math.min(left,Math.round(mapRect.width*.42));
    right=Math.min(right,Math.round(mapRect.width*.46));
    const minimumVisibleHeight=Math.min(150,Math.max(96,mapRect.height*.22));
    bottom=Math.min(bottom,Math.max(margin,Math.round(mapRect.height-top-minimumVisibleHeight)));
    return {
      paddingTopLeft:[left,top],
      paddingBottomRight:[right,bottom]
    };
  }
  _fitDemandViewport(region,animate=true){
