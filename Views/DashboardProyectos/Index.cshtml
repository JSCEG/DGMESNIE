    } catch(e) {}
  };
  anaToggleSel = (key) => {
    const A = this.state.analysis;
    this.setState({ analysis: { ...A, sel: { ...A.sel, [key]: !A.sel[key] }, stale:true } });
  };
  // Escenarios: aplica un conjunto de capas de un solo golpe (o vacía la selección con []).
  anaApplyPreset = (keys) => {
    const A = this.state.analysis;
