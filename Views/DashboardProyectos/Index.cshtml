        ['Año completo de referencia',referenceYear||'—'],
        ['Cobertura de la serie','Usuarios y ventas de energía por división tarifaria']
      ],
      hasChips:false,
      chips:[],
      hasCharts:charts.length>0,
      charts,
      hasTable:tableRows.length>0,
      table:{
        head:['División','Año','Usuarios','Consumo','Intensidad'],
        rows:tableRows
      },
      hasTable2:false,
      source:context.source
    };
    const sections=Array.isArray(report.sections)?report.sections:[];
    if(!sections.find(item=>item&&item.key===section.key)) sections.push(section);
    report.sections=sections;
    report.charts=(Array.isArray(report.charts)?report.charts:[]).concat(charts);
