  _pdfReportTable(doc,tb,cfg){
    const head=(tb&&tb.head)||[], rows=(tb&&tb.rows)||[]; if(!head.length) return cfg.y;
    const n=head.length, x=cfg.x, width=cfg.width;
    const normalizedHead=head.map(h=>String(h||'').trim().toLowerCase());
    let ratios=null;
    // La tabla resumen de PODECOBI abre con un consecutivo corto; reservarle
    // 30 % (la regla genérica) comprime el nombre del polo y la entidad.
    if(n===6 && /^n[úu]m/.test(normalizedHead[0]) && normalizedHead[1].includes('polo')){
      ratios=[.07,.27,.14,.15,.13,.24];
    }
    if(n===8 && normalizedHead[0]==='cvegeo' && normalizedHead[1].includes('localidad')){
      ratios=[.12,.19,.13,.12,.08,.13,.08,.15];
    }
    if(n===7 && normalizedHead[1].includes('permiso') && normalizedHead.some(value=>value.includes('centroide'))){
      ratios=[.10,.15,.23,.15,.11,.12,.14];
    }
    const first=n>=5?.30:(n===2?.56:.42);
    const widths=ratios?ratios.map(r=>width*r):[width*first];
    if(!ratios) for(let i=1;i<n;i++) widths.push(width*(1-first)/(n-1));
    const xs=[x]; for(let i=1;i<n;i++) xs.push(xs[i-1]+widths[i-1]);
