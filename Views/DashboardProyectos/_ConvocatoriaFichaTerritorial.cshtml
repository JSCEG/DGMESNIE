@model NSIE.Models.ProyectosPrivados.CarteraConvocatoriaFichaViewModel
<section class="pam-slide pam-slide--content" data-slide data-index-group="Territorio" data-label="Entorno territorial del proyecto" data-screen-label="07">
    <header class="pam-lamina-head"><span class="pam-lamina-head__kicker">Mixtos II · Territorio</span><span class="pam-lamina-head__aside">Territorio e infraestructura</span></header>
    <h2 class="pam-lamina-title">Entorno territorial del proyecto</h2>
    <div class="pam-lamina-body pam-territorial" data-pam-territorial-analysis data-territorial-url="mixtos:@Model.Project.Folio" data-project-gcr="@Model.Project.Region" data-default-radius="20">
        <div class="pam-territorial__layout">
            <div id="pam-territorial-mapa" class="pam-territorial__mapa" aria-label="Mapa de resultados geoespaciales"></div>
            <aside class="pam-territorial__resumen" aria-live="polite"><div class="pam-territorial__loading"><strong>Ejecutando análisis…</strong><span>Red, municipios, ambiente, pueblos indígenas y permisos.</span></div></aside>
        </div>
        <div class="pam-territorial__metodo"><span>Proyecto / conexión</span><span>Área de análisis: 20 km</span><strong data-territorial-status>Inicializando…</strong></div>
    </div>
    <div class="pam-lamina-foot"><span>Geometrías registradas en ventanilla. Análisis de proximidad en un radio de 20 km.</span><span>07</span></div>
</section>
<section class="pam-slide pam-slide--content" data-slide data-index-group="Territorio" data-label="Perfil energético y social" data-screen-label="08">
    <header class="pam-lamina-head"><span class="pam-lamina-head__kicker">Mixtos II · Territorio</span><span class="pam-lamina-head__aside">Contexto energético y social</span></header>
    <h2 class="pam-lamina-title">Perfil energético y social</h2>
    <div class="pam-lamina-body pam-territorial-ejecutivo" data-pam-territorial-executive><div class="pam-territorial__loading"><strong>Integrando perfil territorial…</strong><span>Capas complementarias, patrimonio y contexto municipal INEGI.</span></div></div>
    <div class="pam-lamina-foot"><span>Contexto energético y municipal de referencia para el área de análisis.</span><span>08</span></div>
</section>
<section class="pam-slide pam-slide--content" data-slide data-index-group="Territorio" data-label="Entorno agrario e indígena" data-screen-label="08B">
    <header class="pam-lamina-head"><span class="pam-lamina-head__kicker">Mixtos II · Territorio</span><span class="pam-lamina-head__aside">Contexto agrario, indígena y eléctrico</span></header>
    <h2 class="pam-lamina-title">Entorno territorial</h2>
    <div class="pam-lamina-body convocatoria-extra-analysis" data-convocatoria-extra-analysis aria-live="polite"><p>Consultando capas agrarias, indígenas, generación distribuida y divisiones tarifarias…</p></div>
    <div class="pam-lamina-foot"><span>Coincidencias dentro del área de análisis de 20 km.</span><span>08B</span></div>
</section>
@for (var pagina = 0; pagina < 2; pagina++) {
    <section class="pam-slide pam-slide--content" data-slide data-index-group="Territorio" data-label="Resultados territoriales · @(pagina + 1)" data-screen-label="@(9 + pagina)">
        <header class="pam-lamina-head"><span class="pam-lamina-head__kicker">Mixtos II · Resultados por geometría</span><span class="pam-lamina-head__aside">Proyecto y conexión</span></header>
        <h2 class="pam-lamina-title">Resultados territoriales</h2>
        <div class="pam-lamina-body" data-pam-territorial-comparison data-territorial-page="@pagina"><div class="pam-territorial__loading"><strong>Preparando resultados…</strong><span>Subestaciones, líneas, entorno ambiental y contexto social.</span></div></div>
        <div class="pam-lamina-foot"><span>Elementos identificados dentro del área de análisis de 20 km.</span><span>@(9 + pagina)</span></div>
    </section>
}
<template id="convocatoria-detail-slide-template">
    <section class="pam-slide pam-slide--content" data-slide aria-hidden="true">
        <header class="pam-lamina-head"><span class="pam-lamina-head__kicker">Mixtos II · Detalle de fuentes</span><span class="pam-lamina-head__aside" data-detail-context></span></header>
        <h2 class="pam-lamina-title" data-detail-title></h2>
        <div class="pam-lamina-body convocatoria-detail-table" data-detail-body></div>
        <div class="pam-lamina-foot"><span data-detail-note></span><span></span></div>
    </section>
</template>
<section class="pam-slide pam-slide--content" data-slide data-index-group="Territorio" data-label="Cobertura del análisis" data-screen-label="11">
    <header class="pam-lamina-head"><span class="pam-lamina-head__kicker">Mixtos II · Evidencia</span><span class="pam-lamina-head__aside">Fuentes consultadas y pendientes</span></header>
    <h2 class="pam-lamina-title">Fuentes y alcance</h2>
    <div class="pam-lamina-body convocatoria-analysis-evidence" data-convocatoria-analysis-evidence><p>Preparando fuentes y resultados…</p></div>
    <div class="pam-lamina-foot"><span>Fuentes institucionales consultadas para el análisis geoespacial.</span><span>11</span></div>
</section>
