@model NSIE.Models.ProyectosPrivados.CarteraConvocatoriaFichaViewModel
@using NSIE.Models.ProyectosPrivados
@using static NSIE.Models.ProyectosPrivados.ConvocatoriaFichaCampos
@{
    var d = Model.Dossier;
    var p = Model.Project;
    var tecnico = d.Registro();
    var consorcio = d.Valor("¿La solicitud es presentada por un consorcio?");
    var oir = Tiene(d.Valor("Persona Escuchar")) ? d.Valor("Persona Escuchar") : d.Valor("Oir");
    var fila = tecnico == null ? "" : $"BD_MIXTOS_II · fila {tecnico.Row}";
}
<section class="pam-slide pam-slide--content" data-slide data-index-group="El proyecto" data-label="Promovente y modalidad">
    <header class="pam-lamina-head"><span class="pam-lamina-head__kicker">Mixtos II · Solicitud</span><span class="pam-lamina-head__aside">@p.Folio</span></header>
    <h2 class="pam-lamina-title">Promovente y modalidad</h2>
    <div class="pam-lamina-body conv-page">
        <div class="convocatoria-summary__metrics">
            <article class="is-guinda"><span><i class="bi bi-diagram-2" aria-hidden="true"></i>Modalidad de asociación con CFE</span><strong>@d.Dato("Modalidad de asociación con CFE en el Esquema de Desarrollo Mixto", 1, "No informada")</strong><small>Esquema de Desarrollo Mixto</small></article>
            <article class="is-dorado"><span><i class="bi bi-people" aria-hidden="true"></i>Grupo de interés</span><strong>@Texto(p.InterestGroup ?? d.Valor("Grupo de Interés"))</strong></article>
            <article class="is-verde"><span><i class="bi bi-building" aria-hidden="true"></i>Consorcio</span><strong>@BanderaTexto(consorcio)</strong><small>@(EsSi(consorcio) ? Texto(d.Valor("Nombre del consorcio"), "Nombre no informado") : "Solicitud individual" )</small></article>
            <article><span><i class="bi bi-calendar-check" aria-hidden="true"></i>Registro en ventanilla</span><strong>@Fecha(d.Valor("Fecha Firma Proyecto"))</strong><small>Estado: @d.Dato("Registro")</small></article>
        </div>
        <dl class="conv-facts">
            <div><dt><i class="bi bi-person-badge" aria-hidden="true"></i>Promovente / razón social</dt><dd>@Texto(p.Company ?? d.Valor("Nombre"))</dd></div>
            <div><dt><i class="bi bi-person-check" aria-hidden="true"></i>Representante</dt><dd>@d.Dato("Representante")</dd></div>
            <div class="is-wide"><dt><i class="bi bi-ear" aria-hidden="true"></i>Personas autorizadas para oír y recibir notificaciones</dt><dd>@Texto(oir)</dd></div>
            <div><dt><i class="bi bi-envelope" aria-hidden="true"></i>Correo electrónico</dt><dd>@d.Dato("Email")</dd></div>
            <div><dt><i class="bi bi-telephone" aria-hidden="true"></i>Teléfono</dt><dd>@d.Dato("Teléfono")</dd></div>
            <div><dt><i class="bi bi-geo" aria-hidden="true"></i>Domicilio fiscal</dt><dd>@Recorte(d.Valor("Domicilio Fiscal"), 190)</dd></div>
            <div><dt><i class="bi bi-mailbox" aria-hidden="true"></i>Domicilio para notificaciones</dt><dd>@Recorte(d.Valor("Domicilio Notificaciones"), 190)</dd></div>
            @if (EsSi(consorcio)) {
                <div class="is-wide"><dt><i class="bi bi-people-fill" aria-hidden="true"></i>Integrantes del consorcio</dt><dd>@Recorte(d.Valor("Nombre, razón o denominación social de los integrantes del consorcio"), 260)</dd></div>
            }
            <div class="is-wide"><dt><i class="bi bi-briefcase" aria-hidden="true"></i>Entidad que actuará como socio del proyecto</dt><dd>@Recorte(d.Valor("Indicar entidad que actuará como socio del proyecto"), 220)</dd></div>
        </dl>
        <p class="conv-note conv-note--privacidad"><i class="bi bi-shield-lock" aria-hidden="true"></i> Datos de contacto declarados por el promovente en su solicitud. Información de uso institucional.</p>
    </div>
    <div class="pam-lamina-foot"><span>@Model.Fuente("solicitud registrada en ventanilla")</span><span class="pam-lamina-foot__meta"></span></div>
</section>
