@model NSIE.Models.ProyectosPrivados.CarteraConvocatoriaFichaViewModel
@using NSIE.Models.ProyectosPrivados
@using static NSIE.Models.ProyectosPrivados.ConvocatoriaFichaCampos
@{
    var d = Model.Dossier;
    var p = Model.Project;
    var tecnico = d.Registro();
    var fila = tecnico == null ? "" : $"BD_MIXTOS_II · fila {tecnico.Row}";
    var epc = d.Valor("¿Busco responsabilidad sobre la negociación y selección del EPC?");
    var financiamiento = d.Valor("¿Busco liderar negociación del contrato de financiamiento?");
    var deuda = d.Valor("¿Tengo disponibilidad para consolidación de la deuda en mis EEFF?");
    var recursos = d.Valor("¿Cuento con los principales recursos técnicos, personal especializado, equipos reservados, entre otros, para el desarrollo del proyecto?");
}
<section class="pam-slide pam-slide--content" data-slide data-index-group="El proyecto" data-label="Capacidad técnica y financiera">
    <header class="pam-lamina-head"><span class="pam-lamina-head__kicker">Mixtos II · Solicitud</span><span class="pam-lamina-head__aside">@p.Folio</span></header>
    <h2 class="pam-lamina-title">Capacidad técnica y financiera</h2>
    <div class="pam-lamina-body conv-page">
        <div class="conv-two">
            <article class="conv-card is-verde">
                <h3><i class="bi bi-gear-wide-connected" aria-hidden="true"></i>Capacidad técnica declarada</h3>
                <dl class="conv-facts conv-facts--compact">
                    <div class="is-wide"><dt>Capacidad instalada total / proyectos relevantes</dt><dd>@Recorte(d.Valor("Capacidad instalada total/proyectos relevantes"), 210)</dd></div>
                    <div class="is-wide"><dt>Experiencia desarrollando y operando renovables</dt><dd>@Recorte(d.Valor("Experiencia desarrollando y operando proyectos renovables"), 210)</dd></div>
                    <div class="is-wide"><dt>Experiencia en sistemas de almacenamiento (SAE)</dt><dd>@Recorte(d.Valor("Experiencia desarrollando y operando SAEE"), 210)</dd></div>
                    <div class="is-wide"><dt>Convenios estratégicos con contratistas</dt><dd>@Recorte(d.Valor("Principales convenios estratégicos con posibles contratistas."), 150)</dd></div>
                    <div class="is-wide"><dt>Grado de avance (proyectos en desarrollo)</dt><dd>@Recorte(d.Valor("Grado de avance para el caso de proyectos en desarrollo"), 170)</dd></div>
                </dl>
                <ul class="conv-flags conv-flags--single">
                    <li class="@Bandera(recursos)"><i class="bi @(EsSi(recursos) ? "bi-check-circle-fill" : EsNo(recursos) ? "bi-x-circle-fill" : "bi-dash-circle")" aria-hidden="true"></i><span>Cuenta con recursos técnicos, personal especializado y equipos reservados</span><strong>@BanderaTexto(recursos)</strong></li>
                </ul>
            </article>
            <article class="conv-card">
                <h3><i class="bi bi-bank" aria-hidden="true"></i>Capacidad financiera declarada</h3>
                <dl class="conv-facts conv-facts--compact">
                    <div class="is-wide"><dt>Activos bajo gestión / capitalización bursátil</dt><dd>@Recorte(d.Valor("Activos bajo gestión, y en su caso capitalización bursátil"), 170)</dd></div>
                    <div class="is-wide"><dt>Fuente de los fondos</dt><dd>@Recorte(d.Valor("Fuente de los fondos"), 170)</dd></div>
                    <div class="is-wide"><dt>Disponibilidad de los fondos en el tiempo</dt><dd>@Recorte(d.Valor("Disponibilidad de los fondos en términos de tiempos"), 170)</dd></div>
                </dl>
                <ul class="conv-flags conv-flags--single">
                    <li class="@Bandera(epc)"><i class="bi @(EsSi(epc) ? "bi-check-circle-fill" : EsNo(epc) ? "bi-x-circle-fill" : "bi-dash-circle")" aria-hidden="true"></i><span>Busca responsabilidad sobre negociación y selección del EPC</span><strong>@BanderaTexto(epc)</strong></li>
                    <li class="@Bandera(financiamiento)"><i class="bi @(EsSi(financiamiento) ? "bi-check-circle-fill" : EsNo(financiamiento) ? "bi-x-circle-fill" : "bi-dash-circle")" aria-hidden="true"></i><span>Busca liderar la negociación del contrato de financiamiento</span><strong>@BanderaTexto(financiamiento)</strong></li>
                    <li class="@Bandera(deuda)"><i class="bi @(EsSi(deuda) ? "bi-check-circle-fill" : EsNo(deuda) ? "bi-x-circle-fill" : "bi-dash-circle")" aria-hidden="true"></i><span>Disponibilidad para consolidar la deuda en sus estados financieros</span><strong>@BanderaTexto(deuda)</strong></li>
                </ul>
                @if (Tiene(d.Valor("Justificación de la negativa"))) { <p><strong>Justificación:</strong> @Recorte(d.Valor("Justificación de la negativa"), 160)</p> }
            </article>
        </div>
    </div>
    <div class="pam-lamina-foot"><span>@Model.Fuente("solicitud registrada en ventanilla") Información declarada por el promovente.</span><span class="pam-lamina-foot__meta"></span></div>
</section>
