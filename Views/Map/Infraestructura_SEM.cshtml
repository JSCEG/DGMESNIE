@using Microsoft.AspNetCore.Http
@using Newtonsoft.Json
@using NSIE.Models
@inject IHttpContextAccessor HttpContextAccessor

@{
    var httpContext = HttpContextAccessor.HttpContext;
    var perfilUsuarioJson = httpContext.Session.GetString("PerfilUsuario");
    var perfilUsuario = string.IsNullOrEmpty(perfilUsuarioJson) ? null : JsonConvert.DeserializeObject<PerfilUsuario>(perfilUsuarioJson);

    ViewData["NombreUsuario"] = perfilUsuario?.Nombre ?? "Invitado";
    ViewData["MercadoUsuario"] = perfilUsuario?.Mercado_ID;
    ViewData["Title"] = "Infraestructura del Sector Energético Mexicano";

    var header = new HeaderViewModel
    {
        Title = "Mapa de Infraestructura",
        IconPath = "geo.png",
        Description = "Permisos de petrolíferos, gas LP, gas natural y generación eléctrica, con ductos y límites estatales.",
        Section = "📊 Datos Públicos",
        ModuleInfo = JsonConvert.SerializeObject(new
        {
            title = "Mapa de Infraestructura",
            description = "Sistema de visualización geográfica de infraestructura energética.",
            functionality = "Enciende capas por mercado, busca por número de permiso, razón social, estado o municipio y genera la ficha en PDF de cada permiso.",
            stage = "Consulta Visual",
            roles = new[] {
                new { icon = "building", text = "SENER: Coordinación general" },
                new { icon = "bolt", text = "CFE: Infraestructura eléctrica" },
                new { icon = "chart-line", text = "CENACE: Control operativo" },
                new { icon = "map-marked-alt", text = "Estados: Información local" },
                new { icon = "city", text = "Municipios: Datos territoriales" },
                new { icon = "industry", text = "Empresas: Activos privados" }
            },
            order = new { step = 12, description = "Georreferenciación de activos" }
        }),
        LegalDescription = "Visualización de infraestructura conforme al Art. 77 del Reglamento.",
        Fundamentos = new List<FundamentoLegal> {
            new() { Reference = "Art. 77 Reglamento", Description = "Establece los lineamientos para la georreferenciación de infraestructura" }
        }
    };
}

@section Styles {
    <link rel="stylesheet" href="~/css/infraestructura-sem.css" asp-append-version="true" />
}

@await Html.PartialAsync("_ViewHeader", header)

<div class="container-fluid px-lg-4">
    <p class="sem-aviso">
        En electricidad, la ubicación corresponde a la dirección declarada en el permiso y puede diferir de la ubicación física de la central.
    </p>

    <div class="sem-app" id="semApp">
        <div class="sem-bar">
            <div class="sem-bar-title">
                <strong>Infraestructura energética</strong>
                <span>Permisos CRE/CNE, ductos y límites</span>
            </div>

            <div class="sem-search" role="search">
                <div class="sem-search-box">
                    <i class="bi bi-search" aria-hidden="true"></i>
                    <input id="semQ" type="text" autocomplete="off" spellcheck="false"
                           placeholder="Permiso, razón social, estado o municipio"
                           aria-label="Buscar permiso, razón social, estado o municipio" />
                    <button type="button" id="semQClear" class="sem-search-clear" title="Limpiar búsqueda" hidden><i class="bi bi-x-lg"></i></button>
                    <button type="button" id="semQBtn" class="sem-btn" title="Ver todos los resultados"><i class="bi bi-arrow-return-left"></i></button>
                </div>
                <div id="semSuggest" class="sem-suggest" hidden></div>
            </div>

            <div class="sem-tools">
                <button type="button" id="semCapasBtn" class="sem-btn is-on" title="Capas"><i class="bi bi-layers"></i><span class="sem-btn-label">Capas</span></button>
                <button type="button" id="semMedir" class="sem-btn" title="Medir distancia"><i class="bi bi-rulers"></i></button>
                <button type="button" id="semLimpiar" class="sem-btn" title="Limpiar herramientas"><i class="bi bi-eraser"></i></button>
                <button type="button" id="semMexico" class="sem-btn" title="Ver todo México"><i class="bi bi-globe-americas"></i></button>
                <button type="button" id="semPantalla" class="sem-btn" title="Pantalla completa"><i class="bi bi-arrows-fullscreen"></i></button>
            </div>
        </div>

        <div class="sem-body">
            <div id="map" class="sem-map"></div>

            <aside id="semCapas" class="sem-panel sem-panel--capas" aria-label="Capas">
                <div class="sem-panel-head">
                    <h3>Capas</h3>
                    <button type="button" id="semCapasCerrar" class="sem-panel-close" title="Cerrar"><i class="bi bi-x-lg"></i></button>
                </div>
                <div class="sem-panel-body">
                    <div class="sem-section">Permisos</div>
                    <div class="sem-filter">
                        <button type="button" data-estatus="todos" class="is-on">Todos</button>
                        <button type="button" data-estatus="vigentes">Solo vigentes</button>
                    </div>
                    <div id="semCapasPermisos"></div>

                    <div class="sem-section">Infraestructura</div>
                    <label class="sem-layer">
                        <input type="checkbox" data-extra="ductos-pet">
                        <span class="sem-swatch-line" style="color:#7A2E14"></span>
                        <span class="sem-layer-name">Ductos de petrolíferos</span>
                    </label>
                    <label class="sem-layer">
                        <input type="checkbox" data-extra="ductos-glp">
                        <span class="sem-swatch-line" style="color:#A57F2C;border-top-style:dashed"></span>
                        <span class="sem-layer-name">Ductos de gas LP</span>
                    </label>

                    <div class="sem-section">Referencia</div>
                    <label class="sem-layer">
                        <input type="checkbox" data-extra="estados" checked>
                        <span class="sem-swatch-line" style="color:#8F8882;border-top-width:1px"></span>
                        <span class="sem-layer-name">Límites estatales</span>
                    </label>
                    <label class="sem-layer">
                        <input type="checkbox" data-extra="radar">
                        <i class="bi bi-cloud-rain" style="width:22px;text-align:center"></i>
                        <span class="sem-layer-name">Radar de lluvia<small>RainViewer · último cuadro</small></span>
                    </label>

                    <div class="sem-section">Mapa base</div>
                    <div class="sem-bases">
                        <label><input type="radio" name="semBase" value="claro" checked> Claro</label>
                        <label><input type="radio" name="semBase" value="oscuro"> Oscuro</label>
                        <label><input type="radio" name="semBase" value="calles"> Calles</label>
                        <label><input type="radio" name="semBase" value="satelite"> Satélite</label>
                    </div>

                    <div id="semCorte" class="sem-corte"></div>
                </div>
            </aside>

            <aside id="semResultados" class="sem-panel sem-panel--resultados" aria-label="Resultados de búsqueda" hidden>
                <div class="sem-panel-head">
                    <h3 id="semResTitulo">Resultados</h3>
                    <button type="button" id="semResCerrar" class="sem-panel-close" title="Cerrar"><i class="bi bi-x-lg"></i></button>
                </div>
                <div id="semResResumen" class="sem-res-resumen"></div>
                <div class="sem-res-acciones">
                    <button type="button" id="semResMapa" class="sem-btn"><i class="bi bi-pin-map"></i><span>Ver en mapa</span></button>
                    <button type="button" id="semResCsv" class="sem-btn"><i class="bi bi-filetype-csv"></i><span>Exportar</span></button>
                </div>
                <div id="semResLista" class="sem-panel-body"></div>
                <div id="semResNota" class="sem-res-nota"></div>
            </aside>

            <div class="sem-legend" aria-hidden="true">
                <div><i style="background:#C0552E"></i>Petrolíferos</div>
                <div><i style="background:#E0A12E"></i>Gas LP</div>
                <div><i style="background:#2E6FB0"></i>Gas natural</div>
                <div><i style="background:#9B2247"></i>Generación eléctrica</div>
            </div>

            <div id="semStatus" class="sem-status" role="status" hidden></div>
        </div>
    </div>
</div>

@section Scripts {
    <script>window.SEM_CDN = '@Cdn.Url';</script>
    <script src="@Cdn.Url/Geovisualizador/shapes/estadosminlight.js"></script>
    <script src="@Cdn.Url/Geovisualizador/data/ductos_petroliferos_4326_0.js"></script>
    <script src="@Cdn.Url/Geovisualizador/data/ductos_glp_4326_0.js"></script>
    <script src="~/js/infraestructura-sem-mapa.js" asp-append-version="true"></script>
}
