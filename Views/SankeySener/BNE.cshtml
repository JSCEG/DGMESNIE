                    description.textContent = nodeInfo.description;
                    description.style.cssText = 'text-align: center; margin: 0 0 2rem 0; color: var(--color-gris-oscuro); font-size: 1rem; font-style: italic; max-width: 600px; margin-left: auto; margin-right: auto;';
                } else {
                    description.style.display = 'none';
                }

                // Contenedor del gráfico
                const chartContainer = document.createElement('div');
                chartContainer.style.cssText = 'width: 800px; height: 500px; margin: 0 auto 2rem auto; border: 1px solid #ddd;';

                // Leyenda
                const legendContainer = document.createElement('div');
                legendContainer.style.cssText = 'margin-top: 2rem; padding: 1.5rem; border: 1px solid #ddd; border-radius: 8px; background-color: #f9f9f9;';

                const legendHeader = document.createElement('div');
                legendHeader.style.cssText = 'display:flex; align-items:center; justify-content:space-between; gap:1rem; margin-bottom:0.5rem;';

                const legendTitle = document.createElement('h4');
                legendTitle.textContent = 'Leyenda de Colores - Sub-Sankey';
                legendTitle.style.cssText = 'text-align: left; margin: 0; color: var(--color-guinda);';

                const legendToolbar = document.createElement('div');
                const showAllBtn = document.createElement('button');
                showAllBtn.textContent = 'Ver todas';
                showAllBtn.style.cssText = 'padding:6px 10px; border:1px solid #ddd; border-radius:6px; background:#fff; cursor:pointer; margin-right:6px;';
                const hideAllBtn = document.createElement('button');
                hideAllBtn.textContent = 'Ocultar elementos';
                hideAllBtn.style.cssText = 'padding:6px 10px; border:1px solid #ddd; border-radius:6px; background:#fff; cursor:pointer;';
                legendToolbar.appendChild(showAllBtn);
                legendToolbar.appendChild(hideAllBtn);
                legendHeader.appendChild(legendTitle);
                legendHeader.appendChild(legendToolbar);

                const legendNote = document.createElement('p');
                legendNote.textContent = 'Energéticos presentes en el diagrama detallado';
                legendNote.style.cssText = 'text-align: left; margin: 0 0 1rem 0; color: var(--color-gris-oscuro); font-size: 0.8rem; font-style: italic;';

                const legendContent = document.createElement('div');
                legendContent.style.cssText = 'display: flex; flex-direction: column; gap: 0.5rem; font-size: 0.9rem; max-width: 100%;';

                // Generar leyenda basada en los nodos del sub-sankey
                let selectedNodes = new Set();
                let originalSubOption = null;
                if (subSankeyChart) {
                    const subOption = subSankeyChart.getOption();
                    originalSubOption = subOption;
                    if (subOption && subOption.series && subOption.series[0] && subOption.series[0].data) {
                        const subSankeyNodes = subOption.series[0].data
                            .filter(node => !node.name.startsWith('SPACER') &&
                                !node.esEspaciador &&
                                node.itemStyle &&
                                node.itemStyle.color)
                            .sort((a, b) => a.name.localeCompare(b.name));

                        const legendGrid = document.createElement('div');
                        legendGrid.style.cssText = 'display: grid; grid-template-columns: repeat(auto-fit, minmax(220px, 1fr)); gap: 0.75rem; width: 100%;';

                        const checkboxRefs = [];
                        subSankeyNodes.forEach(node => {
                            selectedNodes.add(node.name);
                            const legendItem = document.createElement('label');
                            legendItem.style.cssText = 'display: flex; align-items: center; gap: 0.5rem; padding: 0.5rem; background: white; border-radius: 6px; border: 1px solid #e0e0e0; cursor: pointer;';

                            const checkbox = document.createElement('input');
                            checkbox.type = 'checkbox';
                            checkbox.checked = true;
                            checkbox.style.cssText = 'accent-color: var(--color-guinda);';
                            checkboxRefs.push({ checkbox, nodeName: node.name });

                            const colorBox = document.createElement('div');
                            colorBox.style.cssText = `width: 14px; height: 14px; background-color: ${node.itemStyle.color}; border-radius: 3px; border: 1px solid #ccc; flex-shrink: 0;`;

                            const label = document.createElement('span');
                            label.textContent = node.name;
                            label.style.cssText = 'font-size: 0.9rem; font-weight: 500;';

                            checkbox.addEventListener('change', () => {
                                if (checkbox.checked) {
                                    selectedNodes.add(node.name);
                                } else {
                                    selectedNodes.delete(node.name);
                                }
                                updatePreviewChart();
                            });

                            legendItem.appendChild(checkbox);
                            legendItem.appendChild(colorBox);
                            legendItem.appendChild(label);
                            legendGrid.appendChild(legendItem);
                        });

                        legendContent.appendChild(legendGrid);

                        // Toolbar actions: select/deselect all
                        showAllBtn.addEventListener('click', () => {
                            checkboxRefs.forEach(ref => { ref.checkbox.checked = true; selectedNodes.add(ref.nodeName); });
                            updatePreviewChart();
                        });
                        hideAllBtn.addEventListener('click', () => {
                            checkboxRefs.forEach(ref => { ref.checkbox.checked = false; selectedNodes.delete(ref.nodeName); });
                            updatePreviewChart();
                        });

                        function updatePreviewChart() {
                            if (!originalSubOption || !originalSubOption.series || !originalSubOption.series[0]) return;
                            const baseSeries = originalSubOption.series[0];
                            const nodes = (baseSeries.data || []).filter(n => selectedNodes.has(n.name) && (!n.name.startsWith('SPACER')) && (!!activeCategories[n.category]));
                            const selectedSet = new Set(nodes.map(n => n.name));
                            const links = (baseSeries.links || baseSeries.edges || []).filter(l => selectedSet.has(l.source) && selectedSet.has(l.target));
                            const newOption = { series: [{ ...baseSeries, data: nodes, links: links }] };
                            previewChart.setOption(newOption, true);
                        }

                        function renderModalCategoryFilters() {
                            const container = document.getElementById('legend-container');
                            if (!container) return;
                            const counts = {};
                            Object.keys(window.sankeyConfig?.categoryColors || {}).forEach(c => counts[c] = 0);
                            subSankeyNodes.forEach(n => { if (n.category && counts[n.category] !== undefined) counts[n.category]++; });

                            container.innerHTML = '';
                            Object.entries(window.sankeyConfig.categoryColors || {}).forEach(([cat, color]) => {
                                const item = document.createElement('div');
                                item.className = `filter-item ${activeCategories[cat] ? 'active' : 'inactive'}`;
                                item.style.cssText = 'display:inline-flex; align-items:center; gap:6px; border:1px solid #ddd; border-radius:999px; padding:6px 10px; cursor:pointer;';
                                const swatch = document.createElement('span');
                                swatch.style.cssText = `width:10px; height:10px; border-radius:2px; background:${color}; display:inline-block;`;
                                const label = document.createElement('span');
                                label.textContent = cat;
                                label.style.cssText = 'font-size:12px; font-weight:600; color:#555;';
                                const countDiv = document.createElement('span');
                                countDiv.textContent = counts[cat] || 0;
                                countDiv.style.cssText = 'font-size:11px; background:#eef; color:#333; border-radius:999px; padding:2px 6px;';
                                item.appendChild(swatch);
                                item.appendChild(label);
                                item.appendChild(countDiv);
                                item.addEventListener('click', () => {
                                    activeCategories[cat] = !activeCategories[cat];
                                    item.className = `filter-item ${activeCategories[cat] ? 'active' : 'inactive'}`;
                                    updatePreviewChart();
                                });
                                container.appendChild(item);
                            });
                        }

                        renderModalCategoryFilters();
                    }
                }

                // Ensamblar vista previa
                container.appendChild(mainTitle);
                container.appendChild(subtitle);
                if (description.textContent) {
                    container.appendChild(description);
                }
                container.appendChild(chartContainer);
                legendContainer.appendChild(legendHeader);
                legendContainer.appendChild(legendNote);
                legendContainer.appendChild(legendContent);
                container.appendChild(legendContainer);

                // Crear gráfico en el contenedor de vista previa
                const previewChart = echarts.init(chartContainer);
                if (subSankeyChart) {
                    const originalOption = subSankeyChart.getOption();
                    previewChart.setOption(originalOption);
                }

                // Configurar botón de exportación
                document.getElementById('export-subsankey').onclick = () => {
                    exportSubSankey(previewChart);
                };
            }

            // Compatibilidad: función utilizada por acciones antiguas para abrir el modal y generar la vista previa
            function exportSubSankeyWithLegend(openModal = true) {
                const previewContainer = document.getElementById('export-preview-container');
                if (!subSankeyChart) {
                    alert('Por favor, selecciona un energético primero para generar el sub-sankey.');
                    return;
                }
                createExportPreview(previewContainer);
                if (openModal) {
                    const exportModal = document.getElementById('export-modal');
                    exportModal.style.display = 'block';
                }
            }
            function exportSubSankey(chartInstance) {
                if (!chartInstance) {
                    alert('No hay sub-Sankey disponible para exportar');
                    return;
                }

                // Función para exportar con un fondo específico
                function exportWithSpecificBackground(useWhiteBackground) {
                    new Promise(resolve => {
                        const handler = () => {
                            chartInstance.off('rendered', handler);
                            resolve();
                        };
                        chartInstance.on('rendered', handler);

                        if (!chartInstance.isDisposed() && chartInstance.getOption()) {
                            resolve();
                        }
                    }).then(() => {
                        const chartUrl = chartInstance.getDataURL({
                            type: 'png',
                            pixelRatio: 3,
                            backgroundColor: 'rgba(0,0,0,0)', // Siempre transparente desde ECharts
                            excludeComponents: []
                        });

                        const chartImg = new Image();
                        chartImg.onload = function () {
                            const canvas = document.createElement('canvas');
                            const ctx = canvas.getContext('2d');

                            canvas.width = chartImg.width;
                            canvas.height = chartImg.height;

                            if (useWhiteBackground) {
                                ctx.fillStyle = '#ffffff';
                                ctx.fillRect(0, 0, canvas.width, canvas.height);
                            } else {
                                ctx.clearRect(0, 0, canvas.width, canvas.height);
                            }

                            ctx.drawImage(chartImg, 0, 0);

                            const finalUrl = canvas.toDataURL('image/png');
                            const link = document.createElement('a');
                            const subtitleText = document.getElementById('sub-sankey-subtitle').textContent;
                            const baseName = cleanFileName(subtitleText.split(' - ')[0]);
                            const year = yearSelector.value;
                            const prefix = currentLegendOrder !== null ?
                                `${currentLegendOrder}.-BNE_${year}_${useWhiteBackground ? '' : 'transparente_'} subsankey_` :
                                `BNE_${year}_subsankey_${useWhiteBackground ? '' : 'transparente_'} `;
                            link.download = `${prefix}${baseName}.png`;
                            link.href = finalUrl;
                            link.click();
                        };
                        chartImg.src = chartUrl;
                    });
                }

                // Exportar con fondo blanco primero
                // exportWithSpecificBackground(true);
                setTimeout(() => {
                    exportWithSpecificBackground(true);
                }, 1500);
                // Exportar con fondo transparente después de un delay
                setTimeout(() => {
                    exportWithSpecificBackground(false);
                }, 3000);
            }

            // Función para manejar clic en nodos (desde leyenda o diagrama)
            function handleNodeClick(nodeName) {
                // Verificar si es un nodo energético válido
                const nodeInfo = allNodes.get(nodeName);
                if (!nodeInfo || nodeInfo.esEspaciador) {
                    console.log('Not an energetic node or spacer.');
                    document.getElementById('node-details-container').style.display = 'none';
                    return;
                }

                // Actualizar información del nodo (compatibilidad con layouts anteriores)
                const nameEl = document.getElementById('node-details-name');
                if (nameEl) {
