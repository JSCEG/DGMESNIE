                                            <span class="tw-text-[11px] tw-font-bold tw-text-slate-400 dark:tw-text-slate-500 tw-uppercase tw-tracking-widest tw-mb-2 tw-block">Entrada Seleccionada</span>
                                            <div class="tw-text-2xl tw-font-black tw-text-slate-800 dark:tw-text-white tw-mb-3">${finalInflowSubtotal.toLocaleString('es-MX', { minimumFractionDigits: 2, maximumFractionDigits: 2 })} <span class="tw-text-sm tw-font-medium tw-text-slate-400 dark:tw-text-slate-500 tw-ml-1">PJ</span></div>
                                            <div class="tw-w-full tw-h-1 tw-bg-slate-100 dark:tw-bg-slate-800 tw-rounded-full tw-overflow-hidden">
                                                <div class="tw-w-full tw-h-full tw-bg-blue-500"></div>
                                            </div>
                                        </div>
                                        
                                        <!-- Salida Seleccionada -->
                                        <div class="tw-bg-white dark:tw-bg-card-dark tw-p-5 tw-rounded-xl tw-border tw-border-slate-200 dark:tw-border-slate-800 tw-shadow-sm">
                                            <span class="tw-text-[11px] tw-font-bold tw-text-slate-400 dark:tw-text-slate-500 tw-uppercase tw-tracking-widest tw-mb-2 tw-block">Salida Seleccionada</span>
                                            <div class="tw-text-2xl tw-font-black tw-text-slate-800 dark:tw-text-white tw-mb-3">${finalOutflowSubtotal.toLocaleString('es-MX', { minimumFractionDigits: 2, maximumFractionDigits: 2 })} <span class="tw-text-sm tw-font-medium tw-text-slate-400 dark:tw-text-slate-500 tw-ml-1">PJ</span></div>
                                            <div class="tw-w-full tw-h-1 tw-bg-slate-100 dark:tw-bg-slate-800 tw-rounded-full tw-overflow-hidden">
                                                <div class="tw-w-full tw-h-full tw-bg-primary"></div>
                                            </div>
                                        </div>
                                        
                                        <!-- Balance Seleccionado -->
                                        <div class="tw-bg-white dark:tw-bg-card-dark tw-p-5 tw-rounded-xl tw-border ${selectedBalance >= 0 ? 'tw-border-primary/20 dark:tw-border-primary/40' : 'tw-border-red-200 dark:tw-border-red-900'} tw-shadow-sm ${selectedBalance >= 0 ? 'tw-bg-gradient-to-br tw-from-white tw-to-primary/5 dark:tw-from-card-dark dark:tw-to-primary/10' : 'tw-bg-gradient-to-br tw-from-white tw-to-red-50 dark:tw-from-card-dark dark:tw-to-red-950/10'}">
                                            <span class="tw-text-[11px] tw-font-bold ${selectedBalance >= 0 ? 'tw-text-primary' : 'tw-text-red-500'} tw-uppercase tw-tracking-widest tw-mb-2 tw-block">Balance Seleccionado</span>
                                            <div class="tw-text-2xl tw-font-black ${selectedBalance >= 0 ? 'tw-text-primary' : 'tw-text-red-600'} tw-mb-3">${selectedBalance.toLocaleString('es-MX', { minimumFractionDigits: 2, maximumFractionDigits: 2 })} <span class="tw-text-sm tw-font-medium ${selectedBalance >= 0 ? 'tw-text-primary/60' : 'tw-text-red-500/60'} tw-ml-1">PJ</span></div>
                                            <div class="tw-text-[11px] tw-font-semibold ${selectedBalance >= 0 ? 'tw-text-slate-500' : 'tw-text-red-600'} tw-flex tw-items-center tw-gap-1">
                                                <span class="material-icons-outlined text-xs">${selectedBalance >= 0 ? 'check_circle' : 'error'}</span>
                                                ${selectedBalance >= 0 ? 'EQUILIBRADO' : 'DESBALANCE'}
                                            </div>
                                        </div>
                                    </div>
                                    
                                    <!-- Barra de Eficiencia -->`;

                                if (finalInflowSubtotal > 0) {
                                    const lossPercentage = (finalInflowSubtotal - finalOutflowSubtotal) / finalInflowSubtotal;
                                    const efficiency = 1 - lossPercentage;
                                    let efficiencyColor = 'tw-bg-green-500';
                                    let efficiencyMessage = 'Eficiencia en Selección';
                                    let efficiencyIcon = 'check_circle';
