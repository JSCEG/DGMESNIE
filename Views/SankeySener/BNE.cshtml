<style>
    .sparkline {
        stroke: #9F2241;
        stroke-width: 2;
        fill: none;
    }

    .custom-scrollbar::-webkit-scrollbar {
        width: 6px;
    }

    .custom-scrollbar::-webkit-scrollbar-track {
        background: transparent;
    }

    .custom-scrollbar::-webkit-scrollbar-thumb {
        background: #e2e8f0;
        border-radius: 10px;
    }

    .dark .custom-scrollbar::-webkit-scrollbar-thumb {
        background: #334155;
    }

    .legend-group-column {
        flex: 1;
        min-width: 200px;
        max-width: 250px;
        display: flex;
        flex-direction: column;
        gap: 0.5rem;
    }

    .legend-group-title {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 0.35rem;
        width: 100%;
        border-radius: 6px;
        border: none;
        padding: 0.35rem 0.5rem;
        font-size: 0.65rem;
        font-weight: 800;
        text-transform: uppercase;
        letter-spacing: 0.5px;
        cursor: pointer;
        transition: all 0.2s cubic-bezier(0.4, 0, 0.2, 1);
        box-shadow: 0 1px 2px rgba(0, 0, 0, 0.05);
    }

    .legend-group-title.is-active {
        background: var(--color-guinda);
        color: black;
        box-shadow: 0 4px 6px -1px rgba(106, 28, 50, 0.2), 0 2px 4px -1px rgba(106, 28, 50, 0.1);
        transform: translateY(-1px);
    }

    .legend-group-title.is-active:hover {
        background: #7a1b38;
        color: white;
    }

    .legend-group-title.is-inactive {
        background: #f3f4f6;
        color: #9ca3af;
        box-shadow: none;
        opacity: 0.8;
    }

    .legend-group-title.is-inactive:hover {
        background: #e5e7eb;
        color: #6b7280;
        opacity: 1;
    }

    .legend-group-title:focus {
        outline: 2px solid rgba(106, 28, 50, 0.35);
        outline-offset: 2px;
    }

    .legend-group-items {
        display: flex;
        flex-direction: column;
        gap: 0.3rem;
    }

    #color-legend-container.legend-collapsed .legend-group-items {
        display: none;
    }

    #color-legend-container.legend-collapsed #color-legend-content {
        gap: 0.75rem;
    }

    .legend-item-card {
        transition: all 0.2s cubic-bezier(0.4, 0, 0.2, 1);
    }

    .legend-item-card:hover {
        transform: translateY(-2px);
        box-shadow: 0 8px 16px -2px rgba(159, 34, 65, 0.1);
    }

    /* Estilos para tarjetas de categoría */
    .category-card {
        position: relative;
        overflow: hidden;
    }

    .category-card::before {
        content: '';
        position: absolute;
        top: 0;
        left: 0;
        right: 0;
        height: 3px;
        background: linear-gradient(to right, #9F2241, #FF6B6B);
        opacity: 0;
        transition: opacity 0.3s ease;
    }

    .category-card:hover::before {
        opacity: 1;
    }

    .category-card p {
        margin: 0;
    }

    .modal {
        position: fixed;
        inset: 0;
        z-index: 10000;
        background-color: rgba(0,0,0,0.5);
        backdrop-filter: blur(4px);
    }

    .preloader {
        position: fixed;
        inset: 0;
        z-index: 9999;
        display: flex;
        align-items: center;
        justify-content: center;
    }

    /* Fondo blur */
    .preloader-overlay {
        position: absolute;
        inset: 0;
        background: rgba(0,0,0,0.4);
        backdrop-filter: blur(6px);
    }

    /* Card */
    .preloader-card {
        position: relative;
        z-index: 2;
        width: 320px;
        padding: 2rem;
        border-radius: 16px;
        background: rgba(255,255,255,0.95);
        text-align: center;
        box-shadow: 0 20px 50px rgba(0,0,0,0.2);
        animation: fadeIn 0.4s ease;
    }

    .logo-container {
        display: flex;
        justify-content: center;
        align-items: center;
        width: 100%;
    }

    /* Logo */
    .logo-container img {
        display: block;
        width: 80px;
        height: 80px;
        object-fit: contain;
        margin-bottom: 1rem;
        animation: float 2s ease-in-out infinite;
        margin: 0 auto; /* 🔥 clave */
    }

    /* Títulos */
    .title {
        font-size: 1.2rem;
        font-weight: 700;
        margin-bottom: 0.5rem;
    }

    .message {
        font-size: 0.9rem;
        color: #6b7280;
        margin-bottom: 1rem;
    }

    /* Spinner */
    .spinner {
        width: 30px;
        height: 30px;
        border: 3px solid #eee;
        border-top: 3px solid #9F2241;
        border-radius: 50%;
        margin: 0 auto 1rem;
        animation: spin 1s linear infinite;
    }

    /* Progress bar */
    .progress-container {
        width: 100%;
        height: 6px;
        background: #eee;
        border-radius: 10px;
        overflow: hidden;
    }

    .progress-bar {
        height: 100%;
        width: 0%;
        background: linear-gradient(90deg, #9F2241, #BC955C);
        transition: width 0.3s ease;
    }

    /* Animaciones */
    @@keyframes spin {
        to { transform: rotate(360deg); }
    }

    @@keyframes float {
        0%,100% { transform: translateY(0); }
        50% { transform: translateY(-6px); }
    }

    @@keyframes fadeIn {
        from { opacity: 0; transform: scale(0.95); }
        to { opacity: 1; transform: scale(1); }
    }

</style>

