                        selectedBalanceContainer.innerHTML = balanceHtml;
                    }

                    function setupTableInteractivity(table) {
                        if (!table) return;
                        const selectAll = table.querySelector('.select-all');
                        const checkboxes = table.querySelectorAll('.flow-check, .cross-sum');

                        if (selectAll) {
