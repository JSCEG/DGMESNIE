    /* Tooltip mejorado */
    .tooltip-container {
        position: relative;
    }

    .tooltip {
        position: absolute;
        bottom: 100%;
        left: 50%;
        transform: translateX(-50%);
        background: rgba(0, 0, 0, 0.9);
        color: white;
        padding: 0.75rem 1rem;
