        color: #666;
        opacity: 0.6;
    }

    .filter-color {
        width: 16px;
        height: 16px;
        border-radius: 4px;
        border: 1px solid rgba(0, 0, 0, 0.2);
        flex-shrink: 0;
        transition: all 0.3s ease;
    }

    .filter-item.active .filter-color {
        box-shadow: 0 0 0 2px rgba(255, 255, 255, 0.8), 0 0 0 4px var(--filter-color, #2E7D32);
    }

    /* Panel lateral flotante para filtros */
    .filters-panel {
        position: fixed;
        top: 0;
        right: -400px;
        width: 380px;
        height: 100vh;
        background: rgba(255, 255, 255, 0.98);
        backdrop-filter: blur(12px);
        -webkit-backdrop-filter: blur(12px);
        border-left: 1px solid rgba(229, 231, 235, 0.6);
