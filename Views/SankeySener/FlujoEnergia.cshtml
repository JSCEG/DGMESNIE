        function conectarSecundariosATransformacion(energyFlow, hijosSec) {

            const nodoTransformacion = energyFlow.nodes['transformacion'];
            const nodoUsosFinales = energyFlow.nodes['usosFinales'];
            const nodoEnergSecundarios = energyFlow.nodes['energeticosSecundarios'];

            if (!nodoEnergSecundarios || !nodoTransformacion) return;

            const hijosTransformacion = Object.values(energyFlow.nodes)
                .filter(n => n.id.startsWith('transformacion-child-transform-'));

            const hijosSecundarios = Object.values(energyFlow.nodes)
                .filter(n => n.id.startsWith('energeticosSecundarios-child-sec-'));

            const retroalimentacion = {
                "Coque de petróleo": "Centrales Eléctricas",
                "Diesel": "Centrales Eléctricas",
                "Combustóleo": "Centrales Eléctricas",
                "Gas Seco": "Centrales Eléctricas"
            };

            const retroalimentacionCE = {
                "Coque de petróleo": "Centrales Eléctricas",
                "Diesel": "Centrales Eléctricas",
                "Combustóleo": "Centrales Eléctricas",
                "Gas Seco": "Centrales Eléctricas",
                "Energía eléctrica": "Centrales Eléctricas"
            };

            const energeticosSecundarios = [
                "Coque de petróleo",
                "Gas licuado de petróleo",
                "Gasolinas y naftas",
                "Querosenos",
                "Diesel",
                "Combustóleo",
                "Gas Seco",
                "Energía eléctrica",
                "Otros energéticos"
            ];

            const padresTransformacion = [
                "Centrales Eléctricas",
                "Refinerías y Despuntadoras",
                "Plantas de Gas y Fraccionadoras",
                "Coquizadoras y Hornos"
            ]

            // 🧹 Limpiar enlaces previos
            Object.keys(retroalimentacion).forEach(nombre => {
                const sec = hijosSecundarios.find(n => n.name === nombre);
                if (!sec) return;

                energyFlow.removeLink(sec.id, 'transformacion');
                hijosTransformacion.forEach(t => {
                    energyFlow.removeLink(sec.id, t.id);
                });
            });

            // 🟠 Ninguno expandido → agregado (balance correcto)
            if (
                !nodoEnergSecundarios.expanded &&
                !nodoTransformacion.expanded &&
                nodoUsosFinales.expanded
            ) {

                let entradaDesdeTransformacion = 0;
                let salidaHaciaTransformacion  = 0;

                // --------------------------------------------------
                // 🔼 ENTRADA: TODO Transformación → Secundarios
                // --------------------------------------------------

                padresTransformacion.forEach(padre => {
                    energeticosSecundarios.forEach(sec => {
                        entradaDesdeTransformacion += getChildValue(
                            padre,                 // 👈 cualquier nodo de Transformación
                            sec,                   // energético secundario
                            window.selectedYear,
                            "sum-out"
                        ) || 0;
                    });
                });

                // --------------------------------------------------
                // 🔽 SALIDA: Secundarios → Centrales Eléctricas
                // --------------------------------------------------
                salidaHaciaTransformacion = getValue(
                    "Centrales Eléctricas",
                    window.selectedYear,
                    "sum-in",
                    energeticosSecundarios   // 👈 solo secundarios
                );

                const neto = entradaDesdeTransformacion - salidaHaciaTransformacion;

                if (neto > 0) {
                    energyFlow.addLink({
                        from: nodoTransformacion.id,
                        to: nodoEnergSecundarios.id,
                        value: neto
                    });
                }
            }

            // 🟡 Transformación expandida
            if (nodoEnergSecundarios.expanded && !nodoTransformacion.expanded) {

                Object.entries(retroalimentacion).forEach(([sec, dest]) => {

                    const secNode = hijosSecundarios.find(n => n.name === sec);
                    if (!secNode) return;

                    const secValue = hijosSec.find(s => s.name === sec);
                    if (!secValue) return;

                    // 🔼 SALIDA: Transformación → Secundario
                    const salida = secValue.detalle?.transformacion || 0;

                    console.log("Salida de Transformación a Secundario:", sec, "=", salida);

                    // 🔽 RETRO: Secundario → Transformación
                    const retro = getChildValue(
                        dest,               // Padre (Transformación)
                        sec,                // Hijo (Secundario)
                        window.selectedYear,
                        "sum-in"
                    ) || 0;

                    const neto = salida - retro;

                    if (Math.abs(neto) <= 0) return;

                    energyFlow.addLink({
                        from: neto > 0 ? nodoTransformacion.id : secNode.id,
                        to:   neto > 0 ? secNode.id : nodoTransformacion.id,
                        value: Math.abs(neto)
                    });
                });
            }

            // 🟡 Primarios expandidos
            if (!nodoEnergSecundarios.expanded && nodoTransformacion.expanded) {

                const centrales = hijosTransformacion.find(
                    n => n.name === "Centrales Eléctricas"
                );

                if (!centrales) return;

                let totalEntrada = 0;
                let totalSalida = 0;

                Object.entries(retroalimentacionCE).forEach(([sec, dest]) => {

                    const entrada = getChildValue(dest, sec, window.selectedYear, "sum-in") || 0;
                    const salida  = getChildValue(dest, sec, window.selectedYear, "sum-out") || 0;

                    console.log("Secundario:", sec, "Entrada a Transformación =", entrada, ", Salida de Transformación =", salida);

                    totalEntrada += entrada;
                    totalSalida  += salida;
                });

                console.log("Total Entrada a Transformación =", totalEntrada, ", Total Salida de Transformación =", totalSalida);

                const netoTotal = totalEntrada - totalSalida;

                if (Math.abs(netoTotal) <= 0) return;

                console.log("Neto Total Secundarios → Transformación =", Math.abs(netoTotal));

                energyFlow.addLink({
                    from: centrales.id,
                    to:   nodoEnergSecundarios.id,
                    value: Math.abs(netoTotal)
                });
            }

            // 🟢 Ambos expandidos → flujo real 1 a 1
            if (nodoEnergSecundarios.expanded && nodoTransformacion.expanded) {

                Object.entries(retroalimentacion).forEach(([sec, dest]) => {
                    const secNode = hijosSecundarios.find(n => n.name === sec);
                    const destNode = hijosTransformacion.find(n => n.name === dest);

                    if (!secNode || !destNode) return;

                    const valor = getChildValue(dest, sec, window.selectedYear, "sum-in") || 0;

                    if (valor > 0) {
                        energyFlow.addLink({
                            from: secNode.id,
                            to: destNode.id,
                            value: valor
                        });
                    }
                });
            }

            energyFlow.drawConnections();
        }

        // -------------------------------------------------------------
        // animateNodeExpansion: mueve LÓGICAMENTE cada nodo desde el punto
        // origin (parentNode.position) hasta su position final, actualiza
        // left/top y redibuja conexiones en cada frame.
        // -------------------------------------------------------------
        function animateNodeExpansion(parentNode, childNodes, duration = 600) {
            const start = performance.now();

            const startPositions = childNodes.map(n => ({
                node: n,
                x0: parentNode.position.x,
                y0: parentNode.position.y,
                x1: n.position.x,
                y1: n.position.y
            }));

            function frame(now) {
                const t = Math.min(1, (now - start) / duration);
                const ease = t < 0.5 ? 2*t*t : -1 + (4 - 2*t)*t; // ease in-out

                startPositions.forEach(p => {
                    const nx = p.x0 + (p.x1 - p.x0) * ease;
                    const ny = p.y0 + (p.y1 - p.y0) * ease;

                    // coordenadas absolutas
                    p.node.element.style.left = nx + "px";
                    p.node.element.style.top = ny + "px";

                    p.node.position.x = nx;
                    p.node.position.y = ny;
                });

                // redibujar líneas
                energyFlow.drawConnections();

                if (t < 1) {
                    requestAnimationFrame(frame);
                }
            }

            requestAnimationFrame(frame);
        }


        // -------------------------------------------------------------
        // animateNodeCollapse: mueve LÓGICAMENTE cada nodo desde su position
        // actual hacia (targetX, targetY), con fade-out; redibuja líneas.
        // Callback onComplete se ejecuta cuando termina.
        // -------------------------------------------------------------
        function animateNodeCollapse(nodes, targetX, targetY, onComplete, duration = 500) {
            if (!nodes || nodes.length === 0) {
                onComplete && onComplete();
                return;
            }
            const startTime = performance.now();

            const items = nodes.map(n => ({
                node: n,
                startX: n.position.x,
                startY: n.position.y,
                endX: targetX,
                endY: targetY,
                prevTransition: n.element.style.transition || ''
            }));

            // aplicar transición suave
            items.forEach(it => {
                it.node.element.style.transition = `transform ${duration}ms ease, opacity ${duration}ms ease`;
                it.node.element.style.opacity = 1;
            });

            function frame(now) {
                const raw = Math.min((now - startTime) / duration, 1);
                const eased = 1 - Math.pow(1 - raw, 3); // easeOut cubic

                items.forEach(it => {
                    const x = it.startX + (it.endX - it.startX) * eased;
                    const y = it.startY + (it.endY - it.startY) * eased;

                    // actualizar posición lógica
                    it.node.position.x = x;
                    it.node.position.y = y;
                    if (typeof it.node.updatePosition === 'function') it.node.updatePosition();

                    // opacity
                    it.node.element.style.opacity = 1 - eased;
                });

                // redibujar líneas cada frame
                if (typeof energyFlow !== 'undefined' && typeof energyFlow.drawConnections === 'function') {
                    energyFlow.drawConnections();
                    //energyFlow.autoResizeSVG();
                }

                if (raw < 1) {
                    requestAnimationFrame(frame);
                } else {
                    // terminado: ejecutar callback (que suele eliminar nodos lógicamente)
                    items.forEach(it => {
                        // restaurar transition si lo necesitas (o dejar vacío)
                        it.node.element.style.transition = it.prevTransition || '';
                    });
                    onComplete && onComplete();
                }
            }

            requestAnimationFrame(frame);
        }

        function animateGlobalZoom(scale, duration = 600, origin = { x: '0%', y: '0%' }) {
            const wrapper = document.getElementById('zoom-wrapper');

            wrapper.style.transformOrigin = `${origin.x} ${origin.y}`;
            wrapper.style.transition = `transform ${duration}ms ease`;

            requestAnimationFrame(() => {
                wrapper.style.transform = `scale(${scale})`;
            });
        }

        function pushNearbyNodes(originNode, radius = 250, strength = 60) {
            const origin = originNode.position;

            Object.values(energyFlow.nodes).forEach(node => {
                if (node.hidden || node.id === originNode.id) return;

                const dx = node.position.x - origin.x;
                const dy = node.position.y - origin.y;
                const distance = Math.sqrt(dx * dx + dy * dy);

                if (distance < radius && distance > 0) {
                    // Calcular dirección normalizada y desplazamiento proporcional
                    const factor = (1 - distance / radius) * (strength / distance);
                    const offsetX = dx * factor;
                    const offsetY = dy * factor;

                    // Actualizar posición lógica del nodo
                    node.position.x += offsetX;
                    node.position.y += offsetY;

                    // Aplicar posición visual (usa top/left relativos a viz-inner)
                    node.element.style.transition = "top 0.6s ease, left 0.6s ease";
                    node.element.style.left = `${node.position.x}px`;
                    node.element.style.top = `${node.position.y}px`;
                }
            });

            // Redibujar líneas de conexión (si tienes esta función)
            if (typeof drawConnections === "function") {
                drawConnections();
                autoResizeSVG();
            }
        }

        function resetNodePositions() {
            Object.values(energyFlow.nodes).forEach(node => {
                if (node.hidden || !node.originalPosition) return;

                node.position.x = node.originalPosition.x;
                node.position.y = node.originalPosition.y;

                node.element.style.transition = "top 0.6s ease, left 0.6s ease";
                node.element.style.left = `${node.position.x}px`;
                node.element.style.top = `${node.position.y}px`;
            });

            if (typeof drawConnections === "function") {
                drawConnections();
            }
        }

        function resizeContainerForZoom(scale) {
            const container = document.getElementById("visualization-container");

            // base mínima real de tu diagrama
            const base = 4500; 

            container.style.minWidth = (base * scale) + "px";
            container.style.minHeight = (base * scale) + "px";
        }

        function restoreOriginalNodePositions(nodeId, stateName, duration = 600, steps = 30) {
            const node = energyFlow.nodes[nodeId];
            if (!node) return;

            // Guardamos su posición original (asumimos que la tenía almacenada)
            const original = node.originalPosition || { x: node.initialX, y: node.initialY };
            if (!original.x || !original.y) return;

            const pos = node.savedPositions[stateName];
            if (!pos) return;

            const endX = pos.x;
            const endY = pos.y;

            const startX = node.position.x;
            const startY = node.position.y;

            let currentStep = 0;

            const interval = setInterval(() => {
                currentStep++;
                const t = currentStep / steps;
                const ease = t < 0.5 ? 2*t*t : -1 + (4 - 2*t)*t;

                node.position.x = startX + (endX - startX) * ease;
                node.position.y = startY + (endY - startY) * ease;

                node.element.style.left = node.position.x + 'px';
                node.element.style.top = node.position.y + 'px';

                energyFlow.drawConnections();
                energyFlow.autoResizeSVG();

                if (currentStep >= steps) {
                    clearInterval(interval);
                }
            }, duration / steps);
        }

        // -----------------------------
        // Normaliza viz-inner y svg para cubrir todos los nodos
        // Llamar al principio de drawConnections()
        // -----------------------------
        function ensureVizBounds() {
            const nodes = Array.from(document.querySelectorAll('.energy-node'));

            let minX = Infinity, minY = Infinity;
            let maxX = -Infinity, maxY = -Infinity;

            nodes.forEach(n => {
                const x = parseFloat(n.style.left);
                const y = parseFloat(n.style.top);
                const w = n.offsetWidth;
                const h = n.offsetHeight;

                minX = Math.min(minX, x);
                minY = Math.min(minY, y);
                maxX = Math.max(maxX, x + w);
                maxY = Math.max(maxY, y + h);
            });

            const padding = 300;

            const inner = document.getElementById("viz-inner");
            inner.style.width = 2500 + "px";
            inner.style.height = 1500 + "px";

            // if (minX < 0) inner.style.left = (minX - padding) + "px";
            // if (minY < 0) inner.style.top = (minY - padding) + "px";
        }

