    <script type="module">

        // BASES
        const BASE_WIDTH  = 1866;
        const BASE_HEIGHT = 891;
        
        await iniciarSankey();

        //window.energyFlow = new EnergyFlow();

        // Toggle Dark Mode
        const themeToggle = document.getElementById('theme-toggle');
        const html = document.documentElement;

        // Detectar preferencia guardada o del sistema
        if (localStorage.getItem('theme') === 'dark' ||
            (!localStorage.getItem('theme') && window.matchMedia('(prefers-color-scheme: dark)').matches)) {
            html.classList.add('tw-dark');
            themeToggle.innerHTML = '<span class="material-icons-outlined">light_mode</span>';
        }

        themeToggle.addEventListener('click', () => {
            if (html.classList.contains('tw-dark')) {
                html.classList.remove('tw-dark');
                localStorage.setItem('theme', 'light');
                themeToggle.innerHTML = '<span class="material-icons-outlined">dark_mode</span>';
            } else {
                html.classList.add('tw-dark');
                localStorage.setItem('theme', 'dark');
                themeToggle.innerHTML = '<span class="material-icons-outlined">light_mode</span>';
            }
        });

        // BOTON DE COLAPSO DE GRUPOS
        function ensurePanelExists() {
