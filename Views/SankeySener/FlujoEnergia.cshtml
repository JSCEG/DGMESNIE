            toggleNodeFocus(nodeId) {
                focusedNodeId = (focusedNodeId === nodeId) ? null : nodeId;
                this.focusRootId = focusedNodeId;
                this.applyFocus();
            }

            applyFocus() {
                // NODOS
                Object.values(this.nodes).forEach((node, index) => {
                    node.isFocused =
                        !focusedNodeId ||
                        node.id === focusedNodeId ||
                        this.isConnectedTo(focusedNodeId, node.id);

                    node.isFocusRoot = (node.id === this.focusRootId);
                    setTimeout(() => {
                        node.updateFocusStyle();
                    }, focusedNodeId ? index * 20 : 0);
                });

                // LINKS
                this.links.forEach(link => {
                    link.isFocused =
                        !focusedNodeId ||
                        link.from === focusedNodeId ||
                        link.to === focusedNodeId;
                });

                // 🔁 Forzar redibujado para aplicar estilos SVG
                this.drawConnections();
            }

            isConnectedTo(sourceId, targetId) {
                return this.links.some(l =>
                    (l.from === sourceId && l.to === targetId) ||
                    (l.to === sourceId && l.from === targetId)
                );
            }

            restoreBaseLinks() {
                // 1️⃣ eliminar TODOS los links actuales (usando removeLink)
                this.links.slice().forEach(l => {
                    this.removeLink(l.from, l.to);
                });

                // 2️⃣ restaurar snapshot base
                this.baseLinks.forEach(l => {
                    this.addLink({ ...l });
                });
            }

            updateViewBox() {
                const nodes = Object.values(this.nodes);
                if (nodes.length === 0) return;

                // Coordenadas de todos los nodos
                const xs = nodes.map(n => n.position.x);
                const ys = nodes.map(n => n.position.y);

                const minX = Math.min(...xs) - 200; // margen extra
                const maxX = Math.max(...xs) + 200;
                const minY = Math.min(...ys) - 200;
                const maxY = Math.max(...ys) + 200;

                const width = maxX - minX;
                const height = maxY - minY;

                // Ajustar el viewBox del SVG
                this.svg.setAttribute("viewBox", `${minX} ${minY} ${width} ${height}`);
            }

            drawConnections() {
                ensureVizBounds();

                const expectedPaths = new Set();
                const expectedLabels = new Set();
                const expectedRects = new Set();

                this.links.forEach(link => {
                    const fromNode = this.nodes[link.from];
                    const toNode = this.nodes[link.to];
                    // No dibujar si origen o destino oculto/missing
                    if (!fromNode || !toNode || fromNode.hidden || toNode.hidden) return;

                    const start = fromNode.getConnectorPoint(true);
                    const end = toNode.getConnectorPoint(false);

                    const pathId = `path-${fromNode.id}-to-${toNode.id}`;
                    const labelId = `label-${fromNode.id}-to-${toNode.id}`;
                    const rectId = `rect-${fromNode.id}-to-${toNode.id}`;

                    expectedPaths.add(pathId);
                    expectedLabels.add(labelId);
                    expectedRects.add(rectId);

                    const dx = Math.abs(end.x - start.x) * 0.5;
                    const pathData = `M ${start.x} ${start.y} C ${start.x + dx} ${start.y}, ${end.x - dx} ${end.y}, ${end.x} ${end.y}`;

                    // Crear/actualizar path
                    let path = document.getElementById(pathId);
                    if (path) {
                        path.setAttribute('d', pathData);
                    } else {
                        path = document.createElementNS('http://www.w3.org/2000/svg', 'path');
                        path.id = pathId;
                        path.setAttribute('d', pathData);
                        path.setAttribute('stroke', 'var(--line-color)');
                        path.setAttribute('stroke-width', '2');
                        path.setAttribute('fill', 'none');
                        path.setAttribute('stroke-dasharray', '4 4');

                        // ✨ Añadimos transición para efecto visual
                        path.style.transition = 'stroke-opacity 0.6s ease, stroke-width 0.6s ease';
                        path.style.strokeOpacity = 0;
                        requestAnimationFrame(() => {
                            path.style.strokeOpacity = 0.8;
                        });

                        this.pathsGroup.appendChild(path);
                    }

                    // 🎯 ENFOQUE / DESENFOQUE DEL LINK
                    if (focusedNodeId) {
                        if (link.isFocused) {
                            path.style.strokeOpacity = '0.9';
                            path.style.strokeWidth = '2.5';
                            path.style.filter = 'none';
                        } else {
                            path.style.strokeOpacity = '0.08';
                            path.style.strokeWidth = '1';
                            path.style.filter = 'grayscale(80%)';
                        }
                    } else {
                        // Estado normal (sin enfoque activo)
                        path.style.strokeOpacity = '0.8';
                        path.style.strokeWidth = '2';
                        path.style.filter = 'none';
                    }

                    // Etiqueta: prioriza link.value si existe, si no usa valor del destino
                    const amount = (link && link.value !== undefined) ? link.value : toNode.value;
                    const valueText = `${amount.toLocaleString('es-MX', { minimumFractionDigits: 2, maximumFractionDigits: 2 })} PJ`;

                    const midX = (start.x + end.x) / 2;
                    const midY = (start.y + end.y) / 2;

                    let linkLabel = document.getElementById(labelId);
                    let labelBg = document.getElementById(rectId);

                    if (linkLabel) {
                        linkLabel.setAttribute('x', midX);
                        linkLabel.setAttribute('y', midY);
                        linkLabel.textContent = valueText;
                        const bbox = linkLabel.getBBox();
                        if (labelBg) {
                            labelBg.setAttribute('x', bbox.x - 5);
                            labelBg.setAttribute('y', bbox.y - 2);
                            labelBg.setAttribute('width', bbox.width + 10);
                            labelBg.setAttribute('height', bbox.height + 4);
                        }
                    } else {
                        labelBg = document.createElementNS('http://www.w3.org/2000/svg', 'rect');
                        labelBg.id = rectId;
                        labelBg.setAttribute('fill', 'var(--label-bg-color)');
                        labelBg.setAttribute('rx', '4');
                        labelBg.style.transition = 'opacity 0.6s ease';
                        this.labelsGroup.appendChild(labelBg);

                        linkLabel = document.createElementNS('http://www.w3.org/2000/svg', 'text');
                        linkLabel.id = labelId;
                        linkLabel.setAttribute('x', midX);
                        linkLabel.setAttribute('y', midY);
                        linkLabel.setAttribute('text-anchor', 'middle');
                        linkLabel.setAttribute('dy', '5');
                        linkLabel.style.fontSize = '14px';
                        linkLabel.style.fontWeight = '600';
                        linkLabel.style.fill = 'var(--label-text-color)';
                        linkLabel.textContent = valueText;
                        linkLabel.style.transition = 'opacity 0.6s ease';
                        this.labelsGroup.appendChild(linkLabel);

                        // Calcular bbox ya que el texto está en el DOM
                        const bbox = linkLabel.getBBox();
                        labelBg.setAttribute('x', bbox.x - 5);
                        labelBg.setAttribute('y', bbox.y - 2);
                        labelBg.setAttribute('width', bbox.width + 10);
                        labelBg.setAttribute('height', bbox.height + 4);
                    }

                    

                    // 🎯 ENFOQUE / DESENFOQUE DEL LABEL
                    if (focusedNodeId) {
                        if (link.isFocused) {
                            linkLabel.style.opacity = '1';
                            labelBg.style.opacity = '0.9';
                        } else {
                            linkLabel.style.opacity = '0.08';
                            labelBg.style.opacity = '0.05';
                        }
                    } else {
                        // Estado normal (sin foco)
                        linkLabel.style.opacity = '1';
                        labelBg.style.opacity = '0.9';
                    }

                });

                // Eliminar paths/labels/rects que ya no correspondan a ningún link
                if (this.svg) {
                    this.svg.querySelectorAll('path[id^="path-"]').forEach(p => {
                        if (!expectedPaths.has(p.id)) p.remove();
                    });
                    this.svg.querySelectorAll('text[id^="label-"]').forEach(t => {
                        if (!expectedLabels.has(t.id)) t.remove();
                    });
                    this.svg.querySelectorAll('rect[id^="rect-"]').forEach(r => {
                        if (!expectedRects.has(r.id)) r.remove();
                    });
                }
            }

            pushFromLines(nodeId, offsetX, offsetY, duration = 600, steps = 30, stateName = null) {
                const node = energyFlow.nodes[nodeId];
                if (!node || node.hidden) return;

                if (!node.savedPositions) {
                    node.savedPositions = {
                        base: { x: node.position.x, y: node.position.y }
                    };
                }

                // Guarda la posición según el estado
                if (stateName) {
                    energyFlow.saveStatePosition(nodeId, stateName);
                }

                const startX = node.position.x;
                const startY = node.position.y;
                const endX = startX + offsetX;
                const endY = startY + offsetY;

                let currentStep = 0;

                const interval = setInterval(() => {
                    currentStep++;
                    const t = currentStep / steps;
                    const ease = t < 0.5 ? 2*t*t : -1 + (4 - 2*t)*t; // efecto "ease-in-out"
                    node.position.x = startX + offsetX * ease;
                    node.position.y = startY + offsetY * ease;

                    // Actualizar posición visual del nodo
                    node.element.style.left = node.position.x + 'px';
                    node.element.style.top = node.position.y + 'px';

                    // Redibujar conexiones
                    energyFlow.drawConnections();
                    //energyFlow.autoResizeSVG();

                    if (currentStep >= steps) {
                        clearInterval(interval);
                    }
                }, duration / steps);
            }

            saveStatePosition(nodeId, stateName) {
                const node = this.nodes[nodeId];
                if (!node) return;

                if (!node.savedPositions[stateName]) {
                    node.savedPositions[stateName] = {
                        x: node.position.x,
                        y: node.position.y
                    };
                }
            }

            restoreStatePosition(nodeId, stateName, duration = 600){
                const node = this.nodes[nodeId];
                if (!node) return;

                const pos = node.savedPositions[stateName];
                if (!pos) return;

                console.log("Posición Guardada: ", node.savedPositions);

                const startX = node.position.x;
                const startY = node.position.y;

                const endX = pos.x;
                const endY = pos.y;

                const steps = 30;
                let step = 0;

                const interval = setInterval(() => {
                    step++;
                    const t = step / steps;

                    node.position.x = startX + (endX - startX) * t;
                    node.position.y = startY + (endY - startY) * t;

                    node.element.style.left = node.position.x + "px";
                    node.element.style.top = node.position.y + "px";
                    energyFlow.drawConnections();
                    //energyFlow.autoResizeSVG();

                    if (step >= steps) clearInterval(interval);
                }, duration / steps);
            }

            // 🔹 Método auxiliar dentro de la clase
            getClosestPointOnPath(path, x, y, pathLength, precision = 8) {
                let best, bestDistance = Infinity;
                for (let i = 0; i <= pathLength; i += precision) {
                    const point = path.getPointAtLength(i);
                    const dx = point.x - x;
                    const dy = point.y - y;
                    const dist = dx * dx + dy * dy;
                    if (dist < bestDistance) {
                        bestDistance = dist;
                        best = point;
                    }
                }
                return best || { x, y };
            }

            getNodeFlow(nodeId) {
                let incoming = 0;
                let outgoing = 0;

                this.links.forEach(link => {
                    if (link.target === nodeId) incoming += link.value;
                    if (link.source === nodeId) outgoing += link.value;
                });

                return { incoming, outgoing };
            }

            animate() {
                this.particles = this.particles.filter(p => p.update());

                this.links.forEach(link => {
                    const fromNode = this.nodes[link.from];
                    if (!fromNode) return;

                    const path = document.getElementById(`path-${link.from}-to-${link.to}`);
                    if (!path) return;

                    // 🔢 calcular cuántas partículas debe emitir ESTE link
                    const particleQuota = scaleParticles(link.value);

                    // 🏎️ velocidad coherente con el tramo
                    const speed = scaleSpeed(link.value);

                    // contar cuántas partículas activas tiene este link
                    const currentParticles = this.particles.filter(p => p.linkId === link.from + '-' + link.to).length;

                    const missing = particleQuota - currentParticles;
                    if (missing <= 0) return;

                    for (let i = 0; i < missing; i++) {
                        if (Math.random() < 0.05) {
                            this.particles.push(
                                new Particle(path, fromNode.color, speed, link.from + '-' + link.to, link)
                            );
                        }
                    }
                });

                requestAnimationFrame(() => this.animate());
            }
        }

        // Función para aclarar u oscurecer el color según porcentaje
        function shadeColor(color, percent) {
            const num = parseInt(color.slice(1), 16);
            const amt = Math.round(2.55 * percent);
            const R = (num >> 16) + amt;
            const G = (num >> 8 & 0x00FF) + amt;
            const B = (num & 0x0000FF) + amt;
            return "#" + (
                0x1000000 +
                (R < 255 ? (R < 1 ? 0 : R) : 255) * 0x10000 +
                (G < 255 ? (G < 1 ? 0 : G) : 255) * 0x100 +
                (B < 255 ? (B < 1 ? 0 : B) : 255)
            ).toString(16).slice(1);
        }

        function conectarProduccionConPrimariosHijos(energyFlow, YEAR) {

            const prodNode = energyFlow.nodes['primarios'];
            const primNode = energyFlow.nodes['transformacion'];

            if (!prodNode?.expanded || !primNode?.expanded) return;

            const PADRES_SALIDA = [
                "Exportación EP",
                "Energía No Aprovechada EP",
                "Consumo Propio del Sector EP",
                "Variación de Inventarios EP (-)",
                "Pérdidas técnicas por transporte, transmisión y distribución EP"
