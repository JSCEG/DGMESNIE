<script>
    tailwind.config = {
        prefix: 'tw-',
        darkMode: "class",
        theme: {
            extend: {
                colors: {
                    primary: "#9F2241",
                    secondary: "#13322B",
                    accent: "#BC955C",
                    "background-light": "#F8F7F2",
                    "background-dark": "#121212",
                    "card-light": "#FFFFFF",
                    "card-dark": "#1E1E1E",
                    "gobmx-guinda": "#6a1c32",
                    "gobmx-verde": "#13322B",
                    "gobmx-dorado": "#BC955C"
                },
                fontFamily: {
                    display: ["Montserrat", "sans-serif"],
                    sans: ["Montserrat", "sans-serif"],
                    body: ["Noto Sans", "sans-serif"],
                    headings: ["Montserrat", "sans-serif"]
                },
                borderRadius: {
                    DEFAULT: "0.5rem",
                    'xl': '1rem'
                }
            }
        }
    };

    async function iniciarSankey() {

        const loader = showPreloader('Cargando colores...'); 

        try {

            await cargarColoresEnergeticos();

            loader.updateMessage('Procesando datos...'); 

            procesarDatosEnergia(); // tu data_processor

            loader.updateMessage('Construyendo visualización...'); 

            await generarSankey(); // datosEnergia.js

            console.log('Sankey generado con éxito');

        }
        catch (error) {

            console.error(error);
            alert("Error cargando el Sankey");

        }
        finally {

            loader.complete(); 

        }
    }

    // Funciones para controlar el preloader
    function showPreloader(message = 'Cargando...') {
        const preloader = document.getElementById('preloader');
        const messageEl = document.getElementById('preloader-message');
        const progressBar = document.getElementById('preloader-progress-bar');

        messageEl.textContent = message;
        preloader.classList.remove('hidden');

        let progress = 0;

        const progressInterval = setInterval(() => {
            progress += Math.random() * 10;

            if (progress > 85) progress = 85;

            progressBar.style.width = progress + '%';
        }, 250);

        return {
            complete: () => {
                clearInterval(progressInterval);

                progressBar.style.width = '100%';

                setTimeout(() => {
                    preloader.classList.add('hidden');
                    progressBar.style.width = '0%';
                }, 500);
            },

            updateMessage: (msg) => {
                messageEl.textContent = msg;
            },

            updateProgress: (value) => {
                progress = Math.min(100, value);
                progressBar.style.width = progress + '%';
            }
        };
    }
</script>
