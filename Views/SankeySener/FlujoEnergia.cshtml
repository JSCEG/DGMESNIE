        function getNodeDescription(nombreNodo) {
            // intentar como padre
            const parent = window.energyData?.Datos?.find(
                d => d["Nodo Padre"] === nombreNodo
            );
            if (parent) return parent.descripcion;

            // intentar como hijo
            for (const padre of window.energyData?.Datos || []) {
                const hijo = padre["Nodos Hijo"]?.find(
                    h => h["Nodo Hijo"] === nombreNodo
                );
                if (hijo) return hijo.descripcion;
            }

            return "Sin descripción disponible.";
        }

        function getMixedValue(nombre, year) {
            const inVal  = getValue(nombre, year, "sum-in")  || 0;
            const outVal = getValue(nombre, year, "sum-out") || 0;
            return inVal + outVal;
        }

