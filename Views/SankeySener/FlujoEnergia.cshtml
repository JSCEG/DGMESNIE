        // Obtener todos los años únicos desde window.energyData
        function populateYearSelector() {
            const yearSelector = document.getElementById('year-selector');
            const yearsSet = new Set();

            // Extraer todos los años presentes en cualquier hijo
            window.energyData.Datos.forEach(parent => {
                parent["Nodos Hijo"].forEach(hijo => {
                    Object.keys(hijo).forEach(key => {
                        if (!isNaN(key)) {
                            yearsSet.add(parseInt(key));
                        }
                    });
                });
            });

            const years = Array.from(yearsSet).sort(); // orden ascendente

            console.log("Años disponibles en los datos:", years);

            // Determinar el año más reciente con al menos un dato válido
            const yearsWithData = years.filter(year => {
                return window.energyData.Datos.some(parent =>
                    parent["Nodos Hijo"].some(hijo =>
                        hijo[year] !== undefined &&
                        hijo[year] !== null &&
                        hijo[year] !== 0
                    )
                );
            });

            // Elegimos el año más reciente disponible
            const defaultYear = yearsWithData.length > 0
                ? yearsWithData[yearsWithData.length - 1]
                : years[years.length - 1]; // fallback

            console.log("Años con datos completos:", yearsWithData);
            console.log("Año predeterminado seleccionado:", defaultYear);

            // Llenar el selector
            yearSelector.innerHTML = "";

            years.forEach(year => {
                const opt = document.createElement('option');
                opt.value = year;
                opt.textContent = year;
                if (year === defaultYear) opt.selected = true; // seleccionar por defecto
                yearSelector.appendChild(opt);
            });

            // ---- AQUI ASIGNAMOS EL AÑO GLOBAL ----
            window.selectedYear = defaultYear;

            // Llamar la función que actualiza el gráfico
            //updateChart(defaultYear);
        }

        function getChildValue(parentName, childName, year, mode = "raw") {

            // Localizar padre
            const parent = window.energyData.Datos.find(
                d => d["Nodo Padre"] === parentName
            );

            if (!parent) {
                console.warn(`Padre '${parentName}' no encontrado.`);
                return 0;
            }

            // Localizar hijo dentro del padre
            const child = parent["Nodos Hijo"].find(
                h => h["Nodo Hijo"] === childName
            );

            if (!child) {
                console.warn(`Hijo '${childName}' no encontrado dentro de '${parentName}'.`);
                return 0;
            }

            // Obtener valor original
            let value = child[year];

            console.log(`Valor original para '${parentName}' -> '${childName}' en ${year}:`, value);

            // Manejar valores inexistentes
            if (value === undefined || value === null) return 0;

            // Aplicar tipo de modelo solicitado
            switch (mode) {

                case "sum-out":
                    // Solo salidas positivas
                    return value > 0 ? value : 0;

                case "sum-in":
                    // Solo entradas negativas (valor absoluto del negativo)
                    return value < 0 ? Math.abs(value) : 0;

                case "abs":
                    // Magnitud independientemente del signo
                    return Math.abs(value);

                case "raw":
                default:
                    // Valor original tal cual viene en la base
                    return value;
            }
        }

        function getValue(nombrePadre, year, mode = "sum-out", allowedChildren = null) {

            const Data = window.energyData.Datos.find(d => d["Nodo Padre"] === nombrePadre);

            console.log(`Obteniendo valor para '${nombrePadre}' en ${year} con modo '${mode}':`, Data);

            if (!Data) return 0;

            let children = Data["Nodos Hijo"]; // <--- ahora 'let'

            console.log(`Hijos encontrados permitidos:`, allowedChildren);

            // Si existe una lista de hijos permitidos, filtrarlos
            if (allowedChildren && Array.isArray(allowedChildren)) {
                children = children.filter(c =>
                    allowedChildren.includes(c["Nodo Hijo"])
                );
            }

            let values = [];

            if (mode === "sum-out") {
                values = children
                    .filter(c => c[year] > 0)
                    .map(c => c[year]);
            }
            else if (mode === "sum-in") {
                values = children
                    .filter(c => c[year] < 0)
                    .map(c => Math.abs(c[year]));
            }
            else if (mode === "sum-all") {
                values = children
                    .filter(c => c[year] !== 0 && c[year] !== undefined)
                    .map(c => c[year]);
            }

            return values.reduce((sum, v) => sum + v, 0);
        }

        function getSpecialInValue(parentName, year, allowedChildren) {
            const Data = window.energyData.Datos.find(d => d["Nodo Padre"] === parentName);

            if (!Data) return 0;

            // Acceder a todos los hijos del padre
            const children = Data["Nodos Hijo"];

            // Filtrar por nombres permitidos y valores negativos (entradas)
            const values = children
                .filter(c => allowedChildren.includes(c["Nodo Hijo"]))
                .filter(c => c[year] < 0)  // entradas
                .map(c => Math.abs(c[year])); // convertir a positivo

            // Sumar las entradas válidas
            return values.reduce((sum, v) => sum + v, 0);
        }

