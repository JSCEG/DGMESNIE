        function collapseLocalNode(node, energyFlow) {
            if (!node.expanded) return;

            // 1️⃣ Eliminar hijos visuales
            const hijos = node.childNodeIds
                .map(id => energyFlow.nodes[id])
                .filter(Boolean);

            animateNodeCollapse(hijos, node.position.x, node.position.y, () => {

                hijos.forEach(h => {
                    if (h.element?.parentNode) h.element.remove();
                    delete energyFlow.nodes[h.id];
                });

                // 2️⃣ Eliminar SOLO enlaces creados por este nodo
                if (node.createdLinks) {
                    node.createdLinks.forEach(l => {
                        energyFlow.removeLink(l.from, l.to);
                    });
                }

                // 3️⃣ Restaurar SOLO su enlace agregado
                restoreAggregateLink(node.id, energyFlow);

                // 4️⃣ Limpiar estado
                node.childNodeIds = [];
                node.createdLinks = [];
                node.expanded = false;
            });
        }

        function restoreAggregateLink(nodeId, energyFlow) {

            const YEAR = window.selectedYear;

            switch (nodeId) {

