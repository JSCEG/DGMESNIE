                            ocultar.forEach(n => {
                                n.element.style.transition = `opacity ${FADE_MS}ms ease`;
                                n.element.style.opacity = 0;
                                setTimeout(() => {
                                    n.hidden = true;
                                    n.element.style.display = "none";
                                }, FADE_MS);
                            });

                            // ------------------------------------------------------------------
                            // 2) REMOVER LAS CONEXIONES PRINCIPALES
                            // ------------------------------------------------------------------
                            setTimeout(() => {
                                energyFlow.removeLink("energeticosSecundarios", "salidasSecundarias");
                                energyFlow.removeLink("energeticosSecundarios", "usosFinales");
                            }, FADE_MS);

                            // ------------------------------------------------------------------
                            // 3) CREACIÓN DE LOS HIJOS (SALIDAS Y USOS FINALES)
                            // ------------------------------------------------------------------

                            const hijosSalidasConfig = [
                                { name: "Exportación ES", color: "#9b59b6" },
                                { name: "Consumo Propio del Sector ES", color: "#a569bd" },
                                { name: "Pérdidas técnicas por transporte, transmisión y distribución ES", color: "#bb8fce" },
                                { name: "Variación de Inventarios ES (-)", color: "#d2b4de" },
                                { name: "Diferencia Estadística ES (-)", color: "#e8daef" }
                            ];

                            const hijosSalidas = hijosSalidasConfig
                                .map(h => {
                                    const total = getMixedValue(h.name, window.selectedYear);
                                    return {
                                        ...h,
                                        value: total
                                    };
                                })
                                .filter(h => h.value > 0); // 👈 solo nodos con energía real


                            const hijosUsosConfig = [
                                { name: "Industrial", color: "#1abc9c" },
                                { name: "Transporte", color: "#3498db" },
                                { name: "Agropecuario", color: "#27ae60" },
                                { name: "Comercial", color: "#16a085" },
                                { name: "Público", color: "#2980b9" },
                                { name: "Residencial", color: "#f1c40f" },
                                { name: "Consumo final no energético", color: "#d35400" }
                            ];

                            const hijosUsos = hijosUsosConfig
                                .map(h => ({
                                    ...h,
                                    value: getValue(h.name, window.selectedYear, "sum-out") || 0
                                }))
                                .filter(h => h.value > 0);


                            const offsetYSalidas = -((hijosSalidas.length - 1) * spreadY) / 2 + 630;
                            const offsetYUsos    = -((hijosUsos.length - 1) * spreadY) / 2 - 20;

                            this.childNodeIds = [];

                            const nodosSalidasChildren = [];
                            const nodosUsosChildren    = [];

                            // ------------------------------------------------------------------
                            // 3A) Crear hijos de SALIDAS ES
                            // ------------------------------------------------------------------
                            hijosSalidas.forEach((h, i) => {

                                const id = `${this.id}-child-salida-${i}`;
                                if (energyFlow.nodes[id]) return;

                                const d = {
                                    id,
                                    name: h.name,
                                    value: h.value,
                                    type: "sink",
                                    scale: scaleP,
                                    color: h.color,
                                    infoText: getNodeDescription(h.name) || "Representa la energía secundaria que se pierde de forma inherente durante los procesos de transporte, transmisión y distribución, debido a factores técnicos como resistencia, fugas e ineficiencias de la infraestructura, y que no corresponde a consumo final.",
                                    icon: '<svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor"><circle cx="12" cy="12" r="6"/></svg>',
                                    position: {
                                        x: this.position.x - spreadX + 20,
                                        y: this.position.y + offsetYSalidas + i * spreadY
                                    }
                                };

                                const node = new SinkNode(d);
                                energyFlow.nodes[id] = node;
                                nodosSalidasChildren.push(node);
                                this.childNodeIds.push(id);

                                energyFlow.addLink({ from: "energeticosSecundarios", to: id, value: h.value });
                                energyFlow.createdLinks.push({ from: "energeticosSecundarios", to: id, value: h.value });  
                            });

                            const energeticosSecundarios = [
                                "Coque de carbón",
                                "Gas licuado de petróleo",
                                "Gas Seco",
                                "Gasolinas y naftas",
                                "Diesel",
                                "Combustóleo",
                                "Querosenos",
                                "Coque de petróleo",
                                "Energía eléctrica",
                                "Otros energéticos"
                            ];

                            const hijosUsosEnergeticos = hijosUsosConfig
                                .map(h => ({
                                    ...h,
                                    value: getValue(
                                        h.name,
                                        window.selectedYear,
                                        "sum-out",
                                        energeticosSecundarios // 👈 SOLO secundarios
                                    ) || 0
                                }))
                                .filter(h => h.value > 0);

                            const usosEnergeticosMap = Object.fromEntries(
                                hijosUsosEnergeticos.map(h => [h.name, h.value])
                            );

                            // ------------------------------------------------------------------
                            // 3B) Crear hijos de USOS FINALES ES
                            // ------------------------------------------------------------------
                            hijosUsos.forEach((h, i) => {

                                const id = `${this.id}-child-uso-${i}`;
                                if (energyFlow.nodes[id]) return;

                                const d = {
                                    id,
                                    name: h.name,
                                    value: h.value,
                                    type: "sink",
                                    scale: scaleP,
                                    color: h.color,
                                    infoText: getNodeDescription(h.name),
                                    icon: '<svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor"><circle cx="12" cy="12" r="6"/></svg>',
                                    position: {
                                        x: this.position.x,
                                        y: this.position.y + offsetYUsos + i * spreadY
                                    }
                                };

                                const node = new SinkNode(d);
                                energyFlow.nodes[id] = node;
                                nodosUsosChildren.push(node);
                                this.childNodeIds.push(id);

                                // 🔥 LINK SOLO CON ENERGÉTICOS SECUNDARIOS
                                const linkValue = usosEnergeticosMap[h.name] || 0;

                                if (linkValue > 0) {
                                    energyFlow.addLink({
                                        from: "energeticosSecundarios",
                                        to: id,
                                        value: linkValue
                                    });

                                    energyFlow.createdLinks.push({
                                        from: "energeticosSecundarios",
                                        to: id,
                                        value: linkValue
                                    });
                                }
                            });

                            //----------------------------------------------------------
                            // 🔗 CONEXIONES REALES DESDE ENERGÉTICOS SECUNDARIOS
                            //----------------------------------------------------------

                            const energeticosSecundariosConexiones = [
                                "Coque de carbón",
                                "Gas licuado de petróleo",
                                "Gas Seco",
                                "Gasolinas y naftas",
                                "Diesel",
                                "Combustóleo",
                                "Querosenos",
                                "Coque de petróleo",
                                "Energía eléctrica",
                                "Otros energéticos"
                            ];

                            // Obtener nodos energéticos que EXISTEN en el flow
                            const nodosEnergeticos = Object.values(energyFlow.nodes)
                                .filter(n => energeticosSecundariosConexiones.includes(n.name));

                            // Para cada energético
                            nodosEnergeticos.forEach(energeticoNode => {

                                const nombreEnergetico = energeticoNode.name;

                                // recorrer hijos creados (usos + salidas)
                                this.childNodeIds.forEach(childId => {

                                    const destinoNode = energyFlow.nodes[childId];
                                    if (!destinoNode) return;

                                    const nombreDestino = destinoNode.name;

                                    let valor = 0;

                                    // Si es un uso final
                                    if (hijosUsosConfig.some(u => u.name === nombreDestino)) {

                                        valor = getChildValue(
                                            nombreDestino,        // padre real
                                            nombreEnergetico,     // energético
                                            window.selectedYear,
                                            "sum-out"
                                        ) || 0;
                                    }

                                    // Si es una salida ES
                                    if (hijosSalidasConfig.some(s => s.name === nombreDestino)) {

                                        valor = getChildValue(
                                            nombreDestino,
                                            nombreEnergetico,
                                            window.selectedYear,
                                            "sum-in"
                                        ) || 0;
                                    }

                                    if (valor > 0) {

                                        energyFlow.addLink({
                                            from: energeticoNode.id,
                                            to: destinoNode.id,
                                            value: valor
                                        });

                                        energyFlow.createdLinks.push({
                                            from: energeticoNode.id,
                                            to: destinoNode.id,
                                            value: valor
                                        });
                                    }

                                });

                            });

                            // ------------------------------------------------------------------
                            // 4) ANIMACIÓN DE LOS NODOS CREADOS
                            // ------------------------------------------------------------------
                            animateNodeExpansion(this, nodosSalidasChildren, 700);
                            animateNodeExpansion(this, nodosUsosChildren, 700);

                            // ------------------------------------------------------------------
                            // 5) REDIBUJAR CONEXIONES
                            // ------------------------------------------------------------------
                            setTimeout(() => energyFlow.drawConnections(), 720);

                            // ------------------------------------------------------------------
                            // 6) ZOOM GLOBAL SUAVE (estándar igual a primarios)
                            // ------------------------------------------------------------------
                            setTimeout(() => {
                                animateGlobalZoom(0.75, 700, { x: "0%", y: "0%" });
                                this.zoomedOut = true;

                                //NODOS PARA EMPUJAR
                                if (!energyFlow.state.primariosExpanded  && !energyFlow.state.produccionExpanded) {
                                    energyFlow.pushFromLines("importacionES", 0, -40, 800, 30, "secundarios");
                                    energyFlow.pushFromLines("viDifES", 0, 40, 800, 30, "secundarios");
                                }
                                if (energyFlow.state.primariosExpanded  && !energyFlow.state.produccionExpanded) {
                                    energyFlow.pushFromLines("importacionES", 0, -70, 800, 30, "secundarios");
                                    energyFlow.pushFromLines("viDifES", 0, -70, 800, 30, "secundarios");
                                }
                                if (energyFlow.state.primariosExpanded  && energyFlow.state.produccionExpanded) {
                                    energyFlow.pushFromLines("importacionES", 0, 70, 800, 30, "secundarios");
                                    energyFlow.pushFromLines("viDifES", 0, 70, 800, 30, "secundarios");
                                }
                                if (energyFlow.state.primariosExpanded  && energyFlow.state.produccionExpanded && energyFlow.state.transformacionExpanded) {
                                    const salidaNodes = getSalidaSecundariaNodes(energyFlow);

                                    salidaNodes.forEach(n => {
                                        energyFlow.pushFromLines(n.id, 170, 250, 800, 30, "secundarios");
                                    });
                                }
                                if (!energyFlow.state.primariosExpanded  && !energyFlow.state.produccionExpanded && energyFlow.state.transformacionExpanded) {
                                    const salidaNodes = getSalidaSecundariaNodes(energyFlow);

                                    salidaNodes.forEach(n => {
                                        energyFlow.pushFromLines(n.id, 170, 250, 800, 30, "secundarios");
                                    });
                                }
                            }, 760);

                            // ------------------------------------------------------------------
                            // 7) RECONEXIONES AUXILIARES
                            // ------------------------------------------------------------------
                            setTimeout(() => {
                                conectarPrimariosAUsosFinales(energyFlow);
                                conectarSecundariosATransformacion(energyFlow);
                                energyFlow.drawConnections();
                            }, 150);

                            energyFlow.state.secundariosExpanded = true;
                            this.expanded = true;
                            connector.innerHTML = "<span>-</span>";
                            // 🔹 Crear botón flotante de colapso
                            this.createCollapseButton("usosFinales", connector);
                        }
                    } 
                });

                nodeBody.appendChild(connector);
                return node;
            }

            createCollapseButton(nodeType, connector) {

                ensurePanelExists();
                const panel = document.getElementById('active-groups-panel');

                const button = document.createElement('div');
                button.className = 'group-collapse-btn';
                button.dataset.nodeType = nodeType;

                const labelMap = {
                    primarios: "Primarios",
                    transformacion: "Transformación",
                    energeticosSecundarios: "Secundarios",
                    usosFinales: "Usos Finales"
                };

                button.innerHTML = `
                    <span>${labelMap[nodeType]}</span>
                    <span class="close-icon">✕</span>
                `;

                // 🎨 AQUÍ va el color dinámico
                if (this.color) {
                    button.style.borderLeft = `4px solid ${this.color}`;
                }

                // 🏷 Tooltip descriptivo
                button.title = `Colapsar ${labelMap[nodeType]} y volver al estado normal`;

                button.addEventListener('click', () => {
                    this.collapseNode(nodeType, connector);
                });

                panel.appendChild(button);

                this.collapseButton = button;
            }

            collapseNode(nodeType, connector) {
                if (nodeType === 'primarios') {
                    // Obtener hijos actuales visibles
                    const hijos = this.childNodeIds.map(id => energyFlow.nodes[id]).filter(Boolean);

                    const nodoPrimarios = energyFlow.nodes['primarios'];
                    const FADE_MS = 400;

                    if (hijos.length === 0) {
                        // nada que hacer
                        return;
                    }

                    // Determinar punto al que colapsan: nodoPrimarios (si existe) o posición de producción
                    const endX = nodoPrimarios.position.x;
                    const endY = nodoPrimarios.position.y;

                    // Animar colapso y luego hacer limpieza/restauración
                    animateNodeCollapse(hijos, endX, endY, () => {
                        // Después de la animación: eliminar DOM y nodos del mapa
                        hijos.forEach(child => {
                            if (child && child.element && child.element.parentNode) child.element.remove();
                            if (child) delete energyFlow.nodes[child.id];
                        });

                        // Restablecer nodoPrimarios con fade-in
                        if (nodoPrimarios) {
                            nodoPrimarios.hidden = false;
                            nodoPrimarios.element.style.display = "";
                            nodoPrimarios.element.style.transition = `opacity ${FADE_MS}ms ease, transform ${FADE_MS}ms ease`;
                            nodoPrimarios.element.style.opacity = 0;
                            nodoPrimarios.element.style.transform = "scale(0.9)";
                            // forzamos frame
                            requestAnimationFrame(() => {
                                nodoPrimarios.element.style.opacity = 1;
                                nodoPrimarios.element.style.transform = "scale(1)";
                            });
                        }

                        // Restaurar conexiones originales (añadir con fade controlado por removeLink)
                        collapseLocalNode(this, energyFlow);

                        // limpiar ids hijos
                        this.childNodeIds = [];
                        this.expanded = false;
                        connector.innerHTML = '<span>+</span>';

                        energyFlow.state.produccionExpanded = false;

                        // 🔄 Si PRIMARIOS está expandido, revertimos el corrimiento aplicado antes
                        if (energyFlow.state.primariosExpanded) {
                            console.log("Restaurando posición REAL de hijos de PRIMARIOS...");

                            const movedNodes = Object.values(energyFlow.nodes)
                                .filter(n => n.id.startsWith("primarios-child-salida-"));

                            movedNodes.forEach(n => {

                                // 🔥 devolver la posición REAL al punto original
                                n.position.x -= 160;   // el inverso EXACTO del desplazamiento
                                n.position.y -= 0;

                                // 🔥 traducir visualmente de vuelta al origen
                                n.element.style.transition = `transform 600ms ease`;
                                n.element.style.transform = `translate(0px, 0px)`; 
                            });

                            // 🔥 redibujar líneas ahora sí con posición real
                            setTimeout(() => {
                                energyFlow.drawConnections();
                                // ensureVizBounds();
                                // energyFlow.autoResizeSVG();
                            }, 620);
                        }

                        if (this.zoomedOut) {
                            // resetNodePositions();
                            if(!energyFlow.state.primariosExpanded && !energyFlow.state.transformacionExpanded && !energyFlow.state.secundariosExpanded){
                                animateGlobalZoom(1, 700);
                                // 💫 Restaurar posiciones originales de nodos desplazados
                                energyFlow.restoreStatePosition("viDifES","base", 800);
                                energyFlow.restoreStatePosition("salidasPrimarias", "base", 800);
                                energyFlow.restoreStatePosition("importacionES", "base", 800);
                            }
                            if(energyFlow.state.primariosExpanded && !energyFlow.state.transformacionExpanded && !energyFlow.state.secundariosExpanded){
                                // energyFlow.restoreStatePosition("importacionES", "produccion", 800);
                                //Aquí van las salidas
                                // 🔥 EMPUJÓN EN GRUPO PARA LOS HIJOS DE SALIDAS PRIMARIAS
                                const salidaNodes = getSalidaPrimariaNodes(energyFlow);

                                salidaNodes.forEach(n => {
                                    energyFlow.restoreStatePosition(n.id, "produccion", 800);
                                });
                            }
                            if(energyFlow.state.transformacionExpanded && !energyFlow.state.primariosExpanded && !energyFlow.state.secundariosExpanded){
                                energyFlow.restoreStatePosition("salidasPrimarias", "produccion", 800);
                            }
                            if(energyFlow.state.secundariosExpanded && !energyFlow.state.primariosExpanded && !energyFlow.state.transformacionExpanded){
                                energyFlow.restoreStatePosition("salidasPrimarias", "base", 800);
                            }
                            if(energyFlow.state.secundariosExpanded && energyFlow.state.primariosExpanded && !energyFlow.state.transformacionExpanded){
                                const salidaNodes = getSalidaPrimariaNodes(energyFlow);

                                salidaNodes.forEach(n => {
                                    energyFlow.restoreStatePosition(n.id, "produccion", 800);
                                });
                            }
                            if(!energyFlow.state.secundariosExpanded && energyFlow.state.primariosExpanded && energyFlow.state.transformacionExpanded){
                                const salidaNodes = getSalidaPrimariaNodes(energyFlow);

                                salidaNodes.forEach(n => {
                                    energyFlow.restoreStatePosition(n.id, "produccion", 800);
                                });
                            }
                            if(energyFlow.state.transformacionExpanded && energyFlow.state.primariosExpanded && energyFlow.state.secundariosExpanded)
                            {
                                const salidaNodes = getSalidaPrimariaNodes(energyFlow);

                                salidaNodes.forEach(n => {
                                    energyFlow.restoreStatePosition(n.id, "produccion", 800);
                                });
                            }
                            
                            this.zoomedOut = false;
                        }

                        // redibujar conexiones al final del fade para evitar que removeLink borre cosas:
                        setTimeout(() => {
                            energyFlow.drawConnections();
                            // ensureVizBounds();
                            // energyFlow.autoResizeSVG();
                        }, Math.max(600, FADE_MS + 200));

                        // 🔹 Eliminar botón flotante
                        if (this.collapseButton) {
                            this.collapseButton.remove();
                            this.collapseButton = null;
                        }

                    }, 500); // duración de collapse (coincide con tu función animada)
                }
                if (nodeType === 'transformacion') {
                    // recoger hijos visibles actuales
                    const hijos = this.childNodeIds.map(id => energyFlow.nodes[id]).filter(Boolean);
                    if (hijos.length === 0) return;

                    const nodoPrimarios = energyFlow.nodes['primarios'];
                    const FADE_MS = 360;
                    // punto al que colapsan: la posición del nodoPrimarios (o this.position si prefieres)
                    const endX = nodoPrimarios ? nodoPrimarios.position.x : this.position.x;
                    const endY = nodoPrimarios ? nodoPrimarios.position.y : this.position.y;

                    // 1) Animar colapso (mueve y despide)
                    animateNodeCollapse(hijos, endX, endY, () => {
                        // 2) después de la animación: eliminamos DOM y referencias
                        hijos.forEach(child => {
                            if (child && child.element && child.element.parentNode) child.element.remove();
                            if (child) delete energyFlow.nodes[child.id];
                        });

                        // 3) Restaurar (fade-in) de transformacion y salidasPrimarias
                        const nodoTransformacion = energyFlow.nodes['transformacion'];
                        const nodoSalidasPrimarias = energyFlow.nodes['salidasPrimarias'];
                        const restaurar = [nodoTransformacion, nodoSalidasPrimarias].filter(Boolean);

                        restaurar.forEach(n => {
                            n.hidden = false;
                            n.element.style.display = "";
                            // preparar fade-in
                            n.element.style.transition = `opacity ${FADE_MS}ms ease, transform ${FADE_MS}ms ease`;
                            n.element.style.opacity = 0;
                            n.element.style.transform = 'scale(0.92)';
                            // next frame -> animate in
                            requestAnimationFrame(() => {
                                n.element.style.opacity = 1;
                                n.element.style.transform = 'scale(1)';
                            });
                        });

                        // 4) Restaurar conexiones originales (puedes ajustar valores)
                        collapseLocalNode(this, energyFlow);

                        // limpiar estado del nodo
                        this.childNodeIds = [];
                        this.expanded = false;
                        connector.innerHTML = '<span>+</span>';

                        energyFlow.state.primariosExpanded = false;

                        // 🔄 Restaurar el zoom si estaba activo
                        if (this.zoomedOut) {
                            if (!energyFlow.state.transformacionExpanded && !energyFlow.state.secundariosExpanded) {
                                animateGlobalZoom(1, 700);
                                //energyFlow.autoResizeSVG();   // regreso a zoom normal
                                this.zoomedOut = false;

                                // 💫 Restaurar posiciones originales
                                energyFlow.restoreStatePosition("importacionES", "base", 900);
                                energyFlow.restoreStatePosition("viDifES", "base", 900);
                            }
                        }

                        // ────────────────────────────────────────────────
                        //  🔁 NUEVO: Si transformación estaba expandido 
                        //     cuando colapsamos PRIMARIOS → restaurar nodos
                        // ────────────────────────────────────────────────
                        if (energyFlow.state.transformacionExpanded && !energyFlow.state.secundariosExpanded) {
                            console.log("↩️ Restaurando posiciones porque TRANSFORMACIÓN estaba expandido durante el colapso de PRIMARIOS...");

                            energyFlow.restoreStatePosition("importacionES", "primarios", 900);
                            energyFlow.restoreStatePosition("viDifES", "primarios", 900);
                        }
                        if (energyFlow.state.transformacionExpanded && energyFlow.state.secundariosExpanded) {
                            energyFlow.restoreStatePosition("importacionES", "primarios", 900);
                            energyFlow.restoreStatePosition("viDifES", "primarios", 900);
                        }

                        // 5) redibujar conexiones ligeramente después (dejar que el fade termine)
                        setTimeout(() => {
                            // reejecutar funciones dependientes
                            conectarPrimariosAUsosFinales(energyFlow);
                            conectarSecundariosATransformacion(energyFlow);
                            energyFlow.drawConnections();
                            // ensureVizBounds();
                            // energyFlow.autoResizeSVG();
                        }, Math.max(500, FADE_MS + 160));

                        // 🔹 Eliminar botón flotante
                        if (this.collapseButton) {
                            this.collapseButton.remove();
                            this.collapseButton = null;
                        }

                    }, 500); // duración que le damos a animateNodeCollapse
                }
                // --- COLAPSO DEL NODO TRANSFORMACIÓN ---
                if (nodeType === 'energeticosSecundarios') {
                    const nodoEnergSecundarios = energyFlow.nodes['energeticosSecundarios'];

                    // Obtener todos los hijos visibles
                    const hijos = this.childNodeIds.map(id => energyFlow.nodes[id]).filter(Boolean);

                    if (nodoEnergSecundarios && hijos.length > 0) {
                        const endX = nodoEnergSecundarios.position.x;
                        const endY = nodoEnergSecundarios.position.y;

                        // 🔹 Animar colapso de los hijos hacia Energéticos Secundarios
                        animateNodeCollapse(hijos, endX, endY, () => {
                            // Después de la animación, eliminamos hijos y restauramos nodo original
                            hijos.forEach(child => {
                                child.element.remove();
                                delete energyFlow.nodes[child.id];
                            });

                            // 🔹 Mostrar de nuevo Energéticos Secundarios con efecto suave
                            nodoEnergSecundarios.hidden = false;
                            nodoEnergSecundarios.element.style.display = "block";
                            nodoEnergSecundarios.element.style.opacity = 0;
                            nodoEnergSecundarios.element.style.transform = "scale(0.8)";
                            nodoEnergSecundarios.element.style.transition = "opacity 0.4s ease, transform 0.4s ease";

                            requestAnimationFrame(() => {
                                nodoEnergSecundarios.element.style.opacity = 1;
                                nodoEnergSecundarios.element.style.transform = "scale(1)";
                            });

                            // --- ⬇️ BLOQUE DE ZOOM + RESTAURAR ---
                            if (this.zoomedOut) {
                                if(!energyFlow.state.produccionExpanded && !energyFlow.state.secundariosExpanded){
                                    animateGlobalZoom(1, 700);
                                    //energyFlow.autoResizeSVG();
                                    this.zoomedOut = false;
                                    energyFlow.restoreStatePosition("importacionES", "base", 900);
                                    energyFlow.restoreStatePosition("viDifES", "base", 900);
                                    energyFlow.restoreStatePosition("salidasSecundarias", "base", 900);
                                }
                                if(!energyFlow.state.produccionExpanded && energyFlow.state.secundariosExpanded){

                                    const salidaNodes = getSalidaSecundariaNodes(energyFlow);

                                    salidaNodes.forEach(n => {
                                        energyFlow.restoreStatePosition(n.id, "transformacion", 900);
                                    });
                                }
                                if(energyFlow.state.produccionExpanded && !energyFlow.state.secundariosExpanded){
                                    energyFlow.restoreStatePosition("salidasSecundarias", "base", 900);
                                }
                                if(energyFlow.state.produccionExpanded && energyFlow.state.secundariosExpanded){
                                    energyFlow.restoreStatePosition("viDifES", "transformacion", 900);

                                    const salidaNodes = getSalidaSecundariaNodes(energyFlow);

                                    salidaNodes.forEach(n => {
                                        energyFlow.restoreStatePosition(n.id, "transformacion", 900);
                                    });
                                }
                            }

                            // 🔗 Restaurar conexiones originales con efecto de desvanecido
                            collapseLocalNode(this, energyFlow);

                            this.childNodeIds = [];
                            this.expanded = false;
                            connector.innerHTML = '<span>+</span>';

                            energyFlow.state.transformacionExpanded = false;

                            // 🔹 Redibujar con animación suave de líneas
                            setTimeout(() => {
                                energyFlow.drawConnections(true);
                                // ensureVizBounds();
                                // energyFlow.autoResizeSVG();
                            }, 800); // igual que el fade del removeLink

                            // 🔹 Eliminar botón flotante
                            if (this.collapseButton) {
                                this.collapseButton.remove();
                                this.collapseButton = null;
                            }

                        });
                    }
                }
                if (nodeType === 'usosFinales') {
                    const hijos = this.childNodeIds.map(id => energyFlow.nodes[id]).filter(Boolean);
                    if (hijos.length === 0) return;

                    const nodoEnergSecundarios = energyFlow.nodes['energeticosSecundarios'];

                    const nodoSalidasSecundarias = energyFlow.nodes['salidasSecundarias'];
                    const nodoUsosFinales = energyFlow.nodes['usosFinales'];
                    const FADE_MS = 360;

                    // punto final (si el nodo existe, su posición; si no, la posición actual del padre)
                    const endX = this.position.x;
                    const endY = this.position.y;

                    // 1) Animar colapso (todos los hijos deben moverse y desvanecerse)
                    animateNodeCollapse(hijos, endX, endY, () => {
                        // 2) eliminar DOM y referencias
                        hijos.forEach(child => {
                            if (child && child.element && child.element.parentNode) child.element.remove();
                            if (child) delete energyFlow.nodes[child.id];
                        });

                        // 3) Restaurar visibilidad de nodos principales con fade-in
                        [nodoSalidasSecundarias, nodoUsosFinales].forEach(n => {
                            if (!n) return;
                            n.hidden = false;
                            n.element.style.display = "";
                            n.element.style.transition = `opacity ${FADE_MS}ms ease, transform ${FADE_MS}ms ease`;
                            n.element.style.opacity = 0;
                            n.element.style.transform = 'scale(0.92)';
                            requestAnimationFrame(() => {
                                n.element.style.opacity = 1;
                                n.element.style.transform = 'scale(1)';
                            });
                        });

                        // 4) Restaurar conexiones originales
                        collapseLocalNode(this, energyFlow);

                        // limpiar estado
                        this.childNodeIds = [];
                        this.expanded = false;
                        connector.innerHTML = '<span>+</span>';

                        // --- ⬇️ BLOQUE DE ZOOM + RESTAURAR ---
                        if (this.zoomedOut) {

                            // Solo restaurar zoom si producción NO está expandido
                            if (!energyFlow.state.produccionExpanded && !energyFlow.state.primariosExpanded) {
                                animateGlobalZoom(1, 700);
                                //energyFlow.autoResizeSVG();
                                this.zoomedOut = false;
                                energyFlow.restoreStatePosition("importacionES", "base", 900);
                                energyFlow.restoreStatePosition("viDifES", "base", 900);
                            }
                            if (energyFlow.state.primariosExpanded && energyFlow.state.produccionExpanded){
                                energyFlow.restoreStatePosition("importacionES", "secundarios", 900);
                                energyFlow.restoreStatePosition("viDifES", "secundarios", 900);
                            }
                        }

                        energyFlow.state.secundariosExpanded = false;

                        // 5) redibujar y reconectar después de que termine el fade
                        setTimeout(() => {
                            conectarPrimariosAUsosFinales(energyFlow);
                            energyFlow.drawConnections();
                            // ensureVizBounds();
                            // energyFlow.autoResizeSVG();
                        }, Math.max(500, FADE_MS + 160));

                        // 🔹 Eliminar botón flotante
                        if (this.collapseButton) {
                            this.collapseButton.remove();
                            this.collapseButton = null;
                        }

                    }, 500); // duración de collapse (coincide con tu función)
                }
            }

        }

        class IntermediateNode extends SourceNode {
            // Inherits the output connector from SourceNode.
            // It can also be a target, which is handled by the linking logic.
        }

        class SinkNode extends EnergyNode {
            // No output connector handle needed. Just uses the base class element.
        }

        class EnergyFlow {
            constructor() {
                this.nodes = {};
                this.links = [];
                this.particles = [];
                this.globalScale = 1;
                this.focusRootId = null;
                this.svg = document.getElementById('connection-canvas');
                this.init();
                window.addEventListener('resize', () => this.drawConnections());
                // en la inicialización de energyFlow (una vez)
                window.addEventListener('nodeDragged', () => {
                    // 'this' no está disponible aquí — usa la instancia global energyFlow
                    if (typeof energyFlow !== 'undefined') {
                        energyFlow.drawConnections();
                        // ensureVizBounds();
                        // energyFlow.autoResizeSVG();
                    }
                });
                this.state = {
                    primariosExpanded: false,
                    produccionExpanded: false,
                    transformacionExpanded: false,
                    secundariosExpanded: false
                };
            }

            updateNodeConnections(movedNode) {
                this.links.forEach(link => {
                    if (link.from === movedNode.id || link.to === movedNode.id) {
                        const path = document.getElementById(`path-${link.from}-to-${link.to}`);
                        const label = document.getElementById(`label-${link.from}-to-${link.to}`);
                        const rect = document.getElementById(`rect-${link.from}-to-${link.to}`);

                        if (!path) return;

                        // Evitar actualizar si la línea está desvaneciéndose
                        if (path.dataset.isFadingOut === "true") return;

                        // Recalcular posiciones
                        const startNode = this.nodes[link.from];
                        const endNode = this.nodes[link.to];
                        if (!startNode || !endNode) return;

                        const start = startNode.getConnectorPoint(true);
                        const end = endNode.getConnectorPoint(false);

                        const curvature = 0.5;
                        const dx = end.x - start.x;
                        const dy = end.y - start.y;
                        const cx1 = start.x + dx * curvature;
                        const cy1 = start.y;
                        const cx2 = end.x - dx * curvature;
                        const cy2 = end.y;

                        // Actualizar el path
                        path.setAttribute("d", `M ${start.x},${start.y} C ${cx1},${cy1} ${cx2},${cy2} ${end.x},${end.y}`);

                        // Reubicar label y rect si existen
                        if (label && rect) {
                            const midX = (start.x + end.x) / 2;
                            const midY = (start.y + end.y) / 2;
                            label.setAttribute("x", midX);
                            label.setAttribute("y", midY);
                            rect.setAttribute("x", midX - 15);
                            rect.setAttribute("y", midY - 10);
                        }
                    }
                });
            }

            addLink(link) {
                link._destroyed = false;
                // evita duplicados y permite actualizar value si ya existe
                const found = this.links.find(l => l.from === link.from && l.to === link.to);
                if (found) {
                    if (link.value !== undefined) found.value = link.value;
                } else {
                    this.links.push({ ...link });
                }
            }

            removeLink(from, to) {

                this.links.forEach(link => {
                    if (link.from === from && link.to === to) {
                        link._destroyed = true;   // 🔥 marcar como muerto
                    }
                });

                // Eliminamos del arreglo de links de forma inmediata (la "fuente de verdad").
                this.links = this.links.filter(l => !(l.from === from && l.to === to));

                // IDs de los elementos SVG que creas en drawConnections
                const pathId = `path-${from}-to-${to}`;
                const labelId = `label-${from}-to-${to}`;
                const rectId = `rect-${from}-to-${to}`;

                const pathEl = document.getElementById(pathId);
                const labelEl = document.getElementById(labelId);
                const rectEl = document.getElementById(rectId);

                const FADE_MS = 600;

                // Fade path + label + rect (si existen)
                if (pathEl) {
                    // marca que está en fade para evitar dobles fade/conflictos
                    pathEl.dataset.fadingOut = "true";
                    pathEl.style.transition = `stroke-opacity ${FADE_MS}ms ease`;
                    pathEl.style.strokeOpacity = 0;
                }
                if (labelEl) {
                    labelEl.dataset.fadingOut = "true";
                    labelEl.style.transition = `opacity ${FADE_MS}ms ease`;
                    labelEl.style.opacity = 0;
                }
                if (rectEl) {
                    rectEl.dataset.fadingOut = "true";
                    rectEl.style.transition = `opacity ${FADE_MS}ms ease`;
                    rectEl.style.opacity = 0;
                }

                // Programar la eliminación, pero SOLO si el link NO fue vuelto a crear
                setTimeout(() => {
                    const stillExists = this.links.some(l => l.from === from && l.to === to);
                    // Si ya existe de nuevo, cancelamos la eliminación (dejamos el DOM)
                    if (stillExists) {
                        // limpiamos flags y restauramos opacities (por si otro fade los dejó a 0)
                        if (pathEl) { pathEl.dataset.fadingOut = ""; pathEl.style.strokeOpacity = 0.8; }
                        if (labelEl) { labelEl.dataset.fadingOut = ""; labelEl.style.opacity = 1; }
                        if (rectEl) { rectEl.dataset.fadingOut = ""; rectEl.style.opacity = 1; }
                        return;
                    }

                    // Sino, eliminamos los elementos DOM si siguen presentes
                    if (pathEl && pathEl.parentNode) pathEl.remove();
                    if (labelEl && labelEl.parentNode) labelEl.remove();
                    if (rectEl && rectEl.parentNode) rectEl.remove();
                }, FADE_MS + 20);
            }

            init() {
                this.svg = document.getElementById('connection-canvas');

                this.svg.setAttribute("viewBox", "0 0 2500 1500");

                // Grupos para organizar niveles
                this.pathsGroup = document.createElementNS('http://www.w3.org/2000/svg', 'g');
                this.particlesGroup = document.createElementNS('http://www.w3.org/2000/svg', 'g');
                this.labelsGroup = document.createElementNS('http://www.w3.org/2000/svg', 'g');

                // Agregar los grupos en orden visual
                this.svg.appendChild(this.pathsGroup);
                this.svg.appendChild(this.particlesGroup);
                this.svg.appendChild(this.labelsGroup);

                // ✅ Guardar referencia global (para las partículas)
                window.energyFlow = this;

                this.setupGlobalListeners();
                this.loadData();
                this.drawConnections();
                requestAnimationFrame(() => this.animate());
            }

