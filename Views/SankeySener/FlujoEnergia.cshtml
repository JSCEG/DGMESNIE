        // --- CLASSES & FUNCTIONS ---

        class Particle {
            constructor(path, color, speed, linkId, linkRef) {
                this.path = path;
                this.pathLength = path.getTotalLength();
                this.distance = 0;
                this.speed = speed;
                this.linkId = linkId;
                this.link = linkRef;

                this.element = document.createElementNS('http://www.w3.org/2000/svg', 'circle');
                this.element.setAttribute('r', 3);
                this.element.setAttribute('fill', color);

                const particlesGroup = window.energyFlow?.particlesGroup;
                if (particlesGroup) particlesGroup.appendChild(this.element);
            }

            update() {

                // ❌ Si el link ya no existe en el DOM → morir
                if (!this.link || this.link._destroyed) {
                    this.destroy();
                    return false;
                }

                // ❌ Si el path ya no existe (colapso / redibujo)
                if (!document.getElementById(`path-${this.link.from}-to-${this.link.to}`)) {
                    this.destroy();
                    return false;
                }

                // 🎯 Foco visual (esto ya lo tenías bien)
                if (focusedNodeId && !this.link.isFocused) {
                    this.element.style.opacity = '0.05';
                } else {
                    this.element.style.opacity = '1';
                }

                this.distance += this.speed * this.pathLength;

                if (this.distance >= this.pathLength) {
                    this.destroy();
                    return false;
                }

                const p = this.path.getPointAtLength(this.distance);
                this.element.setAttribute('cx', p.x);
                this.element.setAttribute('cy', p.y);

                return true;
            }

            destroy() {
                this.element.remove();
            }
        }

