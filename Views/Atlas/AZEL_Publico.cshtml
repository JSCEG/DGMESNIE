                                    <script>
                                        // Lista de capas raster reales (7 capas, igual que en ponerLinksDescargaDirectos)
                                        const capasRaster = [
                                            {
                                                nombre: '🌞 Potencial Fotovoltaico',
                                                url: 'https://cdn.sassoapps.com/geopackage/potencial_fotovoltaico.gpkg'
                                            },
