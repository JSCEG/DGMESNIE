@using NSIE.Models
@using Newtonsoft.Json

@{
    Layout = "~/Views/Shared/_Layout.cshtml";

    ViewData["Title"] = "Atlas de Zonas con Energías Limpias";

    var header = new HeaderViewModel
    {
        Title = "AZEL",
        IconPath = "conding.png",
        Description = "Inventario y potencial territorial de los recursos renovables en México.",
        Section = "SNIEr > Atlas energético > AZEL",
        ModuleInfo = JsonConvert.SerializeObject(new
        {
            title = "AZEL",
            description = "Consulta geográfica del inventario y potencial de recursos renovables.",
            functionality = "Explora capas, localiza permisos y analiza el potencial energético del territorio.",
            stage = "Disponible",
            roles = new[] { new { icon = "user-shield", text = "Acceso para usuarios autenticados" } },
            order = new { step = 1, description = "Atlas energético institucional" },
            manualUrl = "#"
        })
    };
}

@section Styles {
    <link rel="stylesheet" href="~/css/mapa_azel.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/azel-publico.css" asp-append-version="true" />
}

<div class="azel-view-header">
    @await Html.PartialAsync("_ViewHeader", header)
</div>

<div class="container-fluid azel-page-shell">
</div>

<div class="container-fluid azel-page-shell">
    <div class="azel-intro-card">
        <div class="azel-intro-card__content">
            <span class="azel-eyebrow">Exploración geoespacial</span>
            <h1>Conoce el potencial renovable de México</h1>
            <p>Consulta recursos solares, eólicos, geotérmicos, hídricos y de biomasa; localiza proyectos autorizados y agrega áreas propias para análisis.</p>
        </div>
        <div class="azel-intro-card__meta" aria-label="Características del atlas">
            <span><i class="bi bi-layers" aria-hidden="true"></i> 13 capas descargables</span>
            <span><i class="bi bi-geo-alt" aria-hidden="true"></i> Cobertura nacional</span>
            <span><i class="bi bi-shield-check" aria-hidden="true"></i> Acceso institucional</span>
        </div>
    </div>
</div>

