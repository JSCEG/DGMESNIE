                                    <h3 style="font-size: 10px; margin: 0 0 5px; color: #1e5b4f; text-transform: uppercase; font-family: Montserrat, sans-serif; font-weight: 700;">Distribución Geográfica</h3>
                                    <div id="slide-chart-pie" style="flex: 1; min-height: 0; width: 100%;"></div>
                                </div>
                            </div>
                        </div>
                        <div class="internal-slide__footer">
                            <span></span>
                            <span></span>
                            <span></span>
                        </div>
                    </section>
                `;
            }

            // NOTE: getBarChartSlideHtml and getPieChartSlideHtml are now merged into getIndicatorsSlideHtml (combined KPI + chart slide)
            // These functions are kept as empty stubs to avoid breaking references, but no longer inject slides.
            function getBarChartSlideHtml() { return ''; }
            function getPieChartSlideHtml() { return ''; }

            function getGroupsDetailSlidesHtml(filtered) {
                const chunkSize = 8;
                let slidesHtml = '';
                
                for (let i = 0; i < filtered.length; i += chunkSize) {
                    const chunk = filtered.slice(i, i + chunkSize);
                    const pageNum = Math.floor(i / chunkSize) + 1;
                    const totalPages = Math.ceil(filtered.length / chunkSize);
                    
                    const rowsHtml = chunk.map(g => {
                        const contactName = g.contacto ? g.contacto.split('\n')[0] : '-';
                        const contactEmail = g.correo ? g.correo.split('\n')[0] : '';
                        const emailHtml = contactEmail ? `<br><small class="text-muted"><i class="bi bi-envelope me-1"></i>${escapeHtml(contactEmail)}</small>` : '';
                        const totalProjBadgeStyle = g.totalProyectos > 0
                            ? 'background:#9B2247;color:#ffffff;border:1px solid #861b3c;'
                            : 'background:#ffffff;color:#172333;border:1px solid #d8dee6;';
                        const countryBadge = g.origen
                            ? `<span style="display:inline-block; background:${countryColor(g.origen)}; color:#1f2937; border:1px solid rgba(15,23,42,0.14); border-radius:999px; padding:5px 12px; font-size:0.78rem; font-weight:800; line-height:1.2; white-space:normal;">${escapeHtml(g.origen)}</span>`
                            : '<span style="display:inline-block; background:#f3f4f6; color:#4b5563; border:1px solid #d1d5db; border-radius:999px; padding:5px 12px; font-size:0.78rem; font-weight:800; line-height:1.2;">N/E</span>';

                        return `
                            <tr>
                                <td style="width: 60px; text-align: center;"><strong>${g.grupoInteresId}</strong></td>
                                <td><strong>${escapeHtml(g.nombre)}</strong></td>
                                <td style="width: 150px; text-align: center;">${countryBadge}</td>
                                <td>${escapeHtml(contactName)}${emailHtml}</td>
                                <td style="width: 120px; text-align: center;"><span style="display:inline-flex;align-items:center;justify-content:center;min-width:42px;border-radius:999px;padding:5px 13px;font-weight:800;line-height:1.1;${totalProjBadgeStyle}">${g.totalProyectos}</span></td>
                            </tr>
                        `;
                    }).join('');
                    
                    slidesHtml += `
                        <section class="internal-slide internal-slide--content">
                            <div class="internal-slide__top">
                                <div class="internal-slide__brand">
                                     <img src="https://cdn.sassoapps.com/dgmesnie/logo_gob.png" alt="Gobierno de México">
                                     <img src="https://cdn.sassoapps.com/dgmesnie/logo_sener.png" alt="Secretaría de Energía">
                                </div>
                                <div class="internal-slide__title">Listado de Desarrolladores (${pageNum} de ${totalPages})</div>
                                <div class="internal-slide__unit">DGMESNIE · Grupos de Interés</div>
                            </div>
                            <div class="internal-slide__body" style="padding: 24px; display: flex; flex-direction: column; flex: 1;">
                                <h2>Matriz de Grupos Económicos Registrados</h2>
                                <table class="slide-table" style="font-size: 0.85rem; width: 100%;">
                                    <thead>
                                        <tr>
                                            <th style="width: 60px; text-align: center;">ID</th>
                                            <th>Grupo de Interés / Desarrollador</th>
                                            <th style="width: 150px; text-align: center;">Origen</th>
                                            <th>Contacto Principal</th>
                                            <th style="width: 120px; text-align: center;">Proyectos</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        ${rowsHtml}
                                    </tbody>
                                </table>
                            </div>
                            <div class="internal-slide__footer">
                                <span></span>
                                <span></span>
                                <span></span>
                            </div>
                        </section>
                    `;
                }
                return slidesHtml;
            }

            function renderSlideCharts(filtered) {
                // Palette institucional
                const palette = ['#9B2247', '#1E5B4F', '#A57F2C', '#245b8f', '#e26b8e', '#5fa095', '#d4af37', '#6c757d', '#c0392b', '#27ae60'];

                // Establecer opciones globales de Highcharts con la paleta institucional
                if (window.Highcharts) {
                    Highcharts.setOptions({
                        colors: palette,
                        chart: {
                            backgroundColor: '#ffffff',
                            style: { fontFamily: 'Inter, Noto Sans, sans-serif' }
                        },
                        title: {
                            style: { color: '#243444', fontWeight: '700', fontSize: '11px' }
                        },
                        xAxis: {
                            labels: { style: { color: '#425163', fontSize: '9px' } }
                        },
                        yAxis: {
                            title: { style: { color: '#425163', fontSize: '9px' } },
                            labels: { style: { color: '#425163', fontSize: '9px' } }
                        },
                        legend: {
                            itemStyle: { color: '#243444', fontSize: '9px', fontWeight: '600' }
                        },
                        tooltip: {
                            backgroundColor: '#ffffff',
                            borderColor: '#A57F2C',
                            style: { color: '#243444' }
                        }
                    });
                }

                const topData = [...filtered]
                    .sort((a, b) => b.totalProyectos - a.totalProyectos)
                    .slice(0, 10);

                const nombres = topData.map(d => d.nombre.length > 20 ? d.nombre.substring(0, 20) + '…' : d.nombre);
                const cantidades = topData.map((d, i) => ({ y: d.totalProyectos, color: palette[i % palette.length] }));

                const counts = {};
                filtered.forEach(g => {
                    const p = g.origen || 'No especificado';
                    counts[p] = (counts[p] || 0) + 1;
                });
                const pieData = Object.entries(counts).map(([name, y], i) => ({ name, y, color: palette[i % palette.length] }));

                if (document.getElementById('slide-chart-barras') && window.Highcharts) {
                    Highcharts.chart('slide-chart-barras', {
                        chart: { type: 'column', backgroundColor: '#ffffff' },
                        title: { text: null },
                        credits: { enabled: false },
                        exporting: { enabled: false },
                        xAxis: {
                            categories: nombres,
                            labels: { style: { color: '#425163', fontSize: '9px' }, rotation: -30 }
                        },
                        yAxis: {
                            title: { text: null },
                            allowDecimals: false
                        },
                        plotOptions: {
                            column: {
                                borderRadius: 4,
                                colorByPoint: true
                            }
                        },
                        series: [{
                            name: 'Proyectos / Filiales',
                            data: cantidades
                        }],
                        legend: { enabled: false }
                    });
                }

                if (document.getElementById('slide-chart-pie') && window.Highcharts) {
                    Highcharts.chart('slide-chart-pie', {
                        chart: { type: 'pie', backgroundColor: '#ffffff' },
                        title: { text: null },
                        credits: { enabled: false },
                        exporting: { enabled: false },
                        tooltip: { pointFormat: '<b>{point.y}</b> grupo(s) ({point.percentage:.1f}%)' },
                        plotOptions: {
                            pie: {
                                innerSize: '45%',
                                borderWidth: 2,
                                borderColor: '#ffffff',
                                dataLabels: { enabled: false },
                                showInLegend: true
                            }
                        },
                        legend: {
                            align: 'center',
                            verticalAlign: 'bottom',
                            itemStyle: { fontSize: '9px', color: '#243444' }
                        },
                        series: [{
                            name: 'Desarrolladores',
                            colorByPoint: true,
                            data: pieData
                        }]
                    });
                }
            }

            function renderReportDeck() {
                const deck = document.getElementById('internal-report-deck');
                if (!deck) return;

                const filtered = filterReportData();
                const totalGrupos = filtered.length;
                const totalProyectos = filtered.reduce((acc, item) => acc + (item.totalProyectos || 0), 0);
                const uniqueCountries = new Set(filtered.map(x => x.origen).filter(Boolean));
                const totalPaises = uniqueCountries.size;

                const summaryEl = document.getElementById('rep-summary');
                if (summaryEl) {
                    summaryEl.textContent = `${totalGrupos} desarrollador(es) · ${totalProyectos} proyectos asociados · ${totalPaises} países involucrados`;
                }

                let deckHtml = '';
                deckHtml += getCoverSlideHtml(totalGrupos, totalProyectos, totalPaises);
                deckHtml += getIndicatorsSlideHtml(totalGrupos, totalProyectos, totalPaises);
                
                if (totalGrupos > 0) {
                    deckHtml += getBarChartSlideHtml();
                    deckHtml += getPieChartSlideHtml();
                    deckHtml += getGroupsDetailSlidesHtml(filtered);
                } else {
                    deckHtml += `
                        <section class="internal-slide internal-slide--content">
                            <div class="internal-slide__body justify-content-center align-items-center">
                                <i class="bi bi-info-circle text-muted fs-1 mb-3"></i>
                                <p class="text-muted">No hay datos que coincidan con los filtros seleccionados.</p>
                            </div>
                        </section>
                    `;
                }

                deck.innerHTML = deckHtml;

                if (totalGrupos > 0) {
                    renderSlideCharts(filtered);
                }
            }

            // ── EXPORTACIÓN DE DIAPOSITIVAS A PDF (LANDSCAPE) ─────────────────────────
            async function descargarPdf() {
                if (!window.jspdf || !window.html2canvas) {
                    Swal.fire('Error', 'Las librerías de generación de PDF no están cargadas.', 'error');
                    return;
                }
                const slides = [...document.querySelectorAll('#internal-report-deck .internal-slide')];
                if (!slides.length) {
                    Swal.fire('Error', 'No hay diapositivas para exportar.', 'error');
                    return;
                }

                Swal.fire({
                    title: 'Generando PDF...',
                    text: 'Procesando cada lámina del reporte en alta definición...',
                    allowOutsideClick: false,
                    didOpen: () => { Swal.showLoading(); }
                });

                try {
                    const { jsPDF } = window.jspdf;
                    const pdf = new jsPDF({ orientation: 'landscape', unit: 'px', format: [1280, 720] });

                    for (let idx = 0; idx < slides.length; idx++) {
                        const canvas = await html2canvas(slides[idx], {
                            scale: 2, 
                            useCORS: true,
                            allowTaint: false,
                            backgroundColor: '#ffffff'
                        });
                        const img = canvas.toDataURL('image/jpeg', 0.95);
                        if (idx > 0) pdf.addPage([1280, 720], 'landscape');
                        pdf.addImage(img, 'JPEG', 0, 0, 1280, 720);
                    }

                    pdf.save(`Reporte_Grupos_Interes_${new Date().toISOString().slice(0, 10)}.pdf`);
                    Swal.close();
                    Swal.fire('¡Éxito!', 'El PDF ha sido generado y descargado.', 'success');
                } catch (err) {
                    console.error('Error generando PDF', err);
                    Swal.close();
                    Swal.fire('Error', 'No fue posible generar el PDF del reporte.', 'error');
                }
            }

            // ── ENVÍO DE REPORTES POR CORREO (SMTP INTEGRATION) ──────────────────────
            function abrirModalCorreo() {
                Swal.fire({
                    title: 'Enviar Reporte',
                    input: 'email',
                    inputLabel: 'Introduzca la dirección de correo electrónico del destinatario:',
                    inputPlaceholder: 'correo@energia.gob.mx',
                    showCancelButton: true,
                    confirmButtonColor: '#9B2247',
                    cancelButtonColor: '#6c757d',
                    confirmButtonText: 'Enviar Reporte',
                    cancelButtonText: 'Cancelar',
                    inputValidator: (value) => {
                        if (!value) {
                            return '¡El correo electrónico es requerido!';
                        }
                        const emailRegex = /^[^\s@@]+@@[^\s@@]+\.[^\s@@]+$/;
                        if (!emailRegex.test(value)) {
                            return '¡Por favor ingrese un formato de correo válido!';
                        }
                    }
                }).then((result) => {
                    if (result.isConfirmed) {
                        const email = result.value;

                        Swal.fire({
                            title: 'Enviando correo...',
                            text: 'Generando reporte y conectando con el servidor SMTP...',
                            allowOutsideClick: false,
                            didOpen: () => { Swal.showLoading(); }
                        });

                        $.ajax({
                            url: '/GruposInteres/Api/EnviarReporte',
                            type: 'POST',
                            contentType: 'application/json',
                            data: JSON.stringify({ Destinatario: email }),
                            headers: {
                                "RequestVerificationToken": $('input[name="__RequestVerificationToken"]').val()
                            },
                            success: function(res) {
                                Swal.close();
                                Swal.fire('¡Enviado!', res.mensaje, 'success');
                            },
                            error: function(err) {
                                Swal.close();
                                const errMsg = err.responseJSON && err.responseJSON.error ? err.responseJSON.error : 'No se pudo enviar el correo electrónico.';
                                Swal.fire('Error de Envío', errMsg, 'error');
                            }
                        });
                    }
                });
            }

            // ── MODO PRESENTACIÓN (PANTALLA COMPLETA) ──────────────────────────────────
            function setPresentationControls(visible) {
                const controls = document.getElementById('presentationControls');
                if (!controls) return;
                controls.style.display = visible ? 'flex' : 'none';
                controls.setAttribute('aria-hidden', visible ? 'false' : 'true');
            }

            function fitActiveSlide() {
                if (!presentationMode || !presentationSlides.length) return;
                const active = presentationSlides[presentationIndex];
                if (!active) return;

                const baseW = active.offsetWidth || 1280;
                const baseH = active.offsetHeight || 720;
                const baseScale = Math.min(window.innerWidth / baseW, window.innerHeight / baseH);
                const scale = Math.max(0.2, baseScale * 0.98);
                active.style.setProperty('--presentation-scale', scale.toFixed(4));
            }

            function renderPresentationState() {
                if (!presentationSlides.length) return;
                presentationSlides.forEach((slide, idx) => {
                    slide.classList.toggle('active', idx === presentationIndex);
                    if (idx !== presentationIndex) slide.style.removeProperty('--presentation-scale');
                });
                const counter = document.getElementById('presentationCounter');
                if (counter) counter.textContent = `${presentationIndex + 1}/${presentationSlides.length}`;
                fitActiveSlide();

                // Reflow Highcharts in current active slide to scale nicely
                setTimeout(() => {
                    if (window.Highcharts) {
                        Highcharts.charts.forEach(c => {
                            if (c) c.reflow();
                        });
                    }
                }, 50);
            }

            async function enterPresentation(startAt = 0) {
                presentationSlides = [...document.querySelectorAll('#internal-report-deck .internal-slide')];
                if (!presentationSlides.length) return;
                presentationMode = true;
                presentationIndex = Math.min(Math.max(startAt, 0), presentationSlides.length - 1);
                document.body.classList.add('presentation-mode');
                setPresentationControls(true);
                renderPresentationState();
                if (!document.fullscreenElement && document.documentElement.requestFullscreen) {
                    try { await document.documentElement.requestFullscreen(); } catch (_) { }
                }
                requestAnimationFrame(fitActiveSlide);
            }

            async function exitPresentation() {
                if (!presentationMode) return;
                presentationMode = false;
                document.body.classList.remove('presentation-mode');
                presentationSlides.forEach(slide => {
                    slide.classList.remove('active');
                    slide.style.removeProperty('--presentation-scale');
                });
                setPresentationControls(false);
                if (document.fullscreenElement && document.exitFullscreen) {
                    try { await document.exitFullscreen(); } catch (_) { }
                }
                
                // Reflow Highcharts back to normal sizes
                setTimeout(() => {
                    if (window.Highcharts) {
                        Highcharts.charts.forEach(c => {
                            if (c) c.reflow();
                        });
                    }
                }, 100);
            }

            function nextPresentationSlide() {
                if (!presentationMode) return;
                presentationIndex = Math.min(presentationSlides.length - 1, presentationIndex + 1);
                renderPresentationState();
            }

            function prevPresentationSlide() {
                if (!presentationMode) return;
                presentationIndex = Math.max(0, presentationIndex - 1);
                renderPresentationState();
            }
        })();
    </script>
}
