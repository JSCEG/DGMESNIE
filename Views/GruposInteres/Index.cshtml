            function cargarUsuariosCorreo() {
                $.get('/GruposInteres/Api/UsuariosCorreo', function (data) {
                    usuariosCorreo = Array.isArray(data)
                        ? data.filter(u => !esUsuarioConsultaPublica(u))
                        : [];
                });
            }

            function esUsuarioConsultaPublica(usuario) {
                const correo = (usuario?.correo || '').trim().toLowerCase();
                const nombre = (usuario?.nombre || '').normalize('NFD').replace(/[\u0300-\u036f]/g, '').replace(/\s+/g, '').toLowerCase();
                return correo === 'invitado@energia.gob.mx' || nombre.includes('consultapublica');
            }

            // Paleta de colores de fondo pastel para badges de país (texto siempre negro)
            const COUNTRY_PALETTE = [
                '#FBBF24', '#34D399', '#60A5FA', '#F87171', '#A78BFA',
                '#FB923C', '#4ADE80', '#38BDF8', '#F472B6', '#A3E635',
                '#2DD4BF', '#818CF8', '#FCD34D', '#6EE7B7', '#93C5FD',
                '#FCA5A5', '#C4B5FD', '#86EFAC', '#7DD3FC', '#FDA4AF'
            ];
            const _countryColorMap = {};
            let _countryColorIdx = 0;
            function countryColor(name) {
                if (!name) return null;
                const key = name.trim().toLowerCase();
                if (!_countryColorMap[key]) {
                    _countryColorMap[key] = COUNTRY_PALETTE[_countryColorIdx % COUNTRY_PALETTE.length];
                    _countryColorIdx++;
                }
                return _countryColorMap[key];
            }

            function inicializarDataTable(data) {
                tabla = $('#tablaGEIs').DataTable({
                    data: data,
                    columns: [
                        { data: 'grupoInteresId' },
                        { 
                            data: 'nombre',
                            render: function(data, type, row) {
                                return `<strong class="text-dark">${data}</strong>`;
                            }
                        },
                        { 
                            data: 'origen',
                            render: function(data) {
                                if (!data) return '<span class="text-muted fst-italic">N/E</span>';
                                const bg = countryColor(data);
                                return `<span style="display:inline-block; background:${bg}; color:#1a1a1a; font-weight:700; font-size:0.82rem; padding:4px 10px; border-radius:20px; white-space:nowrap;">${data}</span>`;
                            }
                        },
                        { 
                            data: 'contacto',
                            render: function(data, type, row) {
                                if (!data) return '<span class="text-muted">-</span>';
                                let html = `<div><i class="bi bi-person-fill text-muted me-1"></i>${data.split('\n')[0]}</div>`;
                                if (row.correo) {
                                    html += `<div style="font-size:0.8rem; color:#666;"><i class="bi bi-envelope text-muted me-1"></i>${row.correo.split('\n')[0]}</div>`;
                                }
                                return html;
                            }
                        },
                        { 
                            data: 'totalProyectos',
                            className: 'text-center',
                            render: function(data) {
                                let colorClass = data > 0 ? 'bg-success' : 'bg-light text-dark border';
                                return `<span class="badge ${colorClass} rounded-pill px-3 py-2" style="font-size:0.9rem;">${data}</span>`;
                            }
                        },
                        {
                            data: null,
                            orderable: false,
                            className: 'text-center',
                            render: function(data, type, row) {
                                const nombreSeguro = encodeURIComponent(row.nombre || '');
                                return `
                                    <div class="btn-group btn-group-sm" role="group">
                                        <button type="button" class="btn btn-outline-secondary" onclick="abrirModalVer(${row.grupoInteresId})" title="Solo ver">
                                            <i class="bi bi-eye"></i>
                                        </button>
                                        <button type="button" class="btn btn-outline-primary" onclick="abrirModalEditar(${row.grupoInteresId})" title="Editar / Ver Detalle">
                                            <i class="bi bi-pencil-square"></i>
                                        </button>
                                        <button type="button" class="btn btn-outline-success" onclick="abrirEnvioRegistro(${row.grupoInteresId})" title="Enviar por correo">
                                            <i class="bi bi-envelope-at"></i>
                                        </button>
                                        <button type="button" class="btn btn-outline-danger" onclick="eliminarGrupo(${row.grupoInteresId}, decodeURIComponent('${nombreSeguro}'))" title="Eliminar">
                                            <i class="bi bi-trash"></i>
                                        </button>
                                    </div>
                                `;
                            }
                        }
                    ],
                    language: {
                        url: 'https://cdn.datatables.net/plug-ins/1.13.4/i18n/es-ES.json'
                    },
                    pageLength: 10,
                    dom: '<"d-flex justify-content-between align-items-center mb-3"l>rtip',
                    initComplete: function() {
                        // Eventos para filtros del datatable
                        $('#filtroOrigen').change(function() {
                            let val = $(this).val();
                            tabla.column(2).search(val ? `^${val}$` : '', true, false).draw();
                        });

                        $('#filtroProyectos').change(function() {
                            let val = $(this).val();
                            if (val === 'con') {
                                tabla.column(4).search('^[1-9][0-9]*$', true, false).draw();
                            } else if (val === 'sin') {
                                tabla.column(4).search('^0$', true, false).draw();
                            } else {
                                tabla.column(4).search('').draw();
                            }
                        });
                    }
                });
            }

            // ── COMPORTAMIENTO DE FORMULARIO CRUD ─────────────────────────────────────
            window.abrirModalCrear = function() {
                setModalReadonly(false);
                $("#modalGEITitle").html('<i class="bi bi-plus-circle-fill text-success me-2"></i>Nuevo Grupo Económico de Interés');
                $("#inputGrupoInteresId").val('');
                $("#formGEI")[0].reset();
                $("#tbodyModalProyectos").empty();
                actualizarVisibilidadMensajeProyectos();
                $("#modalGEI").modal('show');
            };

            window.abrirModalEditar = function(id) {
                setModalReadonly(false);
                $("#modalGEITitle").html('<i class="bi bi-pencil-square text-warning me-2"></i>Detalles y Edición de Grupo de Interés');
                cargarDetalleEnModal(id);
            };

            window.abrirModalVer = function(id) {
                setModalReadonly(true);
                $("#modalGEITitle").html('<i class="bi bi-eye-fill text-info me-2"></i>Vista de Grupo de Interés');
                cargarDetalleEnModal(id);
            };

            function cargarDetalleEnModal(id) {
                $("#formGEI")[0].reset();
                $("#tbodyModalProyectos").empty();

                Swal.fire({
                    title: 'Cargando datos...',
                    allowOutsideClick: false,
                    didOpen: () => { Swal.showLoading(); }
                });

                $.get(`/GruposInteres/Api/ObtenerDetalle/${id}`, function(res) {
                    Swal.close();
                    $("#inputGrupoInteresId").val(res.grupoInteresId);
                    $("#inputNombre").val(res.nombre);
                    $("#inputOrigen").val(res.origen);
                    $("#inputContacto").val(res.contacto);
                    $("#inputCorreo").val(res.correo);
                    $("#inputTelefono").val(res.telefono);

                    if (res.proyectos && res.proyectos.length > 0) {
                        res.proyectos.forEach(p => {
                            agregarFilaProyecto(p);
                        });
                    }

                    actualizarVisibilidadMensajeProyectos();
                    $("#modalGEI").modal('show');
                }).fail(function() {
                    Swal.close();
                    Swal.fire('Error', 'No se pudieron recuperar los detalles del registro.', 'error');
                });
            }

            function setModalReadonly(isReadonly) {
                $("#modalGEI").toggleClass('readonly-mode', isReadonly);
                $("#formGEI").find('input:not([type="hidden"]), textarea').prop('readonly', isReadonly);
            }

            window.agregarFilaProyecto = function(proyecto = null) {
                const tbody = $("#tbodyModalProyectos");
                const idRow = 'p_row_' + Date.now() + Math.floor(Math.random() * 1000);
                
                const razonSocial = proyecto ? (proyecto.razonSocial || '') : '';
                const nombreProyecto = proyecto ? (proyecto.nombreProyecto || '') : '';
                const contacto = proyecto ? (proyecto.contacto || '') : '';
                const correo = proyecto ? (proyecto.correo || '') : '';
                const telefono = proyecto ? (proyecto.telefono || '') : '';
                const idProj = proyecto ? (proyecto.proyectoId || '') : '';

                const rowHtml = `
                    <tr id="${idRow}" class="fila-proyecto">
                        <input type="hidden" class="p-id" value="${idProj}">
                        <td><input type="text" class="form-control form-control-sm p-razon" value="${razonSocial}" placeholder="Razón Social"></td>
                        <td><input type="text" class="form-control form-control-sm p-nombre" value="${nombreProyecto}" placeholder="Nombre Proyecto/Obra"></td>
                        <td><textarea class="form-control form-control-sm p-contacto" rows="1" placeholder="Contacto">${contacto}</textarea></td>
                        <td><textarea class="form-control form-control-sm p-correo" rows="1" placeholder="Correo">${correo}</textarea></td>
                        <td><textarea class="form-control form-control-sm p-telefono" rows="1" placeholder="Teléfono">${telefono}</textarea></td>
                        <td class="text-center">
                            <button type="button" class="btn btn-link btn-sm text-danger btn-remove-project" onclick="eliminarFilaProyecto('${idRow}')">
                                <i class="bi bi-trash fs-5"></i>
                            </button>
                        </td>
                    </tr>
                `;
                tbody.append(rowHtml);
                actualizarVisibilidadMensajeProyectos();
            };

            window.eliminarFilaProyecto = function(idRow) {
                $(`#${idRow}`).remove();
                actualizarVisibilidadMensajeProyectos();
            };

            function actualizarVisibilidadMensajeProyectos() {
                const count = $("#tbodyModalProyectos tr").length;
                if (count === 0) {
                    $("#sinProyectosMensaje").show();
                    $("#tablaModalProyectos").hide();
                } else {
                    $("#sinProyectosMensaje").hide();
                    $("#tablaModalProyectos").show();
                }
            }

            window.guardarGEI = function() {
                const nombre = $("#inputNombre").val().trim();
                if (!nombre) {
                    Swal.fire('Atención', 'El nombre del grupo económico es obligatorio.', 'warning');
                    return;
                }

                const idGEI = $("#inputGrupoInteresId").val();
                
                const proyectos = [];
                $("#tbodyModalProyectos tr").each(function() {
                    const row = $(this);
                    const rz = row.find(".p-razon").val().trim();
                    const np = row.find(".p-nombre").val().trim();
                    
                    if (rz || np) {
                        proyectos.push({
                            ProyectoId: row.find(".p-id").val() ? parseInt(row.find(".p-id").val()) : null,
                            RazonSocial: rz,
                            NombreProyecto: np,
                            Contacto: row.find(".p-contacto").val().trim(),
                            Correo: row.find(".p-correo").val().trim(),
                            Telefono: row.find(".p-telefono").val().trim()
                        });
                    }
                });

                const formData = {
                    GrupoInteresId: idGEI ? parseInt(idGEI) : null,
                    Nombre: nombre,
                    Origen: $("#inputOrigen").val().trim(),
                    Contacto: $("#inputContacto").val().trim(),
                    Correo: $("#inputCorreo").val().trim(),
                    Telefono: $("#inputTelefono").val().trim(),
                    Proyectos: proyectos
                };

                Swal.fire({
                    title: 'Guardando...',
                    allowOutsideClick: false,
                    didOpen: () => { Swal.showLoading(); }
                });

                $.ajax({
                    url: '/GruposInteres/Api/Guardar',
                    type: 'POST',
                    contentType: 'application/json',
                    data: JSON.stringify(formData),
                    headers: {
                        "RequestVerificationToken": $('input[name="__RequestVerificationToken"]').val()
                    },
                    success: function(res) {
                        Swal.close();
                        $("#modalGEI").modal('hide');
                        Swal.fire('Guardado', res.mensaje, 'success');
                        cargarTablero();
                    },
                    error: function(err) {
                        Swal.close();
                        const errMsg = err.responseJSON && err.responseJSON.error ? err.responseJSON.error : 'Ocurrió un error inesperado al guardar.';
                        Swal.fire('Error', errMsg, 'error');
                    }
                });
            };

            window.eliminarGrupo = function(id, nombre) {
                Swal.fire({
                    title: '¿Está seguro?',
                    text: `Se eliminará de forma lógica el grupo económico "${nombre}" y todos sus proyectos vinculados.`,
                    icon: 'warning',
                    showCancelButton: true,
                    confirmButtonColor: '#9B2247',
                    cancelButtonColor: '#6c757d',
                    confirmButtonText: 'Sí, eliminar',
                    cancelButtonText: 'Cancelar'
                }).then((result) => {
                    if (result.isConfirmed) {
                        Swal.fire({
                            title: 'Eliminando...',
                            allowOutsideClick: false,
                            didOpen: () => { Swal.showLoading(); }
                        });

                        $.ajax({
                            url: `/GruposInteres/Api/Eliminar/${id}`,
                            type: 'DELETE',
                            headers: {
                                "RequestVerificationToken": $('input[name="__RequestVerificationToken"]').val()
                            },
                            success: function(res) {
                                Swal.close();
                                Swal.fire('Eliminado', res.mensaje, 'success');
                                cargarTablero();
                            },
                            error: function() {
                                Swal.close();
                                Swal.fire('Error', 'No se pudo eliminar el registro.', 'error');
                            }
                        });
                    }
                });
            };

            window.abrirEnvioRegistro = function(id) {
                const optionsHtml = usuariosCorreo.map(u => {
                    const label = `${escapeHtml(u.nombre || u.correo)}${u.nombre ? ' - ' + escapeHtml(u.correo) : ''}`;
                    return `
                        <label class="d-flex align-items-start gap-2 py-1 text-start">
                            <input type="checkbox" class="form-check-input mt-1 js-user-mail" value="${escapeAttr(u.correo)}">
                            <span>${label}</span>
                        </label>
                    `;
                }).join('');

                Swal.fire({
                    title: 'Enviar registro por correo',
                    html: `
                        <div class="text-start">
                            <label class="form-label fw-bold">Usuarios del sistema</label>
                            <div style="max-height: 220px; overflow:auto; border:1px solid #dee2e6; border-radius:8px; padding:10px; margin-bottom:12px;">
                                ${optionsHtml || '<div class="text-muted small">No se pudieron cargar usuarios con correo.</div>'}
                            </div>
                            <label class="form-label fw-bold">Correos adicionales</label>
                            <textarea id="correosAdicionales" class="form-control" rows="3" placeholder="correo@energia.gob.mx, otro@energia.gob.mx"></textarea>
                            <div class="form-text">Separar por coma, punto y coma o salto de línea.</div>
                        </div>
                    `,
                    width: 650,
                    showCancelButton: true,
                    confirmButtonColor: '#9B2247',
                    cancelButtonColor: '#6c757d',
                    confirmButtonText: 'Enviar',
                    cancelButtonText: 'Cancelar',
                    preConfirm: () => {
                        const seleccionados = $('.js-user-mail:checked').map(function() { return this.value; }).get();
                        const adicionales = ($('#correosAdicionales').val() || '').split(/[;,\n\r]+/).map(x => x.trim()).filter(Boolean);
                        const destinatarios = [...new Set([...seleccionados, ...adicionales].map(x => x.toLowerCase()))];
                        if (!destinatarios.length) {
                            Swal.showValidationMessage('Seleccione o escriba al menos un correo.');
                            return false;
                        }
                        return destinatarios;
                    }
                }).then((result) => {
                    if (!result.isConfirmed) return;

                    Swal.fire({
                        title: 'Enviando registro...',
                        allowOutsideClick: false,
                        didOpen: () => { Swal.showLoading(); }
                    });

                    $.ajax({
                        url: `/GruposInteres/Api/EnviarRegistro/${id}`,
                        type: 'POST',
                        contentType: 'application/json',
                        data: JSON.stringify({ Destinatarios: result.value }),
                        headers: {
                            "RequestVerificationToken": $('input[name="__RequestVerificationToken"]').val()
                        },
                        success: function(res) {
                            Swal.close();
                            Swal.fire('Enviado', res.mensaje, 'success');
                        },
                        error: function(err) {
                            Swal.close();
                            const errMsg = err.responseJSON && err.responseJSON.error ? err.responseJSON.error : 'No fue posible enviar el registro.';
                            Swal.fire('Error de Envío', errMsg, 'error');
                        }
                    });
                });
            };

            // ── GENERACIÓN Y FILTRADO DEL DECK DE DIAPOSITIVAS (REPORTE) ──────────────
            function escapeHtml(str) {
                if (!str) return '';
                return str.toString()
                    .replace(/&/g, '&amp;')
                    .replace(/</g, '&lt;')
                    .replace(/>/g, '&gt;')
                    .replace(/"/g, '&quot;')
                    .replace(/'/g, '&#039;');
            }

            function escapeAttr(str) {
                return escapeHtml(str).replace(/`/g, '&#096;');
            }

            function filterReportData() {
                const q = ($('#rep-filtro-busqueda').val() || '').trim().toLowerCase();
                const origen = $('#rep-filtro-origen').val() || '';
                const carga = $('#rep-filtro-proyectos').val() || '';

                return gruposDeInteresGlobal.filter(g => {
                    if (origen && g.origen !== origen) return false;
                    
                    if (carga === 'con' && g.totalProyectos === 0) return false;
                    if (carga === 'sin' && g.totalProyectos > 0) return false;

                    if (q) {
                        const searchStr = `${g.nombre} ${g.origen || ''} ${g.contacto || ''} ${g.correo || ''}`.toLowerCase();
                        if (!searchStr.includes(q)) return false;
                    }
                    return true;
                });
            }

