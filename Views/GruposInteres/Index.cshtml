@using Newtonsoft.Json
@{
    ViewData["Title"] = "Grupos de Interés";
}

@await Html.PartialAsync("_ViewHeader", ViewData["HeaderViewModel"] as NSIE.Models.HeaderViewModel)

<!-- Estilos personalizados para estética premium y z-index modal -->
@section Styles {
    <link rel="stylesheet" href="~/gestor/css/gestor.css" asp-append-version="true" />
    <style>
        :root {
            --color-guinda: #9B2247;
            --color-verde: #1E5B4F;
            --color-dorado: #A57F2C;
            --color-gris-claro: #F8F9FA;
            --color-guinda-light: rgba(155, 34, 71, 0.05);
            --color-verde-light: rgba(30, 91, 79, 0.05);
            --color-dorado-light: rgba(165, 127, 44, 0.05);
            --border-radius: 12px;
            --shadow-premium: 0 8px 30px rgba(0, 0, 0, 0.05);
            --transition-smooth: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
        }

        /* Forzar z-index para que el modal y SweetAlert2 queden siempre arriba de la navegación y el backdrop */
        .modal {
            z-index: 12000 !important;
        }
        .modal-backdrop {
            z-index: 11990 !important;
        }
        .swal2-container {
            z-index: 12100 !important;
        }

        #modalGEI .modal-dialog {
            margin-top: 5.5rem;
        }

        #modalGEI.readonly-mode .modal-footer .btn-save-gei,
        #modalGEI.readonly-mode .btn-add-project,
        #modalGEI.readonly-mode .btn-remove-project {
            display: none !important;
        }

        #modalGEI.readonly-mode input,
        #modalGEI.readonly-mode textarea {
            background: #f8f9fa;
            pointer-events: none;
        }

        /* Tabs estilizados */
        .custom-nav-tabs {
            border-bottom: 2px solid #e0e0e0;
            margin-bottom: 2rem;
            gap: 0.5rem;
        }

        .custom-nav-tabs .nav-link {
            border: none;
            color: #666;
            font-weight: 600;
            padding: 0.8rem 1.5rem;
            border-radius: 8px 8px 0 0;
            position: relative;
            transition: var(--transition-smooth);
            background: transparent;
        }

        .custom-nav-tabs .nav-link:hover {
            color: var(--color-guinda);
            background: var(--color-guinda-light);
        }

        .custom-nav-tabs .nav-link.active {
            color: var(--color-guinda);
            background: transparent;
        }

        .custom-nav-tabs .nav-link.active::after {
            content: '';
            position: absolute;
            bottom: -2px;
            left: 0;
            right: 0;
            height: 3px;
            background-color: var(--color-guinda);
            border-radius: 3px 3px 0 0;
        }

        /* Tabla y paneles */
        .glass-panel {
            background: #ffffff;
            border-radius: var(--border-radius);
            padding: 2rem;
            box-shadow: var(--shadow-premium);
            border: 1px solid rgba(0, 0, 0, 0.03);
            margin-bottom: 2rem;
        }

        .btn-premium {
            padding: 0.6rem 1.4rem;
            border-radius: 8px;
            font-weight: 600;
            transition: var(--transition-smooth);
            display: inline-flex;
            align-items: center;
            gap: 0.5rem;
            font-size: 0.95rem;
        }

        .btn-premium-guinda {
            background-color: var(--color-guinda);
            color: #ffffff;
            border: 1px solid var(--color-guinda);
        }

        .btn-premium-guinda:hover {
            background-color: #821c3b;
            color: #ffffff;
        }

        .btn-premium-verde {
            background-color: var(--color-verde);
            color: #ffffff;
            border: 1px solid var(--color-verde);
        }

        .btn-premium-verde:hover {
            background-color: #17483e;
            color: #ffffff;
        }

        .btn-premium-outline {
            background-color: transparent;
            color: var(--color-guinda);
            border: 1.5px solid var(--color-guinda);
        }

        .btn-premium-outline:hover {
            background-color: var(--color-guinda-light);
            color: var(--color-guinda);
        }

        #tablaGEIs thead th {
            background: var(--color-guinda) !important;
            color: #ffffff !important;
            border-color: #861b3c !important;
            font-size: 0.78rem;
            letter-spacing: 0.02em;
        }

        #tablaModalProyectos thead th {
            background: #f7f8fa !important;
            color: #334155 !important;
            border-color: #d8dee6 !important;
            font-size: 0.78rem;
            letter-spacing: 0.02em;
        }

        #tablaGEIs.table-hover tbody tr:hover,
        #tablaModalProyectos.table-hover tbody tr:hover {
            background-color: #faf6f7;
            transform: none !important;
        }

        #tablaGEIs .btn-group .btn,
        #tablaModalProyectos .btn {
            transition: background-color 0.15s ease, border-color 0.15s ease, color 0.15s ease;
        }

        #tablaGEIs .btn-group .btn:hover,
        #tablaModalProyectos .btn:hover {
            transform: none !important;
        }

        .dataTables_paginate .pagination {
            gap: 0.35rem;
        }

        .dataTables_paginate .page-link {
            min-width: 40px;
            border: 1px solid #ead2db;
            border-radius: 8px !important;
            color: var(--color-guinda);
            box-shadow: none !important;
            text-align: center;
            margin: 0 !important;
        }

        .dataTables_paginate .page-item.active .page-link {
            background: var(--color-guinda);
            border-color: var(--color-guinda);
            color: #ffffff;
        }

        .dataTables_paginate .page-item.disabled .page-link {
            background: #f4f6f8;
            border-color: #dbe1e8;
            color: #94a3b8;
        }

        #modalGEI .modal-content {
            border: 1px solid #efe6de;
            border-top: 4px solid var(--color-guinda);
            border-radius: 18px;
            box-shadow: 0 26px 60px rgba(77, 31, 47, 0.12);
            overflow: hidden;
        }

        #modalGEI .modal-header {
            background: #ffffff !important;
            border-bottom: 1px solid #efe6de;
            color: #172333;
            padding: 1.05rem 1.35rem;
        }

        #modalGEI .modal-title {
            color: #172333;
            font-weight: 700;
        }

        #modalGEI .modal-title i {
            color: var(--color-guinda) !important;
        }

        #modalGEI .modal-body {
            background: #ffffff !important;
            padding: 1.1rem;
        }

        #modalGEI .modal-footer {
            background: #ffffff;
            border-top: 1px solid #d8dee6;
            box-shadow: none;
            padding: 1rem;
        }

        #modalGEI .modal-section {
            background: #ffffff;
            border: 1px solid #efe6de;
            border-radius: 14px;
            margin-bottom: 1.25rem;
            overflow: hidden;
            box-shadow: none;
        }

        #modalGEI .modal-section__header {
            background: #ffffff;
            color: #172333;
            display: flex;
            justify-content: space-between;
            align-items: center;
            gap: 1rem;
            padding: 0.85rem 1.1rem;
            font-weight: 700;
            border-bottom: 1px solid #efe6de;
        }

        #modalGEI .modal-section__header i {
            color: var(--color-guinda);
        }

        #modalGEI .modal-section__title {
            margin-left: auto;
            text-align: right;
        }

        #modalGEI .modal-section__body {
            padding: 1.25rem;
        }

        #modalGEI .form-control,
        #modalGEI .form-select {
            border: 1px solid #d8d2cb;
            border-radius: 12px;
            box-shadow: none;
            color: #172333;
            background: #ffffff;
        }

        #modalGEI .form-control:focus,
        #modalGEI .form-select:focus {
            border-color: rgba(138, 0, 49, 0.35);
            box-shadow: 0 0 0 4px rgba(138, 0, 49, 0.08);
        }

        #modalGEI .form-control:hover,
        #modalGEI .form-select:hover {
            transform: none !important;
        }

        .modal-xl-custom {
            max-width: 90%;
        }

        /* Estilos específicos de tablas de diapositiva */
        .slide-table th {
            background-color: #9B2247 !important;
            color: #ffffff !important;
            text-transform: uppercase;
            font-size: 0.78rem;
            font-weight: 800;
            letter-spacing: 0.04em;
            padding: 10px;
        }
        .slide-table td {
            padding: 10px;
            border-bottom: 1px solid #edf0f3;
            color: #243444;
        }

        /* Forzar aspect-ratio 16:9 en cada diapositiva cuando se muestra en el deck */
        #internal-report-deck .internal-slide {
            width: min(100%, 1280px);
            min-height: unset;
            aspect-ratio: 16 / 9;
        }

        #internal-report-deck .internal-slide--cover .internal-cover-body {
            padding-top: 1.15rem !important;
            padding-bottom: 2.25rem !important;
        }

        #internal-report-deck .internal-slide--cover .internal-cover-body .unit {
            margin-top: 0.55rem;
            margin-bottom: 1rem;
            line-height: 1.15;
        }
    </style>
}

<div class="shell-page-container py-3">
    <!-- Pestañas -->
    <ul class="nav custom-nav-tabs" id="gruposTabs" role="tablist">
        <li class="nav-item" role="presentation">
            <button class="nav-link active" id="tablero-tab" data-bs-toggle="tab" data-bs-target="#tablero-pane" type="button" role="tab" aria-controls="tablero-pane" aria-selected="true">
                <i class="bi bi-table me-2"></i>Tablero de Gestión
            </button>
        </li>
        <li class="nav-item" role="presentation">
            <button class="nav-link" id="reporte-tab" data-bs-toggle="tab" data-bs-target="#reporte-pane" type="button" role="tab" aria-controls="reporte-pane" aria-selected="false">
                <i class="bi bi-bar-chart-line-fill me-2"></i>Reporte
            </button>
        </li>
    </ul>

    <!-- Contenido de Pestañas -->
    <div class="tab-content" id="gruposTabsContent">
        
        <!-- Pestaña 1: Tablero de Gestión (CRUD) -->
        <div class="tab-pane fade show active" id="tablero-pane" role="tabpanel" aria-labelledby="tablero-tab" tabindex="0">
            <div class="glass-panel">
                <div class="d-flex flex-wrap justify-content-between align-items-center mb-4 gap-3">
                    <h3 class="mb-0 text-guinda font-headings"><i class="bi bi-folder-check me-2"></i>Grupos Económicos de Interés Registrados</h3>
                    <div class="d-flex flex-wrap gap-2">
                        <button type="button" class="btn btn-premium btn-premium-guinda" onclick="abrirModalCrear()">
                            <i class="bi bi-plus-circle-fill"></i> Nuevo Grupo Económico
                        </button>
                        <a href="@Url.Action("ExportarExcel", "GruposInteres")" class="btn btn-premium btn-premium-verde">
                            <i class="bi bi-file-earmark-excel-fill"></i> Exportar a Excel
                        </a>
                    </div>
                </div>

                <!-- Filtros del DataTable -->
                <div class="row g-3 mb-4 p-3 bg-light rounded border">
                    <div class="col-md-6 col-lg-4">
                        <label class="form-label font-weight-bold">Filtrar por Origen / País:</label>
                        <select id="filtroOrigen" class="form-select">
                            <option value="">Todos los países</option>
                        </select>
                    </div>
                    <div class="col-md-6 col-lg-4">
                        <label class="form-label font-weight-bold">Filtrar por Carga de Proyectos:</label>
                        <select id="filtroProyectos" class="form-select">
                            <option value="">Todos</option>
                            <option value="con">Con proyectos registrados</option>
                            <option value="sin">Sin proyectos registrados</option>
                        </select>
                    </div>
                </div>

                <!-- Tabla Principal -->
                <div class="table-responsive">
                    <table id="tablaGEIs" class="table table-striped table-hover align-middle w-100" style="font-family: 'Noto Sans', sans-serif;">
                        <thead class="table-dark">
                            <tr>
                                <th style="width: 5%">ID</th>
                                <th style="width: 35%">Grupo Económico / Desarrollador</th>
                                <th style="width: 15%">País de Origen</th>
                                <th style="width: 20%">Contacto Principal</th>
                                <th style="width: 10%" class="text-center">Proyectos</th>
                                <th style="width: 15%" class="text-center">Acciones</th>
                            </tr>
                        </thead>
                        <tbody>
                            <!-- Se llena por AJAX -->
                        </tbody>
                    </table>
                </div>
            </div>
        </div>

        <!-- Pestaña 2: Reporte (Dashboard Homologado con Diapositivas) -->
        <div class="tab-pane fade" id="reporte-pane" role="tabpanel" aria-labelledby="reporte-tab" tabindex="0">
            <!-- Filtros de Reporte -->
            <div class="border rounded-3 bg-white p-4 shadow-sm mb-4">
                <div class="d-flex flex-wrap justify-content-between align-items-center gap-3 mb-3">
                    <div>
                        <h4 class="mb-1">Reporte de Grupos de Interés</h4>
                        <p class="text-muted mb-0">Visualiza la vista previa estilo presentación, descarga en formato PDF o envía por correo.</p>
                    </div>
                    <div class="d-flex flex-wrap gap-2">
                        <button type="button" class="btn btn-outline-secondary" id="rep-refresh"><i class="bi bi-arrow-clockwise me-1"></i>Actualizar</button>
                        <button type="button" class="btn btn-outline-primary" id="rep-presentar"><i class="bi bi-play-fill me-1"></i>Presentar</button>
                        <button type="button" class="btn btn-outline-danger" id="rep-pdf"><i class="bi bi-file-pdf me-1"></i>PDF</button>
                        <button type="button" class="btn btn-premium btn-premium-outline" id="rep-correo"><i class="bi bi-envelope-at-fill me-1"></i>Enviar por Correo</button>
                    </div>
                </div>
                
                <div class="row g-3">
                    <div class="col-12 col-md-4">
                        <label class="form-label small fw-bold text-muted">Búsqueda rápida</label>
                        <input type="search" id="rep-filtro-busqueda" class="form-control" placeholder="Buscar por desarrollador, contacto..." />
                    </div>
                    <div class="col-12 col-md-4">
                        <label class="form-label small fw-bold text-muted">País de origen</label>
                        <select id="rep-filtro-origen" class="form-select">
                            <option value="">Todos los países</option>
                        </select>
                    </div>
                    <div class="col-12 col-md-4">
                        <label class="form-label small fw-bold text-muted">Carga de proyectos</label>
                        <select id="rep-filtro-proyectos" class="form-select">
                            <option value="">Todos</option>
                            <option value="con">Con proyectos registrados</option>
                            <option value="sin">Sin proyectos registrados</option>
                        </select>
                    </div>
                </div>
            </div>
            
            <div class="border rounded-3 bg-white p-4 shadow-sm">
                <div class="d-flex justify-content-between align-items-center mb-3">
                    <h5 class="mb-0 fw-bold">Vista previa del reporte</h5>
                    <span id="rep-summary" class="text-muted small">—</span>
                </div>
                
                <!-- Deck of slides wrapper -->
                <div id="internal-report-deck" class="internal-report-deck" style="background: #e9ecef; padding: 2rem; border-radius: 12px; display: flex; flex-direction: column; gap: 2rem; align-items: center;">
                    <!-- Slides will be rendered dynamically here -->
                </div>
            </div>
        </div>
    </div>
</div>

<!-- MODAL CRUD (CREAR / EDITAR GRUPO DE INTERÉS) -->
<div class="modal fade" id="modalGEI" tabindex="-1" aria-labelledby="modalGEITitle" aria-hidden="true" data-bs-backdrop="static">
    <div class="modal-dialog modal-xl modal-dialog-scrollable">
        <div class="modal-content">
            <div class="modal-header text-white">
                <h5 class="modal-title" id="modalGEITitle"><i class="bi bi-folder2-open me-2"></i>Detalle de Grupo de Interés</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body bg-light">
                <form id="formGEI">
                    @Html.AntiForgeryToken()
                    <input type="hidden" id="inputGrupoInteresId" name="GrupoInteresId" />

                    <!-- Datos del Grupo -->
                    <div class="modal-section">
                        <div class="modal-section__header">
                            <i class="bi bi-info-circle-fill"></i>
                            <span class="modal-section__title">Datos Generales del Grupo Económico</span>
                        </div>
                        <div class="modal-section__body">
                            <div class="row g-3">
                                <div class="col-md-8">
                                    <label for="inputNombre" class="form-label font-weight-bold">Nombre del Grupo / Desarrollador *</label>
                                    <input type="text" class="form-control" id="inputNombre" required maxlength="250">
                                </div>
                                <div class="col-md-4">
                                    <label for="inputOrigen" class="form-label font-weight-bold">País de Origen</label>
                                    <input type="text" class="form-control" id="inputOrigen" placeholder="Ej. España, México" maxlength="150">
                                </div>
                                <div class="col-md-4">
                                    <label for="inputContacto" class="form-label font-weight-bold">Contacto Principal</label>
                                    <input type="text" class="form-control" id="inputContacto">
                                </div>
                                <div class="col-md-4">
                                    <label for="inputCorreo" class="form-label font-weight-bold">Correo Electrónico</label>
                                    <input type="email" class="form-control" id="inputCorreo" placeholder="correo@ejemplo.com">
                                </div>
                                <div class="col-md-4">
                                    <label for="inputTelefono" class="form-label font-weight-bold">Teléfono de Contacto</label>
                                    <input type="text" class="form-control" id="inputTelefono">
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- Proyectos Hijos -->
                    <div class="modal-section">
                        <div class="modal-section__header">
                            <span><i class="bi bi-diagram-3-fill me-2"></i>Proyectos y Empresas del Grupo</span>
                            <button type="button" class="btn btn-sm btn-light font-weight-bold btn-add-project" onclick="agregarFilaProyecto()">
                                <i class="bi bi-plus-circle text-success"></i> Agregar Proyecto/Empresa
                            </button>
                        </div>
                        <div class="modal-section__body p-0">
                            <div class="table-responsive">
                                <table class="table table-hover table-bordered align-middle mb-0" id="tablaModalProyectos">
                                    <thead>
                                        <tr>
                                            <th style="width: 25%">Razón Social</th>
                                            <th style="width: 25%">Nombre Proyecto</th>
                                            <th style="width: 20%">Contacto</th>
                                            <th style="width: 15%">Correo</th>
                                            <th style="width: 10%">Teléfono</th>
                                            <th style="width: 5%" class="text-center">Eliminar</th>
                                        </tr>
                                    </thead>
                                    <tbody id="tbodyModalProyectos">
                                        <!-- Filas dinámicas -->
                                    </tbody>
                                </table>
                            </div>
                            <div id="sinProyectosMensaje" class="text-center py-4 text-muted">
                                <i class="bi bi-info-circle fs-3 d-block mb-2"></i> No hay proyectos o razones sociales asociadas a este grupo económico.
                            </div>
                        </div>
                    </div>
                </form>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancelar</button>
                <button type="button" class="btn btn-premium btn-premium-guinda btn-save-gei" onclick="guardarGEI()">
                    <i class="bi bi-save-fill"></i> Guardar Cambios
                </button>
            </div>
        </div>
    </div>
</div>

<!-- CONTROLES FLOTANTES MODO PRESENTACIÓN -->
<div id="presentationControls" class="presentation-controls" style="display: none;">
    <button id="btnPrevSlide" type="button" aria-label="Lámina anterior">◀ Anterior</button>
    <span id="presentationCounter" class="counter">1/1</span>
    <button id="btnNextSlide" type="button" aria-label="Siguiente lámina">Siguiente ▶</button>
    <button id="btnExitPresentation" type="button" aria-label="Salir de presentación">Salir</button>
</div>

<!-- SCRIPTS DE COMPORTAMIENTO -->
@section Scripts {
    <script src="https://cdn.datatables.net/1.13.4/js/dataTables.bootstrap5.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <script src="https://cdn.jsdelivr.net/npm/html2canvas@1.4.1/dist/html2canvas.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/jspdf@2.5.1/dist/jspdf.umd.min.js"></script>

    <script>
        (() => {
            let tabla = null;
            let gruposDeInteresGlobal = [];
            let presentationMode = false;
            let presentationIndex = 0;
            let presentationSlides = [];
            let usuariosCorreo = [];

            $(document).ready(function () {
                cargarTablero();
                cargarUsuariosCorreo();

                // Resolver bug de superposición moviendo el modal al body
                $('#modalGEI').appendTo('body');

                // Escuchador de pestañas
                $('#reporte-tab').on('shown.bs.tab', function () {
                    renderReportDeck();
                });

                // Escuchadores de eventos para filtros en pestaña de reporte
                $('#rep-filtro-origen, #rep-filtro-proyectos').on('change', renderReportDeck);
                $('#rep-filtro-busqueda').on('input', renderReportDeck);
                $('#rep-refresh').on('click', renderReportDeck);

                // Botones de acción del reporte
                $('#rep-presentar').on('click', () => enterPresentation(0));
                $('#rep-pdf').on('click', descargarPdf);
                $('#rep-correo').on('click', abrirModalCorreo);

                // Controles flotantes de presentación
                $('#btnPrevSlide').on('click', prevPresentationSlide);
                $('#btnNextSlide').on('click', nextPresentationSlide);
                $('#btnExitPresentation').on('click', exitPresentation);

                // Eventos de teclado para Modo Presentación
                $(document).on('keydown', function (e) {
                    if (!presentationMode) return;
                    if (['ArrowRight', 'PageDown', ' '].includes(e.key)) {
                        e.preventDefault();
                        nextPresentationSlide();
                    } else if (['ArrowLeft', 'PageUp', 'Backspace'].includes(e.key)) {
                        e.preventDefault();
                        prevPresentationSlide();
                    } else if (e.key === 'Escape') {
                        e.preventDefault();
                        exitPresentation();
                    }
                });

                // Control de redimensionamiento para auto-escalado
                $(window).on('resize', fitActiveSlide);

                // Detectar salida nativa de fullscreen
                $(document).on('fullscreenchange webkitfullscreenchange mozfullscreenchange MSFullscreenChange', function () {
                    if (presentationMode && !document.fullscreenElement && !document.webkitIsFullScreen) {
                        exitPresentation();
                    }
                });
            });

            // ── GESTIÓN DE DATOS Y TABLERO (CRUD) ──────────────────────────────────
            function cargarTablero() {
                $.get('/GruposInteres/Api/ObtenerTodos', function (data) {
                    gruposDeInteresGlobal = data;

                    // Inicializar o recargar DataTable
                    if (tabla) {
                        tabla.clear().rows.add(gruposDeInteresGlobal).draw();
                    } else {
                        inicializarDataTable(gruposDeInteresGlobal);
                    }

                    // Rellenar selectores de origen (Países)
                    const paises = new Set();
                    gruposDeInteresGlobal.forEach(item => {
                        if (item.origen && item.origen.trim()) {
                            paises.add(item.origen.trim());
                        }
                    });

                    const selectTablero = $('#filtroOrigen');
                    const selectReporte = $('#rep-filtro-origen');

                    selectTablero.empty().append('<option value="">Todos los países</option>');
