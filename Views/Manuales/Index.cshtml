@using NSIE.Models
@inject IHttpContextAccessor HttpContextAccessor
@using Microsoft.AspNetCore.Http
@using Newtonsoft.Json

@{
    var httpContext = HttpContextAccessor.HttpContext;
    var perfilUsuarioJson = httpContext.Session.GetString("PerfilUsuario");
    var perfilUsuario = JsonConvert.DeserializeObject<PerfilUsuario>(perfilUsuarioJson);

    ViewData["Title"] = "Manuales y Guías Metodológicas";
    ViewData["NombreUsuario"] = perfilUsuario?.Nombre ?? "Invitado";
    ViewData["RolUsuario"] = perfilUsuario?.Rol ?? "Público";
    ViewData["IDUsuario"] = perfilUsuario?.IdUsuario ?? "0";

    var header = new HeaderViewModel
    {
        Title = "Manuales, Guías y Material de Consulta",
        IconPath = "sistema.png",
        Description = "Centro de consulta técnica, metodológica, estadística y normativa de la Dirección General.",
        Section = "Biblioteca Digital",
        ModuleInfo = JsonConvert.SerializeObject(new
        {
            title = "Biblioteca Digital Institucional",
            description = "Un espacio abierto para consultar manuales del sistema, infografías, presentaciones oficiales y el marco normativo aplicable.",
            functionality = "Navega por temas del lado izquierdo y consulta el detalle del material clasificado por tipo de recurso en la derecha.",
            stage = "Consulta",
            roles = new[] {
                new { icon = "book-open", text = "Consulta General: Acceso completo a toda la documentación" },
                new { icon = "download", text = "Formatos y Leyes: Enlaces directos a recursos externos oficiales" }
            },
            order = new { step = 1, description = "Repositorio institucional de conocimientos" },
            manualUrl = "/Documentos/ManualSNIEr.pdf"
        })
    };
}

@section Styles {
    <link rel="stylesheet" href="~/css/home-dashboard.css" asp-append-version="true" />
    <style>
        .manuales-grid {
            display: grid;
            grid-template-columns: 280px 1fr;
            gap: 1.5rem;
        }

        .topic-list {
            display: flex;
            flex-direction: column;
            gap: 0.5rem;
        }

        .topic-item {
            background: #ffffff;
            border: 1px solid rgba(0,0,0,0.06);
            border-radius: 12px;
            padding: 1rem;
            text-align: left;
            transition: all 0.25s cubic-bezier(0.4, 0, 0.2, 1);
            cursor: pointer;
            display: flex;
            align-items: center;
            gap: 0.75rem;
        }

        .topic-item:hover {
            transform: translateY(-2px);
            box-shadow: 0 6px 15px rgba(0,0,0,0.04);
            border-color: rgba(138, 0, 49, 0.15);
        }

        .topic-item.active {
            border-color: #8A0031;
            background: rgba(138, 0, 49, 0.02);
            box-shadow: 0 4px 12px rgba(138, 0, 49, 0.05);
        }

        .topic-item.active .topic-icon {
            color: #8A0031;
            background: rgba(138, 0, 49, 0.08);
        }

        .topic-icon {
            width: 40px;
            height: 40px;
            border-radius: 10px;
            background: #f8f9fa;
            color: #6c757d;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 1.15rem;
            transition: all 0.2s;
        }

        .topic-info h4 {
            font-size: 0.95rem;
            font-weight: 700;
            margin: 0 0 0.15rem 0;
            color: #333;
        }

        .topic-info p {
            font-size: 0.78rem;
            margin: 0;
            color: #777;
        }

        .detail-panel {
            background: #ffffff;
            border: 1px solid rgba(0,0,0,0.06);
            border-radius: 20px;
            padding: 1.5rem;
            box-shadow: 0 4px 20px rgba(0,0,0,0.02);
            min-height: 500px;
        }

        .resource-tabs {
            border-bottom: 2px solid #f1f3f5;
            margin-bottom: 1.5rem;
        }

        .resource-tab {
            border: none;
            background: none;
            padding: 0.75rem 1.25rem;
            font-weight: 600;
            font-size: 0.9rem;
            color: #6c757d;
            position: relative;
            transition: color 0.2s;
            cursor: pointer;
        }

        .resource-tab:hover {
            color: #8A0031;
        }

        .resource-tab.active {
            color: #8A0031;
        }

        .resource-tab.active::after {
            content: '';
            position: absolute;
            bottom: -2px;
            left: 0;
            right: 0;
            height: 2px;
            background: #8A0031;
            border-radius: 2px;
        }

        .resource-card {
            border: 1px solid rgba(0,0,0,0.06);
            border-radius: 12px;
            padding: 1.2rem;
            background: #ffffff;
            transition: all 0.2s;
            display: flex;
            align-items: center;
            justify-content: space-between;
            margin-bottom: 0.75rem;
        }

        .resource-card:hover {
            border-color: rgba(138, 0, 49, 0.15);
            transform: translateY(-1px);
            box-shadow: 0 4px 10px rgba(0,0,0,0.02);
        }

        .resource-meta {
            display: flex;
            align-items: center;
            gap: 1rem;
        }

        .resource-type-icon {
            width: 44px;
            height: 44px;
            border-radius: 8px;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 1.25rem;
        }

        .resource-details h5 {
            font-size: 0.95rem;
            font-weight: 700;
            margin: 0 0 0.2rem 0;
            color: #333;
        }

        .resource-details p {
            font-size: 0.8rem;
            margin: 0;
            color: #777;
        }

        .resource-btn {
            border-radius: 8px;
            font-weight: 600;
            font-size: 0.8rem;
            padding: 0.4rem 0.8rem;
            display: inline-flex;
            align-items: center;
            gap: 0.4rem;
            text-decoration: none;
            transition: all 0.2s;
        }

        @@media (max-width: 991px) {
            .manuales-grid {
                grid-template-columns: 1fr;
            }
        }
    </style>
}

<div class="home-dashboard-page">
    <div class="home-dashboard-page__view-header">
        @await Html.PartialAsync("_ViewHeader", header)
    </div>

    <div class="container mb-5">
        <div class="manuales-grid">
            <!-- Columna Izquierda: Temas -->
            <aside class="topic-list" aria-label="Lista de Temas">
                <button type="button" class="topic-item active" onclick="switchTopic(0)">
                    <span class="topic-icon"><i class="bi bi-shield-check"></i></span>
                    <div class="topic-info">
                        <h4>Transparencia</h4>
                        <p>Leyes, solicitudes e informes</p>
                    </div>
                </button>
                <button type="button" class="topic-item" onclick="switchTopic(1)">
                    <span class="topic-icon"><i class="bi bi-file-earmark-bar-graph"></i></span>
                    <div class="topic-info">
                        <h4>Metodologías y Estadísticas</h4>
                        <p>Normas técnicas y balances</p>
                    </div>
                </button>
                <button type="button" class="topic-item" onclick="switchTopic(2)">
                    <span class="topic-icon"><i class="bi bi-laptop"></i></span>
                    <div class="topic-info">
                        <h4>Manuales del Sistema</h4>
                        <p>Guías de uso del SNIEr</p>
                    </div>
                </button>
            </aside>

            <!-- Columna Derecha: Detalle -->
            <main class="detail-panel">
                <div id="topic-title-wrap" class="mb-4">
                    <h2 id="topic-title" style="font-size: 1.5rem; font-weight: 800; color: #333; margin-bottom: 0.25rem;">Transparencia</h2>
                    <p id="topic-desc" class="text-muted small mb-0">Recursos institucionales, leyes generales, infografías informativas y formatos de consulta regulatoria.</p>
                </div>

                <!-- Tabs de Recursos -->
                <nav class="resource-tabs d-flex" aria-label="Tipos de recurso">
                    <button type="button" class="resource-tab active" onclick="switchTab('infografias')">Infografías</button>
                    <button type="button" class="resource-tab" onclick="switchTab('presentaciones')">Presentaciones</button>
                    <button type="button" class="resource-tab" onclick="switchTab('regulacion')">Leyes y Regulación</button>
                    <button type="button" class="resource-tab" onclick="switchTab('consulta')">Material de Consulta</button>
                </nav>

                <!-- Contenido de Recursos -->
                <div id="resources-container">
                    <!-- Dinámico -->
                </div>
            </main>
        </div>
    </div>
</div>

@section Scripts {
    <script src="https://cdnjs.cloudflare.com/ajax/libs/animejs/3.2.1/anime.min.js"></script>
    <script>
        // Datos de la biblioteca estructurados
        const libraryData = [
            {
                title: "Transparencia",
                desc: "Recursos institucionales, leyes generales, infografías informativas y formatos de consulta regulatoria.",
                infografias: [
                    { title: "Ciclo de Transparencia del SNIEr", desc: "Infografía del flujo de peticiones de transparencia institucional.", actionText: "Ver Infografía", icon: "bi-image", color: "rgba(138, 0, 49, 0.08)", textCol: "#8A0031", url: "#" },
                    { title: "Obligaciones del Sector Energético", desc: "Mapa conceptual de regulaciones obligatorias.", actionText: "Ver Infografía", icon: "bi-image", color: "rgba(138, 0, 49, 0.08)", textCol: "#8A0031", url: "#" }
                ],
                presentaciones: [
                    { title: "Guía para Solicitudes de Transparencia", desc: "Guía interactiva paso a paso para tramitar y gestionar solicitudes ante la Dirección General.", actionText: "Abrir guía", icon: "bi-file-slides", color: "rgba(138, 0, 49, 0.08)", textCol: "#8A0031", url: "/Presentaciones/Guia%20para%20Solicitudes%20de%20Transparencia.html" },
                    { title: "Inducción a la Transparencia Energética", desc: "Presentación base para capacitaciones internas.", actionText: "Abrir presentación", icon: "bi-presentation-play", color: "rgba(180, 137, 52, 0.08)", textCol: "#b48934", url: "#" }
                ],
                regulacion: [
                    { title: "Ley General de Transparencia", desc: "Documento oficial del Diario Oficial de la Federación.", actionText: "Ir a Ley", icon: "bi-bank", color: "rgba(108, 117, 125, 0.08)", textCol: "#6c757d", url: "https://buscador-leyes.pages.dev" },
                    { title: "Reglamento del Comité de Información", desc: "Disposiciones administrativas internas vigentes.", actionText: "Descargar PDF", icon: "bi-file-earmark-pdf", color: "rgba(138, 0, 49, 0.08)", textCol: "#8A0031", url: "#" }
                ],
                consulta: [
                    { title: "Guía Interactiva de Solicitudes", desc: "Consulta rápida de flujos de solicitudes de transparencia y plazos oficiales.", actionText: "Abrir guía", icon: "bi-journal-bookmark-fill", color: "rgba(138, 0, 49, 0.08)", textCol: "#8A0031", url: "/Presentaciones/Guia%20para%20Solicitudes%20de%20Transparencia.html" },
                    { title: "Formato Único de Solicitud de Información", desc: "Guía interactiva para tramitar peticiones ciudadanas.", actionText: "Descargar Formato", icon: "bi-file-text", color: "rgba(40, 167, 69, 0.08)", textCol: "#28a745", url: "#" }
                ]
            },
            {
                title: "Metodologías y Estadísticas",
                desc: "Normas técnicas para la integración de datos y diagramas de balance energético nacional.",
                infografias: [
                    { title: "Flujo del Balance Energético Nacional (Sankey)", desc: "Representación gráfica de las transiciones energéticas nacionales.", actionText: "Ver Infografía", icon: "bi-image", color: "rgba(138, 0, 49, 0.08)", textCol: "#8A0031", url: "#" }
                ],
                presentaciones: [
                    { title: "Atribuciones Específicas del Área", desc: "Inducción al marco de facultades metodológicas y de publicación.", actionText: "Ver Diapositivas", icon: "bi-presentation-play", color: "rgba(180, 137, 52, 0.08)", textCol: "#b48934", url: "@Url.Action("Index", "Home")" }
                ],
                regulacion: [
                    { title: "Lineamientos de Calidad Estadística", desc: "Normatividad interna aplicable para series oficiales.", actionText: "Ver Documento", icon: "bi-bank", color: "rgba(108, 117, 125, 0.08)", textCol: "#6c757d", url: "#" }
                ],
                consulta: [
                    { title: "Visualización Interactiva Sankey (Balance)", desc: "Acceso al módulo de balance de energía del portal.", actionText: "Ir a visualizador", icon: "bi-lightning-charge", color: "rgba(138, 0, 49, 0.08)", textCol: "#8A0031", url: "@Url.Action("BNE", "SankeySener")" },
                    { title: "Visualización de Flujos Animada", desc: "Acceso directo al Sankey animado interactivo.", actionText: "Ir a Sankey animado", icon: "bi-bezier2", color: "rgba(138, 0, 49, 0.08)", textCol: "#8A0031", url: "@Url.Action("FlujoEnergia", "SankeySener")" }
                ]
            },
            {
                title: "Manuales del Sistema",
                desc: "Guías detalladas e instructivos técnicos para la operación y uso del portal institucional SNIEr.",
                infografias: [
                    { title: "Guía de Inicio Rápido para Operadores", desc: "Paso a paso ilustrado de cómo ingresar información al portal.", actionText: "Ver Guía", icon: "bi-image", color: "rgba(138, 0, 49, 0.08)", textCol: "#8A0031", url: "#" }
                ],
                presentaciones: [
                    { title: "Taller de Inducción para Nuevos Usuarios", desc: "Capacitación práctica para el uso de módulos y perfiles.", actionText: "Ver Taller", icon: "bi-presentation-play", color: "rgba(180, 137, 52, 0.08)", textCol: "#b48934", url: "#" }
                ],
                regulacion: [],
                consulta: [
                    { title: "Manual Oficial del Sistema SNIEr (Completo)", desc: "Manual técnico integral para el manejo y administración de datos.", actionText: "Descargar Manual", icon: "bi-book", color: "rgba(138, 0, 49, 0.08)", textCol: "#8A0031", url: "/Documentos/ManualSNIEr.pdf" }
                ]
            }
        ];

        let currentTopicIndex = 0;
        let currentTab = 'infografias';

        function switchTopic(index) {
            currentTopicIndex = index;
            const topic = libraryData[index];

            // Actualizar botones de temas
            $('.topic-item').removeClass('active');
            $('.topic-item').eq(index).addClass('active');

            // Actualizar títulos
            $('#topic-title').text(topic.title);
            $('#topic-desc').text(topic.desc);

            // Renderizar la pestaña activa
            renderContent();

            // Animación de entrada
            anime({
                targets: '#resources-container .resource-card',
                opacity: [0, 1],
                translateY: [10, 0],
                delay: anime.stagger(50),
                duration: 500,
                easing: 'easeOutQuad'
            });
        }

        function switchTab(tabName) {
            currentTab = tabName;
            $('.resource-tab').removeClass('active');
            $(`button[onclick="switchTab('${tabName}')"]`).addClass('active');

            renderContent();

            // Animación
            anime({
                targets: '#resources-container .resource-card',
                opacity: [0, 1],
                translateY: [10, 0],
                delay: anime.stagger(50),
                duration: 400,
                easing: 'easeOutQuad'
            });
        }

        function renderContent() {
            const topic = libraryData[currentTopicIndex];
            const list = topic[currentTab] || [];
            const container = document.getElementById('resources-container');
            container.innerHTML = '';

            if (list.length === 0) {
                container.innerHTML = `
                    <div class="text-center p-5 text-muted">
                        <i class="bi bi-folder-x" style="font-size: 2.5rem; color: #ccc;"></i>
                        <p class="mt-2 mb-0 small">No hay recursos disponibles en esta categoría para este tema.</p>
                    </div>
                `;
                return;
            }

            list.forEach(item => {
                const card = document.createElement('div');
                card.className = 'resource-card';

                const targetAttr = item.url.startsWith('http') || item.url.endsWith('.pdf') ? 'target="_blank" rel="noopener noreferrer"' : '';

                card.innerHTML = `
                    <div class="resource-meta">
                        <div class="resource-type-icon" style="background-color: ${item.color}; color: ${item.textCol};">
                            <i class="bi ${item.icon}"></i>
                        </div>
                        <div class="resource-details">
                            <h5>${item.title}</h5>
                            <p>${item.desc}</p>
                        </div>
                    </div>
                    <a href="${item.url}" ${targetAttr} class="btn btn-outline-secondary resource-btn" style="border-color: rgba(0,0,0,0.15); color: #555; border-radius: 8px;">
                        ${item.actionText} <i class="bi bi-chevron-right small"></i>
                    </a>
                `;

                container.appendChild(card);
            });
        }

        // Carga inicial
        $(function () {
            renderContent();

            // Animación de entrada inicial con AnimeJS
            anime.set([
                '.topic-item',
                '.detail-panel'
            ], {
                opacity: 0,
                translateY: 15
            });

            anime.timeline({
                easing: 'easeOutExpo',
                duration: 700
            })
            .add({
                targets: '.topic-item',
                opacity: [0, 1],
                translateY: [15, 0],
                delay: anime.stagger(80)
            })
            .add({
                targets: '.detail-panel',
                opacity: [0, 1],
                translateY: [15, 0]
            }, '-=400');
        });
    </script>
}
