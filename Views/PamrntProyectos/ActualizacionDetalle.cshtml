@if (Model.AnalisisActivo)
{
    <script>
        (() => {
            const pollUrl = '@Url.Action("EstadoAnalisis", "PamrntProyectos", new { loteId = Model.Lote.LoteId })';
            const stateElement = document.getElementById('pam-analysis-state');
            const badgeElement = document.getElementById('pam-analysis-badge');
            const countElement = document.getElementById('pam-analysis-count');
            const percentElement = document.getElementById('pam-analysis-percent');
            const messageElement = document.getElementById('pam-analysis-message');
            const progressElement = document.getElementById('pam-analysis-progress');
            const progressBar = progressElement?.querySelector('.progress-bar');
            const read = (value, camel, pascal) => value?.[camel] ?? value?.[pascal];
            const isActive = state => ['pendiente', 'ejecutando', 'procesando'].includes((state || '').toLocaleLowerCase('es-MX'));

            const schedule = () => window.setTimeout(poll, 2500);
            const poll = async () => {
                if (document.hidden) { schedule(); return; }
                try {
                    const response = await fetch(pollUrl, { cache: 'no-store', headers: { 'X-Requested-With': 'XMLHttpRequest' } });
                    if (response.redirected || [401, 403].includes(response.status)) {
                        window.location.assign(response.url || '@Url.Action("SesionExpirada", "Acceso")');
                        return;
                    }
                    if (!response.ok || !(response.headers.get('content-type') || '').includes('application/json')) {
                        throw new Error(`HTTP ${response.status}`);
                    }
                    const data = await response.json();
                    const estado = read(data, 'estado', 'Estado') || 'Pendiente';
                    const total = Number(read(data, 'totalFuentes', 'TotalFuentes') || 0);
                    const procesadas = Number(read(data, 'fuentesProcesadas', 'FuentesProcesadas') || 0);
                    const progreso = Math.min(100, Math.max(0, Number(read(data, 'progresoPorcentaje', 'ProgresoPorcentaje') || 0)));
                    const mensaje = read(data, 'mensaje', 'Mensaje');

                    if (stateElement) stateElement.textContent = estado;
                    if (badgeElement) badgeElement.textContent = estado;
                    if (countElement) countElement.textContent = `${procesadas} de ${total} fuentes`;
                    if (percentElement) percentElement.textContent = `${Math.round(progreso)}%`;
                    if (messageElement && mensaje) messageElement.textContent = mensaje;
                    if (progressElement) progressElement.setAttribute('aria-valuenow', progreso.toString());
                    if (progressBar) progressBar.style.width = `${progreso}%`;

                    if (isActive(estado)) schedule();
                    else window.location.reload();
                } catch {
                    if (messageElement) messageElement.textContent = 'No se pudo actualizar el progreso en este momento. Se intentará nuevamente.';
                    schedule();
                }
            };

            schedule();
        })();
    </script>
}

<script>
    document.querySelectorAll('.pam-analysis-request-form').forEach(form => {
        form.addEventListener('submit', () => {
            const button = form.querySelector('button[type="submit"]');
            if (!button) return;
            button.disabled = true;
            button.innerHTML = '<i class="fas fa-spinner fa-spin me-2"></i>Solicitando análisis…';
        });
    });

    document.querySelectorAll('[data-decision-form]').forEach(form => {
        const options = [...form.querySelectorAll('input[name="Clasificacion"]')];
        const relatedField = form.querySelector('[data-related-field]');
        const relatedSelect = form.querySelector('[data-related-select]');
        const submitButton = form.querySelector('button[type="submit"]');
        const requiresProject = value => ['Vincular existente', 'Padre-hijo'].includes(value || '');
        if (submitButton) submitButton.dataset.originalLabel = submitButton.innerHTML;

        const refreshRelated = () => {
            const selected = options.find(option => option.checked)?.value;
            const required = requiresProject(selected);
            if (relatedField) relatedField.hidden = !required;
            options.forEach(option => option.setAttribute('aria-expanded', String(required)));
            if (relatedSelect) {
                relatedSelect.disabled = !required;
                relatedSelect.required = required;
            }
        };

        options.forEach(option => option.addEventListener('change', refreshRelated));
        refreshRelated();

        form.addEventListener('submit', event => {
            if (form.dataset.submitting === 'true') {
                event.preventDefault();
                return;
            }
            refreshRelated();
            if (!form.checkValidity()) {
                event.preventDefault();
                form.reportValidity();
                return;
            }
            form.dataset.submitting = 'true';
            if (!submitButton) return;
            submitButton.disabled = true;
            submitButton.innerHTML = '<i class="fas fa-spinner fa-spin me-2"></i>Guardando traza…';
        });
    });

    document.querySelectorAll('[data-field-decision-form]').forEach(form => {
        const submitButton = form.querySelector('button[type="submit"]');
        const fieldsets = [...form.querySelectorAll('[data-field-decision]')];
        if (submitButton) submitButton.dataset.originalLabel = submitButton.innerHTML;

        const refreshField = fieldset => {
            const article = fieldset.closest('.pam-field-change');
            const selected = fieldset.querySelector('input[type="radio"]:checked');
            if (!article) return;
            article.classList.toggle('is-pending-decision', !selected);
            article.classList.toggle('is-reviewed-decision', Boolean(selected));
        };

        form.querySelectorAll('[data-bulk-field-decision]').forEach(button => {
            button.addEventListener('click', () => {
                const decision = button.dataset.bulkFieldDecision;
                fieldsets.forEach(fieldset => {
                    const option = [...fieldset.querySelectorAll('input[type="radio"]')]
                        .find(input => input.value === decision);
                    if (option) option.checked = true;
                    refreshField(fieldset);
                });
                fieldsets[0]?.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
            });
        });

        fieldsets.forEach(fieldset => {
            fieldset.addEventListener('change', () => refreshField(fieldset));
            refreshField(fieldset);
        });

        form.addEventListener('submit', event => {
            if (form.dataset.submitting === 'true') {
                event.preventDefault();
                return;
            }
            if (!form.checkValidity()) {
                event.preventDefault();
                form.reportValidity();
                return;
            }
            form.dataset.submitting = 'true';
            if (!submitButton) return;
            submitButton.disabled = true;
            submitButton.innerHTML = '<i class="fas fa-spinner fa-spin me-2"></i>Guardando decisiones…';
        });
    });

    document.querySelectorAll('[data-reopen-form]').forEach(form => {
        form.addEventListener('submit', async event => {
            if (form.dataset.confirmed === 'true') return;
            event.preventDefault();
            let confirmed = false;
            if (typeof Swal !== 'undefined') {
                const result = await Swal.fire({
                    icon: 'question',
                    title: '¿Reabrir esta revisión?',
                    text: 'La decisión anterior se conservará en el historial y la tarjeta volverá a Pendientes para que pueda corregirla.',
                    showCancelButton: true,
                    confirmButtonText: 'Sí, reabrir',
                    cancelButtonText: 'Cancelar',
                    confirmButtonColor: '#9B2247'
                });
                confirmed = result.isConfirmed;
            } else {
                confirmed = window.confirm('La decisión anterior se conservará. ¿Desea reabrir esta revisión?');
            }
            if (!confirmed) return;
            form.dataset.confirmed = 'true';
            form.requestSubmit();
        });
    });

    window.addEventListener('pageshow', () => {
        document.querySelectorAll('[data-decision-form], [data-field-decision-form]').forEach(form => {
            form.dataset.submitting = 'false';
            const button = form.querySelector('button[type="submit"]');
            if (!button) return;
            button.disabled = false;
            if (button.dataset.originalLabel) button.innerHTML = button.dataset.originalLabel;
        });
    });
</script>

@if (!string.IsNullOrWhiteSpace(decisionSuccessMessage) || !string.IsNullOrWhiteSpace(decisionErrorMessage))
{
    var modalExitoso = !string.IsNullOrWhiteSpace(decisionSuccessMessage);
    var modalMensaje = modalExitoso ? decisionSuccessMessage : decisionErrorMessage;
    var modalTitulo = modalExitoso ? "Clasificación guardada" : "No se pudo guardar";
    var modalIcono = modalExitoso ? "success" : "error";
    <script>
        window.addEventListener('load', () => {
            const modal = {
                icon: @Html.Raw(Newtonsoft.Json.JsonConvert.SerializeObject(modalIcono)),
                title: @Html.Raw(Newtonsoft.Json.JsonConvert.SerializeObject(modalTitulo)),
                text: @Html.Raw(Newtonsoft.Json.JsonConvert.SerializeObject(modalMensaje)),
                confirmButtonText: 'Entendido',
                confirmButtonColor: '#9B2247',
                allowOutsideClick: false
            };
            if (typeof Swal !== 'undefined') Swal.fire(modal);
            else window.alert(`${modal.title}\n\n${modal.text}`);
        }, { once: true });
    </script>
}

@if (Model.Filtro.Cambio.HasValue)
{
    <script>
        window.requestAnimationFrame(() => {
            const target = document.getElementById('pam-project-@Model.Filtro.Cambio.Value');
            if (!target) return;
            target.scrollIntoView({ behavior: 'auto', block: 'center' });
            target.querySelector('summary')?.focus({ preventScroll: true });
        });
    </script>
}
