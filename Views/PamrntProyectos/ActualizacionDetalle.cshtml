@model NSIE.Models.PamLoteAnalisisViewModel

@{
    ViewData["Title"] = $"Análisis del lote {Model.Lote.LoteId}";
    var ejecucion = Model.EjecucionActual;
    var progreso = Math.Clamp(ejecucion?.ProgresoPorcentaje ?? 0m, 0m, 100m);
    var decisionSuccessMessage = TempData["PamDecisionSuccess"] as string;
    var decisionErrorMessage = TempData["PamDecisionError"] as string;
    var successMessage = decisionSuccessMessage
        ?? TempData["PamAnalisisSuccess"] as string
        ?? TempData["PamActualizacionSuccess"] as string;
    var errorMessage = decisionErrorMessage ?? TempData["PamAnalisisError"] as string;

    string ClaseEstado(string estado)
    {
        var valor = (estado ?? string.Empty).ToLowerInvariant();
        if (valor.Contains("error") || valor.Contains("rechaz")) return "is-error";
        if (valor.Contains("observ")) return "is-observed";
        if (valor.Contains("complet") || valor.Contains("extraído")) return "is-success";
        if (valor.Contains("convers")) return "is-warning";
        if (valor.Contains("ejecut") || valor.Contains("proces") || valor.Contains("extray")) return "is-running";
        return "is-pending";
    }

    string FormatearTamano(long bytes)
    {
        if (bytes >= 1024L * 1024L * 1024L) return $"{bytes / (1024d * 1024d * 1024d):N1} GB";
        if (bytes >= 1024L * 1024L) return $"{bytes / (1024d * 1024d):N1} MB";
        return $"{Math.Max(0, bytes) / 1024d:N0} KB";
    }

    string FormatearConfianza(decimal? confianza)
    {
        if (!confianza.HasValue) return "Sin calificar";
        var porcentaje = confianza.Value <= 1m ? confianza.Value * 100m : confianza.Value;
        return $"{Math.Clamp(porcentaje, 0m, 100m):N0}%";
    }

    List<string> SepararClaves(string valor)
    {
        if (string.IsNullOrWhiteSpace(valor)) return new List<string> { "Sin clave" };
        var claves = valor
            .Split(new[] { '\r', '\n', ';', '|' }, StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries)
            .Distinct(StringComparer.OrdinalIgnoreCase)
            .ToList();
        return claves.Count == 0 ? new List<string> { "Sin clave" } : claves;
    }

    string ResumirClaves(string valor)
    {
        var claves = SepararClaves(valor);
        if (claves.Count <= 2) return string.Join(" · ", claves);
        return $"{claves[0]} · {claves[1]} +{claves.Count - 2} más";
    }

    string EtiquetaCampo(string campo) => campo switch
    {
        "NombreProyecto" => "Nombre del proyecto",
        "GRT" => "Región de transmisión",
        "EtapaProyecto" => "Etapa del proyecto",
        "FechaNecesaria" => "Fecha necesaria",
        "FeoFactible" => "Fecha de entrada en operación",
        "MontoProyectoMdp" => "Inversión (MDP)",
        "EstadoRealProyecto" => "Estado reportado",
        "EstadoVigenciaCartera" => "Vigencia en cartera",
        "AnioInstruccion" => "Año de instrucción",
        null or "" => "Registro completo",
        _ => campo
    };

    string ClaseProyecto(PamProyectoCambiosVista proyecto)
    {
        if (proyecto.EsAlta || proyecto.TieneBaja || proyecto.TieneReactivacion) return "is-priority";
        if (proyecto.TotalPrioritarios > 0) return "is-priority";
        if (proyecto.TotalPorCompletar > 0) return "is-complete";
        if (proyecto.TotalInformativos > 0 && proyecto.TotalOtros == 0) return "is-informative";
        if (proyecto.TotalEquivalentes > 0 && proyecto.TotalOtros == 0) return "is-equivalent";
        return "is-other";
    }

    string EtiquetaProyecto(PamProyectoCambiosVista proyecto)
    {
        if (proyecto.EsAlta) return "Alta potencial";
        if (proyecto.TieneBaja) return "Baja propuesta";
        if (proyecto.TieneReactivacion) return "Reactivación";
        if (proyecto.TotalPrioritarios > 0) return "Revisión prioritaria";
        if (proyecto.TotalPorCompletar > 0) return "Datos por completar";
        if (proyecto.TotalInformativos > 0 && proyecto.TotalOtros == 0) return "Revisión informativa";
        if (proyecto.TotalEquivalentes > 0 && proyecto.TotalOtros == 0) return "Equivalencia detectada";
        return "Otros cambios";
    }
}

@await Html.PartialAsync("_ViewHeader", Model.Header)

@* PUENTE TEMPORAL: igual que en Ficha.cshtml — esta vista aún nombra sus
   iconos con clases fa- y la plataforma ya no carga Font Awesome. Quitar al
   migrarla a Bootstrap Icons. *@
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css" />

<div class="container-fluid shell-page-container py-3 pam-analysis-page">
    <div class="pam-analysis-nav">
        <a asp-action="NuevaActualizacion" class="btn btn-outline-secondary">
            <i class="fas fa-arrow-left me-2"></i>Volver a actualizaciones
        </a>
        <div class="pam-analysis-nav__actions">
            <a asp-action="PrepararAplicacion" asp-route-loteId="@Model.Lote.LoteId" class="btn btn-primary">
                <i class="fas fa-list-check me-2"></i>Preparar aplicación
            </a>
            <a asp-action="Index" class="btn btn-link pam-dashboard-link">
                <i class="fas fa-table-columns me-2"></i>Dashboard de proyectos
            </a>
        </div>
    </div>

    @if (!string.IsNullOrWhiteSpace(successMessage))
    {
        <div class="alert pam-analysis-alert is-success" role="status">
            <i class="fas fa-circle-check"></i><span>@successMessage</span>
        </div>
    }

    @if (!string.IsNullOrWhiteSpace(errorMessage))
    {
        <div class="alert pam-analysis-alert is-error" role="alert">
            <i class="fas fa-triangle-exclamation"></i><span>@errorMessage</span>
        </div>
    }

    <section class="pam-analysis-hero">
        <div class="pam-analysis-hero__main">
            <div class="pam-analysis-eyebrow">Lote documental #@Model.Lote.LoteId</div>
            <h2>@Model.Lote.Nombre</h2>
            <p>@(string.IsNullOrWhiteSpace(Model.Lote.Notas) ? "Sin notas adicionales para este corte." : Model.Lote.Notas)</p>
            <div class="pam-analysis-meta">
                <span><i class="fas fa-calendar-day"></i>Corte @Model.Lote.FechaCorte.ToString("dd MMM yyyy")</span>
                <span><i class="fas fa-file-lines"></i>@Model.Lote.TotalArchivos archivo(s)</span>
                <span><i class="fas fa-user"></i>@(Model.Lote.UsuarioNombre ?? "Usuario no identificado")</span>
                <span><i class="fas fa-clock"></i>@Model.Lote.FechaRegistroUtc.ToString("dd MMM yyyy HH:mm") UTC</span>
            </div>
        </div>
        <div class="pam-analysis-hero__status">
            <span class="pam-status @ClaseEstado(Model.Lote.Estado)">@Model.Lote.Estado</span>
            <small>UID @Model.Lote.LoteUid.ToString("N")[..8]</small>
            @if (!Model.AnalisisActivo && Model.Fuentes.Count > 0
                && (Model.EjecucionActual == null || string.Equals(Model.EjecucionActual.Estado, "Error", StringComparison.OrdinalIgnoreCase)))
            {
                <form asp-action="SolicitarAnalisis" asp-route-loteId="@Model.Lote.LoteId" method="post" class="pam-analysis-request-form">
                    @Html.AntiForgeryToken()
                    <button type="submit" class="btn btn-primary">
                        <i class="fas fa-magnifying-glass-chart me-2"></i>Analizar archivos
                    </button>
                </form>
            }
            else if (Model.AnalisisActivo)
            {
                <span class="pam-analysis-lock"><i class="fas fa-spinner fa-spin"></i>Análisis en curso</span>
            }
        </div>
    </section>

    <section class="card border-0 shadow-sm pam-analysis-card">
        <div class="pam-section-heading">
            <div>
                <span class="pam-analysis-eyebrow">Fuentes preservadas</span>
                <h3>Archivos del lote</h3>
            </div>
            <span class="pam-section-count">@Model.Fuentes.Count archivo(s)</span>
        </div>

        @if (Model.Fuentes.Count == 0)
        {
            <div class="pam-analysis-empty">
                <i class="fas fa-file-circle-xmark"></i>
                <strong>Este lote no tiene archivos asociados.</strong>
                <span>No es posible iniciar el análisis hasta registrar una fuente.</span>
            </div>
        }
        else
        {
            <div class="pam-source-list">
                @foreach (var fuente in Model.Fuentes)
                {
                    <article>
                        <div class="pam-source-kind">@((fuente.Extension ?? "archivo").TrimStart('.').ToUpperInvariant())</div>
                        <div class="pam-source-name">
                            <strong title="@fuente.NombreOriginal">@fuente.NombreOriginal</strong>
                            <small>@FormatearTamano(fuente.TamanoBytes) · Firma @(fuente.FirmaValidada ? "validada" : "pendiente")</small>
                        </div>
                        <div class="pam-source-state">
                            <span class="pam-status @ClaseEstado(fuente.EstadoExtraccion)">@fuente.EstadoExtraccion</span>
                            @if (!string.IsNullOrWhiteSpace(fuente.MensajeExtraccion))
                            {
                                <small>@fuente.MensajeExtraccion</small>
                            }
                        </div>
                    </article>
                }
            </div>
        }
    </section>

    @if (ejecucion != null)
    {
        <section class="card border-0 shadow-sm pam-analysis-card pam-progress-card" id="pam-analysis-execution" aria-live="polite">
            <div class="pam-section-heading">
                <div>
                    <span class="pam-analysis-eyebrow">Ejecución #@ejecucion.AnalisisId</span>
                    <h3 id="pam-analysis-state">@ejecucion.Estado</h3>
                </div>
                <span class="pam-status @ClaseEstado(ejecucion.Estado)" id="pam-analysis-badge">@ejecucion.Estado</span>
            </div>
            <div class="pam-progress-meta">
                <span id="pam-analysis-count">@ejecucion.FuentesProcesadas de @ejecucion.TotalFuentes fuentes</span>
                <strong id="pam-analysis-percent">@progreso.ToString("N0")%</strong>
            </div>
            <div class="progress pam-analysis-progress" role="progressbar" aria-label="Progreso del análisis"
                 aria-valuemin="0" aria-valuemax="100" aria-valuenow="@progreso" id="pam-analysis-progress">
                <div class="progress-bar" style="width:@progreso.ToString("0.##", System.Globalization.CultureInfo.InvariantCulture)%"></div>
            </div>
            <p id="pam-analysis-message">@(ejecucion.Mensaje ?? "La ejecución no registró un mensaje adicional.")</p>
            <div class="pam-execution-dates">
                <span>Solicitado @ejecucion.FechaSolicitudUtc.ToString("dd MMM HH:mm") UTC</span>
                @if (ejecucion.FechaInicioUtc.HasValue) { <span>Iniciado @ejecucion.FechaInicioUtc.Value.ToString("dd MMM HH:mm") UTC</span> }
                @if (ejecucion.FechaFinUtc.HasValue) { <span>Finalizado @ejecucion.FechaFinUtc.Value.ToString("dd MMM HH:mm") UTC</span> }
            </div>
        </section>
    }
    else
    {
        <section class="pam-ready-note">
            <i class="fas fa-shield-halved"></i>
            <div>
                <strong>El análisis todavía no se ha solicitado.</strong>
                <span>Al iniciarlo se extraerá información y se propondrán diferencias; ningún proyecto se modifica en esta fase.</span>
            </div>
        </section>
    }

    <section class="pam-analysis-kpis" aria-label="Resumen del análisis">
        <article><span>Referencias detectadas</span><strong>@Model.Resumen.RegistrosDetectados.ToString("N0")</strong><i class="fas fa-list-check"></i></article>
        <article><span>Coincidencias con SQL</span><strong>@Model.Resumen.CoincidenciasExactas.ToString("N0")</strong><i class="fas fa-link"></i></article>
        <article><span>Diferencias de campo</span><strong>@Model.Resumen.CambiosPropuestos.ToString("N0")</strong><i class="fas fa-code-compare"></i></article>
        <article><span>Altas potenciales</span><strong>@Model.Resumen.AltasPropuestas.ToString("N0")</strong><i class="fas fa-circle-plus"></i></article>
        <article><span>Observados</span><strong>@Model.Resumen.Observados.ToString("N0")</strong><i class="fas fa-eye"></i></article>
        <article><span>Sin coincidencia</span><strong>@Model.Resumen.ClavesNoEncontradas.ToString("N0")</strong><i class="fas fa-circle-question"></i></article>
    </section>

    <section class="card border-0 shadow-sm pam-analysis-card pam-changes-card">
        <div class="pam-section-heading pam-review-heading">
            <div>
                <span class="pam-analysis-eyebrow">Comparación contra SQL</span>
                <h3>Revisión agrupada por proyecto</h3>
                <p>
                    <strong>@Model.TotalProyectos.ToString("N0") proyecto(s)</strong>
                    · @Model.TotalCambios.ToString("N0") diferencia(s) contenidas en esos proyectos
                </p>
                <small>Al guardar una clasificación, la tarjeta sale de Pendientes y queda disponible en Revisadas. Este cierre no modifica todavía la cartera maestra.</small>
            </div>
            <form asp-action="ActualizacionDetalle" asp-route-loteId="@Model.Lote.LoteId" method="get" class="pam-project-search" role="search">
                <label for="pam-project-search">Buscar proyecto</label>
                <div>
                    <i class="fas fa-magnifying-glass" aria-hidden="true"></i>
                    <input id="pam-project-search" name="busqueda" type="search" class="form-control"
                           value="@Model.Filtro.Busqueda" placeholder="Clave o nombre" maxlength="200" />
                    <button type="submit" class="btn btn-primary">Buscar</button>
                </div>
                <input type="hidden" name="categoria" value="@Model.Filtro.Categoria" />
                @if (!string.IsNullOrWhiteSpace(Model.Filtro.Tipo))
                {
                    <input type="hidden" name="tipo" value="@Model.Filtro.Tipo" />
                }
                <input type="hidden" name="estadoRevision" value="@Model.Filtro.EstadoRevision" />
                <input type="hidden" name="pagina" value="1" />
            </form>
        </div>

        <details class="pam-pem-guide" open>
            <summary>
                <span><i class="fas fa-compass" aria-hidden="true"></i><strong>Guía rápida para clasificar claves PEM</strong></span>
                <small>@Model.Resumen.RelacionesJerarquiaValidadas relación(es) padre-hijo validada(s) en la cartera</small>
            </summary>
            <div class="pam-pem-guide__body">
                <section aria-labelledby="pam-key-guide-title">
                    <h4 id="pam-key-guide-title">Cómo leer la clave</h4>
                    <div class="pam-key-anatomy" aria-label="Ejemplo P 15 BS 1: familia, año, región y consecutivo">
                        <span><strong>P</strong><small>Familia</small></span>
                        <span><strong>15</strong><small>Año</small></span>
                        <span><strong>BS</strong><small>Región</small></span>
                        <span><strong>1</strong><small>Consecutivo</small></span>
                    </div>
                    <p><strong>PEM</strong> significa Proyecto Elemental Mínimo: puede agrupar varias obras que funcionan como una solución.</p>
                    <div class="pam-key-codes">
                        <span><code>P</code> Ampliación RNT</span>
                        <span><code>M</code> Modernización RNT</span>
                        <span><code>D</code> Ampliación RGD</span>
                        <span><code>I</code> Solución integrada; confirmar alcance en la fuente</span>
                        <span><code>CFE</code> Clave de seguimiento; no define jerarquía</span>
                    </div>
                    <p class="pam-key-regions"><strong>Regiones:</strong> BC Baja California · BS Baja California Sur · CE Central · NE Noreste · NO Noroeste · NT Norte · OC Occidental · OR Oriental · PE Peninsular.</p>
                </section>
                <section aria-labelledby="pam-classification-guide-title">
                    <h4 id="pam-classification-guide-title">Qué clasificación usar</h4>
                    <ul class="pam-classification-guide">
                        <li><span class="is-link">Vincular existente</span><p>Mismo proyecto oficial, aunque tenga otra clave, nombre o varios PEM en una sola fila.</p></li>
                        <li><span class="is-family">Padre-hijo</span><p>Sólo si son dos proyectos distintos y la fuente declara que uno es componente del otro.</p></li>
                        <li><span class="is-new">Alta real</span><p>No existe coincidencia después de cotejar clave, nombre, región y fuente.</p></li>
                        <li><span class="is-discard">Descartar</span><p>No es un proyecto incorporable o el hallazgo proviene de ruido de extracción.</p></li>
                    </ul>
                    <div class="pam-pem-warning"><i class="fas fa-triangle-exclamation" aria-hidden="true"></i><strong>Varias claves PEM en la misma fila del PAM no son hijos:</strong> pertenecen al mismo proyecto y se vinculan al registro existente.</div>
                </section>
            </div>
        </details>

        <nav class="pam-review-state-filters" aria-label="Filtrar proyectos por estado de revisión">
            <span>Estado de revisión</span>
            <a class="@(Model.Filtro.EstadoRevision == "Pendiente" ? "is-active" : null)"
               asp-action="ActualizacionDetalle" asp-route-loteId="@Model.Lote.LoteId"
               asp-route-categoria="@Model.Filtro.Categoria" asp-route-tipo="@Model.Filtro.Tipo"
               asp-route-busqueda="@Model.Filtro.Busqueda" asp-route-estadoRevision="Pendiente" asp-route-pagina="1"
               aria-current="@(Model.Filtro.EstadoRevision == "Pendiente" ? "page" : null)">
                <i class="fas fa-hourglass-half" aria-hidden="true"></i><span>Pendientes</span>
                <strong>@Model.Resumen.ProyectosRevisionPendiente.ToString("N0")</strong>
            </a>
            <a class="@(Model.Filtro.EstadoRevision == "Revisada" ? "is-active" : null)"
               asp-action="ActualizacionDetalle" asp-route-loteId="@Model.Lote.LoteId"
               asp-route-categoria="@Model.Filtro.Categoria" asp-route-tipo="@Model.Filtro.Tipo"
               asp-route-busqueda="@Model.Filtro.Busqueda" asp-route-estadoRevision="Revisada" asp-route-pagina="1"
               aria-current="@(Model.Filtro.EstadoRevision == "Revisada" ? "page" : null)">
                <i class="fas fa-circle-check" aria-hidden="true"></i><span>Revisadas</span>
                <strong>@Model.Resumen.ProyectosRevisionCerrada.ToString("N0")</strong>
            </a>
        </nav>

        <nav class="pam-review-filters" aria-label="Filtrar proyectos por tipo de revisión">
            <a class="@(Model.Filtro.Categoria == "Todos" && string.IsNullOrWhiteSpace(Model.Filtro.Tipo) ? "is-active" : null)"
               asp-action="ActualizacionDetalle" asp-route-loteId="@Model.Lote.LoteId"
               asp-route-categoria="Todos" asp-route-busqueda="@Model.Filtro.Busqueda" asp-route-estadoRevision="@Model.Filtro.EstadoRevision" asp-route-pagina="1"
               aria-current="@(Model.Filtro.Categoria == "Todos" && string.IsNullOrWhiteSpace(Model.Filtro.Tipo) ? "page" : null)">
                <i class="fas fa-layer-group" aria-hidden="true"></i><span>Todos</span>
                <span class="pam-filter-count">@Model.ConteoFiltroActual("Todos").ToString("N0")</span>
            </a>
            <a class="@(Model.Filtro.Categoria == "Prioritario" && string.IsNullOrWhiteSpace(Model.Filtro.Tipo) ? "is-active" : null)"
               asp-action="ActualizacionDetalle" asp-route-loteId="@Model.Lote.LoteId"
               asp-route-categoria="Prioritario" asp-route-busqueda="@Model.Filtro.Busqueda" asp-route-estadoRevision="@Model.Filtro.EstadoRevision" asp-route-pagina="1"
               aria-current="@(Model.Filtro.Categoria == "Prioritario" && string.IsNullOrWhiteSpace(Model.Filtro.Tipo) ? "page" : null)">
                <i class="fas fa-triangle-exclamation" aria-hidden="true"></i><span>Prioritarios</span>
                <span class="pam-filter-count">@Model.ConteoFiltroActual("Prioritario").ToString("N0")</span>
            </a>
            <a class="@(Model.Filtro.Categoria == "Informativo" && string.IsNullOrWhiteSpace(Model.Filtro.Tipo) ? "is-active" : null)"
               asp-action="ActualizacionDetalle" asp-route-loteId="@Model.Lote.LoteId"
               asp-route-categoria="Informativo" asp-route-busqueda="@Model.Filtro.Busqueda" asp-route-estadoRevision="@Model.Filtro.EstadoRevision" asp-route-pagina="1"
               aria-current="@(Model.Filtro.Categoria == "Informativo" && string.IsNullOrWhiteSpace(Model.Filtro.Tipo) ? "page" : null)">
                 <i class="fas fa-circle-info" aria-hidden="true"></i><span>Informativos</span>
                 <span class="pam-filter-count">@Model.ConteoFiltroActual("Informativo").ToString("N0")</span>
            </a>
            <a class="@(Model.Filtro.Categoria == "Completar" && string.IsNullOrWhiteSpace(Model.Filtro.Tipo) ? "is-active" : null)"
               asp-action="ActualizacionDetalle" asp-route-loteId="@Model.Lote.LoteId"
               asp-route-categoria="Completar" asp-route-busqueda="@Model.Filtro.Busqueda" asp-route-estadoRevision="@Model.Filtro.EstadoRevision" asp-route-pagina="1"
               aria-current="@(Model.Filtro.Categoria == "Completar" && string.IsNullOrWhiteSpace(Model.Filtro.Tipo) ? "page" : null)">
                 <i class="fas fa-file-circle-plus" aria-hidden="true"></i><span>Completar datos</span>
                 <span class="pam-filter-count">@Model.ConteoFiltroActual("Completar").ToString("N0")</span>
            </a>
            <a class="@(Model.Filtro.Categoria == "Equivalente" && string.IsNullOrWhiteSpace(Model.Filtro.Tipo) ? "is-active" : null)"
               asp-action="ActualizacionDetalle" asp-route-loteId="@Model.Lote.LoteId"
               asp-route-categoria="Equivalente" asp-route-busqueda="@Model.Filtro.Busqueda" asp-route-estadoRevision="@Model.Filtro.EstadoRevision" asp-route-pagina="1"
               aria-current="@(Model.Filtro.Categoria == "Equivalente" && string.IsNullOrWhiteSpace(Model.Filtro.Tipo) ? "page" : null)">
                 <i class="fas fa-equals" aria-hidden="true"></i><span>Equivalentes</span>
                 <span class="pam-filter-count">@Model.ConteoFiltroActual("Equivalente").ToString("N0")</span>
            </a>
            <a class="@(Model.Filtro.Categoria == "Otros" && string.IsNullOrWhiteSpace(Model.Filtro.Tipo) ? "is-active" : null)"
               asp-action="ActualizacionDetalle" asp-route-loteId="@Model.Lote.LoteId"
               asp-route-categoria="Otros" asp-route-busqueda="@Model.Filtro.Busqueda" asp-route-estadoRevision="@Model.Filtro.EstadoRevision" asp-route-pagina="1"
               aria-current="@(Model.Filtro.Categoria == "Otros" && string.IsNullOrWhiteSpace(Model.Filtro.Tipo) ? "page" : null)">
                <i class="fas fa-ellipsis" aria-hidden="true"></i><span>Otros</span>
                <span class="pam-filter-count">@Model.ConteoFiltroActual("Otros").ToString("N0")</span>
            </a>
            <a class="@(Model.Filtro.Tipo == "Alta" ? "is-active" : null)"
               asp-action="ActualizacionDetalle" asp-route-loteId="@Model.Lote.LoteId"
               asp-route-tipo="Alta" asp-route-busqueda="@Model.Filtro.Busqueda" asp-route-estadoRevision="@Model.Filtro.EstadoRevision" asp-route-pagina="1"
                aria-current="@(Model.Filtro.Tipo == "Alta" ? "page" : null)">
                <i class="fas fa-circle-plus" aria-hidden="true"></i><span>Altas</span>
                <span class="pam-filter-count">@Model.ConteoFiltroActual("Alta").ToString("N0")</span>
            </a>
        </nav>

        @if (!string.IsNullOrWhiteSpace(Model.Filtro.Busqueda))
        {
            <div class="pam-active-search" role="status">
                <span>Resultados para <strong>“@Model.Filtro.Busqueda”</strong></span>
                <a asp-action="ActualizacionDetalle" asp-route-loteId="@Model.Lote.LoteId"
                   asp-route-categoria="@Model.Filtro.Categoria" asp-route-tipo="@Model.Filtro.Tipo" asp-route-estadoRevision="@Model.Filtro.EstadoRevision" asp-route-pagina="1">
                    Limpiar búsqueda
                </a>
            </div>
        }

        @if (Model.Proyectos.Count == 0)
        {
            <div class="pam-analysis-empty">
                <i class="fas fa-folder-open" aria-hidden="true"></i>
                <strong>@(Model.Filtro.EstadoRevision == "Revisada" ? "No hay revisiones cerradas para mostrar." : "No quedan revisiones pendientes con este filtro.")</strong>
                <span>Pruebe otro filtro o cambie entre Pendientes y Revisadas. El análisis original permanece sin cambios.</span>
            </div>
        }
        else
        {
            var gruposVisuales = new List<List<int>>();
            for (var indice = 0; indice < Model.Proyectos.Count; indice++)
            {
                var actual = Model.Proyectos[indice];
                var claveFamiliaActual = actual.AltaDatos?.ClaveFamiliaProbable;
                var seIntegraAlAnterior = gruposVisuales.Count > 0
                    && actual.EsAlta
                    && !string.IsNullOrWhiteSpace(claveFamiliaActual)
                    && Model.Proyectos[gruposVisuales[^1][^1]].EsAlta
                    && string.Equals(
                        Model.Proyectos[gruposVisuales[^1][^1]].AltaDatos?.ClaveFamiliaProbable,
                        claveFamiliaActual,
                        StringComparison.Ordinal);

                if (seIntegraAlAnterior)
                    gruposVisuales[^1].Add(indice);
                else
                    gruposVisuales.Add(new List<int> { indice });
            }

            <div class="pam-project-list">
                @for (var indiceGrupo = 0; indiceGrupo < gruposVisuales.Count; indiceGrupo++)
                {
                    var indicesGrupo = gruposVisuales[indiceGrupo];
                    var proyectoCabecera = Model.Proyectos[indicesGrupo[0]];
                    var altaFamilia = proyectoCabecera.AltaDatos;
                    var esFamiliaProbable = proyectoCabecera.EsAlta && altaFamilia?.EsFamiliaProbable == true;
                    var familiaTitleId = $"pam-family-title-{Model.Filtro.Pagina}-{indiceGrupo}";
                    var familiaHelpId = $"pam-family-help-{Model.Filtro.Pagina}-{indiceGrupo}";

                    <section class="pam-family-group @(esFamiliaProbable ? "is-family" : null)"
                             role="@(esFamiliaProbable ? "group" : null)"
                             aria-labelledby="@(esFamiliaProbable ? familiaTitleId : null)"
                             aria-describedby="@(esFamiliaProbable ? familiaHelpId : null)">
                        @if (esFamiliaProbable)
                        {
                            var clavesVisibles = altaFamilia.ClavesMismoNombre.Take(12).ToList();
                            <header class="pam-family-header">
                                <div class="pam-family-heading">
                                    <span class="pam-analysis-eyebrow"><i class="fas fa-code-branch" aria-hidden="true"></i>Familia / proyecto macro probable</span>
                                    <h4 id="@familiaTitleId">@(altaFamilia.NombreProyecto ?? proyectoCabecera.NombreProyecto ?? "Proyecto por identificar")</h4>
                                    <p id="@familiaHelpId">
                                        El análisis separó <strong>@altaFamilia.TotalClavesMismoNombre claves distintas</strong> que la fuente reporta bajo este mismo nombre
                                        y @indicesGrupo.Count se muestran en esta página. Es una agrupación de revisión, no una relación padre-hijo confirmada;
                                        cada clave se clasifica por separado.
                                    </p>
                                    <div class="pam-family-keys" aria-label="Claves detectadas en esta familia probable">
                                        @foreach (var claveFamilia in clavesVisibles)
                                        {
                                            <code>@claveFamilia</code>
                                        }
                                        @if (altaFamilia.ClavesMismoNombre.Count > clavesVisibles.Count)
                                        {
                                            <span>+@(altaFamilia.ClavesMismoNombre.Count - clavesVisibles.Count) más</span>
                                        }
                                    </div>
                                </div>
                                <span class="pam-family-count"><strong>@altaFamilia.TotalClavesMismoNombre</strong> claves relacionadas por nombre</span>
                            </header>
                        }

                        @foreach (var indiceProyecto in indicesGrupo)
                        {
                            var proyecto = Model.Proyectos[indiceProyecto];
                    var decisionPreliminar = proyecto.Decision;
                    var bloques = new[]
                    {
                        new { Titulo = "Cambios prioritarios", Clase = "is-priority", Icono = "fa-triangle-exclamation", Cambios = proyecto.Prioritarios },
                        new { Titulo = "Datos nuevos para completar", Clase = "is-complete", Icono = "fa-file-circle-plus", Cambios = proyecto.PorCompletar },
                        new { Titulo = "Cambios informativos", Clase = "is-informative", Icono = "fa-circle-info", Cambios = proyecto.Informativos },
                        new { Titulo = "Equivalencias o precisión menor", Clase = "is-equivalent", Icono = "fa-equals", Cambios = proyecto.Equivalentes },
                        new { Titulo = "Otros cambios detectados", Clase = "is-other", Icono = "fa-ellipsis", Cambios = proyecto.Otros }
                    };
                    var confianzaMinima = proyecto.Cambios.Where(cambio => cambio.Confianza.HasValue)
                        .Select(cambio => cambio.Confianza.Value)
                        .DefaultIfEmpty()
                        .Min();
                    var tieneConfianza = proyecto.Cambios.Any(cambio => cambio.Confianza.HasValue);
                    var cambioAltaId = proyecto.AltaDatos?.CambioPropuestoId;
                    var esObjetivoRetorno = cambioAltaId.HasValue && Model.Filtro.Cambio == cambioAltaId.Value;
                    var abrirProyecto = esObjetivoRetorno
                        || (!Model.Filtro.Cambio.HasValue && indiceProyecto == 0 && proyecto.TotalPrioritarios > 0);

                    <details id="@(cambioAltaId.HasValue ? $"pam-project-{cambioAltaId.Value}" : null)"
                             class="pam-project-review @ClaseProyecto(proyecto) @(esFamiliaProbable ? "is-family-member" : null)" open="@(abrirProyecto ? "open" : null)">
                        <summary class="pam-project-summary">
                            <span class="pam-project-identity">
                                <span class="pam-project-classification">@EtiquetaProyecto(proyecto)</span>
                                <code>@(proyecto.ClaveProyecto ?? "Sin clave")</code>
                                <strong>@(esFamiliaProbable ? "Clave individual para revisión" : proyecto.NombreProyecto ?? "Proyecto por identificar")</strong>
                            </span>
                            <span class="pam-project-metrics" aria-label="Resumen de diferencias">
                                @if (proyecto.EsAlta)
                                {
                                    <span><strong>1</strong> registro recibido</span>
                                    @if (proyecto.AltaDatos?.EsFamiliaProbable == true)
                                    {
                                        <span class="is-family"><strong>@proyecto.AltaDatos.TotalClavesMismoNombre</strong> en familia probable</span>
                                    }
                                }
                                else
                                {
                                    <span><strong>@proyecto.TotalCambios</strong> campo(s)</span>
                                    @if (proyecto.RevisionCamposCompleta)
                                    {
                                        <span class="is-decision"><i class="fas fa-circle-check" aria-hidden="true"></i>Campos revisados</span>
                                    }
                                    else
                                    {
                                        <span class="is-priority"><strong>@proyecto.CamposPendientes</strong> por decidir</span>
                                    }
                                }
                                @if (proyecto.TotalPrioritarios > 0) { <span class="is-priority">@proyecto.TotalPrioritarios prioritario(s)</span> }
                                @if (proyecto.TotalPorCompletar > 0) { <span class="is-complete">@proyecto.TotalPorCompletar por completar</span> }
                                @if (proyecto.TotalInformativos > 0) { <span class="is-informative">@proyecto.TotalInformativos informativo(s)</span> }
                                @if (proyecto.TotalEquivalentes > 0) { <span class="is-equivalent">@proyecto.TotalEquivalentes equivalente(s)</span> }
                                @if (proyecto.TotalOtros > 0) { <span>@proyecto.TotalOtros otro(s)</span> }
                                @if (!string.IsNullOrWhiteSpace(decisionPreliminar?.Clasificacion))
                                {
                                    <span class="is-decision"><i class="fas fa-circle-check" aria-hidden="true"></i>Clasificada: <strong>@decisionPreliminar.Clasificacion</strong></span>
                                }
                                @if (tieneConfianza) { <span>@FormatearConfianza(confianzaMinima) confianza mínima</span> }
                            </span>
                            <i class="fas fa-chevron-down pam-project-chevron" aria-hidden="true"></i>
                         </summary>
                        @if (string.Equals(decisionPreliminar?.Estado, "Revisada", StringComparison.OrdinalIgnoreCase)
                            && !string.IsNullOrWhiteSpace(decisionPreliminar.VersionDecision))
                        {
                            <div class="pam-summary-review-action">
                                <span><i class="fas fa-circle-check" aria-hidden="true"></i>Revisión cerrada: @decisionPreliminar.Clasificacion</span>
                                <form asp-action="ReabrirDecisionPreliminar" asp-route-loteId="@Model.Lote.LoteId" method="post" data-reopen-form>
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="CambioPropuestoId" value="@(cambioAltaId ?? 0)" />
                                    <input type="hidden" name="RevisionId" value="@decisionPreliminar.RevisionId" />
                                    <input type="hidden" name="VersionDecision" value="@decisionPreliminar.VersionDecision" />
                                    <input type="hidden" name="PaginaRetorno" value="@Model.Filtro.Pagina" />
                                    <input type="hidden" name="CategoriaRetorno" value="@Model.Filtro.Categoria" />
                                    <input type="hidden" name="BusquedaRetorno" value="@Model.Filtro.Busqueda" />
                                    <input type="hidden" name="TipoRetorno" value="@Model.Filtro.Tipo" />
                                    <button type="submit" class="btn btn-sm btn-outline-secondary"><i class="fas fa-rotate-left me-1" aria-hidden="true"></i>Reabrir para corregir</button>
                                </form>
                            </div>
                        }
                        <div class="pam-project-body">
                            @if (proyecto.EsAlta && proyecto.AltaDatos != null)
                            {
                                var alta = proyecto.AltaDatos;
                                var decision = decisionPreliminar;
                                var revisionCerrada = string.Equals(decision?.Estado, "Revisada", StringComparison.OrdinalIgnoreCase);
                                var puedeClasificar = decision != null && !revisionCerrada && !string.IsNullOrWhiteSpace(decision.VersionDecision);
                                var relacionadosIds = proyecto.Candidatos.Select(candidato => candidato.ProyectoId).ToHashSet();
                                var candidatoVinculo = proyecto.Candidatos
                                    .FirstOrDefault(candidato => candidato.ClasificacionSugerida == "Vincular existente");

                                <div class="pam-project-guidance is-alta">
                                    <i class="fas fa-shield-halved" aria-hidden="true"></i>
                                    <span><strong>Revisión preliminar.</strong> La ficha proviene del archivo recibido. Guardar una clasificación sólo deja traza en el área de revisión; no crea, vincula ni modifica proyectos de la cartera.</span>
                                </div>

                                <section class="pam-alta-section" aria-labelledby="pam-alta-data-@alta.CambioPropuestoId">
                                    <div class="pam-alta-heading">
                                        <div>
                                            <span class="pam-analysis-eyebrow">Información recibida</span>
                                            <h4 id="pam-alta-data-@alta.CambioPropuestoId">Ficha del posible proyecto</h4>
                                        </div>
                                        <span class="pam-confidence">@FormatearConfianza(alta.Confianza) de extracción</span>
                                    </div>
                                    <dl class="pam-alta-data">
                                        <div><dt>Clave recibida</dt><dd>@(alta.ClaveProyecto ?? "Sin clave")</dd></div>
                                        <div class="is-wide"><dt>Proyecto</dt><dd>@(alta.NombreProyecto ?? "Nombre no extraído")</dd></div>
                                        <div><dt>Región</dt><dd>@(alta.GRT ?? "Sin dato")</dd></div>
                                        <div><dt>Etapa</dt><dd>@(alta.EtapaProyecto ?? "Sin dato")</dd></div>
                                        <div><dt>Fecha necesaria</dt><dd>@(alta.FechaNecesaria ?? "Sin dato")</dd></div>
                                        <div><dt>Entrada en operación</dt><dd>@(alta.FeoFactible ?? "Sin dato")</dd></div>
                                        <div><dt>Inversión</dt><dd>@(alta.MontoProyectoMdp.HasValue ? $"{alta.MontoProyectoMdp.Value:N3} MDP" : "Sin dato")</dd></div>
                                        <div><dt>Año de instrucción</dt><dd>@(alta.AnioInstruccion?.ToString() ?? "Sin dato")</dd></div>
                                        <div class="is-wide"><dt>Estado reportado</dt><dd>@(alta.EstadoRealProyecto ?? "Sin dato")</dd></div>
                                    </dl>
                                    <div class="pam-alta-source">
                                        <span><i class="fas fa-file-lines" aria-hidden="true"></i>@(alta.FuenteDocumento ?? "Fuente no indicada")</span>
                                        <span><i class="fas fa-location-dot" aria-hidden="true"></i>@(alta.UbicacionFuente ?? "Sin ubicación interna")</span>
                                    </div>
                                    @if (alta.CamposAdicionales.Count > 0)
                                    {
                                        <details class="pam-alta-more">
                                            <summary>Ver @alta.CamposAdicionales.Count dato(s) adicional(es) del archivo</summary>
                                            <dl>
                                                @foreach (var campo in alta.CamposAdicionales)
                                                {
                                                    <div><dt>@campo.Etiqueta</dt><dd>@campo.Valor</dd></div>
                                                }
                                            </dl>
                                        </details>
                                    }
                                </section>

                                <section class="pam-alta-section" aria-labelledby="pam-alta-candidates-@alta.CambioPropuestoId">
                                    <div class="pam-alta-heading">
                                        <div>
                                            <span class="pam-analysis-eyebrow">Apoyo para cotejo</span>
                                            <h4 id="pam-alta-candidates-@alta.CambioPropuestoId">Posibles coincidencias en la cartera</h4>
                                            <p>Son sugerencias automáticas; confirme nombre, clave y región antes de relacionar.</p>
                                        </div>
                                        <span class="pam-section-count">@proyecto.Candidatos.Count sugerencia(s)</span>
                                    </div>
                                    @if (proyecto.Candidatos.Count == 0)
                                    {
                                        <div class="pam-alta-empty"><i class="fas fa-magnifying-glass"></i>No se encontró una coincidencia suficientemente cercana.</div>
                                    }
                                    else
                                    {
                                        <ol class="pam-candidate-list">
                                            @foreach (var candidato in proyecto.Candidatos)
                                            {
                                                var clavesCandidato = SepararClaves(candidato.ClaveProyecto);
                                                <li>
                                                    <div class="pam-candidate-score"><strong>@candidato.Score.ToString("N0")%</strong><span>similitud</span></div>
                                                    <div class="pam-candidate-main">
                                                        <div class="pam-candidate-keys" aria-label="Claves de cartera sugeridas: @string.Join(", ", clavesCandidato)">
                                                            <span>Cartera</span>
                                                            @foreach (var claveCandidato in clavesCandidato)
                                                            {
                                                                <code>@claveCandidato</code>
                                                            }
                                                        </div>
                                                        <strong>@(candidato.NombreProyecto ?? "Sin nombre")</strong>
                                                        <small>@(candidato.GRT ?? "Sin región") · @(candidato.EtapaProyecto ?? "Sin etapa")</small>
                                                        <span>@candidato.Motivo</span>
                                                        @if (!string.IsNullOrWhiteSpace(candidato.ClasificacionSugerida))
                                                        {
                                                            <span class="pam-candidate-recommendation"><i class="fas fa-wand-magic-sparkles" aria-hidden="true"></i>Sugerencia: @candidato.ClasificacionSugerida</span>
                                                        }
                                                    </div>
                                                    <a asp-action="Detalle" asp-route-proyectoId="@candidato.ProyectoId" target="_blank" rel="noopener" aria-label="Abrir detalle de @string.Join(", ", clavesCandidato) en otra pestaña">
                                                        Ver detalle <i class="fas fa-arrow-up-right-from-square" aria-hidden="true"></i>
                                                    </a>
                                                </li>
                                            }
                                        </ol>
                                    }
                                </section>

                                <section class="pam-alta-section pam-decision-section" aria-labelledby="pam-alta-decision-@alta.CambioPropuestoId">
                                    <div class="pam-alta-heading">
                                        <div>
                                            <span class="pam-analysis-eyebrow">Criterio humano trazable</span>
                                            <h4 id="pam-alta-decision-@alta.CambioPropuestoId">Clasificación preliminar</h4>
                                        </div>
                                        @if (!string.IsNullOrWhiteSpace(decision?.Clasificacion))
                                        {
                                            <span class="pam-decision-current"><i class="fas fa-circle-check" aria-hidden="true"></i>@(revisionCerrada ? "Revisión cerrada" : "Guardada") · @decision.Clasificacion</span>
                                        }
                                    </div>

                                    @if (!string.IsNullOrWhiteSpace(decision?.Clasificacion))
                                    {
                                        <div class="pam-decision-history">
                                            <div>
                                                <strong>Última decisión registrada</strong>
                                                @if (decision.ProyectoRelacionadoId.HasValue)
                                                {
                                                    <span>Relacionado con <code>@ResumirClaves(decision.ProyectoRelacionadoClave ?? decision.ProyectoRelacionadoId.ToString())</code> @(decision.ProyectoRelacionadoNombre)</span>
                                                }
                                                @if (!string.IsNullOrWhiteSpace(decision.Nota))
                                                {
                                                    <span>Nota: @decision.Nota</span>
                                                }
                                            </div>
                                            <small>@(decision.UsuarioNombre ?? "Usuario no identificado") · @(decision.FechaDecisionUtc?.ToString("dd MMM yyyy HH:mm 'UTC'") ?? "Fecha no disponible")</small>
                                        </div>
                                    }

                                    @if (puedeClasificar)
                                    {
                                        @if (candidatoVinculo != null)
                                        {
                                            <div class="pam-decision-recommendation">
                                                <i class="fas fa-link" aria-hidden="true"></i>
                                                <span><strong>El cotejo recomienda Vincular existente.</strong> La clave o el nombre ya corresponde a <code>@ResumirClaves(candidatoVinculo.ClaveProyecto)</code>. Confirme la fuente antes de guardar.</span>
                                            </div>
                                        }
                                        <form asp-action="GuardarDecisionPreliminar" asp-route-loteId="@Model.Lote.LoteId" method="post" class="pam-decision-form" data-decision-form>
                                                 @Html.AntiForgeryToken()
                                                 <input type="hidden" name="CambioPropuestoId" value="@alta.CambioPropuestoId" />
                                                 <input type="hidden" name="RevisionId" value="@decision.RevisionId" />
                                            <input type="hidden" name="VersionDecision" value="@decision.VersionDecision" />
                                            <input type="hidden" name="PaginaRetorno" value="@Model.Filtro.Pagina" />
                                            <input type="hidden" name="CategoriaRetorno" value="@Model.Filtro.Categoria" />
                                            <input type="hidden" name="BusquedaRetorno" value="@Model.Filtro.Busqueda" />
                                            <input type="hidden" name="TipoRetorno" value="@Model.Filtro.Tipo" />

                                            <fieldset>
                                                <legend>¿Cómo debe tratarse este registro?</legend>
                                                <div class="pam-decision-options">
                                                    <label><input type="radio" name="Clasificacion" value="Alta real" checked="@(decision.Clasificacion == "Alta real" ? "checked" : null)" required data-related-toggle aria-controls="pam-related-field-@alta.CambioPropuestoId" aria-expanded="false" /><span><strong>Alta real</strong><small>No corresponde a un proyecto vigente.</small></span></label>
                                                    <label><input type="radio" name="Clasificacion" value="Vincular existente" checked="@(decision.Clasificacion == "Vincular existente" ? "checked" : null)" data-related-toggle aria-controls="pam-related-field-@alta.CambioPropuestoId" aria-expanded="false" /><span><strong>Vincular existente</strong><small>Es el mismo proyecto con otra clave o nombre.</small></span></label>
                                                    <label><input type="radio" name="Clasificacion" value="Padre-hijo" checked="@(decision.Clasificacion == "Padre-hijo" ? "checked" : null)" data-related-toggle aria-controls="pam-related-field-@alta.CambioPropuestoId" aria-expanded="false" /><span><strong>Posible hijo de existente</strong><small>El registro recibido formaría parte del proyecto macro seleccionado.</small></span></label>
                                                    <label><input type="radio" name="Clasificacion" value="Descartar" checked="@(decision.Clasificacion == "Descartar" ? "checked" : null)" data-related-toggle aria-controls="pam-related-field-@alta.CambioPropuestoId" aria-expanded="false" /><span><strong>Descartar</strong><small>No debe incorporarse como proyecto.</small></span></label>
                                                </div>
                                            </fieldset>

                                            <div id="pam-related-field-@alta.CambioPropuestoId" class="pam-related-field" data-related-field>
                                                <label for="pam-related-@alta.CambioPropuestoId">Proyecto vigente relacionado</label>
                                                <select id="pam-related-@alta.CambioPropuestoId" name="ProyectoRelacionadoId" class="form-select"
                                                        aria-describedby="pam-related-help-@alta.CambioPropuestoId" data-related-select>
                                                    <option value="">Seleccione una coincidencia</option>
                                                    @if (decision.ProyectoRelacionadoId.HasValue && !relacionadosIds.Contains(decision.ProyectoRelacionadoId.Value))
                                                    {
                                                        <option value="@decision.ProyectoRelacionadoId" selected>@ResumirClaves(decision.ProyectoRelacionadoClave ?? decision.ProyectoRelacionadoId.ToString()) — @(decision.ProyectoRelacionadoNombre ?? "Proyecto relacionado")</option>
                                                    }
                                                    @foreach (var candidato in proyecto.Candidatos)
                                                    {
                                                        <option value="@candidato.ProyectoId" selected="@(decision.ProyectoRelacionadoId == candidato.ProyectoId ? "selected" : null)">@ResumirClaves(candidato.ClaveProyecto) — @candidato.NombreProyecto (@candidato.Score.ToString("N0")%)</option>
                                                    }
                                                </select>
                                                <small id="pam-related-help-@alta.CambioPropuestoId" data-related-help>Se exige al vincular o marcar el registro recibido como posible hijo. La lista contiene las sugerencias automáticas más cercanas.</small>
                                            </div>

                                            <div class="pam-note-field">
                                                <label for="pam-note-@alta.CambioPropuestoId">Nota de revisión <span>opcional</span></label>
                                                <textarea id="pam-note-@alta.CambioPropuestoId" name="Nota" class="form-control" rows="3" maxlength="1000" placeholder="Explique brevemente el criterio usado">@decision.Nota</textarea>
                                            </div>

                                            <div class="pam-decision-actions">
                                                <p><i class="fas fa-clock-rotate-left" aria-hidden="true"></i>Cada guardado conserva usuario, fecha y versión anterior en el historial.</p>
                                                <button type="submit" class="btn btn-primary"><i class="fas fa-floppy-disk me-2" aria-hidden="true"></i>@(string.IsNullOrWhiteSpace(decision.Clasificacion) ? "Guardar clasificación preliminar" : "Actualizar clasificación preliminar")</button>
                                            </div>
                                        </form>
                                    }
                                    else if (revisionCerrada)
                                    {
                                        <div class="pam-closed-review">
                                            <div class="pam-alta-empty is-success"><i class="fas fa-circle-check"></i>Esta revisión está cerrada y permanece disponible en Revisadas. La clasificación todavía no se ha aplicado a la cartera maestra.</div>
                                            <form asp-action="ReabrirDecisionPreliminar" asp-route-loteId="@Model.Lote.LoteId" method="post" class="pam-reopen-form" data-reopen-form>
                                                @Html.AntiForgeryToken()
                                                <input type="hidden" name="CambioPropuestoId" value="@alta.CambioPropuestoId" />
                                                <input type="hidden" name="VersionDecision" value="@decision.VersionDecision" />
                                                <input type="hidden" name="PaginaRetorno" value="@Model.Filtro.Pagina" />
                                                <input type="hidden" name="CategoriaRetorno" value="@Model.Filtro.Categoria" />
                                                <input type="hidden" name="BusquedaRetorno" value="@Model.Filtro.Busqueda" />
                                                <input type="hidden" name="TipoRetorno" value="@Model.Filtro.Tipo" />
                                                <button type="submit" class="btn btn-outline-secondary"><i class="fas fa-rotate-left me-2" aria-hidden="true"></i>Reabrir para corregir</button>
                                            </form>
                                        </div>
                                    }
                                    else
                                    {
                                        <div class="pam-alta-empty is-warning"><i class="fas fa-triangle-exclamation"></i>La propuesta no tiene una revisión pendiente disponible. Recargue la página o vuelva a ejecutar el análisis.</div>
                                    }
                                </section>
                            }
                            else
                            {
                                var indiceDecisionCampo = 0;
                                var notaProyectoCampos = proyecto.Cambios
                                    .Select(cambio => cambio.NotaDecisionCampo)
                                    .FirstOrDefault(nota => !string.IsNullOrWhiteSpace(nota));

                                <form asp-action="GuardarDecisionesCampo" asp-route-loteId="@Model.Lote.LoteId" method="post" class="pam-field-decision-form" data-field-decision-form>
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="ProyectoVersionBaseId" value="@proyecto.ProyectoVersionBaseId" />
                                    <input type="hidden" name="PaginaRetorno" value="@Model.Filtro.Pagina" />
                                    <input type="hidden" name="CategoriaRetorno" value="@Model.Filtro.Categoria" />
                                    <input type="hidden" name="BusquedaRetorno" value="@Model.Filtro.Busqueda" />
                                    <input type="hidden" name="TipoRetorno" value="@Model.Filtro.Tipo" />
                                    <input type="hidden" name="EstadoRevisionRetorno" value="@Model.Filtro.EstadoRevision" />

                                    <div class="pam-project-guidance @(proyecto.RevisionCamposCompleta ? "is-reviewed" : null)">
                                        <i class="fas @(proyecto.RevisionCamposCompleta ? "fa-circle-check" : "fa-shield-halved")" aria-hidden="true"></i>
                                        <span>@(proyecto.RevisionCamposCompleta
                                            ? "La revisión de campos está cerrada. Puede corregirla; cada nuevo guardado conserva la decisión anterior."
                                            : "Compare cada valor y registre una decisión. Guardar esta revisión no modifica todavía la cartera maestra.")</span>
                                    </div>

                                    <div class="pam-field-review-toolbar">
                                        <div>
                                            <strong>Resolver todos los campos</strong>
                                            <small>Use un criterio común y después ajuste cualquier excepción.</small>
                                        </div>
                                        <div class="pam-field-bulk-actions" role="group" aria-label="Asignar una decisión a todos los campos del proyecto">
                                            <button type="button" class="btn btn-sm btn-outline-success" data-bulk-field-decision="Aplicar"><i class="fas fa-check me-1" aria-hidden="true"></i>Aplicar propuestas</button>
                                            <button type="button" class="btn btn-sm btn-outline-secondary" data-bulk-field-decision="Mantener SQL"><i class="fas fa-database me-1" aria-hidden="true"></i>Mantener SQL</button>
                                            <button type="button" class="btn btn-sm btn-outline-warning" data-bulk-field-decision="Omitir"><i class="fas fa-forward me-1" aria-hidden="true"></i>Omitir</button>
                                        </div>
                                    </div>

                                    @foreach (var bloque in bloques.Where(bloque => bloque.Cambios.Count > 0))
                                    {
                                        <section class="pam-change-block @bloque.Clase" aria-label="@bloque.Titulo">
                                            <div class="pam-change-block__heading">
                                                <h4><i class="fas @bloque.Icono" aria-hidden="true"></i>@bloque.Titulo</h4>
                                                <span>@bloque.Cambios.Count campo(s)</span>
                                            </div>
                                            <div class="pam-field-list">
                                                @foreach (var cambio in bloque.Cambios)
                                                {
                                                    var indiceActual = indiceDecisionCampo++;
                                                    <article class="pam-field-change @(string.IsNullOrWhiteSpace(cambio.DecisionCampo) ? "is-pending-decision" : "is-reviewed-decision")">
                                                        <input type="hidden" name="Cambios[@indiceActual].CambioPropuestoId" value="@cambio.CambioPropuestoId" />
                                                        <input type="hidden" name="Cambios[@indiceActual].UltimaDecisionId" value="@cambio.CambioDecisionId" />
                                                        <div class="pam-field-heading">
                                                            <div>
                                                                <span class="pam-change-type">@(cambio.TipoCambio ?? "Cambio")</span>
                                                                <h5>@EtiquetaCampo(cambio.Campo)</h5>
                                                            </div>
                                                            <span class="pam-confidence">@FormatearConfianza(cambio.Confianza)</span>
                                                        </div>
                                                        <div class="pam-values">
                                                            <span><small>Actual en SQL</small>@(string.IsNullOrWhiteSpace(cambio.ValorActual) ? "Sin valor" : cambio.ValorActual)</span>
                                                            <i class="fas fa-arrow-right" aria-hidden="true"></i>
                                                            <span><small>Propuesto por la fuente</small>@(string.IsNullOrWhiteSpace(cambio.ValorPropuesto) ? "Sin valor" : cambio.ValorPropuesto)</span>
                                                        </div>
                                                        <div class="pam-field-meta">
                                                            <span><i class="fas fa-file-lines" aria-hidden="true"></i>@(cambio.FuenteDocumento ?? "Fuente no indicada")</span>
                                                            <span><i class="fas fa-location-dot" aria-hidden="true"></i>@(cambio.UbicacionFuente ?? "Sin ubicación interna")</span>
                                                            <span><i class="fas @(string.IsNullOrWhiteSpace(cambio.DecisionCampo) ? "fa-hourglass-half" : "fa-circle-check")" aria-hidden="true"></i>@(cambio.DecisionCampo ?? "Pendiente de decisión")</span>
                                                        </div>
                                                        <fieldset class="pam-field-decision" data-field-decision>
                                                            <legend>Decisión para @EtiquetaCampo(cambio.Campo)</legend>
                                                            <label class="is-apply"><input type="radio" name="Cambios[@indiceActual].Decision" value="Aplicar" checked="@(cambio.DecisionCampo == "Aplicar" ? "checked" : null)" required /><span><i class="fas fa-check" aria-hidden="true"></i>Aplicar propuesta</span></label>
                                                            <label class="is-keep"><input type="radio" name="Cambios[@indiceActual].Decision" value="Mantener SQL" checked="@(cambio.DecisionCampo == "Mantener SQL" ? "checked" : null)" /><span><i class="fas fa-database" aria-hidden="true"></i>Mantener SQL</span></label>
                                                            <label class="is-skip"><input type="radio" name="Cambios[@indiceActual].Decision" value="Omitir" checked="@(cambio.DecisionCampo == "Omitir" ? "checked" : null)" /><span><i class="fas fa-forward" aria-hidden="true"></i>Omitir</span></label>
                                                        </fieldset>
                                                    </article>
                                                }
                                            </div>
                                        </section>
                                    }

                                    <div class="pam-field-project-note">
                                        <label>Nota del proyecto <span>opcional</span></label>
                                        <textarea name="NotaProyecto" class="form-control" rows="2" maxlength="1000" placeholder="Explique el criterio general o alguna excepción">@notaProyectoCampos</textarea>
                                    </div>
                                    <div class="pam-decision-actions">
                                        <p><i class="fas fa-clock-rotate-left" aria-hidden="true"></i>Se guardarán @proyecto.TotalCambios decisiones con usuario, fecha e historial.</p>
                                        <button type="submit" class="btn btn-primary"><i class="fas fa-floppy-disk me-2" aria-hidden="true"></i>@(proyecto.RevisionCamposCompleta ? "Actualizar revisión de campos" : "Guardar y cerrar proyecto")</button>
                                    </div>
                                </form>
                            }
                        </div>
                    </details>
                        }
                    </section>
                }
            </div>

            @if (Model.TotalPaginas > 1)
            {
                var paginaInicial = Math.Max(1, Model.Filtro.Pagina - 2);
                var paginaFinal = Math.Min(Model.TotalPaginas, Model.Filtro.Pagina + 2);
                <nav class="pam-pagination" aria-label="Páginas de proyectos con diferencias">
                    @if (Model.Filtro.Pagina > 1)
                    {
                        <a asp-action="ActualizacionDetalle" asp-route-loteId="@Model.Lote.LoteId"
                           asp-route-pagina="@(Model.Filtro.Pagina - 1)" asp-route-tamanoPagina="10"
                           asp-route-categoria="@Model.Filtro.Categoria" asp-route-busqueda="@Model.Filtro.Busqueda" asp-route-tipo="@Model.Filtro.Tipo" asp-route-estadoRevision="@Model.Filtro.EstadoRevision">
                            <i class="fas fa-chevron-left" aria-hidden="true"></i><span>Anterior</span>
                        </a>
                    }
                    else
                    {
                        <span class="is-disabled" aria-disabled="true"><i class="fas fa-chevron-left" aria-hidden="true"></i><span>Anterior</span></span>
                    }
                    <div>
                        @for (var pagina = paginaInicial; pagina <= paginaFinal; pagina++)
                        {
                            <a class="@(pagina == Model.Filtro.Pagina ? "is-current" : null)"
                               asp-action="ActualizacionDetalle" asp-route-loteId="@Model.Lote.LoteId"
                               asp-route-pagina="@pagina" asp-route-tamanoPagina="10"
                               asp-route-categoria="@Model.Filtro.Categoria" asp-route-busqueda="@Model.Filtro.Busqueda" asp-route-tipo="@Model.Filtro.Tipo" asp-route-estadoRevision="@Model.Filtro.EstadoRevision"
                               aria-current="@(pagina == Model.Filtro.Pagina ? "page" : null)">@pagina</a>
                        }
                    </div>
                    @if (Model.Filtro.Pagina < Model.TotalPaginas)
                    {
                        <a asp-action="ActualizacionDetalle" asp-route-loteId="@Model.Lote.LoteId"
                           asp-route-pagina="@(Model.Filtro.Pagina + 1)" asp-route-tamanoPagina="10"
                           asp-route-categoria="@Model.Filtro.Categoria" asp-route-busqueda="@Model.Filtro.Busqueda" asp-route-tipo="@Model.Filtro.Tipo" asp-route-estadoRevision="@Model.Filtro.EstadoRevision">
                            <span>Siguiente</span><i class="fas fa-chevron-right" aria-hidden="true"></i>
                        </a>
                    }
                    else
                    {
                        <span class="is-disabled" aria-disabled="true"><span>Siguiente</span><i class="fas fa-chevron-right" aria-hidden="true"></i></span>
                    }
                </nav>
                <p class="pam-pagination-summary">Proyectos @Model.RegistroDesde–@Model.RegistroHasta de @Model.TotalProyectos</p>
            }
        }
    </section>

    @{
        var hallazgosPendientes = Model.NoEncontrados
            .Where(hallazgo => !hallazgo.CambioPropuestoId.HasValue && !hallazgo.EstaRevisado)
            .ToList();
        var hallazgosAtendidos = Model.NoEncontrados
            .Where(hallazgo => !hallazgo.CambioPropuestoId.HasValue && hallazgo.EstaRevisado)
            .ToList();
        var altasGestionadasEnRevision = Model.NoEncontrados.Count(hallazgo => hallazgo.CambioPropuestoId.HasValue);
    }
    <section class="card border-0 shadow-sm pam-analysis-card" id="pam-claves-no-encontradas">
        <div class="pam-section-heading">
            <div>
                <span class="pam-analysis-eyebrow">Revisión necesaria</span>
                <h3>Claves y hallazgos sin coincidencia en la cartera</h3>
                <p>Las altas con propuesta se atienden en la revisión agrupada; aquí se resuelven las cancelaciones y hallazgos que no generaron una propuesta automática.</p>
            </div>
            <span class="pam-section-count @(hallazgosPendientes.Count > 0 ? "is-warning" : "is-success")">@hallazgosPendientes.Count pendiente(s)</span>
        </div>

        <div class="pam-finding-summary">
            <span><strong>@Model.Resumen.ClavesNoEncontradas</strong> hallazgos totales</span>
            <span><strong>@altasGestionadasEnRevision</strong> altas gestionadas arriba</span>
            <span><strong>@hallazgosAtendidos.Count</strong> hallazgos atendidos</span>
            <span class="@(hallazgosPendientes.Count > 0 ? "is-warning" : "is-success")"><strong>@hallazgosPendientes.Count</strong> por decidir</span>
        </div>

        @if (hallazgosPendientes.Count == 0)
        {
            <div class="pam-analysis-empty is-compact">
                <i class="fas fa-circle-check"></i>
                <strong>No hay hallazgos pendientes de clasificación.</strong>
            </div>
        }
        else
        {
            <div class="pam-cancellation-list">
                @foreach (var hallazgo in hallazgosPendientes)
                {
                    <details id="pam-hallazgo-@hallazgo.HallazgoId" class="pam-cancellation-review">
                        <summary>
                            <span class="pam-project-identity">
                                <span class="pam-project-classification">@(hallazgo.EsCancelacion ? "Cancelación reportada" : "Hallazgo sin coincidencia")</span>
                                <code>@(hallazgo.ClaveRecibida ?? "Sin clave")</code>
                                <strong>@(hallazgo.NombreRecibido ?? "Nombre no extraído")</strong>
                            </span>
                            <span class="pam-cancellation-state"><i class="fas fa-triangle-exclamation" aria-hidden="true"></i>Pendiente de decisión</span>
                            <i class="fas fa-chevron-down pam-project-chevron" aria-hidden="true"></i>
                        </summary>
                        <div class="pam-cancellation-body">
                            <div class="pam-project-guidance is-alta">
                                <i class="fas fa-circle-info" aria-hidden="true"></i>
                                @if (hallazgo.EsCancelacion)
                                {
                                    <span>La clave no existe en la cartera vigente. Elija si debe conservarse como antecedente cancelado, vincularse a un proyecto existente o descartarse.</span>
                                }
                                else
                                {
                                    <span>La fila no generó una propuesta automática. Elija si debe registrarse como alta real, vincularse a un proyecto existente o descartarse.</span>
                                }
                            </div>
                            <div class="pam-alta-source">
                                <span><i class="fas fa-file-lines" aria-hidden="true"></i>@(hallazgo.FuenteDocumento ?? "Fuente no indicada")</span>
                                <span><i class="fas fa-location-dot" aria-hidden="true"></i>@(hallazgo.UbicacionFuente ?? "sin ubicación")</span>
                            </div>
                            <form asp-action="GuardarDecisionHallazgo" asp-route-loteId="@Model.Lote.LoteId" method="post" class="pam-decision-form" data-decision-form>
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="HallazgoId" value="@hallazgo.HallazgoId" />
                                <input type="hidden" name="RevisionId" value="@hallazgo.RevisionId" />
                                <input type="hidden" name="VersionDecision" value="@hallazgo.VersionDecision" />
                                <input type="hidden" name="PaginaRetorno" value="@Model.Filtro.Pagina" />
                                <input type="hidden" name="CategoriaRetorno" value="@Model.Filtro.Categoria" />
                                <input type="hidden" name="BusquedaRetorno" value="@Model.Filtro.Busqueda" />
                                <input type="hidden" name="TipoRetorno" value="@Model.Filtro.Tipo" />
                                <input type="hidden" name="EstadoRevisionRetorno" value="@Model.Filtro.EstadoRevision" />

                                <fieldset class="pam-decision-options">
                                    <legend>¿Cómo debe tratarse este hallazgo?</legend>
                                    @if (hallazgo.EsCancelacion)
                                    {
                                        <label><input type="radio" name="Clasificacion" value="Alta real" required data-related-toggle /><span><strong>Registrar antecedente cancelado</strong><small>Crea la ficha histórica como cancelada; no será un proyecto vigente.</small></span></label>
                                        <label><input type="radio" name="Clasificacion" value="Vincular existente" data-related-toggle /><span><strong>Cancelar proyecto existente</strong><small>Vincula esta clave con un proyecto vigente y prepara su cancelación.</small></span></label>
                                        <label><input type="radio" name="Clasificacion" value="Descartar" data-related-toggle /><span><strong>Descartar reporte</strong><small>Conserva la traza, pero no prepara ningún cambio a la cartera.</small></span></label>
                                    }
                                    else
                                    {
                                        <label><input type="radio" name="Clasificacion" value="Alta real" required data-related-toggle /><span><strong>Registrar como alta real</strong><small>Crea un proyecto nuevo con los datos recibidos.</small></span></label>
                                        <label><input type="radio" name="Clasificacion" value="Vincular existente" data-related-toggle /><span><strong>Vincular existente</strong><small>Relaciona la fila con un proyecto vigente de la cartera.</small></span></label>
                                        <label><input type="radio" name="Clasificacion" value="Descartar" data-related-toggle /><span><strong>Descartar hallazgo</strong><small>Conserva la traza, pero no prepara ningún cambio.</small></span></label>
                                    }
                                </fieldset>

                                <div class="pam-related-field" data-related-field hidden>
                                    <label for="pam-cancel-related-@hallazgo.HallazgoId">@(hallazgo.EsCancelacion ? "Proyecto vigente que se cancelará" : "Proyecto vigente relacionado")</label>
                                    <select id="pam-cancel-related-@hallazgo.HallazgoId" name="ProyectoRelacionadoId" class="form-select" data-related-select disabled>
                                        <option value="">Seleccione un proyecto…</option>
                                        @foreach (var opcion in Model.ProyectosVigentes)
                                        {
                                            <option value="@opcion.ProyectoId">@(ResumirClaves(opcion.ClaveProyecto)) — @opcion.NombreProyecto</option>
                                        }
                                    </select>
                                    <small>@(hallazgo.EsCancelacion ? "Revise clave y nombre antes de confirmar. Si no existe, use “Registrar antecedente cancelado”." : "Revise clave y nombre antes de confirmar. Si no existe, use “Registrar como alta real”.")</small>
                                </div>

                                <div class="pam-decision-note">
                                    <label for="pam-cancel-note-@hallazgo.HallazgoId">Nota de revisión <span>opcional</span></label>
                                    <textarea id="pam-cancel-note-@hallazgo.HallazgoId" name="Nota" class="form-control" rows="2" maxlength="1000" placeholder="Explique brevemente el criterio usado"></textarea>
                                </div>

                                <div class="pam-decision-actions">
                                    <p><i class="fas fa-lock" aria-hidden="true"></i>Esta decisión sólo prepara la aplicación; todavía no modifica la cartera.</p>
                                    <button type="submit" class="btn btn-primary"><i class="fas fa-floppy-disk me-2" aria-hidden="true"></i>Guardar decisión</button>
                                </div>
                            </form>
                        </div>
                    </details>
                }
            </div>
        }

        @if (hallazgosAtendidos.Count > 0)
        {
            <details class="pam-reviewed-findings">
                <summary><i class="fas fa-circle-check" aria-hidden="true"></i>Ver hallazgos atendidos (@hallazgosAtendidos.Count)</summary>
                <div class="pam-finding-list">
                    @foreach (var hallazgo in hallazgosAtendidos)
                    {
                        <article class="is-reviewed">
                            <div>
                                <span class="pam-finding-classification">Revisada · @hallazgo.ClasificacionPreliminar</span>
                                <code>@(hallazgo.ClaveRecibida ?? "Sin clave")</code>
                                <strong>@(hallazgo.NombreRecibido ?? "Nombre no extraído")</strong>
                            </div>
                            <div>
                                <span>@(hallazgo.ProyectoRelacionadoId.HasValue
                                    ? $"Vinculada con {ResumirClaves(hallazgo.ProyectoRelacionadoClave)} — {hallazgo.ProyectoRelacionadoNombre}"
                                    : hallazgo.ClasificacionPreliminar == "Alta real"
                                        ? (hallazgo.EsCancelacion ? "Preparada como antecedente cancelado." : "Preparada como alta nueva.")
                                        : "No se aplicará a la cartera.")</span>
                                <small>@(hallazgo.FuenteDocumento ?? "Fuente no indicada") · @(hallazgo.UbicacionFuente ?? "sin ubicación")</small>
                            </div>
                            <form asp-action="ReabrirDecisionPreliminar" asp-route-loteId="@Model.Lote.LoteId" method="post" data-reopen-form>
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="RevisionId" value="@hallazgo.RevisionId" />
                                <input type="hidden" name="VersionDecision" value="@hallazgo.VersionDecision" />
                                <input type="hidden" name="PaginaRetorno" value="@Model.Filtro.Pagina" />
                                <input type="hidden" name="CategoriaRetorno" value="@Model.Filtro.Categoria" />
                                <input type="hidden" name="BusquedaRetorno" value="@Model.Filtro.Busqueda" />
                                <input type="hidden" name="TipoRetorno" value="@Model.Filtro.Tipo" />
                                <button type="submit" class="btn btn-sm btn-outline-secondary"><i class="fas fa-rotate-left me-1" aria-hidden="true"></i>Reabrir</button>
                            </form>
                        </article>
                    }
                </div>
            </details>
        }
    </section>

    <div class="pam-no-apply-note">
        <i class="fas fa-lock"></i>
        <span><strong>Vista de análisis.</strong> Los resultados son propuestas y todavía no modifican la cartera PAM/PAMRNT.</span>
    </div>
</div>

<style>
    .pam-analysis-page{--pa-guinda:var(--shell-accent,#9b2247);--pa-guinda-dark:#721633;--pa-gold:var(--shell-accent-2,#b38e5d);--pa-ink:var(--shell-ink,#302b28);--pa-muted:var(--shell-muted,#746d68);--pa-surface:var(--shell-surface,#fff);--pa-surface-2:var(--shell-surface-2,#f7f4f1);--pa-line:var(--shell-line,#eadfe3);display:grid;gap:1rem;color:var(--pa-ink)}
    .pam-analysis-nav{display:flex;align-items:center;justify-content:space-between;gap:1rem}.pam-analysis-nav__actions{display:flex;align-items:center;justify-content:flex-end;gap:.5rem;flex-wrap:wrap}.pam-dashboard-link{color:var(--pa-guinda);font-weight:700;text-decoration:none}
    .pam-analysis-alert{display:flex;align-items:center;gap:.7rem;margin:0;border:0;border-left:4px solid;border-radius:.7rem}.pam-analysis-alert.is-success{border-color:#318251;background:#e9f5ed;color:#24623e}.pam-analysis-alert.is-error{border-color:#a34135;background:#f8eae8;color:#7d3028}
    .pam-analysis-hero{display:flex;align-items:stretch;justify-content:space-between;gap:1.5rem;padding:1.6rem;border:1px solid var(--pa-line);border-left:4px solid var(--pa-gold);border-radius:14px;background:var(--pa-surface)}
