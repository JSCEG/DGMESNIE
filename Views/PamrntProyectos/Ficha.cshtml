                    <div class="pam-risk-grid">
                        @foreach (var riesgo in Model.Ficha.Riesgos)
                        {
                            <article>
                                <i class="fas fa-triangle-exclamation"></i>
                                <h3>@riesgo.Riesgo</h3>
                                <p>@riesgo.Impacto</p>
                                <div><strong>Mitigación</strong><span>@riesgo.Mitigacion</span></div>
                            </article>
                        }
                    </div>
                </div>
                <div class="pam-lamina-foot">
                    <span>PAMRNT 2026–2040 · diagnóstico operativo y alternativas de solución.</span>
                    <span class="pam-lamina-foot__meta">
                        <button type="button" class="pam-home" data-goto="1" title="Volver al índice"><svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M3 11.5 12 4l9 7.5"></path><path d="M5.5 10v9h13v-9"></path></svg></button>
                        08
                    </span>
                </div>
            </section>

            @* ── 09 · Alternativas ── *@
            <section class="pam-slide pam-slide--content" data-slide data-label="Alternativas" data-screen-label="09">
                <header class="pam-lamina-head">
                    <span class="pam-lamina-head__kicker">@seccion01</span>
                    <span class="pam-lamina-head__aside">Alternativas de solución</span>
                </header>
                <h2 class="pam-lamina-title">Opciones técnicas registradas para el alcance del proyecto.</h2>
