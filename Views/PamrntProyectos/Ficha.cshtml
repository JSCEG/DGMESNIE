@model NSIE.Models.PamrntFichaProyectoViewModel

@{
    ViewData["Title"] = $"Ficha ejecutiva {Model.Ficha.ClavePem}";
    var detalle = Model.Detalle?.Actual;
    var panorama = Model.ContextoCartera.Take(8).ToList();
    var alternativa1 = Model.Ficha.Alternativas.FirstOrDefault(x => x.Recomendada) ?? Model.Ficha.Alternativas.FirstOrDefault();
    var fechaCorte = detalle?.FechaCorte ?? Model.Proyecto.FechaCorte ?? DateTime.Today;
    var fuentes = Model.Detalle?.Fuentes?.Count ?? 0;
    var versiones = Model.Detalle?.Historial?.Count ?? 0;
    var cambios = Model.Detalle?.Cambios?.Count ?? 0;
    var recursosVisuales = Model.Diagramas.ToList();
    var bcTexto = Model.Ficha.RelacionBeneficioCosto > 0 ? Model.Ficha.RelacionBeneficioCosto.ToString("N2") : "En integración";
    var beneficioTexto = Model.Ficha.BeneficioNetoUsdMiles.HasValue ? $"{Model.Ficha.BeneficioNetoUsdMiles:N0} miles USD" : "En integración";
    var crecimientoTexto = Model.Ficha.CrecimientoDemandaPorcentaje.HasValue ? $"{Model.Ficha.CrecimientoDemandaPorcentaje:N2}%" : "En integración";
    var tipoProyecto = string.IsNullOrWhiteSpace(Model.Proyecto.TipoProyecto) ? Model.Ficha.TipoFicha : Model.Proyecto.TipoProyecto;
    var regionProyecto = string.IsNullOrWhiteSpace(Model.Proyecto.Gcr) ? "Región por definir" : Model.Proyecto.Gcr;
    var historialVersiones = (Model.Detalle?.Historial ?? new List<NSIE.Models.PamProyectoVersionResumen>())
        .OrderBy(x => x.NumeroVersion)
        .TakeLast(12)
        .ToList();
    var historialCambios = (Model.Detalle?.Cambios ?? new List<NSIE.Models.PamCambioDetalle>())
        .OrderByDescending(x => x.FechaRegistroUtc)
        .Take(12)
        .ToList();
    var archivoBase = $"Ficha_{Model.Ficha.ClavePem}_{DateTime.Now:yyyyMMdd}";
    var seccion01 = $"Sección 01 · {Model.Ficha.ClavePem}";
    var seccion02 = "Sección 02 · Cierre y trazabilidad";
    var inv = System.Globalization.CultureInfo.InvariantCulture;
    var esMX = System.Globalization.CultureInfo.GetCultureInfo("es-MX");

    // ── Datos para gráficos ECharts (dona de cartera y anillo B/C) ──
    var datosDona = panorama
        .Where(p => (p.InversionMdp ?? 0) > 0)
        .Select(p => new
        {
            clave = p.ClavePem,
            valor = Math.Round(p.InversionMdp ?? 0, 3),
            activo = string.Equals(p.ClavePem, Model.Ficha.ClavePem, StringComparison.OrdinalIgnoreCase)
        })
        .ToList();
    var totalCartera = datosDona.Sum(d => d.valor);
    var inversionActiva = datosDona.Where(d => d.activo).Sum(d => d.valor);
    var pctCartera = totalCartera > 0 ? 100m * inversionActiva / totalCartera : 0;
    var jsonDona = System.Text.Json.JsonSerializer.Serialize(datosDona);
    // Cuando la ficha es de un proyecto PAM que no está entre los 8 identificados,
    // la dona se muestra como referencia de cartera (sin porcentaje del proyecto).
    var proyectoEnDona = datosDona.Any(d => d.activo);
    var donaCentroValor = proyectoEnDona ? $"{pctCartera.ToString("N1", inv)}%" : totalCartera.ToString("N0", inv);
    var donaCentroEtiqueta = proyectoEnDona ? "de la cartera" : "MDP · 8 proyectos";

    // ── Barra de tiempo hacia la fecha necesaria (parsea "abril de 2031") ──
    DateTime? fechaNecesariaFecha = null;
    var fnTexto = (Model.Ficha.FechaNecesaria ?? string.Empty).ToLowerInvariant();
    var mesesNombre = new Dictionary<string, int>
    {
        ["enero"] = 1, ["febrero"] = 2, ["marzo"] = 3, ["abril"] = 4, ["mayo"] = 5, ["junio"] = 6,
        ["julio"] = 7, ["agosto"] = 8, ["septiembre"] = 9, ["octubre"] = 10, ["noviembre"] = 11, ["diciembre"] = 12
    };
    foreach (var mes in mesesNombre)
    {
        if (!fnTexto.Contains(mes.Key)) continue;
        var anio = System.Text.RegularExpressions.Regex.Match(fnTexto, @"20\d{2}");
        if (anio.Success) fechaNecesariaFecha = new DateTime(int.Parse(anio.Value), mes.Value, 1);
        break;
    }
    var inicioPrograma = new DateTime(2026, 1, 1);
    double? pctTiempo = null;
    int? mesesRestantes = null;
    if (fechaNecesariaFecha.HasValue && fechaNecesariaFecha.Value > inicioPrograma)
    {
        var totalDias = (fechaNecesariaFecha.Value - inicioPrograma).TotalDays;
        var transcurrido = (DateTime.Today - inicioPrograma).TotalDays;
        pctTiempo = Math.Clamp(transcurrido / totalDias * 100.0, 0.0, 100.0);
        mesesRestantes = Math.Max(0, (int)Math.Round((fechaNecesariaFecha.Value - DateTime.Today).TotalDays / 30.44));
    }

    // ── Proyección de demanda real para el gráfico ECharts ──
    // Parte de la demanda máxima observada y la tasa de crecimiento del proyecto;
    // proyecta año a año y cruza la capacidad en el año de la fecha necesaria.
    double? demandaBase = null;
    var demMatch = System.Text.RegularExpressions.Regex.Match(Model.Ficha.DemandaMaxima ?? string.Empty, @"[\d][\d,\.]*");
    if (demMatch.Success && double.TryParse(demMatch.Value.Replace(",", ""), System.Globalization.NumberStyles.Any, inv, out var db) && db > 0)
        demandaBase = db;
    var tasaCrecimiento = (double)(Model.Ficha.CrecimientoDemandaPorcentaje ?? 0) / 100.0;
    const int anioBaseDemanda = 2025;
    const int anioFinDemanda = 2040;
    var anioNecesaria = fechaNecesariaFecha?.Year;
    var hayGraficoDemanda = demandaBase.HasValue && tasaCrecimiento > 0;
    var serieDemanda = new List<object[]>();
    double? capacidadLimite = null;
    if (hayGraficoDemanda)
    {
        for (var a = anioBaseDemanda; a <= anioFinDemanda; a++)
            serieDemanda.Add(new object[] { a, Math.Round(demandaBase.Value * Math.Pow(1 + tasaCrecimiento, a - anioBaseDemanda)) });
        var anioCruce = anioNecesaria is >= anioBaseDemanda and <= anioFinDemanda ? anioNecesaria.Value : anioBaseDemanda + 6;
        capacidadLimite = Math.Round(demandaBase.Value * Math.Pow(1 + tasaCrecimiento, anioCruce - anioBaseDemanda));
    }
    var jsonDemanda = System.Text.Json.JsonSerializer.Serialize(new
    {
        serie = serieDemanda,
        limite = capacidadLimite,
        anioNecesaria,
        unidad = "MWh/h",
        etiquetaNecesaria = $"Fecha necesaria · {Model.Ficha.FechaNecesaria}"
    });
}

<link rel="preconnect" href="https://fonts.googleapis.com" />
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
<link href="https://fonts.googleapis.com/css2?family=IBM+Plex+Mono:wght@500;600;700&display=swap" rel="stylesheet" />
<link rel="stylesheet" href="~/css/pam-ficha-presentacion.css" asp-append-version="true" />

<main class="pam-ficha-page" data-filename="@archivoBase" data-project-key="@Model.Ficha.ClavePem">
    <div class="pam-ficha-toolbar" aria-label="Acciones de la ficha">
        <a asp-action="Index" class="pam-ficha-toolbar__back">
            <i class="fas fa-arrow-left" aria-hidden="true"></i><span>Proyectos identificados</span>
        </a>
        <div class="pam-ficha-toolbar__title">
            <strong>@Model.Ficha.ClavePem</strong><span>Ficha ejecutiva navegable</span>
        </div>
        <div class="pam-ficha-toolbar__actions">
            <button type="button" data-export="pdf" title="Descargar ficha en PDF"><i class="fas fa-file-pdf"></i><span>PDF</span></button>
            <button type="button" data-export="pptx" title="Descargar ficha en PowerPoint"><i class="fas fa-file-powerpoint"></i><span>PPT</span></button>
            <button type="button" data-fullscreen title="Presentar en pantalla completa"><i class="fas fa-expand"></i><span>Presentar</span></button>
        </div>
    </div>

    <div id="pam-deck-shell" class="pam-deck-shell">
        <div id="pam-deck" class="pam-deck" aria-live="polite">

            @* ── 01 · Portada (patrón insumo: logos, eyebrow, H1 Patria, clave + regla dorada, banda fotográfica guinda, meta) ── *@
            <section class="pam-slide pam-slide--cover is-active" data-slide data-label="Portada" data-screen-label="01">
                <div class="pam-cover__logos">
                    <img src="~/img/pamrnt/logo_gob.png" alt="Gobierno de México" />
                    <i></i>
                    <img src="~/img/pamrnt/logo_sener.png" alt="Secretaría de Energía" />
                </div>
                <div class="pam-cover__head">
                    <div class="pam-cover__eyebrow">Subsecretaría de Planeación y Transición Energética</div>
                    <h1>Proyectos identificados de ampliación de la RNT</h1>
                    <div class="pam-cover__row">
                        <div class="pam-cover__clave">@Model.Ficha.ClavePem</div>
                        <span class="pam-cover__dash"></span>
                        <p>@Model.Ficha.Titulo</p>
                    </div>
                    @if (!string.IsNullOrWhiteSpace(Model.Proyecto.EstatusLicitacion))
                    {
                        <div class="pam-cover__estatus @NSIE.Models.PamSemaforo.Clase(Model.Proyecto.EstatusLicitacion)">
                            <i aria-hidden="true"></i>Estatus de licitación: @Model.Proyecto.EstatusLicitacion
                        </div>
                    }
                </div>
                <div class="pam-cover__photo">
                    <img src="~/img/pamrnt/reno_portada.png" alt="" aria-hidden="true" />
                    <i class="pam-cover__goldline"></i>
                    <i class="pam-cover__shade"></i>
                </div>
                <div class="pam-cover__meta">
                    <div><span>Versión</span><strong>@(detalle?.NumeroVersion ?? 1).0</strong></div>
                    <div><span>Corte</span><strong>@fechaCorte.ToString("dd 'de' MMMM 'de' yyyy")</strong></div>
                    <div><span>Prioridad</span><strong>@(Model.Proyecto.Prioridad?.ToString() ?? "—") · @regionProyecto</strong></div>
                    <div><span>Fuente</span><strong>PAMRNT 2026–2040</strong></div>
                </div>
            </section>

            @* ── 02 · Índice navegable (patrón insumo: grupos numerados + líderes punteados + folio mono) ── *@
            <section class="pam-slide pam-slide--content pam-slide--index" data-slide data-label="Índice" data-screen-label="02">
                <header class="pam-lamina-head">
                    <span class="pam-lamina-head__kicker">
                        <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" aria-hidden="true"><line x1="8" y1="6" x2="21" y2="6"></line><line x1="8" y1="12" x2="21" y2="12"></line><line x1="8" y1="18" x2="21" y2="18"></line><line x1="3" y1="6" x2="3.01" y2="6"></line><line x1="3" y1="12" x2="3.01" y2="12"></line><line x1="3" y1="18" x2="3.01" y2="18"></line></svg>
                        Contenido
                    </span>
                    <span class="pam-lamina-head__aside">Índice navegable</span>
                </header>
                <h2 class="pam-lamina-title is-guinda">Índice</h2>
                <div class="pam-lamina-body pam-index">
                    <button type="button" class="pam-index__group" data-goto="2"><b>01</b><span>El proyecto</span></button>
                    <button type="button" class="pam-index__entry" data-goto="3"><span>Decisión ejecutiva</span><i></i><small>04</small></button>
                    <button type="button" class="pam-index__entry" data-goto="4"><span>Panorama del PAMRNT 2026–2040</span><i></i><small>05</small></button>
                    <button type="button" class="pam-index__entry" data-goto="5"><span>Diagnóstico operativo</span><i></i><small>06</small></button>
                    <button type="button" class="pam-index__entry" data-goto="6"><span>Pronóstico e impacto regional</span><i></i><small>07</small></button>
                    <button type="button" class="pam-index__entry" data-goto="7"><span>Riesgos y dependencias</span><i></i><small>08</small></button>
                    <button type="button" class="pam-index__entry" data-goto="8"><span>Alternativas de solución</span><i></i><small>09</small></button>
                    <button type="button" class="pam-index__entry" data-goto="9"><span>Comparativa de confiabilidad</span><i></i><small>10</small></button>
                    <button type="button" class="pam-index__entry" data-goto="10"><span>Evaluación económica</span><i></i><small>11</small></button>
                    <button type="button" class="pam-index__entry" data-goto="11"><span>Diagramas y geoespacial</span><i></i><small>12</small></button>
                    <button type="button" class="pam-index__entry" data-goto="12"><span>Fases y licitación</span><i></i><small>13</small></button>
                    <button type="button" class="pam-index__group" data-goto="13"><b>02</b><span>Cierre y trazabilidad</span></button>
                    <button type="button" class="pam-index__entry" data-goto="14"><span>Conclusión ejecutiva</span><i></i><small>15</small></button>
                    <button type="button" class="pam-index__entry" data-goto="15"><span>Trazabilidad metodológica</span><i></i><small>16</small></button>
                    <button type="button" class="pam-index__group" data-goto="16"><b>03</b><span>Anexos</span></button>
                    <button type="button" class="pam-index__entry" data-goto="17"><span>Historial de versiones</span><i></i><small>18</small></button>
                    <button type="button" class="pam-index__entry" data-goto="18"><span>Línea de tiempo de modificaciones</span><i></i><small>19</small></button>
                </div>
                <div class="pam-lamina-foot">
                    <span>Documento en dos secciones y un cierre de referencia. En pantalla, cada entrada salta a su lámina.</span>
                    <span class="pam-lamina-foot__meta">02</span>
                </div>
            </section>

            @* ── 03 · Divisoria Sección 01 (patrón insumo: barra guinda, número gigante, kicker con punto, Patria, regla dorada) ── *@
            <section class="pam-slide pam-slide--divider" data-slide data-label="Sección 01" data-screen-label="03">
                <i class="pam-divider__bar" aria-hidden="true"></i>
                <div class="pam-divider__logos">
                    <img src="~/img/pamrnt/logo_gob.png" alt="Gobierno de México" />
                    <i></i>
                    <img src="~/img/pamrnt/logo_sener.png" alt="Secretaría de Energía" />
                </div>
                <button type="button" class="pam-home pam-divider__home" data-goto="1" title="Volver al índice">
                    <svg width="21" height="21" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M3 11.5 12 4l9 7.5"></path><path d="M5.5 10v9h13v-9"></path></svg>
                </button>
                <div class="pam-divider__big" aria-hidden="true">01</div>
                <div class="pam-divider__kicker"><span></span>Sección 01 · @tipoProyecto</div>
                <h1>@Model.Ficha.ClavePem</h1>
                <div class="pam-divider__sub">
                    <i></i>
                    <p>@Model.Ficha.Titulo · @regionProyecto</p>
                </div>
            </section>

            @* ── 04 · Decisión ejecutiva ── *@
            <section class="pam-slide pam-slide--content" data-slide data-label="Decisión ejecutiva" data-screen-label="04">
                <header class="pam-lamina-head">
                    <span class="pam-lamina-head__kicker">@seccion01</span>
                    <span class="pam-lamina-head__aside">Decisión ejecutiva</span>
                </header>
                <h2 class="pam-lamina-title">Proyecto recomendado: @Model.Ficha.AlternativaSeleccionada.</h2>
                <div class="pam-lamina-body">
                    <p class="pam-lead">@Model.Ficha.ResumenEjecutivo</p>
                    <div class="pam-metrics pam-metrics--four">
                        <article><span>Inversión</span><strong>@Model.Ficha.InversionMdp.ToString("N3")</strong><small>MDP 2025</small></article>
                        <article><span>Fecha necesaria</span><strong>@Model.Ficha.FechaNecesaria</strong><small>necesaria y factible</small></article>
                        <article><span>Beneficio / Costo</span><strong>@bcTexto</strong><small>pesos por peso invertido</small></article>
                        <article><span>Obras</span><strong>@Model.Ficha.TotalObras</strong><small>componentes asociados</small></article>
                    </div>
                    <div class="pam-decision-strip"><strong>Recomendación</strong><span>@Model.Ficha.RecomendacionEjecutiva</span></div>
                    @if (pctTiempo.HasValue)
                    {
                        <div class="pam-timebar">
                            <div class="pam-timebar__head">
                                <span>Ruta a la fecha necesaria</span>
                                <strong>@Model.Ficha.FechaNecesaria · @mesesRestantes meses restantes</strong>
                            </div>
                            <div class="pam-timebar__track"><i style="width:@pctTiempo.Value.ToString("F1", inv)%"></i></div>
                            <div class="pam-timebar__scale">
                                <span>Inicio del ejercicio · 2026</span>
                                <span>@pctTiempo.Value.ToString("N0")% del plazo transcurrido</span>
                                <span>@Model.Ficha.FechaNecesaria</span>
                            </div>
                        </div>
                    }
                </div>
                <div class="pam-lamina-foot">
                    <span>@Model.Ficha.Fuente</span>
                    <span class="pam-lamina-foot__meta">
                        <button type="button" class="pam-home" data-goto="1" title="Volver al índice"><svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M3 11.5 12 4l9 7.5"></path><path d="M5.5 10v9h13v-9"></path></svg></button>
                        04
                    </span>
                </div>
            </section>

            @* ── 05 · Panorama ── *@
            <section class="pam-slide pam-slide--content" data-slide data-label="Panorama" data-screen-label="05">
                <header class="pam-lamina-head">
                    <span class="pam-lamina-head__kicker">@seccion01</span>
                    <span class="pam-lamina-head__aside">Panorama PAMRNT 2026–2040</span>
                </header>
                <h2 class="pam-lamina-title">Ocho proyectos identificados de ampliación de la RNT.</h2>
                <div class="pam-lamina-body pam-panorama">
                    <table class="pam-table pam-table--portfolio">
                        <thead>
                            <tr><th>Prioridad</th><th>Clave</th><th>Proyecto</th><th>Región</th><th>Inversión MDP</th></tr>
                        </thead>
                        <tbody>
                            @foreach (var item in panorama)
                            {
                                <tr class="@(string.Equals(item.ClavePem, Model.Ficha.ClavePem, StringComparison.OrdinalIgnoreCase) ? "is-highlighted" : null)">
                                    <td>@item.Prioridad</td>
                                    <td>@item.ClavePem</td>
                                    <td>@item.Proyecto</td>
                                    <td>@item.Gcr</td>
                                    <td>@(item.InversionMdp?.ToString("N3") ?? "—")</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                    <aside class="pam-panorama__aside">
                        <div class="pam-chart-caption">Peso en la inversión de la cartera</div>
                        <div id="pam-chart-dona" class="pam-chart-dona"></div>
                        @if (proyectoEnDona)
                        {
                            <p class="pam-chart-note"><strong>@Model.Ficha.ClavePem</strong> representa el <strong>@pctCartera.ToString("N1")%</strong> de los @totalCartera.ToString("N3") MDP de los ocho proyectos identificados.</p>
                        }
                        else
                        {
                            <p class="pam-chart-note"><strong>@Model.Ficha.ClavePem</strong> pertenece a la cartera PAM; la dona muestra, como referencia, los ocho proyectos identificados del PAMRNT 2026–2040.</p>
                        }
                    </aside>
                </div>
                <div class="pam-lamina-foot">
                    <span>Fuente SQL: repositorio histórico PAM/PAMRNT · corte @fechaCorte.ToString("yyyy-MM-dd"). Cuadro 8.4.3 del PAMRNT 2026–2040.</span>
                    <span class="pam-lamina-foot__meta">
                        <button type="button" class="pam-home" data-goto="1" title="Volver al índice"><svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M3 11.5 12 4l9 7.5"></path><path d="M5.5 10v9h13v-9"></path></svg></button>
                        05
                    </span>
                </div>
            </section>

            @* ── 06 · Diagnóstico operativo ── *@
            <section class="pam-slide pam-slide--content" data-slide data-label="El problema" data-screen-label="06">
                <header class="pam-lamina-head">
                    <span class="pam-lamina-head__kicker">@seccion01</span>
                    <span class="pam-lamina-head__aside">Diagnóstico operativo</span>
                </header>
                <h2 class="pam-lamina-title">Problema y ámbito: @Model.Ficha.CorredorPrincipal.</h2>
                <div class="pam-lamina-body pam-problem">
                    <div class="pam-problem__layout">
                        <div class="pam-problem__corridor" aria-label="Ámbito del proyecto">
                            <div class="pam-corridor-line"></div>
                            @for (var i = 0; i < Math.Min(5, Model.Ficha.Estados.Count); i++)
                            {
                                <span style="--i:@i">@Model.Ficha.Estados[i]</span>
                            }
                        </div>
                        <div>
                            <p class="pam-lead">@Model.Ficha.DiagnosticoOperativo</p>
                            <div class="pam-alert-card"><strong>Fecha necesaria</strong><span>@Model.Ficha.FechaNecesaria</span></div>
                        </div>
                    </div>
                </div>
                <div class="pam-lamina-foot">
                    <span>PAMRNT 2026–2040 · Ficha @Model.Ficha.ClavePem, diagnóstico operativo.</span>
                    <span class="pam-lamina-foot__meta">
                        <button type="button" class="pam-home" data-goto="1" title="Volver al índice"><svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M3 11.5 12 4l9 7.5"></path><path d="M5.5 10v9h13v-9"></path></svg></button>
                        06
                    </span>
                </div>
            </section>

            @* ── 07 · Pronóstico ── *@
            <section class="pam-slide pam-slide--content" data-slide data-label="Pronóstico" data-screen-label="07">
                <header class="pam-lamina-head">
                    <span class="pam-lamina-head__kicker">@seccion01</span>
                    <span class="pam-lamina-head__aside">Pronóstico e impacto regional</span>
                </header>
                <h2 class="pam-lamina-title">La demanda crece y el proyecto refuerza la capacidad de su región.</h2>
                <div class="pam-lamina-body">
                    <div class="pam-forecast">
                        <div class="pam-forecast__chart">
                            @if (hayGraficoDemanda)
                            {
                                <div id="pam-chart-demanda" class="pam-chart-demanda"></div>
                            }
                            else
                            {
                                <div class="pam-forecast__sindatos">
                                    <i class="fas fa-chart-line" aria-hidden="true"></i>
                                    <strong>Pronóstico de demanda en integración</strong>
                                    <span>La curva se generará automáticamente al registrar la demanda máxima observada y la tasa de crecimiento del proyecto.</span>
                                </div>
                            }
                        </div>
                        <div class="pam-forecast__facts">
                            <article><strong>@crecimientoTexto</strong><span>crecimiento medio anual a 2030</span></article>
                            <article><strong>@Model.Ficha.DemandaMaxima</strong><span>demanda máxima observada</span></article>
                            <p>@Model.Ficha.PronosticoDemanda</p>
                        </div>
                    </div>
                    @if (Model.ImpactoRegional?.TieneDatos == true)
                    {
                        var ir = Model.ImpactoRegional;
                        <div class="pam-impacto">
                            <div class="pam-impacto__titulo">Contribución del proyecto en la GCR @ir.Region · @ir.TotalProyectos proyectos vigentes</div>
                            <div class="pam-impacto__barras">
                                <div class="pam-impacto__barra">
                                    <span>Inversión</span>
                                    <div class="pam-impacto__track"><i style="width:@(Math.Clamp(ir.PorcentajeInversion, 0, 100).ToString("F1", inv))%"></i></div>
                                    <strong>@ir.PorcentajeInversion.ToString("N1")%</strong>
                                    <small>@ir.InversionProyecto.ToString("N0") de @ir.InversionRegion.ToString("N0") MDP</small>
                                </div>
                                <div class="pam-impacto__barra">
                                    <span>Transmisión</span>
                                    <div class="pam-impacto__track"><i style="width:@(Math.Clamp(ir.PorcentajeKmC, 0, 100).ToString("F1", inv))%"></i></div>
                                    <strong>@ir.PorcentajeKmC.ToString("N1")%</strong>
                                    <small>@((ir.KmCProyecto ?? 0).ToString("N1")) de @ir.KmCRegion.ToString("N1") km-C</small>
                                </div>
                                <div class="pam-impacto__barra">
                                    <span>Transformación</span>
                                    <div class="pam-impacto__track"><i style="width:@(Math.Clamp(ir.PorcentajeMva, 0, 100).ToString("F1", inv))%"></i></div>
                                    <strong>@ir.PorcentajeMva.ToString("N1")%</strong>
                                    <small>@((ir.MvaProyecto ?? 0).ToString("N0")) de @ir.MvaRegion.ToString("N0") MVA</small>
                                </div>
                            </div>
                        </div>
                    }
                </div>
                <div class="pam-lamina-foot">
                    <span>PAMRNT 2026–2040 · escenario de Planeación · agregados de la GCR desde la cartera vigente.</span>
                    <span class="pam-lamina-foot__meta">
                        <button type="button" class="pam-home" data-goto="1" title="Volver al índice"><svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M3 11.5 12 4l9 7.5"></path><path d="M5.5 10v9h13v-9"></path></svg></button>
                        07
                    </span>
                </div>
            </section>

            @* ── 08 · Riesgos ── *@
            <section class="pam-slide pam-slide--content" data-slide data-label="Riesgos y dependencias" data-screen-label="08">
                <header class="pam-lamina-head">
                    <span class="pam-lamina-head__kicker">@seccion01</span>
                    <span class="pam-lamina-head__aside">Riesgos y dependencias</span>
                </header>
                <h2 class="pam-lamina-title">Qué puede fallar, cuál es su impacto y cómo mitigarlo.</h2>
