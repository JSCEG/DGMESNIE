                                <div>@alternativa.Ventaja</div>
                            </article>
                        }
                    </div>
                </div>
                <div class="pam-lamina-foot">
                    <span>PAMRNT 2026–2040 · Ficha @Model.Ficha.ClavePem, alternativas de solución.</span>
                    <span class="pam-lamina-foot__meta">
                        <button type="button" class="pam-home" data-goto="1" title="Volver al índice"><svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M3 11.5 12 4l9 7.5"></path><path d="M5.5 10v9h13v-9"></path></svg></button>
                        09
                    </span>
                </div>
            </section>

            @* ── 10 · Comparativa ── *@
            <section class="pam-slide pam-slide--content" data-slide data-label="Comparativa" data-screen-label="10">
