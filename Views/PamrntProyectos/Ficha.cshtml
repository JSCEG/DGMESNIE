@model NSIE.Models.PamrntFichaProyectoViewModel

@{
    ViewData["Title"] = $"Ficha ejecutiva {Model.Ficha.ClavePem}";
    var detalle = Model.Detalle?.Actual;
    var panorama = Model.Panorama.Take(8).ToList();
    var panoramaTitulo = Model.EsPamrntIdentificado
        ? "Ocho proyectos identificados de ampliación de la RNT."
        : $"Proyectos vigentes de la GCR {(string.IsNullOrWhiteSpace(Model.Proyecto.Gcr) ? "de la región" : Model.Proyecto.Gcr)}.";
    var panoramaKicker = Model.EsPamrntIdentificado ? "Panorama PAMRNT 2026–2040" : "Contexto regional de cartera";
    var panoramaFuente = Model.EsPamrntIdentificado
        ? "Cuadro 8.4.3 del PAMRNT 2026–2040."
        : $"Proyectos vigentes de la misma región en la cartera PAM/PAMRNT.";
    var alternativa1 = Model.Ficha.Alternativas.FirstOrDefault(x => x.Recomendada) ?? Model.Ficha.Alternativas.FirstOrDefault();
    var esMX = System.Globalization.CultureInfo.GetCultureInfo("es-MX");
    var fechaCorte = detalle?.FechaCorte ?? Model.Proyecto.FechaCorte ?? DateTime.Today;
    var fuentes = Model.Detalle?.Fuentes?.Count ?? 0;
    var versiones = Model.Detalle?.Historial?.Count ?? 0;
    var cambios = Model.Detalle?.Cambios?.Count ?? 0;
    var recursosVisuales = Model.Diagramas.ToList();
    var bcTexto = Model.Ficha.RelacionBeneficioCosto > 0 ? Model.Ficha.RelacionBeneficioCosto.ToString("N2", esMX) : "En integración";
    var beneficioTexto = Model.Ficha.BeneficioNetoUsdMiles.HasValue ? $"USD {Model.Ficha.BeneficioNetoUsdMiles.Value.ToString("N0", esMX)} mil" : "En integración";
    var crecimientoTexto = Model.Ficha.CrecimientoDemandaPorcentaje.HasValue ? $"{Model.Ficha.CrecimientoDemandaPorcentaje.Value.ToString("N2", esMX)}%" : "En integración";
    var tipoProyecto = string.IsNullOrWhiteSpace(Model.Proyecto.TipoProyecto) ? Model.Ficha.TipoFicha : Model.Proyecto.TipoProyecto;
    var regionProyecto = string.IsNullOrWhiteSpace(Model.Proyecto.Gcr) ? "Región por definir" : Model.Proyecto.Gcr;
    var ubicacionesTerritoriales = Model.Territorial?.Ubicaciones?.ToList() ?? new List<NSIE.Models.PamTerritorialUbicacion>();
    var ubicacionesValidadas = ubicacionesTerritoriales.Where(x => x.Validada).ToList();
    var ubicacionesAnalisis = ubicacionesValidadas.Count > 0 ? ubicacionesValidadas : ubicacionesTerritoriales;
    var fichaConElementosTerritoriales = ubicacionesAnalisis.Count > 0;
    var fichaTerritorialIndividual = ubicacionesAnalisis.Count <= 12;
    var paginasMatrizTerritorial = ubicacionesAnalisis.Chunk(5).ToList();
    var historialVersiones = (Model.Detalle?.Historial ?? new List<NSIE.Models.PamProyectoVersionResumen>())
        .OrderBy(x => x.NumeroVersion)
        .TakeLast(12)
        .ToList();
    var historialCambios = (Model.Detalle?.Cambios ?? new List<NSIE.Models.PamCambioDetalle>())
        .OrderByDescending(x => x.FechaRegistroUtc)
        .ToList();
    var paginasCambios = historialCambios
        .GroupBy(c => new { c.FechaCorte, c.FuenteDocumento })
        .OrderByDescending(g => g.Key.FechaCorte)
        .SelectMany(grupo =>
        {
            var bloques = grupo.Chunk(4).ToList();
            return bloques.Select((bloque, indice) => new
            {
                grupo.Key.FechaCorte,
                grupo.Key.FuenteDocumento,
                Cambios = bloque.ToList(),
                ParteFuente = indice + 1,
                TotalPartesFuente = bloques.Count
            });
        })
        .ToList();
    var versionVigente = historialVersiones.LastOrDefault(x => x.EsVersionVigente)
        ?? historialVersiones.LastOrDefault();
    var cambiosRecientes = historialCambios.Take(5).ToList();
    var fuentesPorCampo = historialCambios
        .Where(x => !string.IsNullOrWhiteSpace(x.FuenteDocumento))
        .GroupBy(x => x.CampoEtiqueta)
        .Select(grupo => new
        {
            Campo = grupo.Key,
            Fuente = grupo.OrderByDescending(x => x.FechaRegistroUtc).First().FuenteDocumento,
            Corte = grupo.Max(x => x.FechaCorte)
        })
        .Take(6)
        .ToList();
    var relacionesVigentes = (Model.Detalle?.Relaciones ?? new List<NSIE.Models.PamRelacionDetalle>())
        .Where(x => x.EsRelacionVigente)
        .Take(4)
        .ToList();
    var pendientesValidacion = (Model.Ficha.PendientesValidacion ?? new List<string>())
        .Where(x => !string.IsNullOrWhiteSpace(x))
        .Take(4)
        .ToList();
    var expedienteOrigen = Model.ExpedientePormenorizadoOrigen;
    var archivoBase = $"Ficha_{Model.Ficha.ClavePem}_{DateTime.Now:yyyyMMdd}";
    var seccion01 = $"Sección 01 · {Model.Ficha.ClavePem}";
    var seccion02 = "Sección 02 · Cierre y trazabilidad";
    var inv = System.Globalization.CultureInfo.InvariantCulture;
    var seguimientoFicha = Model.Detalle?.SeguimientoActual ?? new List<NSIE.Models.PamSeguimientoProyectoRegistro>();
    var seguimientoCorteFicha = Model.Detalle?.SeguimientoHistorial?.FirstOrDefault();
    var seguimientoOrdenado = seguimientoFicha
        .OrderBy(x => x.NumeroFila > 0 ? x.NumeroFila : int.MaxValue)
        .ThenBy(x => x.CodigoUnico)
        .ToList();
    var seguimientoPaginas = seguimientoOrdenado.Chunk(5).ToList();
    var seguimientoImporteFicha = seguimientoFicha.Where(x => x.ImporteMdp.HasValue).Sum(x => x.ImporteMdp ?? 0);
    var seguimientoProgramados = seguimientoFicha.Where(x => x.AvanceProgramado.HasValue)
        .Select(x => x.AvanceProgramado <= 1 ? x.AvanceProgramado.Value * 100 : x.AvanceProgramado.Value).ToList();
    var seguimientoReales = seguimientoFicha.Where(x => x.AvanceReal.HasValue)
        .Select(x => x.AvanceReal <= 1 ? x.AvanceReal.Value * 100 : x.AvanceReal.Value).ToList();
    decimal? seguimientoProgramadoPromedio = seguimientoProgramados.Count > 0 ? seguimientoProgramados.Average() : null;
    decimal? seguimientoRealPromedio = seguimientoReales.Count > 0 ? seguimientoReales.Average() : null;
    var fasesSeguimientoConteo = seguimientoFicha
        .Select(x => x.FaseInicial)
        .Where(x => !string.IsNullOrWhiteSpace(x))
        .Distinct(StringComparer.OrdinalIgnoreCase)
        .Count();
    var subfasesSeguimientoConteo = seguimientoFicha
        .Select(x => x.FasesSubsecuentes)
        .Where(x => !string.IsNullOrWhiteSpace(x))
        .Distinct(StringComparer.OrdinalIgnoreCase)
        .Count();
    var fechasInicioSeguimiento = seguimientoFicha
        .Select(x => x.FechaInicioConstruccionReal ?? x.FechaInicioConstruccionProgramada ?? x.FechaInicioConcursoReal ?? x.FechaInicioConcursoProgramada)
        .Where(x => x.HasValue)
        .Select(x => x.Value)
        .ToList();
    var fechasTerminoSeguimiento = seguimientoFicha
        .Select(x => x.FechaTerminoConstruccion ?? x.FechaEstimadaTerminoCalculada)
        .Where(x => x.HasValue)
        .Select(x => x.Value)
        .ToList();
    var fechasActualizacionSeguimiento = seguimientoFicha
        .Where(x => x.UltimaActualizacionFecha.HasValue)
        .Select(x => x.UltimaActualizacionFecha.Value)
        .ToList();
    DateTime? seguimientoInicioFicha = fechasInicioSeguimiento.Count > 0 ? fechasInicioSeguimiento.Min() : null;
    DateTime? seguimientoTerminoFicha = fechasTerminoSeguimiento.Count > 0 ? fechasTerminoSeguimiento.Max() : null;
    DateTime? seguimientoUltimaActualizacion = fechasActualizacionSeguimiento.Count > 0 ? fechasActualizacionSeguimiento.Max() : null;
    var seguimientoConRezago = seguimientoFicha.Count(x => x.AvanceProgramado.HasValue
        && x.AvanceReal.HasValue
        && (x.AvanceReal <= 1 ? x.AvanceReal.Value * 100 : x.AvanceReal.Value)
            < (x.AvanceProgramado <= 1 ? x.AvanceProgramado.Value * 100 : x.AvanceProgramado.Value));

    // Reduce el tamaño del título cuando el texto es largo (nombres técnicos extensos).
    Func<string, string> ClaseTitulo = texto => (texto?.Length ?? 0) switch
    {
        > 260 => "is-xs",
        > 170 => "is-sm",
        > 100 => "is-md",
        _ => string.Empty
    };

    Func<string, int, string> Recortar = (t, max) =>
    {
        if (string.IsNullOrWhiteSpace(t)) return t;
        var s = System.Text.RegularExpressions.Regex.Replace(t.Trim(), @"\s+", " ");
        return s.Length <= max ? s : s[..max].TrimEnd(',', ';', '.', ' ') + "…";
    };

    // Diagnóstico real (EstadoRealProyecto, 97% de cobertura) y ámbito para la lámina 06.
    var estadoRealProyecto = Model.Detalle?.Actual?.EstadoRealProyecto;
    var diagnosticoTexto = !string.IsNullOrWhiteSpace(estadoRealProyecto)
        ? estadoRealProyecto
        : Model.Ficha.DiagnosticoOperativo;
    var equiposTexto = Model.Detalle?.Actual?.ElementosEquiposAsociados;
    var comentarioPriorizacion = Model.Detalle?.Actual?.ComentariosNivelPriorizacion;
    // Escala el diagnóstico según su longitud para que quepa sin desbordar.
    var claseDiagnostico = (diagnosticoTexto?.Length ?? 0) switch
    {
        > 900 => "is-xs",
        > 500 => "is-sm",
        > 240 => "is-md",
        _ => string.Empty
    };
    // ── Datos para gráficos ECharts (dona de cartera y anillo B/C) ──
    var datosDona = panorama
        .Where(p => (p.InversionMdp ?? 0) > 0)
        .Select(p => new
        {
            clave = p.ClavePem,
            valor = Math.Round(p.InversionMdp ?? 0, 3),
            activo = string.Equals(p.ClavePem, Model.Ficha.ClavePem, StringComparison.OrdinalIgnoreCase)
        })
        .ToList();
    var totalCartera = datosDona.Sum(d => d.valor);
    var inversionActiva = datosDona.Where(d => d.activo).Sum(d => d.valor);
    var pctCartera = totalCartera > 0 ? 100m * inversionActiva / totalCartera : 0;
    var jsonDona = System.Text.Json.JsonSerializer.Serialize(datosDona);
    // Cuando la ficha es de un proyecto PAM que no está entre los 8 identificados,
    // la dona se muestra como referencia de cartera (sin porcentaje del proyecto).
    var proyectoEnDona = datosDona.Any(d => d.activo);
    var donaCentroValor = proyectoEnDona ? $"{pctCartera.ToString("N1", esMX)}%" : $"${totalCartera.ToString("N0", esMX)}";
    var donaCentroEtiqueta = proyectoEnDona ? "de la cartera" : "MDP · 8 proyectos";

    // ── Barra de tiempo hacia la fecha necesaria (parsea "abril de 2031") ──
    DateTime? fechaNecesariaFecha = null;
    var fnTexto = (Model.Ficha.FechaNecesaria ?? string.Empty).ToLowerInvariant();
    var mesesNombre = new Dictionary<string, int>
    {
        ["enero"] = 1, ["febrero"] = 2, ["marzo"] = 3, ["abril"] = 4, ["mayo"] = 5, ["junio"] = 6,
        ["julio"] = 7, ["agosto"] = 8, ["septiembre"] = 9, ["octubre"] = 10, ["noviembre"] = 11, ["diciembre"] = 12
    };
    foreach (var mes in mesesNombre)
    {
        if (!fnTexto.Contains(mes.Key)) continue;
        var anio = System.Text.RegularExpressions.Regex.Match(fnTexto, @"20\d{2}");
        if (anio.Success) fechaNecesariaFecha = new DateTime(int.Parse(anio.Value), mes.Value, 1);
        break;
    }
    var inicioPrograma = new DateTime(2026, 1, 1);
    double? pctTiempo = null;
    int? mesesRestantes = null;
    if (fechaNecesariaFecha.HasValue && fechaNecesariaFecha.Value > inicioPrograma)
    {
        var totalDias = (fechaNecesariaFecha.Value - inicioPrograma).TotalDays;
        var transcurrido = (DateTime.Today - inicioPrograma).TotalDays;
        pctTiempo = Math.Clamp(transcurrido / totalDias * 100.0, 0.0, 100.0);
        mesesRestantes = Math.Max(0, (int)Math.Round((fechaNecesariaFecha.Value - DateTime.Today).TotalDays / 30.44));
    }

    // ── Proyección de demanda real para el gráfico ECharts ──
    // Parte de la demanda máxima observada y la tasa de crecimiento del proyecto;
    // proyecta año a año y cruza la capacidad en el año de la fecha necesaria.
    double? demandaBase = null;
    var demMatch = System.Text.RegularExpressions.Regex.Match(Model.Ficha.DemandaMaxima ?? string.Empty, @"[\d][\d,\.]*");
    if (demMatch.Success && double.TryParse(demMatch.Value.Replace(",", ""), System.Globalization.NumberStyles.Any, inv, out var db) && db > 0)
        demandaBase = db;
    var tasaCrecimiento = (double)(Model.Ficha.CrecimientoDemandaPorcentaje ?? 0) / 100.0;
    const int anioBaseDemanda = 2025;
    const int anioFinDemanda = 2040;
    var anioNecesaria = fechaNecesariaFecha?.Year;
    var hayGraficoDemanda = demandaBase.HasValue && tasaCrecimiento > 0;
    var serieDemanda = new List<object[]>();
    double? capacidadLimite = null;
    if (hayGraficoDemanda)
    {
        for (var a = anioBaseDemanda; a <= anioFinDemanda; a++)
            serieDemanda.Add(new object[] { a, Math.Round(demandaBase.Value * Math.Pow(1 + tasaCrecimiento, a - anioBaseDemanda)) });
        var anioCruce = anioNecesaria is >= anioBaseDemanda and <= anioFinDemanda ? anioNecesaria.Value : anioBaseDemanda + 6;
        capacidadLimite = Math.Round(demandaBase.Value * Math.Pow(1 + tasaCrecimiento, anioCruce - anioBaseDemanda));
    }
    var jsonDemanda = System.Text.Json.JsonSerializer.Serialize(new
    {
        serie = serieDemanda,
        limite = capacidadLimite,
        anioNecesaria,
        unidad = "MWh/h",
        etiquetaNecesaria = $"Fecha necesaria · {Model.Ficha.FechaNecesaria}"
    });
}

<link rel="preconnect" href="https://fonts.googleapis.com" />
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
<link href="https://fonts.googleapis.com/css2?family=IBM+Plex+Mono:wght@500;600;700&display=swap" rel="stylesheet" />
<link rel="stylesheet" href="~/Geovisualizador/css/leaflet.css" />
<link rel="stylesheet" href="~/css/pam-ficha-presentacion.css" asp-append-version="true" />

<main class="pam-ficha-page" data-filename="@archivoBase" data-project-key="@Model.Ficha.ClavePem">
    <div class="pam-ficha-toolbar" aria-label="Acciones de la ficha">
        <a asp-action="Index" class="pam-ficha-toolbar__back">
            <i class="bi bi-arrow-left" aria-hidden="true"></i><span>Proyectos identificados</span>
        </a>
        <div class="pam-ficha-toolbar__title">
            <strong>@Model.Ficha.ClavePem</strong><span>Ficha ejecutiva navegable</span>
        </div>
        <div class="pam-ficha-toolbar__actions">
            <button type="button" data-export="pdf" title="Descargar ficha en PDF"><i class="bi bi-file-earmark-pdf"></i><span>PDF</span></button>
            <button type="button" data-export="pptx" title="Descargar ficha en PowerPoint"><i class="bi bi-file-earmark-slides"></i><span>PPT</span></button>
            <button type="button" id="pam-btn-enviar" title="Enviar la ficha por correo"><i class="bi bi-send"></i><span>Enviar</span></button>
            <button type="button" data-fullscreen title="Presentar en pantalla completa"><i class="bi bi-arrows-fullscreen"></i><span>Presentar</span></button>
        </div>
    </div>

    @* ── Modal de envío de ficha por correo ── *@
    <div id="pam-envio-modal" class="pam-envio-modal" hidden>
        <div class="pam-envio-backdrop" data-envio-cerrar></div>
        <div class="pam-envio-dialog" role="dialog" aria-modal="true" aria-labelledby="pam-envio-titulo">
            <div class="pam-envio-head">
                <div>
                    <h3 id="pam-envio-titulo">Enviar ficha por correo</h3>
                    <p>Proyecto <strong>@Model.Ficha.ClavePem</strong> · la ficha se genera y se adjunta al correo.</p>
                </div>
                <button type="button" class="pam-envio-x" data-envio-cerrar aria-label="Cerrar"><i class="bi bi-x-lg"></i></button>
            </div>
            <form id="pam-envio-form" data-clave="@Model.Ficha.ClavePem" data-skip-page-preloader="true">
                @Html.AntiForgeryToken()
                <label class="pam-envio-label">Formato del archivo</label>
                <div class="pam-envio-formato">
                    <label><input type="radio" name="formato" value="pdf" checked /><span><i class="bi bi-file-earmark-pdf"></i> PDF</span></label>
                    <label><input type="radio" name="formato" value="pptx" /><span><i class="bi bi-file-earmark-slides"></i> PowerPoint</span></label>
                </div>

                <label class="pam-envio-label" for="pam-envio-buscar">Destinatarios <span>(uno o más)</span></label>
                <input type="search" id="pam-envio-buscar" class="pam-envio-buscar" placeholder="Buscar por nombre o correo…" autocomplete="off" />
                <div class="pam-envio-lista" id="pam-envio-lista" role="listbox" aria-multiselectable="true">
                    @if (Model.Destinatarios.Count == 0)
                    {
                        <div class="pam-envio-vacio">No hay usuarios con correo registrado.</div>
                    }
                    else
                    {
                        @foreach (var u in Model.Destinatarios)
                        {
                            <label class="pam-envio-item" data-nombre="@u.Nombre.ToLowerInvariant()" data-correo="@u.Correo.ToLowerInvariant()">
                                <input type="checkbox" name="usuario" value="@u.IdUsuario" />
                                <span class="pam-envio-item__ini">@(string.IsNullOrWhiteSpace(u.Nombre) ? "?" : u.Nombre.Trim()[..1].ToUpperInvariant())</span>
                                <span class="pam-envio-item__info">
                                    <strong>@u.Nombre</strong>
                                    <small>@u.Correo@(string.IsNullOrWhiteSpace(u.Cargo) ? "" : $" · {u.Cargo}")</small>
                                </span>
                            </label>
                        }
                    }
                </div>

                <label class="pam-envio-label" for="pam-envio-mensaje">Mensaje adicional <span>(opcional)</span></label>
                <textarea id="pam-envio-mensaje" name="mensaje" rows="2" class="pam-envio-mensaje" placeholder="Ej. Se comparte la ficha para la reunión de seguimiento."></textarea>

                <div class="pam-envio-feedback" id="pam-envio-feedback" hidden></div>
                <div class="pam-envio-actions">
                    <button type="button" class="pam-envio-btn pam-envio-btn--cancel" data-envio-cerrar>Cancelar</button>
                    <button type="submit" class="pam-envio-btn pam-envio-btn--send" id="pam-envio-enviar">
                        <i class="bi bi-send" aria-hidden="true"></i> Enviar ficha
                    </button>
                </div>
            </form>
        </div>
    </div>

    <div id="pam-deck-shell" class="pam-deck-shell">
        <div id="pam-deck" class="pam-deck" aria-live="polite">

            @* ── 01 · Portada (patrón insumo: logos, eyebrow, H1 Patria, clave + regla dorada, banda fotográfica guinda, meta) ── *@
            <section class="pam-slide pam-slide--cover is-active" data-slide data-label="Portada" data-screen-label="01">
                <div class="pam-cover__logos">
                    <img src="~/img/pamrnt/logo_gob.png" alt="Gobierno de México" />
                    <i></i>
                    <img src="~/img/pamrnt/logo_sener.png" alt="Secretaría de Energía" />
                </div>
                <div class="pam-cover__head">
                    <div class="pam-cover__eyebrow">Subsecretaría de Planeación y Transición Energética</div>
                    <h1>Proyectos identificados de ampliación de la RNT</h1>
                    <div class="pam-cover__row">
                        <div class="pam-cover__clave">@Model.Ficha.ClavePem</div>
                        <span class="pam-cover__dash"></span>
                        <p>@Model.Ficha.Titulo</p>
                    </div>
                    @if (!string.IsNullOrWhiteSpace(Model.Proyecto.EstatusLicitacion))
                    {
                        <div class="pam-cover__estatus @NSIE.Models.PamSemaforo.Clase(Model.Proyecto.EstatusLicitacion)">
                            <i aria-hidden="true"></i>Estatus de licitación: @Model.Proyecto.EstatusLicitacion
                        </div>
                    }
                </div>
                <div class="pam-cover__photo" style="background-image:url('/img/pamrnt/reno_portada.png')" role="img" aria-label="Infraestructura energética">
                    <i class="pam-cover__goldline"></i>
                    <i class="pam-cover__shade"></i>
                </div>
                <div class="pam-cover__meta">
                    <div><span>Versión</span><strong>@(detalle?.NumeroVersion ?? 1).0</strong></div>
                    <div><span>Corte</span><strong>@fechaCorte.ToString("dd 'de' MMMM 'de' yyyy")</strong></div>
                    <div><span>Prioridad</span><strong>@(Model.Proyecto.Prioridad?.ToString() ?? "—") · @regionProyecto</strong></div>
                    <div><span>Fuente</span><strong>PAMRNT 2026–2040</strong></div>
                </div>
            </section>

            @* ── 02 · Índice navegable (patrón insumo: grupos numerados + líderes punteados + folio mono) ── *@
            <section class="pam-slide pam-slide--content pam-slide--index" data-slide data-label="Índice" data-screen-label="02">
                <header class="pam-lamina-head">
                    <span class="pam-lamina-head__kicker">
                        <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" aria-hidden="true"><line x1="8" y1="6" x2="21" y2="6"></line><line x1="8" y1="12" x2="21" y2="12"></line><line x1="8" y1="18" x2="21" y2="18"></line><line x1="3" y1="6" x2="3.01" y2="6"></line><line x1="3" y1="12" x2="3.01" y2="12"></line><line x1="3" y1="18" x2="3.01" y2="18"></line></svg>
                        Contenido
                    </span>
                    <span class="pam-lamina-head__aside">Índice navegable</span>
                </header>
                <h2 class="pam-lamina-title is-guinda">Índice</h2>
                <div class="pam-lamina-body pam-index">
                    <button type="button" class="pam-index__group" data-goto-label="03"><b>01</b><span>El proyecto</span></button>
                    <button type="button" class="pam-index__entry" data-goto-label="04"><span>Decisión ejecutiva</span><i></i><small>04</small></button>
                    <button type="button" class="pam-index__entry" data-goto-label="05"><span>@(Model.EsPamrntIdentificado ? "Panorama del PAMRNT 2026–2040" : "Contexto regional de cartera")</span><i></i><small>05</small></button>
                    <button type="button" class="pam-index__entry" data-goto-label="06"><span>Diagnóstico operativo</span><i></i><small>06</small></button>
                    <button type="button" class="pam-index__entry" data-goto-label="06B"><span>Ubicación territorial y red</span><i></i><small>06·red</small></button>
                    <button type="button" class="pam-index__entry" data-goto-label="06C"><span>Análisis territorial de proximidad</span><i></i><small>06·20 km</small></button>
                    @if (fichaConElementosTerritoriales)
                    {
                        <button type="button" class="pam-index__entry" data-goto-label="06C-2"><span>Perfil energético y territorial</span><i></i><small>06·perfil</small></button>
                        <button type="button" class="pam-index__entry" data-goto-label="06D"><span>Análisis territorial por elemento</span><i></i><small>06·detalle</small></button>
                    }
                    <button type="button" class="pam-index__entry" data-goto-label="07"><span>Pronóstico e impacto regional</span><i></i><small>07</small></button>
                    <button type="button" class="pam-index__entry" data-goto-label="08"><span>Riesgos y dependencias</span><i></i><small>08</small></button>
                    @if (Model.FichaEnriquecida)
                    {
                        <button type="button" class="pam-index__entry" data-goto-label="09"><span>Alternativas de solución</span><i></i><small>09</small></button>
                        <button type="button" class="pam-index__entry" data-goto-label="10"><span>Comparativa de confiabilidad</span><i></i><small>10</small></button>
                        <button type="button" class="pam-index__entry" data-goto-label="11"><span>Evaluación económica</span><i></i><small>11</small></button>
                    }
                    @if (Model.TieneRecursosVisuales)
                    {
                        if (Model.Diagramas.Count <= 6)
                        {
                            for (var i = 0; i < Model.Diagramas.Count; i++)
                            {
                                var fig = Model.Diagramas[i];
                                var lbl = Model.Diagramas.Count == 1 ? "12" : $"12-{(i + 1)}";
                                var smallLbl = Model.Diagramas.Count == 1 ? "12" : $"12·{(i + 1)}";
                                var titleIndex = fig.TituloVisual;
                                <button type="button" class="pam-index__entry" data-goto-label="@lbl"><span>@Recortar(titleIndex, 55)</span><i></i><small>@smallLbl</small></button>
                            }
                        }
                        else
                        {
                            <button type="button" class="pam-index__entry" data-goto-label="02B"><span>Diagramas y figuras técnicas (@Model.Diagramas.Count láminas)</span><i></i><small>02B</small></button>
                        }
                    }
                    <button type="button" class="pam-index__entry" data-goto-label="13"><span>Fases y alineación con la fecha necesaria</span><i></i><small>13</small></button>
                    <button type="button" class="pam-index__entry" data-goto-label="13A"><span>Datos vigentes de licitación</span><i></i><small>13·lic</small></button>
                    @if (seguimientoFicha.Count > 0)
                    {
                        <button type="button" class="pam-index__entry" data-goto-label="13B"><span>Seguimiento operativo del último corte</span><i></i><small>13·seg</small></button>
                        <button type="button" class="pam-index__entry" data-goto-label="13C"><span>Fases y subfases del seguimiento</span><i></i><small>13·fases</small></button>
                    }
                    <button type="button" class="pam-index__group" data-goto-label="14"><b>02</b><span>Cierre y trazabilidad</span></button>
                    <button type="button" class="pam-index__entry" data-goto-label="15"><span>Conclusión ejecutiva</span><i></i><small>15</small></button>
                    <button type="button" class="pam-index__entry" data-goto-label="16"><span>Aplicación y trazabilidad</span><i></i><small>16</small></button>
                    <button type="button" class="pam-index__group" data-goto-label="17"><b>03</b><span>Anexos</span></button>
                    <button type="button" class="pam-index__entry" data-goto-label="18"><span>Historial de versiones</span><i></i><small>18</small></button>
                    <button type="button" class="pam-index__entry" data-goto-label="19"><span>Línea de tiempo de modificaciones</span><i></i><small>19</small></button>
                </div>
                <div class="pam-lamina-foot">
                    <span>Contenido ejecutivo, seguimiento del proyecto y anexos de trazabilidad.</span>
                    <span class="pam-lamina-foot__meta">02</span>
                </div>
            </section>

            @* ── 02B · Índice complementario de figuras (solo si hay más de 6 figuras en el proyecto) ── *@
            @if (Model.TieneRecursosVisuales && Model.Diagramas.Count > 6)
            {
                <section class="pam-slide pam-slide--content" data-slide data-label="Índice figuras" data-screen-label="02B">
                    <header class="pam-lamina-head">
                        <span class="pam-lamina-head__kicker">@seccion01</span>
                        <span class="pam-lamina-head__aside">ÍNDICE NAVEGABLE DE FIGURAS</span>
                    </header>
                    <h2 class="pam-lamina-title is-guinda">Índice · Diagramas y figuras técnicas (@Model.Diagramas.Count)</h2>
                    <div class="pam-lamina-body pam-index pam-index--figuras">
                        @for (var i = 0; i < Model.Diagramas.Count; i++)
                        {
                            var fig = Model.Diagramas[i];
                            var lbl = $"12-{(i + 1)}";
                            var smallLbl = $"12·{(i + 1)}";
                            var titleIndex = fig.TituloVisual;
                            <button type="button" class="pam-index__entry" data-goto-label="@lbl">
                                <span>@(i + 1). @Recortar(titleIndex, 65)</span><i></i><small>@smallLbl</small>
                            </button>
                        }
                    </div>
                    <div class="pam-lamina-foot">
                            <span>Diagramas y figuras técnicas asociados al alcance del proyecto.</span>
                        <span class="pam-lamina-foot__meta">
                            <button type="button" class="pam-home" data-goto="1" title="Volver al índice principal"><svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M3 11.5 12 4l9 7.5"></path><path d="M5.5 10v9h13v-9"></path></svg></button>
                            02B
                        </span>
                    </div>
                </section>
            }

            @* ── 03 · Divisoria Sección 01 (patrón insumo: barra guinda, número gigante, kicker con punto, Patria, regla dorada) ── *@
            <section class="pam-slide pam-slide--divider" data-slide data-label="Sección 01" data-screen-label="03">
                <i class="pam-divider__bar" aria-hidden="true"></i>
                <div class="pam-divider__logos">
                    <img src="~/img/pamrnt/logo_gob.png" alt="Gobierno de México" />
                    <i></i>
                    <img src="~/img/pamrnt/logo_sener.png" alt="Secretaría de Energía" />
                </div>
                <button type="button" class="pam-home pam-divider__home" data-goto="1" title="Volver al índice">
                    <svg width="21" height="21" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M3 11.5 12 4l9 7.5"></path><path d="M5.5 10v9h13v-9"></path></svg>
                </button>
                <div class="pam-divider__big" aria-hidden="true">01</div>
                <div class="pam-divider__kicker"><span></span>Sección 01 · @tipoProyecto</div>
                <h1>@Model.Ficha.ClavePem</h1>
                <div class="pam-divider__sub">
                    <i></i>
                    <p>@Model.Ficha.Titulo · @regionProyecto</p>
                </div>
            </section>

            @* ── 04 · Decisión ejecutiva ── *@
            <section class="pam-slide pam-slide--content" data-slide data-label="Decisión ejecutiva" data-screen-label="04">
                <header class="pam-lamina-head">
                    <span class="pam-lamina-head__kicker">@seccion01</span>
                    <span class="pam-lamina-head__aside">Decisión ejecutiva</span>
                </header>
                <h2 class="pam-lamina-title @ClaseTitulo("Proyecto recomendado: " + Model.Ficha.AlternativaSeleccionada)">Proyecto recomendado: @Model.Ficha.AlternativaSeleccionada.</h2>
                <div class="pam-lamina-body">
                    <p class="pam-lead">@Model.Ficha.ResumenEjecutivo</p>
                    <div class="pam-metrics pam-metrics--four">
                        <article><span>Inversión</span><strong>$@Model.Ficha.InversionMdp.ToString("N3", esMX)</strong><small>MDP 2025</small></article>
                        <article><span>Fecha necesaria</span><strong>@Model.Ficha.FechaNecesaria</strong><small>necesaria y factible</small></article>
                        <article><span>Beneficio / Costo</span><strong>@bcTexto</strong><small>pesos por peso invertido</small></article>
                        <article><span>Obras</span><strong>@Model.Ficha.TotalObras.ToString("N0", esMX)</strong><small>componentes asociados</small></article>
                    </div>
                    <div class="pam-decision-strip"><strong>Recomendación</strong><span>@Model.Ficha.RecomendacionEjecutiva</span></div>
                    @if (pctTiempo.HasValue)
                    {
                        <div class="pam-timebar">
                            <div class="pam-timebar__head">
                                <span>Ruta a la fecha necesaria</span>
                                <strong>@Model.Ficha.FechaNecesaria · @mesesRestantes meses restantes</strong>
                            </div>
                            <div class="pam-timebar__track"><i style="width:@pctTiempo.Value.ToString("F1", inv)%"></i></div>
                            <div class="pam-timebar__scale">
                                <span>Inicio del ejercicio · 2026</span>
                                <span>@pctTiempo.Value.ToString("N0", esMX)% del plazo transcurrido</span>
                                <span>@Model.Ficha.FechaNecesaria</span>
                            </div>
                        </div>
                    }
                </div>
                <div class="pam-lamina-foot">
                    <span>@Model.Ficha.Fuente</span>
                    <span class="pam-lamina-foot__meta">
                        <button type="button" class="pam-home" data-goto="1" title="Volver al índice"><svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M3 11.5 12 4l9 7.5"></path><path d="M5.5 10v9h13v-9"></path></svg></button>
                        04
                    </span>
                </div>
            </section>

            @* ── 05 · Panorama ── *@
            <section class="pam-slide pam-slide--content" data-slide data-label="Panorama" data-screen-label="05">
                <header class="pam-lamina-head">
                    <span class="pam-lamina-head__kicker">@seccion01</span>
                    <span class="pam-lamina-head__aside">@panoramaKicker</span>
                </header>
                <h2 class="pam-lamina-title">@panoramaTitulo</h2>
                <div class="pam-lamina-body pam-panorama">
                    <table class="pam-table pam-table--portfolio">
                        <thead>
                            <tr><th>Prioridad</th><th>Clave</th><th>Proyecto</th><th>Región</th><th>Inversión (MDP)</th></tr>
                        </thead>
                        <tbody>
                            @foreach (var item in panorama)
                            {
                                <tr class="@(string.Equals(item.ClavePem, Model.Ficha.ClavePem, StringComparison.OrdinalIgnoreCase) ? "is-highlighted" : null)">
                                    <td>@item.Prioridad</td>
                                    <td>@item.ClavePem</td>
                                    <td>@item.Proyecto</td>
                                    <td>@item.Gcr</td>
                                    <td>@(item.InversionMdp.HasValue ? $"${item.InversionMdp.Value.ToString("N3", esMX)}" : "—")</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                    <aside class="pam-panorama__aside">
                        <div class="pam-chart-caption">Peso en la inversión de la cartera</div>
                        <div id="pam-chart-dona" class="pam-chart-dona"></div>
                        @if (proyectoEnDona)
                        {
                            <p class="pam-chart-note"><strong>@Model.Ficha.ClavePem</strong> representa el <strong>@pctCartera.ToString("N1", esMX)%</strong> de los $@totalCartera.ToString("N3", esMX) MDP de los ocho proyectos identificados.</p>
                        }
                        else
                        {
                            <p class="pam-chart-note"><strong>@Model.Ficha.ClavePem</strong> pertenece a la cartera PAM; la dona muestra, como referencia, los ocho proyectos identificados del PAMRNT 2026–2040.</p>
                        }
                    </aside>
                </div>
                <div class="pam-lamina-foot">
                    <span>Fuente: cartera histórica PAM/PAMRNT · corte @fechaCorte.ToString("dd/MM/yyyy"). @panoramaFuente</span>
                    <span class="pam-lamina-foot__meta">
                        <button type="button" class="pam-home" data-goto="1" title="Volver al índice"><svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M3 11.5 12 4l9 7.5"></path><path d="M5.5 10v9h13v-9"></path></svg></button>
                        05
                    </span>
                </div>
            </section>

            @* ── 06 · Diagnóstico operativo ── *@
            <section class="pam-slide pam-slide--content" data-slide data-label="El problema" data-screen-label="06">
                <header class="pam-lamina-head">
                    <span class="pam-lamina-head__kicker">@seccion01</span>
                    <span class="pam-lamina-head__aside">Diagnóstico operativo</span>
                </header>
                <h2 class="pam-lamina-title">Diagnóstico operativo y ámbito del proyecto.</h2>
                <div class="pam-lamina-body pam-diagnostico">
                    <div class="pam-diagnostico__texto">
                        <span class="pam-chart-caption">Estado y problema reportado</span>
                        <p class="pam-lead pam-diagnostico__lead @claseDiagnostico">@diagnosticoTexto</p>
                        <div class="pam-diagnostico__ambito">
                            <article><span>Tipo de proyecto</span><strong>@tipoProyecto</strong></article>
                            <article><span>Fecha necesaria</span><strong>@Model.Ficha.FechaNecesaria</strong></article>
                            @if (!string.IsNullOrWhiteSpace(equiposTexto))
                            {
                                <article class="is-wide"><span>Elementos y equipos asociados</span><strong>@Recortar(equiposTexto, 180)</strong></article>
                            }
                        </div>
                    </div>
                    <aside class="pam-diagnostico__mapa">
                        <div id="pam-mapa-caption" class="pam-chart-caption">Gerencia de Control Regional</div>
                        <div id="pam-mapa-gcr" class="pam-mapa-gcr" data-gcr="@regionProyecto"
                             data-proyectos="@(Model.ImpactoRegional?.TotalProyectos ?? 0)"
                             data-project-id="@Model.Proyecto.ProyectoId"
                             data-territorial-url="/DashboardProyectos/PamTerritorial/@Model.Proyecto.ProyectoId"></div>
                        <div class="pam-mapa-leyenda">
                            <span class="pam-mapa-leyenda__punto"></span>
                            <strong id="pam-mapa-resumen">@regionProyecto</strong>
                            <span id="pam-mapa-datos"></span>
                        </div>
                    </aside>
                </div>
                <div class="pam-lamina-foot">
                    <span>Diagnóstico y ámbito operativo del proyecto · corte @fechaCorte.ToString("dd/MM/yyyy").</span>
                    <span class="pam-lamina-foot__meta">
                        <button type="button" class="pam-home" data-goto="1" title="Volver al índice"><svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M3 11.5 12 4l9 7.5"></path><path d="M5.5 10v9h13v-9"></path></svg></button>
                        06
                    </span>
                </div>
            </section>

            @* ── 06B · Ubicación territorial y red (capas del Dashboard de Proyectos) ── *@
            <section class="pam-slide pam-slide--content" data-slide data-label="Ubicación y red" data-screen-label="06B">
                <header class="pam-lamina-head">
                    <span class="pam-lamina-head__kicker">@seccion01</span>
                    <span class="pam-lamina-head__aside">Ubicación territorial y red</span>
                </header>
                <h2 class="pam-lamina-title">Ubicación del proyecto y contexto de la Red Nacional de Transmisión.</h2>
                <div class="pam-lamina-body pam-red">
                    <div class="pam-red__layout">
                        <div id="pam-mapa-red" class="pam-mapa-red"
                             data-gcr="@regionProyecto"
                             data-project-id="@Model.Proyecto.ProyectoId"
                             data-territorial-url="/DashboardProyectos/PamTerritorial/@Model.Proyecto.ProyectoId"></div>
                        <aside class="pam-red__panel" aria-label="Capas y ubicaciones territoriales">
                            <span class="pam-chart-caption">Capas visibles</span>
                            <div class="pam-red__capas" role="group" aria-label="Capas del mapa">
                                <button type="button" class="pam-red__capa is-active" data-pam-layer="proyecto" aria-pressed="true"><i class="pam-red__proyecto"></i><span>Ubicación PAM</span></button>
                                <button type="button" class="pam-red__capa is-active" data-pam-layer="lineas" aria-pressed="true"><i class="pam-red__lt"></i><span>Líneas RNT</span></button>
                                <button type="button" class="pam-red__capa is-active" data-pam-layer="subestaciones" aria-pressed="true"><i class="pam-red__se"></i><span>Subestaciones</span></button>
                                <button type="button" class="pam-red__capa is-active" data-pam-layer="gcr" aria-pressed="true"><i class="pam-red__gcr"></i><span>Gerencias</span></button>
                            </div>
                            <div class="pam-red__ubicaciones-head">
                                <span class="pam-chart-caption">Ubicaciones del proyecto</span>
                                <strong id="pam-red-ubicacion-meta">Cargando…</strong>
                            </div>
                            <div id="pam-red-ubicaciones" class="pam-red__ubicaciones" aria-live="polite"></div>
                        </aside>
                    </div>
                    <div class="pam-red__leyenda">
                        <span class="pam-red__item"><i class="pam-red__gcr"></i><span id="pam-red-gcr-label">GCR @regionProyecto</span></span>
                        <span id="pam-red-kv" class="pam-red__kv" aria-label="Niveles de tensión"></span>
                        <span class="pam-red__conteo" id="pam-red-conteo"></span>
                    </div>
                </div>
                <div class="pam-lamina-foot">
                    <span>Ubicación de los elementos del proyecto sobre la RNT y las Gerencias de Control Regional.</span>
                    <span class="pam-lamina-foot__meta">
                        <button type="button" class="pam-home" data-goto="1" title="Volver al índice"><svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M3 11.5 12 4l9 7.5"></path><path d="M5.5 10v9h13v-9"></path></svg></button>
                        06·red
                    </span>
                </div>
            </section>

            @* ── 06C · Análisis territorial automático por geometría ── *@
            <section class="pam-slide pam-slide--content" data-slide data-label="Análisis territorial" data-screen-label="06C">
                <header class="pam-lamina-head">
                    <span class="pam-lamina-head__kicker">@seccion01</span>
                    <span class="pam-lamina-head__aside">Análisis territorial de proximidad</span>
                </header>
                <h2 class="pam-lamina-title">Cobertura territorial, infraestructura y sensibilidad del entorno del proyecto.</h2>
                <div class="pam-lamina-body pam-territorial"
                     data-pam-territorial-analysis
                     data-territorial-url="/DashboardProyectos/PamTerritorial/@Model.Proyecto.ProyectoId"
                     data-project-gcr="@regionProyecto"
                     data-default-radius="20">
                    <div class="pam-territorial__layout">
                        <div id="pam-territorial-mapa" class="pam-territorial__mapa" aria-label="Mapa del análisis territorial"></div>
                        <aside class="pam-territorial__resumen" aria-live="polite">
                            <div class="pam-territorial__loading"><i></i><strong>Integrando contexto territorial…</strong><span>Ubicación, red eléctrica, entorno municipal y sensibilidad territorial.</span></div>
                        </aside>
                    </div>
                    <div class="pam-territorial__metodo">
                        <span><i class="pam-territorial__dot is-guinda"></i>Ubicación PAM</span>
                        <span><i class="pam-territorial__dot is-dorado"></i>Área de análisis</span>
                        <span><i class="pam-territorial__dot is-red"></i>Infraestructura RNT</span>
                        <strong data-territorial-status>Inicializando…</strong>
                    </div>
                </div>
                <div class="pam-lamina-foot">
                    <span data-territorial-method>Área de proximidad de 20 km por ubicación de red confirmada.</span>
                    <span class="pam-lamina-foot__meta">
                        <button type="button" class="pam-home" data-goto="1" title="Volver al índice"><svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M3 11.5 12 4l9 7.5"></path><path d="M5.5 10v9h13v-9"></path></svg></button>
                        06·20 km
                    </span>
                </div>
            </section>

            @if (fichaConElementosTerritoriales)
            {
                @* ── 06C-2 · Perfil ejecutivo consolidado ── *@
                <section class="pam-slide pam-slide--content" data-slide data-label="Perfil energético y territorial" data-screen-label="06C-2">
                    <header class="pam-lamina-head">
                        <span class="pam-lamina-head__kicker">@seccion01</span>
                        <span class="pam-lamina-head__aside">Perfil energético y territorial</span>
                    </header>
                    <h2 class="pam-lamina-title">Demanda, contexto tarifario e incidencia territorial del proyecto.</h2>
                    <div class="pam-lamina-body pam-territorial-ejecutivo"
                         data-pam-territorial-executive
                         data-territorial-url="/DashboardProyectos/PamTerritorial/@Model.Proyecto.ProyectoId">
                        <div class="pam-territorial__loading"><i></i><strong>Preparando perfil ejecutivo…</strong><span>Demanda, tarifas, infraestructura, permisos, ambiente y patrimonio.</span></div>
                    </div>
                    <div class="pam-lamina-foot">
                        <span>Cifras consolidadas por capa geoespacial y cobertura operativa del proyecto.</span>
                        <span class="pam-lamina-foot__meta">
                            <button type="button" class="pam-home" data-goto="1" title="Volver al índice"><svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M3 11.5 12 4l9 7.5"></path><path d="M5.5 10v9h13v-9"></path></svg></button>
                            06·perfil
                        </span>
                    </div>
                </section>
            }

            @if (fichaConElementosTerritoriales)
            {
                if (fichaTerritorialIndividual)
                {
                    for (var elementoTerritorialIndex = 0; elementoTerritorialIndex < ubicacionesAnalisis.Count; elementoTerritorialIndex++)
                    {
                        var ubicacionTerritorial = ubicacionesAnalisis[elementoTerritorialIndex];
                        var nombreElementoTerritorial = string.IsNullOrWhiteSpace(ubicacionTerritorial.Etiqueta)
                            ? (string.IsNullOrWhiteSpace(ubicacionTerritorial.ClaveElementoRed) ? $"Elemento {elementoTerritorialIndex + 1}" : ubicacionTerritorial.ClaveElementoRed)
                            : ubicacionTerritorial.Etiqueta;
                        var etiquetaTerritorial = elementoTerritorialIndex == 0 ? "06D" : $"06D-{elementoTerritorialIndex + 1}";
                        var folioTerritorial = ubicacionesAnalisis.Count == 1 ? "06·elemento" : $"06·elemento {elementoTerritorialIndex + 1}/{ubicacionesAnalisis.Count}";
                        @* ── 06D · Una lámina ejecutiva por geometría operativa ── *@
                        <section class="pam-slide pam-slide--content" data-slide data-label="Elemento territorial @(elementoTerritorialIndex + 1)" data-screen-label="@etiquetaTerritorial">
                            <header class="pam-lamina-head">
                                <span class="pam-lamina-head__kicker">@seccion01</span>
                                <span class="pam-lamina-head__aside">Análisis territorial por elemento</span>
                            </header>
                            <h2 class="pam-lamina-title">@Recortar(nombreElementoTerritorial, 92)</h2>
                            <div class="pam-lamina-body pam-elemento-analysis"
                                 data-pam-territorial-element
                                 data-territorial-element-index="@elementoTerritorialIndex"
                                 data-territorial-url="/DashboardProyectos/PamTerritorial/@Model.Proyecto.ProyectoId">
                                <div class="pam-territorial__loading"><i></i><strong>Analizando cobertura del elemento…</strong><span>Red, permisos, ductos, demanda, tarifas, contexto INEGI y sensibilidad territorial.</span></div>
                            </div>
                            <div class="pam-lamina-foot">
                                <span>Infraestructura, entorno territorial y referencias energéticas de cada elemento del proyecto.</span>
                                <span class="pam-lamina-foot__meta">
                                    <button type="button" class="pam-home" data-goto="1" title="Volver al índice"><svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M3 11.5 12 4l9 7.5"></path><path d="M5.5 10v9h13v-9"></path></svg></button>
                                    @folioTerritorial
                                </span>
                            </div>
                        </section>
                    }
                }
                else
                {
                    for (var paginaMatrizIndex = 0; paginaMatrizIndex < paginasMatrizTerritorial.Count; paginaMatrizIndex++)
                    {
                        var etiquetaMatriz = paginaMatrizIndex == 0 ? "06D" : $"06D-{paginaMatrizIndex + 1}";
                        var folioMatriz = $"06·matriz {paginaMatrizIndex + 1}/{paginasMatrizTerritorial.Count}";
                        <section class="pam-slide pam-slide--content" data-slide data-label="Matriz territorial @(paginaMatrizIndex + 1)" data-screen-label="@etiquetaMatriz">
                            <header class="pam-lamina-head">
                                <span class="pam-lamina-head__kicker">@seccion01</span>
                                <span class="pam-lamina-head__aside">Matriz territorial por elemento</span>
                            </header>
                            <h2 class="pam-lamina-title">Infraestructura, mercado y entorno de los elementos del proyecto.</h2>
                            <div class="pam-lamina-body pam-elemento-matriz"
                                 data-pam-territorial-matrix
                                 data-territorial-page="@paginaMatrizIndex"
                                 data-territorial-url="/DashboardProyectos/PamTerritorial/@Model.Proyecto.ProyectoId">
                                <div class="pam-territorial__loading"><i></i><strong>Consolidando matriz territorial…</strong><span>Cinco elementos por lámina para conservar legibilidad.</span></div>
                            </div>
                            <div class="pam-lamina-foot">
                                <span>Cada fila corresponde a una geometría operativa y conserva sus hallazgos territoriales principales.</span>
                                <span class="pam-lamina-foot__meta">
                                    <button type="button" class="pam-home" data-goto="1" title="Volver al índice"><svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M3 11.5 12 4l9 7.5"></path><path d="M5.5 10v9h13v-9"></path></svg></button>
                                    @folioMatriz
                                </span>
                            </div>
                        </section>
                    }
                }
            }

            @* ── 07 · Pronóstico ── *@
            <section class="pam-slide pam-slide--content" data-slide data-label="Pronóstico" data-screen-label="07">
                <header class="pam-lamina-head">
                    <span class="pam-lamina-head__kicker">@seccion01</span>
                    <span class="pam-lamina-head__aside">Pronóstico e impacto regional</span>
                </header>
                <h2 class="pam-lamina-title">@(hayGraficoDemanda ? "La demanda crece y el proyecto refuerza la capacidad de su región." : "Aporte del proyecto y seguimiento en su región.")</h2>
                <div class="pam-lamina-body">
                    @if (hayGraficoDemanda)
                    {
                        <div class="pam-forecast">
                            <div class="pam-forecast__chart">
                                <div id="pam-chart-demanda" class="pam-chart-demanda"></div>
                            </div>
                            <div class="pam-forecast__facts">
                                <article><strong>@crecimientoTexto</strong><span>crecimiento medio anual a 2030</span></article>
                                <article><strong>@Model.Ficha.DemandaMaxima</strong><span>demanda máxima observada</span></article>
                                <p>@Model.Ficha.PronosticoDemanda</p>
                            </div>
                        </div>
                    }
                    else if (!string.IsNullOrWhiteSpace(comentarioPriorizacion))
                    {
                        <div class="pam-seguimiento">
                            <span class="pam-chart-caption">Nivel de priorización y seguimiento</span>
                            <p class="pam-lead">@comentarioPriorizacion</p>
                        </div>
                    }
                    @if (Model.ImpactoRegional?.TieneDatos == true)
                    {
                        var ir = Model.ImpactoRegional;
                        <div class="pam-impacto">
                            <div class="pam-impacto__titulo">Contribución del proyecto en la GCR @ir.Region · @ir.TotalProyectos.ToString("N0", esMX) proyectos vigentes</div>
                            <div class="pam-impacto__barras">
                                <div class="pam-impacto__barra">
                                    <span>Inversión</span>
                                    <div class="pam-impacto__track"><i style="width:@(Math.Clamp(ir.PorcentajeInversion, 0, 100).ToString("F1", inv))%"></i></div>
                                    <strong>@ir.PorcentajeInversion.ToString("N1", esMX)%</strong>
                                    <small>$@ir.InversionProyecto.ToString("N0", esMX) de $@ir.InversionRegion.ToString("N0", esMX) MDP</small>
                                </div>
                                <div class="pam-impacto__barra">
                                    <span>Transmisión</span>
                                    <div class="pam-impacto__track"><i style="width:@(Math.Clamp(ir.PorcentajeKmC, 0, 100).ToString("F1", inv))%"></i></div>
                                    <strong>@ir.PorcentajeKmC.ToString("N1", esMX)%</strong>
                                    <small>@((ir.KmCProyecto ?? 0).ToString("N1", esMX)) de @ir.KmCRegion.ToString("N1", esMX) km-C</small>
                                </div>
                                <div class="pam-impacto__barra">
                                    <span>Transformación</span>
                                    <div class="pam-impacto__track"><i style="width:@(Math.Clamp(ir.PorcentajeMva, 0, 100).ToString("F1", inv))%"></i></div>
                                    <strong>@ir.PorcentajeMva.ToString("N1", esMX)%</strong>
                                    <small>@((ir.MvaProyecto ?? 0).ToString("N0", esMX)) de @ir.MvaRegion.ToString("N0", esMX) MVA</small>
                                </div>
                            </div>
                        </div>
                    }
                </div>
                <div class="pam-lamina-foot">
                    <span>PAMRNT 2026–2040 · escenario de Planeación · agregados de la GCR desde la cartera vigente.</span>
                    <span class="pam-lamina-foot__meta">
                        <button type="button" class="pam-home" data-goto="1" title="Volver al índice"><svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M3 11.5 12 4l9 7.5"></path><path d="M5.5 10v9h13v-9"></path></svg></button>
                        07
                    </span>
                </div>
            </section>

            @* ── 08 · Riesgos ── *@
            <section class="pam-slide pam-slide--content" data-slide data-label="Riesgos y dependencias" data-screen-label="08">
                <header class="pam-lamina-head">
                    <span class="pam-lamina-head__kicker">@seccion01</span>
                    <span class="pam-lamina-head__aside">Riesgos y dependencias</span>
                </header>
                <h2 class="pam-lamina-title">Qué puede fallar, cuál es su impacto y cómo mitigarlo.</h2>
                <div class="pam-lamina-body">
                    <div class="pam-risk-grid">
                        @foreach (var riesgo in Model.Ficha.Riesgos)
                        {
                            <article>
                                <i class="bi bi-exclamation-triangle"></i>
                                <h3>@riesgo.Riesgo</h3>
                                <p>@riesgo.Impacto</p>
                                <div><strong>Mitigación</strong><span>@riesgo.Mitigacion</span></div>
                            </article>
                        }
                    </div>
                </div>
                <div class="pam-lamina-foot">
                    <span>PAMRNT 2026–2040 · diagnóstico operativo y alternativas de solución.</span>
                    <span class="pam-lamina-foot__meta">
                        <button type="button" class="pam-home" data-goto="1" title="Volver al índice"><svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M3 11.5 12 4l9 7.5"></path><path d="M5.5 10v9h13v-9"></path></svg></button>
                        08
                    </span>
                </div>
            </section>

            @* ── 09-11 · Alternativas, comparativa y evaluación económica: sólo en fichas
                 enriquecidas (con datos validados). Para las dinámicas se omiten para no
                 dejar láminas "en integración". El índice y el contador se ajustan solos. ── *@
            @if (Model.FichaEnriquecida)
            {
            @* ── 09 · Alternativas ── *@
            <section class="pam-slide pam-slide--content" data-slide data-label="Alternativas" data-screen-label="09">
                <header class="pam-lamina-head">
                    <span class="pam-lamina-head__kicker">@seccion01</span>
                    <span class="pam-lamina-head__aside">Alternativas de solución</span>
                </header>
                <h2 class="pam-lamina-title">Opciones técnicas registradas para el alcance del proyecto.</h2>
                <div class="pam-lamina-body">
                    <div class="pam-alternatives">
                        @foreach (var alternativa in Model.Ficha.Alternativas)
                        {
                            <article class="@(alternativa.Recomendada ? "is-recommended" : null)">
                                @if (alternativa.Recomendada)
                                {
                                    <span class="pam-recommended">Recomendada</span>
                                }
                                <small>@alternativa.Nombre</small>
                                <h3>@alternativa.Tecnologia</h3>
                                <strong>$@alternativa.InversionMdp.ToString("N3", esMX) <em>MDP 2025</em></strong>
                                <p>@alternativa.Alcance</p>
                                <div>@alternativa.Ventaja</div>
                            </article>
                        }
                    </div>
                </div>
                <div class="pam-lamina-foot">
                    <span>PAMRNT 2026–2040 · Ficha @Model.Ficha.ClavePem, alternativas de solución.</span>
                    <span class="pam-lamina-foot__meta">
                        <button type="button" class="pam-home" data-goto="1" title="Volver al índice"><svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M3 11.5 12 4l9 7.5"></path><path d="M5.5 10v9h13v-9"></path></svg></button>
                        09
                    </span>
                </div>
            </section>

            @* ── 10 · Comparativa ── *@
            <section class="pam-slide pam-slide--content" data-slide data-label="Comparativa" data-screen-label="10">
                <header class="pam-lamina-head">
                    <span class="pam-lamina-head__kicker">@seccion01</span>
                    <span class="pam-lamina-head__aside">Comparativa de confiabilidad</span>
                </header>
                <h2 class="pam-lamina-title">Comparación trazable entre alternativas o alcance vigente.</h2>
                <div class="pam-lamina-body">
                    <table class="pam-table pam-table--comparison">
                        <thead>
                            <tr><th>Criterio</th><th>Opción 1</th><th>Opción 2</th><th>Favorable</th></tr>
                        </thead>
                        <tbody>
                            @foreach (var fila in Model.Ficha.Comparativa)
                            {
                                <tr>
                                    <th>@fila.Criterio</th>
                                    <td>@fila.Alternativa1</td>
                                    <td>@fila.Alternativa2</td>
                                    <td><span>@fila.Favorable</span></td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
                <div class="pam-lamina-foot">
                    <span>PAMRNT 2026–2040 · Cuadro 8.4.6.10.</span>
                    <span class="pam-lamina-foot__meta">
                        <button type="button" class="pam-home" data-goto="1" title="Volver al índice"><svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M3 11.5 12 4l9 7.5"></path><path d="M5.5 10v9h13v-9"></path></svg></button>
                        10
                    </span>
                </div>
            </section>

            @* ── 11 · Evaluación económica ── *@
            <section class="pam-slide pam-slide--content" data-slide data-label="Evaluación económica" data-screen-label="11">
                <header class="pam-lamina-head">
                    <span class="pam-lamina-head__kicker">@seccion01</span>
                    <span class="pam-lamina-head__aside">Evaluación económica</span>
                </header>
                <h2 class="pam-lamina-title">Indicadores económicos del alcance vigente.</h2>
                <div class="pam-lamina-body pam-economics">
                    <div class="pam-economics__layout">
                        @if (Model.Ficha.RelacionBeneficioCosto > 0)
                        {
                            <div id="pam-chart-bc" class="pam-chart-bc" data-etiqueta="@(alternativa1?.Nombre ?? "Alcance vigente")"></div>
                        }
                        else
                        {
                            <div class="pam-benefit-ring"><span>Relación B/C</span><strong>@bcTexto</strong><small>@(alternativa1?.Nombre ?? "Alcance vigente")</small></div>
                        }
                        <div class="pam-economics__facts">
                            <article><span>Inversión seleccionada</span><strong>$@Model.Ficha.InversionMdp.ToString("N3", esMX) MDP</strong></article>
                            <article><span>Beneficio neto</span><strong>@beneficioTexto</strong></article>
                            <p>@Model.Ficha.NotaEvaluacionEconomica</p>
                        </div>
                    </div>
                </div>
                <div class="pam-lamina-foot">
                    <span>PAMRNT 2026–2040 · Cuadro 8.4.6.9 · valor presente 2028.</span>
                    <span class="pam-lamina-foot__meta">
                        <button type="button" class="pam-home" data-goto="1" title="Volver al índice"><svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M3 11.5 12 4l9 7.5"></path><path d="M5.5 10v9h13v-9"></path></svg></button>
                        11
                    </span>
                </div>
            </section>
            }

            @* ── 12 · Figuras y diagramas técnicos (1 lámina por imagen registrada en CDN BD; 0 si no hay) ── *@
            @if (Model.TieneRecursosVisuales)
            {
                for (var i = 0; i < Model.Diagramas.Count; i++)
                {
                    var recurso = Model.Diagramas[i];
                    var numLabel = Model.Diagramas.Count == 1 ? "12" : $"12-{(i + 1)}";
                    var numTotal = Model.Diagramas.Count;
                    var figTag = string.IsNullOrWhiteSpace(recurso.NumeroVisual) ? $"Figura {i + 1}" : $"Figura {recurso.NumeroVisual}";
                    <section class="pam-slide pam-slide--content pam-slide--figura" data-slide data-label="@figTag" data-screen-label="@numLabel">
                        <header class="pam-lamina-head">
                            <span class="pam-lamina-head__kicker">@seccion01</span>
                            <span class="pam-lamina-head__aside">
                                @(numTotal > 1 ? $"Diagrama {i + 1} de {numTotal} · " : "")@recurso.TipoLabel
                            </span>
                        </header>
                        <h2 class="pam-lamina-title @(recurso.TituloVisual.Length > 120 ? "is-sm" : "")">
                            @(string.IsNullOrWhiteSpace(recurso.NumeroVisual) ? "" : $"Figura {recurso.NumeroVisual}: ")@recurso.TituloVisual
                        </h2>
                        <div class="pam-lamina-body pam-figura-body">
                            <div class="pam-figura-card">
                                <div class="pam-figura-card__media">
                                    <a href="@recurso.UrlVisual" target="_blank" rel="noopener noreferrer" class="pam-figura-media__link" onclick="window.open(this.href, '_blank', 'noopener,noreferrer'); return false;" title="Abrir diagrama en alta resolución">
                                        <img src="@recurso.UrlVisual" alt="@recurso.AltVisual" loading="eager" />
                                        <span class="pam-figura-media__zoom"><i class="bi bi-zoom-in"></i> Ampliar diagrama</span>
                                    </a>
                                </div>
                                <aside class="pam-figura-card__info">
                                    <div class="pam-figura-card__tag">
                                        <i class="bi bi-diagram-3"></i>
                                        <strong>@recurso.TipoLabel</strong>
                                        @if (recurso.EsCompartida)
                                        {
                                            <span class="pam-figura-card__shared">· Esquema compartido</span>
                                        }
                                    </div>
                                    @if (!string.IsNullOrWhiteSpace(recurso.DescripcionVisual))
                                    {
                                        <div class="pam-figura-card__block">
                                            <span class="pam-chart-caption">Descripción técnica</span>
                                            <p class="pam-figura-card__desc">@recurso.DescripcionVisual</p>
                                        </div>
                                    }
                                    @if (!string.IsNullOrWhiteSpace(recurso.ContextoVisual))
                                    {
                                        <div class="pam-figura-card__block">
                                            <span class="pam-chart-caption">Contexto del proyecto</span>
                                            <p class="pam-figura-card__contexto">@Recortar(recurso.ContextoVisual, 380)</p>
                                        </div>
                                    }
                                    @if (!string.IsNullOrWhiteSpace(recurso.FuenteDescripcion) && !recurso.FuenteDescripcion.ToLowerInvariant().Contains("leyenda"))
                                    {
                                        <div class="pam-figura-card__fuente">
                                            <i class="bi bi-info-circle"></i>
                                            <span>@recurso.FuenteDescripcion</span>
                                        </div>
                                    }
                                </aside>
                            </div>
                        </div>
                        <div class="pam-lamina-foot">
                            <span>PAMRNT 2026–2040 · Ficha ejecutiva @Model.Ficha.ClavePem · @recurso.TipoLabel.</span>
                            <span class="pam-lamina-foot__meta">
                                <button type="button" class="pam-home" data-goto="1" title="Volver al índice"><svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M3 11.5 12 4l9 7.5"></path><path d="M5.5 10v9h13v-9"></path></svg></button>
                                @numLabel
                            </span>
                        </div>
                    </section>
                }
            }

            @* ── 13 · Fases constructivas y estatus de licitación ── *@
            <section class="pam-slide pam-slide--content pam-slide--fases" data-slide data-label="Fases y alineación" data-screen-label="13">
                <header class="pam-lamina-head">
                    <span class="pam-lamina-head__kicker">@seccion01</span>
                    <span class="pam-lamina-head__aside">Fases y licitación</span>
                </header>
                <h2 class="pam-lamina-title">Fases constructivas, estatus de licitación y alineación con la fecha necesaria.</h2>
                <div class="pam-lamina-body">
                    @{ var emp = Model.Empalme; }
                    <div class="pam-empalme @emp.Clase" aria-label="Alineación de cronograma: fecha necesaria contra red lista">
                        <div class="pam-empalme__linea">
                            <div class="pam-empalme__hito">
                                <span>Fecha necesaria</span>
                                <strong title="@emp.FechaNecesariaTexto">@(emp.FechaNecesaria?.ToString("MMM yyyy", esMX) ?? (string.IsNullOrWhiteSpace(emp.FechaNecesariaTexto) ? "—" : emp.FechaNecesariaTexto))</strong>
                            </div>
                            <div class="pam-empalme__gap">
                                @if (emp.Evaluable)
                                {
                                    <b>@(emp.DeltaMeses > 0 ? "+" : "")@emp.DeltaMeses meses</b>
                                }
                                <i aria-hidden="true"></i>
                            </div>
                            <div class="pam-empalme__hito is-feo">
                                <span>Red lista · FEO factible</span>
                                <strong title="@emp.FeoFactibleTexto">@(emp.FeoFactible?.ToString("MMM yyyy", esMX) ?? (string.IsNullOrWhiteSpace(emp.FeoFactibleTexto) ? "—" : emp.FeoFactibleTexto))</strong>
                            </div>
                        </div>
                        <div class="pam-empalme__veredicto">
                            <i aria-hidden="true"></i>
                            <div><strong>@emp.Nivel</strong><small>@emp.Resumen</small></div>
                        </div>
                    </div>
                    <div class="pam-licitacion pam-licitacion--phase-only">
                        <div class="pam-fases">
                            @if (Model.Fases.Count > 0)
                            {
                                <div class="pam-chart-caption">Fases reportadas en el corte vigente</div>
                                <ol class="pam-fases__lista">
                                    @foreach (var fase in Model.Fases)
                                    {
                                        <li class="@fase.EstatusClase">
                                            <i aria-hidden="true"></i>
                                            <div>
                                                <span>@fase.Etiqueta @(string.IsNullOrWhiteSpace(fase.Feo) ? null : $"· FEO {fase.Feo}")</span>
                                                <strong>@fase.EstatusTexto</strong>
                                                <small>Situación: @fase.EstatusSemaforo</small>
                                            </div>
                                        </li>
                                    }
                                </ol>
                            }
                            else
                            {
                                <div class="pam-chart-caption">Estado general del proyecto</div>
                                <div class="pam-fases__unica @NSIE.Models.PamSemaforo.Clase(Model.Proyecto.EstatusLicitacion)">
                                    <i aria-hidden="true"></i>
                                    <div>
                                        <strong>@(string.IsNullOrWhiteSpace(Model.Proyecto.EstatusLicitacion) ? "Por clasificar" : Model.Proyecto.EstatusLicitacion)</strong>
                                        <small>@(string.IsNullOrWhiteSpace(Model.Proyecto.EtapaProyecto) ? "Etapa sin registrar en el corte vigente." : Model.Proyecto.EtapaProyecto)</small>
                                    </div>
                                </div>
                            }
                        </div>
                        <aside class="pam-fases-resumen @emp.Clase">
                            <span>Cumplimiento del hito</span>
                            <strong>@emp.Nivel</strong>
                            <p>@emp.Resumen</p>
                            <small>Diferencia entre la FEO factible y la fecha necesaria del sistema.</small>
                        </aside>
                    </div>
                </div>
                <div class="pam-lamina-foot">
                    <span>Fases del proyecto, estado de ejecución y fecha estimada de operación · corte @fechaCorte.ToString("dd/MM/yyyy").</span>
                    <span class="pam-lamina-foot__meta">
                        <button type="button" class="pam-home" data-goto="1" title="Volver al índice"><svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M3 11.5 12 4l9 7.5"></path><path d="M5.5 10v9h13v-9"></path></svg></button>
                        13
                    </span>
                </div>
            </section>

            @* ── 13A · Datos vigentes de licitación, separados para conservar legibilidad ── *@
            <section class="pam-slide pam-slide--content pam-slide--licitacion-datos" data-slide data-label="Datos de licitación" data-screen-label="13A">
                <header class="pam-lamina-head">
                    <span class="pam-lamina-head__kicker">@seccion01</span>
                    <span class="pam-lamina-head__aside">Datos vigentes de licitación</span>
                </header>
                <h2 class="pam-lamina-title">Ejecución, financiamiento y fechas clave del proyecto.</h2>
                <div class="pam-lamina-body pam-licitacion-datos-body">
                    <div class="pam-licitacion-estado">
                        <div class="pam-licitacion-estado__marca @NSIE.Models.PamSemaforo.Clase(Model.Proyecto.EstatusLicitacion)"><i></i></div>
                        <div>
                            <span>Estatus de licitación</span>
                            <strong>@(string.IsNullOrWhiteSpace(Model.Proyecto.EstatusLicitacion) ? "Por clasificar" : Model.Proyecto.EstatusLicitacion)</strong>
                            <p>@(string.IsNullOrWhiteSpace(Model.Proyecto.EtapaProyecto) ? "Etapa sin registrar en el corte vigente." : Model.Proyecto.EtapaProyecto)</p>
                        </div>
                        <aside><span>Fuente del estado</span><strong>Informe Pormenorizado vigente</strong></aside>
                    </div>
                    <div class="pam-licitacion__datos pam-licitacion__datos--wide">
                        <article>
                            <span>Avance de ejecución</span>
                            <strong>@(detalle?.PorcentajeAvanceEjecucion.HasValue == true ? $"{detalle.PorcentajeAvanceEjecucion.Value.ToString("N2", esMX)}%" : "—")</strong>
                            <div class="pam-avance"><i style="width:@(Math.Clamp(detalle?.PorcentajeAvanceEjecucion ?? 0, 0, 100).ToString("F1", inv))%"></i></div>
                        </article>
                        <article><span>FEO indicada (oficio SENER)</span><strong>@(string.IsNullOrWhiteSpace(detalle?.FeoIndicadaOficioSener) ? "—" : detalle.FeoIndicadaOficioSener)</strong></article>
                        <article><span>Año de instrucción</span><strong>@(detalle?.AnioInstruccion?.ToString() ?? "—")</strong></article>
                        <article class="is-wide"><span>FEO factible</span><strong class="@((detalle?.FeoFactible?.Length ?? 0) > 42 ? "is-compact" : null)">@(string.IsNullOrWhiteSpace(detalle?.FeoFactible) ? "—" : detalle.FeoFactible)</strong></article>
                        <article><span>Financiamiento</span><strong class="@((detalle?.TipoFinanciamiento?.Length ?? 0) > 34 ? "is-compact" : null)">@(string.IsNullOrWhiteSpace(detalle?.TipoFinanciamiento) ? "—" : detalle.TipoFinanciamiento)</strong></article>
                        <article><span>Región</span><strong>@regionProyecto</strong></article>
                    </div>
                </div>
                <div class="pam-lamina-foot">
                    <span>Avance, financiamiento y fechas reportadas para el alcance vigente del proyecto.</span>
                    <span class="pam-lamina-foot__meta">
                        <button type="button" class="pam-home" data-goto="1" title="Volver al índice"><svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M3 11.5 12 4l9 7.5"></path><path d="M5.5 10v9h13v-9"></path></svg></button>
                        13A
                    </span>
                </div>
            </section>

            @if (seguimientoFicha.Count > 0)
            {
                @* ── 13B · Seguimiento operativo complementario ── *@
                <section class="pam-slide pam-slide--content" data-slide data-label="Seguimiento operativo" data-screen-label="13B">
                    <header class="pam-lamina-head">
                        <span class="pam-lamina-head__kicker">@seccion01</span>
                        <span class="pam-lamina-head__aside">Seguimiento CFE Transmisión</span>
                    </header>
                    <h2 class="pam-lamina-title">Avance físico y financiero reportado al @(seguimientoCorteFicha?.FechaCorte.ToString("dd MMMM yyyy", esMX) ?? fechaCorte.ToString("dd MMMM yyyy", esMX)).</h2>
                    <div class="pam-lamina-body pam-seguimiento-slide">
                        <div class="pam-seguimiento-kpis">
                            <article><span>Corte</span><strong>@seguimientoCorteFicha?.FechaCorte.ToString("dd MMM yyyy", esMX)</strong></article>
                            <article><span>Unidades en seguimiento</span><strong>@((seguimientoCorteFicha?.TotalUnidades ?? seguimientoFicha.Select(x => x.SeguimientoUnidadId).Distinct().Count()).ToString("N0", esMX))</strong></article>
                            <article><span>Importe reportado</span><strong>$@seguimientoImporteFicha.ToString("N3", esMX)</strong><small>MDP</small></article>
                            <article><span>Fases / subfases</span><strong>@fasesSeguimientoConteo / @subfasesSeguimientoConteo</strong><small>desglose reportado</small></article>
                        </div>

                        <div class="pam-seguimiento-comparacion">
                            <div>
                                <span>Avance programado</span>
                                <strong>@(seguimientoProgramadoPromedio.HasValue ? seguimientoProgramadoPromedio.Value.ToString("N1", esMX) : "—")%</strong>
                                <i><b style="width:@(Math.Clamp(seguimientoProgramadoPromedio ?? 0, 0, 100).ToString("F1", inv))%"></b></i>
                            </div>
                            <div class="is-real">
                                <span>Avance real</span>
                                <strong>@(seguimientoRealPromedio.HasValue ? seguimientoRealPromedio.Value.ToString("N1", esMX) : "—")%</strong>
                                <i><b style="width:@(Math.Clamp(seguimientoRealPromedio ?? 0, 0, 100).ToString("F1", inv))%"></b></i>
                            </div>
                            <aside>
                                <span>Diferencia promedio</span>
                                <strong>@(seguimientoProgramadoPromedio.HasValue && seguimientoRealPromedio.HasValue ? $"{(seguimientoRealPromedio.Value - seguimientoProgramadoPromedio.Value).ToString("+N1;-N1;N1", esMX)} pp" : "Sin comparación")</strong>
                                <small>Brecha entre el avance real y el programado al corte.</small>
                            </aside>
                        </div>

                        <div class="pam-seguimiento-hitos">
                            <article><span>Inicio del programa</span><strong>@(seguimientoInicioFicha?.ToString("dd MMM yyyy", esMX) ?? "Por definir")</strong><small>primera fecha reportada</small></article>
                            <article><span>Término previsto</span><strong>@(seguimientoTerminoFicha?.ToString("dd MMM yyyy", esMX) ?? "Por definir")</strong><small>última fecha reportada</small></article>
                            <article class="@(seguimientoConRezago > 0 ? "is-alert" : "is-ok")"><span>Unidades con rezago</span><strong>@seguimientoConRezago.ToString("N0", esMX)</strong><small>avance real menor al programado</small></article>
                            <article><span>Última actualización</span><strong>@(seguimientoUltimaActualizacion?.ToString("dd MMM yyyy", esMX) ?? seguimientoCorteFicha?.FechaCorte.ToString("dd MMM yyyy", esMX) ?? "—")</strong><small>seguimiento CFE Transmisión</small></article>
                        </div>
                    </div>
                    <div class="pam-lamina-foot">
                        <span>Fuente: @seguimientoCorteFicha?.FuenteDocumento · corte @seguimientoCorteFicha?.FechaCorte.ToString("dd/MM/yyyy").</span>
                        <span class="pam-lamina-foot__meta">
                            <button type="button" class="pam-home" data-goto="1" title="Volver al índice"><svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M3 11.5 12 4l9 7.5"></path><path d="M5.5 10v9h13v-9"></path></svg></button>
                            13B
                        </span>
                    </div>
                </section>

                @for (var paginaSeguimientoIndex = 0; paginaSeguimientoIndex < seguimientoPaginas.Count; paginaSeguimientoIndex++)
                {
                    var paginaSeguimiento = seguimientoPaginas[paginaSeguimientoIndex];
                    var etiquetaSeguimiento = paginaSeguimientoIndex == 0 ? "13C" : $"13C-{paginaSeguimientoIndex + 1}";
                    var folioSeguimiento = seguimientoPaginas.Count == 1 ? "13·fases" : $"13·fases {paginaSeguimientoIndex + 1}/{seguimientoPaginas.Count}";
                    var inicioRangoSeguimiento = (paginaSeguimientoIndex * 5) + 1;
                    var finRangoSeguimiento = inicioRangoSeguimiento + paginaSeguimiento.Length - 1;
                    <section class="pam-slide pam-slide--content" data-slide data-label="Fases y subfases @(paginaSeguimientoIndex + 1)" data-screen-label="@etiquetaSeguimiento">
                        <header class="pam-lamina-head">
                            <span class="pam-lamina-head__kicker">@seccion01</span>
                            <span class="pam-lamina-head__aside">Programa por fase y subfase</span>
                        </header>
                        <h2 class="pam-lamina-title">Fases, subfases, periodo de ejecución y avance físico del proyecto.</h2>
                        <div class="pam-lamina-body pam-fases-seguimiento">
                            <div class="pam-fases-seguimiento__head"><span>Unidad / elemento</span><span>Fase inicial</span><span>Subfase(s)</span><span>Periodo</span><span>Avance P / R</span><span>Importe</span></div>
                            @foreach (var registro in paginaSeguimiento)
                            {
                                var avanceProgramadoRegistro = registro.AvanceProgramado.HasValue
                                    ? (registro.AvanceProgramado <= 1 ? registro.AvanceProgramado.Value * 100 : registro.AvanceProgramado.Value)
                                    : (decimal?)null;
                                var avanceRealRegistro = registro.AvanceReal.HasValue
                                    ? (registro.AvanceReal <= 1 ? registro.AvanceReal.Value * 100 : registro.AvanceReal.Value)
                                    : (decimal?)null;
                                var inicioRegistro = registro.FechaInicioConstruccionReal ?? registro.FechaInicioConstruccionProgramada
                                    ?? registro.FechaInicioConcursoReal ?? registro.FechaInicioConcursoProgramada;
                                var terminoRegistro = registro.FechaTerminoConstruccion ?? registro.FechaEstimadaTerminoCalculada;
                                var registroConRezago = avanceProgramadoRegistro.HasValue && avanceRealRegistro.HasValue && avanceRealRegistro.Value < avanceProgramadoRegistro.Value;
                                <article class="@(registroConRezago ? "is-alert" : null)">
                                    <div><code title="@registro.CodigoUnico">@Recortar(registro.CodigoUnico, 30)</code><strong title="@registro.NombreProyecto">@Recortar(registro.NombreProyecto, 45)</strong></div>
                                    <span title="@registro.FaseInicial">@(string.IsNullOrWhiteSpace(registro.FaseInicial) ? "—" : Recortar(registro.FaseInicial, 22))</span>
                                    <span title="@registro.FasesSubsecuentes">@(string.IsNullOrWhiteSpace(registro.FasesSubsecuentes) ? "—" : Recortar(registro.FasesSubsecuentes, 28))</span>
                                    <span><b>@(inicioRegistro?.ToString("MMM yyyy", esMX) ?? "—")</b><small>@(terminoRegistro?.ToString("MMM yyyy", esMX) ?? (string.IsNullOrWhiteSpace(registro.FeoFactible) ? "—" : Recortar(registro.FeoFactible, 16)))</small></span>
                                    <span class="pam-fases-seguimiento__avance"><b>@(avanceProgramadoRegistro.HasValue ? $"{avanceProgramadoRegistro.Value.ToString("N1", esMX)}%" : "—")</b><small class="@(registroConRezago ? "is-alert" : null)">@(avanceRealRegistro.HasValue ? $"{avanceRealRegistro.Value.ToString("N1", esMX)}%" : "—")</small></span>
                                    <span>@(registro.ImporteMdp.HasValue ? $"${registro.ImporteMdp.Value.ToString("N3", esMX)}" : "—")<small>MDP</small></span>
                                </article>
                            }
                        </div>
                        <div class="pam-lamina-foot">
                            <span>Fuente: @seguimientoCorteFicha?.FuenteDocumento · corte @seguimientoCorteFicha?.FechaCorte.ToString("dd/MM/yyyy") · unidades @inicioRangoSeguimiento–@finRangoSeguimiento de @seguimientoOrdenado.Count.</span>
                            <span class="pam-lamina-foot__meta">
                                <button type="button" class="pam-home" data-goto="1" title="Volver al índice"><svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M3 11.5 12 4l9 7.5"></path><path d="M5.5 10v9h13v-9"></path></svg></button>
                                @folioSeguimiento
                            </span>
                        </div>
                    </section>
                }
            }

            @* ── 14 · Divisoria Sección 02 ── *@
            <section class="pam-slide pam-slide--divider" data-slide data-label="Sección 02" data-screen-label="14">
                <i class="pam-divider__bar" aria-hidden="true"></i>
                <div class="pam-divider__logos">
                    <img src="~/img/pamrnt/logo_gob.png" alt="Gobierno de México" />
                    <i></i>
                    <img src="~/img/pamrnt/logo_sener.png" alt="Secretaría de Energía" />
                </div>
                <button type="button" class="pam-home pam-divider__home" data-goto="1" title="Volver al índice">
                    <svg width="21" height="21" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M3 11.5 12 4l9 7.5"></path><path d="M5.5 10v9h13v-9"></path></svg>
                </button>
                <div class="pam-divider__big" aria-hidden="true">02</div>
                <div class="pam-divider__kicker"><span></span>Sección 02</div>
                <h1>Cierre y trazabilidad</h1>
                <div class="pam-divider__sub">
                    <i></i>
                    <p>Conclusión ejecutiva, próximos pasos y soporte documental del proyecto.</p>
                </div>
            </section>

            @* ── 15 · Conclusión ── *@
            <section class="pam-slide pam-slide--content" data-slide data-label="Conclusión" data-screen-label="15">
                <header class="pam-lamina-head">
                    <span class="pam-lamina-head__kicker">@seccion02</span>
                    <span class="pam-lamina-head__aside">Conclusión ejecutiva</span>
                </header>
                <h2 class="pam-lamina-title">Conclusión ejecutiva para @Model.Ficha.ClavePem.</h2>
                <div class="pam-lamina-body pam-conclusion">
                    <p class="pam-lead">@Model.Ficha.ConclusionEjecutiva</p>
                    <div class="pam-conclusion__grid">
                        <article><i class="bi bi-lightning-charge"></i><strong>Alcance</strong><span>@Model.Ficha.AlternativaSeleccionada</span></article>
                        <article><i class="bi bi-geo-alt"></i><strong>Beneficio regional</strong><span>@Model.Ficha.CorredorPrincipal</span></article>
                        <article><i class="bi bi-graph-up"></i><strong>Rentabilidad</strong><span>Relación B/C: @bcTexto.</span></article>
                    </div>
                </div>
                <div class="pam-lamina-foot">
                    <span>PAMRNT 2026–2040 · conclusión de la alternativa seleccionada.</span>
                    <span class="pam-lamina-foot__meta">
                        <button type="button" class="pam-home" data-goto="1" title="Volver al índice"><svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M3 11.5 12 4l9 7.5"></path><path d="M5.5 10v9h13v-9"></path></svg></button>
                        15
                    </span>
                </div>
            </section>

            @* ── 16 · Aplicación y trazabilidad ── *@
            <section class="pam-slide pam-slide--content" data-slide data-label="Aplicación y trazabilidad" data-screen-label="16">
                <header class="pam-lamina-head">
                    <span class="pam-lamina-head__kicker">@seccion02</span>
                    <span class="pam-lamina-head__aside">Versión vigente y evidencia documental</span>
                </header>
                <h2 class="pam-lamina-title">Situación vigente, cambios recientes y asuntos por validar.</h2>
                <div class="pam-lamina-body pam-application-evidence">
                    <section class="pam-evidence__consolidated" aria-labelledby="pam-hechos-consolidados">
                        <div class="pam-evidence__section-head">
                            <span id="pam-hechos-consolidados"><i class="bi bi-check-circle" aria-hidden="true"></i> Hechos consolidados en cartera</span>
                            <small>Versión, vigencia y cambios recientes del proyecto.</small>
                        </div>
                        <dl class="pam-evidence__facts">
                            <div><dt>Versión vigente</dt><dd>V@(versionVigente?.NumeroVersion ?? detalle?.NumeroVersion ?? 1)</dd></div>
                            <div><dt>Vigente desde</dt><dd>@((versionVigente?.VigenteDesde ?? detalle?.VigenteDesde)?.ToString("yyyy-MM-dd") ?? "—")</dd></div>
                            <div><dt>Estado de cartera</dt><dd>@Model.Proyecto.EstadoVigenciaCartera</dd></div>
                            <div><dt>Fuente y corte</dt><dd>@fechaCorte.ToString("yyyy-MM-dd") · @Model.Proyecto.FuenteDocumento</dd></div>
                        </dl>

                        <div class="pam-evidence__subhead">Última aplicación y cambios recientes</div>
                        @if (cambiosRecientes.Count == 0)
                        {
                            <p class="pam-evidence__empty">No hay cambios detallados posteriores registrados para este proyecto.</p>
                        }
                        else
                        {
                            <ul class="pam-evidence__changes">
                                @foreach (var cambio in cambiosRecientes)
                                {
                                    <li>
                                        <strong>@cambio.CampoEtiqueta</strong>
                                        <span>@(cambio.EsAlta ? "Alta registrada en cartera" : $"Actualizado el {cambio.FechaRegistroUtc:yyyy-MM-dd}")</span>
                                        @if (!string.IsNullOrWhiteSpace(cambio.FuenteDocumento))
                                        {
                                            <small>Fuente: @cambio.FuenteDocumento · corte @cambio.FechaCorte.ToString("yyyy-MM-dd")</small>
                                        }
                                    </li>
                                }
                            </ul>
                        }
                    </section>

                    <aside class="pam-evidence__support" aria-label="Soporte documental y pendientes de validación">
                        <section class="pam-origin-record @(expedienteOrigen?.TieneVinculo == true ? "is-linked" : "is-pending")" aria-labelledby="pam-expediente-origen">
                            <div class="pam-evidence__section-head">
                                <span id="pam-expediente-origen"><i class="bi bi-file-earmark-text" aria-hidden="true"></i> Expediente pormenorizado de origen</span>
                                <small>@(expedienteOrigen?.Estado ?? "Pendiente de vinculación")</small>
                            </div>
                            @if (expedienteOrigen?.TieneVinculo == true)
                            {
                                <dl class="pam-origin-record__facts">
                                    <div><dt>Registro</dt><dd>#@expedienteOrigen.ProyectoModernizacionId@(expedienteOrigen.Numero.HasValue ? $" · No. {expedienteOrigen.Numero}" : string.Empty)</dd></div>
                                    <div><dt>Clave PEM</dt><dd>@expedienteOrigen.ClavePem</dd></div>
                                    <div><dt>Vinculación documental</dt><dd>@expedienteOrigen.MetodoVinculo</dd></div>
                                    <div><dt>Fuente y corte de origen</dt><dd>@(string.IsNullOrWhiteSpace(expedienteOrigen.FuenteDocumento) ? "Fuente histórica no especificada" : expedienteOrigen.FuenteDocumento)@(expedienteOrigen.FechaCarga.HasValue ? $" · carga {expedienteOrigen.FechaCarga:yyyy-MM-dd}" : string.Empty)</dd></div>
                                </dl>
                                <a class="pam-origin-record__link" href="@expedienteOrigen.UrlDetalle"><i class="bi bi-box-arrow-up-right" aria-hidden="true"></i> Consultar registro pormenorizado</a>
                            }
                            else
                            {
                                <p>@(expedienteOrigen?.Mensaje ?? "No existe un vínculo comprobable al expediente pormenorizado.")</p>
                                <small>Referencia: @(expedienteOrigen?.MetodoVinculo ?? "No disponible")</small>
                            }
                        </section>
                        <div class="pam-evidence__section-head">
                            <span><i class="bi bi-link-45deg" aria-hidden="true"></i> Fuentes y relaciones</span>
                            <small>@fuentes fuente(s) documentales · @relacionesVigentes.Count relación(es) vigente(s)</small>
                        </div>
                        @if (fuentesPorCampo.Count > 0)
                        {
                            <ul class="pam-evidence__sources">
                                @foreach (var fuenteCampo in fuentesPorCampo)
                                {
                                    <li><strong>@fuenteCampo.Campo</strong><span>@fuenteCampo.Fuente · @fuenteCampo.Corte.ToString("yyyy-MM-dd")</span></li>
                                }
                            </ul>
                        }
                        else
                        {
                            <p class="pam-evidence__empty">No se reportan cambios de fuente por campo.</p>
                        }
                        @if (relacionesVigentes.Count > 0)
                        {
                            <ul class="pam-evidence__relations" aria-label="Relaciones vigentes">
                                @foreach (var relacion in relacionesVigentes)
                                {
                                    <li><strong>@relacion.TipoRelacion</strong><span>@relacion.Direccion · @relacion.ClaveRelacionada — @relacion.NombreRelacionado</span></li>
                                }
                            </ul>
                        }
                        <div class="pam-evidence__pending" role="note">
                            <strong><i class="bi bi-exclamation-triangle" aria-hidden="true"></i> Pendientes de validación</strong>
                            @if (pendientesValidacion.Count == 0)
                            {
                                <span>No se reportan pendientes de validación en el corte vigente.</span>
                            }
                            else
                            {
                                <ul>
                                    @foreach (var pendiente in pendientesValidacion)
                                    {
                                        <li>@pendiente</li>
                                    }
                                </ul>
                            }
                        </div>
                    </aside>
                </div>
                <div class="pam-lamina-foot">
                    <span>Versión vigente, soporte documental y pendientes de validación del proyecto.</span>
                    <span class="pam-lamina-foot__meta">
                        <button type="button" class="pam-home" data-goto="1" title="Volver al índice"><svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M3 11.5 12 4l9 7.5"></path><path d="M5.5 10v9h13v-9"></path></svg></button>
                        16
                    </span>
                </div>
            </section>

            @* ── 17 · Divisoria Sección 03 · Anexos ── *@
            <section class="pam-slide pam-slide--divider" data-slide data-label="Sección 03" data-screen-label="17">
                <i class="pam-divider__bar" aria-hidden="true"></i>
                <div class="pam-divider__logos">
                    <img src="~/img/pamrnt/logo_gob.png" alt="Gobierno de México" />
                    <i></i>
                    <img src="~/img/pamrnt/logo_sener.png" alt="Secretaría de Energía" />
                </div>
                <button type="button" class="pam-home pam-divider__home" data-goto="1" title="Volver al índice">
                    <svg width="21" height="21" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M3 11.5 12 4l9 7.5"></path><path d="M5.5 10v9h13v-9"></path></svg>
                </button>
                <div class="pam-divider__big" aria-hidden="true">03</div>
                <div class="pam-divider__kicker"><span></span>Sección 03</div>
                <h1>Anexos</h1>
                <div class="pam-divider__sub">
                    <i></i>
                    <p>Historial de versiones y modificaciones documentadas del proyecto.</p>
                </div>
            </section>

            @* ── 18 · Anexo A: Historial de versiones ── *@
            <section class="pam-slide pam-slide--content" data-slide data-label="Historial de versiones" data-screen-label="18">
                <header class="pam-lamina-head">
                    <span class="pam-lamina-head__kicker">Sección 03 · Anexos</span>
                    <span class="pam-lamina-head__aside">Anexo A · Historial de versiones</span>
                </header>
                <h2 class="pam-lamina-title">Evolución de las versiones documentadas del proyecto.</h2>
                <div class="pam-lamina-body">
                    @if (historialVersiones.Count == 0)
                    {
                        <div class="pam-annex-empty">
                            <i class="bi bi-clock-history"></i>
                            <strong>No hay versiones históricas registradas.</strong>
                            <span>El proyecto aún no cuenta con versiones históricas anteriores al corte vigente.</span>
                        </div>
                    }
                    else
                    {
                        <table class="pam-table pam-table--annex">
                            <thead>
                                <tr><th>Versión</th><th>Vigencia</th><th>Estado</th><th>Fuente documental</th><th>Corte</th></tr>
                            </thead>
                            <tbody>
                                @foreach (var version in historialVersiones)
                                {
                                    <tr class="@(version.EsVersionVigente ? "is-highlighted" : null)">
                                        <td>V@(version.NumeroVersion)</td>
                                        <td>@(version.EsVersionVigente ? "Vigente" : "Histórica")</td>
                                        <td>@version.EstadoVigenciaCartera</td>
                                        <td>@version.FuenteDocumento</td>
                                        <td>@version.FechaCorte.ToString("yyyy-MM-dd")</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    }
                </div>
                <div class="pam-lamina-foot">
                    <span>Historial de versiones, vigencias y fuentes documentales del proyecto.</span>
                    <span class="pam-lamina-foot__meta">
                        <button type="button" class="pam-home" data-goto="1" title="Volver al índice"><svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M3 11.5 12 4l9 7.5"></path><path d="M5.5 10v9h13v-9"></path></svg></button>
                        18
                    </span>
                </div>
            </section>

            @* ── 19 · Anexo B: Línea de tiempo de modificaciones ── *@
            @if (paginasCambios.Count == 0)
            {
                <section class="pam-slide pam-slide--content" data-slide data-label="Línea de tiempo" data-screen-label="19">
                    <header class="pam-lamina-head">
                        <span class="pam-lamina-head__kicker">Sección 03 · Anexos</span>
                        <span class="pam-lamina-head__aside">Anexo B · Línea de tiempo</span>
                    </header>
                    <h2 class="pam-lamina-title">Trazabilidad del seguimiento: qué cambió, cuándo y desde qué fuente.</h2>
                    <div class="pam-lamina-body">
                        <div class="pam-annex-empty">
                            <i class="bi bi-bar-chart-steps"></i>
                            <strong>No hay cambios detallados capturados.</strong>
                            <span>No se registran modificaciones entre cortes documentales para este proyecto.</span>
                        </div>
                    </div>
                    <div class="pam-lamina-foot">
                        <span>Cambios por corte documental: valor anterior, valor vigente y fuente.</span>
                        <span class="pam-lamina-foot__meta">
                            <button type="button" class="pam-home" data-goto="1" title="Volver al índice"><svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M3 11.5 12 4l9 7.5"></path><path d="M5.5 10v9h13v-9"></path></svg></button>
                            19
                        </span>
                    </div>
                </section>
            }
            else
            {
                @for (var paginaIndex = 0; paginaIndex < paginasCambios.Count; paginaIndex++)
                {
                    var paginaCambio = paginasCambios[paginaIndex];
                    var etiquetaPantalla = paginaIndex == 0 ? "19" : $"19-{paginaIndex + 1}";
                    var folioPagina = paginaIndex == 0 ? "19" : $"19·{paginaIndex + 1}";
                    <section class="pam-slide pam-slide--content" data-slide data-label="Línea de tiempo @(paginaIndex + 1)" data-screen-label="@etiquetaPantalla">
                        <header class="pam-lamina-head">
                            <span class="pam-lamina-head__kicker">Sección 03 · Anexos</span>
                            <span class="pam-lamina-head__aside">Anexo B · Línea de tiempo · @(paginaIndex + 1)/@paginasCambios.Count</span>
                        </header>
                        <h2 class="pam-lamina-title">Trazabilidad del seguimiento: qué cambió, cuándo y desde qué fuente.</h2>
                        <div class="pam-lamina-body">
                        <ol class="pam-trace-log">
                            <li class="pam-trace-log__item">
                                <div class="pam-trace-log__hito">
                                    <time>@paginaCambio.FechaCorte.ToString("dd MMM yyyy", esMX)</time>
                                    <span title="@paginaCambio.FuenteDocumento">@paginaCambio.FuenteDocumento</span>
                                    @if (paginaCambio.TotalPartesFuente > 1)
                                    {
                                        <small>Bloque @paginaCambio.ParteFuente de @paginaCambio.TotalPartesFuente</small>
                                    }
                                </div>
                                <div class="pam-trace-log__cambios">
                                    @foreach (var c in paginaCambio.Cambios)
                                    {
                                        if (c.EsAlta)
                                        {
                                            <div class="pam-trace-chip is-alta"><b>Alta en la cartera</b><span>Fotografía inicial del proyecto</span></div>
                                        }
                                        else
                                        {
                                            <div class="pam-trace-chip">
                                                <b>@c.CampoEtiqueta</b>
                                                <span class="pam-trace-diff">
                                                    <del title="@c.AntesFormateado">@c.AntesFormateado</del>
                                                    <i aria-hidden="true">→</i>
                                                    <ins title="@c.DespuesFormateado">@c.DespuesFormateado</ins>
                                                </span>
                                            </div>
                                        }
                                    }
                                </div>
                            </li>
                        </ol>
                        </div>
                        <div class="pam-lamina-foot">
                            <span>Modificaciones del proyecto por fecha de corte y fuente documental.</span>
                            <span class="pam-lamina-foot__meta">
                                <button type="button" class="pam-home" data-goto="1" title="Volver al índice"><svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M3 11.5 12 4l9 7.5"></path><path d="M5.5 10v9h13v-9"></path></svg></button>
                                @folioPagina
                            </span>
                        </div>
                    </section>
                }
            }

            @* ── 20 · Contraportada (patrón insumo: mujer, banda Gracias, divisor dorado, social, código, QR) ── *@
            <section class="pam-slide pam-slide--back" data-slide data-label="Contraportada" data-screen-label="20">
                <div class="pam-back__top">
                    <button type="button" class="pam-home" data-goto="1" title="Volver al índice">
                        <svg width="21" height="21" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M3 11.5 12 4l9 7.5"></path><path d="M5.5 10v9h13v-9"></path></svg>
                    </button>
                    <div class="pam-back__logos">
                        <img src="~/img/pamrnt/logo_gob.png" alt="Gobierno de México" />
                        <i></i>
                        <img src="~/img/pamrnt/logo_sener.png" alt="Secretaría de Energía" />
                    </div>
                </div>
                <div class="pam-back__body">
                    <img class="pam-back__figure" src="~/img/pamrnt/mujer.png" alt="" aria-hidden="true" />
                    <div class="pam-back__center">
                        <div class="pam-back__band"><span>Gracias</span></div>
                        <div class="pam-back__divider"><span></span><i></i><span></span></div>
                        <p>A todas y todos los que hacen posible, con energía y compromiso, construir un México más justo, soberano y sostenible.</p>
                    </div>
                </div>
                <div class="pam-back__goldline"></div>
                <div class="pam-back__footer">
                    <div class="pam-back__institution">
                        <strong>Secretaría de Energía</strong>
                        <span>Subsecretaría de Planeación y Transición Energética</span>
                        <div class="pam-back__social">
                            <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor" aria-label="Facebook"><path d="M13.5 9H16l.4-3H13.5V4.2c0-.85.25-1.4 1.5-1.4h1.5V.1C16.1.07 15.1 0 14 0c-2.35 0-3.9 1.42-3.9 4.03V6H7.5v3h2.6v9h3.4V9z"></path></svg>
                            <svg width="17" height="17" viewBox="0 0 24 24" fill="currentColor" aria-label="X"><path d="M18.24 2H21.5l-7.5 8.57L22.5 22h-6.9l-4.62-6.04L5.6 22H2.34l8.02-9.17L1.5 2h6.97l4.18 5.52L18.24 2zm-1.2 18h1.92L7.04 4H5.0l12.04 16z"></path></svg>
                            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-label="Instagram"><rect x="3" y="3" width="18" height="18" rx="5"></rect><circle cx="12" cy="12" r="4"></circle><circle cx="17.4" cy="6.6" r="1.1" fill="currentColor" stroke="none"></circle></svg>
                            <svg width="21" height="18" viewBox="0 0 24 24" fill="currentColor" aria-label="YouTube"><path d="M23 7.5s-.2-1.6-.9-2.3c-.9-.95-1.85-.95-2.3-1C16.9 4 12 4 12 4s-4.9 0-7.8.2c-.45.05-1.4.05-2.3 1C1.2 5.9 1 7.5 1 7.5S.8 9.4.8 11.3v1.3C.8 14.5 1 16.4 1 16.4s.2 1.6.9 2.3c.9.95 2.1.92 2.6 1.02C7.2 19.9 12 20 12 20s4.9 0 7.8-.2c.45-.05 1.4-.05 2.3-1 .7-.7.9-2.3.9-2.3s.2-1.9.2-3.8v-1.3c0-1.9-.2-3.8-.2-3.8zM9.8 14.8V8.9l5.1 2.95-5.1 2.95z"></path></svg>
                            <i></i>
                            <b>gob.mx/sener</b>
                        </div>
                        <div class="pam-back__barcode" aria-hidden="true">
                            <svg viewBox="0 0 160 35" preserveAspectRatio="none" focusable="false">
                                @for (var barraX = 0; barraX < 160; barraX += 15)
                                {
                                    <rect x="@barraX" y="0" width="2" height="35"></rect>
                                    <rect x="@(barraX + 5)" y="0" width="1" height="35"></rect>
                                    <rect x="@(barraX + 10)" y="0" width="3" height="35"></rect>
                                }
                            </svg>
                        </div>
                        <div class="pam-back__code">SENER·PAMRNT·@Model.Ficha.ClavePem·@DateTime.Now.Year</div>
                    </div>
                    <div class="pam-back__qrblock">
                        <div class="pam-back__qrtext">
                            <strong>Conoce el programa completo</strong>
                            <span>Escanea el código y visita el portal de la SENER.</span>
                        </div>
                        <div class="pam-back__qr" aria-hidden="true">
                            <span style="grid-column:1/3;grid-row:1/3;"></span><span style="grid-column:6/8;grid-row:1/3;"></span><span style="grid-column:4;grid-row:2;"></span><span style="grid-column:1/3;grid-row:6/8;"></span><span style="grid-column:3;grid-row:4;"></span><span style="grid-column:5;grid-row:5;"></span><span style="grid-column:4;grid-row:6;"></span><span style="grid-column:6;grid-row:5;"></span><span style="grid-column:7;grid-row:4;"></span><span style="grid-column:5;grid-row:7;"></span>
                        </div>
                    </div>
                </div>
            </section>

            <nav id="pam-presentation-controls" class="pam-presentation-controls" aria-label="Controles de presentación">
                <button type="button" data-prev title="Lámina anterior"><i class="bi bi-chevron-left"></i></button>
                <button type="button" data-goto="1" title="Ir al índice"><i class="bi bi-list-ul"></i></button>
                <span data-counter>01 / 20</span>
                <button type="button" data-export="pdf" title="Descargar PDF"><i class="bi bi-file-earmark-pdf"></i></button>
                <button type="button" data-export="pptx" title="Descargar PowerPoint"><i class="bi bi-file-earmark-slides"></i></button>
                <button type="button" data-fullscreen title="Pantalla completa"><i class="bi bi-arrows-fullscreen"></i></button>
                <button type="button" data-next title="Lámina siguiente"><i class="bi bi-chevron-right"></i></button>
            </nav>
        </div>
    </div>

    <div id="pam-export-status" class="pam-export-status" hidden role="status" aria-live="polite">
        <div class="pam-export-status__spinner"></div><strong>Preparando archivo</strong><span data-export-message></span>
    </div>
</main>

<script>
    window.pamFichaCharts = {
        dona: @Html.Raw(jsonDona),
        donaCentroValor: "@donaCentroValor",
        donaCentroEtiqueta: "@donaCentroEtiqueta",
        bc: @Model.Ficha.RelacionBeneficioCosto.ToString(inv),
        bcEtiqueta: "@(alternativa1?.Nombre ?? "Alcance vigente")",
        demanda: @Html.Raw(jsonDemanda)
    };
</script>
