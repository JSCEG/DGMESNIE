            @* ── 12 · Diagramas y geoespacial (recursos BD) ── *@
            <section class="pam-slide pam-slide--content" data-slide data-label="Diagramas y geoespacial" data-screen-label="12">
                <header class="pam-lamina-head">
                    <span class="pam-lamina-head__kicker">@seccion01</span>
                    <span class="pam-lamina-head__aside">Recursos técnicos del proyecto</span>
                </header>
                <h2 class="pam-lamina-title">Diagrama unifilar, mapa geoespacial y lámina C7U según disponibilidad.</h2>
                <div class="pam-lamina-body pam-network">
                    @if (recursosVisuales.Count > 0)
                    {
                        <div class="pam-assets-grid @(recursosVisuales.Count == 1 ? "is-single" : null)">
                            @foreach (var recurso in recursosVisuales.Take(3))
                            {
                                <article class="pam-asset-card">
                                    <div class="pam-asset-card__media">
                                        @if (!string.IsNullOrWhiteSpace(recurso.Url))
                                        {
                                            <img src="@recurso.Url" alt="@(string.IsNullOrWhiteSpace(recurso.AltText) ? recurso.Titulo : recurso.AltText)" />
                                        }
                                        else
                                        {
                                            <div class="pam-asset-card__placeholder"><i class="fas fa-image"></i><span>Recurso pendiente</span></div>
                                        }
                                    </div>
                                    <div class="pam-asset-card__caption">
                                        <strong>@recurso.Titulo</strong>
                                        <span>@recurso.Descripcion</span>
                                    </div>
                                </article>
                            }
                        </div>
                    }
                    else
                    {
                        <div class="pam-network__canvas pam-network__canvas--placeholder">
                            <div class="pam-empty-resource"><i class="fas fa-map-location-dot"></i><strong>Recursos visuales pendientes</strong><span>La ficha reserva este espacio para diagrama unifilar, geoespacial, lámina C7U, ambos o ninguno. Se activará automáticamente al registrar el PNG o URL en la base de datos.</span></div>
                            <div class="pam-network__badge"><strong>@Model.Ficha.TotalObras</strong><span>obras / relaciones registradas</span></div>
                        </div>
                    }
                    <div class="pam-physical-metrics">
                        @foreach (var meta in Model.Ficha.MetasFisicas)
