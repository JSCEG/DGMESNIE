@model NSIE.Models.PamPreparacionAplicacionViewModel

@{
    ViewData["Title"] = $"Preparar aplicación del lote {Model.Lote.LoteId}";
    var paqueteSuccessMessage = TempData["PamPaqueteSuccess"] as string;
    var paqueteErrorMessage = TempData["PamPaqueteError"] as string;
    var aplicacionSuccessMessage = TempData["PamAplicacionSuccess"] as string;
    var aplicacionErrorMessage = TempData["PamAplicacionError"] as string;

    string EtiquetaCampo(string campo) => campo switch
    {
        "NombreProyecto" => "Nombre del proyecto",
        "GRT" => "Región de transmisión",
        "EtapaProyecto" => "Etapa del proyecto",
        "FechaNecesaria" => "Fecha necesaria",
        "FeoFactible" => "Fecha de entrada en operación",
        "MontoProyectoMdp" => "Inversión (MDP)",
        "EstadoRealProyecto" => "Estado reportado",
        "AnioInstruccion" => "Año de instrucción",
        _ => campo ?? "Campo"
    };

    string HashCorto(string hash) => string.IsNullOrWhiteSpace(hash)
        ? "Sin hash"
        : hash[..Math.Min(12, hash.Length)];

    string UidCorto(Guid? uid) => uid.HasValue
        ? uid.Value.ToString()[..8]
        : "Sin UID";
}

@await Html.PartialAsync("_ViewHeader", Model.Header)

<div class="container-fluid shell-page-container py-3 pam-prepare-page">
    @if (!string.IsNullOrWhiteSpace(paqueteSuccessMessage))
    {
        <div class="alert pam-package-message is-success" role="status"><i class="fas fa-circle-check" aria-hidden="true"></i>@paqueteSuccessMessage</div>
    }
    @if (!string.IsNullOrWhiteSpace(paqueteErrorMessage))
    {
        <div class="alert pam-package-message is-error" role="alert"><i class="fas fa-circle-xmark" aria-hidden="true"></i>@paqueteErrorMessage</div>
    }
    @if (!string.IsNullOrWhiteSpace(aplicacionSuccessMessage))
    {
        <div class="alert pam-package-message is-success" role="status"><i class="fas fa-circle-check" aria-hidden="true"></i>@aplicacionSuccessMessage</div>
    }
    @if (!string.IsNullOrWhiteSpace(aplicacionErrorMessage))
    {
        <div class="alert pam-package-message is-error" role="alert"><i class="fas fa-circle-xmark" aria-hidden="true"></i>@aplicacionErrorMessage</div>
    }
    <nav class="pam-prepare-nav" aria-label="Navegación de preparación">
        <a asp-action="ActualizacionDetalle" asp-route-loteId="@Model.Lote.LoteId" class="btn btn-outline-secondary">
            <i class="fas fa-arrow-left me-2" aria-hidden="true"></i>Volver a la revisión
        </a>
        <a asp-action="Index" class="btn btn-link pam-dashboard-link">
            <i class="fas fa-table-columns me-2" aria-hidden="true"></i>Dashboard de proyectos
        </a>
    </nav>

    <header class="pam-prepare-hero">
        <div>
            <span>Vista previa controlada</span>
            <h2>Preparar aplicación a la cartera</h2>
            <p>@Model.Lote.Nombre · corte @Model.Lote.FechaCorte.ToString("dd MMM yyyy") · análisis #@Model.AnalisisId</p>
        </div>
        <div class="pam-prepare-lock"><i class="fas fa-lock" aria-hidden="true"></i>Sin cambios en SQL</div>
    </header>

    @if (!Model.ListaParaConfirmar)
    {
        <section class="pam-prepare-alert is-warning" role="status">
            <i class="fas fa-triangle-exclamation" aria-hidden="true"></i>
            <div>
                <strong>La aplicación todavía no está lista.</strong>
                <span>Faltan @Model.TotalPendientes decisión(es): @Model.Pendientes.Count de altas/cancelaciones y @Model.ResumenCampos.Pendientes de campos. Atiéndalas antes de confirmar cualquier cambio en la cartera maestra.</span>
            </div>
            <a asp-action="ActualizacionDetalle" asp-route-loteId="@Model.Lote.LoteId" asp-route-estadoRevision="Pendiente" class="btn btn-primary">Resolver pendientes</a>
        </section>
    }
    else
    {
        <section class="pam-prepare-alert is-success" role="status">
            <i class="fas fa-circle-check" aria-hidden="true"></i>
            <div>
                <strong>Todas las decisiones están cerradas.</strong>
                <span>La vista previa está lista para una confirmación final separada y trazable.</span>
            </div>
        </section>
    }

    <section class="pam-prepare-kpis" aria-label="Resumen de acciones preparadas">
        <article><span>Altas vigentes</span><strong>@Model.TotalAltas</strong><i class="fas fa-circle-plus" aria-hidden="true"></i></article>
        <article><span>Claves a vincular</span><strong>@Model.TotalVinculos</strong><i class="fas fa-link" aria-hidden="true"></i></article>
        <article><span>Antecedentes cancelados</span><strong>@Model.TotalAntecedentesCancelados</strong><i class="fas fa-clock-rotate-left" aria-hidden="true"></i></article>
        <article><span>Existentes a cancelar</span><strong>@Model.TotalCancelacionesVinculadas</strong><i class="fas fa-ban" aria-hidden="true"></i></article>
        <article><span>Sin aplicación</span><strong>@Model.TotalDescartados</strong><i class="fas fa-box-archive" aria-hidden="true"></i></article>
        <article class="@(Model.TotalPendientes > 0 ? "is-warning" : "is-success")"><span>Pendientes totales</span><strong>@Model.TotalPendientes</strong><i class="fas fa-list-check" aria-hidden="true"></i></article>
    </section>

    <section class="pam-prepare-card pam-validation-card">
        <div class="pam-prepare-heading">
            <div><span>Control previo</span><h3>@(Model.TienePaqueteVigente ? "Advertencias aceptadas al congelar" : "Validaciones del paquete")</h3></div>
            <div class="pam-validation-totals">
                <strong class="@(Model.TotalBloqueos > 0 ? "is-block" : "is-ok")">@Model.TotalBloqueos bloqueo(s)</strong>
                <strong class="@(Model.TotalAdvertencias > 0 ? "is-warning" : "is-ok")">@Model.TotalAdvertencias advertencia(s)</strong>
            </div>
        </div>
        @if (Model.Validaciones.Count == 0)
        {
            <div class="pam-validation-empty"><i class="fas fa-shield-circle-check" aria-hidden="true"></i><span><strong>Sin observaciones automáticas.</strong> El contenido puede congelarse para una autorización posterior.</span></div>
        }
        else
        {
            <div class="pam-validation-list">
                @foreach (var validacion in Model.Validaciones)
                {
                    <article class="@(validacion.Severidad == "Bloqueo" ? "is-block" : "is-warning")">
                        <i class="fas @(validacion.Severidad == "Bloqueo" ? "fa-circle-xmark" : "fa-triangle-exclamation")" aria-hidden="true"></i>
                        <div><strong>@validacion.Titulo</strong><span>@validacion.Detalle</span><code>@validacion.Codigo</code></div>
                        <b>@validacion.Total.ToString("N0")</b>
                    </article>
                }
            </div>
        }
    </section>

    <section class="pam-prepare-card pam-risk-card">
        <div class="pam-prepare-heading">
            <div><span>Lectura por riesgo</span><h3>Cambios agrupados por campo</h3></div>
            <strong>@Model.GruposCampos.Count</strong>
        </div>
        <p class="pam-risk-intro">El nivel de riesgo ayuda a concentrar la última revisión; no cambia las decisiones que ya registraste.</p>
        <div class="pam-field-risk-grid">
            @foreach (var grupo in Model.GruposCampos)
            {
                var esAlto = string.Equals(grupo.NivelRiesgo, "Alto", StringComparison.OrdinalIgnoreCase);
                <article class="@(esAlto ? "is-high" : "is-medium")">
                    <div class="pam-risk-title">
                        <span class="pam-risk-badge">Riesgo @grupo.NivelRiesgo.ToLowerInvariant()</span>
                        <strong>@EtiquetaCampo(grupo.Campo)</strong>
                        <code>@grupo.Campo</code>
                    </div>
                    <b>@grupo.Total.ToString("N0")</b>
                    <div class="pam-risk-decisions">
                        <span><i class="fas fa-check" aria-hidden="true"></i>@grupo.Aplicar.ToString("N0") aplicar</span>
                        <span><i class="fas fa-database" aria-hidden="true"></i>@grupo.MantenerSql.ToString("N0") mantener</span>
                        <span><i class="fas fa-forward" aria-hidden="true"></i>@grupo.Omitir.ToString("N0") omitir</span>
                    </div>
                </article>
            }
        </div>
    </section>

    @if (Model.TotalPendientes > 0)
    {
        <section class="pam-prepare-card">
            <div class="pam-prepare-heading">
                <div><span>Bloqueos</span><h3>Decisiones que faltan</h3></div>
                <strong>@Model.TotalPendientes</strong>
            </div>
            @if (Model.ResumenCampos.Pendientes > 0)
            {
                <div class="pam-field-pending-summary">
                    <i class="fas fa-table-list" aria-hidden="true"></i>
                    <div>
                        <strong>@Model.ResumenCampos.Pendientes campos pendientes en @Model.ResumenCampos.ProyectosPendientes proyectos</strong>
                        <span>Abra cada proyecto, use “Resolver todos los campos” y ajuste únicamente las excepciones.</span>
                    </div>
                    <a asp-action="ActualizacionDetalle" asp-route-loteId="@Model.Lote.LoteId" asp-route-estadoRevision="Pendiente" class="btn btn-outline-secondary btn-sm">Ir a proyectos</a>
                </div>
            }
            <div class="pam-prepare-list">
                @foreach (var item in Model.Pendientes)
                {
                    <article class="is-pending">
                        <div><code>@(item.ClaveRecibida ?? "Sin clave")</code><strong>@(item.NombreRecibido ?? "Nombre no extraído")</strong></div>
                        <span>@(item.EsCancelacion ? "Cancelación sin clasificar" : "Revisión pendiente")</span>
                        <small>@(item.FuenteDocumento ?? "Fuente no indicada") · @(item.UbicacionFuente ?? "sin ubicación")</small>
                    </article>
                }
            </div>
        </section>
    }

    <section class="pam-prepare-card">
        <div class="pam-prepare-heading">
            <div><span>Revisión de diferencias</span><h3>Decisiones por campo</h3></div>
            <strong>@Model.ResumenCampos.Total</strong>
        </div>
        <div class="pam-field-decision-kpis" aria-label="Resumen de decisiones por campo">
            <article><span>Aplicar propuesta</span><strong>@Model.ResumenCampos.Aplicar</strong><i class="fas fa-check" aria-hidden="true"></i></article>
            <article><span>Mantener SQL</span><strong>@Model.ResumenCampos.MantenerSql</strong><i class="fas fa-database" aria-hidden="true"></i></article>
            <article><span>Omitir</span><strong>@Model.ResumenCampos.Omitir</strong><i class="fas fa-forward" aria-hidden="true"></i></article>
            <article class="@(Model.ResumenCampos.Pendientes > 0 ? "is-warning" : "is-success")"><span>Pendientes</span><strong>@Model.ResumenCampos.Pendientes</strong><i class="fas fa-hourglass-half" aria-hidden="true"></i></article>
            <article><span>Proyectos revisados</span><strong>@Model.ResumenCampos.ProyectosRevisados</strong><i class="fas fa-folder-closed" aria-hidden="true"></i></article>
        </div>
        @if (Model.CamposAplicables.Count > 0)
        {
            <details class="pam-fields-ready">
                <summary>Ver campos marcados para aplicar (@Model.ResumenCampos.Aplicar)</summary>
                <div class="pam-fields-ready-list">
                    @foreach (var campo in Model.CamposAplicables)
                    {
                        <article>
                            <div><code>@campo.ClaveProyecto</code><strong>@campo.NombreProyecto</strong></div>
                            <div><small>@campo.Campo</small><span>@(string.IsNullOrWhiteSpace(campo.ValorActual) ? "Sin valor" : campo.ValorActual)</span></div>
                            <i class="fas fa-arrow-right" aria-hidden="true"></i>
                            <div><small>Valor propuesto</small><span>@(string.IsNullOrWhiteSpace(campo.ValorPropuesto) ? "Sin valor" : campo.ValorPropuesto)</span></div>
                        </article>
                    }
                </div>
                @if (Model.ResumenCampos.Aplicar > Model.CamposAplicables.Count)
                {
                    <p>Se muestran los primeros @Model.CamposAplicables.Count de @Model.ResumenCampos.Aplicar campos aceptados.</p>
                }
            </details>
        }
        else
        {
            <div class="pam-prepare-empty">Aún no hay diferencias de campo marcadas para aplicar.</div>
        }
    </section>

    <section class="pam-prepare-card">
        <div class="pam-prepare-heading">
            <div><span>Acciones preparadas</span><h3>Qué ocurriría al confirmar</h3></div>
            <strong>@Model.Acciones.Count</strong>
        </div>
        @if (Model.Acciones.Count == 0)
        {
            <div class="pam-prepare-empty">Todavía no hay acciones cerradas para mostrar.</div>
        }
        else
        {
            <div class="pam-prepare-list">
                @foreach (var item in Model.Acciones)
                {
                    <article>
                        <div><code>@(item.ClaveRecibida ?? "Sin clave")</code><strong>@(item.NombreRecibido ?? "Nombre no extraído")</strong></div>
                        <span class="pam-action-type">@item.TipoAccion</span>
                        <div class="pam-action-target">
                            @if (item.ProyectoRelacionadoId.HasValue)
                            {
                                <small>Destino en cartera</small>
                                <strong>@(item.ProyectoRelacionadoClave ?? $"Proyecto {item.ProyectoRelacionadoId}")</strong>
                                <span>@item.ProyectoRelacionadoNombre</span>
                            }
                            else
                            {
                                <small>@(item.TipoAccion == "No aplicar" ? "La fuente queda sólo en la traza" : "Se prepararía un registro propio")</small>
                            }
                        </div>
                    </article>
                }
            </div>
        }
    </section>

    <section class="pam-package-card @(Model.TienePaqueteVigente ? "is-frozen" : "")">
        <div class="pam-package-heading">
            <div>
                <span>Cierre trazable</span>
                <h3>@(Model.PaqueteAplicado ? "Paquete aplicado a la cartera" : Model.TienePaqueteVigente ? "Paquete de cierre congelado" : "Congelar paquete para autorización")</h3>
                <p>El paquete conserva una fotografía inmutable de las decisiones. Congelarlo no aplica cambios a los proyectos.</p>
            </div>
            @if (Model.TienePaqueteVigente)
            {
                <span class="pam-package-status"><i class="fas @(Model.PaqueteAplicado ? "fa-circle-check" : "fa-snowflake")" aria-hidden="true"></i>@(Model.PaqueteCierre.EstadoActual ?? "Congelado")</span>
            }
        </div>

        @if (Model.TienePaqueteVigente)
        {
            <div class="pam-package-meta">
                <article><span>UID</span><strong>@UidCorto(Model.PaqueteCierre.PaqueteUid)</strong></article>
                <article><span>Huella SHA-256</span><strong>@HashCorto(Model.PaqueteCierre.HashContenido)…</strong></article>
                <article><span>Elementos</span><strong>@Model.PaqueteCierre.TotalDetalles.ToString("N0")</strong></article>
                <article><span>Responsable</span><strong>@Model.PaqueteCierre.UsuarioCreacion</strong></article>
                <article><span>Fecha</span><strong>@Model.PaqueteCierre.FechaCreacionUtc?.ToLocalTime().ToString("dd MMM yyyy HH:mm")</strong></article>
            </div>
            <div class="pam-package-seal"><i class="fas fa-shield-circle-check" aria-hidden="true"></i><span>@(Model.PaqueteAplicado ? "La aplicación quedó vinculada a este paquete, sus resultados y el historial por campo." : "Este contenido coincide con la revisión actual. Cualquier decisión posterior generará una huella distinta y requerirá un nuevo paquete.")</span></div>
        }
        else
        {
            @if (Model.PaqueteCierre.PaqueteAplicacionId.HasValue)
            {
                <div class="pam-package-stale"><i class="fas fa-rotate" aria-hidden="true"></i><span>Existe un paquete anterior, pero ya no coincide con las decisiones actuales. Debes congelar una nueva versión.</span></div>
            }

            <form asp-action="CongelarPaqueteCierre" asp-route-loteId="@Model.Lote.LoteId" method="post" class="pam-freeze-form" data-freeze-form>
                @Html.AntiForgeryToken()
                <div class="pam-package-preview">
                    <article><span>Cambios de campo</span><strong>@Model.ResumenCampos.Total.ToString("N0")</strong></article>
                    <article><span>Acciones sobre claves</span><strong>@Model.Acciones.Count.ToString("N0")</strong></article>
                    <article><span>Huella actual</span><strong>@HashCorto(Model.PaqueteCierre.HashActual)…</strong></article>
                </div>
                <label class="pam-freeze-note">
                    <span>Nota de cierre <small>(opcional)</small></span>
                    <textarea name="Nota" maxlength="1000" rows="2" placeholder="Ej. Revisión final contra fuentes recibidas y criterios acordados."></textarea>
                </label>
                <label class="pam-freeze-confirm">
                    <input type="checkbox" name="Confirmado" value="true" required @(Model.ListaParaCongelar ? null : "disabled") />
                    <span>Confirmo que revisé el resumen, los riesgos y las advertencias. Entiendo que este paso sólo congela la evidencia y todavía no modifica la cartera maestra.</span>
                </label>
                <div class="pam-freeze-actions">
                    @if (Model.TotalBloqueos > 0)
                    {
                        <span><i class="fas fa-circle-xmark" aria-hidden="true"></i>Resuelve @Model.TotalBloqueos bloqueo(s) antes de congelar.</span>
                    }
                    else
                    {
                        <span><i class="fas fa-shield-halved" aria-hidden="true"></i>Se guardarán decisiones, valores, fuentes, usuario, fecha y huellas de integridad.</span>
                    }
                    <button type="submit" class="btn btn-primary" @(Model.ListaParaCongelar ? null : "disabled")>
                        <i class="fas fa-snowflake me-2" aria-hidden="true"></i>Congelar paquete de cierre
                    </button>
                </div>
            </form>
        }
    </section>

    @if (Model.TienePaqueteVigente)
    {
        <section class="pam-apply-card @(Model.PaqueteAplicado ? "is-applied" : "")">
            <div class="pam-package-heading">
                <div>
                    <span>Aplicación transaccional</span>
                    <h3>@(Model.PaqueteAplicado ? "Aplicación concluida" : "Impacto definitivo en la cartera")</h3>
                    <p>@(Model.PaqueteAplicado ? "Las versiones anteriores permanecen disponibles en el historial." : "Esta segunda confirmación sí creará versiones y registros nuevos en la fuente de verdad PAM.")</p>
                </div>
                <span class="pam-apply-status @(Model.Aplicacion.TotalBloqueos > 0 ? "is-blocked" : Model.PaqueteAplicado ? "is-done" : "is-ready")">
                    <i class="fas @(Model.Aplicacion.TotalBloqueos > 0 ? "fa-ban" : Model.PaqueteAplicado ? "fa-circle-check" : "fa-shield-halved")" aria-hidden="true"></i>
                    @(Model.Aplicacion.TotalBloqueos > 0 ? $"{Model.Aplicacion.TotalBloqueos} bloqueo(s)" : Model.PaqueteAplicado ? "Aplicado" : "Listo para confirmar")
                </span>
            </div>

            <div class="pam-apply-impact" aria-label="Impacto de la aplicación definitiva">
                <article><span>Proyectos a versionar</span><strong>@Model.Aplicacion.TotalVersionesNuevas.ToString("N0")</strong><small>La versión anterior se conserva.</small></article>
                <article><span>Campos con historial</span><strong>@Model.Aplicacion.TotalCambiosCampo.ToString("N0")</strong><small>Valor anterior, nuevo y fuente.</small></article>
                <article><span>Proyectos nuevos</span><strong>@Model.Aplicacion.TotalProyectosNuevos.ToString("N0")</strong><small>@Model.Aplicacion.TotalAltasVigentes vigente(s) y @Model.Aplicacion.TotalAntecedentes antecedente(s).</small></article>
                <article><span>Claves alternas</span><strong>@Model.Aplicacion.TotalClavesAlternas.ToString("N0")</strong><small>No generan jerarquías padre-hijo.</small></article>
                <article><span>Fuentes enlazadas</span><strong>@Model.Aplicacion.TotalFuentes.ToString("N0")</strong><small>Documento, hoja/fila y carga.</small></article>
            </div>

            @if (Model.Aplicacion.Validaciones.Count > 0)
            {
                <div class="pam-apply-validations">
                    @foreach (var validacion in Model.Aplicacion.Validaciones)
                    {
                        <article class="@(validacion.Severidad == "Bloqueo" ? "is-block" : "is-warning")">
                            <i class="fas @(validacion.Severidad == "Bloqueo" ? "fa-circle-xmark" : "fa-circle-info")" aria-hidden="true"></i>
                            <div><strong>@validacion.Titulo</strong><span>@validacion.Detalle</span></div>
                            <b>@validacion.Total.ToString("N0")</b>
                        </article>
                    }
                </div>
            }

            @if (Model.PaqueteAplicado)
            {
                <div class="pam-applied-result">
                    <i class="fas fa-circle-check" aria-hidden="true"></i>
                    <div><strong>@Model.Aplicacion.TotalResultados.ToString("N0") resultados trazables registrados</strong><span>El paquete no puede volver a aplicarse y cada cambio quedó enlazado con su versión resultante.</span></div>
                    <a asp-action="Index" class="btn btn-outline-success">Ver cartera actualizada</a>
                </div>
            }
            else
            {
                <form asp-action="AplicarPaquete" asp-route-loteId="@Model.Lote.LoteId" method="post" class="pam-apply-form" data-apply-form>
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="PaqueteAplicacionId" value="@Model.PaqueteCierre.PaqueteAplicacionId" />
                    <div class="pam-apply-warning">
                        <i class="fas fa-triangle-exclamation" aria-hidden="true"></i>
                        <div><strong>Esta operación sí modifica la cartera maestra.</strong><span>Se ejecuta en una sola transacción: si cualquier validación falla, todo se revierte.</span></div>
                    </div>
                    <label class="pam-confirm-phrase">
                        <span>Para autorizar, escribe exactamente <code>@Model.Aplicacion.FraseConfirmacion</code></span>
                        <input type="text" name="Confirmacion" maxlength="80" autocomplete="off" spellcheck="false" required placeholder="@Model.Aplicacion.FraseConfirmacion" @(Model.Aplicacion.PuedeAplicar ? null : "disabled") />
                    </label>
                    <label class="pam-freeze-confirm">
                        <input type="checkbox" name="Confirmado" value="true" required @(Model.Aplicacion.PuedeAplicar ? null : "disabled") />
                        <span>Confirmo que autorizo el versionado de la cartera, las altas, los antecedentes cancelados y las claves alternas descritas arriba.</span>
                    </label>
                    <div class="pam-freeze-actions">
                        <span><i class="fas fa-clock-rotate-left" aria-hidden="true"></i>Las versiones anteriores no se eliminan: permanecen en el historial para auditoría.</span>
                        <button type="submit" class="btn btn-danger" @(Model.Aplicacion.PuedeAplicar ? null : "disabled")>
                            <i class="fas fa-database me-2" aria-hidden="true"></i>Aplicar paquete a la cartera
                        </button>
                    </div>
                </form>
            }
        </section>
    }

    <footer class="pam-prepare-footer">
        <div><i class="fas fa-shield-halved" aria-hidden="true"></i><span><strong>Control de seguridad:</strong> congelar y aplicar son operaciones independientes; cada una conserva usuario, fecha y huella del contenido.</span></div>
        <span class="pam-footer-state"><i class="fas @(Model.PaqueteAplicado ? "fa-circle-check" : "fa-lock")" aria-hidden="true"></i>@(Model.PaqueteAplicado ? "Aplicación registrada" : "Esperando confirmación final")</span>
    </footer>
</div>

<style>
