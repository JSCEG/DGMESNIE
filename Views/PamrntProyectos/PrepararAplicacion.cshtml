<script>
    (() => {
        const form = document.querySelector('[data-freeze-form]');
        if (!form) return;

        form.addEventListener('submit', async event => {
            if (form.dataset.confirmed === 'true') return;
            event.preventDefault();

            if (!form.checkValidity()) {
                form.reportValidity();
                return;
            }

            if (typeof Swal === 'undefined') {
                if (!window.confirm('¿Congelar el paquete de cierre? Este paso conserva una fotografía inmutable, pero no modifica la cartera maestra.')) return;
            } else {
                const result = await Swal.fire({
                    icon: 'warning',
                    title: 'Congelar paquete de cierre',
                    html: 'Se conservarán <strong>@Model.ResumenCampos.Total.ToString("N0") decisiones de campo</strong> y <strong>@Model.Acciones.Count.ToString("N0") acciones sobre claves</strong>.<br><br>Este paso <strong>no modifica la cartera maestra</strong>.',
                    showCancelButton: true,
                    confirmButtonText: 'Sí, congelar paquete',
                    cancelButtonText: 'Volver a revisar',
                    confirmButtonColor: '#9b2247',
                    cancelButtonColor: '#6c6865',
                    reverseButtons: true,
                    focusCancel: true
                });
                if (!result.isConfirmed) return;
            }

            form.dataset.confirmed = 'true';
            const button = form.querySelector('button[type="submit"]');
            if (button) {
                button.disabled = true;
                button.innerHTML = '<i class="fas fa-spinner fa-spin me-2" aria-hidden="true"></i>Congelando…';
            }
            form.requestSubmit();
        });

        @if (!string.IsNullOrWhiteSpace(paqueteSuccessMessage))
        {
            <text>
            if (typeof Swal !== 'undefined') {
                Swal.fire({ icon: 'success', title: 'Paquete actualizado', text: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(paqueteSuccessMessage)), confirmButtonText: 'Entendido', confirmButtonColor: '#9b2247' });
            }
            </text>
        }
        @if (!string.IsNullOrWhiteSpace(paqueteErrorMessage))
        {
            <text>
            if (typeof Swal !== 'undefined') {
                Swal.fire({ icon: 'error', title: 'No se pudo congelar', text: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(paqueteErrorMessage)), confirmButtonText: 'Entendido', confirmButtonColor: '#9b2247' });
            }
            </text>
        }

        const applyForm = document.querySelector('[data-apply-form]');
        if (applyForm) {
            applyForm.addEventListener('submit', async event => {
                if (applyForm.dataset.confirmed === 'true') return;
                event.preventDefault();

                if (!applyForm.checkValidity()) {
                    applyForm.reportValidity();
                    return;
                }

                const accepted = typeof Swal === 'undefined'
                    ? window.confirm('Esta operación creará versiones y proyectos en la cartera maestra. ¿Deseas continuar?')
                    : (await Swal.fire({
                        icon: 'warning',
                        title: 'Aplicar a la cartera maestra',
                        html: 'Se crearán <strong>@Model.Aplicacion.TotalVersionesNuevas.ToString("N0") versiones</strong>, <strong>@Model.Aplicacion.TotalProyectosNuevos.ToString("N0") proyectos</strong> y <strong>@Model.Aplicacion.TotalClavesAlternas.ToString("N0") claves alternas</strong>.<br><br>La operación será atómica y quedará en el historial.',
                        showCancelButton: true,
                        confirmButtonText: 'Sí, aplicar paquete',
                        cancelButtonText: 'Cancelar',
                        confirmButtonColor: '#9b2247',
                        cancelButtonColor: '#6c6865',
                        reverseButtons: true,
                        focusCancel: true
                    })).isConfirmed;

                if (!accepted) return;
                applyForm.dataset.confirmed = 'true';
                const button = applyForm.querySelector('button[type="submit"]');
                if (button) {
                    button.disabled = true;
                    button.innerHTML = '<i class="fas fa-spinner fa-spin me-2" aria-hidden="true"></i>Aplicando transacción…';
                }
                applyForm.requestSubmit();
            });
        }

        @if (!string.IsNullOrWhiteSpace(aplicacionSuccessMessage))
        {
            <text>
            if (typeof Swal !== 'undefined') {
                Swal.fire({ icon: 'success', title: 'Cartera actualizada', text: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(aplicacionSuccessMessage)), confirmButtonText: 'Ver resultado', confirmButtonColor: '#9b2247' });
            }
            </text>
        }
        @if (!string.IsNullOrWhiteSpace(aplicacionErrorMessage))
        {
            <text>
            if (typeof Swal !== 'undefined') {
                Swal.fire({ icon: 'error', title: 'Transacción revertida', text: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(aplicacionErrorMessage)), confirmButtonText: 'Entendido', confirmButtonColor: '#9b2247' });
            }
            </text>
        }
    })();
</script>
