@using Newtonsoft.Json
@using NSIE.Models

@{
    ViewData["Title"] = "Seguridad y Auditoría";

    var header = new HeaderViewModel
    {
        Title = "Seguridad y Auditoría",
        IconPath = "seguridad_alertas_scel.png",
        Description = "Accesos, sesiones y actividad de cada usuario de la plataforma.",
        Section = "Gobernanza y Seguridad",
        ModuleInfo = JsonConvert.SerializeObject(new
        {
            title = "Seguridad y Auditoría",
            description = "Consulta reservada al administrador del sistema.",
            functionality = "Muestra quién tiene sesión abierta, sus accesos, la duración de cada sesión y lo que hizo dentro de la plataforma.",
            stage = "Operación",
            roles = new[] {
                new { icon = "user-shield", text = "Administrador del sistema: acceso exclusivo" }
            },
            order = new { step = 2, description = "Supervisión de acciones y cumplimiento (Art. 76)" }
        }),
        LegalDescription = "Sistema de monitoreo y auditoría conforme al Art. 76 del Reglamento para garantizar la seguridad y trazabilidad.",
        Fundamentos = new List<FundamentoLegal> {
            new() { Reference = "Art. 76 Reglamento", Description = "Establece los mecanismos de auditoría y control" }
        }
    };
}

@section Styles {
    <link rel="stylesheet" href="~/css/auditoria.css" asp-append-version="true" />
}

@await Html.PartialAsync("_ViewHeader", header)

<div class="container-fluid px-3 px-lg-4 auditoria-page">

    @* Cifras de un vistazo: una franja, no tarjetas. *@
    <section class="auditoria-cifras" aria-label="Resumen">
        <div class="auditoria-cifra">
            <span class="auditoria-cifra__etiqueta">Sesiones abiertas</span>
            <strong class="auditoria-cifra__valor" data-cifra="sesionesAbiertas">—</strong>
        </div>
        <div class="auditoria-cifra">
            <span class="auditoria-cifra__etiqueta">Acciones hoy</span>
            <strong class="auditoria-cifra__valor" data-cifra="accionesHoy">—</strong>
        </div>
        <div class="auditoria-cifra">
            <span class="auditoria-cifra__etiqueta">Accesos · 30 días</span>
            <strong class="auditoria-cifra__valor" data-cifra="accesos30Dias">—</strong>
        </div>
        <div class="auditoria-cifra">
            <span class="auditoria-cifra__etiqueta">Usuarios distintos · 30 días</span>
            <strong class="auditoria-cifra__valor" data-cifra="usuariosDistintos30Dias">—</strong>
        </div>
        <div class="auditoria-cifra">
            <span class="auditoria-cifra__etiqueta">Accesos históricos</span>
            <strong class="auditoria-cifra__valor" data-cifra="accesosTotales">—</strong>
        </div>
    </section>

    @* ---------------------------------------------------------------- *@
    <section class="auditoria-seccion">
        <div class="shell-table-toolbar">
            <div>
                <h5 class="mb-1 fw-bold">Sesiones abiertas ahora</h5>
                <p class="mb-0 text-muted small">
                    "En línea" = movimiento en los últimos 15 minutos. Una sesión inactiva sigue abierta hasta que vence;
                    cerrar el navegador no la cierra. Se actualiza cada 30 segundos.
                </p>
            </div>
            <span class="auditoria-actualizado" id="sesionesActualizado"></span>
        </div>
        <div class="table-responsive">
            <table id="tablaSesionesAbiertas" class="table table-hover align-middle w-100">
                <thead>
                    <tr>
                        <th>Usuario</th>
                        <th>Estado</th>
                        <th>Inicio</th>
                        <th>Último movimiento</th>
                        <th>Vence</th>
                        <th>Navegador</th>
                        <th>IP</th>
                    </tr>
                </thead>
                <tbody></tbody>
            </table>
        </div>
    </section>

    @* ---------------------------------------------------------------- *@
    <section class="auditoria-seccion">
        <div class="shell-table-toolbar">
            <div>
                <h5 class="mb-1 fw-bold">Buscar usuario</h5>
                <p class="mb-0 text-muted small">Escribe en el buscador y abre la fila para ver sus accesos, sesiones y actividad.</p>
            </div>
        </div>
        <div class="table-responsive">
            <table id="tablaUsuarios" class="table table-hover align-middle w-100">
                <thead>
                    <tr>
                        <th>Usuario</th>
                        <th>Unidad</th>
                        <th>Último acceso</th>
                        <th>Última acción</th>
                        <th>Accesos</th>
                        <th>Sesión</th>
                    </tr>
                </thead>
                <tbody></tbody>
            </table>
        </div>
    </section>

    @* Detalle del usuario elegido *@
    <section class="auditoria-seccion auditoria-detalle" id="detalleUsuario" hidden>
        <div class="shell-table-toolbar">
            <div>
                <span class="auditoria-kicker">Detalle de usuario</span>
                <h5 class="mb-1 fw-bold" id="detalleNombre"></h5>
                <p class="mb-0 text-muted small" id="detalleSubtitulo"></p>
            </div>
            <div class="shell-table-toolbar__group justify-content-md-end flex-grow-0">
                <div class="shell-filter-control">
                    <label for="detallePeriodo">Periodo</label>
                    <select id="detallePeriodo" class="form-select">
                        <option value="dia">Hoy</option>
                        <option value="semana">Últimos 7 días</option>
                        <option value="mes" selected>Últimos 30 días</option>
                        <option value="anio">Último año</option>
                        <option value="todo">Todo</option>
                    </select>
                </div>
            </div>
        </div>

        <div class="auditoria-totales" id="detalleTotales"></div>

        <div class="auditoria-pestanas" role="tablist">
            <button type="button" class="auditoria-pestana is-activa" role="tab" aria-selected="true" data-panel="panelAccesos">Accesos</button>
            <button type="button" class="auditoria-pestana" role="tab" aria-selected="false" data-panel="panelSesiones">Sesiones</button>
            <button type="button" class="auditoria-pestana" role="tab" aria-selected="false" data-panel="panelAcciones">Actividad</button>
        </div>

        <div class="auditoria-panel" id="panelAccesos" role="tabpanel">
            <div class="table-responsive">
                <table id="tablaAccesos" class="table table-hover align-middle w-100">
                    <thead><tr><th>Fecha y hora</th><th>Tipo de acceso</th><th>IP</th><th>Resultado</th></tr></thead>
                    <tbody></tbody>
                </table>
            </div>
        </div>
        <div class="auditoria-panel" id="panelSesiones" role="tabpanel" hidden>
            <div class="table-responsive">
                <table id="tablaSesiones" class="table table-hover align-middle w-100">
                    <thead><tr><th>Inicio</th><th>Último movimiento</th><th>Duración</th><th>Acciones</th><th>Estado</th><th>Navegador</th><th>IP</th></tr></thead>
                    <tbody></tbody>
                </table>
            </div>
        </div>
        <div class="auditoria-panel" id="panelAcciones" role="tabpanel" hidden>
            <div class="table-responsive">
                <table id="tablaAcciones" class="table table-hover align-middle w-100">
                    <thead><tr><th>Fecha y hora</th><th>Página</th><th>Acción</th><th>Tipo</th><th>Elemento</th><th>Valor</th></tr></thead>
                    <tbody></tbody>
                </table>
            </div>
        </div>
    </section>

    @* ---------------------------------------------------------------- *@
    <section class="auditoria-seccion">
        <div class="shell-table-toolbar">
            <div>
                <h5 class="mb-1 fw-bold">Accesos por día</h5>
                <p class="mb-0 text-muted small">Últimos 90 días, hora de la Ciudad de México.</p>
            </div>
        </div>
        <div id="graficaAccesosDia" class="auditoria-grafica"></div>
    </section>
</div>

@section Scripts {
    <script>
        (function () {
            'use strict';

            var urls = {
                resumen: '@Url.Action("Resumen", "Bitacora")',
                sesiones: '@Url.Action("SesionesAbiertas", "Bitacora")',
                usuarios: '@Url.Action("Usuarios", "Bitacora")',
                detalle: '@Url.Action("DetalleUsuario", "Bitacora")',
                accesosDia: '@Url.Action("AccesosPorDia", "Bitacora")'
            };

            // Todo lo que llega de la bitácora lo escribieron los usuarios (páginas,
            // valores de campos): se escapa siempre antes de pintarlo.
            function esc(valor) {
                if (valor === null || valor === undefined) return '';
                return String(valor)
                    .replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;')
                    .replace(/"/g, '&quot;').replace(/'/g, '&#39;');
            }

            function vacio(valor) {
                return valor === null || valor === undefined || String(valor).trim() === ''
                    ? '<span class="auditoria-vacio">—</span>' : esc(valor);
            }

            var fmtFecha = new Intl.DateTimeFormat('es-MX', { day: '2-digit', month: 'short', year: 'numeric', hour: '2-digit', minute: '2-digit', hour12: false });
            var fmtNumero = new Intl.NumberFormat('es-MX');

            function fecha(iso) {
                if (!iso) return '<span class="auditoria-vacio">—</span>';
                var d = new Date(iso);
                return '<span data-order="' + esc(iso) + '">' + esc(fmtFecha.format(d)) + '</span>';
            }

            function hace(iso) {
                if (!iso) return '';
                var minutos = Math.round((Date.now() - new Date(iso).getTime()) / 60000);
                if (minutos < 1) return 'hace un momento';
                if (minutos < 60) return 'hace ' + minutos + ' min';
                var horas = Math.floor(minutos / 60);
                if (horas < 24) return 'hace ' + horas + ' h';
                return 'hace ' + Math.floor(horas / 24) + ' d';
            }

            var estados = {
                enlinea: ['En línea', 'shell-status-badge--success'],
                inactiva: ['Inactiva', 'shell-status-badge--warning'],
                vencida: ['Vencida', 'shell-status-badge--info'],
                cerrada: ['Cerrada', 'shell-status-badge--info']
            };

            function estado(clave) {
                var e = estados[clave] || [clave, 'shell-status-badge--info'];
                return '<span class="shell-status-badge ' + e[1] + '">' + esc(e[0]) + '</span>';
            }

            function duracion(minutos) {
                if (!minutos) return '<span data-order="0">menos de 1 min</span>';
                var h = Math.floor(minutos / 60), m = minutos % 60;
                return '<span data-order="' + minutos + '">' + (h ? h + ' h ' : '') + m + ' min</span>';
            }

            var idioma = { url: 'https://cdn.datatables.net/plug-ins/1.13.6/i18n/es-ES.json' };

            function botonesExportar(titulo) {
                return [
                    { extend: 'excelHtml5', title: titulo },
                    { extend: 'csvHtml5', title: titulo }
                ];
            }

            function pintarTabla(selector, filas, opciones) {
                var $t = $(selector);
                if ($.fn.DataTable.isDataTable($t)) { $t.DataTable().clear().destroy(); }
                $t.find('tbody').html(filas.join(''));
                return $t.DataTable($.extend({
                    language: idioma,
                    lengthMenu: [[10, 25, 50, -1], [10, 25, 50, 'Todos']],
                    order: [[0, 'desc']]
                }, opciones || {}));
            }

            // --- Resumen -------------------------------------------------------
            function cargarResumen() {
                $.getJSON(urls.resumen).done(function (r) {
                    $('[data-cifra]').each(function () {
                        var v = r[this.getAttribute('data-cifra')];
                        this.textContent = typeof v === 'number' ? fmtNumero.format(v) : '—';
                    });
                });
            }

            // --- Sesiones abiertas ---------------------------------------------
            function cargarSesiones() {
                $.getJSON(urls.sesiones).done(function (sesiones) {
                    var filas = sesiones.map(function (s) {
                        return '<tr>' +
                            '<td><span class="auditoria-nombre">' + vacio(s.nombre) + '</span><span class="auditoria-sub">' + vacio(s.cargo) + '</span></td>' +
                            '<td>' + estado(s.estado) + '</td>' +
                            '<td>' + fecha(s.inicio) + '</td>' +
                            '<td>' + fecha(s.ultimoMovimiento) + '<span class="auditoria-sub">' + esc(hace(s.ultimoMovimiento)) + '</span></td>' +
                            '<td>' + fecha(s.expira) + '</td>' +
                            '<td>' + vacio(s.navegador) + '</td>' +
                            '<td class="auditoria-mono">' + vacio(s.ip) + '</td>' +
                            '</tr>';
                    });
                    var tabla = $('#tablaSesionesAbiertas');
                    var pagina = $.fn.DataTable.isDataTable(tabla) ? tabla.DataTable().page() : 0;
                    pintarTabla('#tablaSesionesAbiertas', filas, { order: [[3, 'desc']], dom: 'frtip', pageLength: 10 }).page(pagina).draw(false);
                    $('#sesionesActualizado').text('Actualizado ' + fmtFecha.format(new Date()));
                });
            }

            // --- Usuarios ------------------------------------------------------
            var usuarios = {};

            function cargarUsuarios() {
                $.getJSON(urls.usuarios).done(function (lista) {
                    var filas = lista.map(function (u) {
                        usuarios[u.idUsuario] = u;
                        var sesion = u.sesionesAbiertas > 0
                            ? '<span class="shell-status-badge shell-status-badge--success" data-order="1">Abierta</span>'
                            : '<span class="shell-status-badge shell-status-badge--info" data-order="0">Sin sesión</span>';
                        return '<tr class="auditoria-fila" data-id="' + esc(u.idUsuario) + '" tabindex="0">' +
                            '<td><span class="auditoria-nombre">' + vacio(u.nombre) + '</span><span class="auditoria-sub">' + vacio(u.correo) + '</span></td>' +
                            '<td>' + vacio(u.unidad) + '</td>' +
                            '<td>' + fecha(u.ultimoAcceso) + '</td>' +
                            '<td>' + fecha(u.ultimaAccion) + '</td>' +
                            '<td data-order="' + esc(u.accesos) + '">' + esc(fmtNumero.format(u.accesos)) + '</td>' +
                            '<td>' + sesion + '</td>' +
                            '</tr>';
                    });
                    pintarTabla('#tablaUsuarios', filas, { order: [[2, 'desc']], dom: 'frtip', pageLength: 10 });
                });
            }

            // --- Detalle -------------------------------------------------------
            var usuarioActual = null;

            function abrirDetalle(id) {
                usuarioActual = id;
                var u = usuarios[id] || {};
                $('#detalleNombre').text(u.nombre || 'Usuario ' + id);
                $('#detalleSubtitulo').text([u.cargo, u.unidad, u.correo].filter(Boolean).join(' · '));
                $('#detalleUsuario').prop('hidden', false);
                $('#tablaUsuarios tbody tr').removeClass('is-elegida');
                $('#tablaUsuarios tbody tr[data-id="' + id + '"]').addClass('is-elegida');
                cargarDetalle();
                document.getElementById('detalleUsuario').scrollIntoView({ behavior: 'smooth', block: 'start' });
            }

            // Los listados se topan para no traer años de bitácora de golpe; si se llegó
            // al tope, el número mostrado es "al menos" y conviene acotar el periodo.
            function topes(d) {
                var llenos = ['accesos', 'sesiones', 'acciones'].filter(function (k) { return d.totales[k] >= d.limites[k]; });
                if (!llenos.length) return '';
                return '<span class="auditoria-sub">Se muestran los registros más recientes hasta el tope (' +
                    esc(llenos.map(function (k) { return fmtNumero.format(d.limites[k]) + ' ' + k; }).join(', ')) +
                    '); acota el periodo para ver el total exacto.</span>';
            }

            function cargarDetalle() {
                if (!usuarioActual) return;
                var periodo = $('#detallePeriodo').val();
                $('#detalleTotales').html('<span class="auditoria-sub">Cargando…</span>');

                $.getJSON(urls.detalle, { id: usuarioActual, periodo: periodo }).done(function (d) {
                    var nombre = (usuarios[usuarioActual] || {}).nombre || 'usuario';
                    var etiquetaPeriodo = $('#detallePeriodo option:selected').text();

                    $('#detalleTotales').html(
                        '<span><strong>' + esc(fmtNumero.format(d.totales.accesos)) + '</strong> accesos</span>' +
                        '<span><strong>' + esc(fmtNumero.format(d.totales.sesiones)) + '</strong> sesiones</span>' +
                        '<span><strong>' + esc(fmtNumero.format(d.totales.acciones)) + '</strong> acciones</span>' +
                        '<span><strong>' + esc(fmtNumero.format(d.totales.ips)) + '</strong> IP distintas</span>' +
                        topes(d));

                    pintarTabla('#tablaAccesos', d.accesos.map(function (a) {
                        return '<tr><td>' + fecha(a.fecha) + '</td><td>' + vacio(a.tipo) + '</td>' +
                            '<td class="auditoria-mono">' + vacio(a.ip) + '</td>' +
                            '<td>' + (a.exitoso ? '<span class="shell-status-badge shell-status-badge--success">Exitoso</span>' : '<span class="shell-status-badge shell-status-badge--danger">Fallido</span>') + '</td></tr>';
                    }), { dom: 'Bfrtip', buttons: botonesExportar('Accesos de ' + nombre + ' · ' + etiquetaPeriodo) });

                    pintarTabla('#tablaSesiones', d.sesiones.map(function (s) {
                        return '<tr><td>' + fecha(s.inicio) + '</td><td>' + fecha(s.ultimoMovimiento) + '</td>' +
                            '<td>' + duracion(s.duracionMin) + '</td><td data-order="' + esc(s.acciones) + '">' + esc(fmtNumero.format(s.acciones)) + '</td>' +
                            '<td>' + estado(s.estado) + '</td><td>' + vacio(s.navegador) + '</td>' +
                            '<td class="auditoria-mono">' + vacio(s.ip) + '</td></tr>';
                    }), { dom: 'Bfrtip', buttons: botonesExportar('Sesiones de ' + nombre + ' · ' + etiquetaPeriodo) });

                    pintarTabla('#tablaAcciones', d.acciones.map(function (a) {
                        return '<tr><td>' + fecha(a.fecha) + '</td><td>' + vacio(a.pagina) + '</td><td>' + vacio(a.accion) + '</td>' +
                            '<td>' + vacio(a.tipo) + '</td><td>' + vacio(a.elemento) + '</td>' +
                            '<td class="auditoria-valor">' + vacio(a.valor) + '</td></tr>';
                    }), { dom: 'Bfrtip', buttons: botonesExportar('Actividad de ' + nombre + ' · ' + etiquetaPeriodo) });

                    // DataTables mide columnas ocultas en cero: se recalculan al cambiar de pestaña.
                    $.fn.dataTable.tables({ visible: true, api: true }).columns.adjust();
                }).fail(function () {
                    $('#detalleTotales').html('<span class="auditoria-sub">No fue posible cargar el detalle del usuario.</span>');
                });
            }

            $(document).on('click', '#tablaUsuarios tbody tr.auditoria-fila', function () {
                abrirDetalle(this.getAttribute('data-id'));
            });
            $(document).on('keydown', '#tablaUsuarios tbody tr.auditoria-fila', function (e) {
                if (e.key === 'Enter' || e.key === ' ') { e.preventDefault(); abrirDetalle(this.getAttribute('data-id')); }
            });
            $('#detallePeriodo').on('change', cargarDetalle);

            $('.auditoria-pestana').on('click', function () {
                $('.auditoria-pestana').removeClass('is-activa').attr('aria-selected', 'false');
                $(this).addClass('is-activa').attr('aria-selected', 'true');
                $('.auditoria-panel').prop('hidden', true);
                $('#' + this.getAttribute('data-panel')).prop('hidden', false);
                $.fn.dataTable.tables({ visible: true, api: true }).columns.adjust();
            });

            // --- Gráfica -------------------------------------------------------
            function cargarGrafica() {
                $.getJSON(urls.accesosDia, { dias: 90 }).done(function (serie) {
                    var css = getComputedStyle(document.documentElement);
                    var guinda = (css.getPropertyValue('--shell-guinda') || '#9B2247').trim();
                    var dorado = (css.getPropertyValue('--shell-dorado') || '#A57F2C').trim();
                    var tinta = (css.getPropertyValue('--shell-muted') || '#6F6B66').trim();

                    Highcharts.chart('graficaAccesosDia', {
                        chart: { backgroundColor: 'transparent', style: { fontFamily: 'inherit' } },
                        title: { text: null },
                        credits: { enabled: false },
                        legend: { itemStyle: { color: tinta, fontWeight: '600' } },
                        xAxis: { categories: serie.map(function (p) { return p.fecha.slice(5); }), labels: { style: { color: tinta } }, tickInterval: 7 },
                        yAxis: { title: { text: null }, allowDecimals: false, labels: { style: { color: tinta } }, gridLineColor: 'rgba(148,163,184,.18)' },
                        tooltip: { shared: true },
                        series: [
                            { type: 'column', name: 'Accesos', color: guinda, borderRadius: 2, data: serie.map(function (p) { return p.accesos; }) },
                            { type: 'line', name: 'Usuarios distintos', color: dorado, marker: { enabled: false }, data: serie.map(function (p) { return p.usuarios; }) }
                        ]
                    });
                });
            }

            $(function () {
                cargarResumen();
                cargarSesiones();
                cargarUsuarios();
                cargarGrafica();
                setInterval(function () { cargarSesiones(); cargarResumen(); }, 30000);
            });
        })();
    </script>
}
