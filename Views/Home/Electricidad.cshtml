@{
    ViewData[
    "Title"
    ] = "Mapas Sistema Electrico Nacional";
}


<div class="text-center">
    <h3 class="cp-section cp-grouping-section">
        <img src="@Cdn.Url/img_snier/vistas/mexico.png" alt="Icono personalizado" class="iconomenu">
        @ViewData["Title"]
    </h3>
</div>
<!-- Miga de Pan -->
<div class="container">

    <h2 class="fw-bold   subtitulo ">Infraestructura y Recursos | Sistema Eléctrico Nacional (SEN)</h2>

    <div class="album py-5">


        <div class="container">
            <div class="row justify-content-center">
                <div class="col-md-4">
                    <div class="card shadow-sm">
                        <a class="card-link" asp-controller="Map" asp-action="I_EConvencional">
                            <div class="card-img">
                                <img src="@Cdn.Url/img_snier/vistas/10.png" class="card-img" alt="..." />
                                <div class="card-overlay">
                                    <h5 class="card-title">
                                        <img src="@Cdn.Url/img_snier/vistas/logo_cre.png" alt="Icono personalizado" class="iconomenu">
                                        Energía Convencional
                                    </h5>

                                </div>
                            </div>
                        </a>
                    </div>
                </div>
                <div class="col-md-4">
                    <div class="card shadow-sm">
                        <a class="card-link" asp-controller="Map" asp-action="I_ELimpia">
                            <div class="card-img">
                                <img src="@Cdn.Url/img_snier/vistas/2.png" class="card-img" alt="..." />
                                <div class="card-overlay">
                                    <h5 class="card-title">
                                        <img src="@Cdn.Url/img_snier/vistas/logo_cre.png" alt="Icono personalizado" class="iconomenu">
                                        Energía Renovable y Limpia
                                    </h5>

                                </div>
                            </div>
                        </a>
                    </div>
                </div>
            </div>
        </div>


    </div>
    <h2 class="fw-bold   subtitulo ">Infraestructura | Lineas de Transmisión y Subestaciones</h2>
    <div class="album py-5">


        <div class="container">
            <div class="row justify-content-center">
                <div class="col-md-4">
                    <div class="card shadow-sm">
                        <a class="card-link" asp-controller="MIM" asp-action="LineasTyS">
                            <div class="card-img">
                                <img src="@Cdn.Url/img_snier/vistas/TyS.png" class="card-img" alt="..." />
                                <div class="card-overlay">
                                    <h5 class="card-title">
                                        <img src="@Cdn.Url/img_snier/vistas/logo_cre.png" alt="Icono personalizado" class="iconomenu">
                                        Líneas de Transmisión y Subestaciones
                                    </h5>

                                </div>
                            </div>
                        </a>
                    </div>
                </div>

            </div>
        </div>


    </div>
</div>
