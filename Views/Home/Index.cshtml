@model NSIE.Models.HomeViewModel
@using NSIE.Models
@using Microsoft.AspNetCore.Http
@using Newtonsoft.Json
@inject IHttpContextAccessor HttpContextAccessor

@{
    const string tituloInstitucional = "Dirección General de Metodologías y Estadísticas del Sistema Nacional de Información de Energía";
    ViewData["Title"] = tituloInstitucional;

    var perfilJson = HttpContextAccessor.HttpContext.Session.GetString("PerfilUsuario");
    var perfilUsuario = JsonConvert.DeserializeObject<PerfilUsuario>(perfilJson);
    ViewData["NombreUsuario"] = perfilUsuario.Nombre;
    ViewData["RolUsuario"] = perfilUsuario.Rol;
    ViewData["MercadoUsuario"] = perfilUsuario.Mercado_ID;

    var header = new HeaderViewModel
    {
        Title = "Dirección General de Metodologías y Estadísticas",
        IconPath = "sistema.png",
        Description = "Sistema Nacional de Información de Energía",
        Section = "Inicio",
        ModuleInfo = JsonConvert.SerializeObject(new
        {
            title = tituloInstitucional,
            description = "Portal principal del Sistema Nacional de Información Energética.",
            functionality = "Consulta módulos, indicadores, reportes, trazabilidad y estados del sistema.",
            stage = "Operación",
            roles = new[] {
new { icon = "globe", text = "Usuarios Públicos: Consulta general de datos" },
new { icon = "user-shield", text = "Funcionarios CRE/SENER: Gestión e integración de información" }
},
            order = new { step = 0, description = "Punto de acceso inicial al ecosistema energético" },
            manualUrl = "/Documentos/ManualSNIEr.pdf"
        })
    };

    var idUsuario = Convert.ToInt32(ViewData["IDUsuario"]);
    var rolUsuario = perfilUsuario?.Rol;
    var nombreUsuario = perfilUsuario?.Nombre?.ToString();
    var esConsultaPublica = (rolUsuario == "10" || nombreUsuario.Contains("consult"));
}

@section Styles {
    <link rel="stylesheet" href="~/css/home-dashboard.css" asp-append-version="true" />
}

<div class="home-dashboard-page">
    <div class="home-dashboard-page__view-header">
        @await Html.PartialAsync("_ViewHeader", header)
    </div>

    <section id="hero-home" aria-label="Resumen de inicio">
        <div class="container">
            <div class="hero-home__content">
                <span class="hero-home__eyebrow">Portal principal</span>
                <div class="hero-home__copy">
                    <h1 class="hero-home__title">
                        @if (esConsultaPublica)
                        {
                            <text>Consulta pública del SNIEr</text>
                        }
                        else
                        {
                            <text>Bienvenido, @nombreUsuario</text>
                        }
                    </h1>
                    <p class="hero-home__lead">Accede a módulos, indicadores y reportes del Sistema Nacional de Información de Energía desde un solo lugar.</p>
                </div>
                <div class="hero-home__meta">
                    <span class="hero-home__meta-pill"><i class="bi bi-compass"></i> Acceso central al ecosistema energético</span>
                    <span class="hero-home__meta-text">El SNIEr concentra la consulta oficial del sector energético en México.</span>
                </div>
            </div>
        </div>
    </section>

        <!-- NUEVO DASHBOARD GRID -->
        <div class="dashboard-container">
            <div class="container">
                <div class="dashboard-grid dashboard-grid--primary">

                    <!-- Card: Módulos Principales -->
                    <section class="home-panel home-panel--plain home-panel--modules" id="modulos-principales">
                        <div class="card-header">
                            <div class="card-icon"><i class="bi bi-grid-3x3-gap-fill"></i></div>
                            <h3 class="card-title">Módulos Principales</h3>
                            <a href="@Url.Action("Dashboard", "Bitacora")" class="mobile-section-link">Ver todos</a>
                        </div>
                        <div class="card-body">
                            <div class="module-list module-list--desktop">
                                <a href="@Url.Action("BNE", "SankeySener")">
                                    <i class="bi bi-diagram-3-fill module-icon"></i>
                                    <span class="module-copy">
                                        <strong>Balance Nacional de Energía</strong>
                                        <small>Consulta la síntesis energética nacional.</small>
                                    </span>
                                    <i class="bi bi-chevron-right module-arrow"></i>
                                </a>
                                <a href="@Url.Action("Index", "Indicadores")">
                                    <i class="bi bi-bar-chart-line-fill module-icon"></i>
                                    <span class="module-copy">
                                        <strong>Estadísticas de Energía</strong>
                                        <small>Explora tableros e indicadores estratégicos.</small>
                                    </span>
                                    <i class="bi bi-chevron-right module-arrow"></i>
                                </a>
                                <a href="@Url.Action("AZEL_Publico", "Atlas")#7">
                                    <i class="bi bi-lightning-charge module-icon"></i>
                                    <span class="module-copy">
                                        <strong>Capacidad Instalada</strong>
                                        <small>Ubica infraestructura y desempeño del sistema.</small>
                                    </span>
                                    <i class="bi bi-chevron-right module-arrow"></i>
                                </a>
                            </div>

                            <div class="module-quick-grid module-quick-grid--mobile" aria-label="Accesos rápidos móviles">
                                <a class="module-quick-card module-quick-card--diagnostico"
                                       href="@Url.Action("AZEL_Publico", "Atlas")#7">
                                    <span class="module-quick-card__icon"><i class="bi bi-flower1"></i></span>
                                    <span class="module-quick-card__label">Diagnóstico</span>
                                </a>
                                <a class="module-quick-card" href="@Url.Action("Index", "SIIL")">
                                    <span class="module-quick-card__icon"><i class="bi bi-bar-chart-line-fill"></i></span>
                                    <span class="module-quick-card__label">SIIL</span>
                                </a>
                                <a class="module-quick-card" href="@Url.Action("MenuPE", "Proyectos")">
                                    <span class="module-quick-card__icon"><i class="bi bi-calendar4-week"></i></span>
                                    <span class="module-quick-card__label">Planeación</span>
                                </a>
                                <a class="module-quick-card module-quick-card--fondos"
                                       href="@Url.Action("TableroFinanciero", "Finanzas")">
                                    <span class="module-quick-card__icon"><i class="bi bi-coin"></i></span>
                                    <span class="module-quick-card__label">Gestión de Fondos</span>
                                </a>
                                <a class="module-quick-card" href="@Url.Action("Fuentes", "FuentesdeInformacion")">
                                    <span class="module-quick-card__icon"><i class="bi bi-folder-fill"></i></span>
                                    <span class="module-quick-card__label">Repositorio</span>
                                </a>
                            </div>
                        </div>
                    </section>

                    <!-- Card: Indicadores Clave -->
                    <section class="home-panel home-panel--plain home-panel--kpis">
                        <div class="card-header card-header--split">
                            <div class="card-header__title-wrap">
                                <div class="card-icon"><i class="bi bi-bar-chart-line-fill"></i></div>
                                <h3 class="card-title">Indicadores Clave</h3>
                            </div>
                            <div class="kpi-update-pill"><span>Actualizado: Hoy 09:30</span><i
                                class="bi bi-arrow-clockwise"></i></div>
                            </div>
                            <div class="card-body">
                                <div class="kpi-grid">
                                    <div class="kpi-item">
                                        <div class="kpi-label">Producción Nacional</div>
                                        <div class="kpi-value">6,580<span class="kpi-unit">PJ</span></div>
                                        <div class="kpi-footnote">Petajoules</div>
                                        <div class="kpi-trend kpi-trend--production" aria-hidden="true"></div>
                                        <div class="kpi-delta"><i class="bi bi-arrow-up"></i><strong>3.2%</strong><span>vs.
                                            ayer</span></div>
                                        </div>
                                        <div class="kpi-item">
                                            <div class="kpi-label">Demanda Eléctrica</div>
                                            <div class="kpi-value">325<span class="kpi-unit">TWh</span></div>
                                            <div class="kpi-footnote">Teravatios hora</div>
                                            <div class="kpi-trend kpi-trend--demand" aria-hidden="true"></div>
                                            <div class="kpi-delta"><i class="bi bi-arrow-up"></i><strong>1.7%</strong><span>vs.
                                                ayer</span></div>
                                            </div>
                                        </div>
                                    </div>
                                </div>

                            </section>

                            <div class="dashboard-grid dashboard-grid--secondary">

                                <!-- Card: Actividad Reciente / Lo Más Consultado (Full Width) -->
                                <section class="home-panel home-panel--activity full-width" id="continuar">
                                    @if (esConsultaPublica)
                                    {
                                        <div class="continuar-header">
                                            <div class="continuar-header__content">
                                                <div class="continuar-header__icon"><i class="bi bi-star-fill"></i></div>
                                                <div>
                                                    <h3 class="card-title mb-1">Lo Más Consultado</h3>
                                                    <p class="text-muted small mb-0">Explora los módulos y secciones más populares de la
                                                        plataforma.</p>
                                                    </div>
                                                </div>
                                                <a href="@Url.Action("Dashboard", "Bitacora")" class="continuar-link">Ver todo <i
                                                    class="bi bi-chevron-right"></i></a>
                                                </div>
                                                <div class="card-body">
                                                    <div id="tarjetas-acciones"></div>
                                                </div>
                                            }
                else
                                            {
                                                <div class="continuar-header">
                                                    <div class="continuar-header__content">
                                                        <div class="continuar-header__icon"><i class="bi bi-clock-history"></i></div>
                                                        <div>
                                                            <h3 class="card-title mb-1">Continuar viendo</h3>
                                                            <p class="text-muted small mb-0">Retoma donde te quedaste en tus últimas consultas.</p>
                                                        </div>
                                                    </div>
                                                    <a href="@Url.Action("Dashboard", "Bitacora")" class="continuar-link">Ver todo <i
                                                        class="bi bi-chevron-right"></i></a>
                                                    </div>
                                                    <div class="card-body">
                                                        <div id="tarjetas-acciones"></div>
                                                    </div>
                                                }
                                                <div class="continuar-footer-note">
                                                    <i class="bi bi-shield-lock"></i>
                                                    <span>Tu progreso se guarda automáticamente para que puedas continuar después.</span>
                                                </div>
                                            </section>

                                            <!-- Card: Ayuda y Soporte -->
                                            <section class="home-panel home-panel--plain home-panel--support home-panel--support-strip">
                                                <div class="card-header">
                                                    <div class="card-icon"><i class="bi bi-question-circle-fill"></i></div>
                                                    <h3 class="card-title">Ayuda y Soporte</h3>
                                                </div>
                                                <div class="card-body">
                                                    <p class="text-muted mb-4">Consulta nuestras guías o contáctanos para obtener asistencia.</p>
                                                    <div class="d-flex flex-column gap-2">
                                                        <a href="https://cdn.sassoapps.com/Manuales/Manual_Usuario_SNIEr.pdf"
                                                               class="btn btn-primary" target="_blank">
                                                            <i class="bi bi-file-earmark-pdf me-2"></i>Descargar Manual
                                                        </a>
                                                        <button class="btn btn-outline-secondary"
                                                                onclick="mostrarAyudaModulo(@Html.Raw(header.ModuleInfo))">
                                                            <i class="bi bi-info-circle me-2"></i>Información del Módulo
                                                        </button>
                                                    </div>
                                                </div>
                                            </section>

                                        </div>
                                    </div>
                                </div>

                            </div>

                            <nav class="home-mobile-nav" aria-label="Navegación móvil principal">
                                <a class="home-mobile-nav__item" href="@Url.Action("AZEL_Publico", "Atlas")#7">
                                    <i class="bi bi-flower1"></i>
                                    <span>Diagnóstico</span>
                                </a>
                                <a class="home-mobile-nav__item home-mobile-nav__item--center" href="#modulos-principales">
                                    <i class="bi bi-grid-3x3-gap-fill"></i>
                                    <span>Módulos</span>
                                </a>
                                <a class="home-mobile-nav__item" href="#continuar">
                                    <i class="bi bi-bell"></i>
                                    <span>Alertas</span>
                                </a>
                                <a class="home-mobile-nav__item" href="@Url.Action("Dashboard", "Bitacora")">
                                    <i class="bi bi-three-dots"></i>
                                    <span>Más</span>
                                </a>
                            </nav>

                            <div class="home-mobile-nav-spacer" aria-hidden="true"></div>

                            @*
<div class="container my-4">
                                <section class="home-panel full-width" data-aos="fade-up">
        <div class="card-header">
            <div class="card-icon"><i class="bi bi-diagram-3"></i></div>
            <h3 class="card-title">Diagrama Energético</h3>
        </div>
        <div class="card-body">
            <div class="diagram-wrapper">
                <partial name="_DiagramaSEM_N" />
            </div>
        </div>
                                </section>
</div>
*@

                            @section Scripts {
                                <script src="https://cdn.jsdelivr.net/npm/particles.js@2.0.0/particles.min.js"></script>
                                <script>
                                    // --- SCRIPT DE PARTICLES.JS ---
                                    document.addEventListener('DOMContentLoaded', function () {
                                    const particlesDiv = document.getElementById('particles-js-home');
                                    if (typeof particlesJS !== 'undefined' && particlesDiv) {
                                    particlesJS("particles-js-home", {
                                    "particles": {
                                    "number": { "value": 42, "density": { "enable": true, "value_area": 920 } },
                                    "color": { "value": "#f6dca0" },
                                    "shape": { "type": "circle" },
                                    "opacity": { "value": 0.55, "random": true },
                                    "size": { "value": 2.4, "random": true },
                                    "line_linked": { "enable": true, "distance": 160, "color": "#f3d58c", "opacity": 0.28, "width": 1 },
                                    "move": { "enable": true, "speed": 2.6, "direction": "none", "random": true, "straight": false, "out_mode": "out" }
                                    },
                                    "interactivity": {
                                    "detect_on": "canvas",
                                    "events": { "onhover": { "enable": true, "mode": "grab" }, "onclick": { "enable": false } },
                                    "modes": { "grab": { "distance": 140, "line_linked": { "opacity": 0.5 } } }
                                    },
                                    "retina_detect": true
                                    });
                                    }
                                    });

                                    // --- SCRIPT PARA FUNCIONALIDAD "CONTINUAR VIENDO" (SIN CAMBIOS) ---
                                    function irA(elemento) {
                                    const controller = elemento.getAttribute('data-controller');
                                    const action = elemento.getAttribute('data-action');
                                    if (controller && action) {
                                    window.location.href = `/${controller}/${action}`;
                                    }
                                    }

                                    function mostrarAyudaModulo(infoJson) {
                                    try {
                                    const info = typeof infoJson === 'string' ? JSON.parse(infoJson) : infoJson;
                                    const html = `
                                    <div class="text-start">
                                    ${info.description ? `<p><strong>${info.description}</strong></p>` : ''}
                                    ${info.functionality ? `<p><i class='fas fa-cogs me-2'></i> ${info.functionality}</p>` : ''}
                                    ${info.stage ? `<p><i class='fas fa-layer-group me-2'></i> Etapa: ${info.stage}</p>` : ''}
                                    ${info.roles?.length ? `
                                    <ul>
                                    ${info.roles.map(r => `<li><i class="fas fa-${r.icon} me-2 text-primary"></i> ${r.text}</li>`).join('')}
                                    </ul>` : ''}
                                    ${info.order ? `<p><i class='fas fa-sort-amount-up'></i> Paso ${info.order.step}: ${info.order.description}</p>` : ''}
                                    </div>`;

                                    Swal.fire({
                                    title: info.title || 'Ayuda del módulo',
                                    html: html,
                                    confirmButtonText: 'Cerrar',
                                    confirmButtonColor: '#6c757d',
                                    backdrop: true
                                    });
                                    } catch (e) {
                                    console.error("Error al parsear o mostrar la ayuda del módulo:", e);
                                    Swal.fire('Error', 'No se pudo mostrar la información de ayuda.', 'error');
                                    }
                                    }

                                    $(function () {
                                    const $seccion = $('#continuar');
                                    const $contenedor = $('#tarjetas-acciones');
                                    const $loader = $('<div id="loader-continua" class="text-center py-3"><div class="spinner-border spinner-border-sm text-primary" role="status"><span class="visually-hidden">Cargando...</span></div></div>');

                                    $contenedor.html($loader);

                                    $.ajax({
                                    url: '@Url.Action("GetUltimasAcciones", "Bitacora")',
                                    data: { top: 5 },
                                    dataType: 'json',
                                    success: acciones => {
                                    if (!acciones || !acciones.length) {
                                    $contenedor.html('<p class="text-muted text-center">Sin actividad reciente.</p>');
                                    return;
                                    }
                                    const badgeMap = {
                                    Home: { label: 'PORTAL', icon: 'bi-house-fill' },
                                    Atlas: { label: 'AZEL', icon: 'bi-lightning-charge-fill' },
                                    Indicadores: { label: 'SNIER', icon: 'bi-bar-chart-fill' },
                                    SNIE: { label: 'SNIE', icon: 'bi-grid-1x2-fill' },
                                    SIIL: { label: 'SIIL', icon: 'bi-building-fill' },
                                    Proyectos: { label: 'SENER', icon: 'bi-flower1' },
                                    SankeySener: { label: 'BNE', icon: 'bi-diagram-3-fill' }
                                    };
                                    const filaId = 'fila-acciones';
                                    const filaHtml = `
                                    <div class="position-relative netflix-carousel">
                                    <button class="nf-nav-btn nf-prev" type="button" aria-label="Anterior" data-target="#${filaId}">❮</button>
                                    <button class="nf-nav-btn nf-next" type="button" aria-label="Siguiente" data-target="#${filaId}">❯</button>
                                    <div id="${filaId}" class="netflix-card-container" role="list" aria-label="Continuar viendo">
                                    ${acciones.map((a, index) => {
                                    const badge = badgeMap[a.controller] || { label: (a.controller || 'SENER').toUpperCase(), icon: 'bi-lightning-charge-fill' };
                                    const portadaTitulo = a.pagina || 'Consulta reciente';
                                    const portadaFecha = a.fecha || '';
                                    const avance = Math.max(30, 65 - (index * 10));
                                    return `
                                    <article class="netflix-card" role="listitem" tabindex="0" onclick="irA(this)" data-controller="${a.controller}" data-action="${a.action}">
                                    <div class="card-img activity-card-cover" aria-hidden="true">
                                    <div class="activity-card-cover__badge">
                                    <span class="activity-card-cover__brand">Energía</span>
                                    <span class="activity-card-cover__subbrand">Secretaría de Energía</span>
                                    </div>
                                    <div class="activity-card-cover__seal"><i class="bi ${badge.icon}"></i></div>
                                    </div>
                                    <div class="card-overlay">
                                    <div class="activity-card-meta-pill">${badge.label}</div>
                                    <h6 title="${portadaTitulo}">${portadaTitulo}</h6>
                                    <p class="text-muted small"><i class="bi bi-calendar3 me-1"></i>${portadaFecha}</p>
                                    <div class="activity-progress">
                                    <div class="activity-progress__bar"><span style="width:${avance}%"></span></div>
                                    <span class="activity-progress__value">${avance}%</span>
                                    </div>
                                    <button class="btn btn-primary btn-sm" type="button"><i class="bi bi-arrow-repeat me-1"></i>Reanudar</button>
                                    </div>
                                    </article>`;
                                    }).join('')}
                                    </div>
                                    <div class="activity-dots" aria-label="Paginación del carrusel"></div>
                                    </div>`;
                                    $contenedor.html(filaHtml);

                                    const $fila = $('#' + filaId);
                                    const $prev = $seccion.find('.nf-prev');
                                    const $next = $seccion.find('.nf-next');
                                    const $dots = $seccion.find('.activity-dots');

                                    function getPageMetrics() {
                                    const el = $fila[0];
                                    if (!el) {
                                    return { pageWidth: 0, pageCount: 0, currentPage: 0, maxScroll: 0 };
                                    }

                                    const pageWidth = Math.max(el.clientWidth * 0.88, 1);
                                    const maxScroll = Math.max(el.scrollWidth - el.clientWidth, 0);
                                    const pageCount = Math.max(1, Math.ceil((maxScroll + pageWidth) / pageWidth));
                                    const currentPage = Math.min(pageCount - 1, Math.round(el.scrollLeft / pageWidth));

                                    return { pageWidth, pageCount, currentPage, maxScroll };
                                    }

                                    function renderDots() {
                                    const { pageCount, currentPage } = getPageMetrics();
                                    const dotsHtml = Array.from({ length: pageCount }, (_, index) => `
                                    <button type="button" class="activity-dot ${index === currentPage ? 'is-active' : ''}" aria-label="Ir a la página ${index + 1}" data-page="${index}"></button>
                                    `).join('');

                                    $dots.html(dotsHtml);
                                    }

                                    function updateNavButtons() {
                                    const el = $fila[0];
                                    if (!el) return;
                                    const { currentPage, pageCount, maxScroll } = getPageMetrics();
                                    $prev.prop('disabled', el.scrollLeft <= 1);
                                    $next.prop('disabled', el.scrollLeft >= maxScroll - 1);
                                    $dots.find('.activity-dot').each(function () {
                                    const page = Number(this.getAttribute('data-page'));
                                    this.classList.toggle('is-active', page === currentPage);
                                    });
                                    $dots.toggle(pageCount > 1);
                                    }

                                    function scrollByPage(dir) {
                                    const el = $fila[0];
                                    if (!el) return;
                                    const { pageWidth, currentPage, pageCount } = getPageMetrics();
                                    const targetPage = Math.max(0, Math.min(pageCount - 1, currentPage + dir));
                                    el.scrollTo({ left: targetPage * pageWidth, behavior: 'smooth' });
                                    setTimeout(updateNavButtons, 400);
                                    }

                                    $prev.on('click', () => scrollByPage(-1));
                                    $next.on('click', () => scrollByPage(1));
                                    $dots.on('click', '.activity-dot', function () {
                                    const el = $fila[0];
                                    if (!el) return;
                                    const { pageWidth } = getPageMetrics();
                                    const targetPage = Number(this.getAttribute('data-page')) || 0;
                                    el.scrollTo({ left: targetPage * pageWidth, behavior: 'smooth' });
                                    setTimeout(updateNavButtons, 400);
                                    });
                                    $fila.on('scroll', updateNavButtons);
                                    $(window).on('resize.homeContinuar', () => {
                                    renderDots();
                                    updateNavButtons();
                                    });
                                    requestAnimationFrame(() => {
                                    renderDots();
                                    updateNavButtons();
                                    });
                                    },
                                    error: (xhr, status, err) => {
                                    console.error('Error al cargar últimas acciones:', err);
                                    $contenedor.html('<p class="text-danger text-center">No fue posible cargar la actividad.</p>');
                                    }
                                    });
                                    });
                                </script>
                            }
