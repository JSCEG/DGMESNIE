@section Styles {
    <link rel="stylesheet" href="~/css/home-dashboard.css" asp-append-version="true" />
}

<div class="home-dashboard-page">
    <div class="home-dashboard-page__view-header">
        @await Html.PartialAsync("_ViewHeader", header)
    </div>

    <section id="hero-home" aria-label="Inicio principal">
        <div class="hero-home__background" aria-hidden="true">
            <div class="hero-home__media">
                <iframe id="heroBackgroundVideo"
                        src="https://www.youtube-nocookie.com/embed/3Os0pbDTubQ?autoplay=1&mute=1&controls=0&loop=1&playlist=3Os0pbDTubQ&playsinline=1&rel=0&modestbranding=1&enablejsapi=1"
                        title="Video institucional de fondo" tabindex="-1"
                        allow="autoplay; encrypted-media; picture-in-picture; fullscreen"
                        referrerpolicy="strict-origin-when-cross-origin">
                </iframe>
            </div>
            <div class="hero-home__brand-strip">
                <img src="https://cdn.sassoapps.com/dgmesnie/logo_gob.png" alt="Gobierno de México"
                     class="hero-home__brand-logo hero-home__brand-logo--gob" />
                <span class="hero-home__brand-divider"></span>
                <img src="https://cdn.sassoapps.com/dgmesnie/logo_sener.png" alt="Secretaría de Energía"
                     class="hero-home__brand-logo hero-home__brand-logo--sener" />
            </div>
            <div class="hero-home__pattern hero-home__pattern--chip"></div>
            <div class="hero-home__pattern hero-home__pattern--rings"></div>
            <div class="hero-home__pattern hero-home__pattern--bars"></div>
            <div class="hero-home__pattern hero-home__pattern--grid"></div>
            <div class="hero-home__pattern hero-home__pattern--lines"></div>
        </div>
        <div class="container">
            <div class="hero-home__content hero-home__content--portal">
                <span class="hero-home__eyebrow">Portal principal</span>
                <div class="hero-home__copy" id="heroWelcomePanel">
                    <h1 class="hero-home__title">
                        @if (esConsultaPublica)
                        {
                            <text>Consulta pública del SNIEr</text>
                        }
                        else
                        {
                            <text>Bienvenido, @nombreUsuarioTexto</text>
                        }
                    </h1>
                    <p class="hero-home__lead">Accede a módulos, indicadores y reportes de la Dirección General de
                        Metodologías y Estadísticas desde un solo lugar.</p>
                    </div>
                </div>
            </div>
        </section>

        <div class="dashboard-container">
            <div class="container">
                <div class="dashboard-grid dashboard-grid--landing">
                    <div class="dashboard-main-stack">
                        <section class="home-panel home-panel--quick" aria-label="Accesos rápidos">
                            <div class="card-header card-header--split">
                                <div class="card-header__title-wrap">
                                    <div class="card-icon"><i class="bi bi-lightning-charge"></i></div>
                                    <div>
                                        <h3 class="card-title mb-1">Accesos rápidos</h3>
                                        <p class="text-muted small mb-0">Entradas directas a módulos prioritarios para
                                            continuar trabajando.</p>
                                        </div>
                                    </div>
                                    <span class="home-quick-counter">@totalAccesosRapidos disponibles</span>
                                </div>
                                <div class="card-body">
                                    <div class="home-quick-grid">
                                        @foreach (var herramienta in herramientasDestacadas)
                                        {
                                            var isExternal = herramienta.Url.StartsWith("http", StringComparison.OrdinalIgnoreCase);
                                            <a class="home-quick-card" href="@herramienta.Url" target="@(isExternal ? "_blank" : "_self")"
                                               rel="noopener noreferrer"
                                               data-search="@($"{herramienta.Titulo} {herramienta.Categoria} {herramienta.Etiqueta}".ToLowerInvariant())">
                                                <span class="home-quick-card__icon"><i class="bi @herramienta.Icono"></i></span>
                                                <div class="home-quick-card__copy">
                                                    <small class="home-quick-card__section">@herramienta.Categoria</small>
                                                    <strong>@herramienta.Titulo</strong>
                                                    <span>@herramienta.Descripcion</span>
                                                </div>
                                                <span class="home-quick-card__arrow">
                                                    <i class="bi @(isExternal ? "bi-box-arrow-up-right" : "bi-chevron-right")"></i>
                                                </span>
                                            </a>
                                        }
                                    </div>
                                </div>
                            </section>

                            <section class="home-panel home-panel--plain home-panel--documents full-width"
                                     aria-label="Documentos SharePoint">
                                <div class="card-header card-header--split">
                                    <div class="card-header__title-wrap">
                                        <div class="card-icon"><i class="bi bi-folder2-open"></i></div>
                                        <div>
                                            <h3 class="card-title mb-1">Accesos de SharePoint</h3>
                                            <p class="text-muted small mb-0">Accesos directos a carpetas institucionales
                                                priorizadas.</p>
                                            </div>
                                        </div>
                                    </div>
                                    <div class="card-body">
                                        <div class="home-document-groups">
                                            @foreach (var grupo in gruposSharePoint)
                                            {
                                                <article class="home-document-group">
                                                    <header class="home-document-group__header">
                                                        <span class="home-document-group__eyebrow">@grupo.Key</span>
                                                    </header>
                                                    <div class="home-document-group__list">
                                                        @foreach (var documento in grupo)
                                                        {
                                                            <a class="home-document-link" href="@documento.Url" target="_blank"
                                                               rel="noopener noreferrer">
                                                                <span class="home-document-link__icon"><i class="bi bi-folder"></i></span>
                                                                <span class="home-document-link__copy">
                                                                    <strong>@documento.Titulo</strong>
                                                                    <small>@documento.Descripcion</small>
                                                                </span>
                                                                <span class="home-document-link__arrow"><i
                                                                    class="bi bi-chevron-right"></i></span>
                                                                </a>
                                                            }
                                                        </div>
                                                    </article>
                                                }
                                            </div>
                                        </div>
                                    </section>
                                </div>
                            </div>
                        </div>
                    </div>

