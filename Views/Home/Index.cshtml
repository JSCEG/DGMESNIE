@model NSIE.Models.HomeViewModel
@using NSIE.Models
@using Microsoft.AspNetCore.Http
@using Newtonsoft.Json
@inject IHttpContextAccessor HttpContextAccessor
@inject NSIE.Servicios.IRepositorioUsuarios RepositorioUsuarios

@{
    const string tituloInstitucional = "Dirección General de Metodologías y Estadísticas del Sistema Nacional de Información de Energía";
    ViewData["Title"] = tituloInstitucional;

    var perfilJson = HttpContextAccessor.HttpContext.Session.GetString("PerfilUsuario");
    var perfilUsuario = JsonConvert.DeserializeObject<PerfilUsuario>(perfilJson);
    ViewData["NombreUsuario"] = perfilUsuario.Nombre;
    ViewData["RolUsuario"] = perfilUsuario.Rol;
    ViewData["MercadoUsuario"] = perfilUsuario.Mercado_ID;

    // Obtener lista de usuarios de forma dinámica
    var listaUsuarios = await RepositorioUsuarios.ObtenerListadeUsuarios();
    var totalUsuariosCount = listaUsuarios?.Count() ?? 0;

    var header = new HeaderViewModel
    {
        Title = "Dirección General de Metodologías y Estadísticas",
        IconPath = "sistema.png",
        Description = "Sistema Nacional de Información de Energía",
        Section = "Inicio",
        ModuleInfo = JsonConvert.SerializeObject(new
        {
            title = tituloInstitucional,
            description = "Pantalla principal para entrar al SNIEr, continuar la navegación reciente y consultar el estado general del ecosistema energético.",
            functionality = "Desde aquí puedes retomar tus vistas recientes y orientarte según tu perfil de consulta o gestión.",
            stage = "Operación",
            roles = new[] {
                new { icon = "globe", text = "Consulta pública: entrada rápida a tableros, indicadores y vistas de consulta." },
                new { icon = "user-shield", text = "Operación institucional: acceso a módulos de captura, seguimiento y administración." }
            },
            highlights = new[] {
                "Retomar las vistas recientes disponibles para tu perfil.",
                "Ubicar accesos directos al punto correcto sin recorrer todo el menú.",
                "Revisar la actividad reciente y navegar al punto correcto sin recorrer todo el menú."
            },
            context = "Úsalo como punto de arranque: desde aquí puedes continuar lo último que consultaste y volver rápidamente al flujo de trabajo.",
            order = new { step = 0, description = "Pantalla de inicio y navegación general del sistema" },
            manualUrl = "/Documentos/ManualSNIEr.pdf"
        })
    };

    var idUsuario = Convert.ToInt32(ViewData["IDUsuario"]);
    var rolUsuario = perfilUsuario?.Rol;
    var nombreUsuario = perfilUsuario?.Nombre?.ToString();
    var esConsultaPublica = rolUsuario == "10"
        || (nombreUsuario?.Contains("consult", StringComparison.OrdinalIgnoreCase) == true);
    var nombreUsuarioTexto = string.IsNullOrWhiteSpace(nombreUsuario) ? "Usuario" : nombreUsuario;

    var modulosDisponibles = Model.Secciones
        .Where(s => s.Modulos != null)
        .SelectMany(s => s.Modulos.Select(m => new { Seccion = s, Modulo = m }))
        .Where(x => x.Modulo != null
            && !string.IsNullOrWhiteSpace(x.Modulo.Action)
            && (x.Modulo.EsExterno || !string.IsNullOrWhiteSpace(x.Modulo.Controller)))
        .GroupBy(x => $"{x.Modulo.EsExterno}|{x.Modulo.Controller}|{x.Modulo.Action}")
        .Select(g => g.First())
        .ToList();

    var accesosGenerales = new[]
    {
        new { Titulo = "Reportes", Descripcion = "Generar reportes e informes", Icono = "bi-file-text", Href = Url.Action("EnConstruccion", "Home"), AbrirNuevaPestana = false, EsNuevo = false, Tono = 0 },
        new { Titulo = "Dashboards de proyectos", Descripcion = "Explorar proyectos energéticos interactivos", Icono = "bi-speedometer2", Href = Url.Action("Index", "DashboardProyectos"), AbrirNuevaPestana = false, EsNuevo = true, Tono = 0 },
        new { Titulo = "Áreas de interés", Descripcion = "Geovisualizador dinámico de capas espaciales", Icono = "bi-map", Href = Url.Action("Index", "AreasInteres"), AbrirNuevaPestana = false, EsNuevo = true, Tono = 2 },
        new { Titulo = "Balance de energía", Descripcion = "Balance Nacional de Energía Oficial", Icono = "bi-bezier2", Href = Url.Action("BNE", "SankeySener"), AbrirNuevaPestana = false, EsNuevo = false, Tono = 0 },
        new { Titulo = "Balance animado", Descripcion = "Diagrama de flujos y transiciones", Icono = "bi-lightning-charge", Href = Url.Action("FlujoEnergia", "SankeySener"), AbrirNuevaPestana = false, EsNuevo = false, Tono = 0 },
        new { Titulo = "Atlas AZEL", Descripcion = "Zonas con alto potencial de energías limpias", Icono = "bi-sun", Href = Url.Action("AZEL_Publico", "Atlas"), AbrirNuevaPestana = false, EsNuevo = true, Tono = 0 },
        new { Titulo = "Buscador de leyes", Descripcion = "Consulta de leyes y reglamentos", Icono = "bi-bank", Href = "https://buscador-juridico.com/", AbrirNuevaPestana = true, EsNuevo = true, Tono = 0 },
        new { Titulo = "Manuales, guías y presentaciones", Descripcion = "Documentación y material institucional", Icono = "bi-book", Href = Url.Action("Index", "Manuales"), AbrirNuevaPestana = false, EsNuevo = true, Tono = 0 },
        new { Titulo = "Guía de transparencia", Descripcion = "Gestión y flujo de solicitudes", Icono = "bi-file-earmark-slides", Href = Url.Content("~/Presentaciones/Guia%20para%20Solicitudes%20de%20Transparencia.html"), AbrirNuevaPestana = true, EsNuevo = true, Tono = 0 },
        new { Titulo = "Atribuciones DGMESNIE", Descripcion = "Atribuciones y objetivos de la DGMESNIE", Icono = "bi-file-slides", Href = Url.Content("~/Presentaciones/Presentacion%20DGMESNIE.html"), AbrirNuevaPestana = true, EsNuevo = false, Tono = 0 }
    };

    var totalSecciones = Model.Secciones.Count;
    var totalModulos = modulosDisponibles.Count;
    var heroBackgroundUrl = "https://cdn.sassoapps.com/img_fondos/portada.PNG";
    var fondosBienvenida = new[]
    {
        new
        {
            Url = "https://cdn.sassoapps.com/dgmesnie/marian_rom.jpg",
            Tema = "Editorial",
            Posicion = "88% center"
        }
    };
}

@section Styles {
    <link rel="stylesheet" href="~/css/home-dashboard.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/infraestructura-sem.css" asp-append-version="true" />
}

<div class="home-dashboard-page">
    <div class="home-dashboard-page__view-header">
        @await Html.PartialAsync("_ViewHeader", header)
    </div>

    @if (accesosGenerales.Any())
    {
        <section id="accesos-rapidos"
                 class="quick-access-ribbon"
                 data-quick-access-ribbon
                 aria-labelledby="quickAccessRibbonTitle">
            <h2 id="quickAccessRibbonTitle" class="visually-hidden">Accesos rápidos</h2>
            <div class="quick-access-ribbon__shell">
                <div id="quickAccessViewport"
                     class="quick-access-ribbon__viewport"
                     data-quick-access-viewport
                     tabindex="0"
                     aria-label="Accesos rápidos generales">
                    <div class="quick-access-ribbon__track" data-quick-access-track>
                        @foreach (var acceso in accesosGenerales)
                        {
                            var claseTono = $"quick-access-bubble--tone-{acceso.Tono}";

                            <a class="quick-access-bubble @claseTono"
                               href="@acceso.Href"
                               target="@(acceso.AbrirNuevaPestana ? "_blank" : null)"
                               rel="@(acceso.AbrirNuevaPestana ? "noopener noreferrer" : null)"
                               title="@acceso.Titulo">
                                <span class="quick-access-bubble__icon" aria-hidden="true">
                                    <i class="bi @acceso.Icono"></i>
                                </span>
                                <span class="quick-access-bubble__copy">
                                    <span class="quick-access-bubble__title-row">
                                        <strong>@acceso.Titulo</strong>
                                        @if (acceso.EsNuevo)
                                        {
                                            <span class="quick-access-bubble__badge">Nuevo</span>
                                        }
                                    </span>
                                    <small>@acceso.Descripcion</small>
                                </span>
                                @if (acceso.AbrirNuevaPestana)
                                {
                                    <i class="bi bi-box-arrow-up-right quick-access-bubble__external" aria-hidden="true"></i>
                                    <span class="visually-hidden">(abre en una pestaña nueva)</span>
                                }
                            </a>
                        }
                    </div>
                </div>

                <div class="quick-access-ribbon__controls" aria-label="Controles de la cenefa">
                    <button type="button"
                            class="quick-access-ribbon__control"
                            data-quick-access-prev
                            aria-controls="quickAccessViewport"
                            aria-label="Ver accesos anteriores">
                        <i class="bi bi-chevron-left" aria-hidden="true"></i>
                    </button>
                    <button type="button"
                            class="quick-access-ribbon__control"
                            data-quick-access-next
                            aria-controls="quickAccessViewport"
                            aria-label="Ver más accesos">
                        <i class="bi bi-chevron-right" aria-hidden="true"></i>
                    </button>
                </div>
            </div>
        </section>
    }

    @* La primera pantalla es el mapa de infraestructura (antes: carrusel de novedades
       y presentación de atribuciones, que siguen disponibles en la cenefa de accesos). *@
    <section class="home-mapa" aria-label="Mapa de infraestructura energética">
        @{ ViewData["SemAppClase"] = "sem-app--home"; }
        @await Html.PartialAsync("_MapaInfraestructura")
        <p class="sem-aviso home-mapa__aviso">
            En electricidad, la ubicación corresponde a la dirección declarada en el permiso y puede diferir de la ubicación física de la central.
        </p>
    </section>
</div>

@section Scripts {
    @await Html.PartialAsync("_MapaInfraestructuraScripts")
    <script src="https://cdnjs.cloudflare.com/ajax/libs/animejs/3.2.1/anime.min.js"></script>
    <script>
        $(function () {
            const fondosBienvenida = @Html.Raw(JsonConvert.SerializeObject(fondosBienvenida));
            const $heroWelcomePanel = $('#heroWelcomePanel');

            function aplicarFondoBienvenida(item) {
                if (!item || !$heroWelcomePanel.length) {
                    return;
                }

                $heroWelcomePanel[0].style.setProperty('--hero-welcome-bg', `url("${item.Url}")`);
                $heroWelcomePanel[0].style.setProperty('--hero-welcome-position', item.Posicion || 'center center');
            }

            if (fondosBienvenida.length && $heroWelcomePanel.length) {
                aplicarFondoBienvenida(fondosBienvenida[0]);
            }

            function inicializarCenefaAccesos() {
                const ribbon = document.querySelector('[data-quick-access-ribbon]');
                const viewport = ribbon?.querySelector('[data-quick-access-viewport]');
                const track = ribbon?.querySelector('[data-quick-access-track]');

                if (!ribbon || !viewport || !track) {
                    return;
                }

                const accesosOriginales = Array.from(track.children);
                const botonAnterior = ribbon.querySelector('[data-quick-access-prev]');
                const botonSiguiente = ribbon.querySelector('[data-quick-access-next]');
                const preferenciaMovimientoReducido = window.matchMedia('(prefers-reduced-motion: reduce)');
                const accesosClonados = [];
                let hayDesbordamiento = false;
                let puntoReinicio = 0;
                let punteroEncima = false;
                let arrastreActivo = false;
                let pausadoPorFoco = false;
                let pausaTemporalHasta = performance.now() + 1800;
                let ultimoFotograma = 0;

                if (accesosOriginales.length > 1) {
                    accesosOriginales.forEach((acceso) => {
                        const clon = acceso.cloneNode(true);
                        clon.setAttribute('aria-hidden', 'true');
                        clon.setAttribute('tabindex', '-1');
                        clon.dataset.quickAccessClone = 'true';
                        track.appendChild(clon);
                        accesosClonados.push(clon);
                    });
                }

                const actualizarMedidas = () => {
                    const primerAcceso = accesosOriginales[0];
                    const ultimoAcceso = accesosOriginales[accesosOriginales.length - 1];
                    const estilosTrack = window.getComputedStyle(track);
                    const separacion = Number.parseFloat(estilosTrack.columnGap || estilosTrack.gap) || 0;
                    const anchoOriginal = primerAcceso && ultimoAcceso
                        ? (ultimoAcceso.offsetLeft + ultimoAcceso.offsetWidth - primerAcceso.offsetLeft + separacion)
                        : 0;

                    hayDesbordamiento = anchoOriginal > viewport.clientWidth + 4;

                    accesosClonados.forEach((clon) => {
                        clon.hidden = !hayDesbordamiento || preferenciaMovimientoReducido.matches;
                    });

                    puntoReinicio = hayDesbordamiento && accesosClonados.length && !preferenciaMovimientoReducido.matches
                        ? accesosClonados[0].offsetLeft
                        : 0;

                    [botonAnterior, botonSiguiente].forEach((boton) => {
                        if (boton) {
                            boton.disabled = !hayDesbordamiento;
                        }
                    });

                    if (!hayDesbordamiento) {
                        viewport.scrollLeft = 0;
                    }
                };

                actualizarMedidas();

                if (typeof ResizeObserver !== 'undefined') {
                    const observadorTamano = new ResizeObserver(actualizarMedidas);
                    observadorTamano.observe(viewport);
                } else {
                    window.addEventListener('resize', actualizarMedidas, { passive: true });
                }

                preferenciaMovimientoReducido.addEventListener?.('change', actualizarMedidas);

                const pausarTemporalmente = (milisegundos = 2400) => {
                    pausaTemporalHasta = performance.now() + milisegundos;
                };

                const desplazarManualmente = (direccion) => {
                    if (!hayDesbordamiento) {
                        return;
                    }

                    pausarTemporalmente();
                    const paso = Math.min(360, Math.max(210, viewport.clientWidth * 0.7));

                    if (direccion < 0 && viewport.scrollLeft <= 2 && puntoReinicio > 0) {
                        viewport.scrollLeft = puntoReinicio;
                    }

                    viewport.scrollBy({
                        left: direccion * paso,
                        behavior: preferenciaMovimientoReducido.matches ? 'auto' : 'smooth'
                    });
                };

                botonAnterior?.addEventListener('click', () => desplazarManualmente(-1));
                botonSiguiente?.addEventListener('click', () => desplazarManualmente(1));

                ribbon.addEventListener('mouseenter', () => { punteroEncima = true; });
                ribbon.addEventListener('mouseleave', () => { punteroEncima = false; });
                ribbon.addEventListener('focusin', () => { pausadoPorFoco = true; });
                ribbon.addEventListener('focusout', () => {
                    requestAnimationFrame(() => {
                        pausadoPorFoco = ribbon.contains(document.activeElement);
                    });
                });
                viewport.addEventListener('pointerdown', () => { arrastreActivo = true; });
                window.addEventListener('pointerup', () => {
                    arrastreActivo = false;
                    pausarTemporalmente(1200);
                });
                window.addEventListener('pointercancel', () => { arrastreActivo = false; });
                viewport.addEventListener('wheel', () => pausarTemporalmente(), { passive: true });

                const animarCenefa = (marcaTiempo) => {
                    if (!ultimoFotograma) {
                        ultimoFotograma = marcaTiempo;
                    }

                    const delta = Math.min(marcaTiempo - ultimoFotograma, 34);
                    ultimoFotograma = marcaTiempo;

                    const puedeAvanzar = hayDesbordamiento
                        && puntoReinicio > 0
                        && !preferenciaMovimientoReducido.matches
                        && !punteroEncima
                        && !arrastreActivo
                        && !pausadoPorFoco
                        && !document.hidden
                        && marcaTiempo >= pausaTemporalHasta;

                    if (puedeAvanzar) {
                        viewport.scrollLeft += delta * 0.025;

                        if (viewport.scrollLeft >= puntoReinicio) {
                            viewport.scrollLeft -= puntoReinicio;
                        }
                    }

                    requestAnimationFrame(animarCenefa);
                };

                requestAnimationFrame(animarCenefa);
            }

            inicializarCenefaAccesos();

            // Animación de entrada con AnimeJS (estilo login)
            if (typeof anime !== 'undefined') {
                // Estado inicial
                anime.set([
                    '.home-dashboard-page__view-header',
                    '.quick-access-ribbon',
                    '.quick-access-bubble:not([data-quick-access-clone])'
                ], {
                    opacity: 0,
                    translateY: 15
                });

                const timeline = anime.timeline({
                    easing: 'easeOutExpo',
                    duration: 800
                });

                timeline
                    .add({
                        targets: '.home-dashboard-page__view-header',
                        opacity: [0, 1],
                        translateY: [10, 0],
                        duration: 600
                    })
                    .add({
                        targets: '.quick-access-ribbon',
                        opacity: [0, 1],
                        translateY: [10, 0],
                        duration: 650
                    }, '-=420')
                    .add({
                        targets: '.quick-access-bubble:not([data-quick-access-clone])',
                        opacity: [0, 1],
                        translateY: [10, 0],
                        delay: anime.stagger(35),
                        duration: 430
                    }, '-=430');
                // El mapa no entra en la animación: debe verse aunque la pestaña
                // esté en segundo plano (ahí el navegador frena los cuadros).
            }
        });
    </script>
}

