                            <div class="hero-home__pattern hero-home__pattern--lines"></div>
                        </div>
                        <div class="w-100 position-relative">
                            <div id="heroCarousel" class="carousel slide" data-bs-ride="carousel" data-bs-interval="6000">
                                <div class="carousel-inner">
                                    <!-- Slide 1: Nuevo Dashboard (Mockup) -->
                                    <div class="carousel-item active">
                                        <div class="hero-home__content hero-home__content--portal hero-home__content--split">
                                            <div class="hero-home__copy">
                                                <span class="badge-novedad mb-3">Novedad destacada</span>
                                                <h1 class="hero-home__title hero-home__title--portal hero-home__title--novedad">
                                                    Nuevo <span class="text-guinda">Dashboard</span> de proyectos energéticos
                                                </h1>
                                                <p class="hero-home__lead">Visualiza, analiza y da seguimiento a los proyectos energéticos en tiempo real con datos interactivos.</p>
                                                <div class="hero-home__cta-row gap-3">
                                                    <a href="@Url.Action("Index", "DashboardProyectos")" class="hero-home__cta-btn">
                                                        Ir al dashboard
                                                        <i class="bi bi-arrow-right"></i>
                                                    </a>
                                                    <a href="https://cdn.sassoapps.com/video/fondo_dgmesnie.mp4" target="_blank" class="btn btn-outline-secondary d-inline-flex align-items-center gap-2" style="border-radius: 99px; padding: 0.75rem 1.5rem; font-weight: 600; color: #8A0031; border-color: rgba(138, 0, 49, 0.2); background: transparent;">
                                                        Ver video demo <i class="bi bi-play-circle"></i>
                                                    </a>
                                                </div>
                                                <!-- Features row at bottom -->
                                                <div class="hero-features-row d-flex gap-4">
                                                    <div class="hero-feature-item d-flex align-items-center gap-2">
