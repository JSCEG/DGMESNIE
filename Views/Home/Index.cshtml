@model NSIE.Models.HomeViewModel
@using NSIE.Models
@using Microsoft.AspNetCore.Http
@using Newtonsoft.Json
@inject IHttpContextAccessor HttpContextAccessor
@inject NSIE.Servicios.IRepositorioUsuarios RepositorioUsuarios

@{
    const string tituloInstitucional = "Dirección General de Metodologías y Estadísticas del Sistema Nacional de Información de Energía";
    ViewData["Title"] = tituloInstitucional;

    var perfilJson = HttpContextAccessor.HttpContext.Session.GetString("PerfilUsuario");
    var perfilUsuario = JsonConvert.DeserializeObject<PerfilUsuario>(perfilJson);
    ViewData["NombreUsuario"] = perfilUsuario.Nombre;
    ViewData["RolUsuario"] = perfilUsuario.Rol;
    ViewData["MercadoUsuario"] = perfilUsuario.Mercado_ID;

    // Obtener lista de usuarios de forma dinámica
    var listaUsuarios = await RepositorioUsuarios.ObtenerListadeUsuarios();
    var totalUsuariosCount = listaUsuarios?.Count() ?? 0;

    var header = new HeaderViewModel
    {
        Title = "Dirección General de Metodologías y Estadísticas",
        IconPath = "sistema.png",
        Description = "Sistema Nacional de Información de Energía",
        Section = "Inicio",
        ModuleInfo = JsonConvert.SerializeObject(new
        {
            title = tituloInstitucional,
            description = "Pantalla principal para entrar al SNIEr, continuar la navegación reciente y consultar el estado general del ecosistema energético.",
            functionality = "Desde aquí puedes retomar tus vistas recientes y orientarte según tu perfil de consulta o gestión.",
            stage = "Operación",
            roles = new[] {
                new { icon = "globe", text = "Consulta pública: entrada rápida a tableros, indicadores y vistas de consulta." },
                new { icon = "user-shield", text = "Operación institucional: acceso a módulos de captura, seguimiento y administración." }
            },
            highlights = new[] {
                "Retomar las vistas recientes disponibles para tu perfil.",
                "Ubicar accesos directos al punto correcto sin recorrer todo el menú.",
                "Revisar la actividad reciente y navegar al punto correcto sin recorrer todo el menú."
            },
            context = "Úsalo como punto de arranque: desde aquí puedes continuar lo último que consultaste y volver rápidamente al flujo de trabajo.",
            order = new { step = 0, description = "Pantalla de inicio y navegación general del sistema" },
            manualUrl = "/Documentos/ManualSNIEr.pdf"
        })
    };

    var idUsuario = Convert.ToInt32(ViewData["IDUsuario"]);
    var rolUsuario = perfilUsuario?.Rol;
    var nombreUsuario = perfilUsuario?.Nombre?.ToString();
    var esConsultaPublica = rolUsuario == "10"
        || (nombreUsuario?.Contains("consult", StringComparison.OrdinalIgnoreCase) == true);
    var nombreUsuarioTexto = string.IsNullOrWhiteSpace(nombreUsuario) ? "Usuario" : nombreUsuario;

    var modulosDisponibles = Model.Secciones
        .Where(s => s.Modulos != null)
        .SelectMany(s => s.Modulos.Select(m => new { Seccion = s, Modulo = m }))
        .Where(x => x.Modulo != null
            && !string.IsNullOrWhiteSpace(x.Modulo.Action)
            && (x.Modulo.EsExterno || !string.IsNullOrWhiteSpace(x.Modulo.Controller)))
        .GroupBy(x => $"{x.Modulo.EsExterno}|{x.Modulo.Controller}|{x.Modulo.Action}")
        .Select(g => g.First())
        .ToList();

    var accesosGenerales = new[]
    {
        new { Titulo = "Reportes", Descripcion = "Generar reportes e informes", Icono = "bi-file-text", Href = Url.Action("EnConstruccion", "Home"), AbrirNuevaPestana = false, EsNuevo = false, Tono = 0 },
        new { Titulo = "Dashboards de proyectos", Descripcion = "Explorar proyectos energéticos interactivos", Icono = "bi-speedometer2", Href = Url.Action("Index", "DashboardProyectos"), AbrirNuevaPestana = false, EsNuevo = true, Tono = 0 },
        new { Titulo = "Áreas de interés", Descripcion = "Geovisualizador dinámico de capas espaciales", Icono = "bi-map", Href = Url.Action("Index", "AreasInteres"), AbrirNuevaPestana = false, EsNuevo = true, Tono = 2 },
        new { Titulo = "Balance de energía", Descripcion = "Balance Nacional de Energía Oficial", Icono = "bi-bezier2", Href = Url.Action("BNE", "SankeySener"), AbrirNuevaPestana = false, EsNuevo = false, Tono = 0 },
        new { Titulo = "Balance animado", Descripcion = "Diagrama de flujos y transiciones", Icono = "bi-lightning-charge", Href = Url.Action("FlujoEnergia", "SankeySener"), AbrirNuevaPestana = false, EsNuevo = false, Tono = 0 },
        new { Titulo = "Atlas AZEL", Descripcion = "Zonas con alto potencial de energías limpias", Icono = "bi-sun", Href = Url.Action("AZEL_Publico", "Atlas"), AbrirNuevaPestana = false, EsNuevo = true, Tono = 0 },
        new { Titulo = "Buscador de leyes", Descripcion = "Consulta de leyes y reglamentos", Icono = "bi-bank", Href = "https://buscador-leyes.pages.dev", AbrirNuevaPestana = true, EsNuevo = true, Tono = 0 },
        new { Titulo = "Manuales, guías y presentaciones", Descripcion = "Documentación y material institucional", Icono = "bi-book", Href = Url.Action("Index", "Manuales"), AbrirNuevaPestana = false, EsNuevo = true, Tono = 0 },
        new { Titulo = "Guía de transparencia", Descripcion = "Gestión y flujo de solicitudes", Icono = "bi-file-earmark-slides", Href = Url.Content("~/Presentaciones/Guia%20para%20Solicitudes%20de%20Transparencia.html"), AbrirNuevaPestana = true, EsNuevo = true, Tono = 0 },
        new { Titulo = "Atribuciones DGMESNIE", Descripcion = "Atribuciones y objetivos de la DGMESNIE", Icono = "bi-file-slides", Href = Url.Content("~/Presentaciones/Presentacion%20DGMESNIE.html"), AbrirNuevaPestana = true, EsNuevo = false, Tono = 0 }
    };

    var totalSecciones = Model.Secciones.Count;
    var totalModulos = modulosDisponibles.Count;
    var heroBackgroundUrl = "https://cdn.sassoapps.com/img_fondos/portada.PNG";
    var fondosBienvenida = new[]
    {
        new
        {
            Url = "https://cdn.sassoapps.com/dgmesnie/marian_rom.jpg",
            Tema = "Editorial",
            Posicion = "88% center"
        }
    };
}

@section Styles {
    <link rel="stylesheet" href="~/css/home-dashboard.css" asp-append-version="true" />
    <style>
        .badge-new-pulse {
            background-color: #9B2247;
            color: #ffffff !important;
            font-size: 0.62rem;
            font-weight: 800;
            padding: 0.15rem 0.35rem;
            border-radius: 5px;
            text-transform: uppercase;
            letter-spacing: 0.05em;
            animation: badge-pulse 1.8s infinite;
            display: inline-flex;
            align-items: center;
            margin-left: 0.5rem;
            vertical-align: middle;
            line-height: 1;
            box-shadow: 0 2px 6px rgba(155, 34, 71, 0.2);
        }

        @@keyframes badge-pulse {
            0% {
                transform: scale(1);
                box-shadow: 0 0 0 0 rgba(155, 34, 71, 0.45);
            }
            70% {
                transform: scale(1.04);
                box-shadow: 0 0 0 5px rgba(155, 34, 71, 0);
            }
            100% {
                transform: scale(1);
                box-shadow: 0 0 0 0 rgba(155, 34, 71, 0);
            }
        }

        /* Asegurar la misma altura en las tarjetas del carrusel en escritorio */
        .carousel-item .hero-home__copy {
            height: auto;
            display: flex;
            flex-direction: column;
            justify-content: space-between;
            box-sizing: border-box;
        }

        .carousel-item .hero-home__stats-card,
        .carousel-item .hero-home__mock-preview {
            height: auto;
            display: flex;
            flex-direction: column;
            justify-content: center;
            box-sizing: border-box;
        }

        /* Contención: nada del carrusel se sale del marco del hero */
        #heroCarousel,
        #heroCarousel .carousel-inner {
            overflow: hidden;
            border-radius: inherit;
        }

        /* Aire inferior: el CTA no debe pegar con el borde de la tarjeta */
        .carousel-item .hero-home__copy {
            padding-bottom: 1.9rem !important;
        }

        .carousel-item .hero-home__cta-row {
            margin-bottom: 0.35rem;
        }

        .hero-home__mock-preview {
            min-width: 0;
        }

        .mockup-card {
            max-width: min(360px, 100%);
        }

        @@media (max-width: 991px) {
            .hero-home__mock-preview {
                display: none !important;
            }
            .hero-home__content--split {
                grid-template-columns: 1fr !important;
            }
            .hero-home__copy {
                padding: 1rem !important;
            }
            /* Aire para los indicadores: que no pisen el CTA */
            .home-dashboard-page #hero-home {
                padding-bottom: 2.2rem !important;
            }
        }

        /* La cenefa ocupa la franja superior; el contenido principal queda a todo lo ancho. */
        @@media (min-width: 992px) {
            /* min-height en vez de height fijo: las tarjetas se alinean entre
               slides pero crecen si el contenido lo pide (antes el CTA se cortaba
               porque .hero-home__copy tiene overflow:hidden) */
            .carousel-item .hero-home__copy {
                height: auto !important;
                min-height: 415px !important;
            }

            .carousel-item .hero-home__stats-card,
            .carousel-item .hero-home__mock-preview {
                height: auto !important;
                min-height: 415px !important;
            }

            .home-dashboard-page .dashboard-grid--landing {
                display: grid !important;
                grid-template-columns: minmax(0, 1fr) !important;
                grid-template-areas: 
                    "hero"
                    "presentation" !important;
                align-items: start !important;
                gap: 1.5rem !important;
            }

            #hero-home-wrapper {
                grid-area: hero !important;
            }

            #atribuciones-section {
                grid-area: presentation !important;
            }

        }

        /* Estilo para el título de novedad */
        .hero-home__title--novedad {
            font-size: clamp(1.8rem, 2.8vw, 2.2rem) !important;
            font-weight: 700 !important;
            color: #333333 !important;
            line-height: 1.25 !important;
            margin-top: 0.5rem !important;
            margin-bottom: 0.5rem !important;
        }

        /* Novedad destacada badge */
        .badge-novedad {
            background-color: rgba(155, 34, 71, 0.08);
            color: #9B2247;
            font-size: 0.75rem;
            font-weight: 700;
            padding: 0.3rem 0.8rem;
            border-radius: 99px;
            display: inline-block;
            text-transform: uppercase;
            letter-spacing: 0.04em;
            width: fit-content;
        }

        .text-guinda {
            color: #9B2247;
            font-weight: 800;
        }

        .hero-features-row {
            margin-top: 1rem;
        }

        .hero-feature-item strong {
            font-size: 0.78rem;
            color: #333;
            display: block;
        }

        .hero-feature-item small {
            font-size: 0.68rem;
            color: #777;
        }

        .hero-feature-icon {
            width: 28px;
            height: 28px;
            border-radius: 50%;
            background: rgba(165, 127, 44, 0.1);
            color: #A57F2C;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 0.85rem;
            flex-shrink: 0;
        }

        .hero-feature-item:nth-child(2) .hero-feature-icon {
            background: rgba(155, 34, 71, 0.1);
            color: #9B2247;
        }

        .hero-feature-item:nth-child(3) .hero-feature-icon {
            background: rgba(40, 167, 69, 0.1);
            color: #28a745;
        }

        /* Mockup Card */
        .hero-home__mock-preview {
            flex: 1;
            display: flex;
            align-items: center;
            justify-content: center;
            padding: 0.5rem;
        }

        .mockup-card {
            background: #ffffff;
            border: 1px solid rgba(0,0,0,0.08);
            border-radius: 16px;
            box-shadow: 0 10px 30px rgba(0,0,0,0.06);
            width: 100%;
            max-width: 360px;
            overflow: hidden;
            position: relative;
            aspect-ratio: 1.6;
            display: flex;
            flex-direction: column;
            transition: transform 0.3s;
        }

        .mockup-card:hover {
            transform: translateY(-4px) scale(1.01);
        }

        .mockup-header {
            background: #f8f9fa;
            border-bottom: 1px solid rgba(0,0,0,0.05);
            padding: 0.4rem 1rem;
            display: flex;
            align-items: center;
            gap: 1rem;
            height: 32px;
        }

        .mockup-dots {
            display: flex;
            gap: 4px;
        }

        .mockup-dots span {
            width: 6px;
            height: 6px;
            border-radius: 50%;
            background: #ccc;
        }

        .mockup-dots span:nth-child(1) { background: #ff5f56; }
        .mockup-dots span:nth-child(2) { background: #ffbd2e; }
        .mockup-dots span:nth-child(3) { background: #27c93f; }

        .mockup-address {
            font-size: 0.65rem;
            color: #aaa;
            font-family: monospace;
            background: #ffffff;
            padding: 1px 12px;
            border-radius: 4px;
            border: 1px solid rgba(0,0,0,0.04);
            line-height: 1.2;
        }

        .mockup-body {
            flex: 1;
            padding: 0.75rem;
            display: flex;
            gap: 0.75rem;
            background-image: radial-gradient(circle at 10% 20%, rgba(155, 34, 71, 0.02) 0%, transparent 80%);
        }

        .mockup-map {
            flex: 1.2;
            background: #f1f3f5;
            border-radius: 10px;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 3rem;
            color: rgba(155, 34, 71, 0.15);
            position: relative;
            overflow: hidden;
        }

        .pulse-dot {
            position: absolute;
            width: 8px;
            height: 8px;
            border-radius: 50%;
            background: #9B2247;
            box-shadow: 0 0 0 0 rgba(155, 34, 71, 0.4);
            animation: pulse-dot-anim 1.5s infinite;
        }

        .pin-1 { top: 40%; left: 30%; }
        .pin-2 { top: 60%; left: 55%; animation-delay: 0.4s; }
        .pin-3 { top: 30%; left: 70%; animation-delay: 0.8s; }

        @@keyframes pulse-dot-anim {
            0% {
                transform: scale(0.95);
                box-shadow: 0 0 0 0 rgba(155, 34, 71, 0.7);
            }
            70% {
                transform: scale(1);
                box-shadow: 0 0 0 6px rgba(155, 34, 71, 0);
            }
            100% {
                transform: scale(0.95);
                box-shadow: 0 0 0 0 rgba(155, 34, 71, 0);
            }
        }

        .mockup-stats {
            flex: 0.8;
            display: flex;
            flex-direction: column;
            gap: 0.5rem;
        }

        .mockup-bar-chart {
            background: #f8f9fa;
            border-radius: 8px;
            padding: 0.5rem;
            display: flex;
            align-items: flex-end;
            justify-content: space-around;
            height: 50px;
        }

        .mockup-bar-chart .bar {
            width: 6px;
            background: rgba(155, 34, 71, 0.4);
            border-radius: 2px 2px 0 0;
        }

        .bar-1 { height: 60%; background: #A57F2C !important; }
        .bar-2 { height: 85%; background: #9B2247 !important; }
        .bar-3 { height: 40%; }

        .mockup-donut {
            flex: 1;
            background: #f8f9fa;
            border-radius: 8px;
            border: 4px solid #fff;
            box-shadow: inset 0 0 0 4px rgba(155, 34, 71, 0.1);
        }

        .mockup-fab {
            position: absolute;
            top: 40px;
            right: 10px;
            width: 32px;
            height: 32px;
            border-radius: 50%;
            background: #9B2247;
            color: #ffffff !important;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 0.85rem;
            box-shadow: 0 4px 10px rgba(155, 34, 71, 0.3);
            transition: all 0.2s;
            z-index: 10;
        }

        .mockup-fab:hover {
            transform: scale(1.1);
            background: #a3003a;
        }

        /* Carousel Indicators */
        .carousel-indicators-custom {
            position: absolute;
            bottom: 12px;
            left: 50%;
            transform: translateX(-50%);
            display: flex;
            gap: 8px;
            z-index: 15;
        }

        .carousel-indicators-custom button {
            width: 20px;
            height: 5px;
            border-radius: 2px;
            border: none;
            background: rgba(0,0,0,0.15);
            transition: all 0.3s;
        }

        .carousel-indicators-custom button.active {
            background: #9B2247;
            width: 32px;
        }

        /* --- Modo oscuro: mockups del carrusel y features del hero --- */
        [data-bs-theme="dark"] .hero-home__title--novedad {
            color: var(--shell-ink, #ece7e2) !important;
        }

        /* Badges de slide: fondo uniforme legible; el guinda pleno no
           contrasta en oscuro, se sube a acento (los inline dorado/verde/azul
           sí son legibles y conservan su identidad) */
        [data-bs-theme="dark"] .badge-novedad {
            background-color: rgba(255, 255, 255, 0.08) !important;
        }

        [data-bs-theme="dark"] .badge-novedad:not([style]),
        [data-bs-theme="dark"] .badge-novedad[style*="#9B2247"] {
            color: var(--shell-accent, #d4537e) !important;
        }

        [data-bs-theme="dark"] .text-guinda {
            color: var(--shell-accent, #d4537e) !important;
        }

        [data-bs-theme="dark"] .hero-feature-item strong {
            color: var(--shell-ink, #ece7e2);
        }

        [data-bs-theme="dark"] .hero-feature-item small {
            color: var(--shell-muted, #a39aa8);
        }

        [data-bs-theme="dark"] .mockup-card {
            background: var(--shell-surface, #1d1925);
            border-color: var(--shell-line, rgba(255,255,255,0.09));
            box-shadow: 0 10px 30px rgba(0,0,0,0.4);
        }

        [data-bs-theme="dark"] .mockup-header {
            background: var(--shell-surface-2, #241f2e);
            border-bottom-color: var(--shell-line, rgba(255,255,255,0.09));
        }

        [data-bs-theme="dark"] .mockup-address {
            background: var(--shell-surface, #1d1925);
            border-color: var(--shell-line, rgba(255,255,255,0.09));
            color: var(--shell-muted, #a39aa8);
        }

        [data-bs-theme="dark"] .mockup-map,
        [data-bs-theme="dark"] .mockup-bar-chart,
        [data-bs-theme="dark"] .mockup-donut {
            background: var(--shell-surface-2, #241f2e);
        }

        [data-bs-theme="dark"] .mockup-donut {
            border-color: var(--shell-surface, #1d1925);
            box-shadow: inset 0 0 0 4px rgba(212, 83, 126, 0.2);
        }

        [data-bs-theme="dark"] .mockup-map {
            color: rgba(212, 83, 126, 0.3);
        }

        [data-bs-theme="dark"] .carousel-indicators-custom button {
            background: rgba(255,255,255,0.2);
        }

        [data-bs-theme="dark"] .carousel-indicators-custom button.active {
            background: var(--shell-accent, #d4537e);
        }

    </style>
}

<div class="home-dashboard-page">
    <div class="home-dashboard-page__view-header">
        @await Html.PartialAsync("_ViewHeader", header)
    </div>

    @if (accesosGenerales.Any())
    {
        <section id="accesos-rapidos"
                 class="quick-access-ribbon"
                 data-quick-access-ribbon
                 aria-labelledby="quickAccessRibbonTitle">
            <h2 id="quickAccessRibbonTitle" class="visually-hidden">Accesos rápidos</h2>
            <div class="quick-access-ribbon__shell">
                <div id="quickAccessViewport"
                     class="quick-access-ribbon__viewport"
                     data-quick-access-viewport
                     tabindex="0"
                     aria-label="Accesos rápidos generales">
                    <div class="quick-access-ribbon__track" data-quick-access-track>
                        @foreach (var acceso in accesosGenerales)
                        {
                            var claseTono = $"quick-access-bubble--tone-{acceso.Tono}";

                            <a class="quick-access-bubble @claseTono"
                               href="@acceso.Href"
                               target="@(acceso.AbrirNuevaPestana ? "_blank" : null)"
                               rel="@(acceso.AbrirNuevaPestana ? "noopener noreferrer" : null)"
                               title="@acceso.Titulo">
                                <span class="quick-access-bubble__icon" aria-hidden="true">
                                    <i class="bi @acceso.Icono"></i>
                                </span>
                                <span class="quick-access-bubble__copy">
                                    <span class="quick-access-bubble__title-row">
                                        <strong>@acceso.Titulo</strong>
                                        @if (acceso.EsNuevo)
                                        {
                                            <span class="quick-access-bubble__badge">Nuevo</span>
                                        }
                                    </span>
                                    <small>@acceso.Descripcion</small>
                                </span>
                                @if (acceso.AbrirNuevaPestana)
                                {
                                    <i class="bi bi-box-arrow-up-right quick-access-bubble__external" aria-hidden="true"></i>
                                    <span class="visually-hidden">(abre en una pestaña nueva)</span>
                                }
                            </a>
                        }
                    </div>
                </div>

                <div class="quick-access-ribbon__controls" aria-label="Controles de la cenefa">
                    <button type="button"
                            class="quick-access-ribbon__control"
                            data-quick-access-prev
                            aria-controls="quickAccessViewport"
                            aria-label="Ver accesos anteriores">
                        <i class="bi bi-chevron-left" aria-hidden="true"></i>
                    </button>
                    <button type="button"
                            class="quick-access-ribbon__control"
                            data-quick-access-next
                            aria-controls="quickAccessViewport"
                            aria-label="Ver más accesos">
                        <i class="bi bi-chevron-right" aria-hidden="true"></i>
                    </button>
                </div>
            </div>
        </section>
    }

    <div class="dashboard-container mt-2">
        <div class="container">
            <div class="dashboard-grid dashboard-grid--landing">
                <!-- Hero/Carrusel -->
                <div id="hero-home-wrapper" class="hero-container-wrapper" style="margin-bottom: 0;">
                    <section id="hero-home" aria-label="Inicio principal" style="margin-bottom: 0; border: none; border-radius: 34px; overflow: hidden; position: relative;">
                        <div class="hero-home__background" aria-hidden="true" style="background-image: linear-gradient(112deg, rgba(255,255,255,.92) 0%, rgba(255,255,255,.72) 42%, rgba(255,255,255,.42) 100%), url('@heroBackgroundUrl'); text-align: center;">
                            <div class="hero-home__media" id="heroMediaContainer">
                            </div>
                            <div class="hero-home__brand-strip">
                                <img src="https://cdn.sassoapps.com/dgmesnie/logo_gob.png" alt="Gobierno de México"
                                     class="hero-home__brand-logo hero-home__brand-logo--gob" />
                                <span class="hero-home__brand-divider"></span>
                                <img src="https://cdn.sassoapps.com/dgmesnie/logo_sener.png" alt="Secretaría de Energía"
                                     class="hero-home__brand-logo hero-home__brand-logo--sener" />
                            </div>
