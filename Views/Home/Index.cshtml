@section Scripts {
    <script src="https://cdnjs.cloudflare.com/ajax/libs/animejs/3.2.1/anime.min.js"></script>
    <script>
        $(function () {
            const fondosBienvenida = @Html.Raw(JsonConvert.SerializeObject(fondosBienvenida));
            const $heroWelcomePanel = $('#heroWelcomePanel');

            function aplicarFondoBienvenida(item) {
                if (!item || !$heroWelcomePanel.length) {
                    return;
                }

                $heroWelcomePanel[0].style.setProperty('--hero-welcome-bg', `url("${item.Url}")`);
                $heroWelcomePanel[0].style.setProperty('--hero-welcome-position', item.Posicion || 'center center');
            }

            if (fondosBienvenida.length && $heroWelcomePanel.length) {
                aplicarFondoBienvenida(fondosBienvenida[0]);
            }

            // Animación de entrada con AnimeJS (estilo login)
            if (typeof anime !== 'undefined') {
                // Estado inicial
                anime.set([
                    '.home-dashboard-page__view-header',
                    '.hero-home__background',
                    '.hero-home__copy > span',
                    '.hero-home__copy > h1',
                    '.hero-home__copy > p',
                    '.hero-home__cta-row',
                    '.hero-home__stats-item',
                    '.home-panel',
                    '.quick-access-item'
                ], {
                    opacity: 0,
                    translateY: 15
                });

                const timeline = anime.timeline({
                    easing: 'easeOutExpo',
                    duration: 800
                });

                timeline
                    .add({
                        targets: '.home-dashboard-page__view-header',
                        opacity: [0, 1],
                        translateY: [10, 0],
                        duration: 600
                    })
                    .add({
                        targets: '.hero-home__background',
                        opacity: [0, 1],
                        scale: [0.98, 1],
                        duration: 800
                    }, '-=400')
                    .add({
                        targets: [
                            '.hero-home__copy > span',
                            '.hero-home__copy > h1',
                            '.hero-home__copy > p',
                            '.hero-home__cta-row'
                        ],
                        opacity: [0, 1],
                        translateY: [15, 0],
                        delay: anime.stagger(100),
                        duration: 600
                    }, '-=600')
                    .add({
                        targets: '.hero-home__stats-item',
                        opacity: [0, 1],
                        translateY: [15, 0],
                        delay: anime.stagger(80),
                        duration: 600
                    }, '-=400')
                    .add({
                        targets: '.home-panel',
                        opacity: [0, 1],
                        translateY: [20, 0],
                        delay: anime.stagger(120),
                        duration: 700
                    }, '-=500')
                    .add({
                        targets: '.quick-access-item',
                        opacity: [0, 1],
                        translateY: [12, 0],
                        delay: anime.stagger(60),
                        duration: 500
                    }, '-=400');
        });

        function makeFullscreen() {
            const container = document.querySelector('.iframe-container-canva');
            if (container) {
                if (container.requestFullscreen) {
                    container.requestFullscreen();
                } else if (container.webkitRequestFullscreen) { /* Safari */
                    container.webkitRequestFullscreen();
                } else if (container.msRequestFullscreen) { /* IE11 */
                    container.msRequestFullscreen();
                }
            }
        }
    </script>
}
