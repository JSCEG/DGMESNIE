                    @section Scripts {
                        <script>
                                $(function () {
                                    const fondosBienvenida = @Html.Raw(JsonConvert.SerializeObject(fondosBienvenida));
                                    const $heroWelcomePanel = $('#heroWelcomePanel');

                                    function aplicarFondoBienvenida(item) {
                                        if (!item || !$heroWelcomePanel.length) {
                                            return;
                                        }

                                        $heroWelcomePanel[0].style.setProperty('--hero-welcome-bg', `url("${item.Url}")`);
                                        $heroWelcomePanel[0].style.setProperty('--hero-welcome-position', item.Posicion || 'center center');
                                    }

                                    if (fondosBienvenida.length && $heroWelcomePanel.length) {
                                        aplicarFondoBienvenida(fondosBienvenida[0]);
                                    }

                                    // Cargar video de fondo de YouTube dinámicamente solo en pantallas de escritorio (>= 992px)
                                    if (window.innerWidth >= 992) {
                                        const mediaContainer = document.getElementById('heroMediaContainer');
                                        if (mediaContainer) {
                                            const iframe = document.createElement('iframe');
                                            iframe.id = 'heroBackgroundVideo';
                                            iframe.src = 'https://www.youtube-nocookie.com/embed/3Os0pbDTubQ?autoplay=1&mute=1&controls=0&loop=1&playlist=3Os0pbDTubQ&playsinline=1&rel=0&modestbranding=1&enablejsapi=1';
                                            iframe.title = 'Video institucional de fondo';
                                            iframe.tabIndex = -1;
                                            iframe.setAttribute('allow', 'autoplay; encrypted-media; picture-in-picture; fullscreen');
                                            iframe.setAttribute('referrerpolicy', 'strict-origin-when-cross-origin');

                                            iframe.addEventListener('load', function () {
                                                const playerWindow = iframe.contentWindow;
                                                if (playerWindow) {
                                                    playerWindow.postMessage(JSON.stringify({ event: 'command', func: 'mute', args: [] }), '*');
                                                    playerWindow.postMessage(JSON.stringify({ event: 'command', func: 'playVideo', args: [] }), '*');
                                                }
                                            });

                                            mediaContainer.appendChild(iframe);
                                        }
                                    }
                                });
                        </script>
                    }
