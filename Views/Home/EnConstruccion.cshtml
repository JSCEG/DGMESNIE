@inject IHttpContextAccessor HttpContextAccessor
@using NSIE.Models
@using Microsoft.AspNetCore.Http
@using Newtonsoft.Json

@{
	var httpContext = HttpContextAccessor.HttpContext;
	var perfilUsuarioJson = httpContext.Session.GetString("PerfilUsuario");
	var perfilUsuario = JsonConvert.DeserializeObject<PerfilUsuario>(perfilUsuarioJson);

	ViewData["Title"] = "Sección en Construcción";
	ViewData["NombreUsuario"] = perfilUsuario?.Nombre;
	ViewData["RolUsuario"] = perfilUsuario?.Rol;
	ViewData["IDUsuario"] = perfilUsuario?.IdUsuario;

	var header = new HeaderViewModel
	{
		Title = "Módulo en Construcción",
		IconPath = "conding.png",
		Description = "Esta sección del sitio se encuentra actualmente en desarrollo y se habilitará próximamente.",
		Section = "Desarrollo",
		ModuleInfo = JsonConvert.SerializeObject(new
		{
			title = "Módulo en Construcción",
			description = "Estamos construyendo esta sección como parte de las mejoras progresivas del portal del SNIEr.",
			functionality = "Sección planificada para futuras integraciones de visualización y consulta.",
			stage = "Desarrollo Activo",
			roles = new[] {
				new { icon = "hammer", text = "Equipo de desarrollo: diseñando la interfaz y base de datos." },
				new { icon = "clock", text = "Disponibilidad: se integrará en el siguiente bloque de actualizaciones." }
			},
			order = new { step = 99, description = "Fase de desarrollo e innovación del portal" },
			manualUrl = "#"
		})
	};
}

@section Styles {
	<link rel="stylesheet" href="~/css/home-dashboard.css" asp-append-version="true" />
}

<div class="home-dashboard-page">
	<div class="home-dashboard-page__view-header">
		@await Html.PartialAsync("_ViewHeader", header)
	</div>

	<div class="container my-5">
		<div class="row">
			<div class="col-12 col-md-8 col-lg-6 mx-auto">
				<div class="text-center p-5 rounded-4 shadow-sm border bg-white" style="border-color: rgba(155, 34, 71, 0.08) !important;">
					<div class="mb-4 d-inline-flex align-items-center justify-content-center" style="width: 80px; height: 80px; background-color: rgba(155, 34, 71, 0.05); border-radius: 50%;">
						<i class="bi bi-tools text-danger" style="font-size: 2.5rem; color: #9B2247 !important;"></i>
					</div>

					<h3 class="mb-3" style="font-weight: 700; color: #333;">Sección en Desarrollo</h3>
					<p class="text-muted mb-4">Estamos trabajando activamente en habilitar esta funcionalidad para ti. Muy pronto estará disponible.</p>

					<div class="p-3 mb-4 rounded-3 text-start" style="background-color: #fcfbfa; border: 1px solid rgba(155, 34, 71, 0.05);">
						<div class="d-flex align-items-center gap-2 mb-2">
							<i class="bi bi-info-circle-fill" style="color: #9B2247;"></i>
							<strong style="color: #333; font-size: 0.9rem;">Próximas características:</strong>
						</div>
						<ul class="mb-0 text-muted small ps-3" style="line-height: 1.6;">
							<li>Visualizaciones avanzadas e interactivas.</li>
							<li>Reportes dinámicos descargables.</li>
							<li>Búsqueda optimizada por categorías energéticas.</li>
						</ul>
					</div>

					<button class="btn btn-primary px-4 py-2" onclick="goBack()" style="background: #9B2247 !important; border: none; border-radius: 8px; font-weight: 600;">
						<i class="bi bi-arrow-left me-2"></i> Regresar al Inicio
					</button>
				</div>
			</div>
		</div>
	</div>
</div>

<script>
	function goBack() {
		window.history.back();
	}
</script>
