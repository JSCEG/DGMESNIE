@model NSIE.Models.BarrenacionViewModel
@using NSIE.Models
@using Newtonsoft.Json

@{
    ViewData["Title"] = "Registro de Barrenación - Formulario 1";
    var pronosticos = ViewBag.PronosticosPozos as List<PronosticoPozo> ?? new List<PronosticoPozo>();
    var header = new HeaderViewModel
    {
        Title = "SIIL - Registro de Barrenación",
        IconPath = "siil.png",
        Description = "Formulario 1: Captura operativa de barrenación",
        Section = "SIIL",
        ModuleInfo = JsonConvert.SerializeObject(new
        {
            title = "Registro",
            description = "Captura y trazabilidad de barrenación",
            functionality = "Registro operativo de barrenación con ID único",
            stage = "Operación",
            roles = new[] {
                new { icon = "flask", text = "Operadores de Campo: Registro de barrenación" }
            }
        })
    };
}

<div class="container-fluid siil-form">
    @await Html.PartialAsync("_ViewHeader", header)

    <div class="container py-3">
        <div class="row justify-content-center">
            <div class="col-lg-10">

                <!-- TÍTULO -->
                <div class="siil-title">
                    <div class="siil-title__icon">
                        <i class="bi bi-tools"></i>
                    </div>
                    <div>
                        <h2 class="mb-1">Registro de Barrenación</h2>
                        <div class="text-muted small">Formulario 1: Operación de Campo</div>
                    </div>
                </div>

                <div class="alert siil-alert">
                    <i class="bi bi-info-circle me-2"></i>
                    <strong>Instrucción SNIEr:</strong>
                    Registre con precisión la información del punto de barrenación y del núcleo recuperado.
                </div>

                @using (Html.BeginForm("Barrenacion", "SIIL", FormMethod.Post, new { id="formBarrenacion", enctype="multipart/form-data"}))
                {
                    @Html.AntiForgeryToken()

                    <div asp-validation-summary="ModelOnly" class="text-danger"></div>

                <!-- ================================= -->
                <!-- 1 CONTEXTO DEL PUNTO DE BARRENACIÓN -->
                <!-- ================================= -->

                <div class="card siil-card mb-4">
                    <div class="card-header siil-card__header">
                        <h5 class="mb-0">1. Contexto del Punto de Barrenación</h5>
                    </div>

                    <div class="card-body">

                        <h6 class="text-primary mb-3">Descripción Local</h6>

                        <div class="row g-3">

                            <div class="col-md-6">
                                <label class="form-label fw-bold">Litología Local *</label>
                                <select asp-for="LitologiaLocal" id="LitologiaLocal" class="form-select" required>
                                    <option value="">Seleccione...</option>
                                    <option>Arcilla Lacustre</option>
                                    <option>Riolita</option>
                                    <option>Conglomerado</option>
                                </select>
                                <span asp-validation-for="LitologiaLocal" class="text-danger"></span>
                            </div>

                            <div class="col-md-6">
                                <label class="form-label fw-bold">Anomalía Gravimétrica (mGal)</label>
                                <input asp-for="AnomaliaGravimetrica" type="number" step="0.01" class="form-control"
                                       placeholder="Valor en mGal">
                                <span asp-validation-for="AnomaliaGravimetrica" class="text-danger"></span>
                            </div>

                        </div>

                        <hr class="my-4">

                        <h6 class="text-primary mb-3">Prospección Decisiva</h6>

                        <div class="row g-3">

                            <div class="col-md-12">
                                <label class="form-label">Anomalía 1</label>
                                <textarea asp-for="Anomalia1" class="form-control" rows="2"></textarea>
                                <span asp-validation-for="Anomalia1" class="text-danger"></span>
                            </div>

                            <div class="col-md-12">
                                <label class="form-label">Anomalía 2</label>
                                <textarea asp-for="Anomalia2" class="form-control" rows="2"></textarea>
                                <span asp-validation-for="Anomalia2" class="text-danger"></span>
                            </div>

                            <div class="col-md-12">
                                <label class="form-label">Anomalía 3</label>
                                <textarea asp-for="Anomalia3" class="form-control" rows="2"></textarea>
                                <span asp-validation-for="Anomalia3" class="text-danger"></span>
                            </div>

                        </div>

                        <hr class="my-4">

                        <h6 class="text-primary mb-3">Condiciones de Campo</h6>

                        <div class="row g-3">

                            <div class="col-md-6">
                                <label class="form-label fw-bold">Accesibilidad *</label>
                                <select asp-for="Accesibilidad" class="form-select" required>
                                    <option value="">Seleccione...</option>
                                    <option>Buena</option>
                                    <option>Regular</option>
                                    <option>Mala</option>
                                    <option>Solo Helicóptero</option>
                                </select>
                                <span asp-validation-for="Accesibilidad" class="text-danger"></span>
                            </div>

                            <div class="col-md-6">
                                <label class="form-label fw-bold">Tipo de Terreno *</label>
                                <select asp-for="TipoTerreno" class="form-select" required>
                                    <option value="">Seleccione...</option>
                                    <option>Planicie (Valle o Cuenca)</option>
                                    <option>Lomerío suave</option>
                                    <option>Piedemonte</option>
                                    <option>Cañada / Arroyo</option>
                                    <option>Mesa / Meseta</option>
                                    <option>Sierra (Ladera)</option>
                                    <option>Banco de Material</option>
                                </select>
                                <span asp-validation-for="TipoTerreno" class="text-danger"></span>
                            </div>

                        </div>

                    </div>
                </div>


                <!-- =========================== -->
                <!-- 2 DESCRIPCIÓN DEL BARRENO -->
                <!-- =========================== -->

                <div class="card siil-card mb-4">

                    <div class="card-header siil-card__header">
                        <h5 class="mb-0">2. Descripción del Barreno</h5>
                    </div>

                    <div class="card-body">

                        <h6 class="text-primary mb-3">Identificación</h6>

                        <div class="row g-3">

                            <div class="col-md-4">
                                <label class="form-label">Barreno (ID) *</label>
                                <input asp-for="BarrenoID" type="text" class="form-control"
                                       placeholder="PROY-SR-BRN-001" required>
                                <span asp-validation-for="BarrenoID" class="text-danger"></span>
                            </div>

                            <div class="col-md-4">
                                <label class="form-label">Perforista</label>
                                <select asp-for="Perforista" class="form-select">
                                    <option value="">Seleccione...</option>
                                    <option>Perforaciones del Norte</option>
                                    <option>GeoDrill México</option>
                                    <option>ExploraMineral SA</option>
                                    <option>Servicios Geotécnicos MX</option>
                                </select>
                                <span asp-validation-for="Perforista" class="text-danger"></span>
                            </div>

                            <div class="col-md-4">
                                <label class="form-label">Responsable</label>
                                <input asp-for="Responsable" type="text" class="form-control">
                                <span asp-validation-for="Responsable" class="text-danger"></span>
                            </div>

                        </div>


                        <hr class="my-4">

                        <h6 class="text-primary mb-3">Localización y Geometría</h6>

                        <div class="row g-3">

                            <div class="col-md-4">
                                <label class="form-label">Latitud (14 - 33)</label>
                                <input asp-for="Latitud" type="number" step="0.000001"
                                       class="form-control">
                                <span asp-validation-for="Latitud" class="text-danger"></span>
                            </div>

                            <div class="col-md-4">
                                <label class="form-label">Longitud (-118.5 a -86)</label>
                                <input asp-for="Longitud" type="number" step="0.000001"
                                       class="form-control">
                                <span asp-validation-for="Longitud" class="text-danger"></span>
                            </div>

                            <div class="col-md-4">
                                <label class="form-label">Altitud (msnm)</label>
                                <input asp-for="Altitud" type="number" step="0.01"
                                       class="form-control">
                                <span asp-validation-for="Altitud" class="text-danger"></span>
                            </div>

                        </div>


                        <div class="row g-3 mt-1">

                            <div class="col-md-6">
                                <label class="form-label">Azimut (0 - 360°)</label>
                                <input asp-for="Azimut" type="number"
                                       class="form-control">
                                <span asp-validation-for="Azimut" class="text-danger"></span>
                            </div>

                            <div class="col-md-6">
                                <label class="form-label">Inclinación (0 a -90°)</label>
                                <input asp-for="Inclinacion" type="number"
                                       class="form-control">
                                <span asp-validation-for="Inclinacion" class="text-danger"></span>
                            </div>

                        </div>


                        <hr class="my-4">

                        <h6 class="text-primary mb-3">Programa y Ejecución</h6>

                        <div class="row g-3">

                            <div class="col-md-4">
                                <label class="form-label">Tipo de Barrenación</label>
                                <select asp-for="TipoBarrenacion" id="TipoBarrenacion" class="form-select">
                                    <option value="">Seleccione...</option>
                                    <option>Corte Diamante</option>
                                </select>
                                <span asp-validation-for="TipoBarrenacion" class="text-danger"></span>
                            </div>

                            <div class="col-md-4">
                                <label class="form-label">Fecha Inicio</label>
                                <input asp-for="FechaInicio" type="date" class="form-control">
                                <span asp-validation-for="FechaInicio" class="text-danger"></span>
                            </div>

                            <div class="col-md-4">
                                <label class="form-label">Fecha Finalización</label>
                                <input asp-for="FechaFinalizacion" type="date" class="form-control">
                                <span asp-validation-for="FechaFinalizacion" class="text-danger"></span>
                            </div>

                        </div>

                        <div class="row g-3 mt-1">

                            <div class="col-md-4">
                                <label class="form-label">Longitud perforada (m)</label>
                                <input asp-for="LongitudPerforada" id="LongitudPerforada" type="number" step="0.01"
                                       class="form-control">
                                <span asp-validation-for="LongitudPerforada" class="text-danger"></span>
                            </div>

                        </div>

                    </div>
                </div>


                <!-- =========================== -->
                <!-- 3 DESCRIPCIÓN DEL NÚCLEO -->
                <!-- =========================== -->

                <div class="card siil-card mb-4">

                    <div class="card-header siil-card__header">
                        <h5 class="mb-0">3. Descripción del Núcleo</h5>
                    </div>

                    <div class="card-body">

                        <h6 class="text-primary mb-3">Datos Generales</h6>

                        <div class="row g-3">

                            <div class="col-md-3">
                                <label class="form-label">Longitud recuperada (m)</label>
                                <input asp-for="LongitudRecuperada" id="LongitudRecuperada" type="number" step="0.01"
                                       class="form-control">
                                <span asp-validation-for="LongitudRecuperada" class="text-danger"></span>
                            </div>

                            <div class="col-md-3">
                                <label class="form-label">Diámetro (mm)</label>
                                <input asp-for="Diametro" type="number" class="form-control">
                                <span asp-validation-for="Diametro" class="text-danger"></span>
                            </div>

                            <div class="col-md-3">
                                <label class="form-label">Número de cajas</label>
                                <input asp-for="NumeroCajas" type="number"
                                       class="form-control">
                                <span asp-validation-for="NumeroCajas" class="text-danger"></span>
                            </div>

                            <div class="col-md-3">
                                <label class="form-label">Nombre de cajas</label>
                                <input asp-for="NombreCajas" type="text" class="form-control">
                                <span asp-validation-for="NombreCajas" class="text-danger"></span>
                            </div>

                        </div>


                        <hr class="my-4">

                        <h6 class="text-primary mb-3">Descripción Técnica</h6>

                        <div class="row g-3">

                            <div class="col-md-4" id="grupoRQD" style="display: none;">
                                <label class="form-label">RQD</label>
                                <select asp-for="RQD" id="RQD" class="form-select">
                                    <option value="">Seleccione...</option>
                                    <option>90% - 100% (Excelente)</option>
                                    <option>75% - 90% (Bueno)</option>
                                    <option>50% - 75% (Regular)</option>
                                    <option>25% - 50% (Pobre)</option>
                                    <option>0% - 25% (Muy pobre)</option>
                                </select>
                                <span asp-validation-for="RQD" class="text-danger"></span>
                            </div>

                            <div class="col-md-4">
                                <label class="form-label">TCR (%)</label>
                                <input asp-for="TCR" id="TCR" type="number"
                                       step="0.01"
                                       class="form-control"
                                       readonly>
                                <span asp-validation-for="TCR" class="text-danger"></span>
                            </div>

                            <div class="col-md-4">
                                <label class="form-label">Responsable</label>
                                <select asp-for="Responsable" class="form-select">
                                    <option value="">Seleccione...</option>
                                    <option>Juan Pérez</option>
                                    <option>María García</option>
                                    <option>Carlos López</option>
                                </select>
                                <span asp-validation-for="Responsable" class="text-danger"></span>
                            </div>

                        </div>

                        <div class="row g-3 mt-1">

                            <div class="col-md-3">
                                <label class="form-label">Intervalos</label>
                                <input asp-for="Intervalos" type="number"
                                       class="form-control">
                                <span asp-validation-for="Intervalos" class="text-danger"></span>
                            </div>

                            <div class="col-md-9">
                                <label class="form-label">Intervalos de interés</label>
                                <textarea asp-for="IntervalosInteres" class="form-control" rows="2"></textarea>
                                <span asp-validation-for="IntervalosInteres" class="text-danger"></span>
                            </div>

                        </div>

                        <div class="row g-3 mt-2">

                            <div class="col-md-6">
                                <label class="form-label">Archivo Descripción Núcleo (.xlsx, .csv)</label>
                                <input asp-for="ArchivoDescripcionNucleo" type="file" class="form-control">
                                <span asp-validation-for="ArchivoDescripcionNucleo" class="text-danger"></span>
                            </div>

                            <div class="col-md-6">
                                <label class="form-label">Fotografías del Núcleo (.jpg, .jpeg, .png)</label>
                                <input asp-for="FotografiasNucleo" type="file" class="form-control"
                                    multiple>
                                <span asp-validation-for="FotografiasNucleo" class="text-danger"></span>
                            </div>

                        </div>

                    </div>
                </div>


                <!-- =========================== -->
                <!-- 4 NOTAS -->
                <!-- =========================== -->

                <div class="card siil-card mb-4">

                    <div class="card-header siil-card__header">
                        <h5 class="mb-0">4. Notas</h5>
                    </div>

                    <div class="card-body">

                        <label class="form-label">Observaciones</label>
                        <textarea asp-for="Observaciones" class="form-control" rows="3"></textarea>
                        <span asp-validation-for="Observaciones" class="text-danger"></span>

                    </div>

                </div>


                <!-- BOTONES -->

                <div class="d-grid gap-2">

                    <button type="submit" class="btn btn-siil-primary btn-lg">
                        <i class="bi bi-save me-2"></i>
                        Guardar Registro de Barrenación
                    </button>

                    <a asp-action="Index" class="btn btn-siil-secondary">
                        <i class="bi bi-x-circle me-2"></i>
                        Cancelar
                    </a>

                </div>

                }

            </div>
        </div>
    </div>
    <style>
        .form-label {
            font-weight: 600;
            color: #5b6472;
            text-transform: uppercase;
            letter-spacing: 0.02em;
            font-size: 0.75rem;
        }

        .siil-form .form-control,
        .siil-form .form-select {
            border-radius: 14px;
            border: 1px solid #e6edf6;
            box-shadow: 0 1px 0 rgba(16, 24, 40, 0.02);
            padding: 0.7rem 0.9rem;
        }

        .siil-title {
            display: flex;
            align-items: center;
            gap: 0.75rem;
            margin-bottom: 1rem;
        }

        .siil-title__icon {
            width: 40px;
            height: 40px;
            border-radius: 12px;
            background: #e9f3ff;
            color: #2f80ed;
            display: grid;
            place-items: center;
            font-size: 1.1rem;
        }

        .siil-alert {
            background: #f4f8ff;
            border: 1px solid #e3ecff;
            color: #2b3b53;
            border-radius: 14px;
            padding: 0.85rem 1rem;
        }

        .siil-card {
            border-radius: 16px;
            border: 1px solid #ecf1f6;
            box-shadow: 0 6px 20px rgba(15, 23, 42, 0.04);
        }

        .siil-card__header {
            background: #f7f9fc;
            border-bottom: 1px solid #edf2f7;
            border-top-left-radius: 16px;
            border-top-right-radius: 16px;
            color: #2b3b53;
            font-weight: 600;
        }

        .siil-card__header--warning {
            background: #fff7e6;
            color: #8a5b00;
        }

        .siil-card__header--success {
            background: #ecfdf3;
            color: #1c7c54;
        }

        .siil-subpanel {
            background: #f7f9fc;
            border: 1px dashed #e0e7ff;
            border-radius: 14px;
            padding: 1rem;
        }

        .siil-id-preview {
            margin-top: 1.5rem;
            padding: 1rem;
            border-radius: 16px;
            background: #f2fceb;
            border: 1px solid #dff2c6;
        }

        .siil-id-preview__value {
            font-weight: 700;
            color: #62b400;
            letter-spacing: 0.04em;
        }

        .btn-siil-primary {
            background: #77c308;
            border-color: #77c308;
            color: #fff;
            border-radius: 14px;
            padding: 0.85rem 1rem;
        }

        .btn-siil-primary:hover {
            background: #66ad06;
            border-color: #66ad06;
            color: #fff;
        }

        .btn-siil-secondary {
            border-radius: 14px;
            border: 1px solid #e6edf6;
            color: #5b6472;
            background: #fff;
            padding: 0.85rem 1rem;
        }

        .btn-siil-secondary:hover {
            background: #f7f9fc;
        }

        .btn-lg {
            font-size: 1.05rem;
        }

        .font-monospace {
            letter-spacing: 0.05em;
        }

    </style>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />

    <script>

        document.addEventListener("DOMContentLoaded", function () {

            inicializarEventos();
            @* inicializarMapa(); *@

            const form = document.getElementById("formBarrenacion");

            generarBarrenoID();

            if (form) {
                form.addEventListener("submit", function (e) {

                    const valido = validarFormularioBarrenacion();

                    if (!valido) {
                        e.preventDefault();
                        return;
                    }

                    const btn = form.querySelector("button[type='submit']");
                    btn.disabled = true;
                    btn.innerHTML = "Guardando...";
                });
            }

        });

        function inicializarEventos(){

            const tipo = document.getElementById("TipoBarrenacion");
            const lat = document.getElementById("Latitud");
            const lon = document.getElementById("Longitud");
            const litologia = document.getElementById("LitologiaLocal");
            const tcr = document.getElementById("TCR");
            const longitudP = document.getElementById("LongitudPerforada");
            const longitudR = document.getElementById("LongitudRecuperada");

            if(longitudP && longitudR){
                longitudP.addEventListener("input", calcularTCR);
                longitudR.addEventListener("input", calcularTCR);
            }

            if(tipo){
                tipo.addEventListener("change", activarRQD);
            }

            if(lat && lon){
                lat.addEventListener("input", limpiarErrorCoordenadaBarrenacion);
                lon.addEventListener("input", limpiarErrorCoordenadaBarrenacion);
                lat.addEventListener("blur", validarCoordenadasBarrenacion);
                lon.addEventListener("blur", validarCoordenadasBarrenacion);
            }

            if(litologia && tcr){
                litologia.addEventListener("change", validarTCRGeologico);
                tcr.addEventListener("blur", validarTCRGeologico);

                litologia.addEventListener("change", function(){
                    validarTCRGeologico();
                });
            }

        }

        function activarRQD(){

            const tipo = document.getElementById("TipoBarrenacion").value;
            const rqd = document.getElementById("RQD");
            const grupo = document.getElementById("grupoRQD");

            if(tipo === "Corte Diamante"){

                grupo.style.display = "block";
                rqd.disabled = false;

            }
            else{

                grupo.style.display = "none";
                rqd.value = "";
                rqd.disabled = true;

            }

        }

        function validarFormularioBarrenacion(){

            limpiarValidaciones();

            let valido = true;

            const lat = parseFloat(document.getElementById("Latitud").value);
            const lon = parseFloat(document.getElementById("Longitud").value);
            const alt = parseFloat(document.getElementById("Altitud").value);
            const azimut = parseInt(document.getElementById("Azimut").value);
            const inclinacion = parseInt(document.getElementById("Inclinacion").value);

            const fechaInicio = document.getElementById("FechaInicio").value;
            const fechaFin = document.getElementById("FechaFin").value;

            const longitudP = parseFloat(document.getElementById("LongitudPerforada").value);
            const longitudR = parseFloat(document.getElementById("LongitudRecuperada").value);

            const diametro = parseInt(document.getElementById("Diametro").value);
            const cajas = parseInt(document.getElementById("NumeroCajas").value);

            const tcr = parseFloat(document.getElementById("TCR").value);
            const intervalos = parseInt(document.getElementById("Intervalos").value);

            // LATITUD
            if(isNaN(lat) || lat < 14 || lat > 33){
                marcarInvalido("Latitud","Latitud fuera de rango (14 a 33).");
                valido = false;
            }

            // LONGITUD
            if(isNaN(lon) || lon < -118.5 || lon > -86){
                marcarInvalido("Longitud","Longitud fuera de rango (-118.5 a -86).");
                valido = false;
            }

            // ALTITUD
            if(isNaN(alt) || alt <= 0){
                marcarInvalido("Altitud","Altitud debe ser mayor a 0.");
                valido = false;
            }

            // AZIMUT
            if(isNaN(azimut) || azimut < 0 || azimut > 360){
                marcarInvalido("Azimut","Azimut debe estar entre 0° y 360°.");
                valido = false;
            }

            // INCLINACION
            if(isNaN(inclinacion) || inclinacion > 0 || inclinacion < -90){
                marcarInvalido("Inclinacion","La inclinación debe estar entre 0° y -90°.");
                valido = false;
            }

            // FECHAS
            if(fechaInicio && fechaFin){

                const f1 = new Date(fechaInicio);
                const f2 = new Date(fechaFin);

                if(f2 < f1){
                    marcarInvalido("FechaFin","La fecha de finalización no puede ser menor a la de inicio.");
                    valido = false;
                }

            }

            // LONGITUD PERFORADA
            if(isNaN(longitudP) || longitudP <= 0){
                marcarInvalido("Longitud_p","Debe ser mayor a 0.");
                valido = false;
            }

            // LONGITUD RECUPERADA
            if(isNaN(longitudR) || longitudR <= 0){
                marcarInvalido("Longitud_r","Debe ser mayor a 0.");
                valido = false;
            }

            // DIÁMETRO
            if(isNaN(diametro) || diametro <= 0){
                marcarInvalido("Diametro","El diámetro debe ser mayor a 0.");
                valido = false;
            }

            // CAJAS
            if(isNaN(cajas) || cajas <= 0){
                marcarInvalido("NumeroCajas","Debe haber al menos una caja.");
                valido = false;
            }

            // TCR
            if(isNaN(tcr) || tcr < 0 || tcr > 100){
                marcarInvalido("TCR","El TCR debe estar entre 0 y 100.");
                valido = false;
            }

            // INTERVALOS
            if(isNaN(intervalos) || intervalos <= 0){
                marcarInvalido("Intervalos","Debe ser mayor a 0.");
                valido = false;
            }

            return valido;

        }

        function marcarInvalido(id,mensaje){

            const input = document.getElementById(id);

            input.classList.add("is-invalid");

            let error = input.nextElementSibling;

            if(!error || !error.classList.contains("invalid-feedback")){

                error = document.createElement("div");
                error.className = "invalid-feedback";

                input.parentElement.appendChild(error);
            }

            error.innerText = mensaje;

        }

        function limpiarValidaciones(){

            const inputs = document.querySelectorAll("#formBarrenacion input, #formBarrenacion select");

            inputs.forEach(input =>{

                input.classList.remove("is-invalid");

                const feedback = input.parentElement.querySelector(".invalid-feedback");

                if(feedback) feedback.remove();

            });

        }

        function validarCoordenadasBarrenacion(){

            const lat = parseFloat(document.getElementById("Latitud").value);
            const lon = parseFloat(document.getElementById("Longitud").value);

            // LIMPIAR VALIDACIONES ANTES DE VALIDAR
            latInput.classList.remove("is-invalid","is-valid");
            lonInput.classList.remove("is-invalid","is-valid");

            limpiarErrorCoordenadaBarrenacion();

            if(isNaN(lat) || isNaN(lon)) return;

            if(lat < 14 || lat > 33 || lon < -118.5 || lon > -86){

                marcarInvalido("Latitud","Coordenadas fuera de México.");
                marcarInvalido("Longitud","Coordenadas fuera de México");

                return;
            }

            const punto = turf.point([lon,lat]);

            const estado = estados.features.find(e => 
                e.properties.CVE_ENT == estadoIdNormalizado
            );

            let dentroMexico = false;

            if (estado.geometry.type === "Polygon") {
                dentroMexico = turf.booleanPointInPolygon(
                    punto,
                    turf.polygon(estado.geometry.coordinates)
                );
            } else {
                dentroMexico = estado.geometry.coordinates.some(pol =>
                    turf.booleanPointInPolygon(
                        punto,
                        turf.polygon(pol)
                    )
                );
            }

            if(!dentroMexico){

                mostrarErrorCoordenadaBarrenacion(
                    "La coordenada no pertenece al territorio nacional."
                );

                return;
            }

            limpiarErrorCoordenadaBarrenacion();

        }

        function validarTCRGeologico(){

            const litologia = document.getElementById("LitologiaLocal").value;
            const tcr = parseFloat(document.getElementById("TCR").value);

            limpiarAdvertencia("TCR");

            if(isNaN(tcr)) return;

            let esperado = null;

            if(litologia === "Riolita") esperado = 90;
            if(litologia === "Basalto") esperado = 80;
            if(litologia === "Granito") esperado = 85;
            if(litologia === "Andesita") esperado = 75;

            if(esperado !== null && tcr < esperado){

                mostrarAdvertencia(
                    "TCR",
                    "Para " + litologia + " normalmente se espera TCR > " + esperado
                );

            }

        }

        function mostrarAdvertencia(id,mensaje){

            const input = document.getElementById(id);

            let aviso = input.parentElement.querySelector(".form-warning");

            if(!aviso){

                aviso = document.createElement("div");
                aviso.className = "form-warning text-warning small mt-1";

                input.parentElement.appendChild(aviso);
            }

            aviso.innerText = "⚠ " + mensaje;

        }

        function generarBarrenoID(){

            const proyecto = "LIT";
            const zona = "SNR";

            const numero = Math.floor(Math.random()*99999)+1;

            const consecutivo = numero.toString().padStart(5,"0");

            const id = proyecto + "-" + zona + "-BRN-" + consecutivo;

            document.getElementById("BarrenoID").value = id;

        }

        function mostrarErrorCoordenadaBarrenacion(mensaje){

            const inputLon = document.getElementById("Longitud");

            let errorDiv = document.getElementById("errorCoordenadaBarrenacion");

            if(!errorDiv){

                errorDiv = document.createElement("div");
                errorDiv.id = "errorCoordenadaBarrenacion";
                errorDiv.className = "text-danger mt-2";

                inputLon.parentElement.appendChild(errorDiv);
            }

            errorDiv.innerText = mensaje;

        }

        function limpiarErrorCoordenadaBarrenacion(){

            const errorDiv = document.getElementById("errorCoordenadaBarrenacion");

            if(errorDiv) errorDiv.remove();

        }

        function limpiarAdvertencia(id){

            const input = document.getElementById(id);

            const aviso = input.parentElement.querySelector(".form-warning");

            if(aviso) aviso.remove();

        }

        function calcularTCR(){

            const pInput = document.getElementById("LongitudPerforada");
            const rInput = document.getElementById("LongitudRecuperada");
            const tcrInput = document.getElementById("TCR");

            const p = parseFloat(pInput.value);
            const r = parseFloat(rInput.value);

            limpiarAdvertencia("TCR");

            // limpiar errores anteriores
            limpiarInvalido("LongitudRecuperada");

            if(isNaN(p) || p <= 0){
                tcrInput.value = "";
                return;
            }

            if(isNaN(r) || r <= 0){
                tcrInput.value = "";
                return;
            }

            if(r > p){

                marcarInvalido(
                    "LongitudRecuperada",
                    "La longitud recuperada no puede ser mayor que la perforada."
                );

                tcrInput.value = "";
                return;
            }

            const tcr = (r / p) * 100;

            tcrInput.value = tcr.toFixed(2);

            // activar advertencias geológicas automáticamente
            validarTCRGeologico();

        }

        function limpiarInvalido(id){

            const input = document.getElementById(id);

            input.classList.remove("is-invalid");

            const feedback = input.parentElement.querySelector(".invalid-feedback");

            if(feedback) feedback.remove();

        }

    </script>
}


