@using Microsoft.AspNetCore.Http
@using Newtonsoft.Json
@inject IHttpContextAccessor HttpContextAccessor

@{
    ViewData["Title"] = "SIIL - Sistema de Información de Infraestructura e Inversión";

    var perfilJson = HttpContextAccessor.HttpContext.Session.GetString("PerfilUsuario");
    var perfilUsuario = JsonConvert.DeserializeObject<PerfilUsuario>(perfilJson);
    ViewData["NombreUsuario"] = perfilUsuario.Nombre;
    ViewData["RolUsuario"] = perfilUsuario.Rol;

    var header = new HeaderViewModel
    {
        Title = ViewData["Title"].ToString(),
        IconPath = "siil.png",
        Description = "Sistema de Información de Infraestructura e Inversión",
        Section = "SIIL",
        ModuleInfo = JsonConvert.SerializeObject(new
        {
            title = "SIIL",
            description = "Sistema de Información de Infraestructura e Inversión",
            functionality = "Gestión de información de infraestructura e inversión energética",
            stage = "Desarrollo",
            roles = new[] {
                new { icon = "industry", text = "Infraestructura energética" },
                new { icon = "chart-line", text = "Análisis de inversión" }
            }
        })
    };
}

<div class="container-fluid p-4">
    @await Html.PartialAsync("_ViewHeader", header)

    <div class="content-area mt-4">
        <div class="card">
            <div class="card-header">
                <h5>Sistema SIIL</h5>
            </div>
            <div class="card-body">
                <p>Bienvenido al Sistema de Información de Infraestructura e Inversión (SIIL)</p>
                <p>Este módulo está en desarrollo y pronto estará disponible con todas sus funcionalidades.</p>
            </div>
        </div>
    </div>
</div>